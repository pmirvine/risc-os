   10 REM > Circles
   20 REM Concentric circle pattern in 16 colours
   30 MODE 12:OFF
   40 ORIGIN 640,512
   50 FOR r%=500 TO 20 STEP -20
   60   GCOL (r% DIV 20) MOD 15+1
   70   CIRCLE FILL 0,0,r%
   80 NEXT
   90 FOR a=0 TO 2*PI STEP PI/12
  100   GCOL 7:LINE 0,0,520*COS(a),520*SIN(a)
  110 NEXT
  120 GCOL 3,15:ELLIPSE 0,0,600,200:ELLIPSE 0,0,200,480
  130 VDU 5:MOVE -140,-450:GCOL 0,7:PRINT "RISC OS 3.71":VDU 4
  140 END
