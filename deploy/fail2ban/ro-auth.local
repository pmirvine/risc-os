# Ban IPs that keep failing Apache basic auth on the tsihome vhost (/ro/). Installed by hand; see deploy/README.md in the risc-os repo.
[DEFAULT]
# never ban this computer or the home network
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24
banaction = firewallcmd-rich-rules
banaction_allports = firewallcmd-rich-rules[actiontype=<allports>]

[apache-basic-auth]
enabled  = true
filter   = apache-basic-auth
port     = http,https
logpath  = /var/log/apache2/tsihome.mynetgear.com-error_log
maxretry = 5
findtime = 10m
bantime  = 1h
