# Ban IPs that keep failing Apache basic auth on the vhost that serves /ro/. Template: fill in the two __PLACEHOLDERS__ (see deploy/README.md).
[DEFAULT]
# never ban this computer or the home network
ignoreip = 127.0.0.1/8 ::1 __LAN__
banaction = firewallcmd-rich-rules
banaction_allports = firewallcmd-rich-rules[actiontype=<allports>]

[apache-basic-auth]
enabled  = true
filter   = apache-basic-auth
port     = http,https
logpath  = __ERROR_LOG__
maxretry = 5
findtime = 10m
bantime  = 1h
