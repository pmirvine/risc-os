[Unit]
Description=Firewall rules for the RISC OS container bridge (br-ro)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/riscos/src/deploy/ro-firewall.sh apply
ExecStop=/srv/riscos/src/deploy/ro-firewall.sh remove
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
