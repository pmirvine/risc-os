// PicRelease - a closed document's decoded pictures let go (Batch B;
// browser-only through ./PicCache, no desktop services).
//
//   releasePics(doc, others, cache = CACHE)
//       each part of doc.parts that no document of `others` (the
//       Docs still open) holds as the same bytes object is
//       forgotten by the cache (cache.forget: its bitmap closed), so
//       a closed window's bitmaps do not wait for the next decode
//       and the garbage collector. Bytes shared with an open
//       document (a picture pasted between them) stay.
import {CACHE} from './PicCache';

const partsOf = (doc) => (doc && doc.parts instanceof Map
  ? doc.parts.values() : []);

/** See the header. */
export function releasePics(doc, others = [], cache = CACHE) {
  const keep = new Set();
  for (const o of others) {
    if (o !== doc) for (const b of partsOf(o)) keep.add(b);
  }
  for (const b of partsOf(doc)) {
    if (b instanceof Uint8Array && !keep.has(b)) cache.forget(b);
  }
}
