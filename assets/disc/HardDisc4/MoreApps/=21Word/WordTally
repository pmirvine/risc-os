// WordTally - the running numbers of ./WordCount: words, characters
// (with and without spaces) and paragraphs, as text is fed to it.
//
//   new Tally()  {words, chars, noSpaces, paras}
//     .text(s)   the text s of a paragraph (code points counted)
//     .gap()     a tab or a line break: a character, ends the word
//     .end()     the end of a paragraph (counted when it had any
//                character)
//
// The rules (Word's) are ./WordCount's header. Pure: no desktop
// services.

/** White space: the Unicode White_Space but the no-break ones. */
function isSpace(c) {
  if (c < 128) return c === 32 || (c >= 9 && c <= 13);
  return c === 0x85 || c === 0x1680 || (c >= 0x2000 && c <= 0x200a &&
    c !== 0x2007) || c === 0x2028 || c === 0x2029 || c === 0x205f ||
    c === 0x3000;
}

/** An East Asian character: counted as a word by itself. */
function isAsian(c) {
  if (c < 0x1100) return false;
  return (c >= 0x4e00 && c <= 0x9fff) || (c >= 0x3040 && c <= 0x30ff &&
    c !== 0x30fb) || (c >= 0xac00 && c <= 0xd7af) ||
    (c >= 0x3400 && c <= 0x4dbf) || (c >= 0x1100 && c <= 0x11ff) ||
    (c >= 0x3100 && c <= 0x318f) || (c >= 0x31f0 && c <= 0x31ff) ||
    (c >= 0xf900 && c <= 0xfaff) || (c >= 0xff66 && c <= 0xffdc) ||
    (c >= 0x20000 && c <= 0x2fa1f);
}

/** The running numbers. */
export class Tally {
  constructor() {
    this.words = 0;
    this.chars = 0;
    this.noSpaces = 0;
    this.paras = 0;
    this.here = 0;            // characters in this paragraph
    this.inWord = false;
  }

  /** Count the text s of a paragraph. */
  text(s) {
    let words = this.words, chars = this.chars, ns = this.noSpaces;
    let inWord = this.inWord;
    const n = s.length;
    for (let i = 0; i < n; i++) {
      let c = s.charCodeAt(i);
      if (c >= 0xd800 && c < 0xdc00 && i + 1 < n) {
        const d = s.charCodeAt(i + 1);
        if (d >= 0xdc00 && d < 0xe000) {
          c = (c - 0xd800) * 0x400 + d - 0xdc00 + 0x10000;
          i++;
        }
      }
      chars++;
      if (isSpace(c)) { inWord = false; continue; }
      if (c !== 0xa0 && c !== 0x2007 && c !== 0x202f) ns++;
      if (isAsian(c)) { words++; inWord = false; continue; }
      if (!inWord) { words++; inWord = true; }
    }
    this.here += chars - this.chars;
    this.words = words;
    this.chars = chars;
    this.noSpaces = ns;
    this.inWord = inWord;
  }

  /** A tab or a line break: a character, ends the word. */
  gap() {
    this.chars++;
    this.here++;
    this.inWord = false;
  }

  /** The end of a paragraph. */
  end() {
    if (this.here > 0) this.paras++;
    this.here = 0;
    this.inWord = false;
  }
}
