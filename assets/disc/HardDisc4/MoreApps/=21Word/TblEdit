// TblEdit - the table commands as pure functions on a Table (Batch
// C, D23..D26). Each takes a table and returns a NEW table sharing
// every row, cell and block it does not change (copy-on-write: no
// object that exists is changed), or the same table when nothing
// changes; ./TblCmd onTable applies one as one restoreBlock.
//
//   emptyLike(p) -> the empty paragraph a command makes (R17, the
//       one helper for them): a fresh id (./Model nextId: the caller
//       reserves the document's ids first, as onTable does), p's pPr
//       (a raw paragraph-mark w:rPr in its extra kept) and pStyle,
//       extraP []; for p not a paragraph a plain empty one
//   clearCells(t, cells) -> t'  cells [{r, k}] (./SelShape's): each
//       keeps ONE paragraph, emptyLike of its first paragraph (its
//       first block when that is one, else the first paragraph in
//       it at any depth); a cell that is one empty paragraph already
//       is kept as it is (so nothing to clear gives t itself)
//   deleteRows(t, r0, r1) -> t' | null  rows r0..r1 (inclusive)
//       removed (D23); null when that is every row (the caller
//       removes the table); RangeError for rows not in t. A vMerge
//       continue cell of the next row whose merge started in the
//       removed rows becomes its restart (the merge goes on, the
//       content goes with its row). The marks between the removed
//       rows and cells (each row's lead, its cells' leads, its tail:
//       bookmarks, comment ranges...) move, in document order, to
//       the front of the next row's lead, or after the last row to
//       the front of the table's tail: a bookmark pair is never
//       broken (./BookmarkKeep's rule); so do the bookmark marks in
//       the removed rows' paragraphs (any depth) whose partner is
//       not in those paragraphs (a pair wholly in them goes with
//       them)
//   insertRows(t, r0, r1, below) -> t'  r1 - r0 + 1 new rows above
//       row r0 or below row r1 (D23), each a copy of the row beside
//       them (r0 above, r1 below): its trPr (tblHeader only when the
//       new rows stay in the header run: above a header row, or
//       between two), each cell's tcPr without vMerge restart (a
//       merge grows only when the new rows are strictly inside it,
//       between two of its rows: continue; below its last row or
//       above its restart: none), one emptyLike paragraph of
//       the cell's first paragraph per cell (fresh ids: reserve the
//       document's first), attrs / lead / tail [], tblPrEx null
//       (R17); RangeError for rows not in t, or 'rows' past
//       ./TblCheck MAX_ROWS (R16)
//   setProps(t, g, shape, patch) -> t'  Table properties (the
//       module ./TblEditProps; also cellsOf)
//   splitTable(t, r) -> [a, b]  rows 0..r-1 stay in a (t's id, tail
//       []), rows r.. become b (D25): a fresh id (./Model nextId),
//       t's tblPr, attrs and tail; a merge crossing row r restarts
//       there; RangeError unless 0 < r < the row count
// Shared with ./TblEditCols:
//   firstPara(cell) -> its first paragraph (as clearCells), or
//       undefined
//   cellMarks(cell, out) -> out with the cell's lead nodes and the
//       bookmark marks of its paragraphs (any depth) pushed;
//       unpaired(got) -> those of got whose partner is not in got;
//       nodesOf(got) -> their element nodes (what moves)
// Each starts from ./TblNorm unstray (a stray continue cell written
// restart) and sets fields with prWith (setProps' raw rule).
// A changed table always gets a NEW grid array (equal values): the
// widths are memoised per grid array (./TblWidth colsOf), and a
// tcPr / trPr object is never changed in place (./TblGrid reuses a
// copy's grid by the identity of its rows' trPr and cells' tcPr).
// Pure: no desktop services.
import {newPara, nextId} from './Model';
import {gridOf} from './TblGrid';
import {forEachIn} from './Walk';
import {MAX_ROWS} from './TblCheck';
import {marksIn} from './BookmarkKeep';
import {prWith, unstray} from './TblNorm';
export {setProps, cellsOf} from './TblEditProps';

const isP = (b) => !!b && b.type === 'p';
const arr = (v) => (Array.isArray(v) ? v : []);

/** See the header. */
export function emptyLike(p) {
  if (!isP(p)) return newPara('');
  const opts = {pPr: p.pPr};
  if (p.pStyle !== undefined) opts.pStyle = p.pStyle;
  return newPara('', opts);
}

/** See the header. */
export function firstPara(cell) {
  if (isP(cell.blocks[0])) return cell.blocks[0];
  let out;
  forEachIn(cell.blocks, [], (b) => {
    if (!isP(b)) return true;
    out = b;
    return false;
  });
  return out;
}

const isClear = (cell) => cell.blocks.length === 1 &&
  isP(cell.blocks[0]) && cell.blocks[0].text === '';

/** See the header. */
export function clearCells(t, cells) {
  const rows = t.rows.slice(), own = new Set();
  let changed = false;
  for (const {r, k} of cells) {
    const cell = rows[r] && rows[r].cells[k];
    if (!cell || isClear(cell)) continue;
    if (!own.has(r)) {
      rows[r] = {...rows[r], cells: rows[r].cells.slice()};
      own.add(r);
    }
    rows[r].cells[k] = {...cell, blocks: [emptyLike(firstPara(cell))]};
    changed = true;
  }
  return changed ? {...t, rows} : t;
}

/** The bookmark marks of a cell's paragraphs (any depth). */
function inner(cell, out) {
  forEachIn(cell.blocks, [], (b) => {
    if (isP(b)) marksIn(b, 0, b.text.length, out);
  });
  return out;
}

/** See the header (cellMarks). */
export function cellMarks(cell, out) {
  out.push(...arr(cell.lead));
  return inner(cell, out);
}

/** See the header (unpaired). */
export function unpaired(got) {
  const has = new Set(got.filter((m) => m.kind).map((m) => m.kind +
    ' ' + m.id));
  const other = {start: 'end', end: 'start'};
  return got.filter((m) => !m.kind || m.id === null ||
    !has.has(other[m.kind] + ' ' + m.id));
}

/** See the header (nodesOf). */
export const nodesOf = (got) => got.map((m) => (m.kind ? m.x.node
  : m));

/** The marks of rows r0..r1 that move (see the header), in order:
 *  between rows and cells all, in paragraphs those unpaired there. */
function looseOf(t, r0, r1) {
  const got = [];
  for (let r = r0; r <= r1; r++) {
    const row = t.rows[r];
    got.push(...arr(row.lead));
    for (const c of row.cells) cellMarks(c, got);
    got.push(...arr(row.tail));
  }
  return nodesOf(unpaired(got));
}

/** Rows r0..r1 of t, or a RangeError. */
function checkRows(t, r0, r1) {
  if (!Number.isInteger(r0) || !Number.isInteger(r1) || r0 < 0 ||
    r1 < r0 || r1 >= t.rows.length) {
    throw new RangeError('no such rows');
  }
}

/** cells with each continue cell of grid row gr whose merge started
 *  at row lo or later made a restart (a copy; the same array if
 *  none). */
function restartAt(cells, gr, lo) {
  let out = cells;
  gr.cells.forEach((c, k) => {
    if (!c.cont || c.top[0] < lo) return;
    if (out === cells) out = cells.slice();
    out[k] = {...out[k], tcPr: prWith(out[k].tcPr,
      {vMerge: 'restart'})};
  });
  return out;
}

/** See the header. */
export function deleteRows(t, r0, r1) {
  checkRows(t, r0, r1);
  t = unstray(t);
  const n = t.rows.length;
  if (r0 === 0 && r1 === n - 1) return null;
  const marks = looseOf(t, r0, r1);
  const rows = [...t.rows.slice(0, r0), ...t.rows.slice(r1 + 1)];
  const grid = [...t.grid];
  if (r1 + 1 === n) {
    return marks.length ? {...t, grid, rows, tail: [...marks,
      ...arr(t.tail)]} : {...t, grid, rows};
  }
  const nx = t.rows[r1 + 1];
  const cells = restartAt(nx.cells, gridOf(t).rows[r1 + 1], r0);
  if (cells !== nx.cells || marks.length) {
    rows[r0] = {...nx, cells, lead: [...marks, ...arr(nx.lead)]};
  }
  return {...t, grid, rows};
}

const header = (row) => !!row && !!row.trPr &&
  row.trPr.tblHeader === true;

/** A new row like row r of t (grid g), see the header: below r, a
 *  cell continues only a merge that goes on below r (A4 ruling). */
function rowLike(row, g, r, below, head) {
  const trPr = head ? {...row.trPr} : prWith(row.trPr,
    {tblHeader: undefined});
  const cells = row.cells.map((c, k) => {
    const x = g.rows[r].cells[k], top = x.top;
    const inMerge = below ? top[0] + g.rows[top[0]].cells[top[1]]
      .rowSpan - 1 > r : x.cont;
    const tcPr = prWith(c.tcPr, {vMerge: inMerge ? 'continue'
      : undefined});
    return {tcPr, blocks: [emptyLike(firstPara(c))], attrs: [],
      lead: []};
  });
  return {trPr, cells, attrs: [], lead: [], tail: [], tblPrEx: null};
}

/** See the header. */
export function insertRows(t, r0, r1, below) {
  checkRows(t, r0, r1);
  const n = r1 - r0 + 1;
  if (t.rows.length + n > MAX_ROWS) {
    throw new RangeError('rows: at most ' + MAX_ROWS);
  }
  t = unstray(t);
  const r = below ? r1 : r0, g = gridOf(t);
  const head = below ? header(t.rows[r1]) && header(t.rows[r1 + 1])
    : header(t.rows[r0]);
  const add = [];
  for (let k = 0; k < n; k++) {
    add.push(rowLike(t.rows[r], g, r, below, head));
  }
  const at = below ? r1 + 1 : r0;
  return {...t, grid: [...t.grid], rows: [...t.rows.slice(0, at),
    ...add, ...t.rows.slice(at)]};
}

/** See the header. */
export function splitTable(t, r) {
  if (!Number.isInteger(r) || r < 1 || r >= t.rows.length) {
    throw new RangeError('no such row');
  }
  t = unstray(t);
  const first = t.rows[r];
  const cells = restartAt(first.cells, gridOf(t).rows[r], 0);
  const rows = t.rows.slice(r);
  if (cells !== first.cells) rows[0] = {...first, cells};
  const a = {...t, grid: [...t.grid], rows: t.rows.slice(0, r),
    tail: []};
  return [a, {...t, id: nextId(), grid: [...t.grid], rows}];
}
