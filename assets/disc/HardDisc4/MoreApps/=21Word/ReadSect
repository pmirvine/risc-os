// ReadSect - section properties (w:sectPr) for the .docx reader.
//
//   props {pgSz?: {w, h, orient?, code?},
//          pgMar?: {top, right, bottom, left, header, footer, gutter},
//          cols?: {num?, space?}, titlePg?: boolean,
//          type?: 'nextPage' | 'continuous' | 'evenPage' |
//                 'oddPage' | 'nextColumn', extra}
//
// Twips stay twips. As everywhere in the reader, an element that is
// not fully understood (w:cols with w:col children, w:pgSz with
// another attribute...) is kept whole in extra, as are header and
// footer references, w:pgNumType, w:docGrid and the rest.
// The attributes of w:sectPr itself (rsids) live only in the
// original node, which the caller keeps as section.raw.
import {readProps, onOff, attrsObj} from './ReadProps';
import {sectType} from './ReadPropsMore';

const MAR = ['top', 'right', 'bottom', 'left', 'header', 'footer',
  'gutter'];

const SECT = new Map([
  ['pgSz', {field: 'pgSz',
    read: attrsObj(['w', 'h', 'orient', 'code'], ['w', 'h', 'code'])}],
  ['pgMar', {field: 'pgMar', read: attrsObj(MAR, MAR)}],
  ['cols', {field: 'cols',
    read: attrsObj(['num', 'space'], ['num', 'space'])}],
  ['titlePg', {field: 'titlePg', read: onOff}],
  ['type', {field: 'type', read: sectType}],
]);

/** The section properties of a w:sectPr node. */
export function readSect(node, map) {
  return readProps(node, map, SECT).props;
}
