// CountBox - the Word count dialogue box (Edit > Word count...), as
// Word's: the numbers of ./WordCount for the selection, or for the
// whole document when nothing is selected, in a small window with a
// Close button. Built by WimpLib Ui/Dialog.
//
//   countBox(dw) -> the box's api (WimpLib Ui/Dialog), one box per
//       document (key 'count:<docKey>'), kept in dw.boxes ('count')
//       so ./CloseDoc deletes it with the document. The numbers are
//       worked out each time it is asked for (also when it is open
//       already: refreshed and brought to the front). Nothing (null)
//       when the document has no selection.
//
// The first line says what was counted (Selection or Document); then
// Words, Characters (no spaces), Characters (with spaces),
// Paragraphs and Lines (the paragraphs of tables count, their lines
// do not: tables have no lines in the layout). A document too big to
// count whole (a table walk past 1,000,000 nodes) says so on the last
// line. Close, Return, Escape and the close icon delete the box and
// give the caret back to the document: nothing changes.
import {dialog} from 'wimplib/Ui/Dialog';
import {box} from './Boxes';
import {countView} from './WordCount';

const ROWS = [['words', 'Words'],
  ['noSpaces', 'Characters (no spaces)'],
  ['chars', 'Characters (with spaces)'], ['paras', 'Paragraphs'],
  ['lines', 'Lines']];
const rows = () => [
  {kind: 'label', name: 'scope', text: '', w: 300},
  ...ROWS.map(([name, text]) => [
    {kind: 'label', text, w: 200},
    {kind: 'label', name, text: '0', w: 100}]),
  {kind: 'label', name: 'note', text: '', w: 300},
];
const HELP = 'Word count: the words, characters, paragraphs and ' +
  'lines of the selected text, or of the whole document when ' +
  'nothing is selected.';

const wired = new WeakSet();       // the boxes with their handler

/** The numbers shown (see the header). */
function fill(api, c) {
  api.set('scope', c.scope === 'selection' ? 'Counted: the selection'
    : 'Counted: the whole document');
  api.set('words', String(c.words));
  api.set('noSpaces', String(c.charsNoSpaces));
  api.set('chars', String(c.chars));
  api.set('paras', String(c.paras));
  api.set('lines', c.lines === null ? '-' : String(c.lines));
  api.set('note', c.partial ? 'Very large tables: not all counted.'
    : '');
}

/** See the header. */
export function countBox(dw) {
  const v = dw.view;
  if (!v.sel) return null;
  const api = dialog({task: dw.app.task, key: `count:${dw.docKey}`,
    title: 'Word count', rows: rows(), help: HELP,
    buttons: ['Close'], enter: 'Close', minW: 330});
  box(dw, 'count', () => api.win);
  if (!wired.has(api)) {
    wired.add(api);
    api.on('button', () => { v.focus(); });
  }
  fill(api, countView(v));
  api.open();
  return api;
}
