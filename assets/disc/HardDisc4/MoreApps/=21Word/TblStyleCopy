// TblStyleCopy - the table styles of a paste from another document
// made in the target's style table (Batch C6.2, D28; ./NumCopy's
// pattern; for ./ClipSlice and ./ClipPaste).
//
//   tableStyleIds(blocks) -> [id]  the tblStyle of every table in
//       blocks, at every depth (./Walk), each once
//   sourceStyles(doc, ids) -> Map id -> {style, m}  the source's side,
//       at copy time: each style of ids and every style it needs,
//       through basedOn and link (each once: a cycle ends), as the
//       source's Style objects (shared, never changed) with m, the
//       scope of the styles part's root (their raw is read in it).
//       Ids that name no style are passed over.
//   copyStyles(doc, src, ids) -> {ops, map}
//       src: sourceStyles' Map; ids: the source ids the pasted
//       tables name. For each one, and each style it needs (basedOn,
//       link): a target style of the same name and type (case
//       ignored, as ./ClipClean maps pStyle) is used as it is; a
//       name the target gives a style of another type maps to none
//       (the table then has the default table style); else the
//       source style is copied: its element cleaned for the target
//       (./NumClean cleanEl: nothing of the source package, w14 and
//       other namespaces left out, left and right spelled as the
//       target spells them), w:styleId the source's id or, when the
//       target has a style of that id, the first of id1, id2... that
//       is free, no w:default (the target keeps its defaults),
//       w:basedOn, w:link and w:next naming the target's ids (left
//       out when they map to none), read back as a Style
//       (./ReadStyles: raw is that element, written verbatim); a
//       style !Word made (raw null: Table Grid) is copied by its
//       fields. At most MAX_COPY (500) styles are copied by one
//       paste (the ids past it map to none, as does a style that
//       needs one past it: it is copied without that basedOn or
//       link); an entry of src whose key is not its style's id (a
//       forged one) names no style (C6 fix B5, C6a M6: no throw).
//       ops: ONE setDocPart styles op holding a NEW style
//       table (the target's styles the same objects, none changed
//       or dropped), none when nothing is copied; map: source id ->
//       target id for each id resolved (one mapping to none is not
//       in it).
//   restyle(blocks, map) -> blocks  every table (at every depth)
//       whose tblPr names a style: tblStyle map's id for it, or left
//       out when map has none (./TblNorm prWith); the same list when
//       nothing changes (./Walk mapBlocks)
// Pure: no desktop services.
import {NS} from './Wml';
import {rootScope, strictScope} from './Ns';
import {cleanEl, cleanExtra} from './NumClean';
import {crossPPr, crossRPr} from './ClipProps';
import {readStyles} from './ReadStyles';
import {addStyle} from './Styles';
import {isStrictDoc} from './JcName';
import {prWith} from './TblNorm';
import {walkBlocks, mapBlocks} from './Walk';

const isObj = (v) => v !== null && typeof v === 'object' &&
  !Array.isArray(v);
const listOf = (v) => (Array.isArray(v) || v instanceof Set ? [...v]
  : []);
const tableOf = (doc) => {
  const st = isObj(doc) ? doc.styles : null;
  return isObj(st) && st.styles instanceof Map ? st : null;
};
const nameKey = (s) => (typeof s.name === 'string'
  ? s.name.toLowerCase() : null);
const REFS = ['basedOn', 'link', 'next'];
export const MAX_COPY = 500;

/** See the header. */
export function tableStyleIds(blocks) {
  const out = new Set();
  for (const {b} of walkBlocks(Array.isArray(blocks) ? blocks : [])) {
    const id = b.type === 'tbl' && isObj(b.tblPr) && b.tblPr.tblStyle;
    if (typeof id === 'string') out.add(id);
  }
  return [...out];
}

/** The scope of style table st's root element. */
const rootOf = (st) => rootScope({name: st.rootName || 'w:styles',
  attrs: Array.isArray(st.rootAttrs) ? st.rootAttrs : []});

/** See the header. */
export function sourceStyles(doc, ids) {
  const out = new Map(), st = tableOf(doc);
  if (!st) return out;
  const m = rootOf(st), todo = listOf(ids);
  while (todo.length) {
    const id = todo.pop();
    if (typeof id !== 'string' || out.has(id)) continue;
    const style = st.styles.get(id);
    if (!isObj(style)) continue;
    out.set(id, {style, m});
    todo.push(style.basedOn, style.link);
  }
  return out;
}

/** id, or the first of id1, id2... not in taken. */
function freeId(id, taken) {
  if (!taken.has(id)) return id;
  for (let k = 1; ; k++) if (!taken.has(id + k)) return id + k;
}

/** The style's element with the target's ids (see the header). */
function element(e, nid, refs, strict, decl) {
  const c = cleanEl(e.style.raw, e.m, strict);
  if (!c || c.name !== 'w:style') return null;
  const attrs = c.attrs.filter(([k]) => k !== 'w:default');
  const at = attrs.findIndex(([k]) => k === 'w:styleId');
  if (at < 0) attrs.push(['w:styleId', nid]);
  else attrs[at] = ['w:styleId', nid];
  const children = [];
  for (const k of c.children) {
    const l = typeof k === 'string' ? '' : k.name.slice(2);
    if (!REFS.includes(l)) children.push(k);
    else if (refs[l] !== undefined) {
      children.push({name: k.name, attrs: [['w:val', refs[l]]],
        children: []});
    }
  }
  return {name: 'w:style', attrs: [...decl, ...attrs], children};
}

/** The copy of source entry e as a Style of the target. */
function made(e, nid, refs, strict, decl) {
  const s = e.style;
  const node = s.raw ? element(e, nid, refs, strict, decl) : null;
  if (node) {
    const mini = {name: 'w:styles', attrs: [['xmlns:w', NS.w]],
      children: [node]};
    const m = rootScope(mini);
    const got = readStyles(mini, strict ? strictScope(m) : m)
      .styles.get(nid);
    if (got) return got;
  }
  const o = {...s, id: nid, raw: null, extra: cleanExtra(s.extra,
    strict), pPr: crossPPr(s.pPr, strict), rPr: crossRPr(s.rPr,
    strict)};
  delete o.isDefault;
  for (const k of REFS) {
    if (refs[k] === undefined) delete o[k];
    else o[k] = refs[k];
  }
  return o;
}

/** Map type|name -> id of the target's styles (the first of each)
 *  and Map name -> type. */
function namesOf(st) {
  const byKey = new Map(), types = new Map();
  for (const s of st.styles.values()) {
    const n = isObj(s) && nameKey(s);
    if (!n) continue;
    if (!byKey.has(s.type + '|' + n)) byKey.set(s.type + '|' + n, s.id);
    if (!types.has(n)) types.set(n, s.type);
  }
  return {byKey, types};
}

/** See the header. */
export function copyStyles(doc, src, ids) {
  const map = new Map(), st = tableOf(doc);
  if (!st || !(src instanceof Map)) return {ops: [], map};
  const {byKey, types} = namesOf(st);
  const taken = new Set(st.styles.keys()), copy = [], seen = new Set();
  const todo = listOf(ids);
  while (todo.length) {
    const id = todo.pop();
    if (typeof id !== 'string' || seen.has(id)) continue;
    seen.add(id);
    const e = src.get(id), s = isObj(e) ? e.style : null;
    if (!isObj(s) || s.id !== id) continue;
    const n = nameKey(s);
    if (n && byKey.has(s.type + '|' + n)) {
      map.set(id, byKey.get(s.type + '|' + n));
      continue;
    }
    if ((n && types.has(n)) || copy.length >= MAX_COPY) continue;
    const nid = freeId(s.id, taken);
    taken.add(nid);
    map.set(id, nid);
    if (n) {
      byKey.set(s.type + '|' + n, nid);
      types.set(n, s.type);
    }
    copy.push(e);
    todo.push(s.basedOn, s.link);
  }
  if (!copy.length) return {ops: [], map};
  const strict = isStrictDoc(doc);
  const decl = rootOf(st).get('w') === NS.w ? []
    : [['xmlns:w', NS.w]];
  const out = {...st, styles: new Map(st.styles)};
  for (const e of copy) {
    const refs = {};
    for (const k of REFS) {
      const v = e.style[k];
      refs[k] = typeof v === 'string' ? map.get(v) : undefined;
    }
    addStyle(out, made(e, map.get(e.style.id), refs, strict, decl));
  }
  return {ops: [{op: 'setDocPart', key: 'styles', value: out}], map};
}

/** See the header. */
export const restyle = (blocks, map) => mapBlocks(blocks, (p) => p, {
  table: (t) => {
    const id = isObj(t.tblPr) ? t.tblPr.tblStyle : undefined;
    if (id === undefined) return t;
    const to = map instanceof Map ? map.get(id) : undefined;
    return to === id ? t : {...t, tblPr: prWith(t.tblPr,
      {tblStyle: to})};
  }});
