// InsertMenu - the Insert submenu of a document's window menu (after
// Edit):
//
//   insertMenu(dw) -> a Menu
//     Page break   Ctrl+Enter   the break at the caret (./InsertApply)
//     Section break >           Next page, Continuous (./SectBreak)
//     Symbol...                 the symbol grid (./SymbolBind)
//     Special character >       em dash, no-break space...
//                               (./SpecialChars, ./SymbolBind)
//     Hyperlink...  Ctrl+K      the Hyperlink box (./LinkBox)
//     Bookmark...   Ctrl+Shift+F5  the Bookmark box (./BookmarkBox)
//   sectionMenu(view) -> its Section break submenu
//
// Page break shows its key from ./Keymap ('Ctrl+Enter': Ctrl on a
// Mac too, ./MacKeys macLabel leaves it); the section breaks have no
// key; the special characters show theirs (Ctrl+Shift+Space, Ctrl+
// Shift+-), Hyperlink its (Ctrl+K; Cmd+K on a Mac), Bookmark its
// (Ctrl+Shift+F5, on a Mac too). Every item is shaded when there is
// no selection;
// each runs view.run(id) or types (./SymbolBind), so it is one undo
// step (./InsertApply, ./EditApply); Hyperlink and Bookmark open
// their boxes, whose OK and Add are one step. Everything of the
// window's: dw.view is its ./EditView.
import {Menu} from 'riscos';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';
import {SPECIAL} from './SpecialChars';
import {openSymbols, insertSpecial} from './SymbolBind';
import {linkBox} from './LinkBox';
import {bookmarkBox} from './BookmarkBox';

/** See the header. */
export function sectionMenu(v) {
  const none = () => !v.sel;
  const it = (text, id, help) => ({text, key: keymap.labelFor(id) ||
    undefined, shaded: none, action: () => v.run(id), help});
  return new Menu('Section break', [
    it('Next page', 'sectionNext', 'A section break: the text after ' +
      'it starts a new section, on a new page.'),
    it('Continuous', 'sectionContinuous', 'A section break: the ' +
      'text after it starts a new section, on the same page.'),
  ]);
}

/** The Special character submenu. */
function specialMenu(dw) {
  const v = dw.view;
  const keyOf = {nbsp: 'nbsp', nbHyphen: 'nbHyphen'};
  const items = SPECIAL.map((x) => ({text: x.text,
    key: macLabel(keymap.labelFor(keyOf[x.cmd] || ''), v.mac) ||
      undefined,
    shaded: () => !v.sel, action: () => { insertSpecial(dw, x); },
    help: x.ch ? `Put in ${x.text.toLowerCase()}, ${x.ch}.` :
      `Put in a ${x.text.toLowerCase()}.`}));
  return new Menu('Special character', items);
}

/** See the header. */
export function insertMenu(dw) {
  const v = dw.view;
  const k = (id) => macLabel(keymap.labelFor(id), v.mac);
  return new Menu('Insert', [
    {text: 'Page break', key: k('pageBreak') || undefined,
      shaded: () => !v.sel, action: () => v.run('pageBreak'),
      help: 'Start a new page here: a page break at the caret (the ' +
        'rest of the paragraph goes after it).'},
    {text: 'Section break', submenu: () => sectionMenu(v),
      shaded: () => !v.sel, dotted: true,
      help: 'Start a new section here, on a new page or on the ' +
        'same page.'},
    {text: 'Symbol...', shaded: () => !v.sel,
      action: () => { openSymbols(dw); },
      help: 'Choose a symbol or a special letter from a window of ' +
        'characters and put it in the text.'},
    {text: 'Special character', submenu: () => specialMenu(dw),
      shaded: () => !v.sel, dotted: true,
      help: 'Put in a dash, a no-break space or hyphen, a ' +
        'copyright sign, a quote and so on.'},
    {text: 'Hyperlink...', key: k('hyperlink') || undefined,
      shaded: () => !v.sel, action: () => { linkBox(dw); },
      help: 'Make the selected text a link to a web or e-mail ' +
        'address, or to a bookmark; on a link, change or remove it.'},
    {text: 'Bookmark...', key: k('bookmark') || undefined,
      shaded: () => !v.sel, action: () => { bookmarkBox(dw); },
      help: 'Name a place or the selected text, so you can go back ' +
        'to it or link to it; delete or go to a bookmark.'},
  ]);
}
