// RulerBind - the ruler of a document's window (./WinPanes): a pane
// under the toolbar (WimpLib Ui/Ruler) showing the page in inches
// from the text's left edge, its margins grey, and the indents of the
// first paragraph the selection touches (./RulerInd): the first line
// (the triangle at the top), the hanging indent (the triangle at the
// bottom: the left indent, the first line staying where it is), the
// left indent (the box under it: the first line moves with it) and
// the right indent (the triangle at the right). Dragging a marker
// moves it, snapped to 1/16 inch (Shift: free) and kept inside the
// text (WimpLib RulerMath.dragIndent), with a dotted line through it;
// the text stays as it is until the button is let go, wherever the
// pointer is: then every selected paragraph gets that indent, one
// undo step (view.format('indentDrag'): ./FormatPara.dragIndents).
//
// Tab stops: the same paragraph's stops in force (./FormatTabs
// rulerStops: its own black, its style's grey; WimpLib RulerTabs). A
// Select click on the ruler away from the markers adds a stop of the
// selector's kind there (snapped as the indents, inside the text); a
// click on the selector (the box at the left end) gives the next kind
// (left, centre, right, decimal: one kind per window, left at first);
// a stop dragged moves (snapped, Shift free), dragged down off the
// ruler goes. Each is one undo step for every selected paragraph,
// applied to each one's own stops (view.format('tabs'): a style's
// stop removed is written as a clear stop). A gesture the command
// refuses (a paragraph whose stops are kept raw, more than 64 of its
// own) changes nothing and beeps (the markers go back). The default
// stops (settings.xml's w:defaultTabStop, ./TabStops defaultStop:
// the same as the layout's) past the last stop are small grey marks
// at the ruler's foot (WimpLib RulerTabs defaultTicks).
//
// The markers come up to date from view.formatListeners (once a frame
// after the selection or the document changes), the scale on each
// move or scroll of the window (drawn again only when it changed).
// The page's margins are shown only: they cannot be dragged. At a
// zoom (view.zoom) the ruler is scaled with the page.
//
//   const rb = bindRuler(view, {task, parent, dy, menu})
//   rb.ruler            the Ui/Ruler
//   rb.kind             the selector's kind
//   rb.refresh()        scale and markers now
//   rb.show(on)         shown or hidden (./WinPanes moves the page)
//   rb.destroy()        listeners removed, the pane deleted
import {Ruler} from 'wimplib/Ui/Ruler';
import {indentMarks, dragIndent} from 'wimplib/RulerMath';
import {tabMarks, dragTab, addAt, nextKind, isTab, tabId,
  defaultTicks} from 'wimplib/RulerTabs';
import {RULER_H, firstPara, textTwips, scaleOf} from './RulerInd';
import {effective} from './ParaInd';
import {rulerStops} from './FormatTabs';
import {defaultStop} from './TabStops';

const D = '|MDrag it with SELECT (hold SHIFT to move it freely).';
const HELP = {
  first: 'The first line\'s indent.' + D,
  hanging: 'The hanging indent: the left edge of the lines after the ' +
    'first.' + D,
  left: 'The left indent: moves the first line too.' + D,
  right: 'The right indent.' + D,
};
const NAME = {left: 'left', center: 'centre', right: 'right',
  decimal: 'decimal'};
const TAB = {tabL: 'A left', tabC: 'A centre', tabR: 'A right',
  tabD: 'A decimal', tabBar: 'A bar'};
const tabHelp = (m) => TAB[m.kind] + ' tab stop' + (m.grey
  ? ', from the paragraph\'s style.' : '.') + D +
  '|MDrag it down off the ruler to remove it.';
const selHelp = (k) => 'Click SELECT on the ruler to add a ' +
  NAME[k] + ' tab stop.|MClick SELECT here for the next kind: left, ' +
  'centre, right, decimal.';

/** See the header. */
export function bindRuler(v, {task, parent, dy, menu}) {
  const ruler = new Ruler({task, parent, dy, height: RULER_H, menu,
    help: 'This is the ruler, in inches from the left margin; the ' +
      'margins are grey. The triangles and the box show the ' +
      'paragraph\'s indents.' + D + '|MClick SELECT on it to add a ' +
      'tab stop.'});
  let ind0 = null;                     // the indents shown
  let tabs0 = [];                      // the stops shown
  let ticks = [];                      // the default stops shown
  const marks = (ind, tabs) => [
    ...indentMarks(ind, textTwips(v.L))
      .map((m) => ({...m, help: HELP[m.id]})),
    ...tabMarks(tabs).map((m) => ({...m, help: tabHelp(m)}))];
  const scale = () => {
    if (parent.isOpen) {
      ruler.setScale({...scaleOf(v.L, parent.scrollX, v.zoom),
        ticks});
    }
  };
  const rb = {ruler, kind: 'left'};
  const refresh = () => {
    if (!ruler.dragging) {
      const p = v.sel && v.win.isOpen ? firstPara(v.d.doc, v.sel)
        : null;
      ind0 = p ? effective(v.d.doc, p) : null;
      tabs0 = p ? rulerStops(v.d.doc, p) : [];
      ticks = p ? defaultTicks(tabs0, defaultStop(v.d.doc),
        textTwips(v.L)) : [];
    }
    scale();
    ruler.setSelector(rb.kind, selHelp(rb.kind));
    if (ruler.dragging) return;
    ruler.setMarkers(ind0 ? marks(ind0, tabs0) : []);
  };
  const live = () => !!ind0 && !!v.sel && v.win.isOpen;
  // a gesture refused (a bad value, stops kept raw, too many): a beep
  const run = (id, arg) => {
    if (!v.format(id, arg)) ruler.beep();
  };
  const stopOf = (id) => tabs0.find((s) => tabId(s.pos) === id);
  ruler.on('drag', ({id, twips, free, remove}) => {
    if (!ind0) return;
    if (!isTab(id)) {
      ruler.setMarkers(marks(dragIndent(id, twips, ind0,
        textTwips(v.L), free), tabs0));
      return;
    }
    const r = remove ? null : dragTab(tabs0, id, twips, free,
      textTwips(v.L));
    ruler.setMarkers(marks(ind0, r ? r.stops
      : tabs0.filter((s) => tabId(s.pos) !== id)));
  });
  ruler.on('commit', ({id, twips, free, remove}) => {
    if (!live()) return;
    if (!isTab(id)) {
      run('indentDrag', {marker: id, at: twips,
        textW: textTwips(v.L), free});
      return;
    }
    const s = stopOf(id);
    if (!s) return;
    if (remove) { run('tabs', {remove: s.pos}); return; }
    const r = dragTab(tabs0, id, twips, free, textTwips(v.L));
    if (!r || r.to === r.from) return;
    const move = {from: r.from, to: r.to, val: s.val};
    if (s.leader) move.leader = s.leader;
    run('tabs', {move});
  });
  ruler.on('add', ({twips, free}) => {
    if (!live()) return;
    const r = addAt(tabs0, twips, rb.kind, free, textTwips(v.L));
    if (r) run('tabs', {add: r.stop});
  });
  ruler.on('selector', () => {
    rb.kind = nextKind(rb.kind);
    ruler.setSelector(rb.kind, selHelp(rb.kind));
  });
  // after every drag, committed or cancelled (no place to drop it):
  // the markers as the paragraph has them
  ruler.on('end', () => refresh());
  const listener = () => refresh();
  v.formatListeners.push(listener);
  const unpane = v.addPane(ruler.pane);
  const off = parent.on('moved', scale);
  refresh();
  return Object.assign(rb, {
    refresh,
    show(on) {
      ruler.show(on);
      refresh();
    },
    destroy() {
      const i = v.formatListeners.indexOf(listener);
      if (i >= 0) v.formatListeners.splice(i, 1);
      unpane();
      off();
      ruler.destroy();
    },
  });
}
