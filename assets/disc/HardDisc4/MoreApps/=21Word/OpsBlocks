// OpsBlocks - removeBlocks and insertBlocks: many blocks of one
// container (a section, or a cell: `at` is a ./Path path) in one op,
// in time linear in the container's size (deleting a selection of
// 40,000 paragraphs is one op, not 40,000).
//
//   removeBlocks {at, count}  -> insertBlocks
//   insertBlocks {at, blocks} -> removeBlocks
//
// insertBlocks checks every block (a table's nesting counted from
// the path's depth), and that no paragraph or table id, at any
// depth, is used twice (among the new blocks or in the document):
// one pass over the document, not one per block (./OpsUtil
// checkIds). A cell keeps at least one block, and never ends with a
// table (./TblCheck endsCell): refused before any change.
import {fail, checkBlock} from './ModelCheck';
import {checkTail} from './TblCheck';
import {locate, own, checkIds} from './OpsUtil';

/** {op:'removeBlocks', at, count}: count >= 1 blocks from at. */
export function removeBlocks(doc, op) {
  const {i, at, blocks, nested} = locate(doc, op.at);
  const n = op.count;
  if (!Number.isInteger(n) || n < 1 || i + n > blocks.length)
    fail('bad count ' + n);
  if (nested && n === blocks.length)
    fail('a cell needs at least one block');
  if (nested && i + n === blocks.length) checkTail(blocks[i - 1]);
  const gone = own(doc, at).splice(i, n);
  return {op: 'insertBlocks', at, blocks: gone};
}

/** {op:'insertBlocks', at, blocks}: blocks (>= 1) put before at. */
export function insertBlocks(doc, op) {
  const {i, at, depth, blocks: bs, nested} = locate(doc, op.at, true);
  const add = op.blocks;
  if (!Array.isArray(add) || !add.length) fail('no blocks to insert');
  if (nested && i === bs.length) checkTail(add[add.length - 1]);
  for (const b of add) checkBlock(b, depth);
  checkIds(doc, add);
  const blocks = own(doc, at);
  const tail = blocks.splice(i);
  for (const b of add) blocks.push(b);
  for (const b of tail) blocks.push(b);
  return {op: 'removeBlocks', at, count: add.length};
}
