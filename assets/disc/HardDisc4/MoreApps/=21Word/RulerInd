// RulerInd - what a document's ruler (./RulerBind) shows, worked out
// from the document and its layout:
//
//   RULER_H              the ruler's height (px)
//   firstIndents(doc, sel) -> {left, first, right} | null  the
//       indents drawn (twips: ./ParaInd.effective, a list level's
//       too; first < 0 for a hanging indent: a list label's place)
//       of the first paragraph the selection touches
//       (a kept block at its start: the next paragraph in it); null
//       when there is none (no selection, a caret on a table)
//   firstPara(doc, sel) -> the first 'p' block the selection
//       touches (as above), or null
//   textTwips(L)         the text's width (twips) of a ./DocLayout
//   scaleOf(L, scrollX, zoom = 1) -> the WimpLib Ui/Ruler scale:
//       origin (the text's left edge), page and text [x0, x1] (px in
//       the window's work area: L's px times the zoom, a factor:
//       ./Zoom), zoom, scrollX
// Pure: no desktop services.
import {orderedPos} from './EditPos';
import {effective} from './ParaInd';

export const RULER_H = 24;

/** See the header. */
export function firstPara(doc, sel) {
  const o = sel && sel.anchor && sel.head ? orderedPos(doc, sel) : null;
  if (!o) return null;
  const secs = doc.sections;
  for (let s = o.f.s; s <= o.t.s; s++) {
    const bs = secs[s].blocks;
    const i1 = s === o.t.s ? o.t.i : bs.length - 1;
    for (let i = s === o.f.s ? o.f.i : 0; i <= i1; i++) {
      if (bs[i].type === 'p') return bs[i];
    }
  }
  return null;
}

/** See the header. */
export function firstIndents(doc, sel) {
  const p = firstPara(doc, sel);
  if (!p) return null;
  return effective(doc, p);
}

/** See the header. */
export const textTwips = (L) => Math.round(L.textW * 15);

/** See the header. */
export function scaleOf(L, scrollX, zoom = 1) {
  const z = zoom;
  return {origin: L.left * z,
    page: [L.pageLeft * z, (L.pageLeft + L.pageW) * z],
    text: [L.left * z, (L.left + L.textW) * z], zoom: z, scrollX};
}
