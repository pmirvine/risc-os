// Layout - a whole document laid out for a window of a given width,
// and drawn: the grey band with the info line, then the paragraphs.
//
//   const L = new Layout(doc, measure)
//   L.layout(width)       break every paragraph for this width;
//                         returns the height of the work area
//   L.paint(g, rect, summary)  draw what lies in rect (work area)
//   L.items               [{block, y, h, lines?, label?}]
//
// Every paragraph is laid out (words are measured once, ./Render's
// makeMeasure caches them), but only the ones in view are drawn:
// they are found by a binary search on their positions.
import {layoutPara} from './Render';
import {kindOf} from './Info';

export const HEAD = 28;                // the info band
const M = 16;                          // the margins
const BOX = 28;                        // a preserved block

export class Layout {
  constructor(doc, measure) {
    this.doc = doc;
    this.measure = measure;
    this.cache = new Map();            // run formats (./Fmt)
    this.items = [];
    this.width = 0;
    this.height = HEAD;
    for (const s of doc.sections) {
      for (const b of s.blocks) this.items.push({block: b, y: 0, h: 0});
    }
  }

  layout(width) {
    this.width = width;
    const w = Math.max(80, width - 2 * M);
    let y = HEAD + 8;
    for (const it of this.items) {
      const b = it.block;
      if (b.type === 'p') {
        const l = layoutPara(b, this.doc.styles, w, this.measure,
          this.cache);
        it.lines = l.lines;
        it.h = l.h;
      } else {
        const k = kindOf(b.node);
        it.label = `[${k} - preserved, not shown]`;
        it.h = BOX + 12;
      }
      it.y = y;
      y += it.h;
    }
    this.height = y + M;
    return this.height;
  }

  /** The index of the first item that ends below y. */
  find(y) {
    let lo = 0, hi = this.items.length;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      const it = this.items[mid];
      if (it.y + it.h <= y) lo = mid + 1;
      else hi = mid;
    }
    return lo;
  }

  paint(g, rect, summary) {
    g.textBaseline = 'alphabetic';
    if (rect.y0 < HEAD) {
      g.fillStyle = '#dddddd';
      g.fillRect(rect.x0, 0, rect.x1 - rect.x0, HEAD);
      g.fillStyle = '#999999';
      g.fillRect(rect.x0, HEAD - 1, rect.x1 - rect.x0, 1);
      g.fillStyle = '#000000';
      g.font = '14px "Homerton", "Liberation Sans", sans-serif';
      g.fillText(summary, M - 8, 19);
    }
    for (let i = this.find(rect.y0); i < this.items.length; i++) {
      const it = this.items[i];
      if (it.y >= rect.y1) break;
      if (it.lines) this.paintPara(g, it, rect);
      else this.paintBox(g, it);
    }
  }

  paintPara(g, it, rect) {
    for (const ln of it.lines) {
      const top = it.y + ln.y;
      if (top >= rect.y1 || top + ln.h <= rect.y0) continue;
      const base = top + ln.base;
      for (const x of ln.items) {
        if (!x.text) continue;
        const f = x.f;
        const left = M + x.x;
        if (x.kind === 'box') {
          g.strokeStyle = '#a0a0a0';
          g.lineWidth = 1;
          const h = f.px * 1.3;
          g.strokeRect(Math.round(left) + 0.5,
            Math.round(base - f.px) + 0.5, Math.round(x.w - 2),
            Math.round(h));
          g.fillStyle = f.colour;
          g.font = f.css;
          g.fillText(x.text, left + 2, base);
          continue;
        }
        g.fillStyle = f.colour;
        if (g.font !== f.css) g.font = f.css;
        g.fillText(x.text, left, base);
        const t = Math.max(1, Math.round(f.px / 14));
        if (f.under) g.fillRect(left, base + 2, x.w, t);
        if (f.strike) g.fillRect(left, base - f.px * 0.3, x.w, t);
      }
    }
  }

  paintBox(g, it) {
    const x = M, y = it.y + 6, w = Math.max(80, this.width - 2 * M);
    g.fillStyle = '#eeeeee';
    g.fillRect(x, y, w, BOX);
    g.strokeStyle = '#888888';
    g.lineWidth = 1;
    g.strokeRect(x + 0.5, y + 0.5, w - 1, BOX - 1);
    g.fillStyle = '#555555';
    g.font = 'italic 13px "Liberation Sans", sans-serif';
    g.fillText(it.label, x + 10, y + 18);
  }
}
