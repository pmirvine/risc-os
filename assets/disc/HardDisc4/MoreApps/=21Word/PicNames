// PicNames - the media names new pictures take (pure; Batch B, plan
// R6). One rule for ./InsertPicture and ./ClipPics.
//
//   usedNumbers(doc, dir) -> Set of N
//       the numbers N of every <dir>media/imageN.<any extension>
//       that a part of doc.parts, a content-type Override or an
//       internal relationship's target names (case ignored): a
//       relationship whose part is missing still holds its name
//   mediaName(doc, dir, ext, used) -> name
//       the first <dir>media/imageN.ext, N from 1, not in `used` and
//       free as a new part (./OpsDoc newPartFree); N is then added to
//       `used`. At most max(used.size + 2, 1024) numbers are tried:
//       none free is RangeError 'name'.
// dir: the main part's folder ('word/'); doc.meta.mainPart set.
import {newPartFree} from './OpsDoc';
import {resolvePart} from './Rels';

/** See the header. */
export function usedNumbers(doc, dir) {
  const used = new Set();
  const pre = (dir + 'media/image').toLowerCase();
  const meta = doc.meta || {};
  const ct = meta.contentTypes, main = meta.mainPart;
  const over = ct && Array.isArray(ct.overrides) ? ct.overrides : [];
  const rels = Array.isArray(doc.rels) ? doc.rels : [];
  const names = [
    ...(doc.parts instanceof Map ? doc.parts.keys() : []),
    ...over.map((o) => String(o && o[0]).replace(/^\//, '')),
    ...rels.filter((r) => r && r.mode !== 'External' &&
      typeof r.target === 'string' && typeof main === 'string')
      .map((r) => resolvePart(main, r.target)),
  ];
  for (const k of names) {
    const lc = String(k).toLowerCase();
    if (!lc.startsWith(pre)) continue;
    const m = /^(\d+)\.[^./]*$/.exec(lc.slice(pre.length));
    if (m) used.add(Number(m[1]));
  }
  return used;
}

/** See the header. */
export function mediaName(doc, dir, ext, used) {
  const most = Math.max(used.size + 2, 1024);
  for (let k = 1; k <= most; k++) {
    const name = dir + 'media/image' + k + '.' + ext;
    if (used.has(k) || !newPartFree(doc, name)) continue;
    used.add(k);
    return name;
  }
  throw new RangeError('name');
}
