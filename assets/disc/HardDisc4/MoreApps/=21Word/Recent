// Recent - the list of files recently opened or saved (pure: no
// desktop services). ./RecentFiles keeps it in Choices:Word and
// makes the icon bar menu's Recent submenu from it.
//
//   MAX                    8: the most the list holds
//   clean(list, keyOf, max)  a safe list: full paths only (strings
//                          with a ':' or '$', at most 1024 characters,
//                          no control characters), the first of any
//                          that have the same keyOf (the canonical
//                          path, lower case; default: lower case), max
//                          at most. Anything but an array is []. An
//                          entry whose keyOf throws is dropped
//   add(list, path, keyOf, max)  path first, then the rest (a new
//                          list: the one given is not changed)
//   fromChoices(c, keyOf)  clean(c.recent): the choices as read (any
//                          value: missing or corrupt ones give [])
//   shown(list, exists)    those that exist (exists(path) may throw)
//   labels(list)           the menu's text for each: the leaf name,
//                          or, for leaves that are the same in two
//                          entries (case ignored), the path, cut to
//                          its last 40 characters ('...' first)

export const MAX = 8;
const LONG = 1024, CUT = 40;
const lower = (p) => p.toLowerCase();

/** A full path a file can have (not '__proto__' and the like). */
function usable(p) {
  return typeof p === 'string' && p.length > 0 && p.length <= LONG &&
    /[:$]/.test(p) && !/[\x00-\x1f\x7f]/.test(p);
}

/** See the header. */
export function clean(list, keyOf = lower, max = MAX) {
  const out = [], seen = new Set();
  if (!Array.isArray(list)) return out;
  for (let i = 0; i < list.length && out.length < max; i++) {
    const p = list[i];
    if (!usable(p)) continue;
    let k;
    try { k = String(keyOf(p)); } catch (e) { continue; }
    if (seen.has(k)) continue;
    seen.add(k);
    out.push(p);
  }
  return out;
}

/** See the header. */
export function add(list, path, keyOf = lower, max = MAX) {
  return clean([path, ...(Array.isArray(list) ? list : [])], keyOf,
    max);
}

/** See the header. */
export function fromChoices(c, keyOf = lower) {
  if (!c || typeof c !== 'object' || Array.isArray(c)) return [];
  if (!Object.prototype.hasOwnProperty.call(c, 'recent')) return [];
  return clean(c.recent, keyOf);
}

/** See the header. */
export function shown(list, exists) {
  if (!Array.isArray(list)) return [];
  return list.filter((p) => {
    try { return !!exists(p); } catch (e) { return false; }
  });
}

/** The last part of a path. */
function leaf(p) {
  return p.slice(Math.max(p.lastIndexOf('.'), p.lastIndexOf(':')) + 1);
}

/** See the header. */
export function labels(list) {
  const n = new Map();
  for (const p of list) {
    const k = lower(leaf(p));
    n.set(k, (n.get(k) || 0) + 1);
  }
  return list.map((p) => {
    if (n.get(lower(leaf(p))) < 2) return leaf(p);
    return p.length <= CUT ? p : '...' + p.slice(p.length - CUT + 3);
  });
}
