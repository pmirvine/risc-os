// BreakMarks - page and column breaks on the screen: which inlines
// they are, their labels, and the geometry of the rule that shows
// one (for ./LineTokens, ./LineLayout, ./PositionMap and ./DocPaint).
//
//   isPageBreak(x)    -> true for a br inline of brType 'page' or
//                        'column' (any other br, or none, is a line
//                        break or nothing: false)
//   breakLabel(x)     -> 'Page break', 'Column break', or ''
//   pbToken(x, i, f)  -> the ./LineTokens token for x at offset i:
//                        {t: 'pb', text: '', f, kind: 'pagebreak',
//                        from: i, to: i + 1, shown: true, label}
//   ruleFit(x, maxX, real) -> {wrap, w}: where the rule goes when
//                        the line's text ends at x and the line may
//                        reach maxX; real: the line already holds
//                        something drawn
//   ruleLit(it)       -> [x0, x1]: the part of a rule item lit when
//                        its break is selected
//   rulePaint(it, labelW) -> {y, label: x, dots: [[x0, x1]...]}:
//                        a rule item drawn (x in the line's items'
//                        coordinates, y the share of the line's
//                        height from its top)
//   MIN_RULE, LIT
//
// A break is one character (U+FFFC, one offset). It ends its line
// (endsWithBreak); the rest of that line, at least MIN_RULE (90 px)
// wide, is a grey dotted rule with its label in the middle: when
// less than that is left on a line that holds something, the rule
// goes to the next line first (wrap); on a narrower page it is
// MIN_RULE wide all the same. The rule is atomic (a click in it puts
// the caret at its nearer edge) and is display only: its label is
// not text. Selected, only its first LIT (8) px are lit (the break's
// offset is in the selection; the rule itself is never highlighted,
// nor painted with a highlight colour). Pure: no desktop services.

export const MIN_RULE = 90;
export const LIT = 8;

const LABELS = new Map([['page', 'Page break'],
  ['column', 'Column break']]);

/** See the header. */
export const isPageBreak = (x) => !!x && typeof x === 'object' &&
  x.kind === 'br' && typeof x.brType === 'string' &&
  LABELS.has(x.brType);

/** See the header. */
export const breakLabel = (x) => (isPageBreak(x)
  ? LABELS.get(x.brType) : '');

/** See the header. */
export const pbToken = (x, i, f) => ({t: 'pb', text: '', f,
  kind: 'pagebreak', from: i, to: i + 1, shown: true,
  label: breakLabel(x)});

/** See the header. */
export function ruleFit(x, maxX, real) {
  const room = maxX - x;
  if (room >= MIN_RULE) return {wrap: false, w: room};
  return {wrap: !!real, w: MIN_RULE};
}

/** See the header. */
export const ruleLit = (it) => [it.x, it.x + Math.min(LIT, it.w)];

/** See the header. */
export function rulePaint(it, labelW) {
  const pad = 6, lw = Math.max(0, +labelW || 0);
  const mid = it.x + it.w / 2;
  const fits = lw > 0 && lw + 2 * pad <= it.w;
  const a = fits ? mid - lw / 2 - pad : mid;
  const b = fits ? mid + lw / 2 + pad : mid;
  const dots = [];
  if (a > it.x) dots.push([it.x, a]);
  if (it.x + it.w > b) dots.push([b, it.x + it.w]);
  if (!fits) dots.splice(0, dots.length, [it.x, it.x + it.w]);
  return {y: 0.5, label: fits ? mid - lw / 2 : null, dots};
}
