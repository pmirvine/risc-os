// SaveState - names and states for saving documents (pure: no
// desktop services).
//
//   untitledName(taken)  'Untitled', else 'Untitled 2', 'Untitled 3'
//                        ...: the first not in taken (names of the
//                        open untitled documents; case ignored)
//   safeLeaf(name)       a leaf name a file can have: the characters
//                        a RISC OS name cannot hold (spaces, . : * #
//                        $ & @ ^ % \ " | and control characters) left
//                        out; 'Untitled' if nothing is left. So the
//                        window 'Untitled 2' is saved as 'Untitled2'
//   leafOf(path)         the last part of a path ('Report')
//   dirOf(path)          its directory ('RAM::RamDisc0.$'), or null
//                        for a name with none (or a disc's root)
//   defaultDir(recent)   where to offer to save an untitled document:
//                        the directory of the first full path in
//                        recent (newest first), else HOME
//   HOME                 'ADFS::HardDisc4.$', the hard disc's root
//   suggestName(dw, dir = HOME, exists)  the Save box's name: the
//                        document's path, or for an untitled one
//                        dir.safeLeaf (a full path, so that OK works
//                        as well as dragging the icon); if exists(p)
//                        says that file is there, the next free one:
//                        dir.Untitled2, dir.Untitled3 ... (the
//                        digits at the end of the leaf counted on)

export const HOME = 'ADFS::HardDisc4.$';
const BASE = 'Untitled';
const BAD = /[\s.:*#$&@^%\\"|\x00-\x1f\x7f]/g;

/** See the header. */
export function untitledName(taken) {
  const used = new Set();
  for (const t of taken || []) {
    if (typeof t === 'string') used.add(t.toLowerCase());
  }
  if (!used.has(BASE.toLowerCase())) return BASE;
  for (let n = 2; ; n++) {
    const name = `${BASE} ${n}`;
    if (!used.has(name.toLowerCase())) return name;
  }
}

/** See the header. */
export function safeLeaf(name) {
  const s = typeof name === 'string' ? name.replace(BAD, '') : '';
  return s || BASE;
}

/** See the header. */
export function leafOf(path) {
  const s = String(path ?? '');
  return s.slice(Math.max(s.lastIndexOf('.'), s.lastIndexOf(':')) + 1);
}

/** See the header. */
export function dirOf(path) {
  if (typeof path !== 'string') return null;
  const i = path.lastIndexOf('.');
  if (i <= 0 || i < path.lastIndexOf(':')) return null;
  if (path.endsWith('$')) return null;
  return path.slice(0, i);
}

/** See the header. */
export function defaultDir(recent) {
  for (const p of recent || []) {
    const d = dirOf(p);
    if (d) return d;
  }
  return HOME;
}

/** See the header. */
export function suggestName(dw, dir = HOME, exists = () => false) {
  if (dw.path) return dw.path;
  const leaf = safeLeaf(dw.leaf);
  const there = (p) => { try { return !!exists(p); } catch (e) {
    return false; } };
  if (!there(`${dir}.${leaf}`)) return `${dir}.${leaf}`;
  const m = /^(.*?)(\d*)$/.exec(leaf);
  const stem = m[1] || leaf;
  for (let n = Math.max(2, +m[2] + 1 || 2); n < 100000; n++) {
    const p = `${dir}.${stem}${n}`;
    if (!there(p)) return p;
  }
  return `${dir}.${leaf}`;
}
