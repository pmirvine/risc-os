// ClipCss - the few CSS values ./ClipRead takes from pasted HTML, each
// checked; anything else, and any value that does not pass, is
// ignored. The HTML is untrusted: nothing here is ever evaluated,
// fetched or kept as written.
//
//   parseStyle(text, pt) -> patch   a style attribute (the first 4096
//                                   characters only); pt: the size
//                                   in force (for em and %)
//   colour(v)  -> 'RRGGBB' | undefined   #rgb, #rrggbb, rgb(r,g,b)
//                 (0..255), rgba() with an alpha above 0 (alpha 0,
//                 transparent: none), a few colour names; hsl(),
//                 hsla() and transparent are not read
//   family(v)  -> a font name | undefined   the first family of a
//                 list, quotes stripped, 1..64 letters, digits,
//                 spaces and . _ & + -; generic families ignored
//   fontSize(v, pt) -> half-points 2..800 | undefined  pt, px, em,
//                 rem, % and the size keywords; clamped to 1..400 pt
//   fontTagSize(v) -> half-points | undefined   <font size=1..7>
//
// patch: {b, i, u, strike, vert, color, sz, font, pre, jc, hidden},
// each only when given: font-weight (bold, bolder, 600 and up: b
// true; normal, lighter, below 600: false), font-style (italic,
// oblique / normal), text-decoration(-line) (underline: u,
// line-through: strike; none changes nothing, as in CSS),
// vertical-align (super, sub, baseline), color, font-family,
// font-size, white-space (pre, pre-wrap, break-spaces: pre true;
// normal, nowrap, pre-line: false), text-align (left start, center,
// right end, justify: jc 'left' 'center' 'right' 'both'), display:
// none and mso-hide: all and mso-list: ignore (Word's list labels):
// hidden. A value holding url(, expression, a backslash, a comment,
// @, < > { } or a control character is ignored whole.
// Pure: no desktop services.

const MAX = 4096;
const BAD = /url\s*\(|expression|javascript|\\|\/\*|@|[<>{}]/i;
const CTL = /[\u0000-\u001f\u007f]/;
const RGB = new RegExp('^rgba?\\(\\s*(\\d{1,3})\\s*,\\s*(\\d{1,3})' +
  '\\s*,\\s*(\\d{1,3})\\s*(?:,\\s*([\\d.]{1,8}%?)\\s*)?\\)$');
const NAMES = {black: '000000', white: 'FFFFFF', red: 'FF0000',
  green: '008000', blue: '0000FF', yellow: 'FFFF00', gray: '808080',
  grey: '808080', silver: 'C0C0C0', maroon: '800000',
  purple: '800080', navy: '000080', teal: '008080', olive: '808000',
  lime: '00FF00', aqua: '00FFFF', fuchsia: 'FF00FF',
  orange: 'FFA500'};
const GENERIC = new Set(['serif', 'sans-serif', 'monospace', 'cursive',
  'fantasy', 'system-ui', 'inherit', 'initial', 'unset', 'default',
  'ui-serif', 'ui-sans-serif', 'ui-monospace', '-apple-system']);
const KEYWORD = {'xx-small': 7, 'x-small': 7.5, small: 10, medium: 12,
  large: 13.5, 'x-large': 18, 'xx-large': 24};
const TAG_PT = [7.5, 10, 12, 13.5, 18, 24, 36];
const ALIGN = {left: 'left', start: 'left', center: 'center',
  right: 'right', end: 'right', justify: 'both'};

const hex2 = (n) => (n | 256).toString(16).slice(1).toUpperCase();

/** See the header. */
export function colour(v) {
  const s = String(v).trim().toLowerCase();
  let m = /^#([0-9a-f])([0-9a-f])([0-9a-f])$/.exec(s);
  if (m) return (m[1] + m[1] + m[2] + m[2] + m[3] + m[3]).toUpperCase();
  m = /^#([0-9a-f]{6})$/.exec(s);
  if (m) return m[1].toUpperCase();
  m = RGB.exec(s);
  if (m) {
    // a transparent colour (alpha 0) is no colour
    if (m[4] !== undefined && !(parseFloat(m[4]) > 0)) return undefined;
    const c = [m[1], m[2], m[3]].map(Number);
    return c.every((n) => n <= 255) ? c.map(hex2).join('') : undefined;
  }
  return Object.hasOwn(NAMES, s) ? NAMES[s] : undefined;
}

/** See the header. */
export function family(v) {
  const first = String(v).split(',')[0].trim()
    .replace(/^(['"])(.*)\1$/, '$2').trim();
  if (GENERIC.has(first.toLowerCase())) return undefined;
  return /^[\p{L}\p{N} ._&+-]{1,64}$/u.test(first) ? first : undefined;
}

const half = (pt) => Math.min(800, Math.max(2, Math.round(pt * 2)));

/** See the header. */
export function fontSize(v, pt) {
  const s = String(v).trim().toLowerCase();
  if (Object.hasOwn(KEYWORD, s)) return half(KEYWORD[s]);
  const m = /^(\d{1,6}(?:\.\d{1,3})?)(pt|px|em|rem|%)$/.exec(s);
  if (!m) return undefined;
  const n = Number(m[1]);
  const base = Number.isFinite(pt) && pt > 0 ? pt : 11;
  const p = m[2] === 'pt' ? n : m[2] === 'px' ? n * 0.75
    : m[2] === '%' ? base * n / 100 : m[2] === 'rem' ? n * 12
      : base * n;
  return half(p);
}

/** See the header. */
export function fontTagSize(v) {
  const n = Number(String(v).trim());
  return Number.isInteger(n) && n >= 1 && n <= 7 ? half(TAG_PT[n - 1])
    : undefined;
}

function weight(v) {
  if (v === 'bold' || v === 'bolder') return true;
  if (v === 'normal' || v === 'lighter') return false;
  return /^\d{3}$/.test(v) ? Number(v) >= 600 : undefined;
}

/** One declaration into patch p. */
function decl(p, k, raw, pt) {
  const v = raw.toLowerCase();
  switch (k) {
    case 'font-weight': p.b = weight(v); break;
    case 'font-style':
      p.i = v === 'italic' || v === 'oblique' ? true
        : v === 'normal' ? false : undefined;
      break;
    case 'text-decoration': case 'text-decoration-line':
      if (/\bunderline\b/.test(v)) p.u = true;
      if (/\bline-through\b/.test(v)) p.strike = true;
      break;
    case 'vertical-align':
      p.vert = v === 'super' ? 'superscript' : v === 'sub'
        ? 'subscript' : v === 'baseline' ? 'baseline' : undefined;
      break;
    case 'color': p.color = colour(v); break;
    case 'font-family': p.font = family(raw); break;
    case 'font-size': p.sz = fontSize(v, pt); break;
    case 'white-space':
      p.pre = /^(pre|pre-wrap|break-spaces)$/.test(v) ? true
        : /^(normal|nowrap|pre-line)$/.test(v) ? false : undefined;
      break;
    case 'text-align':
      p.jc = Object.hasOwn(ALIGN, v) ? ALIGN[v] : undefined;
      break;
    case 'display': if (v === 'none') p.hidden = true; break;
    case 'mso-hide': if (v === 'all') p.hidden = true; break;
    case 'mso-list': if (v === 'ignore') p.hidden = true; break;
    default:
  }
}

/** See the header. */
export function parseStyle(text, pt) {
  const p = {};
  if (typeof text !== 'string' || !text) return p;
  for (const d of text.slice(0, MAX).split(';')) {
    const c = d.indexOf(':');
    if (c < 1) continue;
    const k = d.slice(0, c).trim().toLowerCase();
    const v = d.slice(c + 1).replace(/!\s*important\s*$/i, '').trim();
    if (!v || v.length > 200 || BAD.test(v) ||
      CTL.test(v)) continue;
    decl(p, k, v, pt);
  }
  for (const k of Object.keys(p)) if (p[k] === undefined) delete p[k];
  return p;
}
