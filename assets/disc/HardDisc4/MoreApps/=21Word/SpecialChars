// SpecialChars - the items of Insert > Special character, as data
// (./InsertMenu builds the menu, ./SymbolBind runs them):
//
//   SPECIAL   [{text, ch} | {text, cmd}]  in menu order
//     ch    a character typed as text at the caret (view.input: with
//           the pending format, one undo step, the typing's own rules)
//     cmd   a ./Keymap command id for view.run: 'nbsp' (a no-break
//           space, Ctrl+Shift+Space), 'nbHyphen' (Ctrl+Shift+-),
//           'softHyphen' (Optional hyphen: no key)
//   specialFor(text) -> the item or null
//
// Every ch is in a set of WimpLib CharSets (a test proves it), so the
// bundled fonts all draw it. Pure: no desktop services.

export const SPECIAL = Object.freeze([
  {text: 'Em dash', ch: '\u2014'},
  {text: 'En dash', ch: '\u2013'},
  {text: 'Non-breaking space', cmd: 'nbsp'},
  {text: 'Non-breaking hyphen', cmd: 'nbHyphen'},
  {text: 'Optional hyphen', cmd: 'softHyphen'},
  {text: 'Copyright', ch: '\u00A9'},
  {text: 'Registered', ch: '\u00AE'},
  {text: 'Trademark', ch: '\u2122'},
  {text: 'Section', ch: '\u00A7'},
  {text: 'Paragraph', ch: '\u00B6'},
  {text: 'Ellipsis', ch: '\u2026'},
  {text: 'Single opening quote', ch: '\u2018'},
  {text: 'Single closing quote', ch: '\u2019'},
  {text: 'Double opening quote', ch: '\u201C'},
  {text: 'Double closing quote', ch: '\u201D'},
  {text: 'Degree', ch: '\u00B0'},
].map((x) => Object.freeze(x)));

/** See the header. */
export const specialFor = (text) =>
  SPECIAL.find((x) => x.text === text) || null;
