// Word - a word processor for Microsoft Word documents (.docx).
//
// It opens .docx files (double-click one, or drop it on Word's icon)
// and shows their text, with a caret and a selection; text can be
// typed, deleted and formatted, with undo and redo, and saved
// (everything it does not show is kept): Save, Save as, Save a copy.
// New documents come from the icon bar icon (./IconBar); recently
// used files are under Recent (./RecentFiles); quitting asks first
// about unsaved changes (./Quit).
//
// !RunImage is where it starts: one Word at a time, opening files,
// the messages. A document's window is ./AppWin; reading files is
// ./Open; the info line and the Info boxes are ./Info.
import {wimp, vfs, reportError} from 'riscos';
import {openDocx, describe} from './Open';
import {DocWindow} from './AppWin';
import {loadFonts} from './FontLoad';
import {fontsToLoad} from './FontMap';
import {facts} from './Info';
import {newDoc} from './NewDoc';
import {loadRecent, noteRecent} from './RecentFiles';
import {preQuit} from './Quit';
import {addIcon} from './IconBar';
import {testHook} from './TestHook';

const DOCX = 0xA7E;
const say = (m) => reportError(m, {appName: 'Word'});

export default async function start(task, ctx) {
  const file = ctx.argv[0];
  // only one Word at a time: pass the file to the one running
  const other = wimp.tasks.find((t) => t !== task && t.alive &&
    t.name === task.name);
  if (other) {
    if (file) {
      wimp.sendMessage('DataOpen', {path: file, filetype: DOCX},
        {to: other});
    }
    task.quit();
    return;
  }

  // the bundled fonts a document is shown in (each is loaded once),
  // with Liberation Sans when it uses a font that is not bundled: it
  // is shown without them if they take too long, and laid out again
  // when they arrive
  const fontsFor = (doc) => {
    const want = fontsToLoad(facts(doc).fonts);
    return loadFonts(vfs, `${ctx.dir}.Fonts`, undefined, want)
      .catch(() => null);
  };

  // canonical path (lower case, with a '$') -> DocWindow; a name
  // that is not a path: '?name'; an untitled one: 'untitled:N'
  const docs = new Map();
  let untitled = 0;
  const keyOf = (path) => {
    try { return vfs.canonical(path).toLowerCase(); }
    catch (e) { return '?' + String(path).toLowerCase(); }
  };
  const opening = new Map();           // key -> Promise (in progress)
  const app = {
    task, docs, keyOf, recent: [], fonts: fontsFor,
    prompt: null, closing: null,       // (./CloseDoc, ./Quit)
    /** Open a .docx (or bring its window to the front). */
    open(path) {
      const key = keyOf(path);
      const had = docs.get(key);
      if (had) { had.show(); return Promise.resolve(had); }
      if (!opening.has(key)) {
        opening.set(key, load(path, key)
          .finally(() => opening.delete(key)));
      }
      return opening.get(key);
    },
    closed(dw) {
      for (const [k, v] of docs) if (v === dw) docs.delete(k);
    },
    /** dw has a new path (or none): its key again. */
    rekey(dw) {
      app.closed(dw);
      if (dw.closed) return;           // (closed: not put back)
      docs.set(dw.path ? keyOf(dw.path) : `untitled:${++untitled}`,
        dw);
    },
    /** A new, empty, untitled document (paper 'a4' or 'letter'). */
    async newDoc(o) {
      const paper = o && o.paper === 'letter' ? 'letter' : 'a4';
      return place(null, `untitled:${++untitled}`, newDoc({paper}));
    },
    /** path was opened or saved (./RecentFiles). */
    noteRecent: (path) => noteRecent(app, path),
  };
  async function load(path, key) {
    let doc;
    try {
      doc = await openDocx(vfs, path);
    } catch (e) {
      say(describe(e, vfs.leaf(path)));
      return null;
    }
    if (!task.alive) return null;
    app.noteRecent(path);
    return place(path, key, doc);
  }
  async function place(path, key, doc) {
    const fonts = fontsFor(doc);
    await Promise.race([fonts,
      new Promise((res) => setTimeout(res, 2500))]);
    if (!task.alive) return null;
    const dw = new DocWindow(app, path, doc);
    docs.set(key, dw);
    dw.show();
    fonts.then(() => {
      if ([...docs.values()].includes(dw)) dw.relayout();
    });
    return dw;
  }

  task.word = testHook(app);           // (for tests: ./TestHook)
  addIcon(app);

  // ------------------------------------------------ messages
  task.onMessage('DataOpen', (msg) => {
    if (msg.filetype !== DOCX) return false;
    app.open(msg.path);
    return true;
  });
  // (the Task Manager's Quit, shutdown: asks first; Quit itself and
  // task.quit() do not)
  task.onMessage('PreQuit', preQuit(app));
  task.onMessage('Quit', () => task.quit());

  // ------------------------------------------------ starting
  // (not awaited: the Filer's double-click does not wait for it)
  loadRecent(app);
  if (file) app.open(file);
}
