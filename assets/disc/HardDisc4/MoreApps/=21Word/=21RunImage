// Word - a word processor for Microsoft Word documents (.docx).
//
// It opens .docx files (double-click one, or drop it on Word's icon)
// and shows their text, with a caret and a selection; text can be
// typed and deleted, with undo and redo, and a faithful copy saved
// (everything it does not show is kept). No formatting yet, and no
// Save over the file itself.
//
// !RunImage is where it starts: one Word at a time, the icon on the
// icon bar and its menu, opening files, and quitting. A document's
// window is ./AppWin; reading files is ./Open; the info line and the
// Info boxes are ./Info.
import {wimp, vfs, Menu, infoBox, reportError} from 'riscos';
import {openDocx, describe} from './Open';
import {DocWindow} from './AppWin';
import {loadFonts} from './FontLoad';
import {fontsToLoad} from './FontMap';
import {facts} from './Info';

const DOCX = 0xA7E;
const say = (m, category = 'error') =>
  reportError(m, {appName: 'Word', category});

export default async function start(task, ctx) {
  const file = ctx.argv[0];
  // only one Word at a time: pass the file to the one running
  const other = wimp.tasks.find((t) => t !== task && t.alive &&
    t.name === task.name);
  if (other) {
    if (file) {
      wimp.sendMessage('DataOpen', {path: file, filetype: DOCX},
        {to: other});
    }
    task.quit();
    return;
  }

  // the bundled fonts a document is shown in (each is loaded once),
  // with Liberation Sans when it uses a font that is not bundled: it
  // is shown without them if they take too long, and laid out again
  // when they arrive
  const fontsFor = (doc) => {
    const want = fontsToLoad(facts(doc).fonts);
    return loadFonts(vfs, `${ctx.dir}.Fonts`, undefined, want)
      .catch(() => null);
  };

  const docs = new Map();              // canonical path -> DocWindow
  const keyOf = (path) => {
    try { return vfs.canonical(path).toLowerCase(); }
    catch (e) { return String(path).toLowerCase(); }
  };
  const opening = new Map();           // key -> Promise (in progress)
  const app = {
    task, docs,
    /** Open a .docx (or bring its window to the front). */
    open(path) {
      const key = keyOf(path);
      const had = docs.get(key);
      if (had) { had.show(); return Promise.resolve(had); }
      if (!opening.has(key)) {
        opening.set(key, load(path, key)
          .finally(() => opening.delete(key)));
      }
      return opening.get(key);
    },
    closed(dw) {
      for (const [k, v] of docs) if (v === dw) docs.delete(k);
    },
  };
  async function load(path, key) {
    let doc;
    try {
      doc = await openDocx(vfs, path);
    } catch (e) {
      say(describe(e, vfs.leaf(path)));
      return null;
    }
    if (!task.alive) return null;
    const fonts = fontsFor(doc);
    await Promise.race([fonts,
      new Promise((res) => setTimeout(res, 2500))]);
    if (!task.alive) return null;
    const dw = new DocWindow(app, path, doc);
    docs.set(key, dw);
    dw.show();
    fonts.then(() => { if (docs.get(key) === dw) dw.relayout(); });
    return dw;
  }

  // for tests: the open documents (view: the caret, selection and
  // editing, ./EditView hook: type, press, compose, dirty...), and
  // opening one
  task.word = {
    get docs() {
      return [...docs.values()].map((d) => ({
        path: d.path, doc: d.doc, text: d.text,
        summary: d.summary,             // (as opened)
        win: d.win, saveBytes: () => d.saveBytes(), d: d.d,
        view: d.view.hook(),
      }));
    },
    open: (path) => app.open(path),
  };

  // ------------------------------------------------ the icon bar
  const info = infoBox(task, {name: 'Word',
    purpose: 'Word documents (.docx)', author: 'MoreApps',
    version: '0.10 (05-Oct-26)'});
  const menu = () => new Menu('Word', [
    {text: 'Info', submenu: info},
    {text: 'Quit', action: () => task.quit(),
      help: 'Stop Word: changes not saved as a copy are lost.'},
  ]);
  task.addIconbarIcon({
    sprite: '!word', menu,
    help: 'This is Word.|MDrop a Word .docx file on this icon to ' +
      'open it, or double-click one in a directory display.',
    onClick: () => say('Word cannot make new documents yet: ' +
      'double-click a .docx file, or drop one on this icon, to ' +
      'see it.', 'info'),
    onDataLoad: (ev) => {
      for (const f of ev.files) if (f.type !== 'dir') app.open(f.path);
    },
  });

  // ------------------------------------------------ messages
  task.onMessage('DataOpen', (msg) => {
    if (msg.filetype !== DOCX) return false;
    app.open(msg.path);
    return true;
  });
  task.onMessage('Quit', () => task.quit());

  // ------------------------------------------------ starting
  // (not awaited: the Filer's double-click does not wait for it)
  if (file) app.open(file);
}
