// WinMenu - the menu of a document's window (./AppWin):
//
//   windowMenu(dw) -> a Menu (the keys shown: ./Keymap, Cmd+S on a
//   Mac: ./MacKeys macLabel; they work while the window has the
//   caret: ./DocKeys)
//     Save         Ctrl+S    save it (./DocSave save: an untitled
//                            document opens the Save as box)
//     Save as >    F3        the Save as box (./DocSave saveBox)
//     Revert                 load it again from its file (./CloseDoc;
//                            shaded for an untitled document)
//     Save a copy >          a Save box for a copy (./CopySave)
//     Info >                 what the document holds (./Info)
//     Edit >                 undo, redo, cut, copy, paste, select
//                            all, find, replace, Word count...
//                            (./EditMenu, ./CountBox)
//     Insert >               page break, section breaks, Symbol...,
//                            Special character >, Hyperlink...,
//                            Bookmark...: ./InsertMenu
//     Format >               ./FormatMenu, with Ruler (dw.setRuler),
//                            Paragraph... (./ParaBox), Tabs...
//                            (./TabsBox), Borders and shading...
//                            (./BorderBox), Picture... (./PicBox)
//                            and AutoFormat lists
//                            (./AutoFormatOpt)
//     Zoom >                 50%..200%, Zoom in, Zoom out (./ZoomBind)
//     New          F2        a new, empty document (app.newDoc)
//     Close        Ctrl+F2   asks first if there are changes
//                            (./CloseDoc requestClose)
//
// The boxes are made once (./Boxes) and kept in dw.boxes ('saveas',
// 'copy', 'info' -> Window), which ./AppWin deletes with the
// document.
import {Menu} from 'riscos';
import {editMenu} from './EditMenu';
import {countBox} from './CountBox';
import {insertMenu} from './InsertMenu';
import {formatMenu} from './FormatMenu';
import {paraBox} from './ParaBox';
import {tabsBox} from './TabsBox';
import {borderBox} from './BorderBox';
import {picBox} from './PicBox';
import {listBox} from './ListBox';
import {autoListItem} from './AutoFormatOpt';
import {infoWindow} from './Info';
import {zoomMenu} from './ZoomBind';
import {box} from './Boxes';
import {save, saveBox} from './DocSave';
import {copyBox} from './CopySave';
import {requestClose, revert} from './CloseDoc';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';

/** See the header. */
export function windowMenu(dw) {
  const task = dw.app.task;
  const k = (id) => macLabel(keymap.labelFor(id), dw.view.mac);
  return new Menu('Word', [
    {text: 'Save', key: k('save'), action: () => { save(dw); },
      help: 'Save this document in its file (the first time, ' +
        'the Save box asks where).'},
    {text: 'Save as', key: k('saveBox'), submenu: () => saveBox(dw),
      help: 'Save this document under another name: the window ' +
        'takes that name.'},
    {text: 'Revert', shaded: () => dw.isUntitled,
      action: () => { revert(dw); },
      help: 'Load this document again from its file, as it was ' +
        'last saved (changes are lost: it asks first).'},
    {text: 'Save a copy', submenu: () => copyBox(dw),
      help: 'Save a copy of this document as a Word .docx file: ' +
        'the window keeps its name and its changes.'},
    {text: 'Info', submenu: () => box(dw, 'info',
      () => infoWindow(task, dw.leaf, dw.doc)),
    help: 'What the document holds.'},
    {text: 'Edit', submenu: () => editMenu(dw.view,
      {count: () => countBox(dw)}),
    help: 'Undo, redo, cut, copy, paste, select all, find, replace ' +
      'and the word count.'},
    {text: 'Insert', submenu: () => insertMenu(dw),
      help: 'Put in a page break, a section break, a symbol, a ' +
        'special character, a hyperlink or a bookmark.'},
    {text: 'Format', submenu: () => formatMenu(dw.view, {
      ruler: () => dw.rulerOn,
      toggleRuler: () => dw.setRuler(!dw.rulerOn),
      paragraph: () => paraBox(dw), tabs: () => tabsBox(dw),
      borders: () => borderBox(dw), picture: () => picBox(dw),
      listValue: () => listBox(dw), autoList: autoListItem(dw.app)}),
    help: 'Bold, italic, font, size, colour, alignment, ' +
      'paragraph styles; the ruler.'},
    {text: 'Zoom', submenu: () => zoomMenu(dw),
      help: 'Show the page larger or smaller (CTRL with the wheel ' +
        'does it too).'},
    {text: 'New', key: k('new'), action: () => { dw.app.newDoc(); },
      help: 'Make a new, empty document in a window of its own.'},
    {text: 'Close', key: k('close'),
      action: () => { requestClose(dw); },
      help: 'Close this document (if it has changes, it asks ' +
        'whether to save them first).'},
  ]);
}
