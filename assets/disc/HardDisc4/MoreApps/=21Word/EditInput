// EditInput - typed text and input methods in a document's window
// (./EditView), from the Wimp's text-input caret (src/core
// textinput):
//
//   attachInput(view)
//
//   textinput       the text is typed (view.input): one event, one
//                   edit, however long (at most 100,000 characters,
//                   the Wimp's limit)
//   composition     an input method is composing: its text is shown
//                   at the caret (view.compose), not yet in the
//                   document
//   compositionend  the composing text goes; what is committed comes
//                   next as a textinput (nothing when cancelled)
//   losecaret       the input focus went elsewhere: any composing
//                   text goes too
// A save types the composing text in itself (./DocSave) and sets
// v.lateCommit to {text, at}: the input method's own commit of that
// text, if it comes next within LATE_MS of the save, is not typed a
// second time. Anything else first (other text, composing, a key,
// a click or drag in the window, the caret leaving) ends that, so
// the same text typed on purpose is always typed.
// Events for a window that is no longer open are ignored.
// It also gives the view fromProxy(ev): whether a 'key' event came
// from the Wimp's hidden text field while it had the focus (a
// printable key from there is never text: ./EditKeys).
//
// For ./EditView:
//   showCaret(v, take)  the Wimp's text-input caret at the head
//                  (v.caretRect(): zoomed), so the input method's
//                  candidates show there; only if the window has the
//                  focus, or take (a user gesture: it takes it)
//   inputView(v, text)  type text (with the pending format)
//   composeView(v, text|null)  show what is being composed
import {wimp} from 'riscos';
import * as S from './Selection';
import {EMPTY, forTyping, styleFor} from './Pending';

const TEXT = {text: true, blink: true};
const LATE_MS = 800;

/** See the header. */
export function showCaret(v, take = false) {
  const w = v.win;
  if (!w.isOpen || (!take && !v.hasFocus)) return;
  const one = v.sel && S.collapsed(v.sel);
  const c = one ? v.caretRect() : null;
  const ti = wimp.textInput;
  if (!take && wimp.caret?.text && ti && !ti.focused) {
    // not a user gesture and the hidden field is not the focus
    // owner (the focus is in a page field outside the desktop):
    // move the caret only, never take the focus
    wimp.caret.pos = c ? {x: c.x, y: c.y, h: c.h} : null;
    wimp._drawCaret();
    return;
  }
  if (c) wimp.setCaret(w, null, -1, {x: c.x, y: c.y, h: c.h}, TEXT);
  else wimp.setCaret(w, null, -1, null, TEXT);
}

/** See the header. */
export function inputView(v, text) {
  v.comp = null;
  const s = String(text ?? '');
  if (!s || !v.win.isOpen) return;
  const p = v.pending;
  const out = v.sel
    ? v.typing.type(v.sel, s, {overwrite: v.overwrite,
      rPr: forTyping(p), rStyle: styleFor(p)})
    : null;
  if (!out || out === v.sel) { wimp.beep(); return; }
  v.pending = EMPTY;
  v.edited(out);
}

/** See the header. */
export function composeView(v, text) {
  const t = text ? String(text) : null;
  if (t === v.comp) return;
  v.comp = t;
  v.win.invalidate();
}

/** See the header. */
export function attachInput(v) {
  const w = v.win;
  v.fromProxy = (ev) => {
    const t = wimp.textInput, e = ev && ev.domEvent;
    return !!(e && t && t.el && t.focused && e.target === t.el);
  };
  const late = (text) => {
    const l = v.lateCommit;
    v.lateCommit = null;
    return !!l && l.text === text && performance.now() - l.at < LATE_MS;
  };
  const off = () => { v.lateCommit = null; };
  for (const e of ['key', 'click', 'doubleclick', 'drag']) {
    w.on(e, off, {first: true});
  }
  w.on('textinput', (ev) => {
    if (w.isOpen && !late(ev.text)) v.input(ev.text);
    return true;
  });
  w.on('composition', (ev) => {
    v.lateCommit = null;
    if (w.isOpen && wimp.caret?.window === w) v.compose(ev.text);
    return true;
  });
  w.on('compositionend', () => {
    v.compose(null);
    return true;
  });
  w.on('losecaret', () => { off(); v.compose(null); });
}
