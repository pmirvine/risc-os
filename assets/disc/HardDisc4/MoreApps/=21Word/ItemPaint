// ItemPaint - draws one item of a ./DocLayout on a canvas 2D context:
// a paragraph's lines (./DocPaint calls it) and the grey box of a kept
// block. The rules of what a line looks like are in ./DocPaint's
// header.
//
//   paintPara(L, g, it, rect)  the lines of paragraph item it that lie
//                              in rect {x0, y0, x1, y1}
//   paintBox(L, g, it)         the grey box of a kept block's item
//
// An item is drawn at its column's x (it.x, ./DocItems). Draws on
// the context it is given; imports no desktop services.
import {paintRule} from './MarkPaint';
import {paintPic} from './PicPaint';

export function paintPara(L, g, it, rect) {
  for (const ln of it.lines) {
    const top = it.y + ln.y;
    if (top >= rect.y1) break;
    if (top + ln.h <= rect.y0) continue;
    if (ln.clip) {
      // an exact line spacing too small for the text: cut off (Word)
      g.save();
      g.beginPath();
      g.rect(rect.x0, top, rect.x1 - rect.x0, ln.h);
      g.clip();
    }
    paintLine(L, g, ln, top, it.x);
    if (ln.clip) g.restore();
  }
}

/** Line ln of a paragraph, its top at top, its column at X. */
function paintLine(L, g, ln, top, X) {
  highlights(g, ln, top, X);
  if (ln.label && ln.label.text) paintLabel(g, ln, top, X);
  if (ln.bars) paintBars(g, ln, top, X);
  for (const x of ln.items) {
    if (x.kind === 'pagebreak') {
      paintRule(g, x, X, top, ln.h);
      continue;
    }
    if (x.leader && x.w > 0) paintLeader(g, x, X, top + ln.base);
    if (x.kind === 'pic') {
      paintPic(L, g, x, X + x.x, top + ln.base + (x.dy || 0));
      continue;
    }
    if (!x.text) continue;
    const f = x.f;
    const left = X + x.x;
    const base = top + ln.base + (x.dy || 0);
    if (x.kind === 'box') {
      g.strokeStyle = '#a0a0a0';
      g.lineWidth = 1;
      const h = f.px * 1.3;
      g.strokeRect(Math.round(left) + 0.5,
        Math.round(base - f.px) + 0.5, Math.round(x.w - 2),
        Math.round(h));
      g.fillStyle = f.colour;
      g.font = f.css;
      g.fillText(x.text, left + 2, base);
      continue;
    }
    g.fillStyle = f.colour;
    if (g.font !== f.css) g.font = f.css;
    g.fillText(x.text, left, base);
    const t = Math.max(1, Math.round(f.px / 14));
    if (f.under) g.fillRect(left, base + 2, x.w, t);
    if (f.strike) g.fillRect(left, base - f.px * 0.3, x.w, t);
  }
}

const LEAD = {dot: '.', hyphen: '-', middleDot: '\u00b7'};

/** The leader of tab item x (column at X), its baseline at base. */
function paintLeader(g, x, X, base) {
  const f = x.f, left = X + x.x;
  g.fillStyle = f.colour;
  if (x.leader === 'underscore' || x.leader === 'heavy') {
    const t = Math.max(1, Math.round(f.px / 14));
    g.fillRect(left, base + 2, x.w, x.leader === 'heavy' ? 2 * t : t);
    return;
  }
  const ch = LEAD[x.leader];
  if (!ch) return;
  if (g.font !== f.css) g.font = f.css;
  const cw = g.measureText ? g.measureText(ch).width : f.px / 3;
  if (!(cw > 0)) return;
  const k = Math.ceil(x.x / cw);
  const n = Math.min(Math.floor((x.x + x.w) / cw) - k, 2000);
  if (n > 0) g.fillText(ch.repeat(n), X + k * cw, base);
}

/** The bar stops of line ln (top: its top; X: its column's x). */
function paintBars(g, ln, top, X) {
  g.fillStyle = '#000000';
  for (const b of ln.bars) {
    g.fillRect(Math.round(X + b), Math.round(top), 1,
      Math.round(ln.h));
  }
}

/** The list label of line ln (top: its top; X: its column's x). */
function paintLabel(g, ln, top, X) {
  const {f, text, x} = ln.label;
  g.fillStyle = f.colour;
  if (g.font !== f.css) g.font = f.css;
  g.fillText(text, X + x, top + ln.base);
}

/** The shading, then highlight, rectangles of line ln (at top). */
function highlights(g, ln, top, X) {
  const y0 = Math.round(top), y1 = Math.round(top + ln.h);
  for (const x of ln.items) {
    if ((!x.hl && !x.sh) || !(x.w > 0)) continue;
    const a = Math.floor(X + x.x);
    const w = Math.ceil(X + x.x + x.w) - a;
    for (const c of [x.sh, x.hl]) {
      if (!c) continue;
      g.fillStyle = c;
      g.fillRect(a, y0, w, y1 - y0);
    }
  }
}

export function paintBox(L, g, it) {
  const {x, y, w, h} = L.boxRect(it);
  g.fillStyle = '#eeeeee';
  g.fillRect(x, y, w, h);
  g.strokeStyle = '#888888';
  g.lineWidth = 1;
  g.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
  g.fillStyle = '#555555';
  g.font = 'italic 13px "Liberation Sans", sans-serif';
  g.fillText(it.label, x + 10, y + 18);
}
