// FindView - a match found by the Find box (./EditFind) seen in its
// document: the selection keeps its own colour while the box has
// the caret, and the box is moved off the match.
//
//   lend(s, dw, box)   the box counts as a pane of dw's view
//                      (EditView addPane: the selection is drawn as
//                      when the document has the caret), taken back
//                      from the view it was lent to before; s is
//                      ./EditFind's state ({pane})
//   unlend(s)          taken back (the box closed, the document gone)
//   show(dw, box)      the document's window to the front, the box
//                      (when open) in front of it; if the box covers
//                      the selection's line it moves below it (or
//                      above, when there is no room below)
// Uses the windows only.
import {wimp} from 'riscos';
import {caretOf} from './Zoom';

const GAP = 24, TITLE = 44;

/** See the header. */
export function lend(s, dw, box) {
  if (s.pane && s.pane.view === dw.view) return;
  unlend(s);
  s.pane = {view: dw.view, win: dw.win,
    remove: dw.view.addPane(box.win)};
  dw.win.invalidate();
}

/** See the header. */
export function unlend(s) {
  const p = s.pane;
  if (!p) return;
  s.pane = null;
  p.remove();
  if (p.win.isOpen) p.win.invalidate();
}

/** See the header. */
export function show(dw, box) {
  const w = dw.win;
  if (!w.isOpen) return;
  w.bringToFront();
  if (!box.isOpen) return;
  const b = box.win;
  b.bringToFront();
  const v = dw.view, sel = v.sel;
  if (!sel) return;
  const L = v.L;
  const rs = [sel.anchor, sel.head].map((p) =>
    caretOf(L.caretRect(p), v.zoom || 1, L.top)).filter(Boolean)
    .map((r) => ({...w.workToScreen(r.x, r.y), h: r.h}));
  if (!rs.length) return;
  const top = Math.min(...rs.map((r) => r.y));
  const bot = Math.max(...rs.map((r) => r.y + r.h));
  const x0 = Math.min(...rs.map((r) => r.x));
  const x1 = Math.max(...rs.map((r) => r.x));
  const by0 = b.y - TITLE, by1 = b.y + b.h;
  if (bot < by0 || top > by1 || x1 < b.x || x0 > b.x + b.w) return;
  let y = bot + GAP + TITLE;
  if (y + b.h > wimp.height - 8) y = top - GAP - b.h;
  b.open({x: b.x, y: Math.max(TITLE, Math.round(y)), behind: 'top'});
}
