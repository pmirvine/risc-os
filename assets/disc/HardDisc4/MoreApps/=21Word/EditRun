// EditRun - the commands of a document's window (./EditView), by
// ./Keymap id:
//
//   runView(v, id) -> true if used, undefined if not (the key then
//                     goes on)
//   stepView(v, 'undo' | 'redo')
//
// A formatting id (./FormatApply) is v.format(id) (used whenever
// there is a selection, even if it changes nothing); any other
// command first drops the pending format (./EditFormat). undo and
// redo end the typing's undo step; selectAll selects everything
// without scrolling; insert switches overwrite on or off; the rest
// are editing commands (./EditApply.run): nbsp (Ctrl-Shift-Space) is
// typed text, a no-break space, with the pending format (v.input);
// the selection after one
// is shown when laid out (v.edited). Tab, Shift-Tab and Backspace
// work on list items as ./EditList says; Shift-Tab outside a list
// is not used (undefined, the pending format kept: the key goes
// on). Tab after a marker may make a list item when v.autoList()
// says AutoFormat lists is on (./DocKeys), not in overwrite mode.
// The window's own commands (./Keymap WINDOW: new, close, save,
// saveBox, find, sendToBack) are v.docCommand(id) (./DocKeys;
// undefined without one). Uses only the view: no desktop services.
import * as S from './Selection';
import {run} from './EditApply';
import {isFormat} from './FormatApply';
import {dropPending} from './EditFormat';
import {forTyping, styleFor} from './Pending';
import {usesShiftTab} from './EditList';
import {WINDOW} from './Keymap';

/** See the header. */
export function stepView(v, kind) {
  v.ensure();
  dropPending(v);
  if (!(kind === 'undo' ? v.d.canUndo : v.d.canRedo)) return;
  v.typing.command(() => v.d[kind]());
  v.edited(v.sel);
}

/** See the header. */
export function runView(v, id) {
  if (WINDOW.has(id))
    return v.docCommand ? v.docCommand(id) : undefined;
  if (isFormat(id)) {
    if (!v.sel) return undefined;
    v.format(id);
    return true;
  }
  if (id === 'shiftTab' && !usesShiftTab(v.d.doc, v.sel))
    return undefined;
  if (id === 'nbsp' && v.sel) {
    v.input('\xA0');
    return true;
  }
  const hy = id === 'nbHyphen' || id === 'softHyphen';
  const arg = hy ? {rPr: forTyping(v.pending),
    rStyle: styleFor(v.pending)} : undefined;
  dropPending(v);
  if (id === 'undo' || id === 'redo') {
    stepView(v, id);
    return true;
  }
  if (id === 'selectAll') {
    if (v.sel) v.setSelection(S.selectAll(v.L), {scroll: false});
    return true;
  }
  if (id === 'insert') {
    v.overwrite = !v.overwrite;
    v.typing.reset();
    v.win.invalidate();
    return true;
  }
  if (!v.sel) return undefined;
  const out = run(id, v.d, v.typing, v.sel, {autoList: id === 'tab' &&
    !v.overwrite && !!v.autoList && v.autoList(), arg});
  if (out === undefined) return undefined;
  if (out !== v.sel) v.edited(out);
  return true;
}
