// DocLayout - the whole document laid out as one column the width of
// the text on its page: paragraphs and kept blocks stacked, and
// positions ({id, off}, ./DocPos) <-> places in the work area.
//
//   const L = new DocLayout(doc, metrics, prev?, {top, decorators}?)
//              metrics: WimpLib/TextMetrics; prev: an older layout
//              of doc whose lines may be kept (./DocItems); top: px
//              above everything (the panes), 0..1000; decorators:
//              ./DocStack's (DECORATORS); both prev's when not given
//   L.layout(viewWidth) -> {w, h}: the work area's extent
//   L.items  [{id, block, kind: 'p'|'box', index, y, h, gapAbove,
//             gapBelow, marks, lines?, list?, mark?, label?}]
//             (./DocItems) in document order; a 'p' item is also the
//             pl ({para, y, h, lines, metrics}) of ./PositionMap
//   L.labels  Map paraId -> list Label (./ListNumbers), once per
//             layout object; L.byId  Map id -> item
//   L.left, L.textW, L.pageLeft, L.pageW: the column (px); L.top
//   L.pageH  the page's height (px); L.height  the extent's (layout)
//   L.itemAtY(y)            -> the item at y (clamped to the ends;
//                              a gap gives the item below it; where
//                              items overlap, the lower one from
//                              the top of its first line)
//   L.locate(pos)           -> {item, index, off} (off clamped), or
//                              null for an id not in the document
//   L.caretRect(pos, aff)   -> {x, y, h} in work-area coordinates
//   L.hitTest(x, y)         -> {pos, affinity} (in a section break
//                              band, ./SectDeco: the end of the
//                              block above it; in the gap of a
//                              bottom border, ./BorderGroups: the
//                              paragraph above, its last line)
//   L.selectionRects(sel, y0?, y1?) -> [{x, y, w, h}] (./DocRects)
//   L.paraStart(pos), L.paraEnd(pos), L.docStart(), L.docEnd()
//   L.nextItem(item), L.prevItem(item) -> item or null
//   L.boxRect(item)         -> {x, y, w, h} of a kept block's box
//   L.invalidate()          lay all the lines out (and ask the
//                           decorators) again on next layout
//
// The page geometry (text width from the first section, the page
// centred, a whole page high at least), kept blocks and hits outside
// the items: docs/apps/Word.md, DocLayout. Pure: no desktop services.
import {buildItems, BOX} from './DocItems';
import {stack, MARGIN, DECORATORS} from './DocStack';
import * as PM from './PositionMap';
import {itemEnd, clampOff} from './DocPos';
import {selectionRects} from './DocRects';
import {inBand} from './SectDeco';
import {boxMark} from './BorderGroups';

export {BOX};
export const PAGE_TOP = 8;             // desk above and below the page
const num = (v, d) => (Number.isFinite(v) ? v : d);
const clamp = (v, a, b) => Math.min(Math.max(v, a), b);
const textTop = (it) => it.y + (it.lines && it.lines.length
  ? it.lines[0].y : 0);

export class DocLayout {
  constructor(doc, metrics, prev, opts = {}) {
    this.doc = doc;
    const top = opts.top === undefined && prev ? prev.top : opts.top;
    this.top = clamp(num(top, 0), 0, 1000);
    this.decorators = opts.decorators ||
      (prev && prev.decorators) || DECORATORS;
    this.metrics = metrics;
    this.cache = new Map();            // run formats (./Fmt)
    this.laid = false; this.width = 0;
    const sp = (doc.sections[0] && doc.sections[0].props) || {};
    const sz = sp.pgSz || {}, mar = sp.pgMar || {};
    this.pageH = clamp(num(sz.h, 16838) / 15, 200, 20000);
    this.height = this.minHeight(2 * MARGIN + this.top);
    const pw = num(sz.w, 11906);
    const ml = num(mar.left, 1440), mr = num(mar.right, 1440);
    this.textW = clamp((pw - ml - mr) / 15, 80, 4000);
    this.marL = clamp(ml / 15, 0, 1000);
    const marR = clamp(mr / 15, 0, 1000);
    this.pageW = clamp(pw / 15, 80, this.marL + this.textW + marR);
    this.pageLeft = MARGIN; this.left = MARGIN + this.marL;
    buildItems(this, doc, prev);
  }

  /** See the header. */
  layout(viewWidth) {
    const vw = Math.max(0, num(+viewWidth, 0));
    this.width = vw;
    this.pageLeft = Math.max(MARGIN, (vw - this.pageW) / 2);
    this.left = this.pageLeft + this.marL;
    if (!this.laid) this.stack();
    const right = this.pageLeft + Math.max(this.pageW,
      this.marL + this.textW) + MARGIN;
    return {w: Math.max(vw, Math.ceil(right)), h: this.height};
  }

  /** Break every paragraph and stack the items (./DocStack). */
  stack() { stack(this); }

  /** h, or a whole page below top if that is more. */
  minHeight(h) {
    return Math.max(h, this.top + 2 * PAGE_TOP + this.pageH);
  }

  invalidate() {
    for (const it of this.items) it.deco = null;
    for (const it of this.items) if (it.kind === 'p') it.lines = null;
    this.laid = false;
  }

  itemAtY(y) {
    const {items} = this;
    let lo = 0, hi = items.length - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (items[mid].y + items[mid].h > y) hi = mid; else lo = mid + 1;
    }
    // items that overlap (a negative gap: ./DocStack): the one below
    // once its text has begun (its space before is above that)
    while (lo + 1 < items.length && textTop(items[lo + 1]) <= y) lo++;
    return items[lo] || null;
  }

  locate(pos) {
    const it = pos && this.byId.get(pos.id);
    return it ? {item: it, index: it.index, off: clampOff(it, pos.off)}
      : null;
  }

  /** See the header. */
  caretRect(pos, aff = 'down') {
    const loc = this.locate(pos);
    if (!loc) return null;
    const it = loc.item;
    if (it.kind === 'box') {
      const r = this.boxRect(it);
      return {x: r.x + (loc.off ? r.w : 0), y: r.y, h: r.h};
    }
    const c = PM.caretRect(it, loc.off, aff);
    return {x: c.x + this.left, y: c.y, h: c.h};
  }

  /** The box drawn for a kept block. */
  boxRect(it) {
    return {x: this.left, y: it.y + 6, w: this.textW, h: BOX};
  }

  /** See the header. */
  hitTest(x, y) {
    const {items} = this;
    if (!items.length) return null;
    const last = items[items.length - 1];
    const D = 'down';
    if (!(y >= items[0].y)) return {pos: this.docStart(), affinity: D};
    if (y >= last.y + last.h) return {pos: this.docEnd(), affinity: D};
    const it = this.itemAtY(y);
    const up = this.items[it.index - 1];
    const bm = up && y < it.y ? boxMark(up) : null;
    if (bm && y < up.y + up.h + bm.padBottom) {
      // (the bottom border's gap: still the paragraph above)
      const h = PM.hitTest(up, num(x, 0) - this.left, y);
      return {pos: {id: up.id, off: h.off}, affinity: h.affinity};
    }
    if (up && y < it.y && inBand(up, y)) {
      return {pos: {id: up.id, off: itemEnd(up)}, affinity: D};
    }
    if (it.kind === 'box') {
      const off = x < this.left + this.textW / 2 ? 0 : 1;
      return {pos: {id: it.id, off}, affinity: 'down'};
    }
    const h = PM.hitTest(it, num(x, 0) - this.left, y);
    return {pos: {id: it.id, off: h.off}, affinity: h.affinity};
  }

  /** See the header (./DocRects). */
  selectionRects(sel, y0 = -Infinity, y1 = Infinity) {
    return selectionRects(this, sel, y0, y1);
  }

  paraStart(pos) { return {id: pos.id, off: 0}; }
  paraEnd(pos) {
    const it = this.byId.get(pos.id);
    return {id: pos.id, off: it ? itemEnd(it) : 0};
  }

  docStart() {
    return this.items.length ? {id: this.items[0].id, off: 0} : null;
  }

  docEnd() {
    const it = this.items[this.items.length - 1];
    return it ? {id: it.id, off: itemEnd(it)} : null;
  }

  nextItem(it) { return this.items[it.index + 1] || null; }
  prevItem(it) { return this.items[it.index - 1] || null; }
}
