// OdtComments - the comments of an OpenDocument text (OpenDocument
// 1.3 part 3, 14.1 <office:annotation>, <office:annotation-end>) for
// ./OdtRead, through the builder (./ImpBuild comment).
//
//   PART  {elements: office:annotation, office:annotation-end}
//
// An office:annotation in a paragraph is a comment: its author
// (dc:creator), date (dc:date), initials (meta:creator-initials) and
// its text:p / text:h / text:list children, read into a story with
// the body's walker (./OdtSect inStory). Tables and pictures in a
// comment are left out (one note; the parsed tree is not changed).
// The comment covers the text from the annotation to the
// office:annotation-end of the same office:name when one comes after
// it in the body, in the same text box or shape when it is in one
// (./OdtFind, looked for once; ends in notes and comments do not
// count), else it is a point at its start (a
// note when an end was there but before it, or is ignored: one in a
// note, header or footer). A reply (loext:parent-name naming an
// earlier comment) is a point comment whose parent is that one.
// Not kept, one note each kind: a comment in a header, a footer or a
// note (the Model keeps comments in the body only), one outside a
// paragraph, an end with no start (but for the end of a comment
// past the cap). Caps (./ImpComments): MAX_COMMENTS (past it the
// comments' text is not read).
// Pure: no desktop services.
import {first, attr, textOf} from './OdtXml';
import {marksOf} from './OdtFind';
import {SCOPES} from './OdtBoxes';
import {inStory} from './OdtSect';
import {MAX_COMMENTS} from './RtfComments';

const BLOCKS = new Set(['text:p', 'text:h', 'text:list']);
const LEFT_OUT = new Set(['table:table', 'draw:frame']);
const LEFT = 'tables and pictures in comments are left out';
/** Where an end does not count: notes and comments. */
const SKIP = new Set(['text:note', 'office:annotation']);

const MISSING = 'a comment whose end is missing is anchored at its ' +
  'start';

// (dropped: the names of comments the builder did not keep, past
// its cap: their ends are said nothing of, the cap's note says it)
const state = (ctx) => ctx.cmts || (ctx.cmts = {ends: null,
  pending: new Map(), ids: new Map(), seen: new Set(),
  dropped: new Set(), made: 0});

/** n without its tables and pictures, at any depth: a copy where
 *  anything is taken out (the parsed tree is never changed). */
function clean(ctx, n) {
  let changed = false;
  const out = [];
  for (const c of n.children) {
    if (typeof c !== 'string' && LEFT_OUT.has(c.name)) {
      changed = true;
      ctx.note(LEFT);
      continue;
    }
    const k = typeof c === 'string' ? c : clean(ctx, c);
    if (k !== c) changed = true;
    out.push(k);
  }
  return changed ? {...n, children: out} : n;
}

/** The blocks of a comment's text, with no table or picture. */
function content(ctx, node) {
  const out = [];
  for (const c of node.children) {
    if (typeof c === 'string') continue;
    if (BLOCKS.has(c.name)) out.push(clean(ctx, c));
    else if (LEFT_OUT.has(c.name)) ctx.note(LEFT);
  }
  return out;
}

const textIn = (node, name) => {
  const x = first(node, name);
  return x ? textOf(x).trim() : '';
};

/** Whether an annotation-end naming `name` comes after node in the
 *  body (not in a note: see SKIP; looked up once). */
function hasEnd(ctx, node, name) {
  const S = state(ctx);
  if (!S.ends) {
    S.ends = marksOf([ctx.parts.content], ['office:annotation'],
      [['office:annotation-end', 'office:name']], SKIP, SCOPES);
  }
  return S.ends.later(node, name);
}

function annotation(ctx, node) {
  if (ctx.depth || ctx.where !== 'content') {
    return ctx.note('comments in headers, footers and notes are ' +
      'skipped');
  }
  if (!ctx.para) return ctx.note('a comment outside a paragraph is ' +
    'skipped');
  const S = state(ctx), b = ctx.b;
  const name = attr(node, 'office:name');
  if (S.made >= MAX_COMMENTS) {
    // (said as the builder says it; the text is not read)
    if (typeof name === 'string') S.dropped.add(name);
    return ctx.note('more than ' + MAX_COMMENTS + ' comments: the ' +
      'rest are skipped');
  }
  const parent = S.ids.get(attr(node, 'loext:parent-name'));
  const keep = [ctx.rev, ctx.revMark];
  ctx.rev = ctx.revMark = undefined;
  let story;
  try {
    story = inStory(ctx, ctx.where, {children:
      content(ctx, node)}).end();
  } finally {
    [ctx.rev, ctx.revMark] = keep;
  }
  const c = b.comment({author: textIn(node, 'dc:creator'),
    initials: textIn(node, 'meta:creator-initials'),
    date: textIn(node, 'dc:date'), story, parent});
  if (b.stopped) ctx.stop = true;
  if (!c) {
    if (typeof name === 'string') S.dropped.add(name);
    return;
  }
  S.made++;
  if (typeof name === 'string' && !S.ids.has(name)) {
    S.ids.set(name, c.id);
  }
  const range = parent === undefined && typeof name === 'string' &&
    !S.pending.has(name) && hasEnd(ctx, node, name);
  if (range) {
    S.pending.set(name, c);
    b.obj(c.start);
  } else {
    if (typeof name === 'string' && parent === undefined &&
      S.seen.has(name)) ctx.note(MISSING);
    b.obj(c.ref);
  }
}

function end(ctx, node) {
  const S = state(ctx), name = attr(node, 'office:name');
  if (ctx.depth || ctx.where !== 'content') {
    if (S.ids.has(name)) {
      ctx.note('the end of a comment in a note, header or footer is ' +
        'ignored: the comment is at its start');
    }
    return;
  }
  if (typeof name === 'string') S.seen.add(name);
  const c = S.pending.get(name);
  if (!c) {
    if (!S.dropped.has(name)) {
      ctx.note('the end of a comment with no start is ignored');
    }
    return;
  }
  S.pending.delete(name);
  ctx.b.obj(c.end);
  ctx.b.obj(c.ref);
}

export const PART = {elements: new Map([
  ['office:annotation', annotation],
  ['office:annotation-end', end]])};
