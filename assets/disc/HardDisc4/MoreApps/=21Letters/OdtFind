// OdtFind - one look over an XML tree (./OdtXml) for ./OdtRevs and
// ./OdtComments: which marks have a partner after them.
//
//   marksOf(roots, starts, ends, skip?, scopes?) ->
//       {later(node, value)}
//       roots: the trees looked at (null ones left out); starts and
//       ends element names; ends' value is the attribute named with
//       it ([[element, attribute]...]). later(node, value): whether
//       an end of that value comes after start node (one of starts)
//       in document order, in the same tree and scope. Elements
//       named in skip (a Set) are not looked into: the ends there
//       do not count.
//       Elements named in scopes (a Set: text boxes and shapes,
//       read after their paragraph by ./OdtBoxes) are scopes of
//       their own: only an end in the start's own scope counts.
//       No recursion; values that are not strings are left out.
// Pure: no desktop services.
import {attr} from './OdtXml';

/** See the header. */
export function marksOf(roots, starts, ends, skip = new Set(),
  scopes = new Set()) {
  const want = new Map(ends), at = new Map(), last = new Map();
  const isStart = new Set(starts);
  let n = 0, scopeN = 0;
  roots.forEach((root, r) => {
    if (!root) return;
    const stack = [[root, r + ':0']];
    while (stack.length) {
      const [node, sc] = stack.pop();
      if (isStart.has(node.name)) at.set(node, [sc, n++]);
      const a = want.get(node.name);
      if (a !== undefined) {
        const v = attr(node, a);
        if (typeof v === 'string') last.set(sc + '\u0000' + v, n++);
      }
      if (skip.has(node.name) && node !== root) continue;
      const inner = scopes.has(node.name) ? r + ':' + ++scopeN : sc;
      for (let i = node.children.length - 1; i >= 0; i--) {
        const c = node.children[i];
        if (typeof c !== 'string') stack.push([c, inner]);
      }
    }
  });
  return {later(node, value) {
    const p = at.get(node);
    if (!p || typeof value !== 'string') return false;
    const e = last.get(p[0] + '\u0000' + value);
    return e !== undefined && e > p[1];
  }};
}
