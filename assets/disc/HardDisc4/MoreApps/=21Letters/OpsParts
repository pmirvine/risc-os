// OpsParts - the part-name rules of ./OpsDoc setDocPart: which names
// a part may take, and the check of a new `parts` Map (see the
// header of ./OpsDoc for the rules). ./OpsDoc re-exports partFree and
// newPartFree. Pure: no desktop services.
//
//   partFree(doc, name)     true when `name` may be the numbering part
//   newPartFree(doc, name)  true when `name` may be a new part
//   checkPartName(v, doc)   throws RangeError for a bad name
//   checkParts(v, doc)      throws RangeError for a bad parts Map
import {fail} from './ModelCheck';
import {CT} from './WriteParts';

const isObj = (v) => v !== null && typeof v === 'object' &&
  !Array.isArray(v);

/** True when part `name` (lower case) is another part's. */
function taken(doc, name) {
  const m = isObj(doc.meta) ? doc.meta : {};
  const lc = (x) => typeof x === 'string' ? x.toLowerCase() : null;
  if (name === '[content_types].xml' || name.endsWith('.rels') ||
    name.split('/').includes('_rels')) return true;
  if ([m.mainPart, m.stylesPart, m.settingsPart].some((x) =>
    lc(x) === name)) return true;
  if (doc.parts instanceof Map) {
    for (const k of doc.parts.keys()) if (lc(k) === name) return true;
  }
  const ov = m.contentTypes && Array.isArray(m.contentTypes.overrides)
    ? m.contentTypes.overrides : [];
  return ov.some((o) => Array.isArray(o) && lc(o[0]) === '/' + name &&
    o[1] !== CT.numbering);
}

/** A part name: relative, no '..', no backslash or control. */
export function checkPartName(v, doc) {
  if (v === undefined || v === null) return;
  if (typeof v !== 'string' || !v || v.length > 255 ||
    v.startsWith('/') || /^[A-Za-z]:/.test(v) ||
    /[\\\u0000-\u001f\u007f]/.test(v) ||
    v.split('/').some((s) => s === '' || s === '.' || s === '..'))
    fail('bad part name');
  if (taken(doc, v.toLowerCase()))
    fail('part ' + v + ' is another part of the document');
}

/**
 * True when `name` is a part name setDocPart would take for the
 * numbering part: well formed and no other part's (see above).
 */
export function partFree(doc, name) {
  if (typeof name !== 'string') return false;
  try {
    checkPartName(name, doc);
  } catch (e) {
    return false;
  }
  return true;
}

/** True when `name` is a folder of a part, or inside a part. */
function folderClash(doc, name) {
  const lc = name.toLowerCase();
  const m = isObj(doc.meta) ? doc.meta : {};
  const known = [m.mainPart, m.stylesPart, m.settingsPart,
    ...(doc.parts instanceof Map ? doc.parts.keys() : [])];
  return known.some((x) => typeof x === 'string' &&
    (x.toLowerCase().startsWith(lc + '/') ||
    lc.startsWith(x.toLowerCase() + '/')));
}

/** See the header. */
export function newPartFree(doc, name) {
  const m = isObj(doc.meta) ? doc.meta : {};
  return partFree(doc, name) && !folderClash(doc, name) &&
    !(typeof m.numberingPart === 'string'
    && m.numberingPart.toLowerCase() === name.toLowerCase());
}

export function checkParts(v, doc) {
  if (!(v instanceof Map)) fail('parts must be a Map');
  const old = doc.parts instanceof Map ? doc.parts : new Map();
  const added = new Set();
  for (const [k, b] of v) {
    if (old.has(k)) {
      if (old.get(k) !== b) fail('part ' + k + ' changed');
      continue;
    }
    if (!(b instanceof Uint8Array)) fail('part ' + k + ' not bytes');
    if (!newPartFree(doc, k)) fail('part name ' + k + ' not free');
    const lc = k.toLowerCase();
    if (added.has(lc)) fail('part ' + k + ' given twice');
    added.add(lc);
  }
}
