// DocItems - the items of a ./DocLayout, one per block (each made by
// ./ItemMake itemOf), and which of an older layout's lines may be
// kept.
//
//   buildItems(L, doc, prev?) fills L.root, L.items, L.flow, L.byId,
//                       L.labels and records L.styles, L.numbering,
//                       L.settings (doc.styles, doc.numbering,
//                       doc.rawSettings), L.sectProps (each
//                       section's props object), L.dirtyFrom and
//                       L.cleanFrom (Batch D D7, below)
//   moveColumn(col, x)  puts column col (and its items, and the
//                       columns of the tables in it) at x
//                       (./TblReuse's)
//   reuseKey(item)  -> {block, list, mark}: what a paragraph's lines
//                       depend on besides the layout-wide key, its
//                       column's width and styles
//   sameKey(a, b)   -> true when two reuse keys (or two items: they
//                       have the same fields) lay out the same
//   sameMark(a, b)  -> true when two section-end marks are alike
//   markOf(doc, s)  -> the mark of section s's last block ({type}:
//                       the following section's w:type, as
//                       ./SectMark has it), or null for the last
//
// An item: {id, block, kind: 'p'|'box'|'tbl', index, x, w, col, ci,
// s, y, h, gapAbove, gapBelow, marks, inp, lines?, metrics?, para?,
// list?, mark?, label?} (inp: ./ItemReuse inpOf, P12a fix C1). A
// kept (Opaque) block is a 'box' (label '[table - preserved, not
// shown]' and the like). A typed table is ONE 'tbl'
// item of its column (./TblItems: rows of cells, each cell a column
// of the items of its blocks: paragraphs 'p', Opaque blocks 'box',
// nested tables 'tbl'; a table deeper than ./TblCheck MAX_DEPTH a
// 'box'), its label as a kept block's (./ItemPaint draws it so until
// C2.5).
//
// Columns (D17): a column is {x, w, items, styles}, items stacked
// one under another (./DocStack); styles the style table its
// paragraphs are laid out with (a cell's: the table style's layer
// over doc.styles, R6). The page is the root column L.root {x:
// L.left, w: L.textW, items: L.items, styles: doc.styles}; an item's
// x and w are its column's (px), col its column and ci its index
// there; but a root item's w is its SECTION's first column's
// (Batch D D3: L.geom(s).cols[0].w, ./SectGeom; L.textW is the
// first section's text width), or for a root paragraph the width
// of the column it lands in when that is another (L.colW, Print
// layout's: ./ColPass widthOf, D23), and its s that section's
// index (R12: pagination reads section starts from it; null in a
// cell). L.flow
// holds every item a caret goes into in flow order
// (D9, C3.1): a table's item at its start, then its cells' items row
// by row, cell by cell (a vMerge continue cell's too; nested tables
// the same way), then the table's item AGAIN at its end; an item's
// index is its (first) place there, a table's endIndex its second
// (./DocPos placeOf). Without a table L.flow is L.items itself: it
// is made at the first table (C7 fix: a table-free layout builds no
// second array, and its paragraphs' items take no table path).
// L.byId maps every id, at every depth, to its item. Code that
// places or draws an item reads it.x / it.w, never L.left / L.textW
// (those stay the page's).
//
// gapAbove / gapBelow (px, 0) and marks (drawn only, never text)
// come from ./DocStack's decorators (deco: their result, carried
// over under the same reuse key, boxes too: see ./DocStack). An
// item's mark (a paragraph's or a kept block's) is its section-end
// mark when it is the last block of a section that is not the last,
// else null (./SectDeco draws the band under it).
//
// prev's lines of a paragraph are kept when prev was laid out with
// the same metrics, doc, text width and scope (L.ns, ./PicRead
// docMap: what is a picture); doc.styles, doc.numbering
// and doc.rawSettings are the very objects prev saw (they are
// replaced, never changed, by an edit); and the reuse keys agree:
// the same paragraph object, the same list label
// (./LineLabel sameLabel) and the same mark, and its computed field
// values the same (./FieldPass relayOf, D18: only when L.fields is
// not prev's); and its column has the
// same width and styles object (in a cell: the cell's text width and
// layer, D20; on the page: the item's width, its section's, so a
// section given another geometry re-breaks only its paragraphs),
// and, when L.floats is not prev's (a view switch, P12.2), the
// paragraph may hold no floating picture (./PicLine floatsIn), and
// its wrap key (./WrapPass wrapKey: the exclusions beside it,
// relative to its top, P12.3) is prev's (or prev's item's alt's, the
// lines it had before its key last changed: ./ItemReuse swapAlt).
// L.anchored (Print layout's): the ids of root items that may hold a
// float (prev's, and those not kept that floatsIn says hold one, or
// that are floating tables; a root table also when prev had no
// floats, P12.7; ./WrapPass reads it). A
// table's item is kept whole (./TblReuse reuseTable:
// the same block object, width and styles, labels and decorators;
// with floats not prev's, none in it; the same ./WrapPass cellKey),
// else rebuilt keeping the
// rows it can (./TblItems); kept items get
// their places in L.flow (index, endIndex) and L.byId from this
// layout (./TblReuse register). prev is USED UP by the new layout
// (prev.spent: its kept items are now this one's): offered again, it
// gives nothing (no reuse), and it is never laid out or painted
// again; only ids may be read from it (./Selection clamp).
//
// For pagination (D7, ./Pages): L.dirtyFrom is the first root index
// whose item was not adopted from prev's item at the same index or
// whose section's props object is not prev's (and, set by
// ./DocStack, whose gaps or table height changed), at most the
// shorter item count when the count changed; Infinity when none; 0
// with no prev to keep from, other decorators or another top.
// L.cleanFrom: every root item from it on was adopted from prev's
// item delta places before (delta: the change in item count), its
// section's props prev's, its height and gaps the same (Infinity:
// none known). ./ItemReuse track and dirtyEnd. Pure: no desktop
// services.
import {labels} from './ListNumbers';
import {markOf} from './SectMark';
import {moveColumn} from './TblReuse';
import {keepable, dirtyEnd} from './ItemReuse';
import {relayOf, carry} from './FieldPass';
import {itemOf, BOX} from './ItemMake';
import {outlineOf, indentOf} from './OutlineLayout';

export {markOf, moveColumn, BOX};
export {sameMark, reuseKey, sameKey} from './ItemReuse';

const NO_IDS = new Set();             // (never changed: copied first)


/** See the header. */
export function buildItems(L, doc, prev) {
  L.styles = doc.styles;
  L.numbering = doc.numbering;
  L.settings = doc.rawSettings;
  L.items = [];
  const col = L.root = {x: L.left, w: L.textW, items: L.items,
    styles: doc.styles};
  L.flow = null;
  L.byId = new Map();
  L.labels = labels(doc);
  const keep = keepable(L, doc, prev);
  if (prev) prev.spent = true;
  const ol = L.ol = L.outline ? outlineOf(doc, L.outline) : null;
  const ctx = {L, keep, prev, make: null, w: col.w, s: 0, row: null,
    dx: 0,
    share: keep && prev.decorators === L.decorators,
    proot: keep ? prev.root : null, head: Infinity, bad: -1,
    delta: 0, relay: keep ? relayOf(L, doc, prev) : null,
    refloat: keep && !prev.floats !== !L.floats,
    wrap: keep && !!(L.wrap || prev.wrap), own: false};
  L.anchored = keep && L.floats && prev.floats && prev.anchored ||
    NO_IDS;
  const secs = doc.sections;
  for (const sec of secs) ctx.delta += sec.blocks.length;
  if (ol) ctx.delta = ol.shown;
  if (keep) ctx.delta -= prev.items.length;
  L.sectProps = secs.map((sec) => sec.props);
  ctx.make = (b, c, depth) => itemOf(ctx, b, c, depth, null);
  let k = 0;                           // (ol's row)
  for (let s = 0; s < secs.length; s++) {
    const bs = secs[s].blocks;
    const sp = keep && prev.sectProps[s] !== secs[s].props;
    if (sp) ctx.head = Math.min(ctx.head, L.items.length);
    const end = bs.length - 1;
    const mark = markOf(doc, s);
    ctx.s = s;
    const w = ctx.w = L.geom(s).cols[0].w;
    for (let i = 0; i <= end; i++) {
      const row = ol && ol.rows[k++];
      if (row && row.hidden) continue;    // (collapsed: D32)
      if (row) ctx.w = w - (ctx.dx = indentOf(row, w));
      ctx.row = row || null;
      L.items.push(itemOf(ctx, bs[i], col, 1, i === end ? mark
        : null, L.items.length));
    }
    if (sp) ctx.bad = L.items.length - 1;
  }
  dirtyEnd(ctx);
  if (keep) carry(L, prev);
  // (no table: the same items in the same order)
  if (!L.flow) L.flow = L.items;
}
