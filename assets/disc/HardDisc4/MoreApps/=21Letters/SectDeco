// SectDeco - the band drawn under the last block of a section (but
// the last): a ./DocStack decorator, and what ./DocPaint and
// ./DocLayout need to draw it and to keep clicks out of it.
//
//   sectDeco(item, L, acc) -> {gapBelow: BAND, marks: [mark]} for
//                      an item with a section-end mark (./DocItems:
//                      a paragraph, or a kept block's box), else
//                      null
//   BAND            18 px: the band's height
//   bandOf(item)    -> the band mark of an item, or null
//   inBand(item, y) -> true when y is in the item's band
//   bandPaint(mark, w, labelW) -> {y1, y2, dots: [[a, b]...],
//                      label: x | null}: a double dotted rule across
//                      the text column (w px), y1 and y2 its two
//                      lines' offsets from the band's top, its label
//                      (labelW px wide) in the middle with a gap
//                      round it (null: too narrow, no label)
//
// The mark: {kind: 'section', type, label, dy, h}: the band is dy
// below the item's end (item.y + item.h: under a paragraph's space
// after, or under the box; dy is the gap below the decorators
// before it gave, acc.gapBelow: a bottom border's, ./BorderGroups,
// else 0) and h (BAND) high; label is
// ./SectMark sectLabel's ('Section break (Next page)'). It is in
// the item's gapBelow, so it belongs to no item: never text, never
// selected; a click in it is the end of the item above it
// (./DocLayout hitTest). The mark depends only on item.mark, which
// is in the reuse key, and on the gaps of the decorators before it,
// worked out with it: no keyOf. Pure: no desktop services.
import {sectLabel} from './SectMark';

export const BAND = 18;
const GAP = 6;                         // round the label

/** See the header. */
export function sectDeco(it, L, acc) {
  const m = it.mark;
  if (!m) return null;
  const dy = acc && acc.gapBelow > 0 ? acc.gapBelow : 0;
  return {gapBelow: BAND, marks: [Object.freeze({kind: 'section',
    type: m.type, label: sectLabel(m.type), dy, h: BAND})]};
}

/** See the header. */
export function bandOf(it) {
  for (const m of (it && it.marks) || []) {
    if (m && m.kind === 'section') return m;
  }
  return null;
}

/** See the header. */
export function inBand(it, y) {
  const m = bandOf(it);
  if (!m) return false;
  const top = it.y + it.h + m.dy;
  return y >= top && y < top + m.h;
}

/** See the header. */
export function bandPaint(m, w, labelW) {
  const mid = Math.round(m.h / 2);
  const out = {y1: mid - 2, y2: mid + 1, dots: [[0, w]], label: null};
  const lw = Number.isFinite(labelW) && labelW > 0 ? labelW : 0;
  if (!lw || lw + 4 * GAP > w) return out;
  const x = (w - lw) / 2;
  out.label = x;
  out.dots = [[0, x - GAP], [x + lw + GAP, w]];
  return out;
}
