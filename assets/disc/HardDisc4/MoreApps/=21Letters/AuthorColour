// AuthorColour - one colour per author, for the comments (Batch F1,
// ./CommentPaint, ./CommentBox) and the tracked changes (Batch F2,
// ./RevPaint), so an author keeps the same colour in both.
//
//   colourOf(author) -> 0..5  the palette entry for an author's name
//       (FNV-1a of its UTF-16 units, the same on every run; anything
//       but a string is '')
//   PALETTE  six frozen {soft, light, strong}: soft a comment's
//       colour, light a resolved one's, strong the selected one's
//       (pale tints, multiplied into the white page)
//   INK      six '#rrggbb', the same hues dark enough to draw text
//       and lines in on the white page (a tracked change's text, its
//       underline or strike line)
//   inkOf(author) -> INK[colourOf(author)]
//
// The page is always white paper in this app (on its grey desk,
// whatever the desktop around it), so these are fixed colours, not
// the desktop's. Pure: no desktop services.

const tint = (soft, light, strong) => Object.freeze({soft, light,
  strong});
export const PALETTE = Object.freeze([
  tint('#fbe7a1', '#fdf4d4', '#f2cc45'),   // yellow
  tint('#cbe8c1', '#e7f4e2', '#8ccb7b'),   // green
  tint('#f6cbd7', '#fbe7ed', '#e98ba7'),   // pink
  tint('#c8dcf4', '#e5eefa', '#83afe6'),   // blue
  tint('#e0cff1', '#f0e7f8', '#b693de'),   // violet
  tint('#f8d4b3', '#fcebdc', '#ef9f5f'),   // orange
]);

export const INK = Object.freeze(['#8a6a00', '#2e7d32', '#c2185b',
  '#1565c0', '#6a1b9a', '#c25400']);

/** See the header. */
export function colourOf(author) {
  const s = typeof author === 'string' ? author : '';
  let h = 0x811c9dc5;
  for (let k = 0; k < s.length; k++) {
    h ^= s.charCodeAt(k);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h % PALETTE.length;
}

/** See the header. */
export const inkOf = (author) => INK[colourOf(author)];
