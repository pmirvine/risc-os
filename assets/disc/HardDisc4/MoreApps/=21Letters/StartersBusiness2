// StartersBusiness2 - the rest of the Business group (see
// ./StartersBusiness): every placeholder in [square brackets];
// British conventions; A4, margins 1440 (text width 9026). Built-in
// styles; colours only as theme references; no blank paragraphs.
//
//   pressRelease()  "FOR IMMEDIATE RELEASE" bold; the headline as
//     Title, a Subtitle; the first paragraph begins with the
//     dateline "[Town, 5 November 2026] -"; three body paragraphs
//     and, after the second, a Quote-style paragraph for the
//     quotation; a centred bold "ENDS" straight after the body;
//     then "Notes to editors" (Heading 1, two numbered notes) and
//     "Media contact" (Heading 1, name, telephone, email).
//   newsletter()    three sections: the masthead (Title, Subtitle
//     with a rule under it) in one column; four articles (Heading 2
//     and two paragraphs each, one Quote pull-quote) in two columns
//     with 708 between; a closing line in one column. The breaks are
//     continuous (the kit's sectionBreak type is how the section it
//     ends starts; starterDoc finalType how the last starts).
//   flyer()         one page: a large centred Title (96 half-points),
//     Subtitle, a centred bold line "[Date] | [Time] | [Place]", four
//     bullets, a centred bold call to action and a contact line.
//     Spacing before and after, no tables.
import {para, run, list, sectionBreak, starterDoc}
  from './StarterKit';
import {h1, h2, tight} from './StartersBusiness';

/** See the header. */
export function pressRelease() {
  const body = (t) => para(t);
  return starterDoc({title: 'Press release', body: [
    para(run('FOR IMMEDIATE RELEASE', {b: true}),
      {spacing: {after: 240}}),
    para('[Headline that says what happened]', {style: 'Title'}),
    para('[Subheading that adds one more detail]',
      {style: 'Subtitle'}),
    para([run('[Town, 5 November 2026] - ', {b: true}),
      '[Open with who, what, when and where, in one or two ' +
      'sentences.]']),
    body('[Add the key facts: figures, names and why it matters to ' +
      'the reader.]'),
    para('"[A short quotation that gives a view or a reason.]" ' +
      '[Name], [position]', {style: 'Quote'}),
    body('[Say what happens next, and where to find out more.]'),
    para(run('ENDS', {b: true}), {align: 'center',
      spacing: {before: 360}}),
    h1('Notes to editors'),
    ...list(['[Background on the organisation]',
      '[Further facts, links or images available]'], 'number'),
    h1('Media contact'),
    tight('[Name], [Position]'), tight('[Telephone]'), tight('[Email]'),
  ]});
}

/** See the header. */
export function newsletter() {
  const art = (n) => [h2(`[Article ${n} headline]`),
    para('[Open with the main point in a sentence or two, then say ' +
      'who it affects.]'),
    para('[Add the detail readers need: dates, places and what to ' +
      'do next.]')];
  return starterDoc({title: 'Newsletter', finalType: 'continuous',
    body: [
      para('[Newsletter name]', {style: 'Title'}),
      para('[Issue / date]', {style: 'Subtitle', border: {bottom:
        {sz: 12, space: 4, themeColor: 'accent1'}},
      spacing: {after: 240}}),
      sectionBreak({type: 'continuous', cols: {num: 1, space: 708}}),
      ...art(1), ...art(2),
      para('"[A pull-quote: one line from an article, set apart.]"',
        {style: 'Quote'}),
      ...art(3), ...art(4),
      sectionBreak({type: 'continuous', cols: {num: 2, space: 708}}),
      para('[Contact details]', {spacing: {before: 240}}),
    ]});
}

/** See the header. */
export function flyer() {
  const mid = (t, o = {}, r) => para(r ? run(t, r) : t,
    {align: 'center', ...o});
  return starterDoc({title: 'Flyer', body: [
    para(run('[Event or offer]', {sz: 96}), {style: 'Title',
      align: 'center', spacing: {before: 1200, after: 240}}),
    mid('[A line that says what it is and why to come]',
      {style: 'Subtitle', spacing: {after: 480}}),
    mid('[Date] | [Time] | [Place]', {spacing: {after: 600}},
      {b: true, sz: 32}),
    ...list(['[Detail: what is on]', '[Detail: who it is for]',
      '[Detail: cost or how to book]', '[Detail: what to bring]'],
    'bullet', {spacing: {after: 120}}),
    mid('[Call to action]', {spacing: {before: 720, after: 720}},
      {b: true, sz: 40}),
    mid('[Name] | [Telephone] | [Email]'),
  ]});
}
