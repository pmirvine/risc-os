// Paragraph-mark revisions (w:pPr/w:rPr holding w:ins, w:del,
// w:moveFrom or w:moveTo) on split and join. Pure: the pPr objects
// are shared between paragraphs and never changed in place.

const REV = ['w:ins', 'w:del', 'w:moveFrom', 'w:moveTo'];
const isMark = (x) => x && x.name === 'w:rPr';
const revs = (n) => n.children.filter((c) => REV.includes(c.name));

/** The mark's revision children of pPr (an array, maybe empty). */
export function markRevs(pPr) {
  const n = ((pPr && pPr.extra) || []).find(isMark);
  return n ? revs(n) : [];
}

/** pPr with the mark's revision children removed (an rPr left
 *  empty is dropped); pPr itself when it has none. */
export function markWithout(pPr) {
  if (!markRevs(pPr).length) return pPr;
  const extra = [];
  for (const x of pPr.extra) {
    if (!isMark(x)) { extra.push(x); continue; }
    const children = x.children.filter((c) => !REV.includes(c.name));
    if (children.length) extra.push({...x, children});
  }
  return {...pPr, extra};
}

/** pPr of `first` carrying the mark revision of `second`'s pPr,
 *  when second has one and first has none; else first. */
export function markFrom(first, second) {
  const add = markRevs(second);
  if (!add.length || markRevs(first).length) return first;
  const extra = [...((first && first.extra) || [])];
  const k = extra.findIndex(isMark);
  if (k < 0) extra.push({name: 'w:rPr', attrs: [], children: add});
  else extra[k] = {...extra[k],
    children: [...add, ...extra[k].children]};
  return {...first, extra};
}
