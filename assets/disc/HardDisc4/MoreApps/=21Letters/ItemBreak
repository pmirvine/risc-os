// ItemBreak - a paragraph item broken into lines as ./DocStack
// breaks it (Batch D P12a fix: the one call, for ./DocStack and the
// wrap passes' guesses, ./WrapWant).
//
//   breakItem(L, it, styles, shape?) -> {h, lines}  ./LineLayout
//       layoutPara of paragraph item it of layout L at its width
//       it.w with styles (its column's: doc.styles on the page, a
//       cell's own), L.cacheFor(styles), its list label, the
//       default tab stop (L.defPx, else ./TabStops defaultStop),
//       L.ns, L.fieldText, L.floats and the wrap shape (./WrapPass
//       shapeIn, or none). In Outline view with Show first line
//       only (L.outline.first, ./OutlineFold) only a paragraph's
//       first line is kept, and h is that line's with the space
//       after (the rest of the text has no line: a caret there is
//       drawn at the end of the first)
//
// Pure: no desktop services.
import {layoutPara} from './LineLayout';
import {defaultStop} from './TabStops';

/** See the header. */
export function breakItem(L, it, styles, shape) {
  const r = layoutPara(it.block, styles, it.w, L.metrics,
    L.cacheFor(styles), it.list || undefined,
    L.defPx ?? defaultStop(L.doc) / 15, L.ns, L.fieldText, L.floats,
    shape);
  if (!(L.outline && L.outline.first) || r.lines.length < 2) return r;
  const a = r.lines[0], z = r.lines[r.lines.length - 1];
  return {lines: [a], h: a.y + a.h + (r.h - z.y - z.h)};
}
