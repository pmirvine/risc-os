// LineTokens - one paragraph as the tokens ./LineLayout breaks into
// lines, each with the model offsets (UTF-16 indices into Para.text)
// it stands for.
//
//   tokens(para, styles, cache, map?, fieldText?, floats?, markup?,
//          toc?)
//                    -> [{t, text, f, kind, from, to, shown, pic?,
//                    field?, anchor?, rev?}]
//   t     'w' a word or a piece of one (no break inside), 's' spaces,
//         'tab', 'nl' (a line break), 'pb' (a page or column break:
//         ./BreakMarks, with its label), 'z' (an unseen inline: drawn
//         as nothing, zero width; it sticks to the word next to it)
//   kind  'text' | 'link' | 'box' | 'pic' | 'tab' | 'break' |
//         'pagebreak' | 'anchor'
//   shown true when text is not the model text of [from, to)
//   map   the scope raw inlines are read in (./PicRead docMap)
//   floats  Print layout's (P12.2, D26): an understood floating
//         picture is a 'z' token of kind 'anchor' (./PicLine
//         picToken), zero width; else (Draft, Web) as before
//   fieldText  (para, off) -> {from, to, text, b, e} | null: a
//         field result shown computed (./FieldShow, D18), asked at
//         each w:fldChar and w:fldSimple inline (a paragraph without
//         one asks nothing): [from, to) is drawn as ONE 'w' token,
//         shown, of that text, in the format of the result's first
//         run (an empty result: the separate fldChar's run); field
//         {b, e} on it (the begin and end offsets: ./SelMove). Also
//         asked at each footnote or endnote mark (a noteRef inline,
//         ./NoteNumbers): its number, or custom text, one token in
//         the run's format; without fieldText a mark draws as its
//         custom text, else '#'
//   markup  the markup view (./RevView: 'final', the default, 'all'
//         or 'original'): which tagged runs are hidden. In All
//         Markup each token of a tagged run has its tag (rev): the
//         layout keeps it on the item (never joined to one of
//         another tag, ./LineLayout), for ./RevPaint
//   toc   para lies inside a TOC field's result (./TocParas): true,
//         or a function asked only at a _Toc link (so a keystroke
//         in other text never looks for the fields)
//
// U+FFFC items stand for one offset each: a hyperlink shows its text
// run by run, each in its own run's colour, underline, strike,
// highlight and shading as Word draws it (./LinkRuns: a run styled
// Hyperlink is blue and underlined by that style, a run with no such
// style plain), its font, size, bold and italic the format there for
// the whole link, as before (so widths, and the pages, do not change);
// a link whose runs cannot be read back to its text is drawn in link
// blue, underlined, as before;
// one to a _Toc bookmark in a paragraph inside a TOC field's result,
// toc, or in a TOC n or Table of Figures one (a table of contents
// entry) all in the format there, as Word draws it; other
// wrappers with text (an insertion, a
// simple field, a content control...) show it in the format there.
// Their text breaks into words and spaces like any other (so it can
// wrap): the first piece stands for [i, i+1), the later ones for the
// empty [i+1, i+1), all shown (there is no offset inside the item);
// a tab in that text is a 'tab' token (it goes to the next stop, as
// in Word; a link's carries link: true, kept on its layout item, so
// a click on a TOC entry's leader follows the link), a newline is
// drawn as it is. The unseen kinds
// of ./Kinds (proofing marks, bookmarks, field codes) and deletions
// are 'z'; so is a run of text the markup view hides (Batch F2,
// ./Kinds hiddenRev: in Final a 'del' or 'mvFrom' tag, in Original
// an 'ins' or 'mvTo' one, in All Markup none): one 'z' for all of
// it, in the plain format, as the raw w:del it was read from was
// drawn (the only place the view changes the layout); a
// non-breaking hyphen is '-', a soft hyphen nothing; a picture
// ./PicRead understands is one 'w' token of kind 'pic', text ''
// (./PicLine picToken); anything else is a small grey [...] box.
// A run boundary inside a surrogate pair is moved past the pair.
// Pure: no desktop services.
import {OBJ} from './Model';
import {runFmt} from './Fmt';
import {unseen, localName, hiddenRev} from './Kinds';
import {isPageBreak, pbToken} from './BreakMarks';
import {picToken} from './PicLine';
import {isCustom} from './NoteNumbers';
import {linkRuns} from './LinkRuns';

export const PLAIN = {rPr: {extra: []}};

/**
 * A space for line breaking (and hanging at a wrap): only U+0020.
 * Tabs and breaks are tokens of their own; U+00A0, U+2002, U+3000
 * and the like are word characters. The regexes below agree.
 */
export const isSpace = (ch) => ch === ' ';

const linkFmt = (f) => ({...f, colour: '#0000c0', under: true,
  css: f.css});

const TOC_STYLE = /^(toc [1-9]|table of figures)$/i;

/** Whether paragraph style id (or one it is based on) is TOC 1..9
 *  or Table of Figures, by name. */
function tocStyled(styles, id) {
  const t = styles && styles.styles instanceof Map ? styles.styles
    : null;
  let s = t && id !== undefined ? t.get(id) : undefined;
  for (let k = 0; s && k < 12; k++) {
    if (typeof s.name === 'string' && TOC_STYLE.test(s.name.trim()))
      return true;
    s = s.basedOn === undefined ? undefined : t.get(s.basedOn);
  }
  return false;
}

/** A table of contents entry: a link to a hidden _Toc bookmark in a
 *  paragraph inside a TOC field's result (ps.toc) or in a TOC n or
 *  Table of Figures one, which Word draws plain (its Hyperlink style
 *  not shown); a _Toc link elsewhere (Word makes them for links to
 *  headings) is drawn as a link. */
const tocEntry = (x, ps) => Array.isArray(x.node.attrs) &&
  x.node.attrs.some(([n, v]) => n.split(':').pop() === 'anchor' &&
    /^_Toc/i.test(String(v))) &&
  (tocStyled(ps.styles, ps.para.pStyle) || (typeof ps.toc ===
    'function' ? ps.toc() === true : ps.toc === true));
const boxFmt = (f) => {
  const px = Math.max(8, Math.round(f.px * 0.75));
  return {...f, px, colour: '#606060', under: false, strike: false,
    css: `${px}px "Liberation Sans", sans-serif`};
};

/** The text of a raw inline that is a w:t (a tab in a w:t...). */
function bareT(x) {
  const n = x.node;
  if (x.kind !== 'raw' || !n || typeof n.name !== 'string' ||
    n.name.split(':').pop() !== 't') return '';
  return (n.children || []).filter((c) => typeof c === 'string')
    .join('');
}

/** Words, spaces, tabs and breaks of text (at offset off) in f. */
function words(text, off, f, out) {
  for (const m of text.matchAll(/ +|\t|\n|[^ \t\n]+/g)) {
    const s = m[0], from = off + m.index, to = from + s.length;
    if (s === '\t') {
      out.push({t: 'tab', text: '', f, kind: 'tab', from, to,
        shown: true});
    } else if (s === '\n') {
      out.push({t: 'nl', text: '', f, kind: 'break', from, to,
        shown: true});
    } else {
      out.push({t: isSpace(s[0]) ? 's' : 'w', text: s, f,
        kind: 'text', from, to, shown: false});
    }
  }
}

/** The words and spaces of an inline's text: see the header (later:
 *  not its first piece, all from i + 1). */
function shownWords(text, i, f, kind, out, later = false) {
  let from = later ? i + 1 : i;
  for (const m of text.matchAll(/ +|\t|[^ \t]+/g)) {
    const s = m[0], tab = s === '\t';
    const tk = {t: tab ? 'tab' : isSpace(s[0]) ? 's' : 'w',
      text: tab ? '' : s, f, kind: tab ? 'tab' : kind, from,
      to: i + 1, shown: true};
    // a link's tab (a TOC entry's leader) is still the link
    if (tab && kind === 'link') tk.link = true;
    out.push(tk);
    from = i + 1;
  }
}

/** f with the look of g that does not change widths (see the
 *  header). */
const lookOf = (f, g) => ({...f, colour: g.colour, under: g.under,
  strike: g.strike, highlight: g.highlight, shade: g.shade});

/** A link's tokens, run by run in each run's look (see the
 *  header). */
function linkWords(x, i, f, out, map, ps) {
  const segs = linkRuns(x, map);
  if (!segs) {
    shownWords(x.text, i, linkFmt(f), 'link', out);
    return;
  }
  let later = false;
  for (const g of segs) {
    shownWords(g.text, i, lookOf(f, runFmt(ps.styles, ps.para, g.run,
      ps.cache)), 'link', out, later);
    later = true;
  }
}

/** The tokens of the inline x at offset i, in format f. */
function inline(x, i, f, out, map, floats, ps) {
  const one = (t, text, g, kind, shown = true) => out.push({t, text,
    f: g, kind, from: i, to: i + 1, shown});
  const l = localName(x.node), bare = bareT(x);
  if (isPageBreak(x)) out.push(pbToken(x, i, f));
  else if (x.kind === 'br' || bare === '\n') one('nl', '', f, 'break');
  else if (x.kind === 'tab' || bare === '\t') one('tab', '', f, 'tab');
  else if (bare === OBJ) one('w', bare, f, 'text', false);
  else if (bare) shownWords(bare, i, f, 'text', out);
  else if (x.kind === 'noteRef') {
    one('w', isCustom(x) ? x.custom : '#', f, 'text');
  }
  else if (unseen(x)) one('z', '', f, 'text');
  else if (l === 'noBreakHyphen') one('w', '-', f, 'text');
  else if (x.text && l === 'hyperlink') {
    if (tocEntry(x, ps)) shownWords(x.text, i, f, 'link', out);
    else linkWords(x, i, f, out, map, ps);
  } else if (x.text) shownWords(x.text, i, f, 'text', out);
  else {
    const pic = picToken(x, i, f, map, floats);
    if (pic) out.push(pic);
    else one('w', '[...]', boxFmt(f), 'box');
  }
}

/** The computed results of para, from fieldText (the header). */
function shows(para, ft) {
  const out = [], s = para.text, xs = para.inlines || {};
  for (let k = s.indexOf(OBJ); k >= 0; k = s.indexOf(OBJ, k + 1)) {
    const l = localName((xs[k] || {}).node);
    const v = (l === 'fldChar' || l === 'fldSimple' ||
      (xs[k] || {}).kind === 'noteRef') && ft(para, k);
    if (v) out.push(v);
  }
  return out;
}

/** toks with each computed result v of vs as one token: one merge
 *  pass (toks and vs in offset order; a v overlapping one before it,
 *  a field nested in a result shown, is left out). The token takes
 *  the format of the first token of the result, else of the token
 *  before (an empty result); with neither v is left out. */
function atomic(toks, vs) {
  const out = [], n = toks.length;
  const sorted = vs.every((v, k) => !k || vs[k - 1].from <= v.from)
    ? vs : [...vs].sort((a, b) => a.from - b.from);
  let j = 0, end = -Infinity;
  const inside = (t, v) => t.from >= v.from && t.to <= v.to;
  for (const v of sorted) {
    if (v.from < end) continue;
    while (j < n && toks[j].from < v.from) out.push(toks[j++]);
    const t0 = j < n && inside(toks[j], v) ? toks[j]
      : out[out.length - 1];
    if (!t0 || !t0.f) continue;
    while (j < n && inside(toks[j], v)) j++;
    out.push({t: 'w', text: v.text, f: t0.f, kind: 'text',
      from: v.from, to: v.to, shown: true, field: {b: v.b, e: v.e}});
    end = v.to;
  }
  while (j < n) out.push(toks[j++]);
  return out;
}

/** See the header. */
export function tokens(para, styles, cache, map, fieldText,
  floats, markup, toc) {
  const out = [], ps = {para, styles, toc, cache};
  const text = para.text, n = text.length;
  const runs = para.runs.length ? para.runs
    : [{start: 0, end: n, rPr: {extra: []}}];
  // a boundary inside a surrogate pair moves past it
  const fix = (b) => {
    b = Math.min(Math.max(b, 0), n);
    const c = text.charCodeAt(b - 1);
    return b > 0 && b < n && c >= 0xd800 && c < 0xdc00 &&
      (text.charCodeAt(b) & 0xfc00) === 0xdc00 ? b + 1 : b;
  };
  const piece = (from, to, run) => {
    if (to <= from) return;
    const f = runFmt(styles, para, run, cache);
    let k = from;
    for (let i = from; i <= to; i++) {
      if (i < to && text[i] !== OBJ) continue;
      if (i > k) words(text.slice(k, i), k, f, out);
      if (i < to) {
        inline(para.inlines[i] || {}, i, f, out, map, floats, ps);
      }
      k = i + 1;
    }
  };
  let at = 0;
  for (const run of runs) {
    const s = Math.max(at, fix(run.start));
    const e = Math.max(s, fix(run.end));
    piece(at, s, PLAIN);
    if (hiddenRev(run.rev, markup)) {
      if (e > s) out.push({t: 'z', text: '', kind: 'text', from: s,
        to: e, shown: true, f: runFmt(styles, para, PLAIN, cache)});
    } else {
      const k = out.length;
      piece(s, e, run);
      if (markup === 'all' && run.rev) {
        for (let j = k; j < out.length; j++) out[j].rev = run.rev;
      }
    }
    at = e;
  }
  piece(at, n, PLAIN);
  const vs = fieldText ? shows(para, fieldText) : null;
  return vs && vs.length ? atomic(out, vs) : out;
}
