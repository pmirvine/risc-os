// StylesMerge - merging property objects without sharing anything.
//
// Rules: later layers win key by key; plain objects (spacing, ind,
// rFonts...) merge recursively; arrays named `extra` concatenate
// (earlier layers first); any other array replaces the earlier value;
// undefined is skipped; null is a value like any other, so a null in
// a higher layer overwrites a lower value with null. Everything put
// into the result is copied, so it never aliases a table or paragraph.

const isObj = (v) => typeof v === 'object' && v !== null &&
  !Array.isArray(v);

/** Merge `src` into `dst`, both property objects; returns `dst`. */
export function mergeInto(dst, src) {
  if (!isObj(src)) return dst;
  for (const k of Object.keys(src)) {
    const v = src[k];
    if (v === undefined) continue;
    if (k === 'extra' && Array.isArray(v)) {
      dst.extra = (Array.isArray(dst.extra) ? dst.extra : [])
        .concat(structuredClone(v));
    } else if (isObj(v)) {
      if (!isObj(dst[k])) dst[k] = {};
      mergeInto(dst[k], v);
    } else {
      dst[k] = structuredClone(v);
    }
  }
  return dst;
}
