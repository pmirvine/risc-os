// ViewMenu - the View submenu of a document's window menu (Batch D,
// D29; ./WinMenu puts it after Insert):
//
//   viewMenu(dw) -> a Menu
//     Print layout      the pages, as they will print (ticked when
//                       shown: the four views are radios)
//     Web layout        the text as wide as the window, no page
//                       edges, headers or footers (./WebView)
//     Outline           the headings indented by level, + / - / o
//                       markers (./OutlineLayout, D32)
//     Draft             the text on one long page, no page edges
//     Formatting marks  ticked while on: Print layout draws the page,
//                       column and section breaks as labelled rules
//                       (Draft always does)
//     Ruler             ticked while the ruler is shown (moved here
//                       from Format: dw.setRuler)
//     Header and footer ticked in the header and footer mode (D14):
//                       enters it at the caret's page's header
//                       (Print layout shown first), or leaves it
//                       (./HdrMode toggle)
//     Header and footer options >  the mode's menu (./HdrMenu:
//                       different first page, odd and even, link to
//                       previous, go to, remove); shaded outside it
//     Field codes       ticked while the fields show their codes,
//                       { PAGE }, in place of their results (display
//                       only; this window: ./FieldView setCodes);
//                       Shift+F9
//     Field shading >   Never, When selected (Word's default),
//                       Always: a light grey behind field results
//                       (./FieldShade; the app's choice, kept)
// Only Field codes has a key: Word's Ctrl-Alt-P and Ctrl-Alt-N need
// Alt, which !Letters' keys do not use, and no RISC OS key is given
// up for them (./Keymap: F9 stays Redo). The view is ./ViewMode's.
import {Menu} from 'riscos';
import {setView, setMarks} from './ViewMode';
import {toggle} from './HdrMode';
import {hdrMenu} from './HdrMenu';
import {isNote} from './NoteEdit';

/** The header and footer mode (not the notes mode: ./NoteEdit). */
const isHf = (m) => !!m && !isNote(m);
import {setCodes, codesOn, shadingOf, setShading} from './FieldView';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';

/** See the header. */
export function viewMenu(dw) {
  const radio = (text, view, help, more = {}) => ({text,
    ticked: () => dw.viewName === view,
    action: () => { setView(dw, view); }, help, ...more});
  return new Menu('View', [
    radio('Print layout', 'print', 'Show the document as pages, ' +
      'as they will print, one below the other.'),
    radio('Web layout', 'web', 'Show the text as a web page: as ' +
      'wide as the window, with no page edges, headers or footers.'),
    radio('Outline', 'outline', 'Show the document as an outline: ' +
      'each heading indented by its level, its text below it.'),
    radio('Draft', 'draft', 'Show the text on one long page, ' +
      'without page edges: the quickest view to type in.',
    {dotted: true}),
    {text: 'Formatting marks', ticked: () => !!dw.view.marks,
      action: () => setMarks(dw, !dw.view.marks),
      help: 'Show the page, column and section breaks as labelled ' +
        'lines in Print layout (Draft always shows them).'},
    {text: 'Ruler', ticked: () => !!dw.rulerOn,
      action: () => dw.setRuler(!dw.rulerOn),
      help: 'Show or hide the ruler under the toolbar: the ' +
        'paragraph\'s indents and tab stops, to drag.'},
    {text: 'Header and footer', ticked: () => isHf(dw.view.hdr),
      action: () => toggle(dw),
      help: 'Edit the page\'s header and footer (the body is shown ' +
        'pale); choose again, double-click the body or press ' +
        'Escape to go back to the text.'},
    {text: 'Header and footer options',
      shaded: () => !isHf(dw.view.hdr),
      submenu: () => hdrMenu(dw),
      help: 'Different first page, odd and even pages, link to ' +
        'the previous section, remove: in the header and footer ' +
        'mode.', dotted: true},
    {text: 'Field codes', ticked: () => codesOn(dw),
      key: macLabel(keymap.labelFor('fieldCodes'), dw.view.mac),
      action: () => { setCodes(dw, !codesOn(dw)); },
      help: 'Show each field\'s code, such as { PAGE }, in place ' +
        'of its result; choose again to show the results.'},
    {text: 'Field shading', submenu: () => shadingMenu(dw.app),
      help: 'When to draw a light grey behind field results.'},
  ]);
}

/** View > Field shading (see the header). */
function shadingMenu(app) {
  const it = (text, mode, help) => ({text, help,
    ticked: () => shadingOf(app) === mode,
    action: () => { setShading(app, mode); }});
  return new Menu('Field shading', [
    it('Never', 'never', 'Never shade field results.'),
    it('When selected', 'selected', 'Shade a field\'s result ' +
      'while the caret or the selection is in it.'),
    it('Always', 'always', 'Always shade field results.'),
  ]);
}
