// ClipRead - HTML pasted from other programs -> clipboard blocks (the
// shape of ./ClipSlice), read with a whitelist. The HTML is
// untrusted: it is parsed by the caller's `parseHtml` (DOMParser in
// the browser, which runs no script and loads nothing for a parsed
// document) and only walked here: no innerHTML, nothing evaluated,
// fetched or kept but text and a few checked formats.
//
//   readHtml(html, parseHtml, opts?) -> {blocks, styleNames} | null
//       null when there is nothing to paste or anything throws: the
//       caller pastes the plain text instead. opts {textTw}: the
//       text width where the paste goes (./ClipReadTable)
//   readTree(root, limits?, opts?) -> {blocks, styleNames}
//       root: a DOM-like node: nodeType (1 element, 3 text, 4 CDATA,
//       9 document, 11 fragment; others skipped), nodeName,
//       childNodes, data, getAttribute(name). Entities are decoded
//       by the parser (DOMParser does).
//   LIMITS {depth: 200, nodes: 200,000, text: 5,000,000, html}
//       elements nested deeper than depth are unwrapped (their
//       text kept, their formatting and structure ignored; dropped
//       and hidden ones still dropped); after `nodes` nodes the
//       walk stops (it bounds the work at any depth); text past
//       `text` units is cut; HTML longer than `html` is not read.
//
// Elements: p div h1-h6 ul ol li pre blockquote and the other
// sectioning elements are paragraphs (an empty one makes none); li
// items are ordinary paragraphs (no list is made); h1-h6 are bold at
// Word's heading sizes (./Fmt.HEADING_PT) with pStyle 'Heading' + n,
// named 'heading n' in styleNames, so ./ClipClean gives them the
// target's Heading n style when it has one. br is a line break, hr
// a paragraph end. A <table> is a table block (./ClipReadTable,
// Batch C6.3: rows, cells, spans, widths, shading, borders; its cells
// read by these rules into Builders of their own sharing the text
// limit; a <caption> a paragraph before it) up to depth
// ./ClipReadTable LIMITS.depth (8), and while the cells of all its
// tables stay within LIMITS.cells and its nodes and text within what
// is left of `nodes` and `text` (counted before it is read, so a
// table is never cut short); otherwise, or a table it does not read,
// it is flattened: a row is a paragraph, its cells joined by tabs
// (blocks in a cell are spaces). b strong i em
// u ins s strike del sup sub th font and the style attribute
// (./ClipCss) format text; a is its text only (href never kept or
// followed). script style iframe object embed img svg link meta head
// title noscript template and the like are dropped with their
// content, as are elements styled display:none (and Word's list
// labels, mso-list:ignore). Any other element is unwrapped: its
// content is read, the element ignored. Comments (Word's
// conditional comments too) are skipped. Event attributes and every
// attribute but style (and color size face on font, id on b) are
// never read. Google Docs wraps a copy in <b style="font-weight:
// normal" id="docs-internal-guid-..."> : not bold.
//
// The walk: ./ClipWalk. White space, line breaks and paragraphs:
// ./ClipBuild. Pure: no desktop services.
import {Builder} from './ClipBuild';
import {walk, skipped, cellFmt} from './ClipWalk';
import {readTable, LIMITS as TL} from './ClipReadTable';
import {walkBlocks} from './Walk';

export const LIMITS = Object.freeze({depth: 200, nodes: 200000,
  text: 5000000, html: 4000000});

/** The nodes in el (not itself) when they and their text (an
 *  element one unit) fit what is left in ctx and b; else -1. */
function sizeOf(el, ctx, b) {
  let nodes = ctx.limits.nodes - ctx.nodes;
  let text = ctx.limits.text - b.tally.total;
  const room = nodes, st = [[el, 0]];
  while (st.length) {
    const top = st[st.length - 1], kids = top[0].childNodes;
    if (!kids || top[1] >= kids.length) {
      st.pop();
      continue;
    }
    const c = kids[top[1]++];
    if (--nodes < 0) return -1;
    if (!c || typeof c !== 'object') continue;
    if (c.nodeType === 3 || c.nodeType === 4) {
      text -= typeof c.data === 'string' ? c.data.length : 0;
    } else if (c.nodeType === 1) {
      text--;
      st.push([c, 0]);
    }
    if (text < 0) return -1;
  }
  return room - nodes;
}

/** ctx.table for ./ClipWalk: a <table> read by ./ClipReadTable into
 *  b; false when it is flattened instead. */
const tableHook = (ctx) => (el, g, b, depth) => {
  if (ctx.tdepth >= TL.depth) return false;
  const n0 = ctx.nodes;
  let size = 0;
  const f0 = {...g, cell: 0, row: undefined};
  const inner = (frame, into) => {
    const base = ctx.base;
    ctx.base = depth + 2;
    ctx.tdepth++;
    walk(frame, into, ctx);
    ctx.base = base;
    ctx.tdepth--;
  };
  const t = readTable(el, {
    skip: skipped,
    fits: (x, cells) => {
      if (ctx.cells + cells > TL.cells) return false;
      size = sizeOf(x, ctx, b);
      if (size < 0) return false;
      ctx.cells += cells;
      return true;
    },
    cell: (td) => {
      const cb = new Builder(ctx.limits.text, b.tally);
      inner({n: td, i: 0, f: cellFmt(td, f0), exit: null}, cb);
      cb.flush();
      return cb.blocks;
    },
    caption: (c) => {
      b.flush();
      inner({n: c, i: 0, f: f0, exit: null}, b);
      b.flush();
    },
  }, {textTw: ctx.opts.textTw, nodes: ctx.limits.nodes - ctx.nodes});
  if (!t) return false;
  ctx.nodes = Math.max(ctx.nodes, n0 + size);
  b.block(t);
  return true;
};

/** See the header. */
export function readTree(root, limits = LIMITS, opts = {}) {
  const b = new Builder(limits.text);
  const ctx = {limits, nodes: 0, base: 0, tdepth: 0, cells: 0,
    opts: opts || {}, table: null};
  ctx.table = tableHook(ctx);
  walk({n: {childNodes: [root]}, i: 0, f: {cell: 0}, exit: null}, b,
    ctx);
  b.flush();
  const heads = new Map();
  for (const {b: x} of walkBlocks(b.blocks)) {
    if (x.pStyle && !heads.has(x.pStyle)) {
      heads.set(x.pStyle, {name: 'heading ' + x.pStyle.slice(7),
        type: 'paragraph'});
    }
  }
  return {blocks: b.blocks, styleNames: heads};
}

/** See the header. */
export function readHtml(html, parseHtml, opts) {
  if (typeof html !== 'string' || !html || html.length > LIMITS.html ||
    typeof parseHtml !== 'function') return null;
  try {
    const r = readTree(parseHtml(html), LIMITS, opts);
    return r.blocks.length ? r : null;
  } catch (e) {
    return null;
  }
}
