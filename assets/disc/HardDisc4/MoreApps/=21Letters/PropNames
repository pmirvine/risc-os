// PropNames - the property fields of the Model, and the WML element
// (its local name) each field is read from and written as. The one
// list for the writer (./WriteProps) and for edits (./OpsProps).
//
//   RPR_FIELDS, PPR_FIELDS, SECT_FIELDS   Map field -> element name
//   withoutRaw(extra, names)  `extra` without the raw elements
//                             w:<name> for each name (a new array,
//                             or `extra` itself if none was there)
//
// An edit of a field replaces the element: a raw element of the same
// name kept in `extra` (one the reader could not model, such as
// w:color with w:themeColor, or w:spacing with w:beforeAutospacing)
// is dropped when the field is set or deleted, even when the edit
// changes only part of it. Raw elements are matched by the prefix w
// (or none), as the writer writes them, unless the element's own
// xmlns attribute binds that prefix to another namespace.
import {W} from './Ns';

const pairs = (names) => new Map(names.map((n) => [n, n]));

/** Run properties (w:rPr children). */
export const RPR_FIELDS = pairs(['rFonts', 'b', 'i', 'strike', 'color',
  'sz', 'szCs', 'highlight', 'u', 'vertAlign', 'shd']);

/** Paragraph properties (w:pPr children). */
export const PPR_FIELDS = pairs(['keepNext', 'keepLines',
  'pageBreakBefore', 'numPr', 'spacing', 'ind', 'jc', 'outlineLvl',
  'tabs', 'pBdr', 'shd', 'widowControl', 'contextualSpacing']);

/** Section properties (w:sectPr children). */
export const SECT_FIELDS = pairs(['pgSz', 'pgMar', 'cols', 'titlePg',
  'type']);

const named = (n, names) => n !== null && typeof n === 'object' &&
  typeof n.name === 'string' && !rebound(n) && names.some((x) =>
    n.name === 'w:' + x || n.name === x);

/** Whether n's own xmlns attribute puts its prefix in a namespace
 *  other than WordprocessingML (then it is not ours to replace). */
function rebound(n) {
  const i = n.name.indexOf(':');
  const decl = i < 0 ? 'xmlns' : 'xmlns:' + n.name.slice(0, i);
  return Array.isArray(n.attrs) && n.attrs.some((a) =>
    Array.isArray(a) && a[0] === decl && a[1] !== W);
}

/** See the header. */
export function withoutRaw(extra, names) {
  if (!names.length || !extra.some((n) => named(n, names)))
    return extra;
  return extra.filter((n) => !named(n, names));
}
