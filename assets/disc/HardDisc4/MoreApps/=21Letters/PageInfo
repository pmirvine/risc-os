// PageInfo - the text of a document window's info line (Batch D,
// D30): where the caret is.
//
//   pageInfo(L, sel) -> string   for the caret (sel.head, its
//       affinity) in layout L:
//     Print layout (L.place has pages: ./PlacePrint):
//       'Page 3 of 12'      the caret's page (its index + 1: blank
//                           pages count) of the pages worked out,
//                           the caret's worked out first (./Pages
//                           ofPos); '...' after the count while
//                           pages are still to be worked out
//                           ('Page 3 of 12...')
//       ' (Section 2)'      after it when the document has more
//                           than one section: the section of the
//                           caret's root item (a cell's: its
//                           table's, R12 it.s)
//     Draft: 'Section 2' with more than one section, else ''
//     '' with no selection or a position not in the layout
// Pure: no desktop services.
import {rootOf} from './PageFind';

/** The section index of item it's root item in L (0: not known). */
function sectionOf(L, it) {
  const k = rootOf(L, it), root = k >= 0 ? L.items[k] : null;
  return root && Number.isInteger(root.s) ? root.s : 0;
}

/** See the header. */
export function pageInfo(L, sel) {
  const pos = sel && sel.head;
  const it = pos && L.byId.get(pos.id);
  if (!it) return '';
  const many = L.doc.sections.length > 1;
  const s = many ? sectionOf(L, it) + 1 : 0;
  const P = L.place && L.place.pages;
  if (!P) return many ? 'Section ' + s : '';
  const i = P.ofPos(pos, sel.affinity || 'down');
  if (i < 0) return '';
  return 'Page ' + (i + 1) + ' of ' + P.count +
    (P.done ? '' : '...') + (many ? ' (Section ' + s + ')' : '');
}
