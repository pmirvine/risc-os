// ClipWalk - the whitelist walk of pasted HTML for ./ClipRead (the
// rules are in its header): elements in, ./ClipBuild calls out.
//
//   walk(frame, b, ctx)  walks frame.n's children (frame {n, i: 0,
//       f, exit: null}; f the format in force) into Builder b, with
//       an explicit stack (no recursion). ctx: {limits (./ClipRead
//       LIMITS), nodes (counted here, shared), base (the depth of
//       frame.n: elements deeper than limits.depth are unwrapped),
//       table(el, g, b, depth) -> boolean}: a <table> outside a
//       flattened cell goes to ctx.table first (g its format, depth
//       its depth); true: read there (./ClipReadTable), skipped here;
//       false: flattened here (a row a paragraph, cells joined by
//       tabs, blocks in a cell spaces).
//   skipped(el) -> boolean  an element dropped (with its content) or
//       hidden (display:none, mso-hide:all, mso-list:ignore)
//   cellFmt(el, f) -> the format of table cell el (td / th) under f:
//       its tag's (th bold), its style's, text-align as jc
//
// Every node read counts toward ctx.nodes; the walk stops at
// limits.nodes or when b is full. Pure: no desktop services.
import {parseStyle, colour, family, fontTagSize} from './ClipCss';
import {HEADING_PT} from './Fmt';
import {attrOf as attr} from './ClipDom';

const DROP = new Set(['script', 'style', 'iframe', 'object', 'embed',
  'img', 'svg', 'link', 'meta', 'head', 'title', 'noscript',
  'template', 'math', 'canvas', 'video', 'audio', 'picture', 'source',
  'track', 'select', 'option', 'textarea', 'input', 'frame',
  'frameset', 'applet', 'param', 'base', 'map', 'area', 'dialog']);
const BLOCK = new Set(['p', 'div', 'ul', 'ol', 'li', 'pre', 'xmp',
  'listing', 'blockquote', 'section', 'article', 'header', 'footer',
  'main', 'nav', 'aside', 'address', 'figure', 'figcaption', 'dl',
  'dt', 'dd', 'center', 'form', 'fieldset', 'legend', 'details',
  'summary', 'caption', 'table', 'thead', 'tbody', 'tfoot', 'tr']);
const FMT = {b: {b: true}, strong: {b: true}, th: {b: true},
  i: {i: true}, em: {i: true}, cite: {i: true}, dfn: {i: true},
  u: {u: true}, ins: {u: true}, s: {strike: true},
  strike: {strike: true}, del: {strike: true},
  sup: {vert: 'superscript'}, sub: {vert: 'subscript'},
  pre: {pre: true}, xmp: {pre: true}, listing: {pre: true}};
const STYLE_KEYS = ['b', 'i', 'u', 'strike', 'vert', 'color', 'sz',
  'font', 'pre'];

const nameOf = (el) => String(el.nodeName || '').toLowerCase();

/** Format g after the tag `name` of el (changes g). */
function tagFmt(name, el, g) {
  const h = /^h([1-6])$/.exec(name);
  if (h) {
    g.head = +h[1];
    g.b = true;
    g.sz = HEADING_PT[g.head - 1] * 2;
    return;
  }
  if (name === 'b' && /^docs-internal-guid/.test(attr(el, 'id') || ''))
    return;
  if (Object.hasOwn(FMT, name)) Object.assign(g, FMT[name]);
  if (name !== 'font') return;
  const c = colour(attr(el, 'color') || '');
  const sz = fontTagSize(attr(el, 'size') || '');
  const fa = family(attr(el, 'face') || '');
  if (c) g.color = c;
  if (sz) g.sz = sz;
  if (fa) g.font = fa;
}

/** See the header. */
export function skipped(el) {
  return el.nodeType === 1 && (DROP.has(nameOf(el)) ||
    !!parseStyle(attr(el, 'style'), 11).hidden);
}

/** See the header. */
export function cellFmt(el, f) {
  const g = {...f, cell: 0, row: undefined};
  tagFmt(nameOf(el), el, g);
  const st = parseStyle(attr(el, 'style'), g.sz ? g.sz / 2 : 11);
  for (const k of STYLE_KEYS) if (st[k] !== undefined) g[k] = st[k];
  if (st.jc) g.jc = st.jc;
  return g;
}

/**
 * The frame for element (or document) el under format f, or null
 * to skip it (dropped, hidden, read as a table, or a br / hr
 * handled here).
 */
function enter(el, f, b, ctx, depth) {
  if (el.nodeType !== 1) return {n: el, i: 0, f, exit: null};
  const name = nameOf(el);
  if (DROP.has(name)) return null;
  const inCell = f.cell > 0;
  if (name === 'br' || name === 'hr') {
    if (inCell) b.soft(f);
    else if (name === 'br') b.br(f);
    else b.flush();
    return null;
  }
  const g = {...f};
  tagFmt(name, el, g);
  const st = parseStyle(attr(el, 'style'), g.sz ? g.sz / 2 : 11);
  if (st.hidden) return null;
  for (const k of STYLE_KEYS) if (st[k] !== undefined) g[k] = st[k];
  const block = BLOCK.has(name) || g.head !== f.head;
  if (block && st.jc) g.jc = st.jc;
  if (name === 'table' && !inCell && ctx.table &&
    ctx.table(el, g, b, depth)) return null;
  if (name === 'tr') g.row = {n: 0};
  if (name === 'td' || name === 'th') {
    if (f.row && f.row.n++ > 0) b.tab(g);
    g.cell = (f.cell || 0) + 1;
    return {n: el, i: 0, f: g, exit: null};
  }
  if (!block) return {n: el, i: 0, f: g, exit: null};
  const edge = () => (inCell ? b.soft(g) : b.flush());
  edge();
  return {n: el, i: 0, f: g, exit: edge};
}

/**
 * An element nested deeper than limits.depth: unwrapped (its text
 * read in the format around it), unless dropped or hidden.
 */
const deep = (el, f) => (skipped(el) ? null
  : {n: el, i: 0, f, exit: null});

/** See the header. */
export function walk(frame, b, ctx) {
  const {limits} = ctx;
  const stack = [frame];
  while (stack.length) {
    const top = stack[stack.length - 1];
    const kids = top.n.childNodes;
    const stop = b.full || ctx.nodes >= limits.nodes;
    if (stop || !kids || top.i >= kids.length) {
      stack.pop();
      if (top.exit) top.exit();
      continue;
    }
    const c = kids[top.i++];
    ctx.nodes++;
    if (!c || typeof c !== 'object') continue;
    const t = c.nodeType;
    if (t === 3 || t === 4) {
      const s = c.data;
      if (typeof s === 'string' && s) b.text(s, top.f);
      continue;
    }
    if (t !== 1 && t !== 9 && t !== 11) continue;
    const d = stack.length + ctx.base;
    const fr = d > limits.depth ? deep(c, top.f)
      : enter(c, top.f, b, ctx, d);
    if (fr) stack.push(fr);
  }
}
