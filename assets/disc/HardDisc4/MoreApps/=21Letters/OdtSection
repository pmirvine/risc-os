// OdtSection - text:section of an OpenDocument text (OpenDocument
// 1.3 part 3, 5.4) for ./OdtRead: a named group of paragraphs,
// lists, tables and sections, read in place like the body.
//
//   PART  {elements: text:section, text:section-source}
//
// A section's children are read as the body's (nested sections too:
// the XML depth limit bounds them). Its text:section-source (a link
// to another file) is never followed: a note. A hidden section
// (text:display none, condition or true) is read as normal text
// (a note: hidden sections are shown). Protection is ignored.
// Pure: no desktop services.
import {attr} from './OdtXml';

const HIDDEN = new Set(['none', 'condition', 'true']);

function section(ctx, node) {
  if (HIDDEN.has(attr(node, 'text:display'))) {
    ctx.note('hidden sections are shown');
  }
  ctx.walk(node);
}

export const PART = {elements: new Map([['text:section', section],
  ['text:section-source', (ctx) => ctx.note('linked sections are not ' +
    'followed: their text is what the file holds')]])};
