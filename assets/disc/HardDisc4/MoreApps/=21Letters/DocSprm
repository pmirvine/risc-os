  PIlfo: 0x460B, PFNoLineNumb: 0x240C, PChgTabsPapx: 0xC60D,
  PDxaRight80: 0x840E, PDxaLeft80: 0x840F, PNest80: 0x4610,
  PDxaLeft180: 0x8411, PDyaLine: 0x6412, PDyaBefore: 0xA413,
  PDyaAfter: 0xA414, PChgTabs: 0xC615, PFInTable: 0x2416,
  PFTtp: 0x2417, PDxaAbs: 0x8418, PDyaAbs: 0x8419,
