export const NAMES = new Map(Object.entries(OPS).map(([k, v]) =>
  [v, k]));

/** See the header. */
export const sprmOf = (op) => ({ispmd: op & 0x1FF,
  fSpec: (op >> 9) & 1, sgc: (op >> 10) & 7, spra: op >> 13});

// (little-endian, from the bytes themselves: no DataView a call)
const has = (b, at, n) => b && at >= 0 && at + n <= b.length;
export const u8 = (b, at = 0) => (has(b, at, 1) ? b[at] : 0);
export const u16 = (b, at = 0) => (has(b, at, 2)
  ? b[at] | (b[at + 1] << 8) : 0);
export const i16 = (b, at = 0) => (u16(b, at) << 16) >> 16;
export const i32 = (b, at = 0) => (has(b, at, 4)
  ? b[at] | (b[at + 1] << 8) | (b[at + 2] << 16) | (b[at + 3] << 24)
  : 0);
export const u32 = (b, at = 0) => i32(b, at) >>> 0;

/** The operand at `at` of sprm op: [count bytes, value bytes], or
 *  null when its length cannot be read before `to`. */
function lengthOf(bytes, op, at, to) {
  const spra = op >> 13;
  if (spra !== 6) return [0, SIZES[spra]];
  if (op === OPS.TDefTable) {
    if (at + 2 > to) return null;
    return [2, Math.max(0, u16(bytes, at) - 1)];
  }
  if (at + 1 > to) return null;
  const cb = bytes[at];
  if (op === OPS.PChgTabs && cb === 255) {
    // (the counts give it: PChgTabsDelClose 1 + 4 per tab,
    // PChgTabsAdd 1 + 3 per tab)
    if (at + 2 > to) return null;
    const del = bytes[at + 1];
    const addAt = at + 2 + 4 * del;
    if (addAt + 1 > to) return null;
    return [1, 1 + 4 * del + 1 + 3 * bytes[addAt]];
  }
  return [1, cb];
}

/** See the header. */
export function readSprms(bytes, from, to, note) {
  const out = [];
  if (!(bytes instanceof Uint8Array)) return out;
  let at = Math.max(0, from | 0);
  const end = Math.min(bytes.length, Math.max(0, to | 0));
  while (at + 2 <= end) {
    const op = bytes[at] | (bytes[at + 1] << 8);
    const len = lengthOf(bytes, op, at + 2, end);
    if (!len || at + 2 + len[0] + len[1] > end) {
      if (note) note(BAD);
      return out;
    }
    const v = at + 2 + len[0];
    out.push({op, size: len[0] + len[1],
      operand: bytes.subarray(v, v + len[1])});
    at = v + len[1];
  }
  if (at < end && bytes[at] !== 0 && note) note(BAD);
  return out;
}
