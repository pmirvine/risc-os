  CDxaSpace: 0x8840, CIco: 0x2A42, CHps: 0x4A43, CHpsPos: 0x4845,
  CIss: 0x2A48, CHpsKern: 0x484B, CRgFtc0: 0x4A4F,
  CCharScale: 0x4852, CFDStrike: 0x2A53, CFImprint: 0x0854,
  CFSpec: 0x0855, CFObj: 0x0856, CFEmboss: 0x0858,
  CIbstRMarkDel: 0x4863, CDttmRMarkDel: 0x6864, CShd80: 0x4866,
  CCv: 0x6870, CShd: 0xCA71, CCvUl: 0x6877,
  // paragraphs (sgc 1)
  PIstd: 0x4600, PJc80: 0x2403, PFKeep: 0x2405,
