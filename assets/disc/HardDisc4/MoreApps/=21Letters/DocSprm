// DocSprm - the property modifiers of a Word 97-2003 .doc
// ([MS-DOC] 2.2.5.1 Sprm, 2.2.5.2 Prl, 2.6 the sprm tables): a
// grpprl (a run of Prls: a 2-byte sprm, then its operand) read
// into a list. Used by ./DocFkp, ./DocStyles, ./DocChp, ./DocPap;
// pure.
//
//   readSprms(bytes, from, to, note?) -> [{op, size, operand}]
//       the Prls of bytes from..to: op the sprm (16 bits), size the
//       operand's length in the file (its count bytes included),
//       operand a view of its value (a variable one without its
//       count). The size is the sprm's spra's (SIZES: 0, 1 -> 1, 2
//       -> 2, 3 -> 4, 4, 5 -> 2, 7 -> 3), for spra 6 its first
//       byte; sprmTDefTable's a 2-byte cb (cb - 1 bytes follow) and
//       sprmPChgTabs' cb 255 the size its counts give. A Prl that
//       would run past `to` ends the list (with note(BAD), once per
//       call); a trailing byte of 0 is padding. Every Prl takes at
//       least 2 bytes, so the list ends
//   sprmOf(op) -> {ispmd, fSpec, sgc, spra}   the sprm's fields
//   OPS  {name: op} of the sprms the readers act on (or keep for
//       later modules: sections, tables), named as [MS-DOC] does
//       without 'sprm': OPS.CFBold 0x0835
//   NAMES  Map op -> name (OPS the other way)
//   u8, i16, u16, i32, u32 (operand, at?) -> number   operand
//       values (0 when the operand is too short)
export const SIZES = Object.freeze([1, 1, 2, 4, 2, 2, -1, 3]);
export const BAD = 'formatting in the file is damaged: some of it ' +
  'is not read';

export const OPS = Object.freeze({
  // characters (sgc 2)
  CFRMarkDel: 0x0800, CFRMarkIns: 0x0801, CFFldVanish: 0x0802,
  CPicLocation: 0x6A03, CIbstRMark: 0x4804, CDttmRMark: 0x6805,
