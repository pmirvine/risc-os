// PageCursor - cursors into a galley (Batch D, D2) and the two
// searches ./Paginate makes.
//
//   cursor(k, line, dy?, cuts?) -> a frozen Cursor {k, line, dy?,
//       cuts?}: root item k, its line `line` (0 for a block without
//       lines; a table's row: ./PageRows, P4.1), dy px of that line
//       (or block) already shown on the page before (a cut; only
//       when > 0), cuts (a table's row split, frozen: per cell the
//       first of its lines on the page; only when given)
//   sameCursor(a, b)     two cursors at the same place (cuts by
//       value)
//   sameCuts(a, b)       two cuts lists (or none) alike
//   cutOrder(a, b) -> < 0, 0, > 0  two cursors at the same item and
//       line ordered by how much of it is shown before: dy, then a
//       row's cuts (none first, then by their sum: the cuts of one
//       row's parts only grow)
//   breakFrom(list, j) -> the first index >= j in a sorted list of
//       line indices (a paragraph's page breaks), or -1
//   lastFit(it, ls, j, limit) -> the last line >= j of item it
//       (lines ls, y from it.y) whose bottom is at or above galley
//       y limit, or j - 1 when none (a binary search: line bottoms
//       never go up)
//
// Pure: no desktop services.

/** See the header. */
export function cursor(k, line, dy, cuts) {
  const c = {k, line};
  if (dy > 0) c.dy = dy;
  if (cuts) c.cuts = Object.isFrozen(cuts) ? cuts
    : Object.freeze([...cuts]);
  return Object.freeze(c);
}

/** See the header. */
export const sameCuts = (a, b) => a === b || (!!a && !!b &&
  a.length === b.length && a.every((v, i) => v === b[i]));

/** See the header. */
export const sameCursor = (a, b) => a.k === b.k &&
  a.line === b.line && (a.dy || 0) === (b.dy || 0) &&
  sameCuts(a.cuts, b.cuts);

const sumOf = (c) => (c.cuts ? c.cuts.reduce((s, v) => s + v, 1)
  : 0);

/** See the header. */
export const cutOrder = (a, b) => (a.dy || 0) - (b.dy || 0) ||
  sumOf(a) - sumOf(b);

/** See the header. */
export function breakFrom(list, j) {
  if (!list || !list.length) return -1;
  let lo = 0, hi = list.length;
  while (lo < hi) {
    const m = (lo + hi) >> 1;
    if (list[m] < j) lo = m + 1;
    else hi = m;
  }
  return lo < list.length ? list[lo] : -1;
}

/** See the header. */
export function lastFit(it, ls, j, limit) {
  let lo = j, hi = ls.length - 1, r = j - 1;
  while (lo <= hi) {
    const m = (lo + hi) >> 1;
    if (it.y + ls[m].y + ls[m].h <= limit) {
      r = m;
      lo = m + 1;
    } else hi = m - 1;
  }
  return r;
}
