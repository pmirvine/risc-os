// StartersLetters - the Letters group of starter templates: each
// builder returns a Doc (./StarterKit starterDoc). Every placeholder
// is in [square brackets]; British conventions; A4.
//
//   businessLetter()   sender block, date, recipient, reference,
//                      salutation, subject, three paragraphs,
//                      "Yours sincerely,", signature space, enclosures
import {para, run, starterDoc} from './StarterKit';

const TIGHT = {spacing: {after: 0}};
const lines = (list, o = {}) => list.map((t) =>
  para(t, {...TIGHT, ...o}));

/** See the header. */
export function businessLetter() {
  const gap = {spacing: {after: 240}};
  return starterDoc({title: 'Business letter', body: [
    ...lines(['[Your name]', '[Address line 1]', '[Address line 2]',
      '[Town]', '[Postcode]', '[Telephone]', '[Email]'],
    {align: 'right'}),
    para('[5 November 2026]', {spacing: {before: 360, after: 360}}),
    ...lines(['[Recipient name]', '[Recipient position]',
      '[Company name]', '[Address line 1]', '[Town]', '[Postcode]']),
    para('Our ref: [reference]', {spacing: {before: 240, after: 240}}),
    para('Dear [Name],', gap),
    para(run('[Subject of your letter]', {b: true}), gap),
    para('[Open with the reason you are writing, in a sentence or ' +
      'two.]', gap),
    para('[Give the details the reader needs: dates, amounts, ' +
      'what you ask them to do.]', gap),
    para('[Close with the next step and how to reach you.]', gap),
    para('Yours sincerely,', {spacing: {after: 0}, keepNext: true}),
    ...lines(['', '', ''], {keepNext: true}),
    ...lines(['[Your name]', '[Your position]']),
    para('Enc: [enclosures]', {spacing: {before: 240}}),
  ]});
}
