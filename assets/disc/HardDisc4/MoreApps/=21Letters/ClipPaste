// ClipPaste - Paste and Cut in a document.
//
//   pasteBlocks(d, sel, blocks, {sameDoc, styleNames, styles, lists,
//     pics, picScope, notes, comments, report}) -> sel
//   pastePlain(d, sel, text) -> sel       ./Edit.typeText
//   cutSelection(d, sel) -> {slice, sel}  ./ClipSlice, then deleted
//                                (a range cutting a field made whole
//                                first: ./FieldEdit whole)
//   deleteSelection(d, sel) -> sel        ./EditDel's
//
// d is a ./Document, sel a ./Selection; each returns the selection
// after it (a caret at the end of what was put in) and makes one
// undo step (d.atomic: a paste that fails changes nothing, its
// RangeError is thrown again), or returns sel unchanged when there
// is nothing to do (nothing to paste, a position not in the
// document). Callers run them through Typing.command (a new undo
// step; typing after it starts another).
//
// pasteBlocks: blocks (./ClipSlice's shape) first go through
// ./ClipClean (sameDoc, styleNames, lists, styles: see there) and
// ./FieldPair paired (a field mark without its partners dropped), then
// the selection is deleted (./EditRange) and they go in at the caret,
// in the same step; tables nested deeper than 8 there are their text
// (./ClipPasteTbl fitDepth). One table block over a cells shape
// overwrites the rectangle's cells' contents instead (./ClipPasteTbl
// overwrite, D28, TB15: nothing deleted, no row or column added).
// At a kept block's edge (a table), as typing does, an empty
// paragraph is made there first (before it at off 0, after it at 1)
// and the blocks go into it. Into paragraph P at offset off:
//   - one paragraph: its content is spliced in (spliceText): P keeps
//     its id and properties, the pasted runs their formatting
//   - several blocks: P's text before off and the first block's
//     content are P's (its id, extraP; its properties, but the first
//     block's at off 0, where nothing of P is left before it); the
//     blocks between go in whole (fresh ids, extraP []; a table's
//     at every depth); the last block's content and P's text after
//     off (with its formatting) make a new paragraph (fresh id)
//     with P's properties: P's paragraph mark ends it. A first block
//     that is a table or a kept block
//     leaves P's head alone, and when that head is empty the blocks
//     go in before P, which keeps its id and takes the last block's
//     content; a last kept block leaves the tail on its own; a
//     table going in right after a table (typed or kept: ./TblCheck
//     endsCell) gets an empty paragraph before it, and pasted tables
//     next to each other one between them, at every depth
//     (./ClipCleanTbl apart; D27: tables never touch). Ops:
//     restoreBlock and one insertBlocks (linear: 100,000
//     paragraphs are one op).
// The caret: after the last block's content (at the start of the
// tail after a kept block).
// Lists and table styles from another document: ./ClipCarry.
// Lists (opts.lists, ./ClipNums): the pasted
// paragraphs that keep their properties (the first at off 0 and the
// ones between) and are in a list of opts.lists get that list made
// anew in the target (./NumCopy: its setDocPart ops first, in the
// same step) and their numPr names it (the paragraphs in a pasted
// table's cells too, at every depth: Batch C6.1); every other numPr
// of the source is dropped, as is one whose list cannot be made (no
// free id: a plain paragraph).
//
// Pictures (Batch B): from another document (opts.pics, picScope:
// ./ClipSlice), each kept picture's media becomes a new part of the
// target with a relationship of its own, the picture's r:embed and
// wp:docPr ids new (./ClipPics copyPics: its setDocPart ops after
// the lists', in the same step); in the same document every
// wp:docPr id in the pasted inlines is made fresh, the media shared,
// except a picture whose media an undo took away since the copy:
// that one is carried as from another document (./ClipPics
// samePaste). No id or name free: RangeError.
// Table styles (Batch C6.2): from another document (opts.styles,
// ./ClipSlice), the table styles the pasted tables name are the
// target's of the same name or copied into its style table with
// their basedOn chain (./TblStyleCopy copyStyles: its setDocPart op
// first, in the same step) and each tblStyle names the target's id.
//
// Footnotes and endnotes (Batch E2, ./ClipNotes): every mark the
// copy carried a note for (opts.notes, ./ClipSlice) gets a new note,
// a copy, under an id taken now (nextNoteId), in the same step; from
// another document the notes' styles by Word's name first
// (styleUp). A mark is dropped (its text around kept) in a note, a
// header or footer, a kind kept as bytes, with no id free, and
// when its note did not come: report.marks then says why ('note',
// 'unknown', 'free'; ./ClipRoute beeps). A note's own mark (its
// number) is kept only pasted into a note of the same document
// (./ClipClean toNote). The deleted selection's
// marks take their notes with them at the step's end (./NoteKeep).
//
// Comments (Batch F1, ./ClipComments): the comment marks are kept by
// ./ClipClean (cmtMarks) and every comment the copy carried whole
// (opts.comments, ./ClipSlice) gets a new comment, a copy, under an
// id taken now (nextCommentId, claimed) with a fresh w14:paraId, in
// the same step, its comments part made when the document has none;
// a reply under the new parent. From another document the comment
// styles by Word's name first (styleUp). Every other comment mark
// is dropped (its text around kept): one whose comment did not
// come (half a range, HTML), and every one in a header, footer or
// note, a comments part kept as bytes, with no id free:
// report.comments then says why ('story', 'unknown', 'free';
// ./ClipRoute). The deleted selection's marks take their comments
// with them at the step's end (./CommentKeep), so a cut and a paste
// is a move: the comment comes back under a new id.
//
// pastePlain: the text typed (\n splits paragraphs, controls go:
// ./Edit), one undo step of its own. Ops go to the caret's path
// (./EditPos loc.at), in a cell as at top level.
// Pure: no desktop services.
import {nextId, reserveIds, newPara} from './Model';
import {cut, join} from './OpsUtil';
import {caret, collapsed} from './Selection';
import {orderedPos, findBlock, sibOf} from './EditPos';
import {deleteRange, paraBy} from './EditRange';
import {deleteSelection} from './EditDel';
import {typeText} from './Edit';
import {guard, whole as wholeSel} from './FieldEdit';
import {paired} from './FieldPair';
import {clean} from './ClipClean';
import {slice} from './ClipSlice';
import {copyPics, samePaste} from './ClipPics';
import {freshTable, apart} from './ClipCleanTbl';
import {at as walkAt} from './Walk';
import {endsCell} from './TblCheck';
import {sib, depthOf} from './Path';
import {fitDepth, overShape, overwrite, landed}
  from './ClipPasteTbl';
import {relist, styled} from './ClipCarry';
import {carry, styleUp} from './ClipNotes';
import {carry as carryComments, styleUp as commentStyles}
  from './ClipComments';

export {deleteSelection};

const content = (b) => ({text: b.text, runs: b.runs,
  inlines: b.inlines});

/** A paragraph of content c with the properties of `from`. */
function para(id, c, from, extraP = []) {
  const p = {type: 'p', id, ...c, pPr: from.pPr};
  if (from.pStyle !== undefined) p.pStyle = from.pStyle;
  p.extraP = extraP;
  return p;
}

/** A pasted block, fresh ids (a table's at every depth: Batch C,
 *  ./ClipCleanTbl freshTable), for the middle. */
function whole(b) {
  if (b.type === 'p') return para(nextId(), join(content(b)), b);
  if (b.type === 'tbl') return freshTable(b);
  return {type: 'opaque', node: b.node};
}

/** Put list (cleaned, >= 1 block) in at loc/off; the caret. */
function insert(d, loc, off, list) {
  const P = loc.b, at = loc.at, n = list.length;
  const first = list[0], last = list[n - 1];
  if (n === 1 && first.type === 'p') {
    d.apply({op: 'spliceText', block: at, at: off, del: 0,
      content: content(first)});
    return {id: P.id, off: off + first.text.length};
  }
  const fp = first.type === 'p', lp = n > 1 && last.type === 'p';
  const head = fp ? join(cut(P, 0, off), content(first))
    : join(cut(P, 0, off));
  const tail = lp ? join(content(last), cut(P, off, P.text.length))
    : join(cut(P, off, P.text.length));
  reserveIds(d.doc);
  const mids = list.slice(fp ? 1 : 0, lp ? n - 1 : n).map(whole);
  const end = lp ? last.text.length : 0;
  if (!head.text && !fp) {
    // nothing of P before: the blocks go in before P (not right
    // after a table: D27)
    const prev = at[at.length - 1] > 0 ? walkAt(d.doc, sib(at, -1))
      : null;
    if (endsCell(mids[0]) && endsCell(prev))
      mids.unshift(newPara(''));
    d.apply({op: 'insertBlocks', at, blocks: mids});
    d.apply({op: 'restoreBlock', block: sibOf(loc, mids.length),
      snapshot: para(P.id, tail, P, P.extraP)});
    return {id: P.id, off: end};
  }
  const t = para(nextId(), tail, P);
  d.apply({op: 'restoreBlock', block: at, snapshot:
    para(P.id, head, fp && off === 0 ? first : P, P.extraP)});
  d.apply({op: 'insertBlocks', at: sibOf(loc, 1),
    blocks: [...mids, t]});
  return {id: t.id, off: end};
}

/** The indexes of list whose pPr insert() keeps, at offset off. */
function kept(list, off) {
  const n = list.length, out = [];
  if (n === 1 && list[0].type === 'p') return out;
  const fp = list[0].type === 'p';
  const lp = n > 1 && list[n - 1].type === 'p';
  if (fp && off === 0) out.push(0);
  for (let i = fp ? 1 : 0; i < (lp ? n - 1 : n); i++) out.push(i);
  return out;
}

/** See the header. */
export function pasteBlocks(d, sel, blocks, opts = {}) {
  const how = {...opts, toNote: d.note !== null && typeof d.note ===
    'object', cmtMarks: true};
  const fit = () => apart(paired(clean(blocks, d.doc, how)));
  let list = fit();
  if (!list.length) return sel;
  let o = orderedPos(d.doc, sel);
  if (!o) return sel;
  const g = guard(d.doc, sel, o);
  if (!g) return sel;                  // (./FieldEdit: a field)
  if (g !== sel) o = orderedPos(d.doc, sel = g);
  const over = collapsed(sel) ? null : overShape(d.doc, sel, list);
  let out = null;
  d.atomic(() => {
    // (a style made by name: the blocks mapped to it)
    if (!opts.sameDoc) {
      const a = styleUp(d, opts), b = commentStyles(d, opts);
      if (a || b) list = fit();
    }
    let pos = null, loc = null;
    if (!over) {
      pos = collapsed(sel) ? o.from : deleteRange(d, o);
      loc = findBlock(d.doc, pos.id);
      if (loc.b.type !== 'p') {
        pos = paraBy(d, loc, pos.off);
        loc = findBlock(d.doc, pos.id);
      }
    }
    if (over) list = [landed(d.doc, over, list[0])];
    list = fitDepth(list, over ? depthOf(over.table) : loc.depth);
    list = carryComments(d, carry(d, list, opts), opts);
    if (!opts.sameDoc) {
      if (opts.styles instanceof Map)
        list = styled(d, list, opts.styles);
      list = relist(d, list, over ? [0] : kept(list, pos.off),
        opts.lists);
      const c = copyPics(d.doc, list, opts.pics, opts.picScope);
      for (const op of c.ops) d.apply(op);
      list = c.blocks;
    } else {
      const c = samePaste(d.doc, list, opts.pics, opts.picScope);
      for (const op of c.ops) d.apply(op);
      list = c.blocks;
    }
    out = over ? overwrite(d, over, list[0])
      : insert(d, loc, pos.off, list);
  });
  return out ? caret(out) : sel;
}

/** See the header. */
export const pastePlain = (d, sel, text) => typeText(d, sel, text);

/** See the header. */
export function cutSelection(d, sel) {
  sel = wholeSel(d.doc, sel);          // (no half field: ./FieldEdit)
  const s = slice(d.doc, sel);
  if (!s) return {slice: null, sel};
  return {slice: s, sel: deleteSelection(d, sel)};
}
