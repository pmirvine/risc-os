// DeepEqual - equality of model data, the one rule (./ModelCheck and
// ./Model re-export it; split from ./ModelCheck in Batch D P6.3).
//
//   deepEqual(a, b)   plain data: objects (key order does not
//                     matter), arrays, Xml nodes, primitives; a Map
//                     equals a Map with the same keys, each value
//                     deepEqual (key order does not matter); a Set
//                     a Set with the same members (by identity); a
//                     byte array (any typed array) one of the same
//                     kind, length and elements. The same object:
//                     true at once. (Before P6.3 every two Maps were
//                     equal: doc.stories differences were invisible.)
//   sameStories(a, b) two doc.stories values: both absent (undefined
//                     or null), or Maps with the same part names in
//                     the SAME order (the order stories are written
//                     in), each Story deepEqual. Undo restores the
//                     Doc deep-equal, stories included (Batch D
//                     Global Constraints).
// Recursion is per level of the data (model data is shallow: tables
// are at most ./TblCheck MAX_DEPTH deep). Pure: no desktop services.

const isView = (v) => ArrayBuffer.isView(v) && !(v instanceof DataView);

function sameView(a, b) {
  if (!isView(b) || a.constructor !== b.constructor ||
    a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}

function sameMap(a, b) {
  if (!(b instanceof Map) || a.size !== b.size) return false;
  for (const [k, v] of a) {
    if (!b.has(k) || !deepEqual(v, b.get(k))) return false;
  }
  return true;
}

function sameSet(a, b) {
  if (!(b instanceof Set) || a.size !== b.size) return false;
  for (const v of a) if (!b.has(v)) return false;
  return true;
}

/** See the header. */
export function deepEqual(a, b) {
  if (a === b) return true;
  if (typeof a !== 'object' || typeof b !== 'object' ||
    a === null || b === null) return false;
  if (Array.isArray(a)) {
    if (!Array.isArray(b) || a.length !== b.length) return false;
    for (let i = 0; i < a.length; i++) {
      if (!deepEqual(a[i], b[i])) return false;
    }
    return true;
  }
  if (Array.isArray(b)) return false;
  if (a instanceof Map) return sameMap(a, b);
  if (a instanceof Set) return sameSet(a, b);
  if (isView(a)) return sameView(a, b);
  if (b instanceof Map || b instanceof Set || isView(b)) return false;
  const ka = Object.keys(a);
  if (ka.length !== Object.keys(b).length) return false;
  for (const k of ka) {
    if (!Object.hasOwn(b, k) || !deepEqual(a[k], b[k])) return false;
  }
  return true;
}

/** See the header. */
export function sameStories(a, b) {
  if (a === undefined || a === null || b === undefined || b === null)
    return (a ?? null) === (b ?? null);
  if (!(a instanceof Map) || !(b instanceof Map) || a.size !== b.size)
    return false;
  const kb = [...b.keys()];
  let i = 0;
  for (const [k, v] of a) {
    if (kb[i++] !== k || !deepEqual(v, b.get(k))) return false;
  }
  return true;
}
