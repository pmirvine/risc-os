// EditDel - the deleting commands of !Letters: Backspace, Delete, and
// their word forms; deleting the selection.
//
//   deleteBack(d, sel)        Backspace
//   deleteForward(d, sel)     Delete
//   deleteWordBack(d, sel)    Ctrl-Backspace: to the start of the
//                             word on the left (WimpLib/Segment)
//   deleteWordForward(d, sel) Ctrl-Delete: to the start of the next
//                             word
//   deleteSelection(d, sel)   the selected range (./EditRange)
//
// d is a ./Document, sel a ./Selection; each returns the selection
// after it: a caret (affinity 'down', no goalX), the same sel when
// nothing changes (an invalid or collapsed sel, the document's start
// or end), and one undo step (d.atomic: a command that fails changes
// nothing) when something does. With a selection, every command
// deletes it. deleteWordBack and deleteWordForward at a paragraph's
// start or end act as Backspace and Delete.
//
// Backspace and Delete remove one grapheme cluster (a surrogate
// pair, a letter with its accents, an emoji ZWJ sequence: as Word
// does for emoji and browsers' text fields do). At a paragraph's
// start (end) they merge it with the one before (after) by the
// ./EditRange merge rule, but never across a section break (a no-op
// here: the keys remove the break first, ./EditApply and
// ./SectBreak deleteBreakAt). Next to a
// kept block (a table) the first press selects the block and returns
// that selection without changing the document; the second, with it
// selected, deletes it. With the caret on a kept block's edge facing
// a paragraph: an empty paragraph there (or one holding only unseen
// inlines, such as a bookmark's marks) is removed, otherwise the
// caret just moves into it; the paragraph's bookmark marks whose
// partner stays go to the caret's place (a pair is never broken), and
// the last paragraph of a cell is never removed after a table (a cell
// ends with a paragraph: ./TblCheck endsCell). Nor is the paragraph
// between two tables, typed or Opaque (D27: written next to each
// other they are one table to Word; C7 fix): the caret goes into it.
//
// Unseen inlines (bookmarks, proofing marks, field codes: ./Kinds
// unseenAt) are never deleted by these keys: the keys look past the
// ones next to the caret and delete the character (or word) beyond
// them, keeping every unseen inline in what they delete; with only
// such inlines between the caret and the paragraph's edge, they join
// the paragraphs (the inlines kept). A selection deleted takes its
// inlines with it (bookmarks whole: ./BookmarkKeep).
// Ops go to the location's path (loc.at, ./EditPos): in a cell's
// paragraph the keys work inside the cell, and at the cell's edge
// (Backspace at its first paragraph's start, Delete at its last's
// end) they do nothing, no beep (EditPos neighbour: none across a
// cell boundary). By a typed table (Batch C3.4, D10, TB10; a kept
// (Opaque) block as above): Backspace at the start of the
// paragraph after it removes that paragraph when it is empty (as
// above: unseen inlines only) and not the last of its container
// (its section, or its cell) and no other table follows it, the
// caret then at the end of the table's last cell; otherwise the
// caret just goes there. Delete at the end of the paragraph
// before it removes that paragraph when it is empty and not after
// another table, the caret then at the start of the first cell;
// otherwise nothing. On a table's edge {t, 0|1} the keys work as
// for a kept block (select it, then delete it). Over a selection
// with an end in a cell, by its shape (./SelShape): Delete (and
// typing, ./EditRange) clears a 'cells' shape; Backspace removes its
// rows when it spans every grid column, the table when it is the
// whole table, else clears it (./RangeTbl backCells); a 'mixed'
// range goes with the rows it covers (./RangeTbl deleteIn).
// Pure: no desktop services.
import {prevWord, nextWord} from 'wimplib/Segment';
import {caret, select, collapsed} from './Selection';
import {prevG, nextG} from './DocPos';
import {checkPos, orderedPos, neighbour, posOf, topOnly}
  from './EditPos';
import {deleteRange, mergeAt} from './EditRange';
import {unseenAt, onlyUnseen} from './Kinds';
import {shapeOf} from './SelShape';
import {backCells} from './RangeTbl';
import {firstPos, lastPos} from './TblCmd';
import {at as walkAt} from './Walk';
import {endsCell} from './TblCheck';
import {marksIn, stillPaired, putMarks} from './BookmarkKeep';

const isTbl = (b) => b.type === 'tbl' && Array.isArray(b.rows);

/** Run fn in one group; its position (or null: none) as a caret. */
function run(d, sel, fn) {
  let out = null;
  d.atomic(() => { out = fn(); });
  return out ? caret(out) : sel;
}

const boxSel = (loc) => select(posOf(loc, 0), posOf(loc, 1));

/** A table (typed or Opaque) is beside loc on side dir, in its
 *  section or cell (the paragraph at loc must stay: D27). */
function tableBy(doc, loc, dir) {
  const o = neighbour(doc, loc, dir);
  return !!o && o.s === loc.s && endsCell(o.b);
}

/** See the header. */
export function deleteSelection(d, sel) {
  const o = orderedPos(d.doc, sel);
  if (!o || collapsed(sel)) return sel;
  return run(d, sel, () => deleteRange(d, o));
}

/** Backspace over a selection: a 'cells' shape as the header says,
 *  anything else as Delete. */
function backSelection(d, sel) {
  const o = orderedPos(d.doc, sel);
  const sh = o && !collapsed(sel) && !topOnly(o) && shapeOf(d.doc, sel);
  if (!sh || sh.kind !== 'cells') return deleteSelection(d, sel);
  if (!sh.whole) return run(d, sel, () => backCells(d, sh, o));
  const id = walkAt(d.doc, sh.table).id;
  return deleteSelection(d, select({id, off: 0}, {id, off: 1}));
}

/**
 * Delete [a, b) of the paragraph at loc but its unseen inlines (the
 * pieces between them, last first); the caret at `to`.
 */
function cutText(d, sel, loc, a, b, to) {
  const p = loc.b;
  return run(d, sel, () => {
    let z = b;
    for (let k = b - 1; k >= a - 1; k--) {
      if (k >= a && !unseenAt(p, k)) continue;
      if (z > k + 1) {
        d.apply({op: 'replaceText', block: loc.at, at: k + 1,
          del: z - k - 1, ins: ''});
      }
      z = k;
    }
    return {id: p.id, off: to};
  });
}

/**
 * At a block boundary: `loc` is where the caret is (a paragraph's
 * edge or a kept block's), dir -1 (Backspace) or 1 (Delete).
 */
function atEdge(d, sel, loc, dir) {
  const n = neighbour(d.doc, loc, dir);
  if (!n || n.s !== loc.s) return sel;
  if (isTbl(n.b) && loc.b.type === 'p') {
    return byTable(d, sel, loc, n, dir);
  }
  if (n.b.type !== 'p') return boxSel(n);
  if (loc.b.type !== 'p') {
    // a kept block's edge facing a paragraph (never the last of a
    // cell after a table: a cell ends with a paragraph)
    const tail = dir > 0 && loc.cell && endsCell(loc.b) &&
      !neighbour(d.doc, n, 1);
    if (!onlyUnseen(n.b) || tail || (endsCell(loc.b) &&
      tableBy(d.doc, n, dir))) {
      return caret(posOf(n, dir < 0 ? n.b.text.length : 0));
    }
    return removeEmpty(d, sel, n, sel.head);
  }
  return run(d, sel, () => (dir < 0 ? mergeAt(d, n, loc)
    : mergeAt(d, loc, n)));
}

/**
 * TB10: the caret at the start of paragraph loc after typed table n
 * (Backspace) or at the end of the one before it (Delete).
 */
function byTable(d, sel, loc, n, dir) {
  const back = dir < 0;
  const to = back ? lastPos(n.b) : firstPos(n.b);
  if (!to) return boxSel(n);
  const nx = back && neighbour(d.doc, loc, 1);
  const last = back && (!nx || nx.s !== loc.s);
  if (!onlyUnseen(loc.b) || last || tableBy(d.doc, loc, -dir)) {
    return back ? caret(to) : sel;
  }
  return removeEmpty(d, sel, loc, to);
}

/**
 * Remove the paragraph at loc that holds only unseen inlines; its
 * bookmark marks whose partner stays go to `to`, the caret's place
 * (./BookmarkKeep: a pair is never broken). One undo step.
 */
function removeEmpty(d, sel, loc, to) {
  return run(d, sel, () => {
    const got = marksIn(loc.b, 0, loc.b.text.length, []);
    d.apply({op: 'removeBlock', at: loc.at});
    putMarks(d, to, stillPaired(d.doc, got));
    return to;
  });
}

/** Backspace or Delete (dir -1 or 1), stepping with `step`. */
function del(d, sel, dir, step) {
  if (!collapsed(sel)) {
    return dir < 0 ? backSelection(d, sel) : deleteSelection(d, sel);
  }
  const loc = checkPos(d.doc, sel.head);
  if (!loc) return sel;
  const off = sel.head.off;
  if (loc.b.type !== 'p') {
    // a kept block: from inside its edge, select it
    if (off === (dir < 0 ? 1 : 0)) return boxSel(loc);
    return atEdge(d, sel, loc, dir);
  }
  const p = loc.b, text = p.text;
  let k = off;
  if (dir < 0) while (k > 0 && unseenAt(p, k - 1)) k--;
  else while (k < text.length && unseenAt(p, k)) k++;
  if (dir < 0 ? k === 0 : k === text.length)
    return atEdge(d, sel, loc, dir);
  const to = step(text, k);
  return dir < 0 ? cutText(d, sel, loc, to, k, to)
    : cutText(d, sel, loc, k, to, off);
}

/** See the header. */
export const deleteBack = (d, sel) => del(d, sel, -1, prevG);

/** See the header. */
export const deleteForward = (d, sel) => del(d, sel, 1, nextG);

/** See the header. */
export const deleteWordBack = (d, sel) => del(d, sel, -1,
  (t, off) => prevWord(t, off));

/** See the header. */
export const deleteWordForward = (d, sel) => del(d, sel, 1,
  (t, off) => nextWord(t, off));
