// EditScroll - what can be seen of a document's window (./EditView),
// whose top v.inset px are hidden by its toolbar (a pane in front of
// it: ./AppWin), and keeping the caret there:
//
//   visible(v) -> {x0, y0, x1, y1}: the part of the work area that
//                 can be seen (y0 = scrollY + inset)
//   scrollToCaret(v)    scroll so that the head is 24 px inside that
//                 part (never under the toolbar; never above 0); a
//                 head past the extent's end (Print layout's pages
//                 worked out for it just now) calls v.refit() first,
//                 when the view has one (./ViewMode: the extent
//                 set again, D34)
//   pageStep(v) -> px that Page Up and Page Down scroll and move: the
//                 visible height less 32, at least 20
//   dragStep(v, sx, sy) -> {dx, dy}: while a drag's pointer (screen
//                 sx, sy) is above the visible part (or under the
//                 toolbar), left, right or below it: 20 px up or down,
//                 16 across; 0 inside
// v: {win, inset, caretRect()}. The caret's rectangle is where the
// layout's placement puts its line (L.place lineAt: ./Place, D4,
// through ./DocHit caretRect), and the extent scrolled over is the
// placement's (L.place extent, which L.layout returns: ./WinFit).
// Uses only the view: no desktop services.

const MARGIN = 24, LINE = 20, STEP_Y = 20, STEP_X = 16;
const inset = (v) => Math.max(0, Number(v.inset) || 0);

/** See the header. */
export function visible(v) {
  const w = v.win;
  return {x0: w.scrollX, y0: w.scrollY + inset(v),
    x1: w.scrollX + w.w, y1: w.scrollY + w.h};
}

/** See the header. */
export function scrollToCaret(v) {
  const w = v.win, c = v.caretRect();
  if (!c || !w.isOpen) return;
  const e = w.extent, eh = e ? e.y1 - e.y0 : Infinity;
  if (v.refit && c.y + c.h + MARGIN > eh) v.refit();
  const top = inset(v);
  let sx = w.scrollX, sy = w.scrollY;
  if (c.y + c.h + MARGIN > sy + w.h) sy = c.y + c.h + MARGIN - w.h;
  if (c.y - MARGIN < sy + top) sy = c.y - MARGIN - top;
  if (c.x + MARGIN > sx + w.w) sx = c.x + MARGIN - w.w;
  if (c.x - MARGIN < sx) sx = c.x - MARGIN;
  sx = Math.max(0, Math.round(sx));
  sy = Math.max(0, Math.round(sy));
  if (sx !== w.scrollX || sy !== w.scrollY) w.scrollTo(sx, sy);
}

/** See the header. */
export function pageStep(v) {
  return Math.max(LINE, v.win.h - inset(v) - 32);
}

/** See the header. */
export function dragStep(v, sx, sy) {
  const w = v.win;
  let dx = 0, dy = 0;
  if (sy < w.y + inset(v)) dy = -STEP_Y;
  else if (sy > w.y + w.h) dy = STEP_Y;
  if (sx < w.x) dx = -STEP_X;
  else if (sx > w.x + w.w) dx = STEP_X;
  return {dx, dy};
}
