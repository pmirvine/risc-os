// Letters - a word processor for Microsoft Word documents (.docx)
// and Rich Text Format (RTF) files.
//
// It opens .docx and RTF files, and ODT and Word .doc files as
// copies to save as .docx (double-click one, or drop it on
// Letters' icon) and shows their text, with a caret and a selection;
// text can be typed, deleted and formatted, with undo and redo, and
// saved (everything it does not show is kept): Save, Save as, Save a
// copy.
// New documents come from the icon bar icon (./IconBar); recently
// used files are under Recent (./RecentFiles); quitting asks first
// about unsaved changes (./Quit).
//
// !RunImage is where it starts: one Letters at a time, opening files,
// the messages. A document's window is ./AppWin; reading files is
// ./Open; the info line and the Info boxes are ./Info. A document
// opened from RTF stays RTF (dw.format 'rtf': ./DocSave saves it as
// RTF), any other is a .docx (new ones too); what the RTF reader
// noted (skipped, damaged) is said once, in a notice, as it opens.
// A file an importer reads (./Open IMPORTERS: OpenDocument &A81,
// Word .doc &AE6) opens as an imported .docx window (./AppWin:
// saved only by Save as, never over the file), said in the notice.
import {wimp, vfs, reportError} from 'riscos';
import {openDoc, describe, openNotice, FILETYPES, formatOfType,
  typeAt} from './Open';
import {DocWindow} from './AppWin';
import {loadFonts} from './FontLoad';
import {fontsToLoad} from './FontMap';
import {facts} from './Info';
import {newDoc} from './NewDoc';
import {openChecked} from './StarterList';
import {loadRecent, noteRecent} from './RecentFiles';
import {preQuit} from './Quit';
import {addIcon} from './IconBar';
import {testHook} from './TestHook';

const say = (m) => reportError(m, {appName: 'Letters'});
const tell = (m) => reportError(m, {appName: 'Letters',
  category: 'info'});

export default async function start(task, ctx) {
  const file = ctx.argv[0];
  // only one Letters at a time: pass the file to the one running
  const other = wimp.tasks.find((t) => t !== task && t.alive &&
    t.name === task.name);
  if (other) {
    if (file) {
      // (its own type when it is one Letters opens: else as a .docx)
      const st = vfs.stat(file);       // (null when it is not there)
      const t = st && st.filetype;
      wimp.sendMessage('DataOpen', {path: file,
        filetype: formatOfType(t) ? t : FILETYPES.docx}, {to: other});
    }
    task.quit();
    return;
  }

  // the bundled fonts a document is shown in (each is loaded once),
  // with Liberation Sans when it uses a font that is not bundled: it
  // is shown without them if they take too long, and laid out again
  // when they arrive (deleted text's too: All Markup shows it)
  const fontsFor = (doc) => {
    const want = fontsToLoad(facts(doc, 'all').fonts);
    return loadFonts(vfs, `${ctx.dir}.Fonts`, undefined, want)
      .catch(() => null);
  };

  // canonical path (lower case, with a '$') -> DocWindow; a name
  // that is not a path: '?name'; an untitled one: 'untitled:N'
  const docs = new Map();
  let untitled = 0;
  const keyOf = (path) => {
    try { return vfs.canonical(path).toLowerCase(); }
    catch (e) { return '?' + String(path).toLowerCase(); }
  };
  const opening = new Map();           // key -> Promise (in progress)
  const app = {
    task, docs, keyOf, recent: [], fonts: fontsFor, dir: ctx.dir,
    prompt: null, closing: null,       // (./CloseDoc, ./Quit)
    /** Open a .docx, RTF, ODT or .doc (or bring its window to the
     *  front). */
    open(path) {
      const key = keyOf(path);
      const had = docs.get(key);
      if (had) { had.show(); return Promise.resolve(had); }
      if (!opening.has(key)) {
        opening.set(key, load(path, key)
          .finally(() => opening.delete(key)));
      }
      return opening.get(key);
    },
    closed(dw) {
      for (const [k, v] of docs) if (v === dw) docs.delete(k);
    },
    /** dw has a new path (or none): its key again. */
    rekey(dw) {
      app.closed(dw);
      if (dw.closed) return;           // (closed: not put back)
      docs.set(dw.path ? keyOf(dw.path) : `untitled:${++untitled}`,
        dw);
    },
    /** A template as a new untitled document, each time in a window
     *  of its own (./TemplateMenu); not noted as recent. */
    openTemplate(path) {
      return load(path, `untitled:${++untitled}`, true, true);
    },
    /** A starter (./StarterList) as a new untitled document, built
     *  now; not noted as recent, its Save name its title. */
    async openStarter(id) {
      const got = openChecked(id, say);
      if (!got) return null;
      try {
        return await place(null, `untitled:${++untitled}`, got.doc,
          got.format, got.imported, got.title);
      } catch (e) {
        say(`The starter could not be opened: ${e.message || e}`);
        return null;
      }
    },
    /** A new, empty, untitled document (paper 'a4' or 'letter'). */
    async newDoc(o) {
      const paper = o && o.paper === 'letter' ? 'letter' : 'a4';
      return place(null, `untitled:${++untitled}`, newDoc({paper}),
        'docx');
    },
    /** path was opened or saved (./RecentFiles). */
    noteRecent: (path) => noteRecent(app, path),
  };
  async function load(path, key0, quiet, template) {
    let got, key = key0;
    try {
      got = await openDoc(vfs, path, {template});
    } catch (e) {
      say(describe(e, vfs.leaf(path), typeAt(vfs, path)));
      return null;
    }
    if (!task.alive) return null;
    // (a template is a new document each time it is opened: never
    // keyed by the template's file, so opening it again makes another)
    if (got.imported === 'template' && !/^untitled:/.test(key)) {
      key = `untitled:${++untitled}`;
    }
    if (!quiet) app.noteRecent(path);
    const dw = await place(path, key, got.doc, got.format,
      got.imported);
    const m = dw && openNotice(dw.leaf, got);
    if (m) tell(m);
    return dw;
  }
  async function place(path, key, doc, format, imported, title) {
    const fonts = fontsFor(doc);
    // (the choices too: the view chosen last, ./ViewMode)
    await Promise.race([Promise.all([fonts, app.choicesReady]),
      new Promise((res) => setTimeout(res, 2500))]);
    if (!task.alive) return null;
    const dw = new DocWindow(app, path, doc, format, imported,
      title);
    docs.set(key, dw);
    dw.show();
    fonts.then(() => {
      if ([...docs.values()].includes(dw)) dw.relayout();
    });
    return dw;
  }

  task.word = testHook(app);           // (for tests: ./TestHook)
  addIcon(app);

  // ------------------------------------------------ messages
  task.onMessage('DataOpen', (msg) => {
    if (!formatOfType(msg.filetype)) return false;
    app.open(msg.path);
    return true;
  });
  // (the Task Manager's Quit, shutdown: asks first; Quit itself and
  // task.quit() do not)
  task.onMessage('PreQuit', preQuit(app));
  task.onMessage('Quit', () => task.quit());

  // ------------------------------------------------ starting
  // (not awaited: the Filer's double-click does not wait for it)
  loadRecent(app);
  if (file) app.open(file);
}
