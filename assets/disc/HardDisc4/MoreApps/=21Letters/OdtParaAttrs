// OdtParaAttrs - the paragraph formatting of an OpenDocument style
// (OpenDocument 1.3 part 3, 17.6 <style:paragraph-properties>: its
// fo: and style: attributes, and 17.8 <style:tab-stops>) as a layer
// for ./OdtProps, as ./OdtAttrs does for characters.
//
//   paraLayer(ctx, node) -> {jc?, left?, right?, firstLine?,
//       before?, after?, line?, keepNext?, keepLines?, breakBefore?,
//       breakAfter?, tabs?, pBdr?, pad?, shd?}  lengths in twips
//       (firstLine negative: hanging); line {line, lineRule} as
//       w:spacing; breakBefore / breakAfter 'page' | 'column' |
//       'auto'; tabs [{val, pos, leader?}] (pos from the paragraph's
//       left indent, as ODF has it; at most MAX_TABS); pBdr {top?,
//       ...: {val, sz?, color?}} (sz eighths of a point, 2..96), pad
//       {top?, ...: points} (the border's space, 0..31); shd 'none'
//       or RRGGBB
// A value that cannot be read is not set (never NaN).
// Pure: no desktop services.
import {points, twips, pct, hex} from './OdtUnits';
import {kids, attr} from './OdtXml';
import {ignored, bool} from './OdtAttrs';

const JC = new Map([['start', 'left'], ['left', 'left'],
  ['end', 'right'], ['right', 'right'], ['center', 'center'],
  ['justify', 'both']]);
const SIDES = ['top', 'left', 'bottom', 'right'];
const BORDER = new Map([['solid', 'single'], ['double', 'double'],
  ['dotted', 'dotted'], ['dashed', 'dashed'],
  ['groove', 'threeDEngrave'],
  ['ridge', 'threeDEmboss'], ['inset', 'inset'], ['outset', 'outset'],
  ['dash-dot', 'dotDash'], ['dash-dot-dot', 'dotDotDash'],
  ['wave', 'wave'], ['double-thin', 'double'], ['fine-dashed',
    'dashSmallGap']]);
const WIDTH = new Map([['thin', 0.75], ['medium', 1.5], ['thick', 3]]);
const MAX_TABS = 64;

/** 'width style color' (fo:border) -> a side, or undefined. */
export function border(v) {
  if (typeof v !== 'string' || v.length > 100) return undefined;
  if (v.trim() === 'none') return {val: 'none'};
  let w, st, color;
  for (const t of v.trim().split(' ')) {
    if (!t) continue;
    if (BORDER.has(t) || t === 'none' || t === 'hidden') st = t;
    else if (hex(t)) color = hex(t);
    else if (points(t) !== undefined) w = points(t);
    else if (WIDTH.has(t)) w = WIDTH.get(t);
  }
  if (st === undefined) return undefined;
  if (st === 'none' || st === 'hidden') return {val: 'none'};
  const sz = Math.min(96, Math.max(2, Math.round((w ?? 0.75) * 8)));
  return {val: BORDER.get(st), sz, color: color || 'auto'};
}

/** The borders and their padding of a paragraph-properties node. */
function borders(node, o) {
  const all = border(attr(node, 'fo:border'));
  const pAll = points(attr(node, 'fo:padding'));
  for (const s of SIDES) {
    const b = border(attr(node, 'fo:border-' + s)) || all;
    if (b) (o.pBdr || (o.pBdr = {}))[s] = b;
    const p = points(attr(node, 'fo:padding-' + s)) ?? pAll;
    if (p !== undefined) {
      (o.pad || (o.pad = {}))[s] = Math.min(31, Math.max(0,
        Math.round(p)));
    }
  }
}

const LEADER = new Map([['.', 'dot'], ['-', 'hyphen'],
  ['_', 'underscore'], ['\u00b7', 'middleDot']]);
const LEADER_STYLE = new Map([['dotted', 'dot'], ['dash', 'hyphen'],
  ['solid', 'underscore'], ['long-dash', 'hyphen']]);
const TAB = new Map([['left', 'left'], ['center', 'center'],
  ['right', 'right'], ['char', 'decimal']]);

/** <style:tab-stops> -> [{val, pos, leader?}] (pos from the left
 *  indent), or undefined. */
function tabStops(node) {
  const ts = kids(node, 'style:tab-stops')[0];
  if (!ts) return undefined;
  const out = [];
  for (const t of kids(ts, 'style:tab-stop').slice(0, MAX_TABS)) {
    const pos = twips(attr(t, 'style:position'));
    if (pos === undefined || Math.abs(pos) > 31680) continue;
    const s = {val: TAB.get(attr(t, 'style:type')) || 'left', pos};
    const lt = attr(t, 'style:leader-text');
    const ls = attr(t, 'style:leader-style');
    const l = lt !== undefined ? LEADER.get(lt)
      : LEADER_STYLE.get(ls);
    if (l && attr(t, 'style:leader-type') !== 'none') s.leader = l;
    if (!out.some((x) => x.pos === pos)) out.push(s);
  }
  return out;
}

/** See the header. */
export function paraLayer(ctx, node) {
  const o = {};
  const set = (k, v) => { if (v !== undefined) o[k] = v; };
  set('jc', JC.get(attr(node, 'fo:text-align')));
  const m = twips(attr(node, 'fo:margin'));
  for (const [k, a] of [['left', 'fo:margin-left'],
    ['right', 'fo:margin-right'], ['before', 'fo:margin-top'],
    ['after', 'fo:margin-bottom']]) {
    const v = twips(attr(node, a)) ?? m;
    if (v !== undefined) o[k] = k === 'before' || k === 'after'
      ? Math.max(0, v) : v;
  }
  set('firstLine', twips(attr(node, 'fo:text-indent')));
  set('line', lineOf(node));
  set('keepNext', bool(attr(node, 'fo:keep-with-next'), 'always',
    ['auto']));
  set('keepLines', bool(attr(node, 'fo:keep-together'), 'always',
    ['auto']));
  for (const [k, a] of [['breakBefore', 'fo:break-before'],
    ['breakAfter', 'fo:break-after']]) {
    const v = attr(node, a);
    if (v === 'page' || v === 'column' || v === 'auto') o[k] = v;
  }
  set('tabs', tabStops(node));
  borders(node, o);
  const bg = attr(node, 'fo:background-color');
  set('shd', bg === 'transparent' ? 'none' : hex(bg));
  ignored(ctx, node);
  return o;
}

/** fo:line-height / style:line-height-at-least -> w:spacing's
 *  {line, lineRule}, or undefined. */
function lineOf(node) {
  const lh = attr(node, 'fo:line-height');
  if (lh === 'normal') return {line: 240, lineRule: 'auto'};
  const p = pct(lh);
  if (p !== undefined && p > 0 && p <= 1000) {
    return {line: Math.round(240 * p / 100), lineRule: 'auto'};
  }
  const t = twips(lh);
  if (t !== undefined && t > 0) {
    return {line: Math.min(t, 31680), lineRule: 'exact'};
  }
  const al = twips(attr(node, 'style:line-height-at-least'));
  if (al !== undefined && al >= 0) {
    return {line: Math.min(al, 31680), lineRule: 'atLeast'};
  }
  return undefined;
}
