// Keymap - the keys of !Letters' editing commands: a table of rows
// {id, keys: ['Ctrl+Z', ...], label: 'Undo', menu: 'Edit'} and
//
//   keymap.lookup(ev) -> id | null   ev: {code, key, shift, ctrl, alt}
//   keymap.labelFor(id) -> 'Ctrl+Z'  the first key, for a menu
//   keymap.row(id) -> the row | null
//   new Keymap().bind(rows) -> the Keymap (replaces its rows)
//   keymap                           the one bound to ROWS
//
// Key names: 'Ctrl+Shift+Z', 'Shift+Enter', 'Ctrl++', 'Ctrl+F2':
// optional 'Ctrl+', 'Alt+' and 'Shift+' (in that order: 'Ctrl+Alt+F',
// Batch E2), then Enter Backspace Delete Tab
// Insert Space Up Down, a function key F1..F12, or one printable ASCII
// character (a letter, digit or symbol such as = > < + - . ,).
// Labels are Word's ('Ctrl+Z', 'Ctrl+F2'), not RISC OS's ('^Z',
// '^F2'). A symbol is matched as the browser names the key: with
// Shift on a US keyboard Ctrl+Shift+. arrives as '>', so a row lists
// both names ('Ctrl+Shift+>', 'Ctrl+Shift+.').
//
// ev is what the window got: code the Wimp key code (src/core/input.js
// keyCode), key the browser's name for the key (absent for a key sent
// by Wimp_ProcessKey), shift, ctrl, alt the modifiers. The Wimp gives
// Enter 13, Backspace 8 and Delete 127 whatever is held, Tab &18A and
// Insert &1CD (+&10 Shift, +&20 Ctrl), function keys F1..F9 &181..&189
// and F10..F12 &1CA..&1CC (+&10 Shift, +&20 Ctrl), Ctrl-letters 1..26:
// so with a key name the name and the flags decide, and the code alone
// only when there is none (then the bits of the code count as
// modifiers, and a code 1..26 is Ctrl-letter, except 8, 9 and 13, which
// stay Backspace, Tab and Enter: Ctrl-H, Ctrl-I (italic) and Ctrl-M
// (indentMore) work only with a key name). A key that is ''
// (Wimp_ProcessKey gives the char there, '' below 32) or no single
// character or known name counts as no name. With Alt held only a
// row naming Alt matches (Ctrl+Alt+F, Alt+Down: the notes' keys,
// ./KeymapMore); its letter is the key's place on the keyboard when
// the browser says it (domEvent.code KeyF: Alt makes another
// character of it on a Mac, AltGr on some keyboards), and Alt with
// no such row gives null, as does any key without a row: the
// handler then returns undefined and the key goes on. Movement
// keys are ./Keys's, not ours (it also decides Ctrl-A, selectAll).
// tab and shiftTab depend on where the caret is: in a table's cell
// they go to the next or previous cell (./EditKeys, ./SelTable), in
// a list item they change its level
// (./EditList), elsewhere Tab types a tab and Shift-Tab goes on.
// cellTab (Ctrl+Tab, Word's) types a tab in a cell (./EditKeys);
// elsewhere it goes on. Ctrl+Shift+Tab and Alt-Tab are never ours.
// The notes on the other rows and menu 'Window': ./KeymapMore.
// Pure: no desktop services.
import {command} from './Keys';
import {WINROWS, WINDOW, OUTROWS} from './KeymapMore';

export {WINDOW};
export const ROWS = [
  {id: 'enter', keys: ['Enter'], label: 'New paragraph'},
  {id: 'shiftEnter', keys: ['Shift+Enter'], label: 'Line break'},
  {id: 'backspace', keys: ['Backspace', 'Shift+Backspace'],
    label: 'Delete back'},
  {id: 'delete', keys: ['Delete'], label: 'Delete forward'},
  {id: 'ctrlBackspace', keys: ['Ctrl+Backspace'],
    label: 'Delete word back'},
  {id: 'ctrlDelete', keys: ['Ctrl+Delete'],
    label: 'Delete word forward'},
  {id: 'tab', keys: ['Tab'], label: 'Tab'},
  {id: 'shiftTab', keys: ['Shift+Tab'], label: 'Promote'},
  {id: 'cellTab', keys: ['Ctrl+Tab'], label: 'Tab in a cell'},
  {id: 'insert', keys: ['Insert'], label: 'Overwrite'},
  {id: 'pageBreak', keys: ['Ctrl+Enter'], label: 'Page break',
    menu: 'Insert'},
  {id: 'splitTable', keys: ['Ctrl+Shift+Enter'], label: 'Split table',
    menu: 'Table'},
  {id: 'columnBreak', keys: [], label: 'Column break',
    menu: 'Insert'},
  {id: 'nbsp', keys: ['Ctrl+Shift+Space'], label: 'No-break space',
    menu: 'Insert'},
  {id: 'nbHyphen', keys: ['Ctrl+Shift+-', 'Ctrl+Shift+_'],
    label: 'No-break hyphen', menu: 'Insert'},
  {id: 'softHyphen', keys: [], label: 'Optional hyphen',
    menu: 'Insert'},
  {id: 'sectionNext', keys: [], label: 'Next page', menu: 'Insert'},
  {id: 'sectionContinuous', keys: [], label: 'Continuous',
    menu: 'Insert'},
  {id: 'sectionEven', keys: [], label: 'Even page', menu: 'Insert'},
  {id: 'sectionOdd', keys: [], label: 'Odd page', menu: 'Insert'},
  {id: 'undo', keys: ['Ctrl+Z', 'F8'], label: 'Undo', menu: 'Edit'},
  {id: 'redo', keys: ['Ctrl+Y', 'Ctrl+Shift+Z', 'F9'], label: 'Redo',
    menu: 'Edit'},
  {id: 'selectAll', keys: ['Ctrl+A'], label: 'Select all',
    menu: 'Edit'},
  {id: 'cut', keys: ['Ctrl+X'], label: 'Cut', menu: 'Edit'},
  {id: 'copy', keys: ['Ctrl+C'], label: 'Copy', menu: 'Edit'},
  {id: 'paste', keys: ['Ctrl+V'], label: 'Paste', menu: 'Edit'},
  fmt('bold', ['Ctrl+B'], 'Bold'),
  fmt('italic', ['Ctrl+I'], 'Italic'),
  fmt('underline', ['Ctrl+U'], 'Underline'),
  fmt('alignLeft', ['Ctrl+L'], 'Align left'),
  fmt('alignCenter', ['Ctrl+E'], 'Centre'),
  fmt('alignRight', ['Ctrl+R'], 'Align right'),
  fmt('alignJustify', ['Ctrl+J'], 'Justify'),
  fmt('clearFormat', ['Ctrl+Space'], 'Clear formatting'),
  fmt('superscript', ['Ctrl+Shift+=', 'Ctrl+Shift++'],
    'Superscript'),
  fmt('subscript', ['Ctrl+='], 'Subscript'),
  fmt('fontBigger', ['Ctrl+Shift+>', 'Ctrl+Shift+.'], 'Bigger'),
  fmt('fontSmaller', ['Ctrl+Shift+<', 'Ctrl+Shift+,'], 'Smaller'),
  fmt('indentMore', ['Ctrl+M'], 'Indent more'),
  fmt('indentLess', ['Ctrl+Shift+M'], 'Indent less'),
  fmt('lineSingle', ['Ctrl+1'], 'Single spacing'),
  fmt('lineDouble', ['Ctrl+2'], 'Double spacing'),
  fmt('line15', ['Ctrl+5'], '1.5 lines'),
  fmt('spaceBefore12', ['Ctrl+0'], 'Space before'),
  fmt('bullets', ['Ctrl+Shift+L'], 'Bullets'),
  fmt('caseCycle', ['Shift+F3'], 'Change case'),
  ...WINROWS,
  ...OUTROWS,
];

/** A row of the Format menu. */
function fmt(id, keys, label) {
  return {id, keys, label, menu: 'Format'};
}

const NAMES = ['Enter', 'Backspace', 'Delete', 'Tab', 'Insert',
  'Space', 'Up', 'Down'];
const ARROW = {ArrowUp: 'Up', ArrowDown: 'Down'};
const FKEY = /^F([1-9]|1[0-2])$/;
// Wimp code (no modifiers) -> function key name
const FCODE = new Map([...Array(12)].map((_, i) =>
  [i < 9 ? 0x181 + i : 0x1C1 + i, 'F' + (i + 1)]));
const known = (k) => NAMES.includes(k) || FKEY.test(k);

/** 'Ctrl+Shift+Z' -> the canonical form, or throws. */
function canon(name) {
  const m = /^((?:(?:Ctrl|Alt|Shift)\+)*)(.+)$/.exec(String(name));
  const k = m ? m[2] : '';
  const mods = new Set(m ? m[1].split('+') : []);
  if (!known(k) && !/^[!-~]$/.test(k))
    throw new Error('Keymap: bad key ' + name);
  return form(k.length === 1 ? k.toUpperCase() : k,
    mods.has('Ctrl'), mods.has('Shift'), mods.has('Alt'));
}

const form = (k, ctrl, shift, alt = false) => (ctrl ? 'Ctrl+' : '') +
  (alt ? 'Alt+' : '') + (shift ? 'Shift+' : '') + k;
const CODE = /^Key([A-Z])$|^Digit([0-9])$|^Arrow(Up|Down)$/;

/** The canonical key name of the event, or null (unknown key). */
function nameOf(ev) {
  const {code} = ev;
  let k = typeof ev.key === 'string' ? ev.key : null;
  const dc = ev.alt && ev.domEvent ? CODE.exec(ev.domEvent.code || '')
    : null;
  if (dc) k = dc[1] || dc[2] || 'Arrow' + dc[3];
  if (k === ' ') k = 'Space';
  else if (Object.hasOwn(ARROW, k || '')) k = ARROW[k];
  // no name: '' (Wimp_ProcessKey, codes < 32), or not a name we know
  if (k !== null && k.length !== 1 && !known(k)) k = null;
  let shift = !!ev.shift, ctrl = !!ev.ctrl;
  if (k === null) {
    if (!Number.isInteger(code) || code < 0) return null;
    if (code === 13) k = 'Enter';
    else if (code === 8) k = 'Backspace';
    else if (code === 127) k = 'Delete';
    else if (code === 9) k = 'Tab';
    else if (code >= 1 && code <= 26) {
      k = String.fromCharCode(64 + code);
      ctrl = true;
    } else {
      const base = code & ~0x30;
      if (base === 0x18A || base === 0x1CD)
        k = base === 0x18A ? 'Tab' : 'Insert';
      else if (FCODE.has(base)) k = FCODE.get(base);
      else return null;
      shift = shift || (code & 0x10) !== 0;
      ctrl = ctrl || (code & 0x20) !== 0;
    }
  } else if (k.length === 1) k = k.toUpperCase();
  return form(k, ctrl, shift, !!ev.alt);
}

export class Keymap {
  constructor() {
    this._rows = new Map();
    this._keys = new Map();
  }

  /** Replace the table with rows; returns this. */
  bind(rows) {
    const rs = new Map(), keys = new Map();
    for (const r of rows) {
      rs.set(r.id, r);
      for (const k of r.keys || []) keys.set(canon(k), r.id);
    }
    this._rows = rs;
    this._keys = keys;
    return this;
  }

  row(id) { return this._rows.get(id) || null; }

  /** The first key of row id as 'Ctrl+Z' ('' when none). */
  labelFor(id) {
    const r = this._rows.get(id);
    return r && r.keys && r.keys.length ? r.keys[0] : '';
  }

  /** See the header. */
  lookup(ev) {
    if (!ev || typeof ev !== 'object') return null;
    const a = ev.alt ? null : command(ev.code, {shift: ev.shift,
      ctrl: ev.ctrl, key: ev.key});
    if (a && a.cmd === 'selectAll') return 'selectAll';
    const n = nameOf(ev);
    return n === null ? null : this._keys.get(n) || null;
  }
}

export const keymap = new Keymap().bind(ROWS);
