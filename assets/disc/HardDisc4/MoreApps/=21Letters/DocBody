// DocBody - the special characters of a .doc's main text that shape
// it ([MS-DOC] 2.4.3, 2.8.25, sprmCFSpec): paragraph, cell and row
// marks, breaks, tabs and hyphens. A handler module of ./DocRead
// (PART {chars, start, finish}); the field marks, pictures, notes
// and comments are ./DocFields', ./DocNotes', ./DocComments'.
//
//   0x0D  paragraph mark; 0x07 cell / row mark: the paragraph ends
//         (codes of fields still open close there, ./DocFields), as
//         ./DocTable mark says (a cell's or a row's end in a table)
//   0x0C  a page break (w:br page) in the paragraph; a section break
//         (one just before a section's end in PlcfSed,
//         ctx.sectionEnds) ends the paragraph and its section
//         (./DocSect breakAt)
//   0x09  tab; 0x0B line break ('\n'); 0x1E non-breaking hyphen
//         (U+2011); 0x1F optional hyphen (U+00AD); U+00A0 (no-break
//         space) is text as it is
//   start: the first paragraph is entered (./DocTable enter); finish:
//         the tables still open end, then the last section
//         (./DocSect last)
import {closeCodes} from './DocFields';
import {mark, enter, finish} from './DocTable';
import {breakAt, last} from './DocSect';

const PAGE = {kind: 'br', level: 'r', brType: 'page'};

const put = (s) => (ctx, cp) => ctx.put(s, cp);

/** A paragraph, cell or row mark. */
function end(ctx, cp) {
  closeCodes(ctx);
  mark(ctx, cp);
}

/** A page break, or a section break: a paragraph end. */
function page(ctx, cp) {
  if (ctx.storyEnd !== undefined || !ctx.sectionEnds ||
    !ctx.sectionEnds.has(cp + 1)) {
    return ctx.obj({...PAGE}, cp);
  }
  breakAt(ctx, cp);
}

/** See the header. */
export const PART = {
  chars: new Map([
    [0x0D, end],
    [0x07, end],
    [0x0C, page],
    [0x09, put('\t')],
    [0x0B, put('\n')],
    [0x1E, put('\u2011')],
    [0x1F, put('\u00AD')]]),
  start: [(ctx) => enter(ctx, 0)],
  finish: [finish, last],
};
