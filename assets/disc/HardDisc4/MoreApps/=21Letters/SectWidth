// SectWidth - the width of a section's text column in twips: the one
// rule Insert > Picture and Insert > Table size by (Batch C4 fix
// wave; it was written in both).
//
//   columnTw(props, doc?) -> the width of the section's first text
//       column (./SectGeom geomOf, Batch D: the page width, A4's 11906
//       when not given, less the left and right margins, 1440 each
//       when not given, and the gutter unless doc's settings put it
//       at the top (gutterAtTop, ./SettingsRead: as the layout's
//       L.geom, P1 fix M1); less the spaces between its
//       w:cols num columns, 720 each when not given, divided by num;
//       or its first w:col's when they are not of equal width): a
//       number, fractional or <= 0 as it comes (the caller decides
//       what that means). props: a section's props (null or {} for
//       the defaults).
// Pure: no desktop services.
import {geomOf} from './SectGeom';
import {onOffOf} from './SettingsRead';

/** See the header. */
export function columnTw(props, doc) {
  return geomOf({props: props || {}},
    {gutterAtTop: onOffOf(doc, 'gutterAtTop')}).cols[0].w;
}
