// DocEvents - a tiny event emitter.
//
//   const ev = new DocEvents();
//   const off = ev.on('change', fn);   ev.emit('change', data);  off();
//
// A listener that throws does not stop the others: its error goes to
// ev.onError(err), which by default throws it again from a microtask
// (so it is still reported, but after emit has finished).

const rethrow = (e) => queueMicrotask(() => { throw e; });

export class DocEvents {
  constructor() {
    this._fns = new Map();
    this.onError = rethrow;
  }

  /**
   * Call fn(data) on every emit of `name`.
   * @returns {function} call it to stop listening
   */
  on(name, fn) {
    if (typeof fn !== 'function') throw new TypeError('not a function');
    if (!this._fns.has(name)) this._fns.set(name, new Set());
    const set = this._fns.get(name);
    const entry = {fn};
    set.add(entry);
    return () => set.delete(entry);
  }

  /** Call the listeners of `name` (those present when it starts). */
  emit(name, data) {
    const set = this._fns.get(name);
    if (!set) return;
    for (const e of [...set]) {
      try {
        e.fn(data);
      } catch (err) {
        this.onError(err);
      }
    }
  }
}
