// ModelCheck - invariants of the document model, and run
// normalisation.
//
// A Para's runs are sorted, non-empty, contiguous and cover exactly
// [0, text.length); adjacent runs never have equal formatting (rPr,
// including its extra nodes, and rStyle). Each U+FFFC in text has an
// entry in inlines (key: its index as a decimal string) and every
// entry points at a U+FFFC. Offsets are UTF-16 code units and never
// fall inside a surrogate pair. An inline is one the writer can
// write: a raw inline has its node, a br its node or a brType (the
// writer makes <w:br w:type=.../>), a tab needs neither.
// A block is a Para, an Opaque {type:'opaque', node} or a Table
// {type:'tbl'...}, whose rules are in ./TblCheck (given checkBlock and
// checkProps, so it imports nothing from here).
import {checkTable, checkCellPara} from './TblCheck';
import {deepEqual} from './DeepEqual';

export {deepEqual, sameStories} from './DeepEqual';

export const OBJ = '\ufffc';

/** Throw a RangeError (the error every refused op gives). */
export function fail(msg) {
  throw new RangeError(msg);
}

const isObj = (v) => v !== null && typeof v === 'object' &&
  !Array.isArray(v);

/** True when two runs have the same formatting (rPr and rStyle). */
export function sameFmt(a, b) {
  return a.rStyle === b.rStyle && deepEqual(a.rPr, b.rPr);
}

const isHi = (c) => c >= 0xd800 && c <= 0xdbff;
const isLo = (c) => c >= 0xdc00 && c <= 0xdfff;

/** True when `pos` falls between the halves of a surrogate pair. */
export function midPair(text, pos) {
  return pos > 0 && pos < text.length &&
    isHi(text.charCodeAt(pos - 1)) && isLo(text.charCodeAt(pos));
}

/** True when `s` has no unpaired surrogate. */
export function wellFormed(s) {
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    if (isHi(c) && isLo(s.charCodeAt(i + 1))) i++;
    else if (isHi(c) || isLo(c)) return false;
  }
  return true;
}

/** Throw unless 0 <= pos <= text.length on a code-point boundary. */
export function checkPos(text, pos, what = 'offset') {
  if (!Number.isInteger(pos) || pos < 0 || pos > text.length)
    fail(what + ' ' + pos + ' out of range');
  if (midPair(text, pos)) fail(what + ' ' + pos + ' splits a pair');
}

/**
 * Drop empty runs and merge neighbours with equal formatting.
 * Returns a new array; run objects are copied when merged.
 */
export function normRuns(runs) {
  const out = [];
  for (const r of runs) {
    if (r.end <= r.start) continue;
    const q = out[out.length - 1];
    if (q && q.end === r.start && sameFmt(q, r)) {
      out[out.length - 1] = {...q, end: r.end};
    } else out.push(r);
  }
  return out;
}

/** Throw RangeError unless `p` is a well-formed, normalised Para. */
export function checkPara(p) {
  if (!isObj(p) || p.type !== 'p') fail('not a paragraph');
  if (!Number.isInteger(p.id)) fail('paragraph id must be an integer');
  if (!Array.isArray(p.extraP)) fail('extraP must be an array');
  checkProps(p.pPr, 'pPr');
  if (p.pStyle !== undefined && typeof p.pStyle !== 'string')
    fail('pStyle must be a string');
  checkContent(p, true);
}

/**
 * Throw unless {text, runs, inlines} agree: runs non-empty, contiguous
 * and covering text (and normalised, with `norm`); inlines as above.
 */
export function checkContent(c, norm = false) {
  if (!isObj(c) || typeof c.text !== 'string' || !wellFormed(c.text))
    fail('bad text');
  if (!Array.isArray(c.runs)) fail('runs must be an array');
  let at = 0;
  c.runs.forEach((r, k) => {
    if (!isObj(r) || r.start !== at || !(r.end > r.start))
      fail('runs must be non-empty and contiguous');
    checkProps(r.rPr, 'rPr');
    if (r.rStyle !== undefined && typeof r.rStyle !== 'string')
      fail('rStyle must be a string');
    if (midPair(c.text, r.end)) fail('a run splits a pair');
    if (norm && k && sameFmt(c.runs[k - 1], r))
      fail('runs not normalised');
    at = r.end;
  });
  if (at !== c.text.length) fail('runs must cover the text');
  checkInlines(c.text, c.inlines);
}

/**
 * Throw unless `o` is a property object with an `extra` array, and
 * every `extra` in the objects nested in it is an array too.
 */
export function checkProps(o, what) {
  if (!isObj(o) || !Array.isArray(o.extra))
    fail(what + ' must be an object with an extra array');
  nestedExtra(o, what);
}

function nestedExtra(o, what) {
  for (const k of Object.keys(o)) {
    const v = o[k];
    if (k === 'extra' && !Array.isArray(v))
      fail(what + ': extra must be an array');
    if (isObj(v)) nestedExtra(v, what);
  }
}

const KINDS = ['raw', 'br', 'tab'];
const LEVELS = ['p', 'r'];

/** Throw unless `x` is a valid Inline (kind, level and node). */
function checkInline(x, i) {
  if (!isObj(x)) fail('U+FFFC at ' + i + ' has no inline');
  if (!KINDS.includes(x.kind)) fail('bad inline kind ' + x.kind);
  if (x.level === undefined && x.kind === 'tab') return;
  if (!LEVELS.includes(x.level))
    fail('inline at ' + i + ' needs level p or r');
  if (x.level === 'p' && x.kind !== 'raw')
    fail('a ' + x.kind + ' inline must be at level r');
  // what the writer writes: the node, or for a br its w:type
  const none = x.node === undefined || x.node === null;
  if (none && x.kind === 'raw') {
    fail('raw inline at ' + i + ' has no node');
  }
  if (none && x.kind === 'br' && typeof x.brType !== 'string')
    fail('br inline at ' + i + ' needs a node or a brType');
}

/** Throw unless inlines and the U+FFFC characters of text agree. */
export function checkInlines(text, inlines) {
  if (!isObj(inlines)) fail('inlines must be an object');
  let n = 0;
  for (let i = 0; i < text.length; i++) {
    if (text.charCodeAt(i) !== 0xfffc) continue;
    checkInline(inlines[i], i);
    n++;
  }
  if (Object.keys(inlines).length !== n)
    fail('an inline does not point at U+FFFC');
}

/**
 * Throw unless `b` is a valid block (Para, Opaque or Table) inside
 * `around` tables (./Path depthOf of its path; 0: top level): a
 * table's own nesting counts from around + 1, and a paragraph in a
 * cell follows the cell's rule (./TblCheck checkCellPara).
 */
export function checkBlock(b, around = 0) {
  if (isObj(b) && b.type === 'tbl') checkTable(b, CK, around + 1);
  else if (isObj(b) && b.type === 'opaque') {
    if (!isObj(b.node)) fail('opaque block needs a node');
  } else {
    checkPara(b);
    if (around > 0) checkCellPara(b);
  }
}

const CK = {block: (b) => checkBlock(b), props: checkProps};

/**
 * The story op addresses (Batch D, D12, R8): its `story`, a part
 * name; undefined for the body (absent or null). RangeError for any
 * other value. Whether doc holds that story: ./OpsPath.
 */
export function opStory(op) {
  const s = op.story;
  if (s === undefined || s === null) return undefined;
  if (typeof s !== 'string') fail('bad story');
  return s;
}

const STORY_KINDS = ['hdr', 'ftr'];

const none = (v) => v === null || v === undefined;

/**
 * Throw unless `s` is a Story (./StoryRead, D9): part a string,
 * kind 'hdr' or 'ftr' and the root's local name the same, root
 * {name, attrs}, rels an array or null, relsPart a string or none,
 * bytes a byte array or none, prolog none or {before, after} arrays,
 * blocks and orig arrays, every block valid (checkBlock), every
 * orig entry a block object (shallow: orig is what was read).
 */
export function checkStory(s) {
  if (!isObj(s) || typeof s.part !== 'string') fail('not a story');
  if (!STORY_KINDS.includes(s.kind)) fail('bad story kind');
  if (!isObj(s.root) || typeof s.root.name !== 'string' ||
    !Array.isArray(s.root.attrs)) fail('story needs its root');
  if (s.root.name.slice(s.root.name.indexOf(':') + 1) !== s.kind)
    fail('story kind is not its root');
  if (s.rels !== null && !Array.isArray(s.rels))
    fail('story rels must be an array or null');
  if (!none(s.relsPart) && typeof s.relsPart !== 'string')
    fail('story relsPart must be a name or null');
  if (!none(s.bytes) && !(s.bytes instanceof Uint8Array))
    fail('story bytes must be bytes or null');
  if (!none(s.prolog) && !(isObj(s.prolog) &&
    Array.isArray(s.prolog.before) && Array.isArray(s.prolog.after)))
    fail('bad story prolog');
  if (!Array.isArray(s.blocks) || !Array.isArray(s.orig))
    fail('story blocks and orig must be arrays');
  for (const b of s.orig) {
    if (!isObj(b) || typeof b.type !== 'string')
      fail('story orig must hold blocks');
  }
  for (const b of s.blocks) checkBlock(b);
}
