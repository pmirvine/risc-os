// StyleId - style ids and style names (pure).
//
// idFor(table, name) -> a style id for a new style called `name`:
// the name with everything but A-Z, a-z and 0-9 removed ('Style' if
// nothing is left), with 1, 2... appended until no style of the
// table has it (compared ignoring case, as Word does).
// nameOk(table, name, exceptId?) -> true when `name` may be a style
// name: not empty after trimming, at most 100 characters, no control
// characters, and not equal (ignoring case, after trimming) to the
// name of another style; the style `exceptId` is not "another".
// Style ids are only ever Map keys here, so any text is safe.

const MAX_NAME = 100;
const CONTROL = /[\u0000-\u001f\u007f-\u009f]/;

const fold = (s) => String(s).trim().toLowerCase();

/** See the header. */
export function idFor(table, name) {
  let base = String(name ?? '').replace(/[^A-Za-z0-9]/g, '');
  if (base === '') base = 'Style';
  const used = new Set();
  for (const id of table.styles.keys()) used.add(id.toLowerCase());
  let id = base;
  for (let n = 1; used.has(id.toLowerCase()); n++) id = base + n;
  return id;
}

/** See the header. */
export function nameOk(table, name, exceptId) {
  if (typeof name !== 'string') return false;
  const t = name.trim();
  if (t === '' || name.length > MAX_NAME || CONTROL.test(name))
    return false;
  const key = t.toLowerCase();
  for (const [id, s] of table.styles) {
    if (id === exceptId) continue;
    if (fold(s.name ?? id) === key) return false;
  }
  return true;
}
