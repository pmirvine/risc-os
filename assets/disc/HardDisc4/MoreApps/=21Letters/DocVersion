// DocVersion - a number that changes whenever an op changes a Doc
// (Batch D P9.1): the ops change the body's section and block arrays
// IN PLACE (./OpsPath own: only the blocks they change are new
// objects), so doc.sections alone cannot tell a memo that the body
// changed. ./Ops applyOwn calls bump after every op that did not
// throw (an undo and a redo too: they apply ops).
//
//   versionOf(doc) -> integer  0 for a Doc no op has changed (or not
//       an object)
//   bump(doc)                  the next version
//
// Memos of the body (./FieldScan scan, ./Fields NUMWORDS) keep the
// version they were made at. Pure: no desktop services.
const V = new WeakMap();
const isObj = (v) => v !== null && typeof v === 'object';

/** See the header. */
export const versionOf = (doc) => (isObj(doc) && V.get(doc)) || 0;

/** See the header. */
export function bump(doc) {
  if (isObj(doc)) V.set(doc, versionOf(doc) + 1);
}
