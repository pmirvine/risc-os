// StylePair - a linked paragraph / character style pair, as Word
// keeps it (pure). Deleting one half deletes the other, and
// renaming 'Foo' renames 'Foo Char' to match.
//
//   mateOf(table, id) -> id | null  the style `id` links to, only
//       when it exists and links back to `id`
//   deletePlan(table, id) -> {ids}  `id`, then its mate when the
//       mate is a custom style that is not the default of its type
//   renamePlan(table, id, newName) -> {mateName} | null  when the
//       custom style `id` has a custom mate named '<name> Char',
//       the name the mate gets ('<newName> Char'); null when there
//       is no such mate, the name does not change, or the new mate
//       name is taken
import {nameOk} from './StyleId';
import {isBuiltinStyle} from './StylesBuiltin';

/** See the header. */
export function mateOf(table, id) {
  const m = table.styles.get(table.styles.get(id)?.link);
  return m && m.link === id && m.id !== id ? m.id : null;
}

/** See the header. */
export function deletePlan(table, id) {
  const ids = [id], m = mateOf(table, id);
  const s = m && table.styles.get(m);
  if (s && !isBuiltinStyle(s) && table.defaults[s.type] !== m)
    ids.push(m);
  return {ids};
}

/** See the header. */
export function renamePlan(table, id, newName) {
  const s = table.styles.get(id), m = mateOf(table, id);
  const mate = m && table.styles.get(m);
  if (!s || !mate || isBuiltinStyle(s) || isBuiltinStyle(mate))
    return null;
  if (typeof newName !== 'string' || newName.trim() === s.name ||
    mate.name !== s.name + ' Char') return null;
  const mateName = newName.trim() + ' Char';
  return nameOk(table, mateName, m) ? {mateName} : null;
}
