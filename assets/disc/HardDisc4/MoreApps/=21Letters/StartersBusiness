// StartersBusiness - the Business group of starter templates (one
// of two modules: ./StartersBusiness2 has the press release,
// newsletter and flyer): every placeholder in [square brackets];
// British conventions; A4, margins 1440 (text width 9026). Built-in
// styles; colours only as theme references; no blank paragraphs.
//
//   invoice()   Title "Invoice"; a borderless block of three
//     columns (4426 + 1900 + 2700): the supplier's details on the
//     left, a small table of Invoice no. / Date / Due date /
//     Purchase order on the right; "Bill to" and the client; the
//     items table (Description, Quantity, Unit price, Total: 4026 +
//     1200 + 1900 + 1900), its header row shaded with a theme tint
//     and five empty rows 480 twips high; the totals (Subtotal, VAT
//     ([20%]), Total due in bold): label, then the value after a
//     tab at a right tab stop at 8918 (9026 less the 108 cell
//     margin: the last column's text edge); payment terms and
//     bank details; footer with the company, "Registered in
//     [England and Wales] no. [number]" and the VAT number.
//   agenda()    Title; details table (Date, Time, Place, Chair,
//     Minutes); "Apologies:"; the agenda table (No., Item, Led by,
//     Time: 800 + 4626 + 2200 + 1400) with six items, Any other
//     business and Date of next meeting.
//   minutes()   Title; details table; Attendees and Apologies;
//     Heading 1 "Discussion" with each item a Heading 2 and a
//     paragraph; Heading 1 "Actions" and the Actions table (Action,
//     Owner, Due: 5026 + 2200 + 1800); "Minutes taken by: [name]".
import {para, run, tab, table, starterDoc, footer}
  from './StarterKit';

export const BOLD = (t, o = {}) => para(run(t, {b: true}),
  {spacing: {after: 0}, ...o});
export const TINT = {themeFill: 'accent1', themeFillTint: '33'};
/** A shaded header row; `right`: the columns aligned right. */
export const heads = (cols, right = []) => cols.map((t, k) => ({
  content: [BOLD(t, right.includes(k) ? {align: 'right'} : {})],
  shade: TINT}));
export const h1 = (t) => para(t, {style: 'Heading1'});
export const h2 = (t) => para(t, {style: 'Heading2'});
export const tight = (t, o = {}) => para(t,
  {spacing: {after: 0}, ...o});
const label = (t) => ({content: [BOLD(t)]});
const lead = (t) => para(run(t, {b: true}), {spacing: {before: 360,
  after: 60}, keepNext: true});

/** A two-column "label | value" details table. */
const details = (rows) => table({cols: [1800, 7226], borders: 'rules',
  rows: rows.map(([k, v]) => [label(k), v])});

/** See the header. */
export function invoice() {
  const total = (k, v, o = {}, r) => tight([run(k, r), tab(r),
    run(v, r)], {tabs: [{pos: 8918, val: 'right'}], ...o});
  const none = {content: [], align: 'right'};
  const blank = {cells: ['', '', none, none], height: 480};
  const meta = [['Invoice no.', '[0001]'],
    ['Date', '[5 November 2026]'], ['Due date', '[5 December 2026]'],
    ['Purchase order', '[PO number]']];
  const from = [label('[Company name]'), '[Address line 1]',
    '[Town] [Postcode]', '[Telephone] | [Email]'];
  return starterDoc({title: 'Invoice', body: [
    para('Invoice', {style: 'Title'}),
    table({cols: [4426, 1900, 2700], rows: meta.map(([k, v], i) =>
      [from[i], label(k), v])}),
    lead('Bill to'),
    tight('[Client name]'), tight('[Client address line 1]'),
    tight('[Town] [Postcode]', {spacing: {after: 360}}),
    table({cols: [4026, 1200, 1900, 1900], borders: 'grid',
      header: true, rows: [heads(['Description', 'Quantity',
        'Unit price', 'Total'], [1, 2, 3]), blank, blank, blank, blank,
      blank]}),
    total('Subtotal:', '[\u00a30.00]', {spacing: {before: 240,
      after: 0}}),
    total('VAT ([20%]):', '[\u00a30.00]'),
    total('Total due:', '[\u00a30.00]', {spacing: {before: 60,
      after: 0}}, {b: true}),
    lead('Payment terms'),
    tight('Payment is due within [30] days of the invoice date.'),
    lead('Bank details'),
    tight('Account name: [name]'),
    tight('Sort code: [00-00-00] | Account number: [00000000]'),
  ], footer: [footer('[Company name] | Registered in ' +
    '[England and Wales] no. [number] | VAT no. [number]',
  {align: 'center'})]});
}

/** See the header. */
export function agenda() {
  const item = (n, t, who, mins) => [String(n), t, who, mins];
  const rows = [1, 2, 3, 4, 5, 6].map((n) => item(n,
    '[Agenda item]', '[Name]', '[10 min]'));
  return starterDoc({title: 'Meeting agenda', body: [
    para('Meeting agenda', {style: 'Title'}),
    details([['Date', '[5 November 2026]'], ['Time', '[10:00]'],
      ['Place', '[Room or video link]'], ['Chair', '[Name]'],
      ['Minutes', '[Name]']]),
    para([run('Apologies: ', {b: true}), '[Names]'],
      {spacing: {before: 240, after: 240}}),
    table({cols: [800, 4626, 2200, 1400], borders: 'grid',
      header: true, rows: [heads(['No.', 'Item', 'Led by', 'Time']),
        ...rows, item(7, 'Any other business', '[Name]', '[5 min]'),
        item(8, 'Date of next meeting: [date]', '', '')]}),
  ]});
}

/** See the header. */
export function minutes() {
  const point = (n) => [h2(`${n}. [Agenda item]`),
    para('[Summarise the discussion and the decision made.]')];
  const action = ['[What is to be done]', '[Name]', '[Date]'];
  return starterDoc({title: 'Meeting minutes', body: [
    para('Meeting minutes', {style: 'Title'}),
    details([['Meeting', '[Meeting name]'],
      ['Date', '[5 November 2026]'], ['Time', '[10:00]'],
      ['Place', '[Room or video link]']]),
    para([run('Attendees: ', {b: true}), '[Names]'],
      {spacing: {before: 240, after: 60}}),
    para([run('Apologies: ', {b: true}), '[Names]']),
    h1('Discussion'), ...point(1), ...point(2), ...point(3),
    h1('Actions'),
    table({cols: [5026, 2200, 1800], borders: 'grid', header: true,
      rows: [heads(['Action', 'Owner', 'Due']), action, action,
        action]}),
    para('Minutes taken by: [name]', {spacing: {before: 360}}),
  ]});
}
