// ColMemo - what ./ColPass remembers of the pages it settles (Batch
// D, D23, P10 fix I2), split from it: page keys and cursors, and the
// memos a colW carries.
//
//   keyOf(G, pg) -> page pg's key in galley G (the ./Pages' P.G):
//       where it starts (the id of G's item at its start, the line
//       and the cut's dy; a cursor is G's index, ./EndGalley)
//   curOf(G, cs) -> its columns cs's cursors and widths as a string
//   pruned(L, P, known) -> known (a Map key -> record) without the
//       keys of pages no longer in P once it has grown past twice
//       P's pages (and 64)
//   memosOf(cw, ver) -> {known, giver, pages, total} of colW cw at
//       ./DocVersion ver: known and giver kept whatever the
//       version, pages and total only in the same version; new
//       ones for a first pass
//   live(L, m, copy?) -> Map m without the ids no longer in layout L
//       (P10 fix M6: deleted paragraphs forgotten); a copy when copy,
//       else m itself
//
// Pure: no desktop services.

const at = (G, c) => {
  const it = G.items[c.k];
  return (it ? it.id : '') + '/' + (c.line || 0) + '/' + (c.dy || 0);
};

/** See the header. */
export const keyOf = (G, pg) => at(G, pg.start);
export const curOf = (G, cs) => cs.map((c) => at(G, c.start) + '-' +
  at(G, c.end) + '@' + c.w).join(' ');

/** See the header. */
export function pruned(L, P, known) {
  if (known.size <= 2 * P.list.length + 64) return known;
  const keys = new Set(P.list.map((pg) => keyOf(P.G, pg)));
  for (const k of known.keys()) if (!keys.has(k)) known.delete(k);
  return known;
}

/** See the header. */
export function memosOf(cw, ver) {
  const ok = cw && cw.known instanceof Map;
  return {known: ok ? cw.known : new Map(),
    giver: ok ? cw.giver : new Map(),
    pages: ok && cw.ver === ver ? cw.pages : new Map(),
    total: ok && cw.ver === ver ? cw.total : 0};
}

/** See the header. */
export function live(L, m, copy) {
  const out = copy ? new Map() : m;
  for (const [id, v] of m) {
    if (!L.byId.has(id)) out.delete(id);
    else if (copy) out.set(id, v);
  }
  return out;
}
