// OdtNotes - the footnotes and endnotes of an OpenDocument text
// (OpenDocument 1.3 part 3, 6.3 <text:note>) for ./OdtRead, through
// the builder (./ImpBuild footnote, endnote, story).
//
//   PART  {elements: text:note}
//
// A text:note of class footnote or endnote is read where it stands:
// its text:note-body (paragraphs, lists, tables: the body's walker,
// into a story, ./OdtSect inStory) becomes the note and its mark is
// put at the reference (superscript, in the run's format). The
// text:note-citation (the label) is not read: the notes are numbered
// by Word. At most MAX_NOTES (./RtfNotes) in all (a note for the
// rest). A note inside a header, a footer or another note is
// skipped with a note, as is a note with no body, one of another
// class, and one outside a paragraph. The numbering settings
// (text:notes-configuration) are not read.
// Pure: no desktop services.
import {first, attr} from './OdtXml';
import {MAX_NOTES} from './RtfNotes';
import {fmtNow} from './OdtBody';
import {inStory} from './OdtSect';

const KINDS = new Set(['footnote', 'endnote']);

function note(ctx, node) {
  if (ctx.depth) {
    return ctx.note('notes inside headers, footers and other notes ' +
      'are skipped');
  }
  const c = attr(node, 'text:note-class');
  const kind = KINDS.has(c) ? c : null;
  const body = first(node, 'text:note-body');
  if (!kind || !body || !ctx.para) {
    return ctx.note('a note that is not a footnote or endnote with ' +
      'text in a paragraph is skipped');
  }
  if ((ctx.notesMade || 0) >= MAX_NOTES) {
    return ctx.note('more than ' + MAX_NOTES + ' notes: the rest ' +
      'are skipped');
  }
  // (ended first: the builder refuses a note while a story is open)
  const story = inStory(ctx, ctx.where, body).end();
  const mark = kind === 'endnote' ? ctx.b.endnote(story)
    : ctx.b.footnote(story);
  if (ctx.b.stopped) ctx.stop = true;
  if (!mark) return;
  ctx.notesMade = (ctx.notesMade || 0) + 1;
  const f = fmtNow(ctx);
  ctx.b.obj(mark, {...f, rPr: {...f.rPr, vertAlign: 'superscript'}});
}

export const PART = {elements: new Map([['text:note', note]])};
