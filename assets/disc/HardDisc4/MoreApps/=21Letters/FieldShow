// FieldShow - field results shown computed (Batch D, D18): what a
// layout draws in place of a field's stored result, and the ranges
// the caret and the editing keys treat as one atomic unit. The model
// is never changed: display and save keep the stored result (OD3).
//
//   computedIn(doc, p) -> [Show], mayHold(p), work  ./FieldShows'
//       (re-exported): which fields a paragraph shows computed
//   fieldText(L, p, off) -> {from, to, text, b, e} | null  the
//       layout L's text for the show of p at off (./LineTokens draws
//       [from, to) as ONE token): the value under L.fields (below),
//       or the stored result when there is none (Draft: no page; no
//       `now`) as one token; a keep show (./FieldShows: STYLEREF in
//       a header or footer) only on a page with its span (L.fields
//       page, not a body's pageOf) and evaluated in the story view's
//       host document (./FieldShows hostOf), null with no value (its
//       stored result drawn as read: a header's height as
//       before). Recorded per paragraph in L.fshown (Map id -> {p,
//       key}: key the paged values joined, '' when none), which
//       ./FieldPass reads. With L.fields.codes (View > Field
//       codes): a field shown as its code (./FieldCodes codeAt) is
//       that code, a field inside one nothing (null), others as
//       above
//       Also a footnote or endnote mark (a noteRef inline): {from:
//       off, to: off + 1, text: ./NoteNumbers markText under L.doc
//       (L.noteId: the note a self mark is in; L.fields.noteNums
//       the numbers by page, ./NoteHooks notePass), b, e: off}; a
//       self mark L.noteLabel when a string (a note's layout,
//       ./NoteLayout: its L.doc is the note's view, not the body);
//       null when it has no text to show. Kept in no record: the
//       paragraph's reuse key holds it (./NoteNumbers noteKey)
//   keyOf(L, p) -> string  that key for p under L.fields (made and
//       recorded when not yet); keyFor(doc, p, fx) the same under
//       fields context fx, not recorded; volFor(doc, p, fx) the
//       other values (dates, times...) joined, as the record's vol
//       (./FieldPass relayOf: the clock moved, P9 fix I2)
//   storyKey(doc, part, fx) -> string  the values key of the story
//       part on fx's page (./StoryLayout valuesKey): '' when it shows
//       no page-dependent field, else their texts joined
//   countsOf(P) -> {list} | null  the pages NUMPAGES and SECTIONPAGES
//       count: P's once done (./Pages totalsOf), else the last
//       finished Pages' (D7: the previous count until done); null
//       when none was finished. Each page as {s}: no Page or Pages
//   pageOn(pg) -> {num, s, fmt, span} | null  Page pg's values the
//       page fields show (frozen, memoised): what a fields context
//       holds (final fix A C1: a Page kept there keeps its Pages,
//       galley and DocLayout, whose fields kept the Page before
//       them). span {first, last} (frozen): the ids of the first and
//       last body paragraph on the page (a paragraph continued from
//       the page before counts; a table's first and last paragraph
//       at any depth; notes placed after the text are not body), from
//       the galley of the ./Pages holding pg (./PageFrames ownerOf)
//       as it is when first asked; null for a blank page, a page of
//       no Pages or with no paragraph. A header's or footer's
//       STYLEREF needs it (./FieldStyleRef)
//
// L.fields (./DocLayout's option, carried from prev) = {now, page?,
// pages?, pageOf?, codes?, shade?}: now the Date volatile fields
// show; a story's layout its page (pageOn) and the counts
// (countsOf); the body's pageOf (Map paragraph id -> pageOn's
// values, ./FieldPass) and pages;
// codes and shade: ./FieldView's. The editing rules
// for those ranges: ./FieldEdit. Pure: no desktop services.
import {scan} from './FieldScan';
import {computedIn, mayHold, showIndex, work, hostOf}
  from './FieldShows';
import {plain} from './FieldMarks';
import {evaluate} from './Fields';
import {codeAt, inCode} from './FieldCodes';
import {versionOf} from './DocVersion';
import {totalsOf} from './Pages';
import {ownerOf} from './PageFrames';
import {markText} from './NoteNumbers';
import {OBJ} from './Model';

export {computedIn, mayHold, work};
const FRESH = 1024;                    // new records noted one by one
const isObj = (v) => v !== null && typeof v === 'object';

/** The text show s of p gives under fields context fx (null: a keep
 *  show with no value, its stored result drawn as read). */
function textOf(doc, p, s, fx) {
  work.evals++;
  let v = null;
  if (s.keep) {                        // (a story's STYLEREF)
    const page = isObj(fx) && !(fx.pageOf instanceof Map) ? fx.page
      : null;
    return isObj(page) && isObj(page.span) ? evaluate({doc:
      hostOf(doc) || doc, now: fx.now, page, pages: fx.pages ||
      undefined}, s.f) : null;
  }
  if (isObj(fx)) {
    const page = fx.pageOf instanceof Map ? fx.pageOf.get(p.id)
      : fx.page;
    v = evaluate({doc, now: fx.now, page: page || undefined,
      pages: fx.pages || undefined}, s.f);
  }
  return v === null ? plain(p, s.from, s.to) : v;
}

/** p's shows, their texts under fx and the key (the header). */
function valuesOf(doc, p, fx) {
  const shows = computedIn(doc, p);
  const texts = shows.map((s) => textOf(doc, p, s, fx));
  let key = '', vol = '';
  texts.forEach((t, k) => {
    const x = t === null ? '\u0002' : t;
    if (shows[k].paged) key += '\u0001' + x;
    else vol += '\u0001' + x;
  });
  return {p, shows, texts, key, vol};
}

/** See the header. */
export const keyFor = (doc, p, fx) => valuesOf(doc, p, fx).key;

/** See the header. */
export const volFor = (doc, p, fx) => valuesOf(doc, p, fx).vol;

/** p's record in L.fshown: its texts and key (made when not yet:
 *  kept for the same paragraph object of the same doc at the same
 *  ./DocVersion; L.fshown may be the last layout's, ./FieldPass
 *  carry); a new one noted for ./FieldPass (L.fwork fresh: at most
 *  FRESH, then all of them are looked at). */
function recordOf(L, p) {
  const m = L.fshown || (L.fshown = new Map());
  let r = m.get(p.id);
  const doc = L.doc, ver = versionOf(doc);
  if (r && r.p === p && r.doc === doc && r.ver === ver) return r;
  r = {...valuesOf(doc, p, L.fields), doc, ver};
  m.set(p.id, r);
  const w = L.fwork || (L.fwork = {fresh: new Set(), all: true,
    n: -1});
  if (w.fresh.size < FRESH) w.fresh.add(r);
  else w.all = true;
  return r;
}

const ats = new WeakMap();             // shows -> Map at -> index

/** Map show offset -> its index in shows (memoised). */
function atOf(shows) {
  let m = ats.get(shows);
  if (!m) {
    m = new Map();
    shows.forEach((s, k) => { if (!m.has(s.at)) m.set(s.at, k); });
    ats.set(shows, m);
  }
  return m;
}

/** See the header. */
export function fieldText(L, p, off) {
  if (!isObj(L) || !isObj(p)) return null;
  const nx = isObj(p.inlines) ? p.inlines[off] : null;
  if (isObj(nx) && nx.kind === 'noteRef' && p.text[off] === OBJ) {
    const t = nx.self && typeof L.noteLabel === 'string'
      ? L.noteLabel : markText(L.doc, nx, L.noteId,
        isObj(L.fields) ? L.fields.noteNums : undefined);
    return t === null ? null : {from: off, to: off + 1, text: t,
      b: off, e: off};
  }
  if (isObj(L.fields) && L.fields.codes) {
    const c = codeAt(L.doc, p, off);
    if (c || inCode(L.doc, p, off)) return c;
  }
  const r = recordOf(L, p), k = atOf(r.shows).get(off);
  if (k === undefined) return null;
  const s = r.shows[k];
  return r.texts[k] === null ? null : {from: s.from, to: s.to,
    text: r.texts[k], b: s.b, e: s.e};
}

/** See the header. */
export const keyOf = (L, p) => recordOf(L, p).key;

/** See the header. */
export function storyKey(doc, part, fx) {
  if (!isObj(doc) || typeof part !== 'string') return '';
  const st = doc.stories instanceof Map ? doc.stories.get(part) : null;
  if (!st) return '';
  const m = showIndex(scan(doc, part), true);
  if (!m.size) return '';
  let out = '';
  for (const b of st.blocks) {
    const list = b && b.type === 'p' ? m.get(b.id) : null;
    if (!list) continue;
    for (const s of list) {
      const t = s.paged ? textOf(doc, b, s, fx) : '';
      if (s.paged) out += '\u0001' + (t === null ? '\u0002' : t);
    }
  }
  return out;
}

/** See the header. */
export const countsOf = (P) => (!isObj(P) ? null : P.done
  ? totalsOf(P) : P.counts || null);

const ons = new WeakMap();             // Page -> its values

/** a in order, or (back) last first; [] for no array. */
const ordered = (a, back) => (!Array.isArray(a) ? []
  : back ? a.slice().reverse() : a);

/** The id of the first (back: last) paragraph in block b, at any
 *  depth of a table, or null. */
function paraIn(b, back) {
  if (!isObj(b)) return null;
  if (b.type === 'p') return b.id === undefined ? null : b.id;
  if (b.type !== 'tbl') return null;
  for (const row of ordered(b.rows, back)) {
    for (const cell of ordered(isObj(row) ? row.cells : null, back)) {
      for (const x of ordered(isObj(cell) ? cell.blocks : null,
        back)) {
        const id = paraIn(x, back);
        if (id !== null) return id;
      }
    }
  }
  return null;
}

/** The id of a body paragraph of galley item it (not a note's). */
const idOf = (it, back) => (isObj(it) && !it.en
  ? paraIn(it.block, back) : null);

/** Page pg's span (see the header), or null. */
function spanOf(pg) {
  const P = ownerOf(pg), G = isObj(P) ? P.G : null;
  const a = pg.start, z = pg.end;
  if (!isObj(G) || pg.blank || !isObj(a) || !isObj(z)) return null;
  const items = G.items;
  const k1 = Math.min(z.line > 0 || z.dy > 0 ? z.k : z.k - 1,
    items.length - 1);
  let first = null, last = null;
  for (let k = a.k; k <= k1 && first === null; k++)
    first = idOf(items[k], false);
  for (let k = k1; k >= a.k && last === null; k--)
    last = idOf(items[k], true);
  return first === null || last === null ? null
    : Object.freeze({first, last});
}

/** See the header. */
export function pageOn(pg) {
  if (!isObj(pg)) return null;
  let v = ons.get(pg);
  if (!v) {
    v = Object.freeze({num: pg.num, s: pg.s, fmt: pg.fmt,
      span: spanOf(pg)});
    ons.set(pg, v);
  }
  return v;
}
