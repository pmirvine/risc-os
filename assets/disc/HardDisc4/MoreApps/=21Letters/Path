// Path - block paths, the one rule for every consumer (Batch C).
//
// A block position is a path: [s, i] (block i of section s) or
// [s, i, r, c, j, (r, c, j)...]: block i is a table, row r, cell c,
// block j of that cell's blocks, and so on into nested tables. A path
// names a block inside k tables: length 2 + 3k, 0 <= k <= MAX_DEPTH
// (./TblCheck).
//
//   isPath(at)      an array of integers >= 0 of such a length
//   depthOf(at)     k, the number of tables around the block
//   isTop(at)       k = 0
//   sib(at, d)      the block d places on in the same container
//   tableOf(at)     the enclosing table's path (RangeError at top)
//   cellOf(at)      {table, r, c}: the innermost cell, null at top
//   topOf(at)       [s, i]: the top-level block holding it
//   samePath(a, b)  the same path
//   cmpPath(a, b)   <0, 0, >0: flow order of two block paths
//                   (element-wise; a table before its contents)
//
// The helpers other than isPath take valid paths and do not check
// them (./Walk at() and the ops do). Pure: no desktop services.
import {MAX_DEPTH} from './TblCheck';

/** See the header. */
export function isPath(at) {
  if (!Array.isArray(at)) return false;
  const n = at.length;
  if (n < 2 || (n - 2) % 3 !== 0 || (n - 2) / 3 > MAX_DEPTH)
    return false;
  for (let k = 0; k < n; k++) {
    if (!Number.isInteger(at[k]) || at[k] < 0) return false;
  }
  return true;
}

/** See the header. */
export const depthOf = (at) => (at.length - 2) / 3;

/** See the header. */
export const isTop = (at) => at.length === 2;

/** See the header. */
export function sib(at, d) {
  const out = at.slice();
  out[out.length - 1] += d;
  return out;
}

/** See the header. */
export function tableOf(at) {
  if (at.length < 5) throw new RangeError('a top-level block has no ' +
    'table');
  return at.slice(0, -3);
}

/** See the header. */
export function cellOf(at) {
  const n = at.length;
  if (n < 5) return null;
  return {table: at.slice(0, -3), r: at[n - 3], c: at[n - 2]};
}

/** See the header. */
export const topOf = (at) => [at[0], at[1]];

/** See the header. */
export function samePath(a, b) {
  if (a.length !== b.length) return false;
  for (let k = 0; k < a.length; k++) if (a[k] !== b[k]) return false;
  return true;
}

/** See the header. */
export function cmpPath(a, b) {
  const n = Math.min(a.length, b.length);
  for (let k = 0; k < n; k++) if (a[k] !== b[k]) return a[k] - b[k];
  return a.length - b.length;
}
