// FieldNames - what the Field box (./FieldBox) offers (Batch D, D19):
// the field names with evaluators, the formats each takes, and the
// field code they make.
//
//   NAMES  the names offered, in the box's order: PAGE NUMPAGES
//       SECTIONPAGES DATE TIME CREATEDATE SAVEDATE PRINTDATE
//       FILENAME AUTHOR TITLE NUMWORDS (each has a ./Fields
//       evaluator)
//   formatsOf(name) -> [{id, text, sw}]  the Format popup's choices
//       for that name: first '(none)' (sw ''), then
//       numbers (PAGE NUMPAGES SECTIONPAGES NUMWORDS): 1, 2, 3;
//         i, ii, iii; I, II, III; a, b, c; A, B, C; 1st, 2nd, 3rd
//         (\* Arabic, roman, ROMAN, alphabetic, ALPHABETIC,
//         Ordinal)
//       dates and times (DATE TIME CREATEDATE SAVEDATE PRINTDATE):
//         date pictures by example (\@ "dd/MM/yyyy" ...)
//       text (FILENAME AUTHOR TITLE): UPPER CASE, lower case,
//         Title Case, First capital (\* Upper, Lower, Caps,
//         FirstCap); an unknown name: '(none)' only
//   codeOf(name, id) -> the field code they make: the name, the
//       format's switch, and \* MERGEFORMAT, as Word's Field box
//       writes it ('PAGE \* roman \* MERGEFORMAT'); '' with no name
//   CODES  the codes of the Insert menu's items: page (PAGE),
//       pages (NUMPAGES), date (DATE \@ "dd/MM/yyyy"), time (TIME
//       \@ "HH:mm"), each \* MERGEFORMAT: the pictures written out,
//       so Word shows them the same in any language
//
// Pure: no desktop services.

export const NAMES = Object.freeze(['PAGE', 'NUMPAGES', 'SECTIONPAGES',
  'DATE', 'TIME', 'CREATEDATE', 'SAVEDATE', 'PRINTDATE', 'FILENAME',
  'AUTHOR', 'TITLE', 'NUMWORDS']);

const NONE = {id: 'none', text: '(none)', sw: ''};
const NUM = [['arabic', '1, 2, 3', '\\* Arabic'],
  ['roman', 'i, ii, iii', '\\* roman'],
  ['ROMAN', 'I, II, III', '\\* ROMAN'],
  ['alpha', 'a, b, c', '\\* alphabetic'],
  ['ALPHA', 'A, B, C', '\\* ALPHABETIC'],
  ['ord', '1st, 2nd, 3rd', '\\* Ordinal']];
const pic = (p, text) => [p, text, `\\@ "${p}"`];
const DATES = [pic('dd/MM/yyyy', '14/10/2026'),
  pic('d MMMM yyyy', '14 October 2026'),
  pic('dddd d MMMM yyyy', 'Wednesday 14 October 2026'),
  pic('d/M/yy', '14/10/26'), pic('yyyy-MM-dd', '2026-10-14'),
  pic('MMMM yyyy', 'October 2026'), pic('HH:mm', '14:05'),
  pic('HH:mm:ss', '14:05:09'), pic('h:mm am/pm', '2:05 pm'),
  pic('dd/MM/yyyy HH:mm', '14/10/2026 14:05')];
const TEXT = [['upper', 'UPPER CASE', '\\* Upper'],
  ['lower', 'lower case', '\\* Lower'],
  ['caps', 'Title Case', '\\* Caps'],
  ['first', 'First capital', '\\* FirstCap']];
const KIND = {PAGE: NUM, NUMPAGES: NUM, SECTIONPAGES: NUM,
  NUMWORDS: NUM, DATE: DATES, TIME: DATES, CREATEDATE: DATES,
  SAVEDATE: DATES, PRINTDATE: DATES, FILENAME: TEXT, AUTHOR: TEXT,
  TITLE: TEXT};
const list = (rows) => Object.freeze([NONE, ...rows.map(([id, text,
  sw]) => Object.freeze({id, text, sw}))]);
const LISTS = new Map(Object.entries(KIND).map(([n, rows]) =>
  [n, list(rows)]));
const ONLY = Object.freeze([NONE]);

/** See the header. */
export const formatsOf = (name) => (Object.hasOwn(KIND, name)
  ? LISTS.get(name) : ONLY);

const MERGE = '\\* MERGEFORMAT';

/** See the header. */
export function codeOf(name, id) {
  if (typeof name !== 'string' || !name) return '';
  const f = formatsOf(name).find((x) => x.id === id);
  return [name, f ? f.sw : '', MERGE].filter(Boolean).join(' ');
}

/** See the header. */
export const CODES = Object.freeze({
  page: codeOf('PAGE'), pages: codeOf('NUMPAGES'),
  date: codeOf('DATE', 'dd/MM/yyyy'), time: codeOf('TIME', 'HH:mm'),
});
