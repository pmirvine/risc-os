// InlineText - the text an inline item (a U+FFFC) stands for when the
// text of a paragraph is taken outside the drawing: the selection's
// text, the clipboard (plain and HTML) and Find. One rule for all.
//
//   hyphenText(x) -> '-' for a bare w:noBreakHyphen inline, '' for a
//                    bare w:softHyphen, else null (not one; no
//                    attributes and no children)
//   inlineText(x) -> the text of any inline: a tab '\t', a line
//                    break '\n', a no-break hyphen '-' (U+002D, so
//                    other programs see a hyphen and Find's '-'
//                    matches it), an optional hyphen '', else its
//                    own display text (a link's), else ''
//
// Find never replaces text that holds an inline (FindText inInline,
// the same rule as for links), so a '-' needle matches a no-break
// hyphen but Replace leaves it; and a '-' put in by a paste is plain
// text, not the inline again. Pure: no desktop services.

/** See the header. */
export function hyphenText(x) {
  const n = x && x.kind === 'raw' && x.level === 'r' && x.node;
  if (!n || typeof n !== 'object' || n.name === undefined) return null;
  if ((n.attrs && n.attrs.length) || (n.children && n.children.length))
    return null;
  if (n.name === 'w:noBreakHyphen') return '-';
  return n.name === 'w:softHyphen' ? '' : null;
}

/** See the header. */
export function inlineText(x) {
  if (!x) return '';
  if (x.kind === 'tab') return '\t';
  if (x.kind === 'br') return '\n';
  const h = hyphenText(x);
  if (h !== null) return h;
  return typeof x.text === 'string' ? x.text : '';
}
