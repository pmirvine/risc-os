// SpellJobs: the long-paragraph checks ./SpellState has begun, a
// few at once (a paint showing other long paragraphs must not throw
// away how far a check had got).
//   new SpellJobs(cap?)  cap: most held (default MAX, 4)
//   get(p, gen)    -> the job {p, gen, ...} of Para p made in that
//                     generation, else undefined
//   set(p, job)    keeps it; jobs of another generation than job.gen
//                  are dropped, and when over cap the oldest set
//   delete(p)      done with p
//   size           how many are held
// Pure.
export const MAX = 4;

export class SpellJobs {
  constructor(cap = MAX) {
    this._cap = cap;
    this._m = new Map();               // Para -> job (oldest first)
  }

  get size() { return this._m.size; }

  get(p, gen) {
    const j = this._m.get(p);
    return j && j.gen === gen ? j : undefined;
  }

  set(p, job) {
    this._m.delete(p);
    for (const [q, j] of this._m) {
      if (j.gen !== job.gen) this._m.delete(q);
    }
    this._m.set(p, job);
    while (this._m.size > this._cap) {
      this._m.delete(this._m.keys().next().value);
    }
  }

  delete(p) { this._m.delete(p); }
}
