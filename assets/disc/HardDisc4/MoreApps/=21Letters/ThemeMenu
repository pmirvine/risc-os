// ThemeMenu - the document theme's menu: Design > (./WinMenu) and
// Format > Theme > (./FormatMenu), the same items for both.
//
//   themeMenu(dw, {fontsBox, colorsBox}) -> a Menu titled 'Theme'
//       Fonts >               the 25 font pairs (./ThemePresets), the
//                             pair in force ticked
//       Colours >             the 23 colour schemes, the one in
//                             force ticked
//       Customize fonts...    fontsBox() (the custom fonts box)
//       Customize colours...  colorsBox()
//       Reset to Office theme the standard theme (./ThemeDoc reset)
//   dw.d is the Document. A choice is one undo step
//   (./ThemeDoc); a refused edit is reported to the user and
//   changes nothing. Everything is shaded when the document is
//   read-only (dw.view.readOnly or dw.readOnly). The long lists are
//   plain menus, as Format > Font's: the desktop scrolls a menu
//   taller than the screen.
import {Menu, reportError} from 'riscos';
import * as TD from './ThemeDoc';
import {COLOR_SCHEMES, FONT_PAIRS} from './ThemePresets';

// (dw.d: the real Document, not a header or note's facade)
const doc = (dw) => dw.d;
// (a placeholder: !Letters has no read-only documents yet, so this is
// false today; dw.view.readOnly / dw.readOnly are the names a future
// read-only mode would use)
const readOnly = (dw) => !!((dw.view && dw.view.readOnly) ||
  dw.readOnly);

/** Run an edit; a refusal is shown. */
function run(fn) {
  const r = fn();
  if (r && r.refused) reportError(r.refused, {appName: 'Letters'});
}

/** See the header. */
export function themeMenu(dw, {fontsBox, colorsBox} = {}) {
  const shaded = () => readOnly(dw);
  const list = (title, all, now, put) => new Menu(title, all.map(
    (p) => ({text: p.name, shaded,
      ticked: () => now(doc(dw)).name === p.name,
      action: () => run(() => put(doc(dw), p))})));
  const call = (fn) => () => { if (fn) fn(); };
  return new Menu('Theme', [
    {text: 'Fonts', shaded, help: 'Word\'s font pairs for the ' +
      'headings and the body text of the whole document.',
    submenu: () => list('Fonts', FONT_PAIRS, TD.fontsOf, TD.setFonts)},
    {text: 'Colours', shaded, help: 'Word\'s colour schemes for the ' +
      'whole document.', dotted: true,
    submenu: () => list('Colours', COLOR_SCHEMES, TD.colorsOf,
      TD.setColors)},
    {text: 'Customize fonts...', shaded: () => shaded() || !fontsBox,
      action: call(fontsBox), help: 'Choose the heading and body ' +
        'fonts yourself, in a box.'},
    {text: 'Customize colours...',
      shaded: () => shaded() || !colorsBox, action: call(colorsBox),
      help: 'Choose the twelve theme colours yourself, in a box.',
      dotted: true},
    {text: 'Reset to Office theme', shaded,
      action: () => run(() => TD.reset(doc(dw))),
      help: 'Put back the standard Office fonts and colours.'},
  ]);
}
