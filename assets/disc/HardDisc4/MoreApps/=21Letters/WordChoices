// WordChoices - Word's choices: one JSON object in Choices:Letters,
// shared by everything that keeps a choice there (./RecentFiles:
// 'recent'; ./AutoFormatOpt: 'autoList'; ./ViewMode: 'view', the
// view chosen last; ./CountBox: 'countNotes'; ./CaptionBox:
// 'captionLabels', the caption labels made with New label...,
// [label, ...] cleaned by ./CaptionPatch savedLabels; ./CommentOpts:
// 'userName' and 'userInitials', the author new comments are
// written with; ./SpellOpts: 'spell', false when Check spelling as
// you type is off, and 'userWords', the personal word list, [word,
// ...]). Each changes
// only its own key and writes the whole object, so none overwrites
// another's (keys it does not know are kept as they were read). The
// core writes the file as ASCII (a character outside it is a \uXXXX
// escape), so any word or name is kept whole; a file of RISC OS
// Latin-1 bytes from before reads as it did.
//
//   loadChoices(app) -> Promise  app.choices = {} at once, then the
//                     object read from Choices:Letters (missing,
//                     corrupt or not an object: {}); the promise is
//                     app.choicesReady (one read per app: a second
//                     call gives the same promise). Never rejects
//   choiceOf(app, key) -> the value of key (an own property of the
//                     choices), or undefined
//   setChoice(app, key, value) -> Promise  after the read (at once,
//                     synchronously, when it is done): the choices
//                     in Choices:Letters now (read again when the disc
//                     has the file in
//                     memory, so another writer's keys are kept;
//                     else app.choices), key set, written whole,
//                     and app.choices is that. A write that fails is
//                     told to the console only: it never stops a
//                     save. Never rejects
//   mergeChoice(stored, key, value) -> a new object: stored (a
//                     plain object; anything else {}) with key set
//
// key is one of ours ('recent', 'autoList', 'view',
// 'countNotes', 'captionLabels', 'userName', 'userInitials',
// 'spell', 'userWords'), never
// a name
// read from the file; JSON.parse makes '__proto__' an ordinary own
// key, which the spread copies as data (no prototype is ever
// changed).
import {vfs, choices} from 'riscos';

const NAME = 'Letters', PATH = 'Choices:' + NAME;
const ready = new WeakSet();           // apps whose choices are read
const isObj = (v) => typeof v === 'object' && v !== null &&
  !Array.isArray(v);

/** See the header. */
export const mergeChoice = (stored, key, value) =>
  ({...(isObj(stored) ? stored : {}), [key]: value});

/** JSON text -> the choices object, or null. */
function parse(text) {
  try {
    const c = JSON.parse(text);
    return isObj(c) ? c : null;
  } catch (e) {
    return null;
  }
}

// The bytes 0x80-0x9F of RISC OS Latin-1 (as the core's charset
// reads them: a curly apostrophe is 0x91).
const HIGH = '\u20AC\u0174\u0175\u25F0\uD83E\uDFC0\u0176\u0177' +
  '\uD83E\uDFC1\u21E6\u21E8\u21E9\u21E7\u2026\u2122\u2030\u2022' +
  '\u2018\u2019\u2039\u203A\u201C\u201D\u201E\u2013\u2014\u2212' +
  '\u0152\u0153\u2020\u2021\uFB01\uFB02';
const HI = [...HIGH];

/** Bytes as RISC OS Latin-1 text, as vfs.readText reads them. The
 *  core writes the file as ASCII, every other character a \uXXXX
 *  escape (JSON.parse undoes it); a file written before that holds
 *  Latin-1 bytes, which this reads as they were meant. */
function latin1(bytes) {
  let s = '';
  for (let i = 0; i < bytes.length; i++) {
    const b = bytes[i];
    s += b >= 0x80 && b < 0xA0 ? HI[b - 0x80] : String.fromCharCode(b);
  }
  return s;
}

/** The choices in the file now, if it can be read at once. */
function current() {
  try {
    if (!vfs.exists(PATH)) return null;
    return parse(latin1(vfs.readFileSync(PATH)));
  } catch (e) {
    return null;                       // (not in memory, unreadable)
  }
}

/** See the header. */
export function loadChoices(app) {
  if (app.choicesReady) return app.choicesReady;
  app.choices = {};
  app.choicesReady = (async () => {
    try {
      if (vfs.exists(PATH)) {
        app.choices = parse(await vfs.readText(PATH)) || {};
      }
    } catch (e) {
      console.warn('Letters: Choices:Letters not read', e);
    }
    ready.add(app);
  })();
  return app.choicesReady;
}

/** See the header. */
export function choiceOf(app, key) {
  const c = app.choices;
  return isObj(c) && Object.hasOwn(c, key) ? c[key] : undefined;
}

/** See the header. */
export function setChoice(app, key, value) {
  const write = () => {
    app.choices = mergeChoice(current() || app.choices, key, value);
    try {
      choices.write(NAME, app.choices);
    } catch (e) {
      console.warn('Letters: Choices:Letters not written', e);
    }
  };
  if (ready.has(app)) {
    write();
    return Promise.resolve();
  }
  return loadChoices(app).then(write);
}
