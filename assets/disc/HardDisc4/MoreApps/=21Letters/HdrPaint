// HdrPaint - a document's window drawn in header and footer mode
// (Batch D, D14).
//
//   paintHdr(B, L, g, rect, sel, active, more)  B the body's layout
//       (Print layout: B.place a ./PlacePrint), L the story's own
//       layout on its page (./HdrEdit: L.place a ./HdrView
//       PlaceShift). The pages as ever (./EditPaint paintView, no
//       selection: the headers and footers in full colour); then on
//       every page that meets rect (work area, layout px) the body
//       dimmed (DIM, 50% white over the page from bodyTop to the
//       frame's bottom), a BOUNDARY line in [4, 3] dashes across the
//       page where the header's area ends (bodyTop) and where the
//       footer's starts (the frame's bottom), each with its tab:
//       ./HdrView labelOf's text at the page's left (below the
//       header's line, above the footer's), 'Same as previous' at
//       its right when linked (TAB on TAB_TEXT, TAB_H px, FONT);
//       then the selection, the caret's overwrite shade, a picture's
//       handles in the story (./EditPaint paintSel on L)
//   DIM, BOUNDARY, TAB, TAB_TEXT, TAB_H, FONT, SAME
//
// Draws on the context it is given; imports no desktop services.
import {paintView, paintSel} from './EditPaint';
import {labelOf} from './HdrView';

export const DIM = 'rgba(255, 255, 255, 0.5)';
export const BOUNDARY = '#3c6eb4';
export const TAB = '#dce6f2', TAB_TEXT = '#1f3a60', TAB_H = 16;
export const FONT = '11px "Liberation Sans", Arial, sans-serif';
export const SAME = 'Same as previous';

/** A tab with text at (x, y): its left (or right) edge, its top (or
 *  bottom, above). */
function tab(g, x, y, text, right, above) {
  g.font = FONT;
  const w = Math.ceil(g.measureText(text).width) + 8;
  const tx = right ? x - w : x, ty = above ? y - TAB_H : y;
  g.fillStyle = TAB;
  g.fillRect(tx, ty, w, TAB_H);
  g.fillStyle = TAB_TEXT;
  g.fillText(text, tx + 4, ty + 12);
}

/** The dashed line across page rectangle r at y, and its tabs. */
function boundary(g, r, y, lab, above) {
  g.save();
  g.strokeStyle = BOUNDARY;
  g.lineWidth = 1;
  g.setLineDash([4, 3]);
  g.beginPath();
  g.moveTo(r.x, y + 0.5);
  g.lineTo(r.x + r.w, y + 0.5);
  g.stroke();
  g.restore();
  tab(g, r.x + 1, above ? y : y + 1, lab.text, false, above);
  if (lab.linked) tab(g, r.x + r.w - 1, above ? y : y + 1, SAME, true,
    above);
}

/** See the header. */
export function paintHdr(B, L, g, rect, sel, active, more = {}) {
  paintView(B, g, rect, null, active, more);
  const Pl = B.place, S = Pl.sheet, P = Pl.pages;
  for (const i of S.pagesIn(rect.y0, rect.y1)) {
    const pg = P.list[i];
    if (!pg || pg.blank) continue;
    const r = S.rect(pg), y0 = Math.round(r.y + pg.bodyTop);
    const y1 = Math.round(r.y + pg.bodyTop + pg.frameH);
    g.fillStyle = DIM;
    g.fillRect(r.x, y0, r.w, y1 - y0);
    boundary(g, r, y0, labelOf(B.doc, pg, 'hdr'), false);
    boundary(g, r, y1, labelOf(B.doc, pg, 'ftr'), true);
  }
  paintSel(L, g, rect, sel, active, more);
}
