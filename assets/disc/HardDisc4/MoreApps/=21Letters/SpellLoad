// SpellLoad - reads the bundled UK English dictionary.
//
//   loadDict(readBytes, dir) -> Promise<{dic: string, aff: string}>
//
// Reads 'dir.en_GB_dic' and 'dir.en_GB_aff' (a Hunspell
// dictionary and affix file, LibreOffice's en_GB, LGPL: see
// Dict.Licences) through `readBytes(path) -> Promise<Uint8Array>`
// and decodes them as UTF-8 with any byte order mark removed.
// The promise is kept on globalThis (Symbol.for(
// 'letters.spell.dict')), so it outlives this module and every
// run of !Letters shares one read. A failed read rejects with an
// Error and is not kept, so the next call tries again; callers
// treat a rejection as "no dictionary" and carry on editing.
export const DICT_DIR = 'Dict';

const KEY = Symbol.for('letters.spell.dict');

function decode(bytes) {
  const s = new TextDecoder('utf-8').decode(bytes);
  return s.charCodeAt(0) === 0xFEFF ? s.slice(1) : s;
}

export function loadDict(readBytes, dir) {
  if (globalThis[KEY]) return globalThis[KEY];
  const job = Promise.all([
    readBytes(dir + '.en_GB_dic'),
    readBytes(dir + '.en_GB_aff'),
  ]).then(([dic, aff]) => ({dic: decode(dic), aff: decode(aff)}))
    .catch((e) => {
      if (globalThis[KEY] === job) delete globalThis[KEY];
      throw e instanceof Error ? e : new Error(String(e));
    });
  globalThis[KEY] = job;
  return job;
}
