// PicDrag - a picture selected, resized and opened with the mouse
// (Batch B). ./EditMouse asks these first; each returns true when it
// has used the event (it then goes no further).
//
//   picClick(v, ev) -> boolean
//       a Select click (no Ctrl) on a handle of the selected
//       picture (./PicFind handleAt at v.zoom) leaves it selected
//       (a drag may follow; Shift too); one without Shift on a
//       picture (./PicFind picAt) selects it (its U+FFFC)
//   picDragStart(v, ev) -> boolean
//       a Select drag (no Ctrl) starting on a handle of the selected
//       picture, or (P12.5, D27) on the body of a selected floating
//       one (./PicFind selectedPic float): the picture is MOVED, the
//       ghost its box shifted by the pointer's move, and on release
//       v.typing.command(() => ./AnchorMove moveAnchor(...)) (the
//       posOffsets + the move; one step; null: a beep). A handle
//       resizes (below), also a floating picture whose anchor is
//       understood (./AnchorRead). An unsupported one (!supported:
//       R2), an anchor not understood, a move of one whose position
//       ./AnchorMove cannot set (canMove: in an mc:AlternateContent;
//       P12a fix M4: at the press), or a move of one in line (its
//       body: not used) beeps or is left to the text: no drag.
//       Else the pointer
//       is followed (wimp.drag, type 'point'): v.picGhost {x, y, w,
//       h} (layout px) is the box it would get (./PicSize dragSize;
//       Shift, read live from os.input.keysDown, frees a corner),
//       drawn dashed by ./EditPaint; v.picDrag {cancel()} while it
//       lasts (./EditKeys: Escape ends it, the ghost gone, nothing
//       changed). On release the new extent goes in by
//       v.typing.command(() => ./PicOps setPicture(...)), one undo
//       step (none when nothing changes), shown by v.edited; a
//       refusal beeps. The file's extent changes as the box does
//       (cx x new w / old w, so a picture shown smaller than its
//       extent, fitted to the column, keeps its proportions), each
//       side within ./PicSize MIN_EMU..MAX_EMU; an edge handle
//       leaves the other side's extent as it was; a corner without
//       Shift keeps the extent's proportions (one factor, kept so
//       that both sides are in range; the larger side worked out
//       from the smaller: within 1 EMU; none: a beep). The ghost
//       shows that extent. Back where it began: no change, no
//       step. When the document changes (d.stateId) or the
//       picture is no longer selected during the drag (a key: Delete,
//       Ctrl-Z, typing), the drag ends at once with a beep: nothing
//       is put in
//   picDouble(v, ev) -> boolean
//       a Select double-click (no Shift, Ctrl) on a picture selects
//       it and calls v.onPicture?.() (the Picture dialog: B6)
//
// None of them acts while the format painter is on (v.painter:
// ./PaintBind) or there is no selection: the mouse then works as it
// does on text. Points are the window's (zoomed): ./Zoom toLayout.
// The picture's box, its handles and the ghost are where the
// layout's placement puts its line (./PicFind: L.place, D4).
import {wimp, os} from 'riscos';
import * as S from './Selection';
import {picAt, selectedPic, handleAt} from './PicFind';
import {dragSize, MIN_EMU, MAX_EMU} from './PicSize';
import {setPicture} from './PicOps';
import {moveAnchor, canMove} from './AnchorMove';
import {toLayout} from './Zoom';

const SIGNS = {nw: [-1, -1], n: [0, -1], ne: [1, -1], e: [1, 0],
  se: [1, 1], s: [0, 1], sw: [-1, 1], w: [-1, 0]};

/** A Select press the pictures may use. */
const ours = (v, ev) => ev.button === 'select' && !ev.ctrl &&
  !v.painter && !!v.sel;

const pointOf = (v, x, y) => toLayout(x, y, v.zoom, v.L.top);

/** {s, name}: the selected picture's handle at p, else null. */
function onHandle(v, p) {
  const s = selectedPic(v.L, v.sel);
  const name = s && handleAt(s.rect, p.x, p.y, v.zoom);
  return name ? {s, name} : null;
}

/** {s, name: null}: the selected floating picture's box at p. */
function onFloat(v, p) {
  const s = selectedPic(v.L, v.sel), r = s && s.float && s.rect;
  const dx = r && p.x - r.x, dy = r && p.y - r.y;
  return r && dx >= 0 && dx < r.w && dy >= 0 && dy < r.h ?
    {s, name: null} : null;
}

/** An anchor ./AnchorRead understands (R12: others are not moved
 *  or resized). */
const placed = (i) => !i.floating || !!i.anchor && !i.anchor.unknown;
const resizable = (i) => i.supported && placed(i);
const movable = (i) => i.floating && placed(i);

/** Select the picture found (./PicFind). */
function choose(v, f) {
  const {id, off} = f.pos;
  v.setSelection(S.select({id, off}, {id, off: off + 1}),
    {scroll: false});
  v.focus();
}

/** See the header. */
export function picClick(v, ev) {
  if (!ours(v, ev)) return false;
  const p = pointOf(v, ev.x, ev.y);
  if (onHandle(v, p)) {
    v.focus();
    return true;
  }
  const f = !ev.shift && picAt(v.L, p.x, p.y);
  if (!f) return false;
  choose(v, f);
  return true;
}

/** See the header. */
export function picDouble(v, ev) {
  if (!ours(v, ev) || ev.shift) return false;
  const p = pointOf(v, ev.x, ev.y);
  const f = picAt(v.L, p.x, p.y);
  if (!f) return false;
  choose(v, f);
  if (typeof v.onPicture === 'function') v.onPicture();
  return true;
}

const shiftDown = () => !!os.input &&
  ['ShiftLeft', 'ShiftRight'].some((k) => os.input.keysDown.has(k));

/** The box r becomes at size {w, h}, its far side kept. */
function ghostOf(r, name, size) {
  const [sx, sy] = SIGNS[name];
  return {x: sx < 0 ? r.x + r.w - size.w : r.x,
    y: sy < 0 ? r.y + r.h - size.h : r.y, w: size.w, h: size.h};
}

const lim = (v) => Math.min(MAX_EMU, Math.max(MIN_EMU,
  Math.round(v)));

/** The extent for box size (see the header); null: none fits. */
function extentFor(info, name, start, size, free) {
  const [sx, sy] = SIGNS[name];
  const {cx, cy} = info, kw = size.w / start.w, kh = size.h / start.h;
  if (!sx || !sy || free) {
    return {cx: sx ? lim(cx * kw) : cx, cy: sy ? lim(cy * kh) : cy};
  }
  // a corner: one factor for both sides, kept in range
  const big = Math.max(cx, cy), small = Math.min(cx, cy);
  const k = Math.min(MAX_EMU / big, Math.max(MIN_EMU / small, kw));
  let s1 = Math.round(small * k), b1 = Math.round(s1 * big / small);
  while (b1 > MAX_EMU && s1 > MIN_EMU) {
    s1 -= 1;
    b1 = Math.round(s1 * big / small);
  }
  if (s1 < MIN_EMU || b1 > MAX_EMU) return null;
  return cx >= cy ? {cx: b1, cy: s1} : {cx: s1, cy: b1};
}

/** See the header. */
export function picDragStart(v, ev) {
  if (!ours(v, ev) || v.picDrag) return false;
  const p0 = pointOf(v, ev.x, ev.y);
  const hit = onHandle(v, p0) || onFloat(v, p0);
  if (!hit) return false;
  const info = hit.s.item.pic, name = hit.name, pos = hit.s.pos;
  if (!name ? !movable(info) || !canMove(v.d, v.sel)
    : !resizable(info)) {
    wimp.beep();                       // (at the press: P12a fix M4)
    return true;
  }
  const w = v.win, r = hit.s.rect, start = {w: r.w, h: r.h};
  let move = {dx: 0, dy: 0};
  const sel = v.sel, state = v.d.stateId;
  let ext = info, free = false, done = false;
  const end = () => {
    done = true;
    v.picGhost = null;
    v.picDrag = null;
    if (w.isOpen) w.invalidate();
  };
  // the document changed, or the picture is no longer selected
  const stale = () => {
    if (!w.isOpen) return true;
    const s = v.d.stateId === state && selectedPic(v.L, v.sel);
    return !s || s.pos.id !== pos.id || s.pos.off !== pos.off;
  };
  const alive = () => {
    if (done) return false;
    if (!stale()) return true;
    end();
    wimp.beep();
    return false;
  };
  const follow = (sx, sy) => {
    if (!alive()) return;
    const q = w.screenToWork(sx, sy), p = pointOf(v, q.x, q.y);
    free = shiftDown();
    if (!name) {
      move = {dx: p.x - p0.x, dy: p.y - p0.y};
      v.picGhost = {...r, x: move.dx + r.x, y: move.dy + r.y};
      w.invalidate();
      return;
    }
    const size = dragSize(start, name, p.x - p0.x, p.y - p0.y,
      {free});
    ext = extentFor(info, name, start, size, free);
    v.picGhost = ghostOf(r, name, ext ? {w: start.w * ext.cx /
      info.cx, h: start.h * ext.cy / info.cy} : size);
    w.invalidate();
  };
  v.picDrag = {cancel: end};
  v.picGhost = {...r};
  w.invalidate();
  wimp.drag({type: 'point', event: ev.pointerEvent,
    onMove: (s) => follow(s.sx, s.sy),
    onEnd: (d) => {
      // (the last moves may come together with the release)
      if (d && Number.isFinite(d.sx)) follow(d.sx, d.sy);
      if (!alive()) return;
      end();
      if (!name) put(v, () => moveAnchor(v.d, sel, {...move,
        from: {x: hit.s.float.x, y: hit.s.float.y, bx: hit.s.float.bx,
          by: hit.s.float.by}}));
      else if (!ext) wimp.beep();
      else if (ext.cx !== info.cx || ext.cy !== info.cy) {
        put(v, () => setPicture(v.d, sel, ext));
      }
    }});
  return true;
}

/** Run cmd (a command returning the selection, or null: a beep)
 *  as one undo step; a RangeError beeps. */
function put(v, cmd) {
  let out;
  try {
    out = v.typing.command(cmd);
  } catch (e) {
    if (!(e instanceof RangeError)) throw e;
    wimp.beep();
    return;
  }
  if (out === null) wimp.beep();
  else v.edited(out);
}
