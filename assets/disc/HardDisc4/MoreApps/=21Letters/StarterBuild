// StarterBuild - starterDoc: nodes from ./StarterKit -> a Doc.
//
// A literal tab inside text is refused (use StarterKit tab()): the
// reader folds it and w:tab together, so only here can it be seen.
//   starterDoc({body, header, footer, styles, pgMar, finalType,
//     title}) -> Doc
//     body    nodes (w:p, w:tbl) for the document (a table last
//             is followed by an empty Normal paragraph)
//     tailGap 'tiny': that paragraph is one point high (a design
//             that must stay on one page; typing in it is clipped)
//     header, footer  nodes for the default header / footer, or none
//     styles  ids of built-in styles to ensure besides those the
//             nodes name (pStyle, rStyle, tblStyle are found)
//     pgMar   page margin twips to change (default 1440 all round,
//             header / footer 708)
//     finalType  how the last section starts ('continuous': on the
//             page of the one before; default a new page)
//     stylePPr  {styleId: pPr props} merged into those styles'
//             paragraph properties (objects such as spacing merge
//             key by key), e.g. {Normal: {spacing: {line:
//             480, lineRule: 'auto', after: 0}}}
//     titlePg true: the last section has a different first page (no
//             first-page header or footer part: they are blank)
//     title   the document title (docProps/core.xml)
//
// A new A4 ./NewDoc document (Office theme, compatibility mode 15,
// the built-in styles) whose body, header and footer parts are read
// by the reader's own functions: ./ReadBody readBody, ./StoryRead
// readStory, ./ReadStyles, ./ReadNumbering; the numbering part is
// added only when a list is used (and numbered lists that restart:
// numIds above 2). Every sectionBreak gets this page size and
// margins. Nothing is built until called.
import {el, serialize} from 'wimplib/Xml';
import {NS, W} from './Wml';
import {rootScope} from './Ns';
import {newDoc} from './NewDoc';
import {readBody} from './ReadBody';
import {readStory} from './StoryRead';
import {readStyles} from './ReadStyles';
import {readNumbering} from './ReadNumbering';
import {ensureBuiltin} from './StyleCmd';
import {stylesTree} from './WriteStyles';
import {CT, STD_DECL, relType} from './WriteParts';
import {starterNumbering} from './StarterNum';

const ROOT = [['xmlns:w', NS.w], ['xmlns:r', NS.r]];
const bytes = (root) => new TextEncoder().encode(
  serialize(root, {decl: STD_DECL}));
const rel = (id, type, target) => ({id, type, target,
  attrs: [['Id', id], ['Type', type], ['Target', target]]});

/** Every style id the nodes name, and whether a list is used. */
function scan(nodes, ids = new Set(), used = {num: false, max: 0}) {
  for (const n of nodes) {
    if (typeof n === 'string') continue;
    if (/^w:(pStyle|rStyle|tblStyle)$/.test(n.name))
      ids.add(n.attrs.find(([k]) => k === 'w:val')[1]);
    if (n.name === 'w:numId') {
      used.num = true;
      used.max = Math.max(used.max, +n.attrs[0][1]);
    }
    if (n.name === 'w:t' && n.children.some((c) =>
      typeof c === 'string' && c.includes('\t')))
      throw new RangeError('literal tab in w:t: use tab()');
    scan(n.children, ids, used);
  }
  return {ids, used};
}

/** w:sectPr: [type], pgSz, pgMar, cols (CT_SectPr order). */
function sectPr(spec, refs, type, cols, last) {
  return W('sectPr', null, refs.map(([kind, id]) =>
    W(kind + 'Reference', [['w:type', 'default'], ['r:id', id]])),
  type ? W('type', {'w:val': type}) : null,
  W('pgSz', {'w:w': 11906, 'w:h': 16838}),
  W('pgMar', {'w:top': 1440, 'w:right': 1440, 'w:bottom': 1440,
    'w:left': 1440, 'w:header': 708, 'w:footer': 708, 'w:gutter': 0,
    ...spec.pgMar}), cols || W('cols', {'w:space': 708}),
  last && spec.titlePg ? W('titlePg') : null);
}

/** A sectionBreak paragraph with the page set up. */
function fill(n, spec) {
  const pPr = n.name === 'w:p' && n.children.find((c) =>
    c.name === 'w:pPr');
  const sp = pPr && pPr.children.find((c) => c.name === 'w:sectPr');
  if (!sp) return n;
  const by = (name) => sp.children.find((c) => c.name === name);
  const t = by('w:type');
  const made = sectPr(spec, [], t && t.attrs[0][1], by('w:cols'));
  return {...n, children: n.children.map((c) => c !== pPr ? c
    : {...pPr, children: pPr.children.map((x) => x === sp ? made
      : x)})};
}

/** See the header. */
export function starterDoc(spec) {
  const {body = [], header = [], footer = [], title = ''} = spec;
  const doc = newDoc({paper: 'a4'});
  const all = [...body, ...header, ...footer];
  const {ids, used} = scan(all);
  let table = doc.styles;
  for (const id of [...ids, ...(spec.styles || [])]) {
    table = ensureBuiltin(table, id) || table;
    if (!table.styles.has(id))
      throw new RangeError('no built-in style ' + id);
  }
  for (const [id, pPr] of Object.entries(spec.stylePPr || {})) {
    const s = table.styles.get(id);
    if (!s) throw new RangeError('no style ' + id);
    const merged = {...s.pPr, ...pPr};
    for (const k of Object.keys(pPr))   // one level deeper (spacing)
      if (pPr[k] && s.pPr && s.pPr[k] && typeof pPr[k] === 'object')
        merged[k] = {...s.pPr[k], ...pPr[k]};
    table.styles.set(id, {...s, raw: undefined, pPr: merged});
  }
  const st = stylesTree(table);
  const theme = doc.styles.theme;
  doc.styles = readStyles(st, rootScope(st));
  doc.styles.theme = theme;

  const meta = doc.meta, dir = 'word/';
  const addPart = (name, kind, type, nodes) => {
    const id = 'rId' + (doc.rels.length + 1);
    const root = el(kind === 'header' ? 'w:hdr' : 'w:ftr', ROOT, nodes);
    const part = readStory(dir + name, bytes(root),
      rootScope({name: 'w:document', attrs: ROOT}), null);
    doc.parts.set(part.part, part.bytes);
    doc.stories.set(part.part, part);
    doc.rels.push(rel(id, relType(kind), name));
    meta.contentTypes.overrides.push(['/' + part.part, type]);
    meta.zipOrder.push(part.part);
    meta.storyParts.push(part.part);
    return [kind === 'header' ? 'header' : 'footer', id];
  };
  const refs = [];
  if (header.length)
    refs.push(addPart('header1.xml', 'header', CT.header, header));
  if (footer.length)
    refs.push(addPart('footer1.xml', 'footer', CT.footer, footer));
  if (used.num) {
    const nums = starterNumbering(Math.max(0, used.max - 2));
    doc.numbering = readNumbering(nums.raw, rootScope(nums.raw),
      doc.styles);
    doc.rels.push(rel('rId' + (doc.rels.length + 1),
      relType('numbering'), 'numbering.xml'));
    meta.numberingPart = dir + 'numbering.xml';
    meta.contentTypes.overrides.push(['/' + meta.numberingPart,
      CT.numbering]);
    meta.zipOrder.push(meta.numberingPart);
    meta.prolog.set(meta.numberingPart, {decl: STD_DECL, before: [],
      after: []});
  }

  const map = rootScope({name: 'w:document', attrs: ROOT});
  // (a table last: Word keeps a paragraph after it: an ordinary
  // empty one, or with tailGap 'tiny' a one-point one for a design
  // that must keep to one page; typing there would be clipped)
  const last = body[body.length - 1];
  const tiny = spec.tailGap === 'tiny';
  const tail = last && last.name === 'w:tbl' ? [W('p', null,
    tiny ? W('pPr', null, W('spacing', {'w:before': 0, 'w:after': 0,
      'w:line': 20, 'w:lineRule': 'exact'}),
    W('rPr', null, W('sz', {'w:val': 2}))) : null)] : [];
  const bodyTree = el('w:body', null,
    [...body, ...tail].map((n) => fill(n, spec)),
    sectPr(spec, refs, spec.finalType, null, true));
  doc.sections = readBody(bodyTree, map).sections;
  if (title) {
    const core = doc.parts.get('docProps/core.xml');
    const was = new TextDecoder().decode(core);
    const now = was.replace('<dc:title/>',
      serialize(el('dc:title', null, title)));
    if (now === was) throw new Error('no dc:title in core.xml');
    doc.parts.set('docProps/core.xml', new TextEncoder().encode(now));
  }
  return doc;
}
