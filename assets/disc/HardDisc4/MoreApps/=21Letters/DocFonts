// DocFonts - the font table of a .doc ([MS-DOC] 2.9.284 SttbfFfn:
// an STTB of 2.9.82 FFN records, whose xszFfn is the font's name
// in UTF-16). Used by ./DocStyles; pure.
//
//   readFonts(table, fib, note?) -> [name | undefined]  by font
//       index (sprmCRgFtc0's ftc). At most MAX_FONTS; a record that
//       runs past the table ends the list (a note); a name is cut
//       at its NUL, at most 64 characters, its control characters
//       left out; an empty one is undefined
import {slice} from './DocFib';

export const MAX_FONTS = 4096;
const NAME_AT = 40, MAX_NAME = 64;
const BAD = 'the font table is damaged: some fonts are not known';

/** See the header. */
export function readFonts(table, fib, note = () => {}) {
  const t = slice(table, fib, 'SttbfFfn', note);
  const out = [];
  if (!t || t.length < 4) return out;
  const u16 = (o) => t[o] | (t[o + 1] << 8);
  // (cData, cbExtra: SttbfFfn has no fExtend)
  const n = Math.min(u16(0), MAX_FONTS);
  let at = 4;
  for (let i = 0; i < n; i++) {
    if (at >= t.length) {
      note(BAD);
      break;
    }
    const cb = t[at];
    const end = at + 1 + cb;
    if (end > t.length) {
      note(BAD);
      break;
    }
    let s = '';
    for (let o = at + NAME_AT; o + 1 < end && s.length < MAX_NAME;
      o += 2) {
      const c = u16(o);
      if (!c) break;
      if (c >= 0x20) s += String.fromCharCode(c);
    }
    s = s.trim();
    out.push(s ? s.toWellFormed() : undefined);
    at = end;
  }
  return out;
}
