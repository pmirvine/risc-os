// EditKeys - a key in a document's window (./EditView):
//
//   keyFor(view, ev) -> true if used, undefined if not (the Wimp
//                       then passes it on)
//   pageMove(view, cmd) -> true | false  cmd 'nextPage' or
//                       'prevPage' as Ctrl-Page Down / Up do it (the
//                       Edit menu's Next page and Previous page:
//                       ./EditMenu, for a browser that keeps the
//                       keys); false without a selection or for any
//                       other cmd
//
// On a Mac (view.mac) Cmd + a letter is Ctrl + it first (./MacKeys).
// ./Keys first (moving the caret, extending the selection, Ctrl-A,
// Escape), then ./Keymap (editing and the window's keys: view.run); its
// cut, copy and paste keys are passed on (undefined): the browser turns
// them into its clipboard events (./EditClip). New, Close, Save and
// Save as (F2, Ctrl-N, Ctrl-F2, Ctrl-S, F3: ./DocKeys) act once per
// press: the browser's repeats of a key held down (domEvent.repeat) are
// used up and do nothing. A printable key that still comes as a 'key'
// (the Wimp's hidden text field has lost the browser's focus, or
// Wimp_ProcessKey sent it) is typed: one character, no Ctrl, no Alt, no
// Cmd (Meta: a browser shortcut such as Cmd-C or Cmd-V, never text),
// and not from the text field while it has the focus
// (view.fromProxy(ev): such a key was not typed there, so it is not
// text either). Page Up and Page Down scroll the window by the height
// that can be seen (less the toolbar's) less 32 px
// (./EditScroll.pageStep) and move the caret as far (on the screen:
// step / v.zoom in the layout), so it stays where it was in the window
// (scrolled again only if the line it lands on is not all in view: the
// step stays exact); Ctrl-Page Down and Ctrl-Page Up (nextPage,
// prevPage) put the caret on the next or previous page's first line
// in Print layout, scrolled into view (./SelPage), and are Page Down
// and Page Up where there are no pages (Draft: ./SelMove pageCmd,
// the one rule); Ctrl-Home and
// Ctrl-End scroll to the very top or bottom; Ctrl-A selects
// everything without scrolling; Escape makes a
// selection a caret at its head (a caret's Escape is passed on; with
// the format painter on it only ends that: ./PaintBind; during a
// picture's handle drag or a table border's only that, nothing
// changed: ./PicDrag, ./TblDrag); in the header and footer mode
// (v.hdr) Escape leaves it (v.leaveHdr: ./HdrMode). In a
// table's cell (the selection's head: ./SelTable cellTabTarget, D10)
// Tab and Shift-Tab select the next and previous cell's content
// (before the keymap: in a list paragraph in a cell too); Tab in
// the last cell adds a row below the last one (view.run('tabRow'):
// ./TblCmd tabRowCmd, C4.1, D23; cellTabTarget's 'last' checked by
// direction), Shift-Tab at the first cell does nothing; Ctrl-Tab
// (cellTab) types a tab character there,
// as typing does (view.input), and elsewhere goes on (R21: no
// command runs, so a pending typing format is kept).
// Ctrl-Shift-Enter (./Keymap splitTable) is Split table when an end
// of the selection is in a table's cell, and Insert > Column break
// (columnBreak, Batch D P10.3, D22) everywhere else (no selection:
// splitTable, which does nothing). In Outline view (v._L.outline, not
// in the header and footer mode) ./OutlineCmd outlineId comes before
// ./Keys: Ctrl-Shift-Up and Down move the paragraph (else they
// extend the selection by paragraphs), Tab and Shift-Tab at a
// heading's start demote and promote it (Shift-Tab body text too),
// a beep when refused (./EditRun). Uses only the view: no desktop
// services.
import * as S from './Selection';
import {command} from './Keys';
import {keymap} from './Keymap';
import {pageStep, visible} from './EditScroll';
import {macKey} from './MacKeys';
import {cellTabTarget, inCell} from './SelTable';
import {pageCmd} from './SelMove';
import {outlineId} from './OutlineCmd';

const CLIP = new Set(['cut', 'copy', 'paste']);
const ONCE = new Set(['new', 'close', 'save', 'saveBox']);
const TABS = new Set(['tab', 'shiftTab', 'cellTab']);

/** Tab, Shift-Tab, Ctrl-Tab in a cell; undefined elsewhere. */
function inTable(v, id) {
  const doc = v.d && v.d.doc;
  if (!doc) return undefined;
  if (id === 'cellTab') {
    if (!inCell(doc, v.sel.head)) return undefined;
    v.input('\t');
    return true;
  }
  const to = cellTabTarget(doc, v.sel, id === 'tab' ? 1 : -1);
  if (to === null) return undefined;
  if (to === 'last' && id === 'tab') return v.run('tabRow');
  if (to !== 'last') v.setSelection(to);
  return true;
}

/** Ctrl-Shift-Enter's command: splitTable or columnBreak. */
function splitOrColumn(v) {
  const doc = v.d && v.d.doc, s = v.sel;
  if (!doc || !s || inCell(doc, s.head) || inCell(doc, s.anchor)) {
    return 'splitTable';
  }
  return 'columnBreak';
}

/** The character a 'key' types, or null (see the header). */
function printable(v, ev) {
  if (ev.ctrl || ev.alt) return null;
  const e = ev.domEvent;
  if (e && (e.metaKey || e.ctrlKey || e.altKey)) return null;
  if (v.fromProxy && v.fromProxy(ev)) return null;
  const k = typeof ev.key === 'string' && [...ev.key].length === 1
    ? ev.key : ev.char;
  if (typeof k !== 'string' || !k) return null;
  const c = k.codePointAt(0);
  return c < 32 || (c >= 127 && c < 160) ? null : k;
}

/** See the header. */
export function keyFor(v, e0) {
  // (Escape ends a picture's or a table border's drag, ./PicDrag,
  // ./TblDrag, then the format painter, ./PaintBind, nothing else)
  const drag = e0.code === 27 && (v.picDrag || v.tblDrag);
  if (drag) {
    drag.cancel();
    return true;
  }
  if (e0.code === 27 && v.endPainter && v.endPainter()) return true;
  if (e0.code === 27 && v.hdr && v.leaveHdr) {
    v.leaveHdr();                      // (./HdrMode)
    return true;
  }
  const ev = macKey(e0, v.mac);
  // (v._L, not v.L: reading v.L lays out, and a storm of keys must
  // not lay out once a key; outline only says which view it is)
  const ol = !v.hdr && v.sel && v._L && v._L.outline;
  const oid = ol ? outlineId(v.d.doc, v.sel, ol, keymap.lookup(ev))
    : null;
  if (oid) return v.run(oid);
  const k = command(ev.code,
    {shift: ev.shift, ctrl: ev.ctrl, key: ev.key});
  if (k) return v.sel ? move(v, k) : undefined;
  const id = keymap.lookup(ev);
  if (id) {
    const t = TABS.has(id) && v.sel ? inTable(v, id) : undefined;
    // (Ctrl-Tab outside a cell goes on: no command, pending kept)
    if (t !== undefined || id === 'cellTab') return t;
    if (CLIP.has(id)) return undefined;
    if (ONCE.has(id) && ev.domEvent && ev.domEvent.repeat) return true;
    return v.run(id === 'splitTable' ? splitOrColumn(v) : id);
  }
  const ch = printable(v, ev);
  if (ch === null) return undefined;
  v.input(ch);
  return true;
}

/** A ./Keys command (also pageMove's). */
function move(v, k) {
  const L = v.L;
  k = {...k, cmd: pageCmd(L, k.cmd)};
  switch (k.cmd) {
    case 'selectAll':
      v.setSelection(S.selectAll(L), {scroll: false});
      return true;
    case 'collapse':
      if (S.collapsed(v.sel)) return undefined;
      v.setSelection(S.caret(v.sel.head, v.sel.affinity));
      return true;
    case 'pageUp': case 'pageDown': {
      const w = v.win, d = k.cmd === 'pageDown' ? 1 : -1;
      const step = pageStep(v), z = v.zoom || 1;
      const sel = S.move(v.sel, L, k.cmd, k.extend, step / z);
      w.scrollTo(w.scrollX, Math.max(0, w.scrollY + d * step));
      v.setSelection(sel, {scroll: false});
      const c = v.caretRect(), vis = visible(v);
      if (c && (c.y < vis.y0 || c.y + c.h > vis.y1 || c.x < vis.x0 ||
        c.x > vis.x1)) v.scrollToCaret();
      return true;
    }
    case 'docHome': case 'docEnd': {
      // all the way: the page's top (or bottom) edge shows too
      const w = v.win;
      w.scrollTo(w.scrollX, k.cmd === 'docHome' ? 0 : w.extent.y1);
      v.setSelection(S.move(v.sel, L, k.cmd, k.extend));
      return true;
    }
    default:
      v.setSelection(S.move(v.sel, L, k.cmd, k.extend));
      return true;
  }
}

/** See the header: Edit > Next page / Previous page (./EditMenu). */
export function pageMove(v, cmd) {
  if (!v.sel || (cmd !== 'nextPage' && cmd !== 'prevPage')) {
    return false;
  }
  return move(v, {cmd, extend: false});
}
