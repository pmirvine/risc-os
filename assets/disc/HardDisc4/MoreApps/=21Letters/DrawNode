// DrawNode - reading DrawingML elements by namespace (pure; shared
// by ./PicRead and ./AnchorRead, Batch D P12.1).
//
//   is(n, m, uri, local)     element `n` (scope `m` inside it) is
//                            uri:local
//   kids(n, m) -> [[child, scope]...] | null (null: real text)
//   child([n, m], uri, local) -> [node, scope] | null   the ONE
//                            such child (null: none or repeated)
//   plain(n, local)          unprefixed attribute, or undefined
//   nsAttr([n, m], uri, local)  attribute uri:local: undefined
//                            absent, null repeated
//
// Elements are recognised by namespace URI and local name with the
// scope (./Ns), never by prefix.
import {scope, isEl, blank} from './Ns';

/** Element `n` (with `m` the scope inside it) is uri:local. */
export function is(n, m, uri, local) {
  const s = n.name;
  const i = s.indexOf(':');
  return s.slice(i + 1) === local &&
    m.get(i < 0 ? '' : s.slice(0, i)) === uri;
}

/** [[child, scope]...] of `n`, or null when it holds real text. */
export function kids(n, m) {
  const out = [];
  for (const c of n.children) {
    if (typeof c === 'string') {
      if (!blank(c)) return null;
    } else if (isEl(c)) {
      out.push([c, c.attrs.length ? scope(m, c) : m]);
    }
  }
  return out;
}

/** The one child uri:local of [n, m] as [node, scope], else null. */
export function child(e, uri, local) {
  const list = e && kids(e[0], e[1]);
  if (!list) return null;
  let hit = null;
  for (const k of list) {
    if (!is(k[0], k[1], uri, local)) continue;
    if (hit) return null;
    hit = k;
  }
  return hit;
}

/** The unprefixed attribute `local` of `n`, or undefined. */
export function plain(n, local) {
  for (const [k, v] of n.attrs) if (k === local) return v;
  return undefined;
}

/** Attribute uri:local of [n, m]: undefined absent, null repeated. */
export function nsAttr([n, m], uri, local) {
  let out;
  for (const [k, v] of n.attrs) {
    const i = k.indexOf(':');
    if (i <= 0 || k.slice(i + 1) !== local) continue;
    if (m.get(k.slice(0, i)) !== uri) continue;
    if (out !== undefined) return null;
    out = v;
  }
  return out;
}
