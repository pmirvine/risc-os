// SaveState - names and states for saving documents (pure: no
// desktop services).
//
//   untitledName(taken)  'Untitled', else 'Untitled 2', 'Untitled 3'
//                        ...: the first not in taken (names of the
//                        open untitled documents; case ignored)
//   safeLeaf(name)       a leaf name a file can have: the characters
//                        a RISC OS name cannot hold (spaces, . : * #
//                        $ & @ ^ % \ " | and control characters) left
//                        out; 'Untitled' if nothing is left. So the
//                        window 'Untitled 2' is saved as 'Untitled2'
//   leafOf(path)         the last part of a path ('Report')
//   dirOf(path)          its directory ('RAM::RamDisc0.$'), or null
//                        for a name with none (or a disc's root)
//   defaultDir(recent)   where to offer to save an untitled document:
//                        the directory of the first full path in
//                        recent (newest first), else HOME
//   HOME                 'ADFS::HardDisc4.$', the hard disc's root
//   suggestName(dw, dir = HOME, exists)  the Save box's name: the
//                        document's path, or for an untitled one
//                        dir.safeLeaf (a full path, so that OK works
//                        as well as dragging the icon); if exists(p)
//                        says that file is there, the next free one:
//                        dir.Untitled2, dir.Untitled3 ... (the
//                        digits at the end of the leaf counted on)
//   suggestName(dw, dir, exists, format)  the same for a document
//                        saved as format ('docx' | 'rtf': ./Open
//                        FILETYPES): a leaf ending in the other
//                        format's '/docx' or '/rtf' (any case) gets
//                        this one's ('Report/docx' -> 'Report/rtf');
//                        a leaf with neither is kept (the file type
//                        says what it is). No format: as above
//   A document imported from another kind of file (dw.importedFrom
//   its path, dw.path null: ./Open IMPORTERS) is offered beside it,
//   its leaf's '/odt', '/ott', '/doc', '/dot' or '/docx' (any case)
//   replaced by '/docx', added when it has none ('Report/odt',
//   'Report' -> 'Report/docx'), never the file it came from; if
//   that is there, 'Report2/docx', 'Report3/docx' ... (importName;
//   saved as RTF, the same with '/rtf': importName(from, dir,
//   exists, ext))
//   fileOf(path, imported) -> {path, imported, importedFrom}   a
//                        window's file (./AppWin): path, or for a
//                        document imported ('odt' | 'doc') from path,
//                        path null and importedFrom path

export const HOME = 'ADFS::HardDisc4.$';
const BASE = 'Untitled';
const BAD = /[\s.:*#$&@^%\\"|\x00-\x1f\x7f]/g;

/** See the header. */
export function untitledName(taken) {
  const used = new Set();
  for (const t of taken || []) {
    if (typeof t === 'string') used.add(t.toLowerCase());
  }
  if (!used.has(BASE.toLowerCase())) return BASE;
  for (let n = 2; ; n++) {
    const name = `${BASE} ${n}`;
    if (!used.has(name.toLowerCase())) return name;
  }
}

/** See the header. */
export function safeLeaf(name) {
  const s = typeof name === 'string' ? name.replace(BAD, '') : '';
  return s || BASE;
}

/** See the header. */
export function leafOf(path) {
  const s = String(path ?? '');
  return s.slice(Math.max(s.lastIndexOf('.'), s.lastIndexOf(':')) + 1);
}

/** See the header. */
export function dirOf(path) {
  if (typeof path !== 'string') return null;
  const i = path.lastIndexOf('.');
  if (i <= 0 || i < path.lastIndexOf(':')) return null;
  if (path.endsWith('$')) return null;
  return path.slice(0, i);
}

/** See the header. */
export function defaultDir(recent) {
  for (const p of recent || []) {
    const d = dirOf(p);
    if (d) return d;
  }
  return HOME;
}

/** See the header. */
export function suggestName(dw, dir = HOME, exists = () => false,
  format) {
  return withExt(suggested(dw, dir, exists, EXT[format]), format);
}

const EXT = {docx: '/docx', rtf: '/rtf'};

/** p with the extension of format, switched from the other's. */
function withExt(p, format) {
  const want = EXT[format];
  if (!want) return p;
  const i = Math.max(p.lastIndexOf('.'), p.lastIndexOf(':')) + 1;
  const leaf = p.slice(i), low = leaf.toLowerCase();
  for (const e of Object.values(EXT)) {
    if (e !== want && low.endsWith(e) && leaf.length > e.length) {
      return p.slice(0, i) + leaf.slice(0, -e.length) + want;
    }
  }
  return p;
}

/** See the header. */
export function fileOf(path, imported) {
  const from = imported && path ? path : null;
  return {path: from ? null : path || null,
    imported: from ? imported : null, importedFrom: from};
}

const OLD_EXT = /\/(odt|ott|doc|dot|docx)$/i;

/** See the header: the name offered for a document imported from
 *  the file at from. */
export function importName(from, dir = HOME, exists = () => false,
  ext = '/docx') {
  const d = dirOf(from) || dir, leaf = leafOf(from);
  const stem = safeLeaf(leaf.replace(OLD_EXT, '') || leaf);
  const low = String(from).toLowerCase();
  const there = (p) => {
    if (p.toLowerCase() === low) return true;
    try { return !!exists(p); } catch (e) { return false; }
  };
  const first = `${d}.${stem}${ext}`;
  if (!there(first)) return first;
  let k = stem.length;
  while (k > 0 && stem[k - 1] >= '0' && stem[k - 1] <= '9') k--;
  const base = stem.slice(0, k) || stem;
  for (let n = Math.max(2, +stem.slice(k) + 1 || 2); n < 100000;
    n++) {
    const p = `${d}.${base}${n}${ext}`;
    if (!there(p)) return p;
  }
  return first;
}

/** suggestName with no format. */
function suggested(dw, dir, exists, ext) {
  if (dw.path) return dw.path;
  if (dw.importedFrom) {
    return importName(dw.importedFrom, dir, exists, ext);
  }
  const leaf = safeLeaf(dw.leaf);
  const there = (p) => { try { return !!exists(p); } catch (e) {
    return false; } };
  if (!there(`${dir}.${leaf}`)) return `${dir}.${leaf}`;
  // the digits at the end, found by a loop (a lazy run before a
  // digit run backtracks in O(n^2))
  let k = leaf.length;
  while (k > 0 && leaf[k - 1] >= '0' && leaf[k - 1] <= '9') k--;
  const stem = leaf.slice(0, k) || leaf;
  for (let n = Math.max(2, +leaf.slice(k) + 1 || 2); n < 100000;
    n++) {
    const p = `${dir}.${stem}${n}`;
    if (!there(p)) return p;
  }
  return `${dir}.${leaf}`;
}
