// WinMenu - the menu of a document's window (./AppWin):
//
//   windowMenu(dw) -> a Menu (the keys shown: ./Keymap, Cmd+S on a
//   Mac: ./MacKeys macLabel; they work while the window has the
//   caret: ./DocKeys)
//     Save         Ctrl+S    save it (./DocSave save: an untitled
//                            document opens the Save as box)
//     Save as >    F3        the Save as box (./DocSave saveBox)
//     Revert                 load it again from its file (./CloseDoc;
//                            shaded for an untitled document)
//     Save a copy >          a Save box for a copy (./CopySave)
//     Info >                 what the document holds (./Info)
//     Edit >                 undo, redo, cut, copy, paste, select
//                            all, find, replace, Update field,
//                            Update all fields (then its one
//                            message: dw.fieldUpdate text, an
//                            information box), Word count...
//                            (./EditMenu, ./FieldUpdate, ./CountBox)
//     Insert >               Field..., page and column breaks,
//                            section breaks, Table..., Picture...,
//                            Symbol..., Special character >,
//                            Hyperlink..., Bookmark...: ./InsertMenu
//     View >                 Print layout, Web layout, Outline,
//                            Draft, Formatting marks, Ruler, Header
//                            and footer, field codes and shading
//                            (./ViewMenu, ./ViewMode)
//     Outline >              Expand, Collapse, Show level, Show first
//                            line only, Promote, Demote, Move up and
//                            down; shaded outside Outline view
//                            (./OutlineMenu, D32)
//     Header > / Footer >    only in the header and footer mode: the
//                            mode's menu (./HdrMenu, D14)
//     Footnote > / Endnote > only in the notes mode: next, previous,
//                            go to mark (./NoteMenu, Batch E2)
//     Format >               ./FormatMenu, with
//                            Paragraph... (./ParaBox), Tabs...
//                            (./TabsBox), Borders and shading...
//                            (./BorderBox), Picture... (./PicBox),
//                            Page setup... (./PageBox),
//                            Layout... (./LayoutBox), Columns...
//                            (./ColumnsBox); these three
//                            shaded in the header and footer mode
//                            and the notes mode (D14: no "apply
//                            to" from a story)
//                            and AutoFormat lists
//                            (./AutoFormatOpt)
//     Table >                insert a table, rows, columns, merge and
//                            split cells, select, distribute:
//                            ./TblMenu
//     Tools >                Show Comments, Delete comments in
//                            selection, User name and initials...
//                            (./ToolsMenu, Batch F1)
//     Zoom >                 50%..200%, Zoom in, Zoom out (./ZoomBind)
//     New          F2        a new, empty document (app.newDoc)
//     Close        Ctrl+F2   asks first if there are changes
//                            (./CloseDoc requestClose)
//
// The boxes are made once (./Boxes) and kept in dw.boxes ('saveas',
// 'copy', 'info' -> Window), which ./AppWin deletes with the
// document.
import {Menu, reportError} from 'riscos';
import {editMenu} from './EditMenu';
import {countBox} from './CountBox';
import {updateAll} from './FieldUpdate';
import {updateFieldAt} from './TocBox';
import {insertMenu} from './InsertMenu';
import {formatMenu} from './FormatMenu';
import {stylesWindow} from './StyleBox';
import {viewMenu} from './ViewMenu';
import {outlineMenu} from './OutlineMenu';
import {hdrMenu} from './HdrMenu';
import {noteMenu} from './NoteMenu';
import {isNote} from './NoteEdit';
import {tblMenu} from './TblMenu';
import {toolsMenu} from './ToolsMenu';
import {paraBox} from './ParaBox';
import {tabsBox} from './TabsBox';
import {borderBox} from './BorderBox';
import {picBox} from './PicBox';
import {pageBox} from './PageBox';
import {layoutBox} from './LayoutBox';
import {columnsBox} from './ColumnsBox';
import {listBox} from './ListBox';
import {autoListItem} from './AutoFormatOpt';
import {infoWindow} from './Info';
import {zoomMenu} from './ZoomBind';
import {box} from './Boxes';
import {save, saveBox} from './DocSave';
import {copyBox} from './CopySave';
import {requestClose, revert} from './CloseDoc';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';

/** Edit > Update all fields, then what it did said once. */
function updateAllSay(dw) {
  updateAll(dw);
  const u = dw.fieldUpdate;
  if (u && typeof u.text === 'string') {
    reportError(u.text, {appName: 'Letters', category: 'info'});
  }
}

/** See the header. */
export function windowMenu(dw) {
  const task = dw.app.task;
  const k = (id) => macLabel(keymap.labelFor(id), dw.view.mac);
  return new Menu('Letters', [
    {text: 'Save', key: k('save'), action: () => { save(dw); },
      help: 'Save this document in its file (the first time, ' +
        'the Save box asks where).'},
    {text: 'Save as', key: k('saveBox'), submenu: () => saveBox(dw),
      help: 'Save this document under another name: the window ' +
        'takes that name.'},
    {text: 'Revert', shaded: () => dw.isUntitled,
      action: () => { revert(dw); },
      help: 'Load this document again from its file, as it was ' +
        'last saved (changes are lost: it asks first).'},
    {text: 'Save a copy', submenu: () => copyBox(dw),
      help: 'Save a copy of this document as a Word .docx file: ' +
        'the window keeps its name and its changes.'},
    {text: 'Info', submenu: () => box(dw, 'info',
      () => infoWindow(task, dw.leaf, dw.doc)),
    help: 'What the document holds.'},
    {text: 'Edit', submenu: () => editMenu(dw.view,
      {count: () => countBox(dw), update: () => updateFieldAt(dw),
        updateAll: () => updateAllSay(dw)}),
    help: 'Undo, redo, cut, copy, paste, select all, find, replace, ' +
      'update fields and the word count.'},
    {text: 'Insert', submenu: () => insertMenu(dw),
      help: 'Put in a field, a page or column break, a section ' +
        'break, a table, a picture, a symbol, a special character, ' +
        'a hyperlink or a bookmark.'},
    {text: 'View', submenu: () => viewMenu(dw),
      help: 'Print layout, Web layout, Outline or Draft; formatting ' +
        'marks; the ruler; headers and footers; field codes.'},
    {text: 'Outline', shaded: () => dw.viewName !== 'outline',
      submenu: () => outlineMenu(dw),
      help: 'Outline view: expand or collapse headings, show a ' +
        'level, promote, demote and move paragraphs.'},
    ...(isNote(dw.view.hdr) ? [{text: dw.view.hdr.note.kind ===
      'endnote' ? 'Endnote' : 'Footnote', submenu: () => noteMenu(dw),
    help: 'The next or previous note; back to the text.'}]
      : dw.view.hdr ? [{text: dw.view.hdr.kind === 'hdr' ? 'Header'
        : 'Footer', submenu: () => hdrMenu(dw),
      help: 'Different first page, odd and even pages, link to the ' +
        'previous section, remove.'}] : []),
    {text: 'Format', submenu: () => formatMenu(dw.view, {
      paragraph: () => paraBox(dw), tabs: () => tabsBox(dw),
      borders: () => borderBox(dw), picture: () => picBox(dw),
      pageSetup: dw.view.hdr ? null : () => pageBox(dw),
      layout: dw.view.hdr ? null : () => layoutBox(dw),
      columns: dw.view.hdr ? null : () => columnsBox(dw),
      listValue: () => listBox(dw), autoList: autoListItem(dw.app),
      styles: () => stylesWindow(dw)}),
    help: 'Bold, italic, font, size, colour, alignment, ' +
      'paragraph styles.'},
    {text: 'Table', submenu: () => tblMenu(dw),
      help: 'Put in a table; add, remove, merge and split its rows, ' +
        'columns and cells.'},
    {text: 'Tools', submenu: () => toolsMenu(dw),
      help: 'The Comments pane; your name and initials for new ' +
        'comments.'},
    {text: 'Zoom', submenu: () => zoomMenu(dw),
      help: 'Show the page larger or smaller (CTRL with the wheel ' +
        'does it too).'},
    {text: 'New', key: k('new'), action: () => { dw.app.newDoc(); },
      help: 'Make a new, empty document in a window of its own.'},
    {text: 'Close', key: k('close'),
      action: () => { requestClose(dw); },
      help: 'Close this document (if it has changes, it asks ' +
        'whether to save them first).'},
  ]);
}
