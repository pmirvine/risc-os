// RevWrite - runs tagged with a revision (run.rev: ./RevRead) written
// back inside their w:ins, w:del, w:moveFrom or w:moveTo, for
// ./WritePara (Batch F2).
//
//   wrap(runs, emit) -> nodes   emit(run) -> the nodes of one run (its
//     w:r elements and the level 'p' inlines in it), in order. Each
//     longest stretch of runs of one revision (./Kinds sameRev) goes
//     inside one element (revNode); untagged runs' nodes are as
//     emitted
//   revNode(rev, kids) -> the element of rev's kind: its attributes
//     rev.attrs in their order, those named id, author and date (any
//     prefix: ./RevRead reads no other) holding the tag's id, author
//     and date (one whose value the tag no longer has is left out),
//     and w:id, w:author, w:date after them for any missing that the
//     tag has (a tag made by editing has no attrs; one read without
//     an author or date gets none); children kids then rev.extra
//   textName(run) -> 'w:delText' in deleted text (a 'del' tag),
//     else 'w:t': as Word writes them, the old place of a move in
//     w:t too (Word will not open a w:moveFrom holding w:delText)
//
// An untouched revision is so written exactly as read.
// Pure: no desktop services.
import {sameRev} from './Kinds';

const ELEMENT = {ins: 'w:ins', del: 'w:del', mvFrom: 'w:moveFrom',
  mvTo: 'w:moveTo'};

/** See the header. */
export const textName = (run) => (run && run.rev &&
  run.rev.kind === 'del' ? 'w:delText' : 'w:t');

/** See the header. */
export function revNode(rev, kids) {
  const val = {id: String(rev.id), author: rev.author,
    date: rev.date};
  const seen = new Set();
  const attrs = [];
  for (const [n, v] of rev.attrs || []) {
    const l = n.slice(n.indexOf(':') + 1);
    if (!Object.hasOwn(val, l)) attrs.push([n, v]);
    else if (val[l] !== undefined) attrs.push([n, val[l]]);
    seen.add(l);
  }
  for (const l of ['id', 'author', 'date']) {
    if (!seen.has(l) && val[l] !== undefined)
      attrs.push(['w:' + l, val[l]]);
  }
  return {name: ELEMENT[rev.kind], attrs,
    children: kids.concat(rev.extra || [])};
}

/** See the header. */
export function wrap(runs, emit) {
  const out = [];
  for (let k = 0; k < runs.length;) {
    const rev = runs[k].rev;
    if (!rev) {
      out.push(...emit(runs[k++]));
      continue;
    }
    const kids = [];
    while (k < runs.length && runs[k].rev &&
      sameRev(runs[k].rev, rev)) kids.push(...emit(runs[k++]));
    out.push(revNode(rev, kids));
  }
  return out;
}
