// TblNames - the value forms and name lists shared by the table
// property reader (./TblProps) and writer (./TblWriteProps): one
// rule for both, so a field written reads back equal. Pure; imports
// nothing.

/** A percentage width as some files write it ("50%", "12.5%"). */
export const WIDTH_PCT = /^\d{1,3}(\.\d+)?%$/;
/** A width's w:type. */
export const WIDTH_TYPES = ['dxa', 'pct', 'auto', 'nil'];
/** A string field's value (jc, tblStyle...): 1..253 characters,
 * no control characters. */
export const STR = /^[^\u0000-\u001f\u007f]{1,253}$/;
/** tblLook's w:val: four hex digits. */
export const HEX4 = /^[0-9A-Fa-f]{4}$/;
/** The margin sides (tblCellMar, tcMar), in schema order. */
export const MAR = ['top', 'left', 'bottom', 'right'];
/** tblLook's flags, in the order Word writes them. */
export const LOOK = ['firstRow', 'lastRow', 'firstColumn', 'lastColumn',
  'noHBand', 'noVBand'];
/** tblBorders' sides in schema order. */
export const SIDES6 = ['top', 'left', 'bottom', 'right', 'insideH',
  'insideV'];
/** tcBorders' sides in schema order. */
export const SIDES8 = [...SIDES6, 'tl2br', 'tr2bl'];
/** trHeight's w:hRule values. */
export const H_RULES = ['auto', 'atLeast', 'exact'];
