// OdtPict - the pictures of an OpenDocument text (OpenDocument 1.3
// part 3, 10.4 <draw:frame>, 10.4.4 <draw:image>) for ./OdtRead,
// through the builder's b.picture (./ImpPict).
//
//   PART  {elements: draw:frame, draw:a (read through), and the
//       drawing shapes}; frame(ctx, node), SHAPES, SHAPE_NOTE for
//       ./OdtBoxes
//   hrefName(href) -> entry name | null  a package-internal path:
//       './Pictures/a%20b.png' -> 'Pictures/a b.png'. A URL or drive
//       (anything with a ':' before its first '/'), an absolute
//       path, a back slash, a '..' step, '#...' or an empty one is
//       null: it is never fetched, nor read outside the zip
//   fromBase64(text, max) -> Uint8Array | null  never more than max
//       bytes, and the length is checked before any decoding
//
// A frame is read as ONE inline picture in the paragraph it sits in
// (as-char, paragraph, page and frame anchors alike; a frame between
// paragraphs gets a paragraph of its own). Its draw:image comes from
// the zip entry xlink:href names, or from inline office:binary-data
// (base64): the type is the bytes' (./RtfPict kindOf), at most
// MAX_PICTURE bytes each and MAX_PICTURES / MAX_TOTAL bytes in all
// (SVG and other types: a note once per kind, skipped). Size:
// svg:width / svg:height (cm mm in pt pc px) over EMU, together
// scaled down to 22 inches at most; either missing, not a length or
// not above 0: the picture's own size (a note). svg:desc (else
// svg:title) is the alt text, draw:name the name.
// A frame holding a text box, an embedded object, a plug-in...,
// and any drawing shape or group: skipped with ONE note per kind
// (but ./OdtBoxes, after this in ./OdtRead PARTS, reads the text of
// text boxes and shapes). A frame with both an object and an image
// is an object.
// Pure: no desktop services.
import {kindOf, MAX_PICTURE, MAX_PICTURES, MAX_TOTAL}
  from './RtfPict';
import {first, attr, textOf} from './OdtXml';
import {points} from './OdtUnits';
import {fmtNow} from './OdtBody';
import {touch} from './OdtSect';

const EMU_PT = 12700, MAX_EMU = 22 * 914400;
const SKIPS = new Map([
  ['draw:text-box', 'text boxes are skipped'],
  ['draw:object', 'embedded objects are skipped'],
  ['draw:object-ole', 'embedded objects are skipped'],
  ['draw:plugin', 'plug-ins and media are skipped'],
  ['draw:applet', 'plug-ins and media are skipped'],
  ['draw:floating-frame', 'plug-ins and media are skipped'],
  ['draw:g', 'drawing groups are skipped']]);
export const SHAPES = ['draw:custom-shape', 'draw:line', 'draw:rect',
  'draw:ellipse', 'draw:circle', 'draw:polygon', 'draw:polyline',
  'draw:path', 'draw:connector', 'draw:caption', 'draw:measure',
  'draw:control', 'dr3d:scene'];
export const SHAPE_NOTE = 'drawing shapes and lines are skipped';

/** See the header. */
export function hrefName(href) {
  if (typeof href !== 'string' || !href || href.length > 1024) {
    return null;
  }
  let s;
  try {
    s = decodeURIComponent(href);
  } catch (e) {
    return null;
  }
  if (s.includes('\\') || s.includes('\u0000') || s[0] === '/' ||
    s[0] === '#') return null;
  const colon = s.indexOf(':'), slash = s.indexOf('/');
  if (colon >= 0 && (slash < 0 || colon < slash)) return null;
  const out = [];
  for (const part of s.split('/')) {
    if (part === '..') return null;
    if (part !== '.' && part !== '') out.push(part);
  }
  return out.length ? out.join('/') : null;
}

const B64 = new Int8Array(128).fill(-1);
for (const [i, c] of [...'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopq' +
  'rstuvwxyz0123456789+/'].entries()) B64[c.charCodeAt(0)] = i;

/** See the header. */
export function fromBase64(text, max) {
  // (a little over 4/3 for the line ends)
  if (typeof text !== 'string' || text.length > max * 1.4 + 100) {
    return null;
  }
  const out = new Uint8Array(Math.ceil(text.length * 3 / 4));
  let n = 0, acc = 0, bits = 0;
  for (let i = 0; i < text.length; i++) {
    const c = text.charCodeAt(i);
    if (c === 61 || c === 32 || c === 10 || c === 13 || c === 9) {
      continue;
    }
    const v = c < 128 ? B64[c] : -1;
    if (v < 0) return null;
    acc = acc << 6 | v;
    bits += 6;
    if (bits >= 8) {
      bits -= 8;
      out[n++] = acc >> bits & 255;
      acc &= (1 << bits) - 1;
      if (n > max) return null;
    }
  }
  return out.subarray(0, n);
}

const state = (ctx) => ctx.pict || (ctx.pict = {made: 0, total: 0,
  size: false});

/** The bytes of a draw:image, or null (a note says why). */
function bytesOf(ctx, img) {
  const bin = first(img, 'office:binary-data');
  if (bin) {
    const text = textOf(bin);
    const got = fromBase64(text, MAX_PICTURE);
    if (!got) {
      ctx.note('a picture larger than ' + (MAX_PICTURE >> 20) +
        ' MB, or not valid base64, is skipped');
    }
    return got;
  }
  const raw = attr(img, 'xlink:href');
  const name = hrefName(raw);
  const bytes = name && ctx.files.get(name);
  if (bytes) return bytes;
  ctx.note(name ? 'a picture the file does not contain is skipped'
    : 'a picture that is not inside the file is skipped');
  return null;
}

/** The size in EMU of the frame, or {} (a note). */
function sizeOf(ctx, frame) {
  const pt = (n) => points(attr(frame, n));
  let cx = pt('svg:width'), cy = pt('svg:height');
  if (!(cx > 0) || !(cy > 0)) {
    ctx.note('a picture with no usable size is shown at its own size');
    return {};
  }
  cx *= EMU_PT;
  cy *= EMU_PT;
  const f = Math.min(1, MAX_EMU / Math.max(cx, cy));
  return {cx: Math.max(1, Math.round(cx * f)),
    cy: Math.max(1, Math.round(cy * f))};
}

/** The type of bytes kindOf does not know, as a note. */
function unknownKind(bytes) {
  let i = 0;
  while (i < bytes.length && bytes[i] <= 32) i++;
  return bytes[i] === 0x3c
    ? 'a picture in SVG format is skipped: it cannot be converted'
    : 'a picture in a format !Letters does not recognise is skipped';
}

function picture(ctx, frame, img) {
  const P = state(ctx);
  if (P.made >= MAX_PICTURES) {
    return ctx.note('more than ' + MAX_PICTURES + ' pictures or ' +
      (MAX_TOTAL >> 20) + ' MB of them: the rest are skipped');
  }
  const bytes = bytesOf(ctx, img);
  if (!bytes) return;
  if (!kindOf(bytes)) return ctx.note(unknownKind(bytes));
  if (P.total + bytes.length > MAX_TOTAL) {
    P.made = MAX_PICTURES;
    return ctx.note('more than ' + MAX_PICTURES + ' pictures or ' +
      (MAX_TOTAL >> 20) + ' MB of them: the rest are skipped');
  }
  const text = (n) => {
    const e = first(frame, n);
    return e ? textOf(e).trim() : undefined;
  };
  const inline = ctx.b.picture(bytes, {...sizeOf(ctx, frame),
    name: attr(frame, 'draw:name'),
    alt: text('svg:desc') || text('svg:title')});
  if (!inline) return;
  P.made++;
  P.total += bytes.length;
  if (ctx.para) return ctx.b.obj(inline, fmtNow(ctx));
  ctx.b.obj(inline);
  ctx.b.endPara({});
  if (ctx.b.stopped) ctx.stop = true;
}

/** A draw:frame (see the header). */
export function frame(ctx, node) {
  const els = node.children.filter((c) => typeof c !== 'string');
  const skip = els.find((c) => SKIPS.has(c.name));
  if (skip) return ctx.note(SKIPS.get(skip.name));
  const img = els.find((c) => c.name === 'draw:image');
  if (!img) return;
  if (!ctx.para) touch(ctx);
  picture(ctx, node, img);
}

const shape = (ctx) => ctx.note(SHAPE_NOTE);
export const PART = {elements: new Map([['draw:frame', frame],
  ['draw:a', (ctx, node) => ctx.walk(node)],
  ...[...SKIPS.keys()].map((k) => [k, (ctx) => ctx.note(SKIPS.get(k))]),
  ...SHAPES.map((k) => [k, shape])])};
