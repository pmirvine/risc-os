// Find - finding text in a document and replacing it (the Find box:
// ./EditFind).
//
//   search(doc, from, needle, {matchCase, whole, backwards, wrap})
//     -> {at, from, to, inInline, wrapped} | null
//   count(doc, needle, opts) -> the number of matches
//   replaceOne(d, match, repl) -> {at, from, to} (the text put in) |
//                         null (an inline in it, or gone)
//   replaceAll(d, needle, repl, opts) -> {count, skipped, last}
//                         last: {at, from, to} of the last text put
//                         in (null when none)
//   fold, prepare, MAX    from ./FindText
//
// from is {at, off}: a block's path (./Path), offset off in its text
// (a table's path: off 0 its start edge, before its cells; off 1 its
// end edge, after them); anything else is the document's start. The
// search goes through the paragraphs in flow order (D9: a table's
// cells row by row, cell by cell, nested tables entered; Batch C3.5)
// and a match is at its paragraph's path.
// Forwards: the first match starting at or after it; backwards
// (backwards: true): the last one ending at or before it. With wrap
// a search that reaches the end (start) goes on from the start
// (end) of the document: the match says wrapped. A match is in one
// paragraph (never across two); kept blocks (Opaque tables) are
// passed over. at says where it is, from and to its offsets in the
// text; what matches (case, whole words, inline items, grapheme
// clusters) is ./FindText's. A match with an inline item in it
// (inInline: link text) can be selected but is never replaced
// (replaceAll counts it in skipped). The needle is literal (no
// wildcards); an empty one finds nothing. count and replaceAll
// take the matches first to last, none overlapping.
//
// The replacement is plain text (./Edit clean: control characters
// and U+FFFC dropped, CR LF is LF): a new line (LF) in it is a line
// break in the paragraph (the LF that SHIFT-RETURN types), a tab a
// tab. It takes the format of the first character it replaces.
// replaceOne and replaceAll are each one undo step (d.atomic);
// replaceAll changes each paragraph once (one spliceText), in one
// pass over the paragraphs found first: text put in is never
// searched again. Pure: no desktop services.
import {cut, join} from './OpsUtil';
import {isPath, cmpPath, samePath, topOf} from './Path';
import {at as walkAt, forEachIn, forEachBlock} from './Walk';
import {fmtAt} from './OpsText';
import {clean} from './Edit';
import {view, shownAt, inPara, matches, needleOf, OBJ}
  from './FindText';

export {fold, prepare, MAX} from './FindText';

/** The paragraphs of top-level block b at path top in flow order:
 *  [{p, at}] (a typed table's cells' paragraphs, nested ones too). */
function parasOf(b, top) {
  if (b.type === 'p') return [{p: b, at: top}];
  const out = [];
  if (b.type !== 'tbl') return out;
  forEachIn([b], [top[0]], (x, at) => {
    if (x.type === 'p') out.push({p: x, at: [...top, ...at.slice(2)]});
  });
  return out;
}

/** Search the paragraphs from place f to one end of the document
 *  (f null: from the start, backwards the end). */
function scan(doc, f, n, o) {
  const secs = doc.sections, d = o.backwards ? -1 : 1;
  const top = f ? topOf(f.at) : null;
  let sec = top ? top[0] : d > 0 ? 0 : secs.length - 1;
  let k = top ? top[1] : null;
  for (; sec >= 0 && sec < secs.length; sec += d, k = null) {
    const bs = secs[sec].blocks;
    if (k === null) k = d > 0 ? 0 : bs.length - 1;
    for (; k >= 0 && k < bs.length; k += d) {
      const ps = parasOf(bs[k], [sec, k]);
      for (let j = d > 0 ? 0 : ps.length - 1; j >= 0 && j < ps.length;
        j += d) {
        const {p, at} = ps[j];
        if (f && !ahead(f, at, d)) continue;
        const v = view(p), len = v.text.length;
        const lim = f && samePath(at, f.at) ? shownAt(v, f.off) : null;
        const m = d > 0 ? inPara(p, n, o, lim ?? 0, len, at)
          : inPara(p, n, o, 0, lim ?? len, at);
        if (m) return m;
      }
    }
  }
  return null;
}

/** Whether paragraph path at is at or past place f going d: a
 *  table's cells are past its start edge (off 0) and before its end
 *  edge (off 1). */
function ahead(f, at, d) {
  const c = cmpPath(at, f.at);
  if (c === 0) return true;
  const inT = at.length > f.at.length &&
    samePath(at.slice(0, f.at.length), f.at);
  if (inT) return d > 0 ? f.off === 0 : f.off === 1;
  return d > 0 ? c > 0 : c < 0;
}

/** from as a place {at, off} in doc, or null (the start). */
function placeOf(doc, from) {
  const at = from && from.at;
  if (!isPath(at) || !walkAt(doc, at)) return null;
  return {at, off: Number.isInteger(from.off) && from.off > 0
    ? from.off : 0};
}

/** See the header. */
export function search(doc, from, needle, opts = {}) {
  const o = {...opts}, n = needleOf(needle, o);
  if (!n || !doc.sections.length) return null;
  const m = scan(doc, placeOf(doc, from), n, o);
  if (m || !o.wrap) return m ? {...m, wrapped: false} : null;
  const w = scan(doc, null, n, o);
  return w ? {...w, wrapped: true} : null;
}

/** Every paragraph in flow order: [{p, at}]. */
function allParas(doc) {
  const out = [];
  forEachBlock(doc, (b, at) => {
    if (b.type === 'p') out.push({p: b, at});
  });
  return out;
}

/** See the header. */
export function count(doc, needle, opts = {}) {
  const o = {...opts, backwards: false}, n = needleOf(needle, o);
  let c = 0;
  if (!n) return 0;
  for (const {p, at} of allParas(doc)) {
    for (const m of matches(p, n, o, at)) c++;
  }
  return c;
}

/** The replacement as content formatted as p's character at. */
function piece(p, at, del, text) {
  const f = fmtAt(p, at, del);
  return {text, inlines: {},
    runs: text ? [{start: 0, end: text.length, ...f}] : []};
}

/** See the header. */
export function replaceOne(d, m, repl) {
  const b = m && isPath(m.at) && walkAt(d.doc, m.at);
  if (!b || b.type !== 'p' || !(m.from >= 0) || !(m.to > m.from) ||
    m.to > b.text.length || b.text.slice(m.from, m.to).includes(OBJ))
    return null;
  const text = clean(repl);
  d.atomic(() => d.apply({op: 'spliceText', block: m.at,
    at: m.from, del: m.to - m.from,
    content: piece(b, m.from, m.to - m.from, text)}));
  return {at: m.at, from: m.from, to: m.from + text.length};
}

/** See the header. */
export function replaceAll(d, needle, repl, opts = {}) {
  const o = {...opts, backwards: false}, n = needleOf(needle, o);
  const text = clean(repl);
  let c = 0, skipped = 0, last = null;
  if (!n) return {count: c, skipped, last};
  d.atomic(() => {
    for (const {p, at: path} of allParas(d.doc)) {
      const parts = [];
      let at = -1, pos = 0;
      for (const m of matches(p, n, o, path)) {
        if (m.inInline) { skipped++; continue; }
        if (at < 0) at = pos = m.from;
        parts.push(cut(p, pos, m.from),
          piece(p, m.from, m.to - m.from, text));
        pos = m.to;
        c++;
      }
      if (at < 0) continue;
      const content = join(...parts), end = at + content.text.length;
      d.apply({op: 'spliceText', block: path, at, del: pos - at,
        content});
      last = {at: path, from: end - text.length, to: end};
    }
  });
  return {count: c, skipped, last};
}
