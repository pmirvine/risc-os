// TblConflict - the border drawn where two table cells meet (D22,
// ECMA-376 17.4.66): the one rule ./TblBorders uses. Pure.
//
//   weightOf(side) -> sz (eighths of a point, an integer clamped
//     2..96, else 4) x the style's lines (2: double and the thinThick
//     / thickThin families; 3: triple; else 1); 0 for nil, none or
//     no side (a side: {val, sz, color...} as the readers give it)
//   conflict(a, b) -> side | null  where a (the cell above / to the
//     left) meets b: the heavier; then the style earlier in
//     PRECEDENCE (a style not in it after all); then the darker
//     colour (smaller R + B + 2G; auto, none or bad: black); then a.
//     nil / none lose to any border; neither drawn: null
//   drawn(side)  a side that draws a line (a good val, not nil /
//     none); norm(side) -> side when drawn, else null
//   PRECEDENCE  D22's list of styles (frozen)
import {NAME} from './ReadPropsMore';

export const PRECEDENCE = Object.freeze(['single', 'thick', 'double',
  'dotted', 'dashed', 'dotDash', 'dotDotDash', 'triple',
  'thinThickSmallGap', 'thickThinSmallGap', 'thinThickThinSmallGap',
  'thinThickMediumGap', 'thickThinMediumGap',
  'thinThickThinMediumGap', 'thinThickLargeGap', 'thickThinLargeGap',
  'thinThickThinLargeGap', 'wave', 'doubleWave', 'dashSmallGap',
  'dashDotStroked', 'threeDEmboss', 'threeDEngrave', 'outset',
  'inset']);
const RANK = new Map(PRECEDENCE.map((v, n) => [v, n]));
const isObj = (v) => v !== null && typeof v === 'object';
/** See the header. */
export const drawn = (s) => isObj(s) && typeof s.val === 'string' &&
  NAME.test(s.val) && s.val !== 'nil' && s.val !== 'none';
/** See the header. */
export const norm = (s) => (drawn(s) ? s : null);
const lines = (v) => (v === 'double' ? 2 : v === 'triple' ? 3
  : /^(thinThick|thickThin)/.test(v) ? 2 : 1);
const HEX6 = /^[0-9A-Fa-f]{6}$/;

/** See the header. */
export function weightOf(s) {
  if (!drawn(s)) return 0;
  const sz = Number.isInteger(s.sz) ? Math.min(Math.max(s.sz, 2), 96)
    : 4;
  return sz * lines(s.val);
}

/** R + B + 2G of a side's colour (auto, none or bad: black, 0). */
function shade(s) {
  if (typeof s.color !== 'string' || !HEX6.test(s.color)) return 0;
  const n = parseInt(s.color, 16);
  return (n >> 16) + (n & 255) + 2 * ((n >> 8) & 255);
}

/** See the header. */
export function conflict(a, b) {
  const da = drawn(a), db = drawn(b);
  if (!da || !db) return da ? a : db ? b : null;
  const wa = weightOf(a), wb = weightOf(b);
  if (wa !== wb) return wa > wb ? a : b;
  const ra = RANK.get(a.val) ?? RANK.size;
  const rb = RANK.get(b.val) ?? RANK.size;
  if (ra !== rb) return ra < rb ? a : b;
  return shade(b) < shade(a) ? b : a;
}
