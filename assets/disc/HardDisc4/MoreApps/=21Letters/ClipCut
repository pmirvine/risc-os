// ClipCut - the part of a typed table a copy takes (Batch C, C6.1,
// D28), for ./ClipSlice: still the document's own objects (ids and
// all, nothing changed in place); ClipSlice then makes a clipboard
// block of it.
//
//   cutRows(t, r0, r1) -> Table  rows r0..r1 (INCLUSIVE) of t, as a
//       'mixed' selection takes them (./SelShape): t itself when that
//       is every row; else a new table with a NEW grid array (equal
//       values), the rows themselves (their leads and tails), the
//       table's tail only with its last row, and every vMerge
//       continue cell that no longer has its merge above (the first
//       row's: its restart is not copied) written restart (./TblNorm
//       unstray: the one rule). RangeError for rows not in t.
//   cutRect(t, {r0, r1, c0, c1}) -> Table | null  the rectangle of
//       rows r0..r1 and grid columns c0..c1 (INCLUSIVE, ./SelShape's
//       'cells' shape): cutRows, then the grid columns outside it
//       gone by ./TblEditCols deleteCols (the one rule for that: a
//       span crossing an edge is cut and a dxa tcW loses the columns
//       cut off, gridBefore / gridAfter shrink, a dxa tblW shrinks,
//       the grid is the rectangle's columns; the bookmark marks of
//       what goes whose partner stays move into what stays, so no
//       pair is broken). null when no cell is left (a rectangle
//       wholly in rows' gridBefore / gridAfter). RangeError for
//       rows or columns not in t.
// ./SelShape grows a 'cells' rectangle until no merged cell crosses
// its edge, so a copy never cuts a merge in practice; these cut any
// rectangle they are given (the tests give them crossing ones).
// Pure: no desktop services.
import {gridOf} from './TblGrid';
import {unstray} from './TblNorm';
import {deleteCols} from './TblEditCols';
import {checkCols} from './TblEditDist';

/** See the header. */
export function cutRows(t, r0, r1) {
  const n = t.rows.length;
  if (!Number.isInteger(r0) || !Number.isInteger(r1) || r0 < 0 ||
    r1 < r0 || r1 >= n) throw new RangeError('no such rows');
  if (r0 === 0 && r1 === n - 1) return t;
  return unstray({...t, grid: [...t.grid], rows: t.rows.slice(r0,
    r1 + 1), tail: r1 === n - 1 ? t.tail : []});
}

/** See the header. */
export function cutRect(t, {r0, r1, c0, c1} = {}) {
  checkCols(gridOf(t), c0, c1);
  let u = cutRows(t, r0, r1);
  if (u === t) u = {...t, grid: [...t.grid]};
  const cols = gridOf(u).cols;
  if (c0 >= cols) return null;
  if (c1 + 1 < cols) {
    u = deleteCols(u, null, {c0: c1 + 1, c1: cols - 1});
  }
  if (u && c0 > 0) u = deleteCols(u, null, {c0: 0, c1: c0 - 1});
  return u;
}
