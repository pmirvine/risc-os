// StarterList - the starter templates File > New from template
// offers, in one table. Nothing is built until a starter is chosen.
//
//   STARTERS   [{id, group, title, help, build: () => Doc}]
//   GROUPS     the group names, in menu order
//   starterOf(id) -> the entry, or undefined
//   openResult(id) -> {doc, format: 'docx', imported: 'template',
//     notes: []}   the shape ./Open openDoc gives for a template, so
//     the window code needs no new case; undefined for an unknown id
//   openChecked(id, say) -> that plus title, or null after say(...)
//     when the id is unknown or building throws
import {businessLetter} from './StartersLetters';
import {cvSimple, cvTwoColumn} from './StartersCareers';
import {report, essay, proposal} from './StartersReports';
import {invoice, agenda, minutes} from './StartersBusiness';
import {pressRelease, newsletter, flyer}
  from './StartersBusiness2';
import {personalLetter, coverLetter, memo, faxCover}
  from './StartersLetters2';

export const GROUPS = ['Letters', 'Careers', 'Reports', 'Business'];

export const STARTERS = [
  {id: 'business-letter', group: 'Letters', title: 'Business letter',
    help: 'A formal letter with sender, recipient and subject.',
    build: businessLetter},
  {id: 'personal-letter', group: 'Letters', title: 'Personal letter',
    help: 'A friendly letter with your address and a warm close.',
    build: personalLetter},
  {id: 'cover-letter', group: 'Letters', title: 'Cover letter',
    help: 'A letter to go with a job application.',
    build: coverLetter},
  {id: 'memo', group: 'Letters', title: 'Memo',
    help: 'An internal note with To, From, Date and Subject.',
    build: memo},
  {id: 'fax-cover', group: 'Letters', title: 'Fax cover sheet',
    help: 'A fax front page with recipient details and a message box.',
    build: faxCover},
  {id: 'cv-simple', group: 'Careers', title: 'CV (simple)',
    help: 'A one-column CV with ruled section headings.',
    build: cvSimple},
  {id: 'cv-two-column', group: 'Careers', title: 'CV (two column)',
    help: 'A CV with a shaded side column for contact and skills.',
    build: cvTwoColumn},
  {id: 'report', group: 'Reports', title: 'Report',
    help: 'A report with cover, contents, sections and page numbers.',
    build: report},
  {id: 'essay', group: 'Reports', title: 'Essay',
    help: 'A double-spaced essay with a running header and references.',
    build: essay},
  {id: 'proposal', group: 'Reports', title: 'Project proposal',
    help: 'A proposal with objectives, timeline and budget tables.',
    build: proposal},
  {id: 'invoice', group: 'Business', title: 'Invoice',
    help: 'An invoice with items, totals, VAT and bank details.',
    build: invoice},
  {id: 'agenda', group: 'Business', title: 'Meeting agenda',
    help: 'A meeting agenda with a numbered table of items.',
    build: agenda},
  {id: 'minutes', group: 'Business', title: 'Meeting minutes',
    help: 'Meeting minutes with items discussed and an actions table.',
    build: minutes},
  {id: 'press-release', group: 'Business', title: 'Press release',
    help: 'A press release with dateline, quotation and contact.',
    build: pressRelease},
  {id: 'newsletter', group: 'Business', title: 'Newsletter',
    help: 'A newsletter with a masthead and two-column articles.',
    build: newsletter},
  {id: 'flyer', group: 'Business', title: 'Flyer',
    help: 'A one-page flyer for an event or offer.',
    build: flyer},
];

/** See the header. */
export const starterOf = (id) => STARTERS.find((s) => s.id === id);

/** See the header. */
export function openResult(id) {
  const s = starterOf(id);
  return s && {doc: s.build(), format: 'docx', imported: 'template',
    notes: []};
}

/** The result of openResult(id) with the title, for opening: null
 *  (after say(message)) when the id is unknown or building throws. */
export function openChecked(id, say) {
  try {
    const got = openResult(id);
    if (!got) throw new Error(`no starter '${id}'`);
    return {...got, title: starterOf(id).title};
  } catch (e) {
    say(`The starter could not be made: ${e && e.message || e}`);
    return null;
  }
}
