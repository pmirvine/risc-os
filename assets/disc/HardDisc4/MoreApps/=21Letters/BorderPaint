// BorderPaint - draws a paragraph's part of its border box
// (./BorderGroups mark) on a canvas 2D context: the shading first
// (under the text), the edges after it.
//
//   geometry(m, it, prev, left) -> {fill, edges}  in work-area px:
//       fill {x, y, w, h, colour} or null; edges [{side, style, lw,
//       colour, x, y, w, h}] (top, between, bottom across; left,
//       right down). it: the laid-out item (./DocStack), prev: the
//       item above it (for a box it shares), left: the column's x
//   paintFill(g, m, it, prev, left)       the shading
//   paintEdges(g, m, it, prev, left, rect) the edges (cut to rect's
//       rows, so a long side costs only what is seen)
//   edge(g, e, rect?)  one edge: single and thick a solid bar, double
//       two bars lw thick with lw between, dotted lw squares every
//       2 lw, dashed bars 3 lw long every 5 lw (along the edge)
//
// Where things are (textTop / textBottom: the top of the first line
// and the bottom of the last): the top edge is space above textTop,
// t thick (between likewise, for a paragraph sharing the box with
// the one above); the bottom edge space below textBottom; the left
// edge at inL - space - t, the right at inR + space, from the top
// edge's top (or, sharing the box above, from where the box went
// on) to the bottom edge's bottom (or, sharing it below, to the end
// of the item's gap below). The shading fills inside the edges: from
// the top edge (else textTop: not the space before), to the bottom
// edge (else textBottom: not the space after), and right through
// the space between paragraphs that share a box; across from inL
// (less the left edge's space when there is one) to inR (plus the
// right edge's). Pure: draws on the context it is given.

/** See the header. */
export function geometry(m, it, prev, left) {
  const ls = it.lines;
  const last = ls[ls.length - 1];
  const tTop = it.y + ls[0].y, tBot = it.y + last.y + last.h;
  const xl = left + m.inL, xr = left + m.inR;
  const L = m.left, R = m.right, T = m.top, B = m.bottom;
  const lo = L ? xl - L.space - L.t : xl;
  const ro = R ? xr + R.space + R.t : xr;
  const prevEnd = prev ? prev.y + prev.h + prev.gapBelow : it.y;
  const end = it.y + it.h + it.gapBelow;
  const fTop = m.joinAbove ? Math.min(prevEnd, tTop - m.padTop)
    : T ? tTop - T.space : tTop;
  const fBot = m.joinBelow ? end : B ? tBot + B.space : tBot;
  const vTop = !m.joinAbove && T ? fTop - T.t : fTop;
  const vBot = !m.joinBelow && B ? fBot + B.t : fBot;
  const edges = [];
  const across = (side, e, y) => edges.push({side, style: e.style,
    lw: e.lw, colour: e.color, x: lo, y, w: ro - lo, h: e.t});
  const down = (side, e, x) => edges.push({side, style: e.style,
    lw: e.lw, colour: e.color, x, y: vTop, w: e.t, h: vBot - vTop});
  if (T) across('top', T, tTop - T.space - T.t);
  if (m.between) {
    across('between', m.between, tTop - m.between.space -
      m.between.t);
  }
  if (B) across('bottom', B, tBot + B.space);
  if (L) down('left', L, lo);
  if (R) down('right', R, xr + R.space);
  const fx0 = L ? xl - L.space : xl, fx1 = R ? xr + R.space : xr;
  const fill = m.fill && fBot > fTop && fx1 > fx0
    ? {x: fx0, y: fTop, w: fx1 - fx0, h: fBot - fTop, colour: m.fill}
    : null;
  return {fill, edges};
}

const R = Math.round;

/** See the header. */
export function paintFill(g, m, it, prev, left) {
  if (!m.fill) return;
  const f = geometry(m, it, prev, left).fill;
  if (!f) return;
  g.fillStyle = f.colour;
  const x = R(f.x), y = R(f.y);
  g.fillRect(x, y, R(f.x + f.w) - x, R(f.y + f.h) - y);
}

/** See the header. */
export function paintEdges(g, m, it, prev, left, rect) {
  if (!m.top && !m.bottom && !m.between && !m.left && !m.right) return;
  for (const e of geometry(m, it, prev, left).edges) edge(g, e, rect);
}

/** Bars of length len every step along the edge, from a to b. */
function dashes(g, e, a, b, len, step) {
  const across = e.side !== 'left' && e.side !== 'right';
  const n0 = across ? R(e.x) : R(e.y);
  for (let p = n0 + Math.max(0, Math.floor((a - n0) / step)) * step;
    p < b; p += step) {
    const l = Math.min(len, b - p);
    if (across) g.fillRect(p, R(e.y), l, e.h);
    else g.fillRect(R(e.x), p, e.w, l);
  }
}

/** See the header. */
export function edge(g, e, rect) {
  const across = e.side !== 'left' && e.side !== 'right';
  // (the part in rect's rows only, for an edge down)
  let a = across ? R(e.x) : R(e.y);
  let b = across ? R(e.x + e.w) : R(e.y + e.h);
  if (!across && rect) {
    a = Math.max(a, Math.floor(rect.y0) - 1);
    b = Math.min(b, Math.ceil(rect.y1) + 1);
  }
  if (b <= a) return;
  g.fillStyle = e.colour;
  const lw = e.lw;
  if (e.style === 'dotted') return dashes(g, e, a, b, lw, 2 * lw);
  if (e.style === 'dashed') return dashes(g, e, a, b, 3 * lw, 5 * lw);
  const bar = (o) => (across ? g.fillRect(a, R(e.y) + o, b - a, lw)
    : g.fillRect(R(e.x) + o, a, lw, b - a));
  bar(0);
  if (e.style === 'double') bar(2 * lw);
}
