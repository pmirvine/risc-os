// PicBuckets - the size a picture is decoded at, and the small
// helpers of ./PicCache (which re-exports MAX_DECODE, bucketOf and
// decodeSize). Browser globals only (Blob, createImageBitmap).
//
//   bucketOf(info, want?) -> px   see ./PicCache
//   decodeSize(info, long = MAX_DECODE)   see ./PicCache
//   decodeImage(bytes, mime, info, opts)  the default decoder
//   sizeOf(bitmap) -> bytes   width * height * 4
//   close(bitmap)             close it, ignoring a closed one
//   call(fs)                  call each, ignoring their trouble

export const MAX_DECODE = 4096;
const MIN_BUCKET = 32;

/** See the header. */
export function bucketOf(info, want) {
  const top = Math.min(Math.max(info.w, info.h) || 1, MAX_DECODE);
  if (!(want > 0)) return top;
  let b = MIN_BUCKET;
  while (b < want && b < top) b *= 2;
  return Math.min(b, top);
}

/** See the header. */
export function decodeSize(info, long = MAX_DECODE) {
  const w = info && info.w, h = info && info.h;
  if (!(w > long || h > long)) return null;
  const k = long / Math.max(w, h);
  return {resizeWidth: Math.max(1, Math.round(w * k)),
    resizeHeight: Math.max(1, Math.round(h * k)),
    resizeQuality: 'medium'};
}

export function decodeImage(bytes, mime, info, opts) {
  const blob = new Blob([bytes], {type: mime});
  return opts ? createImageBitmap(blob, opts) : createImageBitmap(blob);
}

export const sizeOf = (b) => Math.max(0,
  (b && b.width) * (b && b.height) * 4 || 0);

export const close = (b) => {
  try {
    if (b && typeof b.close === 'function') b.close();
  } catch (e) { /* closed already */ }
};

export const call = (fs) => {
  for (const f of fs) {
    try { f(); } catch (err) { /* a window's own trouble */ }
  }
};
