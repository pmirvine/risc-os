// PicSize - the size a picture is dragged to (pure; Batch B).
//
//   dragSize(start, handle, dx, dy, {free}?) -> {w, h}
//       start {w, h}: the size when the drag began (px); handle one
//       of nw n ne e se s sw w (./PicFind); dx, dy: how far the
//       pointer has moved (px, layout). An edge changes one side
//       (e, s grow with dx, dy; w, n shrink). A corner keeps the
//       proportions of start unless free, when both sides follow
//       it: the side whose relative change is the larger leads (as
//       Word: the corner stays on the pointer along that axis) and
//       the other follows. Each side at least 1 px; anything else
//       gives start back.
//   pxToEmu(px) = round(px x 9525)
//   MIN_EMU = 9525 (15 twips), MAX_EMU = 20116800 (22 in): the
//       sizes a picture may be given (./PicOps)
import {EMU_PX} from './PicRead';

export const MIN_EMU = 9525;
export const MAX_EMU = 20116800;

/** See the header. */
export const pxToEmu = (px) => Math.round(px * EMU_PX);

const SIGNS = {nw: [-1, -1], n: [0, -1], ne: [1, -1], e: [1, 0],
  se: [1, 1], s: [0, 1], sw: [-1, 1], w: [-1, 0]};

/** See the header. */
export function dragSize(start, handle, dx, dy, {free = false} = {}) {
  const sg = Object.hasOwn(SIGNS, handle) ? SIGNS[handle] : null;
  const {w, h} = start;
  const ok = (v) => Number.isFinite(v);
  if (!sg || !ok(dx) || !ok(dy) || !(w > 0) || !(h > 0)) {
    return {w, h};
  }
  let nw = w + sg[0] * dx, nh = h + sg[1] * dy;
  if (!sg[0]) nw = w;
  if (!sg[1]) nh = h;
  if (sg[0] && sg[1] && !free) {
    const kw = nw / w, kh = nh / h;
    let k = Math.abs(kw - 1) >= Math.abs(kh - 1) ? kw : kh;
    k = Math.max(k, 1 / Math.min(w, h));
    nw = w * k;
    nh = h * k;
  }
  return {w: Math.max(1, nw), h: Math.max(1, nh)};
}
