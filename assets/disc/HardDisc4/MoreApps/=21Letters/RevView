// RevView - the markup view of a document's window (Batch F2): which
// tracked changes (run.rev tags, ./RevRead) its text shows. One rule
// for the layout (./LineTokens), the keys (./SelMove, ./EditDel), the
// selection, Find, the word count, Info, Change Case and the
// clipboard's plain text, so what is drawn, keyed, searched and
// counted agree.
//
//   MODES    ['final', 'all', 'original']; DEFAULT 'final'
//   isMode(m)  -> whether m is one of them
//   modeOf(m)  -> m when it is one, else DEFAULT
//   hides(kind, mode) -> whether text of revision kind ('ins',
//            'del', 'mvFrom', 'mvTo') is hidden in mode:
//              'final'     deletions and moved-away text ('del',
//                          'mvFrom'): the text as it will be
//              'original'  insertions and moved-to text ('ins',
//                          'mvTo'): the text as it was
//              'all'       none (All Markup: every change drawn,
//                          ./RevPaint)
//            any other mode is 'final'
//   visible(run, mode) -> whether the text of run (a model run, its
//            tag or none) takes space in the layout
//   setMarkup(dw, mode) -> bool  the window dw shows mode: dw.d.markup
//            set and the document laid out again (dw.newLayout, all
//            of it: ./ItemReuse keeps no lines of another view);
//            false, nothing changed, for a mode that is not one or
//            the view it shows already
//   shownSel(L, sel) -> sel, or one whose ends lie outside the text
//            L's view hides (an end strictly inside a hidden
//            stretch goes to its nearer edge, the end on a tie)
//
// A revision kept raw (a w:del or w:moveFrom ./RevRead does not
// model, and every one outside the body: ./Kinds BLANK) is drawn as
// before in every view: a raw deletion hidden, a raw insertion shown.
// A document with no tagged runs looks and lays out the same in all
// three. The rule itself is ./Kinds hiddenRev (the text-taking
// helpers there take the mode). Pure: no desktop services.
import {hiddenRev, hiddenSpanAt, MODES, isMode} from './Kinds';
import {select} from './Selection';

export {MODES, isMode};
export const DEFAULT = 'final';

/** See the header. */
export const modeOf = (m) => (isMode(m) ? m : DEFAULT);

/** See the header. */
export const hides = (kind, mode) => hiddenRev({kind}, mode);

/** See the header. */
export function visible(run, mode) {
  return !(run !== null && typeof run === 'object' &&
    hiddenRev(run.rev, mode));
}

/** See the header. */
export function setMarkup(dw, mode) {
  if (!isMode(mode) || !dw || !dw.d || dw.d.markup === mode) {
    return false;
  }
  dw.d.markup = mode;
  dw.newLayout(dw.L.metrics, dw.L);
  return true;
}

/** pos out of the hidden stretch it is strictly inside (see the
 *  header), or pos itself. */
function out(L, pos, mode) {
  const it = pos && L.byId && L.byId.get(pos.id);
  if (!it || it.kind !== 'p' || !it.block) return pos;
  const sp = hiddenSpanAt(it.block, pos.off, mode);
  if (!sp || pos.off <= sp[0]) return pos;
  return {id: pos.id, off: pos.off - sp[0] < sp[1] - pos.off ? sp[0]
    : sp[1]};
}

/** See the header. */
export function shownSel(L, sel) {
  if (!L || !sel || !sel.anchor || !sel.head) return sel;
  const mode = modeOf(L.markup);
  const a = out(L, sel.anchor, mode), h = out(L, sel.head, mode);
  return a === sel.anchor && h === sel.head ? sel
    : select(a, h, sel.affinity);
}
