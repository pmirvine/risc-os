// OpsTheme - setTheme: replace the document's theme part.
//
//   setTheme {value: Uint8Array | null} -> setTheme {value: the old
//     bytes | null}
//   Sets doc.parts 'word/theme/theme1.xml' (a new Map; every other
//   name keeps its bytes object; null removes the part) and
//   doc.styles.theme (./ThemeRead.parse of the bytes, undefined when
//   the part is gone; the style table is copied, not changed). The
//   one fixed part name is checked here, not by setDocPart parts
//   (which refuses a changed part). The
//   relationship and content type of a part that was absent are the
//   caller's (./ThemeDoc); the writer gives the part its type.
//   The value is kept by reference (immutable by contract, as
//   setDocPart's). A bad value is refused (RangeError), doc unchanged.
import {fail} from './ModelCheck';
import {parse} from './ThemeRead';

export const THEME_PART = 'word/theme/theme1.xml';

/** See the header. */
export function setTheme(doc, op) {
  const v = op.value;
  if (v !== null && !(v instanceof Uint8Array))
    fail('setTheme needs bytes or null');
  const old = doc.parts instanceof Map ? doc.parts : new Map();
  const prev = old.has(THEME_PART) ? old.get(THEME_PART) : null;
  const next = new Map(old);
  if (v === null) next.delete(THEME_PART);
  else next.set(THEME_PART, v);
  doc.parts = next;
  const s = doc.styles;
  if (s && typeof s === 'object') {
    const t = {...s};
    if (v === null) delete t.theme;
    else t.theme = parse(v);
    doc.styles = t;
  }
  return {op: 'setTheme', value: prev};
}
