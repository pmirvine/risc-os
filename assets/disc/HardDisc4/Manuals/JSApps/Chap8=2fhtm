if (n) {
  reportError(`${n} contacts added`,
    { appName: 'Contacts', category: 'info' });
}
</PRE>
(Without <CODE>appName</CODE> the box would be titled <I>Error</I>, which it isn't.)
<DT><DD>2  A third kind in <CODE>exportBox</CODE>:
<PRE>
const lines = this.chosen().map((c) =&gt;
  `${nameOf(c)}  ${phoneOf(c)}`);
return saveAs({ task: this.app.task, filetype: 0xFFF,
  filename: 'Phones', getData: async () =&gt;
    lines.join('\n') + '\n' });
</PRE>
and <CODE>{ text: 'Phone list', submenu: () =&gt; this.exportBox('phones') }</CODE> in the Export menu.<P>
<DT><DD>3  Use <CODE>sep</CODE> in place of <CODE>','</CODE> in <CODE>csvRows</CODE>, and in
<CODE>csvRead</CODE>:
<PRE>
const first = text.split('\n')[0];
const count = (ch) =&gt; first.split(ch).length;
const sep = count(';') &gt; count(',') ? ';' : ',';
const [header, ...rows] = csvRows(text, sep);
</PRE>
<DT><DD>4  In <CODE>dragOut</CODE>:
<PRE>
const csv = ev.shift;
dragSave(ev, { task: this.app.task,
  leafname: leaf + (csv ? '/csv' : '/vcf'),
  filetype: csv ? 0xDFE : 0xFFF,
  getData: async () =&gt;
    encode(csv ? csvWrite(sel) : vcardWrite(sel)) });
</PRE>
