/** The week's number: that of its Thursday. */
export function weekNumber(key) {
  const thu = addDays(startOfWeek(key), 3);
  const jan1 = `${thu.slice(0, 4)}-01-01`;
  return Math.floor(daysBetween(jan1, thu) / 7) + 1;
}
