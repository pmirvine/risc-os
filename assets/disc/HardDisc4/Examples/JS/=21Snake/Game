// Game - the rules of Snake: where everything is, and what
// happens at each tick of the clock. It knows nothing about
// windows or drawing, so it could be used in another program.

export const COLS = 24;     // the board is COLS x ROWS cells
export const ROWS = 18;

// The four directions: how far one step moves in x and y
export const UP = { x: 0, y: -1 };
export const DOWN = { x: 0, y: 1 };
export const LEFT = { x: -1, y: 0 };
export const RIGHT = { x: 1, y: 0 };

// A new game: a short snake heading right, and some food
export function newGame() {
  const game = {
    snake: [{ x: 6, y: 9 }, { x: 5, y: 9 }, { x: 4, y: 9 }],
    dir: RIGHT,       // the way the snake is going
    next: RIGHT,      // the way it will go at the next step
    food: null,
    score: 0,
    over: false,
  };
  placeFood(game);
  return game;
}

// Turn at the next step - but not straight back on itself
export function turn(game, dir) {
  if (dir.x === -game.dir.x && dir.y === -game.dir.y) return;
  game.next = dir;
}

// Move the snake one cell. Returns 'moved', 'ate' or 'crashed'.
export function step(game) {
  if (game.over) return 'crashed';
  game.dir = game.next;
  const head = game.snake[0];
  const cell = { x: head.x + game.dir.x, y: head.y + game.dir.y };
  const outside = cell.x < 0 || cell.x >= COLS ||
    cell.y < 0 || cell.y >= ROWS;
  if (outside || isSnake(game, cell)) {
    game.over = true;
    return 'crashed';
  }
  game.snake.unshift(cell);            // the new head
  if (cell.x === game.food.x && cell.y === game.food.y) {
    game.score = game.score + 1;       // keep the tail: it grows
    placeFood(game);
    return 'ate';
  }
  game.snake.pop();                    // drop the tail
  return 'moved';
}

// Is any part of the snake in this cell?
function isSnake(game, cell) {
  for (const part of game.snake) {
    if (part.x === cell.x && part.y === cell.y) return true;
  }
  return false;
}

// Put the food in a random cell that the snake isn't in
function placeFood(game) {
  let cell;
  do {
    cell = {
      x: Math.floor(Math.random() * COLS),
      y: Math.floor(Math.random() * ROWS),
    };
  } while (isSnake(game, cell));
  game.food = cell;
}
