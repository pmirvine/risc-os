// Board - draws a game of Snake on a window's canvas
import { wimpColour } from 'riscos';
import { COLS, ROWS } from './Game';

export const CELL = 16;               // size of a cell in pixels
export const WIDTH = COLS * CELL;
export const HEIGHT = ROWS * CELL;

// Draw the whole board: grass, food, snake and any message
export function drawBoard(g, game) {
  g.fillStyle = wimpColour(13);                  // dark green
  g.fillRect(0, 0, WIDTH, HEIGHT);

  g.fillStyle = wimpColour(11);                  // red food
  g.beginPath();
  g.arc(game.food.x * CELL + CELL / 2, game.food.y * CELL + CELL / 2,
    CELL / 2 - 2, 0, Math.PI * 2);
  g.fill();

  for (const part of game.snake) {
    square(g, part, wimpColour(10));             // light green
  }
  square(g, game.snake[0], wimpColour(9));       // yellow head

  if (game.over) {
    message(g, 'Game over', 'Press Space for a new game');
  }
}

// Fill one cell, leaving a thin gap around it
function square(g, cell, colour) {
  g.fillStyle = colour;
  g.fillRect(cell.x * CELL + 1, cell.y * CELL + 1,
    CELL - 2, CELL - 2);
}

// Two lines of text in the middle of the board
function message(g, big, small) {
  g.fillStyle = 'white';
  g.textAlign = 'center';
  g.font = 'bold 28px sans-serif';
  g.fillText(big, WIDTH / 2, HEIGHT / 2 - 8);
  g.font = '14px sans-serif';
  g.fillText(small, WIDTH / 2, HEIGHT / 2 + 20);
}
