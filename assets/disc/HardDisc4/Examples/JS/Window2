// Window2 - a window with a label and a button
let clicks = 0;

const w = task.createWindow({
  title: 'Counter',
  x: 300, y: 200, w: 260, h: 120,
  extent: { w: 260, h: 120 },
  flags: { title: true, close: true, back: true, moveable: true },
  icons: [
    { x: 20, y: 16, w: 220, h: 32, text: 'Not clicked yet',
      hcentre: true },
    { x: 70, y: 64, w: 120, h: 40, text: 'Click me',
      border: true, filled: true, hcentre: true,
      button: 'click', validation: 'R5,3' },
  ],
});

const label = w.icons[0];
const button = w.icons[1];

w.on('click', (ev) => {
  if (ev.icon === button) {
    clicks = clicks + 1;
    label.setText(`Clicked ${clicks} times`);
  }
});

w.on('close', () => task.quit());
w.open();
