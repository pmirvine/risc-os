// Doodle3 - Doodle2 as modules. Double-click Main to run it.
import { Menu, colourMenu, infoBox, wimpColour, wimp } from 'riscos';
import {
  startLine, addPoint, endLine, clear, isEmpty, drawPicture,
} from './Picture';

export default function start(task, ctx) {
  let colour = 7;     // the Wimp colour we are using (7 is black)

  const w = task.createWindow({
    title: 'Doodle3',
    x: 160, y: 100, w: 480, h: 360,
    extent: { w: 480, h: 360 },
    flags: { title: true, close: true, back: true, moveable: true },
    colours: { workBg: 0 },
    workButton: 'click',
  });
  w.useCanvas((g) => drawPicture(g));

  const info = infoBox(task, {
    name: 'Doodle3', purpose: 'Draws doodles',
    author: 'A. Programmer', version: '1.00',
  });
  function doodleMenu() {
    return new Menu('Doodle3', [
      { text: 'Info', submenu: info },
      { text: 'Colour',
        submenu: colourMenu('Colour', colour, (n) => {
          colour = n;
        }) },
      { text: 'Clear', shaded: isEmpty(), dotted: true,
        action: () => {
          clear();
          w.invalidate();
        } },
      { text: 'Quit', action: () => task.quit() },
    ]);
  }

  w.on('click', (ev) => {
    if (ev.button === 'select') {
      startLine(wimpColour(colour), ev.x, ev.y);
      w.invalidate();
    } else if (ev.button === 'menu') {
      wimp.menus.openAt(doodleMenu(), ev, { task });
    }
    return true;
  });

  w.on('pointermove', (ev) => {
    if (ev.buttons === 1) {
      if (addPoint(ev.x, ev.y)) w.invalidate();
    } else {
      endLine();
    }
  });

  task.addIconbarIcon({
    sprite: 'file_aff',
    onClick: () => w.open({ behind: 'top' }),
    menu: () => doodleMenu(),
  });
  task.onMessage('Quit', () => task.quit());

  w.open();
}
