// Doodle - draw with the mouse
const colours = ['black', 'red', 'blue', 'green', 'orange'];
let colour = 0;       // which of the colours we are using
const lines = [];     // everything drawn so far
let drawing = null;   // the line being drawn, while Select is held

const w = task.createWindow({
  title: 'Doodle - black',
  x: 160, y: 100, w: 480, h: 360,
  extent: { w: 480, h: 360 },
  flags: { title: true, close: true, back: true, moveable: true },
  colours: { workBg: 0 },
  workButton: 'click',
});

w.useCanvas((g) => {
  g.lineWidth = 4;
  g.lineCap = 'round';
  g.lineJoin = 'round';
  for (const line of lines) {
    g.strokeStyle = line.colour;
    g.beginPath();
    g.moveTo(line.points[0].x, line.points[0].y);
    for (const p of line.points) {
      g.lineTo(p.x, p.y);
    }
    g.stroke();
  }
});

w.on('click', (ev) => {
  if (ev.button === 'select') {
    // start a new line where the mouse is
    drawing = { colour: colours[colour], points: [] };
    drawing.points.push({ x: ev.x, y: ev.y });
    lines.push(drawing);
    w.invalidate();
  } else if (ev.button === 'adjust') {
    // change to the next colour
    colour = (colour + 1) % colours.length;
    w.setTitle(`Doodle - ${colours[colour]}`);
  }
  return true;
});

w.on('pointermove', (ev) => {
  if (drawing && ev.buttons === 1) {
    drawing.points.push({ x: ev.x, y: ev.y });
    w.invalidate();
  } else {
    drawing = null;
  }
});

w.on('close', () => task.quit());
w.open();
