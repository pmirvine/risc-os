// Keys - move a ball around with the arrow keys
let x = 200;
let y = 150;
const size = 20;
const step = 10;

const w = task.createWindow({
  title: 'Keys',
  x: 200, y: 150, w: 400, h: 300,
  extent: { w: 400, h: 300 },
  flags: { title: true, close: true, back: true, moveable: true },
  colours: { workBg: 0 },
  workButton: 'click',
});

w.useCanvas((g) => {
  g.fillStyle = 'black';
  g.font = '16px sans-serif';
  g.fillText('Click here, then use the arrow keys', 10, 24);
  g.fillStyle = 'red';
  g.beginPath();
  g.arc(x, y, size, 0, Math.PI * 2);
  g.fill();
});

w.on('key', (ev) => {
  if (ev.code === 0x18C) {         // left arrow
    x = x - step;
  } else if (ev.code === 0x18D) {  // right arrow
    x = x + step;
  } else if (ev.code === 0x18E) {  // down arrow
    y = y + step;
  } else if (ev.code === 0x18F) {  // up arrow
    y = y - step;
  } else {
    return;                        // not ours: the Wimp passes it on
  }
  // keep the ball inside the window
  x = Math.max(size, Math.min(400 - size, x));
  y = Math.max(size, Math.min(300 - size, y));
  w.invalidate();
  return true;
});

w.on('click', () => {
  wimp.setCaret(w);                // take the input focus
  return true;
});

w.on('close', () => task.quit());
w.open();
wimp.setCaret(w);
