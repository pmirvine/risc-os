// Emitter - lets one part of a program tell others that something
// has happened, without knowing who is listening.
//
//   class Book extends Emitter { ... this.emit('change', data) }
//   const off = book.on('change', (data) => redraw());
//   off();                          // stop listening

export class Emitter {
  constructor() {
    this.listeners = new Map();      // event name -> Set of functions
  }

  /** Call fn(data) whenever the event happens; returns off(). */
  on(type, fn) {
    if (!this.listeners.has(type)) {
      this.listeners.set(type, new Set());
    }
    this.listeners.get(type).add(fn);
    return () => this.listeners.get(type).delete(fn);
  }

  /** Tell every listener that the event has happened. */
  emit(type, data) {
    for (const fn of [...(this.listeners.get(type) ?? [])]) fn(data);
  }
}
