// Check - tests the parts of Contacts that don't need windows:
// the Book. Double-click it: it prints ok or FAIL for each
// test, and 'all ok' if they all pass.
import { print } from 'riscos';
import { Book, nameOf } from './Model';

let failed = 0;
// the same, whatever order their fields are in
const sorted = (k, v) => (v && typeof v === 'object' &&
  !Array.isArray(v) ? Object.fromEntries(Object.entries(v).sort())
  : v);
const same = (a, b) =>
  JSON.stringify(a, sorted) === JSON.stringify(b, sorted);

function check(what, got, want) {
  const ok = same(got, want);
  if (!ok) failed++;
  print(`${ok ? 'ok  ' : 'FAIL'} ${what}`);
  if (!ok) print(`     got ${JSON.stringify(got)}`);
}

export default function start() {
  // ------------------------------------------------ the Book
  const book = new Book();
  let changes = 0;
  book.on('change', () => changes++);
  const ann = book.add({ first: 'Ann', last: 'Smith' });
  const bob = book.add({ first: 'Bob', last: 'Jones',
    company: 'Acorn' });
  book.add({ company: 'Zebra Ltd' });
  check('add gives ids', [ann.id, bob.id], [1, 2]);
  check('changes are told', changes, 3);
  check('sorted by surname', book.list().map(nameOf),
    ['Jones, Bob', 'Smith, Ann', 'Zebra Ltd']);
  check('sorted by company', book.list({ sort: 'company' })
    .map((c) => c.id), [ann.id, bob.id, 3]);
  check('search', book.list({ search: 'acorn' }).map(nameOf),
    ['Jones, Bob']);
  book.update(ann.id, { first: 'Anne' });
  check('update', book.get(ann.id).first, 'Anne');
  book.remove(bob.id);
  check('remove', book.list().map(nameOf), ['Smith, Anne',
    'Zebra Ltd']);
  const copy = Book.fromJSON(JSON.parse(JSON.stringify(book)));
  check('saved and loaded', copy.list().map(nameOf),
    book.list().map(nameOf));

  print(failed ? `${failed} FAILED` : 'all ok');
}
