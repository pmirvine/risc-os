// Store - what the organiser remembers, section by section, with no
// windows in it. Each kind of entry is kept in a Collection: a Map
// from id to entry, which emits 'change' whenever it changes.
//
//   const diary = new Diary();
//   diary.add({ date, text })
//   diary.update(id, fields); diary.put(entry); diary.remove(id)
//   diary.get(id), diary.all(), diary.toJSON()
//   diary.occurrences(from, to)   appointments on those days
import { Emitter } from './Toolkit/Emitter';

export class Collection extends Emitter {
  constructor(items = []) {
    super();
    this.items = new Map();            // id -> entry
    this.nextId = 1;
    for (const x of items) this.put(x, false);
  }
  get size() { return this.items.size; }
  get(id) { return this.items.get(id); }
  all() { return [...this.items.values()]; }
  add(fields) {
    const x = { ...fields, id: fields.id ?? this.nextId };
    this.put(x);
    return x;
  }
  update(id, fields) {
    const x = { ...this.items.get(id), ...fields, id };
    this.put(x);
    return x;
  }
  /** Keep exactly this entry (tell listeners unless quiet). */
  put(x, tell = true) {
    this.items.set(x.id, x);
    this.nextId = Math.max(this.nextId, x.id + 1);
    if (tell) this.emit('change', x);
  }
  remove(id) {
    const x = this.items.get(id);
    this.items.delete(id);
    this.emit('change', x);
    return x;
  }
  toJSON() { return this.all(); }
}

// ------------------------------------------------ the diary
// An appointment: { date, time ('09:30' or ''), end, text }.

export class Diary extends Collection {
  /** [{ appt, date }] for the days from..to, in time order. */
  occurrences(from, to) {
    const out = [];
    for (const a of this.all()) {
      for (const date of datesOf(a, from, to)) {
        out.push({ appt: a, date });
      }
    }
    return out.sort((x, y) => (x.date + (x.appt.time || ''))
      .localeCompare(y.date + (y.appt.time || '')));
  }
}
/** The days an appointment falls on between from and to. */
function datesOf(a, from, to) {
  return a.date >= from && a.date <= to ? [a.date] : [];
}
