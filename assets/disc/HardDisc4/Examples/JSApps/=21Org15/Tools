// Tools - what the toolbox does, for every section: the buttons,
// choosing and deleting entries (the Delete key, or dragging one into
// the wastebasket), dragging entries about, and the Link tool.
import { wimp, Menu, query, beep } from 'riscos';
import * as D from './Toolkit/Dates';
import { chain } from './Paper';

/** Today's date for the toolbox: '25 Sep'. */
export const TODAY = () => D.format(D.today(), '%ZDY %M3');

// ------------------------------------------------ the toolbox
const VIEWS = 4;                          // room for 4 view buttons
export function buttons(org) {
  const view = (i) => ({ name: 'view' + i, text: '', h: 26,
    action: () => { const s = org.section;
      s.setView(s.views[i]); org.refresh(); } });
  return [
    { name: 'new', sprite: 'tb_new', action: () => org.section
      .newEntry(), help: 'Click SELECT to add an entry here.' },
    { name: 'link', sprite: 'tb_link', action: () => startLink(org),
      help: 'Click SELECT, then on two entries, to link them.' },
    { name: 'back', sprite: 'tb_back', action: () => org.back(),
      help: 'Click SELECT to go back to where you were.' },
    { name: 'today', text: TODAY(), h: 30,
      action: () => { org.section.today(); org.refresh(); },
      help: 'Today\'s date. Click SELECT to go to today.' },
    { gap: true },
    ...Array.from({ length: VIEWS }, (_, i) => view(i)),
    { gap: true },
    { name: 'bin', sprite: 'tb_bin', action: () => remove(org),
      help: 'The wastebasket: drag an entry here to delete it, ' +
        'or click SELECT to delete the chosen entry.' },
  ];
}
/** The toolbox follows the section: its views and New's help. */
export function updateToolbox(org) {
  const s = org.section, bar = org.bar;
  for (let i = 0; i < VIEWS; i++) {
    bar.hide('view' + i, i >= s.views.length);
    if (i < s.views.length) {
      bar.setText('view' + i, s.views[i]);
      const on = s.views[i] === s.view;
      bar.icon('view' + i).setState({ selected: on });
    }
  }
  bar.icon('new').help = `Click SELECT: ${s.newHelp}.`;
  bar.setText('today', TODAY());
  bar.icon('link').setState({ selected: !!org.linking });
}

// ------------------------------------------------ choosing entries
/** A click on an entry: the Link tool, a chain, or choosing it. */
export function clickEntry(org, ev) {
  const box = org.section.at(ev.x, ev.y);
  if (!box) {
    if (org.linking) { org.linking = null; org.refresh(); }
    org.selected = null;
    return false;
  }
  if (org.linking) { pickForLink(org, box.ref); return true; }
  if (org.doc.links.has(box.ref) && ev.x > box.x + box.w - 16) {
    linkMenu(org, box.ref, ev);           // the chain mark
    return true;
  }
  org.selected = box.ref;
  org.redraw();
  return false;                           // the section sees it too
}
/** After the section has drawn: chain marks and the chosen entry. */
export function decorate(org, g) {
  const same = (a, b) => a && b && a.section === b.section &&
    a.id === b.id && (a.date ?? '') === (b.date ?? '');
  for (const b of org.section.boxes) {
    if (org.doc.links.has(b.ref)) chain(g, b.x + b.w - 12, b.y + 8);
    const chosen = same(b.ref, org.selected) ||
      same(b.ref, org.linking?.first);
    if (chosen) {
      g.strokeStyle = org.linking ? '#c00000' : '#000000';
      g.lineWidth = 2;
      g.strokeRect(b.x - 1, b.y - 1, b.w + 2, b.h + 2);
    }
  }
}

// ------------------------------------------------ deleting
export async function remove(org, ref = org.selected) {
  if (!ref) { beep(); return; }
  const s = org.sections.find((x) => x.id === ref.section);
  if (org.app.prefs.confirm) {
    const r = await query({ task: org.app.task, title: 'Organiser',
      message: `Delete '${s.describe(ref)}'?`,
      buttons: ['Delete', 'Cancel'] });
    org.focus();
    if (r !== 'Delete') return;
  }
  s.remove(ref);
  org.doc.links.forget(ref);
  org.selected = null;
  org.refresh();
}

// ------------------------------------------------ dragging entries
/** A drag on an entry: into the wastebasket, or somewhere else. */
export async function drag(org, ev) {
  const box = org.section.at(ev.x, ev.y);
  if (!box) { org.section.drag(ev); return true; }
  const p = org.win.workToScreen(box.x, box.y);
  const drop = await wimp.drag({ event: ev.pointerEvent,
    box: { x0: p.x, y0: p.y, x1: p.x + box.w, y1: p.y + box.h } });
  if (drop.window === org.bar.pane && drop.icon?.name === 'bin') {
    await remove(org, box.ref);
  } else if (drop.window === org.win) {
    org.section.dropped(box.ref, drop.x, drop.y);
    org.refresh();
  }
  return true;
}

// ------------------------------------------------ links
export function startLink(org) {
  org.linking = org.selected ? { first: org.selected } : {};
  org.refresh();
}
function pickForLink(org, ref) {
  if (!org.linking.first) org.linking.first = ref;
  else {
    org.doc.links.link(org.linking.first, ref);
    org.linking = null;
  }
  org.refresh();
}
function linkMenu(org, ref, ev) {
  const items = org.doc.links.of(ref).map((r) => {
    const s = org.sections.find((x) => x.id === r.section);
    return { text: `${s.name}: ${s.describe(r)}`.slice(0, 40),
      action: () => org.go(r) };
  });
  wimp.menus.openAt(new Menu('Linked to', items), ev,
    { task: org.app.task });
}
