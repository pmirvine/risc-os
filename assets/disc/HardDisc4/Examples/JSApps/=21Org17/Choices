// Choices - the settings a user can change, kept in Choices:Organiser
// (the RISC OS Style Guide's way): the binder's colour, and whether
// to ask before deleting.
//
//   const prefs = await loadChoices();     { colour, confirm }
//   openChoices(task, prefs, changed)    the Choices... dialogue box
import { choices } from 'riscos';
import { Form } from './Toolkit/Form';

export const COLOURS = { Brown: '#6b3f22', Black: '#2a2a2a',
  Blue: '#2c4a73', Green: '#2f5d3a', Red: '#7a2323' };
export const DEFAULTS = { colour: COLOURS.Brown, confirm: true };

export const loadChoices = () => choices.read('Organiser', DEFAULTS);

let form = null;
const nameOf = (c) => Object.keys(COLOURS)
  .find((n) => COLOURS[n] === c) ?? 'Brown';
const shown = (p) => ({ ...p, colour: nameOf(p.colour) });

export async function openChoices(task, prefs, changed) {
  form ??= new Form(task, {
    title: 'Organiser choices',
    help: 'Choose how the Organiser looks and behaves.',
    fields: [
      { name: 'colour', label: 'Binder', width: 120,
        choices: Object.keys(COLOURS),
        help: 'The colour of the binder\'s cover.' },
      { name: 'confirm', label: 'Ask before deleting', option: true },
    ],
    buttons: ['Default', 'Cancel', 'Set', 'Save'],
    stay: ['Default'],
  });
  form.off?.();
  form.off = form.on('button', () => form.set(shown(DEFAULTS)));
  const r = await form.run(shown(prefs));
  if (!r) return;
  Object.assign(prefs, { colour: COLOURS[r.values.colour] ??
    DEFAULTS.colour, confirm: r.values.confirm });
  if (r.button === 'Save') choices.write('Organiser', prefs);
  changed(prefs);
}
