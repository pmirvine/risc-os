// RulerPick - which marker of a ruler (./Ui/Ruler) a press picks.
//
//   pickMarker(markers, x, y, h, xOf, near = 6) -> a marker or null
//       markers [{twips, kind}], (x, y) the press (px in the ruler,
//       h its height), xOf(twips) -> the x of a marker
//
// Only markers within near px across count. The ruler has three
// bands: the top 40 % ('down': the first-line triangle), the middle
// ('up': the hanging and right triangles, and the tab stops: kinds of
// ./RulerTabs) and the bottom 20 % ('box': the left indent's box).
// The nearest marker in the press's band wins, else the nearest in
// any band. Markers within 1 px of the nearest are a tie (a tab stop
// where an indent marker is: a right tab at the right margin, a stop
// at the left indent): in the lower part of the middle band (from
// 60 % of the height down, under the triangles' tips) a tab stop
// wins, above it the indent marker, so both can be dragged; the box
// and the first-line triangle keep their own bands.
// Pure: no desktop services.
import {isTabKind} from './RulerTabs';

/** See the header. */
export function pickMarker(markers, x, y, h, xOf, near = 6) {
  const band = (k) => (k === 'down' ? y < h * 0.4
    : k === 'up' || isTabKind(k) ? y >= h * 0.4 && y < h * 0.8
      : y >= h * 0.8);
  const tabFirst = y >= h * 0.6;
  const near1 = [];
  for (const m of markers) {
    const d = Math.abs(xOf(m.twips) - x);
    if (d < near + 1) near1.push({m, d});
  }
  for (const pass of [true, false]) {
    const list = pass ? near1.filter((c) => band(c.m.kind)) : near1;
    if (!list.length) continue;
    const min = Math.min(...list.map((c) => c.d));
    const tied = list.filter((c) => c.d <= min + 1);
    const pref = tied.filter((c) => isTabKind(c.m.kind) === tabFirst);
    const from = pref.length ? pref : tied;
    return from.reduce((a, c) => (c.d < a.d ? c : a)).m;
  }
  return null;
}
