// ZipNames - decides which entry names in a zip file are safe. See
// ./Zip. A name must be a plain relative path of non-empty segments,
// so that unpacking can never leave its folder.
import { ZipError } from './ZipError';

/**
 * Throws ZipError('not-zip') for a name that is empty, absolute,
 * has a drive letter, backslash or control character, or has an
 * empty, '.' or '..' segment. One trailing '/' (a folder) is fine.
 * @param {string} name
 */
export function checkName(name) {
  const path = name.endsWith('/') ? name.slice(0, -1) : name;
  const bad = path === '' || /[\x00-\x1f\\]/.test(path) ||
    /^[A-Za-z]:/.test(path) ||
    path.split('/').some((s) => s === '' || s === '.' || s === '..');
  if (bad) throw new ZipError('not-zip', 'unsafe name: ' + name);
}
