// ColourLayout - where the parts of a colour popup (./ColourPopup)
// go. Pure; y runs down from the window's top.
//
//   layout(withTheme) -> {W, H, btnY, std: {x, y},
//     theme: {x, y} | null, themeLabelY, stdLabelY}
//     Without a theme block: the 8 x 5 swatches at the top, the
//     buttons under them. With: a "Theme Colours" label and the
//     10 x 6 theme grid, then a "Standard Colours" label and the
//     swatches, then the buttons.
//   cellAt(lay, x, y) -> {kind: 'theme' | 'std', col, row} | null
//     the cell under a work-area point
import {COLS, ROWS} from '../ColourList';

export const CELL = 22, PAD = 8, LABEL = 16, BTN_H = 28;
export const THEME_COLS = 10, THEME_ROWS = 6;

/** See the header. */
export function layout(withTheme) {
  let y = PAD, theme = null, themeLabelY = null, stdLabelY = null;
  if (withTheme) {
    themeLabelY = y;
    y += LABEL;
    theme = {x: PAD, y};
    y += THEME_ROWS * CELL + 6;
    stdLabelY = y;
    y += LABEL;
  }
  const std = {x: PAD, y};
  y += ROWS * CELL + 8;
  const W = Math.max(COLS, withTheme ? THEME_COLS : 0) * CELL + 2 * PAD;
  return {W, H: y + BTN_H + PAD, btnY: y, std, theme,
    themeLabelY, stdLabelY};
}

const inGrid = (g, cols, rows, x, y) => {
  const col = Math.floor((x - g.x) / CELL);
  const row = Math.floor((y - g.y) / CELL);
  return col >= 0 && row >= 0 && col < cols && row < rows ?
    {col, row} : null;
};

/** See the header. */
export function cellAt(lay, x, y) {
  const t = lay.theme &&
    inGrid(lay.theme, THEME_COLS, THEME_ROWS, x, y);
  if (t) return {kind: 'theme', ...t};
  const s = inGrid(lay.std, COLS, ROWS, x, y);
  return s ? {kind: 'std', ...s} : null;
}
