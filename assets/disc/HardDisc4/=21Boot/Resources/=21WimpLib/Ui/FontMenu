// FontMenu - a menu of font names: the document's fonts first, then
// Word's common ones, then 'Desktop fonts' (a submenu of the
// desktop's font families: the font manager's), each name once
// (../FontList).
//
//   fontMenu({current, docFonts, onPick, desktop?}) -> a Menu
//     current   the font in use (ticked, any case), or null
//     docFonts  the document's fonts (names)
//     onPick(name)  a name was chosen
//     desktop   the desktop's families (default: the font manager's,
//               read when the menu is made)
//   desktopFonts() -> the desktop's font families (none when the
//               font manager cannot say)
import {Menu, os} from 'riscos';
import {fontList, findFont} from '../FontList';

/** See the header. */
export function desktopFonts() {
  try {
    const reg = os && os.fontreg;
    return reg ? reg.families().map((f) => f[0]) : [];
  } catch (e) {
    return [];
  }
}

/** See the header. */
export function fontMenu({current = null, docFonts = [], onPick,
  desktop}) {
  const l = fontList(docFonts, desktop ?? desktopFonts());
  const tick = findFont(l, current);
  const item = (n, dotted) => ({text: n, ticked: n === tick, dotted,
    action: () => onPick && onPick(n)});
  const items = [];
  const add = (names) => names.forEach((n, i) =>
    items.push(item(n, i === names.length - 1)));
  add(l.doc);
  add(l.word);
  if (l.desktop.length) {
    const sub = new Menu('Desktop fonts',
      l.desktop.map((n) => item(n, false)));
    items.push({text: 'Desktop fonts', submenu: sub,
      ticked: l.desktop.includes(tick),
      help: 'The fonts of the desktop (its font manager\'s).'});
  } else if (items.length) items[items.length - 1].dotted = false;
  return new Menu('Font', items);
}
