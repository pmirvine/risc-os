// RulerTabPaint - how ./Ruler draws tab stops (./RulerPaint calls it)
// and its tab-type selector: the five glyphs as Word draws them, on
// the ruler's lower part ('tabL' an L, 'tabR' a mirrored L, 'tabC' an
// upside-down T, 'tabD' that with a dot right of the stem, 'tabBar' a
// bar), black, or grey for a stop a style gives; and the selector, a
// box at the ruler's left end (left of the page: it does not scroll)
// showing the kind a click on the ruler adds.
//
//   SEL                {x, w}: the selector box (pane px), w square
//   inSelector(x, y, h)  whether pane point (x, y) is on the box of a
//                      ruler h px high
//   paintTab(g, x, h, kind, grey)  a tab marker at pane x
//   paintSelector(g, r)  the box with r.selector's glyph ('left',
//                      'center', 'right', 'decimal' or 'bar'); nothing
//                      when r.selector is null
// Draws on a canvas only: no desktop services.

export const SEL = Object.freeze({x: 3, w: 18});
const INK = '#000000', GREY = '#808080';
const GLYPH = {left: 'tabL', center: 'tabC', right: 'tabR',
  decimal: 'tabD', bar: 'tabBar'};
// where the stem goes in the box, so that the glyph looks centred
const STEM = {tabL: 6, tabR: 12, tabC: 9, tabD: 8, tabBar: 9};

/** See the header. */
export function inSelector(x, y, h) {
  const top = Math.round((h - SEL.w) / 2);
  return x >= SEL.x && x < SEL.x + SEL.w && y >= top && y < top + SEL.w;
}

/** Glyph kind with its stem at x, its foot on line yb (px). */
function glyph(g, x, yb, kind) {
  const yt = yb - 7;
  if (kind === 'tabBar') { g.fillRect(x - 1, yt - 2, 2, 10); return; }
  g.fillRect(x - 1, yt, 2, 8);
  if (kind === 'tabL') g.fillRect(x - 1, yb - 1, 7, 2);
  else if (kind === 'tabR') g.fillRect(x - 6, yb - 1, 7, 2);
  else g.fillRect(x - 5, yb - 1, 10, 2);
  if (kind === 'tabD') g.fillRect(x + 2, yt + 2, 2, 2);
}

/** See the header. */
export function paintTab(g, x, h, kind, grey) {
  g.fillStyle = grey ? GREY : INK;
  glyph(g, Math.round(x), Math.round(h * 0.8) - 1, kind);
}

/** See the header. */
export function paintSelector(g, r) {
  const kind = r.selector && GLYPH[r.selector];
  if (!kind) return;
  const h = r.height, top = Math.round((h - SEL.w) / 2);
  g.fillStyle = '#ffffff';
  g.fillRect(SEL.x, top, SEL.w, SEL.w);
  g.strokeStyle = INK;
  g.lineWidth = 1;
  g.strokeRect(SEL.x + 0.5, top + 0.5, SEL.w - 1, SEL.w - 1);
  g.fillStyle = INK;
  glyph(g, SEL.x + STEM[kind], top + SEL.w - 5, kind);
}
