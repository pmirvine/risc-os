// CharGridPaint - the shape of ./CharGrid's window and its drawing:
// the sizes, the icons, the canvas painting and the key targets.
//
//   COLS 16, ROWS 8 (shown), RECENT 16, CW x CH a cell, PAD, SB (the
//   scroll bar's width), RY GY SY BY (the tops of the recent row, the
//   grid, the status line and the buttons), GRIDW, W x H the window
//   icons()  the window's icons (names: label, set, arrow,
//            recentlabel, status, button:Close, button:Insert)
//   paint(g, s, rec, fam, total)  the recent row, the grid and its
//            scroll bar on the canvas g (work coordinates); s is
//            {set: {chars}, top, sel}, rec the recent characters,
//            fam a CSS family, total the grid's rows
//   target(code, i, n, key) -> the index a movement key (a Wimp key
//            code; key the browser's name for it when there is one,
//            as Shift-Up has Page Up's code) goes to from index i
//            (-1: none chosen) in n characters, {page: -1 | 1} for
//            Page Up / Down, or null
// Pure drawing: no desktop services.

export const COLS = 16, ROWS = 8, RECENT = 16;
export const CW = 32, CH = 30, PAD = 12, SB = 14;
export const RY = 68, GY = RY + CH + 8, SY = GY + ROWS * CH + 10;
export const BY = SY + 36, GRIDW = COLS * CW;
export const W = 2 * PAD + GRIDW + 4 + SB, H = BY + 36 + PAD;

/** The icons of the window. */
export function icons() {
  const btn = (text, x, v) => ({x, y: BY, w: 104, h: 36, text,
    name: `button:${text}`, border: true, filled: true, hcentre: true,
    button: 'click', validation: v});
  return [
    {x: PAD, y: 10, w: 44, h: 28, text: 'Set', name: 'label'},
    {x: PAD + 48, y: 10, w: 240, h: 28, text: '', name: 'set',
      border: true, filled: true, bg: 0, button: 'click',
      validation: 'R2', help: 'Click to choose another set.'},
    {x: PAD + 292, y: 10, w: 28, h: 28, sprite: 'gright',
      name: 'arrow', button: 'click', help: 'Choose another set.'},
    {x: PAD, y: RY - 24, w: 200, h: 22, text: 'Recently used',
      name: 'recentlabel'},
    {x: PAD, y: SY, w: GRIDW, h: 26, text: '', name: 'status'},
    btn('Close', W - PAD - 104, 'R5,3'),
    btn('Insert', W - PAD - 216, 'R6,3'),
  ];
}

const BY_KEY = {ArrowLeft: 'left', ArrowRight: 'right',
  ArrowDown: 'down', ArrowUp: 'up', Home: 'home', End: 'end',
  PageDown: 'pgdn', PageUp: 'pgup'};

/** The command of a Wimp key code (Shift-Down is Page Down's). */
function byCode(code) {
  const pg = code & ~0x20;
  if (pg === 0x19E) return 'pgdn';
  if (pg === 0x19F) return 'pgup';
  const k = code === 30 ? 30 : code & ~0x30;
  return {0x18C: 'left', 0x18D: 'right', 0x18E: 'down', 0x18F: 'up',
    0x18B: 'end', 30: 'home'}[k] || null;
}

/** See the header. */
export function target(code, i, n, key) {
  const named = typeof key === 'string' && key.length > 1;
  const cmd = !named ? byCode(code) :
    Object.hasOwn(BY_KEY, key) ? BY_KEY[key] : null;
  if (cmd === 'pgdn' || cmd === 'pgup') {
    return {page: cmd === 'pgdn' ? 1 : -1};
  }
  const none = i < 0, at = none ? 0 : i;
  const to = {left: at - (none ? 0 : 1), right: at + (none ? 0 : 1),
    down: at + (none ? 0 : COLS), up: at - (none ? 0 : COLS),
    home: 0, end: n - 1}[cmd];
  return to === undefined ? null : Math.max(0, Math.min(n - 1, to));
}

/** The recent row, the grid and its scroll bar. */
export function paint(g, s, rec, fam, total) {
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.font = `19px ${fam}`;
  const cell = (x, y, ch) => {
    const on = ch === s.sel;
    g.fillStyle = on ? '#2a4f9a' : '#ffffff';
    g.fillRect(x, y, CW, CH);
    g.strokeStyle = '#888888';
    g.lineWidth = 1;
    g.strokeRect(x + 0.5, y + 0.5, CW, CH);
    g.fillStyle = on ? '#ffffff' : '#000000';
    g.fillText(ch, x + CW / 2, y + CH / 2 + 1);
  };
  for (let c = 0; c < RECENT; c++) {
    if (rec[c]) cell(PAD + c * CW, RY, rec[c]);
  }
  const chars = s.set.chars;
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const ch = chars[(s.top + r) * COLS + c];
      if (ch) cell(PAD + c * CW, GY + r * CH, ch);
    }
  }
  if (total <= ROWS) return;
  const x = PAD + GRIDW + 4, h = ROWS * CH;
  g.fillStyle = '#bbbbbb';
  g.fillRect(x, GY, SB, h);
  const th = Math.max(16, h * ROWS / total);
  g.fillStyle = '#555555';
  g.fillRect(x, GY + (h - th) * s.top / (total - ROWS), SB, th);
}
