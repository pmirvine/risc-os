// RulerPaint - how ./Ruler draws itself: the desk grey, the page
// (its margins grey, the text white), the ticks and inch numbers of
// ../RulerMath.ticks (unsigned, counting out from the left margin as
// Word shows them; the margin itself has none: its edge shows it),
// the scale's ticks (the default tab stops: grey marks at the foot),
// and the markers ('down' a triangle at the top, 'up' at the bottom,
// 'box' under it; the one being dragged dark, a dotted line through
// it); tab stops (kinds tabL tabC tabR tabD tabBar, grey ones a
// style's) and the tab-type selector by ./RulerTabPaint.
//
//   paintRuler(g, r)   r: the Ruler (scale, height, pane.w, markers,
//                      dragging, selector, _x(twips) -> pane x)
// Draws on a canvas only: no desktop services.
import {toTwips, ticks} from '../RulerMath';
import {isTabKind} from '../RulerTabs';
import {paintTab, paintSelector} from './RulerTabPaint';

const GREY = '#c8c8c8', DESK = '#a0a0a0', INK = '#000000';

/** See the header. */
export function paintRuler(g, r) {
  const s = r.scale, h = r.height, w = r.pane.w;
  g.fillStyle = DESK;
  g.fillRect(0, 0, w, h);
  if (!s) return;
  const X = (px) => Math.round(px - s.scrollX);
  const [p0, p1] = s.page.map(X), [t0, t1] = s.text.map(X);
  g.fillStyle = GREY;
  g.fillRect(p0, 2, p1 - p0, h - 6);
  g.fillStyle = '#ffffff';
  g.fillRect(t0, 2, t1 - t0, h - 6);
  g.fillStyle = INK;
  g.font = '9px sans-serif';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  const from = toTwips(s.page[0] - s.origin, s.zoom);
  const to = toTwips(s.page[1] - s.origin, s.zoom);
  for (const t of ticks(from, to)) {
    const x = Math.round(r._x(t.at));
    if (t.label !== undefined) {
      g.fillText(String(t.label), x, h / 2 - 1);
    } else if (t.size !== 3) {
      const len = t.size === 2 ? 5 : 3;
      g.fillRect(x, Math.round(h / 2 - len / 2) - 1, 1, len);
    }
  }
  g.fillStyle = '#808080';
  for (const t of s.ticks || []) {
    g.fillRect(Math.round(r._x(t)), h - 5, 1, 3);
  }
  for (const m of r.markers) mark(g, r, m);
  paintSelector(g, r);
}

/** Marker m of ruler r. */
function mark(g, r, m) {
  const x = Math.round(r._x(m.twips)) + 0.5, h = r.height;
  const dragged = r.dragging === m.id;
  if (isTabKind(m.kind)) {
    paintTab(g, x - 0.5, h, m.kind, m.grey);
    if (dragged) line(g, x, h);
    return;
  }
  g.fillStyle = dragged ? '#808080' : '#e8e8e8';
  g.strokeStyle = INK;
  g.lineWidth = 1;
  g.beginPath();
  if (m.kind === 'down') {
    g.moveTo(x - 5, 0.5); g.lineTo(x + 5, 0.5); g.lineTo(x, 7.5);
  } else if (m.kind === 'up') {
    const y = Math.round(h * 0.8) - 0.5;
    g.moveTo(x - 5, y); g.lineTo(x + 5, y); g.lineTo(x, y - 7);
  } else {
    const y = Math.round(h * 0.8) + 0.5;
    g.rect(x - 5, y, 10, h - y - 1);
  }
  g.closePath();
  g.fill();
  g.stroke();
  if (dragged) line(g, x, h);
}

/** The dotted line through a marker being dragged. */
function line(g, x, h) {
  g.strokeStyle = INK;
  g.lineWidth = 1;
  g.setLineDash([2, 2]);
  g.beginPath();
  g.moveTo(x, 0); g.lineTo(x, h);
  g.stroke();
  g.setLineDash([]);
}

