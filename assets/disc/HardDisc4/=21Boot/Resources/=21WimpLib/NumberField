// NumberField - reading and writing what a number field holds (the
// size field of a toolbar, say).
//
//   parseNumber(text, {min, max, step, unit}) -> the number, or null
//       text: a plain decimal number ('11', '11.5', '.5'), spaces
//       around it allowed, then unit if one is given ('12pt', any
//       case); no sign, exponent or other characters. The number is
//       rounded to the nearest step (if step > 0), then clamped to
//       min..max
//   formatNumber(n, decimals) -> n with at most decimals places and
//       no trailing zeros ('2', '2.13'); '' for no number
//   halfPoints(text) -> a font size in half-points (as Word stores
//       it): points, to the nearest half point, clamped to 1..400
//       points ('11.5' -> 23); null when text is not a number
//   formatPoints(pt) -> points to the nearest half point ('11',
//       '11.5'); '' for no size (a mixed selection)
// Pure JavaScript.

const NUM = /^(\d+(?:\.\d*)?|\.\d+)$/;

/** See the header. */
export function parseNumber(text, opts = {}) {
  const {min = -Infinity, max = Infinity, step = 0, unit = ''} = opts;
  if (typeof text !== 'string') return null;
  let s = text.trim();
  if (unit && s.toLowerCase().endsWith(unit.toLowerCase())) {
    s = s.slice(0, -unit.length).trim();
  }
  if (!NUM.test(s)) return null;
  let n = Number(s);
  if (!Number.isFinite(n)) n = max;
  if (step > 0) n = Math.round(n / step) * step;
  return Math.min(Math.max(n, min), max);
}

/** See the header. */
export function formatNumber(n, decimals = 1) {
  if (typeof n !== 'number' || !Number.isFinite(n)) return '';
  const s = n.toFixed(decimals);
  return s.includes('.') ? s.replace(/\.?0+$/, '') : s;
}

/** See the header. */
export function halfPoints(text) {
  const p = parseNumber(text, {min: 1, max: 400, step: 0.5,
    unit: 'pt'});
  return p === null ? null : Math.round(p * 2);
}

/** See the header. */
export function formatPoints(pt) {
  if (typeof pt !== 'number' || !Number.isFinite(pt)) return '';
  return formatNumber(Math.round(pt * 2) / 2, 1);
}
