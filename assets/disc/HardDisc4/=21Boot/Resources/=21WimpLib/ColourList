// ColourList - the colours a colour popup offers (./Ui/ColourPopup):
//
//   SWATCHES       40 colours as 'RRGGBB', COLS (8) across, ROWS (5)
//                  down: greys from white to black; Word's ten
//                  standard colours (dark red, red, orange, yellow,
//                  light green, green, light blue, blue, dark blue,
//                  purple) and six lights; darks; Office's theme
//                  accents
//   swatchAt(col, row) -> the colour there, or null outside the grid
//   parseHex(text) -> 'RRGGBB' (upper case) from 'rrggbb', '#rrggbb'
//                  or 'rgb' (each digit doubled), or null
//   cssOf(value)   -> a CSS colour for 'RRGGBB' or 'auto' (black), or
//                  null
// Pure JavaScript.

export const COLS = 8, ROWS = 5;

export const SWATCHES = Object.freeze([
  'FFFFFF', 'F2F2F2', 'D9D9D9', 'BFBFBF', '7F7F7F', '595959', '404040',
  '000000',
  'C00000', 'FF0000', 'FFC000', 'FFFF00', '92D050', '00B050', '00B0F0',
  '0070C0',
  '002060', '7030A0', 'FFC7CE', 'FFE699', 'FFF2CC', 'E2EFDA', 'DDEBF7',
  'E4DFEC',
  '843C0C', 'C55A11', 'BF8F00', '548235', '2F5597', '1F4E79', '7F6000',
  '3A3838',
  '4472C4', 'ED7D31', 'A5A5A5', 'FFD966', '5B9BD5', '70AD47', '264478',
  '9E480E',
]);

/** See the header. */
export function swatchAt(col, row) {
  if (!Number.isInteger(col) || !Number.isInteger(row)) return null;
  if (col < 0 || row < 0 || col >= COLS || row >= ROWS) return null;
  return SWATCHES[row * COLS + col];
}

/** See the header. */
export function parseHex(text) {
  if (typeof text !== 'string') return null;
  let s = text.trim().replace(/^#/, '');
  if (/^[0-9a-f]{3}$/i.test(s)) s = s.replace(/./g, (c) => c + c);
  return /^[0-9a-f]{6}$/i.test(s) ? s.toUpperCase() : null;
}

/** See the header. */
export function cssOf(value) {
  if (value === 'auto') return '#000000';
  const h = typeof value === 'string' && /^[0-9a-f]{6}$/i.test(value)
    ? value : null;
  return h ? '#' + h.toLowerCase() : null;
}
