// PdfColour - CSS colour strings as a PDF context reads them (the
// fillStyle and strokeStyle the painters set; ./PdfSink in !Letters).
//
//   parseColour(s) -> {r, g, b, a} | null
//       r, g, b 0..255 (not rounded), a 0..1. Reads #rgb, #rgba,
//       #rrggbb, #rrggbbaa, rgb() / rgba() (commas or spaces, a
//       '/ alpha' after spaces, numbers or percentages, clamped),
//       and the names black, white, transparent (a = 0) and the
//       CSS basic sixteen plus orange and grey. Any case, spaces
//       around. null for anything else (hsl(), exponents, NaN,
//       a missing part). Read by hand, no regular expressions:
//       linear in the length of s
//   rgbOf({r, g, b}) -> 'r g b'  the PDF components 0..1 through
//       ./PdfWrite num, for rg / RG
//
// Pure: no desktop services.
import {num} from './PdfWrite';

const NAMES = new Map([
  ['black', [0, 0, 0]], ['white', [255, 255, 255]],
  ['red', [255, 0, 0]], ['lime', [0, 255, 0]],
  ['green', [0, 128, 0]], ['blue', [0, 0, 255]],
  ['yellow', [255, 255, 0]], ['aqua', [0, 255, 255]],
  ['fuchsia', [255, 0, 255]], ['silver', [192, 192, 192]],
  ['gray', [128, 128, 128]], ['grey', [128, 128, 128]],
  ['maroon', [128, 0, 0]], ['olive', [128, 128, 0]],
  ['purple', [128, 0, 128]], ['teal', [0, 128, 128]],
  ['navy', [0, 0, 128]], ['orange', [255, 165, 0]],
]);

const isSpace = (c) => c === ' ' || c === '\t' || c === '\n' ||
  c === '\r' || c === '\f';

/** The value of one hex digit, or -1. */
function hexDigit(c) {
  const n = c.charCodeAt(0);
  if (n >= 48 && n <= 57) return n - 48;
  if (n >= 97 && n <= 102) return n - 87;
  if (n >= 65 && n <= 70) return n - 55;
  return -1;
}

/** #rgb, #rgba, #rrggbb, #rrggbbaa (s without the #). */
function hexColour(s) {
  const n = s.length;
  if (n !== 3 && n !== 4 && n !== 6 && n !== 8) return null;
  const d = [];
  for (const c of s) {
    const v = hexDigit(c);
    if (v < 0) return null;
    d.push(v);
  }
  const at = (i) => n < 6 ? d[i] * 17 : d[2 * i] * 16 + d[2 * i + 1];
  const a = n === 4 || n === 8 ? at(3) / 255 : 1;
  return {r: at(0), g: at(1), b: at(2), a};
}

/** A plain decimal (optional sign, digits, one point), or NaN. */
function decimal(s) {
  let i = 0, digits = 0, dot = false;
  if (s[0] === '+' || s[0] === '-') i = 1;
  for (; i < s.length; i++) {
    const c = s[i];
    if (c === '.' && !dot) dot = true;
    else if (c >= '0' && c <= '9') digits++;
    else return NaN;
  }
  return digits ? Number(s) : NaN;
}

/** A number or percentage of full (NaN when unreadable). */
function part(s, full) {
  if (s.endsWith('%')) return decimal(s.slice(0, -1)) * full / 100;
  return decimal(s);
}

const clamp = (v, hi) => Math.min(Math.max(v, 0), hi);

/** The inside of rgb( ... ). */
function rgbArgs(s) {
  let parts;
  if (s.indexOf(',') >= 0) {
    parts = s.split(',').map((x) => x.trim());
  } else {
    parts = [];
    let cur = '';
    for (const c of s) {
      if (isSpace(c) || c === '/') {
        if (cur) parts.push(cur);
        cur = '';
        if (c === '/') parts.push('/');
      } else cur += c;
    }
    if (cur) parts.push(cur);
    if (parts.length === 5 && parts[3] === '/') parts.splice(3, 1);
    else if (parts.length !== 3) return null;
  }
  if (parts.length !== 3 && parts.length !== 4) return null;
  const v = parts.map((x, i) => part(x, i < 3 ? 255 : 1));
  if (v.some((x) => Number.isNaN(x))) return null;
  return {r: clamp(v[0], 255), g: clamp(v[1], 255),
    b: clamp(v[2], 255), a: v.length === 4 ? clamp(v[3], 1) : 1};
}

/** See the header. */
export function parseColour(s) {
  if (typeof s !== 'string') return null;
  const t = s.trim().toLowerCase();
  if (t === 'transparent') return {r: 0, g: 0, b: 0, a: 0};
  const named = NAMES.get(t);
  if (named) return {r: named[0], g: named[1], b: named[2], a: 1};
  if (t[0] === '#') return hexColour(t.slice(1));
  let open = 0;
  if (t.startsWith('rgba(')) open = 5;
  else if (t.startsWith('rgb(')) open = 4;
  if (!open || !t.endsWith(')')) return null;
  return rgbArgs(t.slice(open, -1));
}

/** See the header. */
export function rgbOf(c) {
  return num(c.r / 255) + ' ' + num(c.g / 255) + ' ' + num(c.b / 255);
}
