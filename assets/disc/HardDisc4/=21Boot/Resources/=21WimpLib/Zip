// Zip - reads and writes zip files (and so .docx files) in pure
// JavaScript. It uses only DecompressionStream / CompressionStream,
// so it runs in the browser desktop and under Node for the tests.
//
//   await readZip(bytes, { maxTotal, maxRatio })
//        -> Map of name -> Uint8Array, in directory order; folders
//           are left out. Throws ZipError (see ./ZipError).
//   await writeZip(parts, { date })
//        -> Uint8Array; parts is a Map or an array of [name, bytes];
//           the same parts and date always give the same bytes.
//   ZipError, with err.code
//
// Not supported: zip64, encryption, split archives, methods other
// than stored and deflate. Names with '..' or a leading '/' are
// refused so that unpacking can never leave its folder.
export { ZipError } from './ZipError';
export { readZip } from './ZipRead';
export { writeZip } from './ZipWrite';
