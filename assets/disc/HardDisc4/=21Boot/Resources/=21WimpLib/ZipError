// ZipError - what the zip reader throws for a file it cannot use.
//
//   err.code   one of:
//     'truncated'   the file ends before the archive does
//     'bad-crc'     an entry's data does not match its checksum
//     'zip64'       the archive needs the 4 GB+ zip64 extensions
//     'encrypted'   an entry is password protected
//     'too-big'     it would unpack to more than the limits allow
//     'bad-method'  an entry uses a compression other than 0 or 8
//     'not-zip'     not a zip file, or it has an unsafe name

export class ZipError extends Error {
  /**
   * @param {string} code see above
   * @param {string} [message] defaults to the code
   */
  constructor(code, message) {
    super(message || code);
    this.name = 'ZipError';
    this.code = code;
  }
}
