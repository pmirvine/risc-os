// DialogIcons - the icons of a Ui/Dialog box, from where
// ./DialogLayout put them.
//
//   iconSpecs(boxes, list, {enter, groups}) -> icon specs for
//       task.createWindow (boxes: DialogLayout's; list: its
//       controls(rows)). Icon names: a control's field is its name
//       (a label with none: 'text:<i>'); 'label:<name>',
//       'arrow:<name>' (a popup's menu arrow), 'after:<name>';
//       the bottom row 'button:<text>' (enter: the default one, R6,3).
//       groups: Map group -> ESG (1..31; options are ESG 0)
//   esgOf(list) -> that Map, groups numbered in order
// (../DialogValues reads and sets what the icons show.)
// Pure JavaScript.

const MAXTEXT = 1000;

/** See the header. */
export function esgOf(list) {
  const m = new Map();
  for (const c of list) {
    if (c.kind === 'radio' && !m.has(c.group)) {
      m.set(c.group, m.size + 1);
    }
  }
  return m;
}

/** The validation string and maxLen of a writable control. */
function writable(c) {
  if (c.kind === 'length') {
    return ['R7;A-0-9. "inptINPT', 16];
  }
  if (c.kind === 'number') {
    const u = String(c.unit ?? '').replace(/[^A-Za-z]/g, '');
    const letters = u ?
      ` ${u.toLowerCase()}${u.toUpperCase()}` : '';
    const minus = c.min < 0 ? '-' : '';
    return [`R7;A${minus}0-9.${letters}`, 16];
  }
  const v = String(c.validation ?? '').replace(/^R\d[^;]*;?/i, '');
  const max = Number.isInteger(c.maxLen) && c.maxLen > 0 ?
    Math.min(c.maxLen, MAXTEXT) : 256;
  return [v ? `R7;${v}` : 'R7', max];
}

/** The spec of one box. */
function spec(b, c, i, groups) {
  const at = {x: b.x, y: b.y, w: b.w, h: b.h, vcentre: true,
    help: c.help};
  switch (b.part) {
    case 'label':
      return {...at, text: b.text, name: `label:${c.name}`,
        rjustify: true};
    case 'after': return {...at, text: b.text, name: `after:${c.name}`};
    case 'arrow':
      return {...at, sprite: 'gright', name: `arrow:${c.name}`,
        button: 'click', validation: 'R5;Sgright,pgright'};
    default:
  }
  const name = c.name ?? `text:${i}`;
  switch (c.kind) {
    case 'label': return {...at, text: b.text, name};
    case 'text': case 'length': case 'number': {
      const [validation, maxLen] = writable(c);
      return {...at, text: '', name, border: true, filled: true, bg: 0,
        button: 'writable', validation, maxLen};
    }
    case 'option': case 'radio': {
      const s = c.kind === 'option' ? 'opt' : 'radio';
      return {...at, text: b.text, name, sprite: `${s}off`,
        validation: `S${s}off,${s}on`, button: 'radio',
        esg: c.kind === 'option' ? 0 : groups.get(c.group)};
    }
    case 'popup':
      return {...at, text: '', name, border: true, filled: true, bg: 0,
        button: 'click', validation: 'R2'};
    case 'colour':
      return {...at, text: '', name, border: true, button: 'click',
        validation: 'R5'};
    default:
      return {...at, text: b.text, name, border: true, filled: true,
        hcentre: true, button: 'click', validation: 'R5,3'};
  }
}

/** See the header. */
export function iconSpecs(boxes, list, {enter, groups} = {}) {
  const g = groups ?? esgOf(list);
  return boxes.map((b) => {
    if (b.part === 'button') {
      return {x: b.x, y: b.y, w: b.w, h: b.h, text: b.text,
        name: `button:${b.text}`, border: true, filled: true,
        hcentre: true, vcentre: true, button: 'click',
        validation: b.text === enter ? 'R6,3' : 'R5,3'};
    }
    return spec(b, list[b.ci], b.ci, g);
  });
}
