// GameLib - Options: a game's settings, described by a list.
//
// A game lists its options as {key, label, values, names}: the
// allowed values and how each is shown. These helpers take that list
// (and the defaults) as arguments, so every game can use them. A
// saved object only counts for values the list allows.

const find = (options, key) => options.find((o) => o.key === key);

/** The defaults, with each value the object has that is allowed. */
export function sanitise(options, defaults, obj) {
  const out = { ...defaults };
  if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
    for (const o of options) {
      if (Object.hasOwn(obj, o.key) && o.values.includes(obj[o.key])) {
        out[o.key] = obj[o.key];
      }
    }
  }
  return out;
}

/** Move a setting to the next (step 1) or previous (-1) value. */
export function stepOption(options, s, key, step) {
  const o = find(options, key);
  const i = o.values.indexOf(s[key]);
  const n = o.values.length;
  s[key] = o.values[(((i < 0 ? 0 : i) + step) % n + n) % n];
  return s[key];
}

/** How a setting's current value is shown. */
export function optionName(options, s, key) {
  const o = find(options, key);
  const i = o.values.indexOf(s[key]);
  return i < 0 ? String(s[key]) : o.names[i];
}
