// GameLib - Pad: the first gamepad, as named presses.
//
// pollPad() reads the standard-mapping gamepad that getGamepads()
// gives it and names what is down: PadUp, PadDown, PadLeft, PadRight
// (the D-pad, or the left stick pushed past half way along its
// dominant axis), PadA, PadB and PadStart. It compares with the set
// held last time to say which went down just now.

const BUTTONS = [[12, 'PadUp'], [13, 'PadDown'], [14, 'PadLeft'],
  [15, 'PadRight'], [0, 'PadA'], [1, 'PadB'], [9, 'PadStart']];
const DEAD = 0.5;

/** {presses: [names newly down], held: Set of names down}. */
export function pollPad(getGamepads, prev) {
  const held = new Set();
  let pad = null;
  try {
    for (const p of getGamepads?.() ?? []) {
      if (p && p.connected !== false) { pad = p; break; }
    }
  } catch { pad = null; }
  if (pad) {
    const b = pad.buttons ?? [];
    for (const [i, name] of BUTTONS) {
      if (b[i] && (b[i].pressed || b[i].value > 0.5)) held.add(name);
    }
    const ax = pad.axes?.[0] ?? 0, ay = pad.axes?.[1] ?? 0;
    if (Math.abs(ax) >= Math.abs(ay)) {
      if (ax > DEAD) held.add('PadRight');
      else if (ax < -DEAD) held.add('PadLeft');
    } else if (ay > DEAD) held.add('PadDown');
    else if (ay < -DEAD) held.add('PadUp');
  }
  const presses = [...held].filter((n) => !prev?.has(n));
  return { presses, held };
}
