// Dates - days written as keys: '2026-09-25'. Keys sort and compare
// as text ('2026-09-25' < '2026-10-01'), make good names for things
// in a Map, and go into files as they are. JavaScript's Date is used
// only inside this module, and always at midday, so that changes to
// and from summer time never move a day.
//
//   today()                       '2026-09-25'
//   keyOf(date) / dateOf(key)     a Date to a key and back
//   addDays(key, n), addMonths(key, n), addYears(key, n)
//   daysBetween(a, b)             whole days from a to b
//   weekday(key)                  0 Monday ... 6 Sunday
//   startOfWeek(key)              the Monday of its week
//   monthGrid(year, month)        6 weeks x 7 keys (Mondays first)
//   daysInMonth(year, month)      (months are 1-12 here)
//   parseDay('25/12/2026')        a key, or null ('2026-12-25' too)
//   parseTime('9:30')             '09:30', or null
//   format(key, '%W3 %ZDY %M3')   the desktop's formatTime codes
import { formatTime } from 'riscos';

const two = (n) => String(n).padStart(2, '0');

export function keyOf(d) {
  return `${d.getFullYear()}-${two(d.getMonth() + 1)}-` +
    two(d.getDate());
}
export function dateOf(key) {
  const [y, m, d] = key.split('-').map(Number);
  return new Date(y, m - 1, d, 12);            // midday
}
export const today = () => keyOf(new Date());

export function addDays(key, n) {
  const d = dateOf(key);
  d.setDate(d.getDate() + n);
  return keyOf(d);
}
export function addMonths(key, n) {
  const [y, m, d] = key.split('-').map(Number);
  const first = new Date(y, m - 1 + n, 1, 12);
  // 31 January + 1 month is 28 (or 29) February, not 3 March
  const day = Math.min(d, daysInMonth(first.getFullYear(),
    first.getMonth() + 1));
  first.setDate(day);
  return keyOf(first);
}
export const addYears = (key, n) => addMonths(key, 12 * n);

export function daysBetween(a, b) {
  return Math.round((dateOf(b) - dateOf(a)) / 86400000);
}
export const weekday = (key) => (dateOf(key).getDay() + 6) % 7;
export const startOfWeek = (key) => addDays(key, -weekday(key));
export function daysInMonth(year, month) {
  return new Date(year, month, 0).getDate();   // day 0 of the next
}

/** The weeks of a month for a calendar: 6 rows of 7 keys. */
export function monthGrid(year, month) {
  let day = startOfWeek(`${year}-${two(month)}-01`);
  const weeks = [];
  for (let w = 0; w < 6; w++) {
    const week = [];
    for (let i = 0; i < 7; i++) {
      week.push(day);
      day = addDays(day, 1);
    }
    weeks.push(week);
  }
  return weeks;
}

/** '25/12/2026' or '2026-12-25' as a key; null if it isn't a date. */
export function parseDay(text) {
  const s = String(text).trim();
  let m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
  const [y, mo, d] = m ? [+m[3], +m[2], +m[1]]
    : (m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s))
      ? [+m[1], +m[2], +m[3]] : [];
  if (!y || mo < 1 || mo > 12 || d < 1) return null;
  if (d > daysInMonth(y, mo)) return null;     // 31/02/2026 ...
  return `${y}-${two(mo)}-${two(d)}`;
}
/** '9:30', '09.30' or '0930' as '09:30'; null if it isn't a time. */
export function parseTime(text) {
  const m = /^(\d{1,2})[:.]?(\d\d)$/.exec(String(text).trim());
  if (!m || +m[1] > 23 || +m[2] > 59) return null;
  return `${two(+m[1])}:${m[2]}`;
}

export const format = (key, fmt) => formatTime(fmt, dateOf(key));
