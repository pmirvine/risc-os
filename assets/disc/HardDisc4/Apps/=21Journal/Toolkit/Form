// Form - a dialogue box made from a list of fields.
//
//   const form = new Form(task, {
//     title: 'Contact',
//     fields: [
//       { name: 'first', label: 'First name' },    a line of text
//       { name: 'notes', label: 'Notes', lines: 3 },    several lines
//       { name: 'kind', label: 'Kind', choices: ['A', 'B'] },  pop-up
//       { name: 'vip', label: 'Favourite', option: true },     on/off
//       { column: 2 },         (the fields after it: a new column)
//     ],
//     message: 'A line of text above the fields',   optional
//     buttons: ['Cancel', 'Save'],   the last is the default (Return)
//     check: (values) => null or { field: 'first', message: '...' },
//   });
//   const values = await form.ask(values);  -> the new values or null
//   form.run(values) -> { button, values } or null (Cancel, Escape)
//   form.get() / form.set(values)
// Buttons named in 'stay' (e.g. ['Default']) don't close the box:
// they emit 'button' instead.
import { wimp, Menu, TextArea, reportError } from 'riscos';
import { Emitter } from './Emitter';

const LABEL = 110, FIELD = 220, ROW = 34, GAP = 12;

export class Form extends Emitter {
  constructor(task, opts) {
    super();
    this.opts = opts;
    this.fields = [];                  // {spec, icon, area, popup}
    const icons = [];
    let x = GAP, y = GAP, bottom = 0, right = 0;
    if (opts.message) {
      const w = opts.message.length * 8 + 16;
      icons.push({ x: GAP, y, w, h: 28, text: opts.message });
      y += ROW + 6;
      bottom = y;
      right = GAP + w;
    }
    const top = y;                     // where columns start
    for (const f of opts.fields) {
      if (f.column) { x = right + GAP; y = top; continue; }
      const fx = x + LABEL, fw = f.width ?? FIELD;
      const h = f.lines ? f.lines * 19 + 10 : 28;
      const entry = { spec: f, y, x: fx, w: fw, h };
      if (f.option) {
        icons.push({ x: fx, y, w: fw, h: 28, text: f.label,
          sprite: 'optoff', validation: 'Soptoff,opton',
          button: 'radio', name: f.name, help: f.help });
      } else {
        icons.push({ x, y, w: LABEL - 8, h: 28, text: f.label,
          rjustify: true });
        if (!f.lines) {
          icons.push({ x: fx, y, w: f.choices ? fw - 32 : fw, h: 28,
            text: '', border: true, filled: true,
            bg: f.choices ? 1 : 0, maxLen: f.maxLen ?? 100,
            button: f.choices ? 0 : 'writable',
            validation: f.allowed ? 'A' + f.allowed : '',
            name: f.name, help: f.help });
        }
        if (f.choices) {
          icons.push({ x: fx + fw - 28, y, w: 28, h: 28,
            sprite: 'gright', button: 'click', name: f.name + '!',
            help: 'Click SELECT to choose from a menu.' });
        }
      }
      this.fields.push(entry);
      y += h + 6;
      bottom = Math.max(bottom, y);
      right = Math.max(right, fx + fw);
    }
    // the buttons, bottom right: the last is the default
    const names = opts.buttons ?? ['Cancel', 'OK'];
    const bw = (b) => Math.max(80, b.length * 9 + 24);
    const all = names.reduce((t, b) => t + bw(b) + GAP, GAP);
    right = Math.max(right, all);      // (room for all the buttons)
    let bx = right;
    const by = bottom + GAP;
    for (const b of [...names].reverse()) {
      const w = bw(b), def = b === names.at(-1);
      bx -= w;
      icons.push({ x: bx, y: def ? by - 2 : by, w, h: def ? 40 : 36,
        text: b, border: true, filled: true, hcentre: true,
        button: 'click', validation: def ? 'R6,3' : 'R5,3',
        name: 'button:' + b });
      bx -= GAP;
    }
    const W = right + GAP, H = by + 40 + GAP;
    const win = this.win = task.createWindow({
      title: opts.title ?? 'Form', w: W, h: H, extent: { w: W, h: H },
      flags: { title: true, moveable: true }, returnNext: true,
      icons, help: opts.help,
    });
    // several lines: the desktop's TextArea
    for (const e of this.fields) {
      e.icon = win.iconByName(e.spec.name);
      if (e.spec.lines) {
        e.area = new TextArea(win,
          { x: e.x, y: e.y, w: e.w, h: e.h });
      }
    }
    win.on('click', (ev) => this.click(ev));
    win.on('key', (ev) => this.key(ev));
  }

  // ------------------------------------------------ values
  get() {
    const v = {};
    for (const { spec, icon, area } of this.fields) {
      if (area) v[spec.name] = area.text;
      else if (spec.option) v[spec.name] = icon.selected;
      else v[spec.name] = icon.text.trim();
    }
    return v;
  }
  set(values) {
    for (const { spec, icon, area } of this.fields) {
      const x = values[spec.name];
      if (area) area.text = x ?? '';
      else if (spec.option) icon.setState({ selected: !!x });
      else icon.setText(String(x ?? ''));
    }
  }

  // ------------------------------------------------ opening
  /** Open the box: resolves { button, values }, or null (Cancel). */
  run(values = {}) {
    this.set(values);
    const w = this.win;
    w.open({ x: Math.round((wimp.width - w.w) / 2),
      y: Math.round((wimp.height - w.h) / 3), behind: 'top' });
    const first = this.fields.find((e) => e.icon?.writable);
    if (first) wimp.setCaret(w, first.icon);
    return new Promise((resolve) => { this.done = resolve; });
  }
  async ask(values) {
    const r = await this.run(values);
    return r ? r.values : null;
  }
  finish(result) {
    this.win.close();
    const done = this.done;
    this.done = null;
    done?.(result);
  }
  press(button) {
    if ((this.opts.stay ?? []).includes(button)) {
      this.emit('button', button);
      return;
    }
    if (button === 'Cancel') { this.finish(null); return; }
    const values = this.get();
    const bad = this.opts.check?.(values);
    if (bad) {
      reportError(bad.message);
      const e = this.fields.find((f) => f.spec.name === bad.field);
      if (e?.area) e.area.focus();
      else if (e?.icon) wimp.setCaret(this.win, e.icon);
      return;
    }
    this.finish({ button, values });
  }

  // ------------------------------------------------ mouse and keys
  click(ev) {
    const name = ev.icon?.name ?? '';
    if (name.startsWith('button:')) this.press(name.slice(7));
    else if (name.endsWith('!')) this.popup(name.slice(0, -1), ev);
    return undefined;
  }
  popup(name, ev) {
    const e = this.fields.find((f) => f.spec.name === name);
    const menu = new Menu(e.spec.label, e.spec.choices.map((c) => ({
      text: c, ticked: () => e.icon.text === c,
      action: () => e.icon.setText(c),
    })));
    const p = this.win.workToScreen(e.x + e.w, e.y);
    wimp.menus.open(menu, p.x, p.y, { task: this.win.task });
  }
  key(ev) {
    if (ev.code === 27) { this.press('Cancel'); return true; }
    if (ev.code === 13) {                   // Return: the default
      this.press((this.opts.buttons ?? ['OK']).at(-1));
      return true;
    }
    return undefined;
  }
}
