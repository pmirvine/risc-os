| !Boot file for !Browse: its icons, URI and URL files, and web addresses from other programs
IconSprites <Obey$Dir>.!Sprites
Set File$Type_F91 URI
Set File$Type_B28 URL
If "<Alias$URLOpen_http>" = "" Then Set Alias$URLOpen_http Run <Obey$Dir>.!Run -url %%*0
If "<Alias$URLOpen_https>" = "" Then Set Alias$URLOpen_https Run <Obey$Dir>.!Run -url %%*0
