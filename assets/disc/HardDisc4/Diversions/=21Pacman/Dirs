// !Pacman - Dirs: the four directions and the four ghosts' numbers.
//
// The directions are numbered in the order a ghost breaks a tie
// (up, left, down, right), so the reverse of d is d ^ 2. DX and DY
// give the step one tile (or one pixel) in each direction.

export const UP = 0, LEFT = 1, DOWN = 2, RIGHT = 3;
export const DX = [0, -1, 0, 1];
export const DY = [-1, 0, 1, 0];
export const NAMES = ['up', 'left', 'down', 'right'];

/** The opposite direction. */
export const reverse = (d) => d ^ 2;

export const BLINKY = 0, PINKY = 1, INKY = 2, CLYDE = 3;
