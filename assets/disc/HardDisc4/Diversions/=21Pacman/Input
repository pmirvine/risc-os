// !Pacman - Input: small helpers the shell uses for focus and pad.
//
// No desktop in here. Quiet is the short spell after the shell itself
// opens, closes or switches the display, when the window losing the
// caret (or leaving browser full screen) is ours doing and not the
// player going away. syncPad turns the gamepad's buttons into key
// presses and releases on the game's Keys. wantFor works out the
// direction Pac-Man is asked to take.

import { pollPad } from 'gamelib/Pad';

export class Quiet {
  constructor(ms = 300, now = () => performance.now()) {
    Object.assign(this, { ms, now });
    this.until = 0;
  }

  /** The shell is about to change the display. */
  settle() { this.until = this.now() + this.ms; }

  /** True while focus changes are our own. */
  get active() { return this.now() < this.until; }
}

/** Poll the pads; the new set of held button names is returned. */
export function syncPad(keys, held,
  pads = () => navigator.getGamepads?.()) {
  const r = pollPad(pads, held);
  for (const n of r.presses) keys.keyDown({ code: n });
  for (const n of held) {
    if (!r.held.has(n)) keys.keyUp({ code: n });
  }
  return r.held;
}

// In the order of the engine's numbers: up 0, left 1, down 2, right 3.
export const DIRS = ['up', 'left', 'down', 'right'];

/** The wanted direction: the latest one held, else the old want. */
export function wantFor(keys, want) {
  const n = keys.latest(DIRS);
  return n === null ? want : DIRS.indexOf(n);
}
