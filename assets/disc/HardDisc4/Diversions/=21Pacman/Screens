// !Pacman - Screens: which screen is showing and what a key does.
//
// One object the shell talks to, with no desktop in it: the shell
// (!RunImage) passes in `app`, which has
//   keys        the Keys of the game (ACTIONS below)
//   settings    {lives, bonus, ...}
//   scores      {table, lastName}, the high scores (see Scores)
//   seed()      a seed number for a new game
//   toDesktop() leave the game and show the desktop
//   viewSource() open the program's files in !JsEdit
//   changeSetting(key)   a setting was changed: apply and save it
//   toggleBrowserFull()   browser full screen on or off (the F key)
//   saveScores()   the table has changed: save it
// Screens are 'title', 'play', 'pause' (the Escape menu over the
// game), 'settings', 'scores', 'help' (the last two are pages),
// 'entry' (typing a name; `typing` is true so F is a letter) and
// 'attract-demo' / 'attract-scores' (see Attract). Each
// display frame the shell calls frame(presses), then tick() for
// every 60 Hz tick due, then draw(surface). P pauses a game by
// itself (paused); losing the keyboard focus does the same.
// When a game ends, gameFinished(game) says what comes next: name
// entry if it made the top ten (never for a demo game), else the
// title.

import { Game } from './Game';
import { drawGame } from './Render';
import { Menu } from './Menu';
import { Title } from './Title';
import { OPTIONS } from './Settings';
import { HELP, drawPage, drawScores, drawEntry } from './Pages';
import { Entry } from './Entry';
import { Attract } from './Attract';
import { SIZE, record } from './Scores';
import { qualifies, today } from 'gamelib/ScoreTable';
import { stepOption, optionName } from 'gamelib/Options';
import { rgb } from 'gamelib/Surface';
import { drawText } from 'gamelib/Font';
import { COLOURS } from './Theme';

export const ACTIONS = {
  up: ['ArrowUp', 'KeyW', 'Quote', 'PadUp'],
  down: ['ArrowDown', 'KeyS', 'Slash', 'PadDown'],
  left: ['ArrowLeft', 'KeyA', 'KeyZ', 'PadLeft'],
  right: ['ArrowRight', 'KeyD', 'KeyX', 'PadRight'],
  pause: ['KeyP', 'PadStart'],
  menu: ['Escape', 'PadB'],
  full: ['KeyF'],
  select: ['Enter', 'Space', 'PadA'],
};

// In the order of the engine's numbers: up 0, left 1, down 2, right 3.
export const DIRS = ['up', 'left', 'down', 'right'];

/** The wanted direction: the latest one held, else the old want. */
export function wantFor(keys, want) {
  const n = keys.latest(DIRS);
  return n === null ? want : DIRS.indexOf(n);
}

export class Screens {
  constructor(app) {
    this.app = app;
    this.game = null;
    this.want = -1;
    this.paused = false;
    this.typing = false;       // a name is being typed: F is a letter
    this.frames = 0;
    this.attract = new Attract(app);
    this.title();
  }

  get table() { return this.app.scores?.table ?? []; }

  get menu() {
    return { title: this.titleScreen.menu, pause: this.pauseMenu,
      settings: this.settingsMenu }[this.name] ?? null;
  }

  title() {
    const a = this.app;
    this.name = 'title';
    this.game = null;
    this.attract.reset();
    this.titleScreen = new Title([
      { text: 'Play', action: () => this.play() },
      { text: 'High scores', action: () => this.page('scores') },
      { text: 'Settings', action: () => this.settings() },
      { text: 'How to play', action: () => this.page('help') },
      { text: 'View source', action: () => a.viewSource() },
      { text: 'Desktop', action: () => a.toDesktop() },
    ]);
  }

  play() {
    const s = this.app.settings;
    this.game = new Game({ seed: this.app.seed?.() ?? 1,
      lives: s.lives ?? 3, bonus: s.bonus ?? 10000 });
    this.game.high = this.table[0]?.score ?? 0;
    this.want = -1;
    this.paused = false;
    this.name = 'play';
  }

  openPause() {
    const c = () => { this.name = 'play'; this.paused = false; };
    this.name = 'pause';
    this.pauseMenu = new Menu([
      { text: 'Continue', action: c },
      { text: 'Restart', action: () => this.play() },
      { text: 'Settings', action: () => this.settings() },
      { text: 'Title', action: () => this.title() },
      { text: 'Desktop', action: () => this.app.toDesktop() },
    ], { y: 112 });
  }

  /** Show a text page ('scores' or 'help'); any key goes back. */
  page(name) { this.back = this.name; this.name = name; }

  /** The Settings screen, from the title or the pause menu. */
  settings() {
    const s = this.app.settings;
    const change = (key, d) => {
      stepOption(OPTIONS, s, key, d);
      this.app.changeSetting?.(key);
    };
    this.back = this.name;
    this.name = 'settings';
    this.settingsMenu = new Menu([...OPTIONS.map((o) => ({
      text: () => `${o.label}: ${optionName(OPTIONS, s, o.key)}`,
      action: () => change(o.key, 1), step: (d) => change(o.key, d),
    })), { text: 'Back', action: () => this.leave() }],
    { y: 80, step: 16 });
  }

  /** Back from Settings or a text page to where it was opened. */
  leave() { this.name = this.back; }

  /** The game is over (GAME OVER has shown): where next? */
  gameFinished(game) {
    this.title();
    if (game.demo || !qualifies(this.table, game.score, SIZE)) return;
    this.pending = { score: game.score, level: game.level };
    this.entry = new Entry(this.app.scores.lastName);
    this.name = 'entry';
    this.typing = true;
  }

  /** Name entered: into the table, saved, and show the table. */
  enter() {
    const { score, level } = this.pending;
    record(this.app.scores, this.entry.name, score, level, today());
    this.app.saveScores?.();
    this.typing = false;
    this.title();
    this.page('scores');
  }

  /** The key presses of this display frame ([{code, repeat}]). */
  frame(presses) {
    if (this.attract.frame(this, presses)) return;
    const keys = this.app.keys;
    let dir = -1;
    for (const p of presses) {
      if (this.name === 'entry') {
        if (this.entry.key(p) === 'done') this.enter();
        continue;
      }
      for (const name of keys.namesFor(p.code)) {
        const d = DIRS.indexOf(name);
        if (d >= 0) dir = d;
        this.action(name, p.repeat);
      }
    }
    if (dir >= 0 && this.name === 'play') {
      this.want = wantFor(keys, dir);
    }
  }

  action(name, repeat) {
    const m = this.menu;
    if (name === 'full' && !repeat && !this.typing) {
      this.app.toggleBrowserFull?.();
    } else if (this.name === 'scores' || this.name === 'help') {
      if (!repeat && ['select', 'menu', 'pause'].includes(name)) {
        this.leave();
      }
    } else if (this.name === 'play') {
      if (repeat) return;
      if (name === 'pause') this.paused = !this.paused;
      else if (name === 'menu') this.openPause();
    } else if (name === 'menu' && !repeat) {
      if (this.name === 'pause') {
        this.name = 'play';
        this.paused = false;
      }
      else if (this.name === 'settings') this.leave();
      else this.app.toDesktop();
    } else if (m && !(repeat && name === 'select')) m.press(name);
  }

  /** One 60 Hz tick: true if the game moved. */
  tick() {
    this.frames++;
    if (this.name === 'title') this.titleScreen.tick();
    if (this.attract.tick(this)) return false;
    if (this.name !== 'play' || this.paused) return false;
    this.game.tick({ want: this.want });
    if (this.game.state === 'over') this.gameFinished(this.game);
    return true;
  }

  draw(s) {
    if (this.name === 'title') return this.titleScreen.draw(s);
    if (this.name.endsWith('scores')) return drawScores(s, this.table);
    if (this.name === 'entry') {
      return drawEntry(s, this.pending.score, this.entry.text,
        this.frames);
    }
    if (this.name === 'help') return drawPage(s, 'HOW TO PLAY', HELP,
      'Return: back');
    if (this.back === 'title' && this.name === 'settings') {
      drawPage(s, 'SETTINGS', [], 'Left/right change, Esc back');
      return this.settingsMenu.draw(s);
    }
    const g = this.game;
    drawGame(s, g, g.frame);
    if (this.paused) {
      s.shade(0, 24, 224, 248, 0, 0.5);
      drawText(s, 'PAUSED', 112, 160, { align: 'centre',
        colour: rgb(...COLOURS.ready) });
    } else if (this.name === 'pause') {
      s.shade(0, 24, 224, 248, 0, 0.6);
      this.pauseMenu.draw(s);
    } else if (this.name === 'settings') {
      s.shade(0, 24, 224, 248, 0, 0.8);
      this.settingsMenu.draw(s);
    }
  }

  /** The keyboard focus went elsewhere: stop a game in progress. */
  blur() {
    if (this.name === 'play') this.paused = true;
    this.want = -1;
  }

  pointer(p) {
    if (!this.attract.pointer(this, p)) this.menu?.pointer(p);
  }
}
