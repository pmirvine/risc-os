// !Pacman - Menu: a list of choices drawn on the game surface.
//
// items are {text, action}; text may be a function when it changes
// (a setting's value, say). The menu is centred on x, its first item
// at y, step pixels apart. press('up' | 'down' | 'select') and
// pointer({type, x, y, button}) drive it ('left' and 'right' call an
// item's step(-1 or 1), for a setting), so keys, gamepad and mouse
// all work; the chosen item's action is called. The current item is
// yellow with an arrow.

import { rgb } from 'gamelib/Surface';
import { drawText, textWidth } from 'gamelib/Font';
import { COLOURS } from './Theme';

export class Menu {
  constructor(items, { x = 112, y = 0, step = 12 } = {}) {
    Object.assign(this, { items, x, y, step });
    this.sel = 0;
  }

  label(i) {
    const t = this.items[i].text;
    return typeof t === 'function' ? t() : t;
  }

  /** The box of item i, for drawing and for the pointer. */
  rect(i) {
    const w = textWidth(this.label(i)) + 8;
    return { x: this.x - (w >> 1), y: this.y + i * this.step, w,
      h: 10 };
  }

  /** A key action; true if the menu used it. */
  press(name) {
    const n = this.items.length;
    if (name === 'up') this.sel = (this.sel + n - 1) % n;
    else if (name === 'down') this.sel = (this.sel + 1) % n;
    else if (name === 'select') this.items[this.sel].action?.();
    else if (name === 'left' || name === 'right') {
      this.items[this.sel].step?.(name === 'left' ? -1 : 1);
    }
    else return false;
    return true;
  }

  /** A pointer event: moving over an item chooses it, SELECT acts. */
  pointer(p) {
    for (let i = 0; i < this.items.length; i++) {
      const r = this.rect(i);
      if (p.x < r.x || p.x >= r.x + r.w || p.y < r.y
        || p.y >= r.y + r.h) continue;
      this.sel = i;
      if (p.type === 'down' && (p.button ?? 'select') === 'select') {
        this.items[i].action?.();
      }
      return true;
    }
    return false;
  }

  draw(s) {
    this.items.forEach((_, i) => {
      const on = i === this.sel;
      const colour = rgb(...(on ? COLOURS.ready : COLOURS.text));
      const r = this.rect(i);
      drawText(s, this.label(i), this.x, r.y + 1,
        { colour, align: 'centre' });
      if (on) drawText(s, '>', r.x - 4, r.y + 1, { colour });
    });
  }
}
