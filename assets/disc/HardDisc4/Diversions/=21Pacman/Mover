// !Pacman - Mover: how many whole pixels an actor moves this frame.
//
// 100% speed is 1.262626 pixels a frame. Each actor keeps a whole
// number accumulator acc (millionths of a pixel): every frame it adds
// pct * STEP, moves floor(acc / UNIT) pixels and keeps the remainder,
// so the same speed always gives the same movement, with no floating
// point. Each of those pixels then runs the actor's per-pixel rules.

export const UNIT = 1e6, STEP = 12626;

/** Advance actor.acc by one frame at pct percent; whole pixels due. */
export function steps(actor, pct) {
  const acc = actor.acc + pct * STEP;
  const n = Math.floor(acc / UNIT);
  actor.acc = acc - n * UNIT;
  return n;
}
