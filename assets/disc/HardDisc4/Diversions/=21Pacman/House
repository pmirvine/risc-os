// !Pacman - House: who leaves the ghost house, and when.
//
// Only the first ghost still waiting counts the dots Pac-Man eats; it
// leaves when its own count reaches the level's limit. After a lost
// life one global counter takes over (Pinky at 7, Inky at 17, Clyde
// at 32); if it reaches 32 with Clyde still inside it switches off
// and the personal counts, which were kept, carry on. If no dot is
// eaten for a while the first waiting ghost leaves anyway. tick()
// names the ghost to release (or null); the caller calls onLeft(id)
// once that ghost has left, and onDot() for each dot eaten.

import { houseLimits, idleLimit } from './Levels';
import { PINKY, INKY, CLYDE } from './Dirs';

const GLOBAL_LIMIT = [0, 7, 17, 32];

export class House {
  constructor(level) {
    this.limits = houseLimits(level);
    this.idleMax = idleLimit(level);
    this.waiting = [PINKY, INKY, CLYDE];
    this.global = false;
    this.counts = [0, 0, 0, 0];
    this.globalCount = 0;
    this.idle = 0;
  }

  /** Pac-Man ate a dot. */
  onDot() {
    this.idle = 0;
    if (this.global) this.globalCount++;
    else if (this.waiting.length) this.counts[this.waiting[0]]++;
  }

  /** One frame; the id of the ghost to let out now, or null. */
  tick() {
    const id = this.waiting[0];
    if (id === undefined) return null;
    if (this.global && id === CLYDE &&
        this.globalCount >= GLOBAL_LIMIT[CLYDE]) {
      this.global = false;
    }
    if (this.global ? this.globalCount >= GLOBAL_LIMIT[id]
                    : this.counts[id] >= this.limits[id]) return id;
    if (++this.idle >= this.idleMax) {
      this.idle = 0;
      return id;
    }
    return null;
  }

  /** A life was lost: the global counter takes over. */
  onDeath() {
    this.global = true;
    this.globalCount = 0;
  }

  /** Ghost id has left the house. */
  onLeft(id) {
    const i = this.waiting.indexOf(id);
    if (i >= 0) this.waiting.splice(i, 1);
  }
}
