// !Pacman - Play: one frame of the 'play' state.
//
// The order is the arcade's: Pac-Man moves and eats; a collision is
// checked; each ghost moves; a collision is checked again. A collision
// is Pac-Man and a ghost in the same tile. Each ghost steers for its
// scatter corner or its chase target (Modes says which), and every
// mode change turns the ghosts in the maze round. The House (dots
// eaten, then an idle timer) says when a ghost leaves its pen; a
// death starts the 'dying' show (Game puts everyone back after it).
// Blinky speeds up as Cruise Elroy when few dots are left, and then
// chases even in scatter, until a death suspends it. Speeds come
// from the level table (ghostPct, pacPct). Points go through
// addScore, which gives the extra life. An energizer starts a
// fright (Fright): the ghosts outside turn round, every ghost turns
// blue, and the scatter and chase clock waits until it ends. Touching
// a blue ghost eats it (Fright gives the points: 200 to 1600) and
// freezes the game for 60 frames in the 'eaten' state, while eyes
// already on their way home keep moving. Eating all four ghosts of
// each of the four energizers of a level earns 12000, once. The
// bonus fruit (Fruit) appears at 70 and 170 dots eaten and is eaten
// by standing on its tile; the last dot ends the level.

import { chaseTarget } from './Targets';
import { levelSpec } from './Levels';

import { EYES_PCT } from './Ghost';

export const FREEZE = 60;
const BONUS = 12000;

/** Do Pac-Man and a ghost share a tile? A blue one is eaten, any
 *  other (not eyes) kills him. True if the frame is over. */
function collide(game) {
  const p = game.player;
  for (const g of game.ghosts) {
    if (g.state === 'eyes' || g.tx !== p.tx || g.ty !== p.ty) continue;
    if (g.blue) eat(game, g);
    else kill(game);
    return true;
  }
  return false;
}

/** Pac-Man is caught: everyone goes back and 'ready' follows. The
 *  ghosts restart in the house, and the House's global counter (7,
 *  17, 32 dots) takes over from the personal ones. */
export function kill(game) {
  game.events.push({ type: 'death' });
  game.popups = [];
  game.eatenId = -1;
  game.fruit.clear();
  game.elroyOff = true;
  game.deathFrame = -1;
  game.ghostsShown = true;
  game.setState('dying');
}

/** One frame of the death: Pac-Man freezes for 60 frames, the ghosts
 *  vanish, his 11 frame collapse takes 90, and he pauses for 60.
 *  True when the 210 frames are over. */
export function dyingFrame(game) {
  const t = ++game.stateTimer;
  game.ghostsShown = t < 60;
  game.deathFrame = t < 60 ? -1
    : Math.min(10, Math.floor(((t - 60) * 11) / 90));
  return t >= 210;
}

/** Points; crossing the bonus score (once) earns an extra life. */
export function addScore(game, points) {
  const was = game.score;
  game.score += points;
  if (game.bonus > 0 && !game.extraDone && was < game.bonus
    && game.score >= game.bonus) {
    game.extraDone = true;
    game.lives++;
    game.events.push({ type: 'extraLife' });
  }
}

/** Pac-Man eats a ghost: points, a popup, and the freeze. */
function eat(game, g) {
  const points = game.fright.nextScore();
  addScore(game, points);
  g.eat();
  game.events.push({ type: 'ghostEaten', id: g.id, points });
  game.popups.push({ px: g.px, py: g.py, text: String(points),
    frames: FREEZE });
  if (game.fright.eaten === 4 && ++game.sweeps === 4) {
    addScore(game, BONUS);
    game.events.push({ type: 'bonus', points: BONUS });
  }
  game.eatenId = g.id;
  game.setState('eaten');
}

/** One frame of the freeze: only the eyes move. */
export function eatenFrame(game) {
  for (const g of game.ghosts) {
    if (g.state === 'eyes' && g.id !== game.eatenId) step(game, g);
  }
  tickPopups(game);
  if (++game.stateTimer >= FREEZE) {
    game.eatenId = -1;
    game.setState('play');
  }
}

function tickPopups(game) {
  for (const p of game.popups) p.frames--;
  game.popups = game.popups.filter((p) => p.frames > 0);
}

/** Standing on the fruit's tile eats it. */
function eatFruit(game) {
  const f = game.data.maze.SPECIAL.fruit;
  const p = game.player;
  if (!game.fruit.shown
    || !f.tiles.some(([x, y]) => x === p.tx && y === p.ty)) return;
  const kind = game.fruit.kind;
  const points = game.fruit.eat();
  addScore(game, points);
  game.events.push({ type: 'fruitEaten', kind, points });
  game.popups.push({ px: f.px, py: f.py, text: String(points),
    frames: 120 });
}

/** The last dot: the ghosts stop, the level-complete show begins. */
function levelDone(game) {
  game.events.push({ type: 'levelDone' });
  if (game.fright.on) endFright(game);
  game.fright.reset();
  game.fruit.clear();
  game.popups = [];
  game.setState('levelDone');
}

/** Move a ghost; one that reaches the exit (112, 92) has left. */
function step(game, g) {
  const was = g.state;
  moveGhost(game, g);
  if (was === 'leaving' && g.state === 'active') {
    game.house.onLeft(g.id);
  }
}

/** A ghost's speed in percent, by the arcade's precedence: eyes,
 *  then the tunnel, then blue, then Blinky's Elroy, then normal. A
 *  ghost in the house, or leaving it, goes at half speed. */
export function ghostPct(game, g) {
  if (g.state === 'eyes') return EYES_PCT;
  if (g.state !== 'active') return 50;
  const s = levelSpec(game.level);
  if (game.maze.isTunnel(g.tx, g.ty)) return s.tunnel;
  if (g.blue) return s.ghostFright;
  if (g.id === 0 && game.elroy) {
    return game.elroy === 2 ? s.elroy2 : s.elroy1;
  }
  return s.ghost;
}

/** Pac-Man's speed in percent: faster while the ghosts are blue
 *  (on the levels that have a fright speed), never slowed in the
 *  tunnel. */
export function pacPct(game) {
  const s = levelSpec(game.level);
  return game.fright.on && s.pacFright !== null ? s.pacFright : s.pac;
}

function moveGhost(game, g) {
  const eyes = g.state === 'eyes';
  g.tick({ maze: game.maze, pct: ghostPct(game, g),
    target: targetOf(game, g), frightened: g.blue, rng: game.rng,
    redZones: !eyes });
}

/** Run one frame of play with input {want: 0..3 | -1}. */
export function playFrame(game, input) {
  const want = input && input.want !== undefined ? input.want : -1;
  const { maze, player } = game;
  tickPopups(game);
  if (game.elroyOff && game.ghosts[3].state === 'active') {
    game.elroyOff = false;
  }
  game.fruit.tick();
  if (game.fright.tick()) endFright(game);
  const r = player.tick(maze, want, pacPct(game));
  if (r.ate) {
    addScore(game, r.ate);
    game.house.onDot();
    game.fruit.onDots(maze.dotsEaten);
    game.events.push({ type: r.ate === 50 ? 'energizer' : 'dot' });
    if (r.ate === 50) startFright(game);
  }
  eatFruit(game);
  if (maze.dotsLeft === 0) return levelDone(game);
  if (collide(game)) return;
  release(game);
  if (game.modes.tick(game.fright.on)) {
    game.events.push({ type: 'modeChange', mode: game.modes.mode });
    for (const g of game.ghosts) {
      if (g.state === 'active') g.reverse = true;
    }
  }
  for (const g of game.ghosts) step(game, g);
  for (const g of game.ghosts) {
    g.flash = g.blue && game.fright.flashWhite();
  }
  collide(game);
}

/** An energizer: the ghosts outside turn round, the rest go blue. */
function startFright(game) {
  const blue = game.fright.start();
  game.events.push({ type: 'frightStart' });
  for (const g of game.ghosts) {
    if (g.state === 'active') g.reverse = true;
    if (blue && g.state !== 'eyes') g.blue = true;
  }
}

function endFright(game) {
  game.events.push({ type: 'frightEnd' });
  for (const g of game.ghosts) g.blue = g.flash = false;
}

/** The tile a ghost steers for now. */
export function targetOf(game, g) {
  if (g.state === 'eyes') return game.data.maze.SPECIAL.eyesTarget;
  const corner = game.data.maze.SPECIAL.scatter[g.id];
  if (game.modes.mode === 'scatter' && !(g.id === 0 && game.elroy)) {
    return corner;
  }
  return chaseTarget(g.id, game.player, game.ghosts[0], corner, g);
}

/** The House says who is due (the same ghost every frame until it
 *  is dealt with): start its way out once, and tell the House. */
function release(game) {
  const id = game.house.tick();
  if (id === null) return;
  game.ghosts[id].leave();
  game.house.onRelease(id);
}
