// !Pacman - Entry: typing a three letter name for the high scores.
//
// No desktop in here. key(e) takes one key press ({key, repeat,
// ctrl}, as Keys records it) and says 'done' on Return or Escape.
// Letters become capitals; digits, space, full stop and minus are
// kept; every other key (accents, Tab, F keys, dead keys, emoji) is
// ignored, as is a fourth character. Held keys do not repeat into
// the name; only Backspace does. A blank name is stored as '???'.

const OK = /^[a-zA-Z0-9 .-]$/;

export class Entry {
  constructor(initial = '') {
    this.text = String(initial).replace(/[^a-zA-Z0-9 .-]/g, '')
      .toUpperCase().slice(0, 3);
  }

  /** The name to store: what was typed, or ??? if nothing. */
  get name() { return /\S/.test(this.text) ? this.text : '???'; }

  key(e) {
    const k = e?.key;
    if (typeof k !== 'string') return null;
    if (k === 'Backspace') this.text = this.text.slice(0, -1);
    else if (e.repeat || e.ctrl) return null;
    else if (k === 'Enter' || k === 'Escape') return 'done';
    else if (OK.test(k) && this.text.length < 3) {
      this.text += k.toUpperCase();
    }
    return null;
  }
}
