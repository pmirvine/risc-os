// !Pacman - Sprites: Pac-Man, the ghosts and the little digits.
//
// Every sprite is drawn from Shapes into a 16 x 16 cell centred on
// the pixel (x, y) the actor stands on. Nothing is read from a ROM:
//   Pac-Man   a yellow disc of radius 6.5 less a wedge for the mouth
//             (half angle 0, 22, 45, 22 degrees, a step every 2
//             pixels moved), and the death: a wedge opening to 180
//             degrees in 11 frames, then a burst of lines.
//   Ghosts    a half disc over a rectangle with a skirt that changes
//             every 8 frames, eyes that look the way it will turn;
//             blue (small square eyes, a zigzag mouth), blue and
//             white when flashing, and eyes alone when eaten.
//   Digits    our own 4 x 6 set, for the scores that pop up.
// Fruit are in FruitArt.

import { rgb } from 'gamelib/Surface';
import { pie, line } from 'gamelib/Shapes';
import { DX, DY, UP, LEFT, DOWN, RIGHT } from './Dirs';
import { COLOURS } from './Theme';
import { drawFruit } from './FruitArt';

export { drawFruit };

const MOUTH = [0, 22, 45, 22].map((d) => (d * Math.PI) / 180);
const FACING = [];
FACING[UP] = -Math.PI / 2; FACING[LEFT] = Math.PI;
FACING[DOWN] = Math.PI / 2; FACING[RIGHT] = 0;

/** Pac-Man; dying is -1 when alive, else 0 to 10 (the death). */
export function drawPac(s, x, y, dir, anim, dying) {
  const c = rgb(...COLOURS.pac);
  const cx = x + 0.5, cy = y + 0.5;
  if (dying >= 10) {
    for (let i = 0; i < 8; i++) {
      const a = (i * Math.PI) / 4;
      line(s, cx + Math.cos(a) * 3.5, cy + Math.sin(a) * 3.5,
        cx + Math.cos(a) * 6.5, cy + Math.sin(a) * 6.5, c);
    }
    return;
  }
  let half = MOUTH[(anim >> 1) & 3], face = FACING[dir] ?? Math.PI;
  if (dying >= 0) {
    half = (dying * Math.PI) / 10;
    face = -Math.PI / 2;
  }
  pie(s, cx, cy, 6.5, face + half, face + Math.PI * 2 - half, c);
}

// Bottom edge of each of a skirt's 14 columns, in rows below y.
const SKIRT = [
  [6, 6, 4, 2, 2, 4, 6, 6, 4, 2, 2, 4, 6, 6],
  [4, 6, 6, 4, 2, 4, 6, 6, 4, 2, 4, 6, 6, 4],
];

function eyes(s, x, y, ghost) {
  const d = ghost.turn ?? ghost.dir ?? LEFT;
  for (const ex of [x - 5, x + 1]) {
    s.fillRect(ex, y - 6, 4, 5, rgb(255, 255, 255));
    s.fillRect(ex + 1 + DX[d], y - 5 + DY[d] + 1, 2, 2,
      rgb(...COLOURS.wall));
  }
}

/** A ghost; flashWhite picks the white half of the fright flash. */
export function drawGhost(s, x, y, ghost, frame, flashWhite) {
  if (ghost.state === 'eyes') return eyes(s, x, y, ghost);
  const blue = ghost.blue;
  const body = rgb(...(blue ? (flashWhite ? COLOURS.flash
    : COLOURS.blue) : COLOURS.ghosts[ghost.id]));
  pie(s, x, y, 7, Math.PI, Math.PI * 2, body);
  const skirt = SKIRT[(frame >> 3) & 1];
  for (let i = 0; i < 14; i++) {
    s.fillRect(x - 7 + i, y, 1, skirt[i] + 1, body);
  }
  if (!blue) return eyes(s, x, y, ghost);
  const face = rgb(...(flashWhite ? COLOURS.faceFlash : COLOURS.face));
  s.fillRect(x - 4, y - 4, 2, 2, face);
  s.fillRect(x + 2, y - 4, 2, 2, face);
  for (let i = 0; i < 10; i++) {
    s.pixel(x - 5 + i, y + 1 + ((i >> 1) & 1), face);
  }
}

// 3 pixels wide, 6 high, a row to a number (bit 2 is the left pixel).
const DIGITS = [
  [7, 5, 5, 5, 5, 7], [2, 6, 2, 2, 2, 7], [7, 1, 7, 4, 4, 7],
  [7, 1, 7, 1, 1, 7], [5, 5, 7, 1, 1, 1], [7, 4, 7, 1, 1, 7],
  [7, 4, 7, 5, 5, 7], [7, 1, 1, 2, 2, 2], [7, 5, 7, 5, 5, 7],
  [7, 5, 7, 1, 1, 7],
];

/** Digits in 4 x 6 cells (3 pixels of ink), top left at (x, y). */
export function drawDigits(s, x, y, text, c) {
  String(text).split('').forEach((ch, i) => {
    const g = DIGITS[ch.charCodeAt(0) - 48];
    if (!g) return;
    for (let r = 0; r < 6; r++) {
      for (let b = 0; b < 3; b++) {
        if (g[r] & (4 >> b)) s.pixel(x + i * 4 + b, y + r, c);
      }
    }
  });
}
