// !Pacman - Ghost: a ghost, in the house or moving through the maze.
//
// A ghost decides one tile ahead. On entering a tile it already knows
// the way it will go at that tile's centre (turn), and it picks the
// way for the tile after (ahead) with chooseExit. At the centre it
// takes turn. A reverse flag, set by the game, swaps turn for the
// opposite direction at the next tile entry. A blue ghost (set by
// the game, in the house too) chooses at random with frightExit.
//
// A ghost is 'house' (bobbing between y 112 and 120), 'leaving' (to
// x 112, up to y 92, then off to the left), 'active' (in the maze) or
// 'eyes' (eaten). Eyes steer for the tile above the door, red zones
// ignored; on passing (112, 92) they go down to (112, 116), then
// sideways to their home x, and revive as a 'leaving' ghost, not
// blue. The house moves are at half speed, the eyes at EYES_PCT.

import { DX, DY, UP, LEFT, DOWN, RIGHT } from './Dirs';
import { steps } from './Mover';
import { chooseExit, frightExit } from './Targets';

// The eyes always go at twice full speed, whatever the level.
export const EYES_PCT = 200;
const HOME_X = [112, 112, 96, 128];

export class Ghost {
  constructor(id, start) {
    this.id = id;
    this.start = start;
    this.reset();
  }

  /** Back to the starting place; the plan is made on the first tick. */
  reset() {
    const { px, py, dir } = this.start;
    this.place(px, py, dir);
    this.blue = this.flash = false;
    if (py > 100) this.state = 'house';
  }

  /** Start the way out of the house (from the House's release). */
  leave() { if (this.state === 'house') this.state = 'leaving'; }

  /** Eaten: eyes that head for the door; never blue again. */
  eat() {
    this.state = 'eyes';
    this.blue = this.flash = false;
    this.reverse = false;
    this.ahead = -1;
    this.stage = 0;
  }

  place(px, py, dir) {
    this.px = px;
    this.py = py;
    this.dir = dir;
    this.acc = 0;
    this.tx = px >> 3;
    this.ty = py >> 3;
    this.state = 'active';
    this.turn = dir;
    this.ahead = -1;
    this.reverse = false;
    this.stage = 0;
  }

  /** One frame. ctx = {maze, pct, target, frightened, rng,
   *  redZones}; frightened makes the choices random. */
  tick(ctx) {
    const eyes = this.state === 'eyes';
    if (this.state !== 'active' && !eyes) return this.inHouse();
    if (eyes && this.stage) return this.goHome();
    this.ctx = ctx;
    const { maze, target } = ctx;
    const redZones = ctx.redZones && !eyes;
    if (this.ahead < 0) this.plan(maze, target, redZones);
    const n = steps(this, eyes ? EYES_PCT : ctx.pct);
    for (let i = 0; i < n; i++) {
      this.px = (this.px + DX[this.dir] + 224) % 224;
      this.py += DY[this.dir];
      const tx = this.px >> 3, ty = this.py >> 3;
      if (tx !== this.tx || ty !== this.ty) {
        this.tx = tx;
        this.ty = ty;
        this.enter(maze, target, redZones);
      }
      if ((this.px & 7) === 4 && (this.py & 7) === 4) {
        this.dir = this.turn;
      }
      if (eyes && this.px === 112 && this.py === 92) {
        this.stage = 1;
        this.dir = this.turn = DOWN;
        return this.goHome(n - i - 1);
      }
    }
  }

  /** Eyes inside: down the door, sideways, then revive and leave. */
  goHome(n = steps(this, EYES_PCT)) {
    const hx = HOME_X[this.id];
    for (let i = 0; i < n; i++) {
      if (this.stage === 1) {
        this.py++;
        if (this.py === 116) this.stage = 2;
      } else if (this.px !== hx) {
        this.dir = this.px < hx ? RIGHT : LEFT;
        this.px += DX[this.dir];
      }
      this.turn = this.dir;
      this.tx = this.px >> 3;
      this.ty = this.py >> 3;
      if (this.stage === 2 && this.px === hx) {
        this.blue = this.flash = false;
        this.state = 'leaving';
        this.dir = UP;
        return;
      }
    }
  }

  /** House and leaving moves: 50% speed, no decisions. */
  inHouse() {
    const n = steps(this, 50);
    for (let i = 0; i < n; i++) {
      if (this.state === 'house') {
        this.py += DY[this.dir];
        if (this.py >= 120) this.dir = UP;
        else if (this.py <= 112) this.dir = DOWN;
      } else if (this.px !== 112) {
        this.dir = this.px < 112 ? RIGHT : LEFT;
        this.px += DX[this.dir];
      } else {
        this.dir = UP;
        this.py--;
      }
      this.turn = this.dir;
      this.ty = this.py >> 3;
      this.tx = this.px >> 3;
      if (this.state === 'leaving' && this.py === 92 &&
        this.px === 112) {
        this.place(112, 92, LEFT);
        return;
      }
    }
  }

  /** The way out of tile at the end of a move going dir. */
  choose(maze, tile, dir, target, redZones) {
    const { frightened, rng } = this.ctx;
    return frightened ? frightExit(maze, tile, dir, rng)
      : chooseExit(maze, tile, dir, target, redZones);
  }

  /** The first plan, made from where the ghost stands. */
  plan(maze, target, redZones) {
    this.turn = this.dir;
    this.ahead = this.choose(maze, [this.tx + DX[this.dir],
      this.ty + DY[this.dir]], this.dir, target, redZones);
  }

  /** A new tile: take the plan, or the reversal, and plan the next. */
  enter(maze, target, redZones) {
    if (this.reverse) {
      this.turn = this.dir ^ 2;
      this.reverse = false;
    } else {
      this.turn = this.ahead;
    }
    this.ahead = this.choose(maze, [this.tx + DX[this.turn],
      this.ty + DY[this.turn]], this.turn, target, redZones);
  }
}
