// !Pacman - Modes: the ghosts' scatter and chase clock.
//
// The mode starts as scatter and alternates down the level's
// schedule. tick(frightOn) counts one frame (not while a fright is
// running) and says whether the mode just switched, which is when
// the ghosts must turn round. reset(level) starts over, as on a new
// level or after a lost life.

import { schedule } from './Levels';

export class Modes {
  constructor(level) { this.reset(level); }

  reset(level) {
    this.list = schedule(level);
    this.phase = 0;
    this.timer = 0;
    this.mode = 'scatter';
  }

  /** One frame; true if the mode switched on this frame. */
  tick(frightOn) {
    if (frightOn) return false;
    if (++this.timer < this.list[this.phase]) return false;
    this.phase++;
    this.timer = 0;
    this.mode = this.phase & 1 ? 'chase' : 'scatter';
    return true;
  }
}
