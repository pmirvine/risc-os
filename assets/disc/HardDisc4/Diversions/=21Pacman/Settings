// !Pacman - Settings: the options, their defaults, and saving them.
//
// The list is GameLib's Options kind: each option has a key, a label,
// the values allowed and the names shown for them. The Settings
// screen steps through it with stepOption. Saved as the file
// Settings in the game's Choices directory; anything wrong in the
// file gives the defaults. The volume is kept as 0 to 1 (older
// files held a percent, which tidyVolume converts).

import { sanitise } from 'gamelib/Options';
import { tidyVolume } from './Sound';

const PERCENTS = [20, 40, 60, 80, 100];

export const OPTIONS = [
  { key: 'display', label: 'Display', values: ['full', 'window'],
    names: ['Full screen', 'Window'] },
  { key: 'browserFull', label: 'Browser', values: [false, true],
    names: ['In page', 'Full screen'] },
  { key: 'sound', label: 'Sound', values: [true, false],
    names: ['On', 'Off'] },
  { key: 'volume', label: 'Volume', values: [0.2, 0.4, 0.6, 0.8, 1],
    names: PERCENTS.map((p) => p + '%') },
  { key: 'lives', label: 'Lives', values: [1, 2, 3, 5],
    names: ['1', '2', '3', '5'] },
  { key: 'bonus', label: 'Bonus life', values: [10000, 15000, 20000, 0],
    names: ['10000', '15000', '20000', 'None'] },
];

export const DEFAULTS = { display: 'full', browserFull: false,
  sound: true, volume: 0.8, lives: 3, bonus: 10000 };

/** The saved settings from a Choices store (see GameLib Choices). */
export async function loadSettings(store) {
  return sanitise(OPTIONS, DEFAULTS,
    tidyVolume(await store.read('Settings', DEFAULTS)));
}

export function saveSettings(store, settings) {
  return store.write('Settings', settings);
}
