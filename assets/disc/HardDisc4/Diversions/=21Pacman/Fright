// !Pacman - Fright: the clock and score chain of a frightened spell.
//
// spec is {frightFrames, flashes}: how long the ghosts stay blue (in
// 60 Hz frames; null means they do not turn blue at all) and how many
// times they flash white at the end. Each flash is 14 frames blue then
// 14 frames white; the last flashes x 28 frames flash (a short fright
// flashes from its first frame). start() begins or restarts a spell,
// tick() counts a frame and says when the spell ends, nextScore()
// gives what the next ghost eaten is worth: 200, 400, 800, 1600.

export class Fright {
  constructor(spec) {
    this.frames = spec.frightFrames;
    this.flashes = spec.flashes;
    this.reset();
  }

  /** No spell running (a new level or a lost life). */
  reset() {
    this.on = false;
    this.elapsed = 0;
    this.eaten = 0;
  }

  /** An energizer: true if the ghosts turn blue. */
  start() {
    this.elapsed = 0;
    this.eaten = 0;
    this.on = this.frames !== null && this.frames > 0;
    return this.on;
  }

  /** One frame; true on the frame the spell ends. */
  tick() {
    if (!this.on) return false;
    if (++this.elapsed < this.frames) return false;
    this.on = false;
    return true;
  }

  /** Is the flash showing white at this frame of the spell? */
  flashWhite(frame = this.elapsed) {
    const from = Math.max(0, this.frames - this.flashes * 28);
    return frame >= from && Math.floor((frame - from) / 14) % 2 === 1;
  }

  /** The points for the next ghost eaten in this spell. */
  nextScore() {
    return 200 * 2 ** Math.min(this.eaten++, 3);
  }
}
