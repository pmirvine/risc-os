// !Pacman - Levels: what changes from one level to the next.
//
// levelSpec(n) is the whole table row for level n (levels past 21
// use the last row): speeds as percentages of full speed (pac,
// pacFright, ghost, tunnel, ghostFright), the two Elroy stages (dots
// left, speed), the fright time in frames and its flashes (null when
// the ghosts do not turn blue at all, and then pacFright and
// ghostFright are null too), the bonus fruit and its points, the
// scatter and chase schedule, and the ghost house's dot limits for
// Inky and Clyde and its idle time. LEVELS holds levels 1 to 21.
// mazeWhite(t) says whether the maze is flashing white t frames
// into the level-complete sequence.
//
// The schedule: how many 60 Hz frames each phase lasts. The phases
// alternate, scatter first. After the last chase (Infinity) the
// ghosts chase for ever. The 1-frame scatter on level 2 and later is
// real: it reverses the ghosts once more.

// first level, last level, then pac, pacFright, ghost, tunnel,
// ghostFright, elroy1 dots and speed, elroy2 dots and speed, fright
// seconds, flashes.
const N = null;
const ROWS = [
  [1, 1, 80, 90, 75, 40, 50, 20, 80, 10, 85, 6, 5],
  [2, 2, 90, 95, 85, 45, 55, 30, 90, 15, 95, 5, 5],
  [3, 3, 90, 95, 85, 45, 55, 40, 90, 20, 95, 4, 5],
  [4, 4, 90, 95, 85, 45, 55, 40, 90, 20, 95, 3, 5],
  [5, 5, 100, 100, 95, 50, 60, 40, 100, 20, 105, 2, 5],
  [6, 6, 100, 100, 95, 50, 60, 50, 100, 25, 105, 5, 5],
  [7, 8, 100, 100, 95, 50, 60, 50, 100, 25, 105, 2, 5],
  [9, 9, 100, 100, 95, 50, 60, 60, 100, 30, 105, 1, 3],
  [10, 10, 100, 100, 95, 50, 60, 60, 100, 30, 105, 5, 5],
  [11, 11, 100, 100, 95, 50, 60, 60, 100, 30, 105, 2, 5],
  [12, 13, 100, 100, 95, 50, 60, 80, 100, 40, 105, 1, 3],
  [14, 14, 100, 100, 95, 50, 60, 80, 100, 40, 105, 3, 5],
  [15, 16, 100, 100, 95, 50, 60, 100, 100, 50, 105, 1, 3],
  [17, 17, 100, N, 95, 50, N, 100, 100, 50, 105, N, N],
  [18, 18, 100, 100, 95, 50, 60, 100, 100, 50, 105, 1, 3],
  [19, 20, 100, N, 95, 50, N, 120, 100, 60, 105, N, N],
  [21, 21, 90, N, 95, 50, N, 120, 100, 60, 105, N, N],
];

// The fruit: last level it is used on, name, points.
const FRUIT = [[1, 'cherries', 100], [2, 'strawberry', 300],
  [4, 'peach', 500], [6, 'apple', 700], [8, 'grapes', 1000],
  [10, 'rocket', 2000], [12, 'bell', 3000], [255, 'key', 5000]];

/** The phase lengths, in frames, for level n. */
export function schedule(n) {
  if (n === 1) return [420, 1200, 420, 1200, 300, 1200, 300, Infinity];
  if (n <= 4) return [420, 1200, 420, 1200, 300, 61980, 1, Infinity];
  return [300, 1200, 300, 1200, 300, 62220, 1, Infinity];
}

/** Dots Pinky's, Inky's and Clyde's counters need, by ghost id. */
export function houseLimits(n) {
  if (n === 1) return [0, 0, 30, 60];
  if (n === 2) return [0, 0, 0, 50];
  return [0, 0, 0, 0];
}

/** Frames without a dot before the house lets a ghost out. */
export function idleLimit(n) {
  return n <= 4 ? 240 : 180;
}

function build(n) {
  const r = ROWS.find((x) => n >= x[0] && n <= x[1]);
  const f = FRUIT.find((x) => n <= x[0]);
  const lim = houseLimits(n);
  return { pac: r[2], pacFright: r[3], ghost: r[4], tunnel: r[5],
    ghostFright: r[6], elroy1Dots: r[7], elroy1: r[8],
    elroy2Dots: r[9], elroy2: r[10],
    frightFrames: r[11] === null ? null : r[11] * 60, flashes: r[12],
    fruit: f[1], fruitPoints: f[2], schedule: schedule(n),
    inky: lim[2], clyde: lim[3], idleFrames: idleLimit(n) };
}

export const LEVELS = Array.from({ length: 21 },
  (_, i) => build(i + 1));

/** The table row for level n (21 and above share the last). */
export function levelSpec(n) {
  return LEVELS[Math.min(Math.max(n, 1), 21) - 1];
}

/** Is the maze white t frames into the level-complete sequence?
 *  Four bursts of 15 frames, 30 apart, from frame 120. */
export function mazeWhite(t) {
  return t >= 120 && t < 240 && (t - 120) % 30 < 15;
}
