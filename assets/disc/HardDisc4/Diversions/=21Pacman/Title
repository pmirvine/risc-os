// !Pacman - Title: the title screen's picture and its menu.
//
// The title from Theme, then the four ghosts introduced one after
// another with name and nickname (one every 60 frames), the points
// legend, and the menu. The clock t counts 60 Hz frames since the
// screen began. The menu's choices are made by Screens and given in.

import { rgb } from 'gamelib/Surface';
import { drawText } from 'gamelib/Font';
import { disc } from 'gamelib/Shapes';
import { COLOURS, GHOSTS, TITLE } from './Theme';
import { drawGhost } from './Sprites';
import { Menu } from './Menu';

export class Title {
  constructor(items) {
    this.t = 0;
    this.legend = [10, 50];        // what a dot and an energizer score
    this.menu = new Menu(items, { y: 214 });
  }

  tick() { this.t++; }

  /** How many ghosts are introduced so far (0 to 4). */
  shown() {
    return this.t < 30 ? 0 : Math.min(4, 1 + ((this.t - 30) / 60 | 0));
  }

  rollCall() { return GHOSTS.map((g) => [g.name, g.nickname]); }

  draw(s) {
    s.clear(rgb(0, 0, 0));
    const white = rgb(...COLOURS.text);
    drawText(s, TITLE.toUpperCase(), 112, 16, { scale: 4,
      align: 'centre', smooth: true, colour: rgb(...COLOURS.pac),
      shadow: rgb(...COLOURS.wall) });
    drawText(s, 'CHARACTER / NICKNAME', 112, 64,
      { align: 'centre', colour: white });
    GHOSTS.forEach((g, i) => {
      if (i >= this.shown()) return;
      const y = 92 + i * 20;
      const colour = rgb(...g.colour);
      drawGhost(s, 28, y, { id: g.id, state: 'active', dir: 3,
        turn: 3, blue: false }, this.t, false);
      drawText(s, g.name.toUpperCase(), 48, y - 4, { colour });
      drawText(s, '"' + g.nickname.toUpperCase() + '"', 112, y - 4,
        { colour });
    });
    const dot = rgb(...COLOURS.dot);
    s.fillRect(79, 175, 2, 2, dot);
    drawText(s, this.legend[0] + ' PTS', 92, 172, { colour: white });
    disc(s, 80, 192, 4, (this.t >> 4) % 2 ? 0 : dot);
    drawText(s, this.legend[1] + ' PTS', 92, 188, { colour: white });
    this.menu.draw(s);
  }
}
