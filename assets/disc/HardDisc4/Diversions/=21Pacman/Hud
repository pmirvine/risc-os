// !Pacman - Hud: the scores above the maze and the lives below.
//
// Texts are the system font at scale 1, on the 8 pixel tile grid:
// "1UP" and its score on the left, "HIGH SCORE" and the best score in
// the middle (rows 0 and 1), spare lives and the fruit of the last
// seven levels (named by Levels) along the bottom (screen rows
// 34-35), and in the maze "PLAYER ONE" and "READY!" before play,
// or "GAME OVER" ("DEMO" in a demo game). game.lives is the number of
// spare lives.

import { rgb } from 'gamelib/Surface';
import { drawText } from 'gamelib/Font';
import { COLOURS } from './Theme';
import { drawPac, drawFruit } from './Sprites';
import { levelSpec } from './Levels';

/** Draw the whole Hud for a game; high is the best score so far. */
export function drawHud(s, game, frame, high) {
  const text = rgb(...COLOURS.text);
  const playing = game.state === 'play' || game.state === 'eaten';
  if (!playing || (frame >> 4) % 2 === 0) {
    drawText(s, '1UP', 24, 0, { colour: text });
  }
  drawText(s, String(game.score), 56, 8,
    { colour: text, align: 'right' });
  drawText(s, 'HIGH SCORE', 112, 0, { colour: text, align: 'centre' });
  drawText(s, String(Math.max(high, game.score)), 136, 8,
    { colour: text, align: 'right' });
  const st = game.state;
  if (st === 'start') {
    drawText(s, 'PLAYER ONE', 112, 112, { align: 'centre',
      colour: rgb(...COLOURS.ghosts[2]) });
  }
  if (st === 'start' || st === 'ready') {
    drawText(s, 'READY!', 112, 160, { align: 'centre',
      colour: rgb(...COLOURS.ready) });
  } else if (st === 'gameOver' || st === 'over') {
    drawText(s, game.demo ? 'DEMO' : 'GAME OVER', 112, 160,
      { align: 'centre', colour: rgb(...COLOURS.over) });
  }
  const spare = Math.max(0, game.lives);
  for (let i = 0; i < Math.min(spare, 5); i++) {
    drawPac(s, 24 + i * 16, 280, 1, 2, -1);
  }
  for (let i = 0; i < 7 && game.level - i >= 1; i++) {
    drawFruit(s, 208 - i * 16, 280, levelSpec(game.level - i).fruit);
  }
}
