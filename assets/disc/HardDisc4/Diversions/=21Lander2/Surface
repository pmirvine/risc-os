// Lander II - Surface: a block of pixels that the game draws into.
//
// Everything - landscape, ships, particles, the score bar, the menus - is
// drawn into one Surface in software, a pixel at a time, as the
// Archimedes did into screen memory. present() then copies it to a
// canvas on the real screen, scaled up.
//
// Pixels are 32-bit numbers made with rgb(): the ImageData layout
// (0xAABBGGRR on little-endian machines, which is all of them now).

/** A pixel value from red, green and blue levels 0-255. */
export const rgb = (r, g, b) => ((255 << 24) | (b << 16) | (g << 8) | r) >>> 0;

/** A pixel value from 4-bit levels 0-15 (as Lander's &RGB colours). */
export const rgb4 = (r, g, b) => rgb(r * 17, g * 17, b * 17);

/** The red, green and blue parts of a pixel value. */
export const unrgb = (c) => [c & 255, (c >>> 8) & 255, (c >>> 16) & 255];

export class Surface {
  constructor(width, height) {
    this.canvas = document.createElement('canvas');
    this.ctx = this.canvas.getContext('2d');
    this.resize(width, height);
  }

  /** Change the size (the pixels are lost). */
  resize(width, height) {
    this.width = width;
    this.height = height;
    this.canvas.width = width;
    this.canvas.height = height;
    this.image = this.ctx.createImageData(width, height);
    this.pixels = new Uint32Array(this.image.data.buffer);
  }

  /** Fill everything with one colour. */
  clear(c) { this.pixels.fill(c); }

  /** One pixel (clipped). */
  pixel(x, y, c) {
    x |= 0; y |= 0;
    if (x >= 0 && y >= 0 && x < this.width && y < this.height) {
      this.pixels[y * this.width + x] = c;
    }
  }

  /** A filled rectangle (clipped). */
  fillRect(x, y, w, h, c) {
    let x0 = Math.max(0, x | 0), y0 = Math.max(0, y | 0);
    const x1 = Math.min(this.width, (x + w) | 0);
    const y1 = Math.min(this.height, (y + h) | 0);
    for (; y0 < y1; y0++) {
      const o = y0 * this.width;
      this.pixels.fill(c, o + x0, o + x1);
    }
  }

  /**
   * Darken (or tint) a rectangle: each pixel becomes
   * pixel * (1 - a) + c * a, for dimming the game behind a menu.
   */
  shade(x, y, w, h, c, a) {
    const [cr, cg, cb] = unrgb(c);
    const x0 = Math.max(0, x | 0), y0 = Math.max(0, y | 0);
    const x1 = Math.min(this.width, (x + w) | 0);
    const y1 = Math.min(this.height, (y + h) | 0);
    const k = 1 - a;
    for (let yy = y0; yy < y1; yy++) {
      for (let i = yy * this.width + x0, e = yy * this.width + x1; i < e; i++) {
        const p = this.pixels[i];
        this.pixels[i] = rgb(
          ((p & 255) * k + cr * a) | 0,
          (((p >>> 8) & 255) * k + cg * a) | 0,
          (((p >>> 16) & 255) * k + cb * a) | 0);
      }
    }
  }

  /**
   * Copy the pixels to a 2D canvas context, scaled into the rectangle
   * (dx, dy, dw, dh) without smoothing, so each pixel stays square.
   */
  present(ctx, dx, dy, dw, dh) {
    this.ctx.putImageData(this.image, 0, 0);
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(this.canvas, dx, dy, dw, dh);
  }
}
