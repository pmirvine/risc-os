// Pickups: the original's unused spinning pyramid, half size, in the
// colours of what it gives you. Faces: four sides, then the flat top.
const pickup = (a, b, top) => {
  const m = recoloured(scaled(pyramid, 0.5), [a, b, a, b, top, top]);
  m.shadow = true;
  return m;
};

