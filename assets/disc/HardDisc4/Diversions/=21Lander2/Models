/**
 * The model for each value in the object map (world.objects), as the
 * original's objectTypes table: 1, 3, 4 small tree; 2, 6 tall tree;
 * 5 gazebo; 7 fir tree; 8 building; 9-12 rocket; 0 the unused pyramid;
 * and 12 more for the destroyed version of each (type + 12).
 */
export const OBJECT_MODELS = [
  'pyramid', 'smallTree', 'tallTree', 'smallTree', 'smallTree', 'gazebo',
  'tallTree', 'firTree', 'building', 'rocket', 'rocket', 'rocket', 'rocket',
  'remainsRight', 'remainsLeft', 'remainsLeft', 'remainsLeft',
  'smokingGazebo', 'remainsRight', 'remainsRight', 'smokingBuilding',
  'remainsRight', 'remainsLeft', 'remainsLeft', 'remainsLeft',
];

