// The catalogue

export const MODELS = {
  // the original's
  ship, rock, pyramid, smallTree, tallTree, firTree, gazebo, building, rocket,
  remainsLeft, remainsRight, smokingGazebo, smokingBuilding,
  // Lander II's
  seeder, seederLanded, drone, mutant, bomber, pest, fighter, fighterHurt,
  attractor, missile, enemyMissile, bomb, monster,
  pickupFuel: pickup(0xC60, 0x840, 0xA40),
