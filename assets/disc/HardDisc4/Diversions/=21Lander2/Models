// Lander II - Models: the 3D shapes of everything in the game.
//
// Every object is a "blueprint", as in David Braben's Lander (1987): a
// list of corners (vertices) and a list of flat, single-coloured
// triangles (faces). Units are tiles, and y points DOWN, so a tree's
// vertices have negative y (they stand up from the ground).
//
//   MODELS.name = {
//     vertices: [[x, y, z], ...],
//     faces: [{ normal: [x, y, z], v: [a, b, c], colour: 0xRGB }, ...],
//     rotates,   // true: the object turns (the renderer rotates it and
//                // skips the faces that point away from the eye)
//     shadow,    // true: it casts a shadow on the ground
//     sort,      // true: sort its faces far to near (shapes with parts)
//     radius,    // the furthest vertex from the centre (for culling)
//   }
//
// For a rotating object, x is along the nose, y along the roof (out of
// the floor, so down when level) and z out of the right-hand side, the
// three vectors of Maths.orientation().
//
// Colours are Lander's &RGB: four bits each of red, green and blue.
// Each face is lit by the rule in the original's DrawObject: the more a
// face points up (and a little to the left), the more white is added:
//
//   level = 8 * (1 - normal.y) + (normal.x < 0 ? 1 : 0) - 5  (at least 0)
//   each of r, g, b = min(15, colour + level)
//
// The first half of this file is the original's blueprints, number for
// number: vertex coordinates are 32-bit values where a tile is &01000000
// (2^24), and normals are unit vectors scaled by 2^31. They come from
// Mark Moxon's documented source of Lander (lander.bbcelite.com). The
// second half adds the craft of a Zarch-like game in the same style.

// ------------------------------------------------------------------------
// Helpers

const V = 16777216;            // 2^24: one tile in the original's units
const N = 2147483648;          // 2^31: 1.0 for a normal vector

/**
 * A blueprint in the original's format: flags (bit 0 rotates, bit 1
 * casts a shadow), vertices as 32-bit x, y, z and faces as normal x, y,
 * z, vertex 1, 2, 3 and colour.
 */
function original(flags, verts, faces) {
  const vertices = [];
  for (let i = 0; i < verts.length; i += 3) {
    vertices.push([(verts[i] | 0) / V, (verts[i + 1] | 0) / V, (verts[i + 2] | 0) / V]);
  }
  const list = [];
  for (let i = 0; i < faces.length; i += 7) {
    list.push({
      normal: [(faces[i] | 0) / N, (faces[i + 1] | 0) / N, (faces[i + 2] | 0) / N],
      v: [faces[i + 3], faces[i + 4], faces[i + 5]],
      colour: faces[i + 6],
    });
  }
  return finish({ vertices, faces: list, rotates: !!(flags & 1), shadow: !!(flags & 2) });
}

/** Work out the bounding radius. */
function finish(m) {
  let r = 0;
  for (const [x, y, z] of m.vertices) r = Math.max(r, Math.hypot(x, y, z));
  m.radius = r;
  m.sort = !!m.sort;
  return m;
}

/**
 * A new solid shape. parts is a list of { vertices, faces: [[a, b, c,
 * colour], ...] } convex pieces; each face normal is worked out from its
 * corners and made to point away from the middle of its piece, so the
 * corners can be listed in any order. A face written [a, b, c, colour,
 * true] is a thin fin that is seen from both sides.
 */
function solid(parts, opts = {}) {
  const vertices = [], faces = [];
  for (const p of parts) {
    const base = vertices.length;
    let cx = 0, cy = 0, cz = 0;
    for (const v of p.vertices) { cx += v[0]; cy += v[1]; cz += v[2]; }
    const n = p.vertices.length;
    const mid = p.centre || [cx / n, cy / n, cz / n];
    for (const v of p.vertices) vertices.push(v);
    for (const [a, b, c, colour, twoSided] of p.faces) {
      const A = p.vertices[a], B = p.vertices[b], C = p.vertices[c];
      const ux = B[0] - A[0], uy = B[1] - A[1], uz = B[2] - A[2];
      const wx = C[0] - A[0], wy = C[1] - A[1], wz = C[2] - A[2];
      let nx = uy * wz - uz * wy, ny = uz * wx - ux * wz, nz = ux * wy - uy * wx;
      const len = Math.hypot(nx, ny, nz) || 1;
      nx /= len; ny /= len; nz /= len;
      // point outwards: away from the middle of the piece
      const ox = A[0] - mid[0], oy = A[1] - mid[1], oz = A[2] - mid[2];
      if (nx * ox + ny * oy + nz * oz < 0) { nx = -nx; ny = -ny; nz = -nz; }
      faces.push({ normal: [nx, ny, nz], v: [a + base, b + base, c + base], colour,
        twoSided: !!twoSided });
    }
  }
  return finish({ vertices, faces, rotates: opts.rotates !== false,
    shadow: opts.shadow !== false, sort: !!opts.sort });
}

/** A ring of n points of radius r at height y (starting on the nose). */
function ring(n, r, y, turn = 0) {
  const pts = [];
  for (let i = 0; i < n; i++) {
    const a = (i + turn) * Math.PI * 2 / n;
    pts.push([r * Math.cos(a), y, r * Math.sin(a)]);
  }
  return pts;
}

/**
 * A double cone: a ring of points with an apex above (top) and below
 * (bottom), coloured by the lists (used round the ring in turn).
 */
function bicone(equator, top, bottom, topColours, bottomColours) {
  const n = equator.length;
  const vertices = [...equator, top, bottom];
  const faces = [];
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n;
    faces.push([i, j, n, topColours[i % topColours.length]]);
    faces.push([i, j, n + 1, bottomColours[i % bottomColours.length]]);
  }
  return { vertices, faces };
}

/** A copy of a model with every vertex multiplied by k. */
function scaled(m, k) {
  return finish({ ...m, vertices: m.vertices.map(([x, y, z]) => [x * k, y * k, z * k]),
    faces: m.faces.map((f) => ({ ...f })) });
}

/** A copy of a model with new face colours (a list, one per face). */
function recoloured(m, colours) {
  return finish({ ...m, faces: m.faces.map((f, i) => ({ ...f, colour: colours[i] })) });
}

