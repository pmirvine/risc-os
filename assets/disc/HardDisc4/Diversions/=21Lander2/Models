export const PICKUP_MODELS = { fuel: 'pickupFuel', missile: 'pickupMissile',
  shield: 'pickupShield', cleanse: 'pickupCleanse' };

/**
 * The original's lighting rule: how many levels of white to add to a
 * face whose (rotated) normal is (nx, ny, nz). Faces pointing up (y is
 * down, so ny < 0) are brightest; faces to the left get one level more.
 */
export function faceLevel(nx, ny) {
  let level = Math.floor(8 * (1 - ny)) + (nx < 0 ? 1 : 0) - 5;
  return level < 0 ? 0 : level;
}

/** A face colour &RGB after adding level to each channel (max 15). */
export function litColour(colour, level) {
  const r = Math.min(15, ((colour >> 8) & 15) + level);
  const g = Math.min(15, ((colour >> 4) & 15) + level);
  const b = Math.min(15, (colour & 15) + level);
  return (r << 8) | (g << 4) | b;
}

/**
 * The world position of every vertex of a model at (x, y, z) turned by
 * the orientation o = { nose, roof, side } (or not turned if o is null):
 * for collision tests, such as the original's "is any corner of the ship
 * below its shadow?" crash test.
 */
export function worldVertices(model, o, x, y, z) {
  const m = typeof model === 'string' ? MODELS[model] : model;
  return m.vertices.map(([a, b, c]) => (o && m.rotates
    ? [x + o.nose[0] * a + o.roof[0] * b + o.side[0] * c,
      y + o.nose[1] * a + o.roof[1] * b + o.side[1] * c,
      z + o.nose[2] * a + o.roof[2] * b + o.side[2] * c]
    : [x + a, y + b, z + c]));
}
