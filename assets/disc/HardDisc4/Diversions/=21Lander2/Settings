export const DEFAULTS = {
  look: 'enhanced', view: 'far', resolution: '512', display: 'full',
  soundSet: 'original', arcadeVoices: 'one', volume: 0.8, controls: 'mouse',
  sensitivity: 1, difficulty: 'normal', speed: 'normal', particles: 1000,
  shadows: true, stars: true, browserFull: false,
};

/** Speed setting -> game speed multiplier (world ticks per 1/50 s). */
export const SPEEDS = { original: 0.67, normal: 1, fast: 1.33 };

const NAME = 'Lander2.Settings';

/** Keep only values the game knows; anything else becomes the default. */
export function sanitise(s) {
  const out = { ...DEFAULTS };
  if (s && typeof s === 'object') {
    for (const o of OPTIONS) {
      if (o.values.includes(s[o.key])) out[o.key] = s[o.key];
    }
  }
  return out;
}

/** The saved settings (or the defaults). */
export async function loadSettings() {
  try {
    return sanitise(await choices.read(NAME, DEFAULTS));
  } catch {
    return { ...DEFAULTS };
  }
}

/** The directory the game's choices go in, made if need be. */
export function choicesDir() {
  const w = os.sysvars?.get?.('Choices$Write') || 'ADFS::HardDisc4.$.!Boot.Choices';
  const dir = w + '.Lander2';
  try { vfs.mkdir(dir, { parents: true }); } catch { /* read-only: never mind */ }
  return dir;
}

/** Save the settings (quietly does nothing if the disc can't be written). */
export async function saveSettings(s) {
  try {
    choicesDir();
    await choices.write(NAME, sanitise(s));
  } catch (e) {
    console.warn('Lander II: cannot save the settings', e);
  }
}

/** The next (step 1) or previous (step -1) value of a setting. */
export function stepSetting(s, key, step) {
  const o = OPTIONS.find((x) => x.key === key);
  const i = o.values.indexOf(s[key]);
  const n = o.values.length;
  s[key] = o.values[(((i < 0 ? 0 : i) + step) % n + n) % n];
  return s[key];
}

/** How a setting's current value is shown. */
export function settingName(s, key) {
  const o = OPTIONS.find((x) => x.key === key);
  const i = o.values.indexOf(s[key]);
  return i < 0 ? String(s[key]) : o.names[i];
}
