// Lander II - Raster: filling flat-coloured triangles, a row at a time.
//
// The whole 3D world is drawn from flat triangles, as David Braben's
// Lander drew it on the Archimedes: each triangle is cut into horizontal
// lines of pixels and each line is filled with one colour.
//
// Corners are screen positions with fractions (x, y), and a pixel is
// filled when its centre (px + 0.5, py + 0.5) is inside the triangle.
// A centre exactly on an edge belongs to the triangle on its right, or
// below it (the "top-left rule"), so two triangles that share an edge
// never both fill, or both miss, a pixel on it: the landscape has no
// gaps or double-drawn seams between its tiles. For that to hold, the
// x of an edge on a row is always worked out the same way - from its
// upper end - whichever triangle it belongs to.

/**
 * Fill the triangle (ax, ay), (bx, by), (cx, cy) with colour c, in the
 * pixels (a Uint32Array, width pixels a row), clipped to the rows
 * [top, bottom) and the columns [0, width).
 */
export function fillTriangle(pixels, width, top, bottom, ax, ay, bx, by, cx, cy, c) {
  let t;
  // sort the corners so that ay <= by <= cy (a is the top)
  if (by < ay) { t = ax; ax = bx; bx = t; t = ay; ay = by; by = t; }
  if (cy < ay) { t = ax; ax = cx; cx = t; t = ay; ay = cy; cy = t; }
  if (cy < by) { t = bx; bx = cx; cx = t; t = by; by = cy; cy = t; }

  // the rows whose centres are inside: ay <= py + 0.5 < cy
  let y0 = Math.ceil(ay - 0.5), y2 = Math.ceil(cy - 0.5);
  if (y0 < top) y0 = top;
  if (y2 > bottom) y2 = bottom;
  if (y0 >= y2) return;
  let y1 = Math.ceil(by - 0.5);
  if (y1 < y0) y1 = y0;
  if (y1 > y2) y1 = y2;

  // the long edge a-c runs the full height; is it on the left?
  const sac = (cx - ax) / (cy - ay);
  const left = ax + (by - ay) * sac < bx;

  if (y1 > y0) {
    // upper half: edges a-c and a-b
    const sab = (bx - ax) / (by - ay);
    if (left) spans(pixels, width, y0, y1, ax, ay, sac, ax, ay, sab, c);
    else spans(pixels, width, y0, y1, ax, ay, sab, ax, ay, sac, c);
  }
  if (y2 > y1) {
    // lower half: edges a-c and b-c
    const sbc = (cx - bx) / (cy - by);
    if (left) spans(pixels, width, y1, y2, ax, ay, sac, bx, by, sbc, c);
    else spans(pixels, width, y1, y2, bx, by, sbc, ax, ay, sac, c);
  }
}

/**
 * Fill rows [y0, y1) between a left edge (starting at lx, ly with slope
 * ls, in x per row) and a right edge (rx, ry, rs).
 */
function spans(pixels, width, y0, y1, lx, ly, ls, rx, ry, rs, c) {
  for (let y = y0; y < y1; y++) {
    const yc = y + 0.5;
    let x0 = Math.ceil(lx + (yc - ly) * ls - 0.5);
    let x1 = Math.ceil(rx + (yc - ry) * rs - 0.5);
    if (x0 < 0) x0 = 0;
    if (x1 > width) x1 = width;
    if (x1 <= x0) continue;
    let i = y * width + x0;
    const e = y * width + x1;
    if (x1 - x0 < 24) {
      for (; i < e; i++) pixels[i] = c;
    } else {
      pixels.fill(c, i, e);
    }
  }
}

/** Fill a rectangle of pixels, clipped to the rows [top, bottom). */
export function fillBox(pixels, width, top, bottom, x, y, w, h, c) {
  let x0 = x < 0 ? 0 : x, y0 = y < top ? top : y;
  const x1 = x + w > width ? width : x + w, y1 = y + h > bottom ? bottom : y + h;
  for (; y0 < y1; y0++) {
    for (let i = y0 * width + x0, e = y0 * width + x1; i < e; i++) pixels[i] = c;
  }
}
