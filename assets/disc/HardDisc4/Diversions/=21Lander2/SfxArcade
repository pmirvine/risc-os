// Lander II - SfxArcade: the "Arcade" sound set, in the style of the
// Williams arcade machines of the early 1980s (Defender, Stargate,
// Robotron: 2084).
//
// Those machines had a little sound computer of their own (a 6800 chip
// feeding an 8-bit converter) that made every sound in software: square
// and sawtooth waves swooping up and down in pitch, and "sample and hold"
// noise - a random level held for a while, then another - whose rate
// sweeps down so an explosion seems to fall in pitch as it dies away.
// That is how these recipes work too, made clean and bright at 32000
// samples a second, with no 8-bit grain.
//
// The fields of each recipe are explained at the top of SfxOrig.

import { perc, line, sweep, glide, steps, wobble, times, note, echo,
  fadeOut } from './SfxKit';

const RATE = 32000;

// ---------------------------------------------------------------- helpers

// Soft-edged gate for a note `dur` long: 2 ms in, 5 ms out, no clicks.
const gate = (dur, g = 1) => line([[0, 0], [0.002, g], [dur - 0.005, g], [dur, 0]]);

// A run of square-wave notes (Hz), each `each` seconds apart and `len`
// long: arpeggios, fanfares and the "1-up" jingle.
function arp(k, a, freqs, each, o = {}) {
  const { start = 0, len = each, wave = 'square', duty = 0.5, gain = 1 } = o;
  freqs.forEach((f, i) => {
    k.tone(a, { wave, duty, freq: f, start: start + i * each, dur: len,
      gain: gate(len, gain) });
  });
  return a;
}

// A Williams explosion: sample-and-hold noise whose rate falls from `hi`
// to `lo` (the falling "kksshhh"), and a square wave diving underneath.
function boom(k, a, o) {
  const { start = 0, dur, hi = 8000, lo = 400, sq = 400 } = o;
  k.noise(a, { start, dur, hold: sweep(hi, lo, dur), gain: perc(0.002, dur) });
  k.tone(a, { wave: 'square', start, dur: dur * 0.85, freq: sweep(sq, 35, dur * 0.8),
    gain: perc(0.002, dur * 0.8, 0.45) });
  return a;
}

// ---------------------------------------------------------------- the set

export const SET = {
  name: 'arcade',
  title: 'Arcade (Defender / Robotron)',
  rate: RATE,
  target: -19,
  finish: null,
  pan: (p) => p * 0.7,        // the originals were mono: keep the stereo narrow

  sounds: {
    // The player's laser: the classic "pew", a square wave diving from
    // 1800 to 200 Hz in 90 ms. Quiet, short and varied a little each shot,
    // because it autofires at up to 25 a second.
    fire: {
      level: -8, pos: true, gap: 0.035, max: 3, vary: 0.04,
      make(k) {
        const a = k.buffer(0.1);
        k.tone(a, { wave: 'square', freq: sweep(1800, 200, 0.09), dur: 0.1,
          gain: line([[0, 0], [0.001, 1], [0.05, 0.5], [0.1, 0]]),
          duty: glide(0.5, 0.2, 0.09) });
        return a;
      },
    },
    // Alien fire: the "pew" turned round, a thin pulse wave rising 600 to
    // 1200 Hz, so it reads as hostile.
    enemyFire: {
      level: -8, pos: true, gap: 0.05, max: 3, vary: 0.03,
      make(k) {
        const a = k.buffer(0.08);
        k.tone(a, { wave: 'pulse', duty: 0.25, freq: sweep(600, 1200, 0.07),
          gain: line([[0, 0], [0.001, 1], [0.06, 0.6], [0.075, 0]]) });
        return a;
      },
    },
    // A shot hitting the ground: a tick of coarse noise.
    hitSmall: {
      level: -11, pos: true, gap: 0.04, max: 3, vary: 0.1,
      make(k) {
        const a = k.buffer(0.06);
        k.noise(a, { hold: 3000, gain: perc(0.001, 0.05) });
        k.tone(a, { wave: 'square', freq: sweep(300, 100, 0.04),
          gain: perc(0.001, 0.04, 0.3) });
        return a;
      },
    },
    // An alien blown up: noise falling from 8000 to 600 holds a second,
    // over a square wave diving 400 to 40 Hz.
    explodeSmall: {
      level: 0, pos: true, gap: 0.05, max: 5, vary: 0.08,
      make(k) { return boom(k, k.buffer(0.65), { dur: 0.6, hi: 8000, lo: 600 }); },
    },
    // A big kill: the Robotron boom, long and deep, with an extra blast of
    // white noise at the start.
    explodeLarge: {
      level: 3, pos: true, gap: 0.08, max: 3, vary: 0.05,
      make(k) {
        const a = k.buffer(1.6);
        boom(k, a, { dur: 1.5, hi: 6000, lo: 150, sq: 200 });
        k.noise(a, { dur: 0.6, gain: perc(0.002, 0.6, 0.6),
          filter: { type: 'lp', freq: sweep(4000, 200, 0.6) } });
        return a;
      },
    },
    // The player dies: Defender's long falling wail (a square wave from
    // 1000 down to 50 Hz with a 12 Hz vibrato) over a two-second boom.
    crash: {
      level: 4, gap: 0.5, max: 1,
      make(k) {
        const a = k.buffer(2.2);
        k.tone(a, { wave: 'square', freq: wobble(sweep(1000, 50, 1.5), 12, 0.3),
          dur: 1.7, gain: line([[0, 0], [0.01, 0.6], [1.4, 0.45], [1.7, 0]]) });
        k.noise(a, { hold: sweep(5000, 200, 2.0), gain: perc(0.005, 2.0) });
        return fadeOut(a, RATE, 0.2);
      },
    },
    // A soft touchdown: a two-note "bloop" up a fifth.
    land: {
      level: -7, gap: 0.3,
      make(k) {
        const a = k.buffer(0.17);
        k.tone(a, { wave: 'square', freq: 523, dur: 0.06, gain: gate(0.06) });
        k.tone(a, { wave: 'square', freq: 784, start: 0.07, dur: 0.09,
          gain: gate(0.09) });
        return a;
      },
    },
    // Tanks full: a fast C major arpeggio, C E G C.
    refuelFull: {
      level: -8, gap: 0.5,
      make(k) {
        return arp(k, k.buffer(0.17), ['C6', 'E6', 'G6', 'C7'].map(note), 0.04,
          { duty: 0.25 });
      },
    },
    // Pickup: four quick rising notes.
    pickup: {
      level: -6, gap: 0.1,
      make(k) { return arp(k, k.buffer(0.15), [660, 880, 1100, 1320], 0.035); },
    },
    // Wave start: a Defender-style fanfare, G C E G on a square lead over
    // a sawtooth bass.
    waveStart: {
      level: -4, gap: 1,
      make(k) {
        const a = k.buffer(1.2);
        arp(k, a, ['G4', 'C5', 'E5'].map(note), 0.1);
        k.tone(a, { wave: 'square', freq: wobble(note('G5'), 7, 0.012), start: 0.3,
          dur: 0.45, gain: gate(0.45) });
        k.tone(a, { wave: 'saw', freq: note('C3'), dur: 1.1, gain: gate(1.1, 0.6),
          filter: { type: 'lp', freq: 1500 } });
        return fadeOut(a, RATE, 0.3);
      },
    },
    // Wave cleared: a rising sweep, then chords: C, G, C.
    waveCleared: {
      level: -4, gap: 1,
      make(k) {
        const a = k.buffer(1.35);
        k.tone(a, { wave: 'square', freq: sweep(200, 2000, 0.4), dur: 0.4,
          gain: gate(0.4, 0.6) });
        const chord = (names, start, dur) => {
          for (const n of names) {
            k.tone(a, { wave: 'saw', freq: note(n), start, dur, gain: gate(dur, 0.5),
              filter: { type: 'lp', freq: 3500 } });
          }
        };
        chord(['C4', 'E5', 'G5', 'C6'], 0.45, 0.18);
        chord(['G3', 'D5', 'G5', 'B5'], 0.65, 0.18);
        chord(['C4', 'E5', 'G5', 'C6'], 0.85, 0.45);
        return a;
      },
    },
    // Extra life: the "1-up", six staccato square pulses stepping up a
    // semitone each.
    extraLife: {
      level: -5, gap: 1,
      make(k) {
        const f = [0, 1, 2, 3, 4, 5].map((i) => 1047 * Math.pow(2, i / 12));
        return arp(k, k.buffer(0.5), f, 0.08, { len: 0.05 });
      },
    },
    // Low fuel: a pair of square beeps at 1000 Hz, every second.
    lowFuel: {
      level: -8, gap: 0.8, repeat: 1.0,
      make(k) {
        return arp(k, k.buffer(0.23), [1000, 1000], 0.14, { len: 0.08 });
      },
    },
    // Game over: G F E D C on a square lead, then a wash of noise.
    gameOver: {
      level: -3, gap: 2,
      make(k) {
        const a = k.buffer(2.2);
        arp(k, a, ['G4', 'F4', 'E4', 'D4'].map(note), 0.2, { len: 0.18 });
        k.tone(a, { wave: 'square', freq: wobble(note('C4'), 6, 0.015), start: 0.8,
          dur: 0.6, gain: gate(0.6) });
        k.tone(a, { wave: 'saw', freq: note('C2'), start: 0.8, dur: 0.6,
          gain: gate(0.6, 0.5), filter: { type: 'lp', freq: 800 } });
        k.noise(a, { start: 1.0, dur: 1.2, gain: line([[0, 0], [0.2, 0.35], [1.2, 0]]),
          filter: { type: 'lp', freq: sweep(3000, 300, 1.2) } });
        return a;
      },
    },
    // Homing missile: a sawtooth rising 300 to 1200 Hz with a hiss.
    missileLaunch: {
      level: -5, pos: true, gap: 0.15,
      make(k) {
        const a = k.buffer(0.32);
        k.tone(a, { wave: 'saw', freq: sweep(300, 1200, 0.25), gain: perc(0.005, 0.3) });
        k.noise(a, { gain: perc(0.002, 0.25, 0.3), filter: { type: 'hp', freq: 2000 } });
        return a;
      },
    },
    // Alien missile: the same falling instead of rising.
    enemyMissileLaunch: {
      level: -6, pos: true, gap: 0.15,
      make(k) {
        const a = k.buffer(0.32);
        k.tone(a, { wave: 'saw', freq: sweep(1200, 300, 0.25), gain: perc(0.005, 0.3) });
        k.noise(a, { gain: perc(0.002, 0.25, 0.3), filter: { type: 'hp', freq: 2000 } });
        return a;
      },
    },
    // Smart bomb: Defender's - a roar of full-level noise with a lowpass
    // filter closing from 8 kHz to 100 Hz, and a square wave diving from
    // 3000 to 50 Hz.
    smartBomb: {
      level: 4, gap: 0.5,
      make(k) {
        const a = k.buffer(1.6);
        k.noise(a, { gain: line([[0, 0], [0.005, 1], [0.4, 0.8], [1.55, 0]]),
          filter: { type: 'lp', freq: sweep(8000, 100, 1.5) } });
        k.tone(a, { wave: 'square', freq: sweep(3000, 50, 0.7), dur: 0.8,
          gain: perc(0.002, 0.8, 0.5) });
        return a;
      },
    },
    // Virus alert: a two-tone siren, 440 / 660 Hz, 150 ms each.
    virusAlert: {
      level: -4, gap: 2,
      make(k) {
        const a = k.buffer(1.25);
        k.tone(a, { wave: 'square', freq: steps(0.15, [440, 660], true), dur: 1.2,
          gain: gate(1.2), filter: { type: 'lp', freq: 3000 } });
        return a;
      },
    },
    // Shield hit: a fast warble and a crackle.
    shieldHit: {
      level: -5, gap: 0.1,
      make(k) {
        const a = k.buffer(0.18);
        k.tone(a, { wave: 'square', freq: steps(0.025, [2000, 1500], true), dur: 0.16,
          gain: perc(0.002, 0.16) });
        k.noise(a, { hold: 4000, dur: 0.03, gain: perc(0.001, 0.03, 0.7) });
        return a;
      },
    },
    // A tree turns bad: a thin trilling square falling an octave.
    treeMutated: {
      level: -12, pos: true, gap: 0.2, max: 2,
      make(k) {
        const a = k.buffer(0.3);
        k.tone(a, { wave: 'pulse', duty: 0.3,
          freq: wobble(sweep(300, 150, 0.25), 30, 0.2),
          gain: perc(0.005, 0.25) });
        return a;
      },
    },
    // A seeder turning into a mutant: a pulse wave trilling 40 times a
    // second as it climbs two octaves.
    enemyMutated: {
      level: -6, pos: true, gap: 0.2, max: 2,
      make(k) {
        const a = k.buffer(0.42);
        const up = sweep(150, 600, 0.4);
        k.tone(a, { wave: 'pulse', duty: 0.3,
          freq: (t) => up(t) * (Math.floor(t * 80) % 2 ? 1.5 : 1),
          gain: line([[0, 0], [0.005, 1], [0.35, 0.8], [0.42, 0]]) });
        return a;
      },
    },
    // A tree or building destroyed: a short falling crunch.
    objectDestroyed: {
      level: -4, pos: true, gap: 0.08, max: 3, vary: 0.08,
      make(k) {
        return boom(k, k.buffer(0.4), { dur: 0.35, hi: 3000, lo: 500, sq: 150 });
      },
    },
    // A seeder dropping virus: a soft low bloop.
    seederSpray: {
      level: -16, pos: true, gap: 0.12, max: 2, vary: 0.2,
      make(k) {
        const a = k.buffer(0.03);
        k.tone(a, { wave: 'square', freq: sweep(300, 220, 0.02), dur: 0.025,
          gain: gate(0.025) });
        return a;
      },
    },
    // A new ship materialising: a sweep up through a flickering arpeggio,
    // Robotron style.
    respawn: {
      level: -6, gap: 0.5,
      make(k) {
        const a = k.buffer(0.6);
        const up = sweep(200, 1600, 0.5), chord = [1, 1.25, 1.5];
        k.tone(a, { wave: 'square', freq: (t) => up(t) * chord[Math.floor(t / 0.02) % 3],
          dur: 0.56, gain: line([[0, 0], [0.01, 1], [0.5, 0.8], [0.56, 0]]) });
        return a;
      },
    },
    // Menus and the high-score table: short square blips.
    uiMove: {
      level: -10, gap: 0.03,
      make(k) {
        const a = k.buffer(0.025);
        k.tone(a, { wave: 'square', freq: 900, gain: gate(0.025) });
        return a;
      },
    },
    uiSelect: {
      level: -8, gap: 0.05,
      make(k) {
        const a = k.buffer(0.05);
        k.tone(a, { wave: 'square', freq: sweep(900, 1800, 0.05), gain: gate(0.05) });
        return a;
      },
    },
    uiBack: {
      level: -9, gap: 0.05,
      make(k) {
        const a = k.buffer(0.05);
        k.tone(a, { wave: 'square', freq: sweep(1800, 900, 0.05), gain: gate(0.05) });
        return a;
      },
    },
    hsLetter: {
      level: -11, gap: 0.03,
      make(k) {
        const a = k.buffer(0.02);
        k.tone(a, { wave: 'square', freq: 1500, gain: gate(0.02) });
        return a;
      },
    },
    hsConfirm: {
      level: -8, gap: 0.1,
      make(k) {
        return arp(k, k.buffer(0.2), ['C5', 'E5', 'G5', 'C6', 'E6'].map(note), 0.04);
      },
    },
    // Title tune: a zooming C major arpeggio, a rising lead and a
    // sawtooth bass line.
    titleJingle: {
      level: -4, gap: 1,
      make(k) {
        const a = k.buffer(1.8);
        arp(k, a, ['C5', 'E5', 'G5', 'C6', 'E6', 'G6'].map(note), 0.06, { duty: 0.25 });
        arp(k, a, ['G5', 'A5', 'B5'].map(note), 0.15, { start: 0.4, len: 0.14 });
        k.tone(a, { wave: 'square', freq: wobble(note('C6'), 6, 0.012), start: 0.85,
          dur: 0.7, gain: gate(0.7) });
        const bass = [['C3', 0, 0.4], ['G2', 0.4, 0.45], ['C3', 0.85, 0.7]];
        for (const [n, start, dur] of bass) {
          k.tone(a, { wave: 'saw', freq: note(n), start, dur, gain: gate(dur, 0.6),
            filter: { type: 'lp', freq: 1200 } });
        }
        return fadeOut(echo(a, RATE, 0.12, 0.2, 0.3), RATE, 0.25);
      },
    },
    // New high score: an arpeggio up to a shimmering major chord.
    highScore: {
      level: -4, gap: 1,
      make(k) {
        const a = k.buffer(1.1);
        arp(k, a, ['C5', 'E5', 'G5'].map(note), 0.07);
        for (const n of ['C6', 'E6', 'G6']) {
          k.tone(a, { wave: 'square', freq: wobble(note(n), 7, 0.01), start: 0.21,
            dur: 0.8, gain: times(gate(0.8, 0.5), perc(0.01, 1.4)) });
        }
        return a;
      },
    },
  },

  loops: {
    // Engine: a rattly 70 Hz sawtooth (an 18 Hz wobble of +- 6 Hz) with
    // some rumbling noise. Full thrust raises it to 90 Hz and opens the
    // filter.
    thrust: {
      level: -5, loop: 0.1, filter: 'lowpass', q: 0.9, attack: 0.04, release: 0.12,
      glide: 0.1,
      make(k) {
        const a = k.buffer(1.1);
        k.tone(a, { wave: 'saw', freq: (t) => 70 + 6 * Math.sin(2 * Math.PI * 18 * t),
          gain: 0.7 });
        k.noise(a, { gain: 0.5, filter: { type: 'lp', freq: 900 } });
        return a;
      },
      params: (s) => (s.thrust
        ? { gain: 1, rate: 90 / 70, freq: 3000 }
        : { gain: 0.55, rate: 0.95, freq: 1200 }),
    },
    // Refuelling: square blips every 80 ms, getting higher and quicker as
    // the tank fills.
    refuel: {
      level: -10, filter: 'lowpass', q: 0.7, attack: 0.02, release: 0.05,
      make(k) {
        const a = k.buffer(0.32);
        arp(k, a, [400, 400, 400, 400], 0.08, { len: 0.03 });
        return a;
      },
      params: (s) => ({ gain: 1, rate: 1 + 1.5 * s.fuel, freq: 8000 }),
    },
    // Bomber whoosh, with a 90 Hz sawtooth drone underneath.
    bomber: {
      level: 1, loop: 0.2, filter: 'bandpass', q: 1.2, attack: 0.1, release: 0.3,
      make(k) {
        const a = k.buffer(2.2);
        k.noise(a, { gain: wobble(0.8, 0.5, 0.3) });
        k.tone(a, { wave: 'saw', freq: 90, gain: 0.4 });
        return a;
      },
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 400 + 1600 * s.near }),
    },
    // Pests: square-wave trills, a new random note (2-3 kHz) every 30 ms.
    pest: {
      level: -11, filter: 'lowpass', q: 0.7, attack: 0.05, release: 0.2,
      make(k) {
        const a = k.buffer(0.96);
        const f = [];
        for (let i = 0; i < 32; i++) f.push(2500 + 500 * k.random());
        return arp(k, a, f, 0.03, { len: 0.022 });
      },
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 9000 }),
    },
  },
};
