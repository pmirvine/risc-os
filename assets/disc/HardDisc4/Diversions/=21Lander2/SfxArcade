      priority: 0xB8, protect: ticks(6),
      make: board([[0, 0x12]]),
    },
    // A seeder becomes a mutant: Defender's lander reaching the top of
    // the screen (the spinner, command $0E, sent 10 frames running, so it
    // whirrs up ten steps).
    enemyMutated: {
      level: -5, pos: true, gap: 0.2, max: 2,
      priority: 0xC8, protect: held('landerSuck'),
      make: board('landerSuck', { seconds: 0.5, fade: 0.1 }),
    },
    // A tree or building destroyed: the Williams explosion (FNOISE as
    // CANNON) closing down 2.5 times faster: a shorter crunch.
    objectDestroyed: {
      level: -4, pos: true, gap: 0.08, max: 3, vary: 0.06,
      priority: 0xD0, protect: held('schitzHit'),
      make: board([[0, 'fnoise', { fmax: 0xFF, sampc: 400, fdflg: 1, dsflg: 1 }]],
        { seconds: 1.0, fade: 0.2 }),
    },
    // A seeder dropping virus: a few ticks of the lightning routine (LITEN)
    // with a delay falling fast: a soft crackle, short enough to repeat.
    // The lowest priority of all: it never cuts another sound off.
    seederSpray: {
      level: -18, pos: true, gap: 0.12, max: 2, vary: 0.2,
      priority: 0xB8, protect: ticks(3),
      make: board([[0, 'liten', { lfreq: 0x20, dfreq: 0xFC, cycnt: 8 }]],
        { seconds: 0.05, fade: 0.015 }),
    },
    // A new ship: Defender's APPEAR (command $15), what it plays as a ship
    // materialises - a crackle that speeds up into a hiss. Priority $F0
    // (Defender's is $D0) so it cuts off the tail of the death explosion.
    respawn: {
      level: -5, gap: 0.5,
      priority: 0xF0, protect: held('appear'),
      make: board('appear'),
    },
    // Menus and the high-score table: short Williams blips. They play
    // alongside whatever else is sounding (oneVoice: false).
    // uiMove: the first pitch of the spinner "drip" (command $08, SPNRV).
    uiMove: {
      level: -9, gap: 0.03, oneVoice: false,
      make: board('SPNRV', { until: ['gwave', 1], fade: 0.004 }),
    },
    // uiSelect: the whole "drip", a rising "bloip".
    uiSelect: {
      level: -7, gap: 0.05, oneVoice: false,
      make: board('SPNRV'),
    },
    // uiBack: the start of the "cool downer" (command $09, CLDWNV).
    uiBack: {
      level: -8, gap: 0.05, oneVoice: false,
      make: board('CLDWNV', { seconds: 0.045, fade: 0.01 }),
    },
    // hsLetter: one pass of XBV (command $04), a tiny zip.
    hsLetter: {
      level: -10, gap: 0.03, oneVoice: false,
      make: board('XBV', { until: ['gwave', 1], fade: 0.003 }),
    },
    // hsConfirm: one pass of ED17, four notes up.
    hsConfirm: {
      level: -7, gap: 0.1, oneVoice: false,
      make: board('ED17', { until: ['gwave', 1], fade: 0.01 }),
    },
    // Title tune: the first phrase (seven notes) of Defender's high-score
    // tune, Bach's Toccata in D minor on the board's "organ".
    titleJingle: {
      level: -4, gap: 1,
      priority: 0xFF,
      make: board('toccata', { until: ['note', 7], fade: 0.15 }),
    },
    // New high score: Defender's "Phantom" tune (three organ notes).
    highScore: {
      level: -4, gap: 1,
      priority: 0xFF,
      make: board('phantom'),
    },
  },

  loops: {
    // Engine: Defender's thrust (command $16, THRUST) - noise whose level
    // may change by only 3 steps every 30 CPU cycles: a roar. Hovering
    // plays it at a third of the speed, which is just what Defender's
    // background rumble (BG1, the same routine with a slope of 1) is.
    // Defender rumbles all the time in play, so `idle` (flying, engines
    // off) plays the rumble quietly too.
    thrust: {
      idle: true,
      level: -5, filter: 'lowpass', q: 0.7, attack: 0.03, release: 0.12,
      glide: 0.08,
      make: loop('THRUST', { seconds: 1.5, crossfade: 0.1 }),
      params: (s) => (s.thrust
        ? { gain: 1, rate: 1, freq: 16000 }
        : s.idle ? { gain: 0.35, rate: 1 / 3, freq: 16000 }
          : { gain: 0.8, rate: 1 / 3, freq: 16000 }),
    },
    // Refuelling: Defender's BG2 turbine (command $10): a low sine whose
    // pitch steps round a short pattern. BG2 rose a step each time the
    // command was sent again; here the pitch rises as the tank fills.
    // One pass of the pattern repeats exactly, so it loops cleanly.
    refuel: {
      level: -10, filter: 'lowpass', q: 0.7, attack: 0.02, release: 0.08,
      make: loop([[0, 0x10]], { mark: 'gwave', from: 1, to: 3 }),
      params: (s) => ({ gain: 1, rate: 1 + 1.5 * s.fuel, freq: 12000 }),
    },
    // Bomber: Williams filtered noise (FNOISE) whose slope is picked at
    // random for each stretch, from 1 to 7 (6 AND a random byte, plus
    // Robotron's minimum of 1, as its HBOMB does): a rough, crackly roar.
    // Its sound lies low, so it is muffled with distance by a low-pass
    // rather than the band-pass of the Original set (whose band-pass takes
    // about 9 dB off; hence the lower level here).
    bomber: {
      level: -8, filter: 'lowpass', q: 0.9, attack: 0.1, release: 0.3,
      make: loop([[0, 'fnoise', { fmax: 6, sampc: 0, dsflg: 1, lofrq: 1 }]],
        { rom: 'robotron', seconds: 2.0, crossfade: 0.2 }),
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 700 + 5000 * s.near }),
    },
    // Pests: Robotron's mosquito (command $3F, MOSQTO): the first two of
    // its rising whoops, looped.
    pest: {
      level: -9, filter: 'lowpass', q: 0.7, attack: 0.05, release: 0.2,
      make: loop('MOSQTO', { mark: 'vari', from: 0, to: 2 }),
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 9000 }),
    },
  },
};
