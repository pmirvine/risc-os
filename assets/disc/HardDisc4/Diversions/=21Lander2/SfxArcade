    lowFuel: {
      level: -7, gap: 0.8, repeat: 1.0,
      priority: 0xC8, protect: held('probeHit'),
      make: board('probeHit', { seconds: 0.35, fade: 0.05 }),
    },
    // Game over: Defender's falling humanoid (command $1A, SCREAM): four
    // falling whistles, each starting half a second after the last.
    gameOver: {
      level: -3, gap: 2,
      priority: 0xF0, protect: held('astroScream'),
      make: board('astroScream', { seconds: 2.5, fade: 0.6 }),
    },
    // Our homing missile: Robotron's LAUNCH (command $39), the lightning
    // routine with its delay shrinking slowly: a rocket's crackle.
    missileLaunch: {
      level: -4, pos: true, gap: 0.15,
      priority: 0xC8, protect: ticks(8),
      make: board('LAUNCH', { seconds: 0.45, fade: 0.12 }),
    },
    // An alien missile: Defender's mutant shot (command $09, CLDWNV), a
    // spiky wave falling "zeeoooww".
    enemyMissileLaunch: {
      level: -5, pos: true, gap: 0.15,
      priority: 0xC0, protect: held('schitzoShoot'),
      make: board('schitzoShoot', { seconds: 0.35, fade: 0.08 }),
    },
    // Smart bomb: exactly Defender's - six crackles of lightning 4 frames
    // apart, then the explosion.
    smartBomb: {
      level: 2, gap: 0.5,
      priority: 0xE8, protect: held('smartBomb'),
      make: board('smartBomb', { seconds: 2.6, fade: 0.5 }),
    },
    // Virus alert: Robotron's siren (command $31, SIREN): a square wave
