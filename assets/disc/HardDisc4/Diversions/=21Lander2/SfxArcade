// Lander II - SfxArcade: the "Arcade" sound set - the sound board of the
// Williams arcade machines Defender (1980) and Robotron: 2084 (1982).
//
// Credit: Williams Electronics Defender (1980) / Robotron: 2084 (1982)
// sound ROM, by Sam Dicker; routines and tables transcribed from the
// original source.
//
// Every sound here is played on Williams (the file next to this one), a
// recreation of that board which runs Sam Dicker's sound routines cycle
// for cycle with the original tables. Where Lander II has an event that
// Defender had too, it gets Defender's own sound, sent the way Defender's
// game sent it (its "sound table": which commands, how many times, how
// many 60ths of a second apart). Where Defender has nothing to match,
// Robotron often does; failing that, the sound is a Williams routine with
// parameters of our own, chosen in the same style. Each recipe below
// says where its sound comes from.
//
// The board could only play one sound at a time. The game decided which
// sound got through by priority: a new sound was sent only if it
// mattered at least as much as the one playing, and it cut that one off.
// Each recipe carries Defender's priority byte (its main program's sound
// tables: $FF for an extra ship, $F0 for the player's death, $E8 a smart
// bomb, $E0 rescuing a humanoid, $D0 an explosion, $C0 a shot) as
// `priority`; Sound's one-voice channel (see Channel) uses it. `protect`
// (seconds) records how long the game held that priority: the time of
// Defender's (or Robotron's) table where there is one. On the board the
// sound then played on, but anything could cut in. (The tunes have none:
// nothing else played with them.) Menu blips have oneVoice: false and
// play alongside whatever else is sounding.
//
// The fields of each recipe are explained at the top of SfxOrig. The
// options to render() and renderLoop() are explained at the top of
// Williams: `seconds` cuts a sound short (the arcade's sounds often ran on
// for seconds until the next one cut them off), `fade` smooths the cut.

import { render, renderLoop, SOUNDS } from './Williams';

const RATE = 48000;

// Play a Williams sound (a name from Williams' SOUNDS, a command number or
// a list of timed commands) with render()'s options. The seed comes from
// the synthesiser's own seeded random numbers, so each sound's noise is
// its own but the same every time it is made.
// (make.williams keeps what was asked for, for the developer's page.)
function board(sound, o = {}) {
  const make = (k) => render(sound, { rate: RATE, seed: (k.random() + 1) / 2, ...o });
  make.williams = { sound, o };
  return make;
}
function loop(sound, o = {}) {
  const make = (k) => renderLoop(sound, { rate: RATE, seed: (k.random() + 1) / 2, ...o });
  make.williams = { sound, o, loop: true };
  return make;
}

// How long a game table held its priority, in seconds; and n frames.
const held = (name) => +SOUNDS[name].protect.toFixed(3);
const ticks = (n) => +(n / 60).toFixed(3);

// ---------------------------------------------------------------- the set

export const SET = {
  name: 'arcade',
  title: 'Arcade (Defender / Robotron)',
  rate: RATE,
  target: -19,
  finish: null,
  pan: (p) => p * 0.4,        // the originals were mono: keep the stereo narrow

