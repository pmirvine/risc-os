    fire: {
      level: -8, pos: true, gap: 0.035, max: 3, vary: 0.03,
      priority: 0xC0, protect: held('laser'),
      make: board('laser', { seconds: 0.35, fade: 0.12 }),
    },
    // Alien fire: Defender's lander and baiter shot (command $03, DP1V):
