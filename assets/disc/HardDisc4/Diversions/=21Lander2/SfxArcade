      level: -7, pos: true, gap: 0.05, max: 3, vary: 0.03,
      priority: 0xC0, protect: held('landerShoot'),
      make: board('landerShoot'),
    },
    // A shot hits the ground, or an enemy that survives it: Defender's
    // explosion routine (FNOISE, as CANNON: full-range noise whose slope
    // limit shrinks by 1/8 at a time) closing down seven times faster -
    // 150 steps per shrink instead of 1000 - for a short "tsshk".
    hitSmall: {
      level: -11, pos: true, gap: 0.04, max: 3, vary: 0.1,
      priority: 0xC8, protect: ticks(8),
      make: board([[0, 'fnoise', { fmax: 0xFF, sampc: 150, fdflg: 1, dsflg: 1 }]],
        { seconds: 0.25, fade: 0.05 }),
    },
    // An alien blown up: Defender's lander explosion (command $06, HBEV):
    // a 72-step sine sliding down from 392 to 30 Hz, four echoes each a
    // quarter quieter, wrapping round gritty: "bwoww-bwoww-bwoww".
    explodeSmall: {
      level: 0, pos: true, gap: 0.05, max: 5, vary: 0.06,
      priority: 0xD0, protect: held('landerHit'),
      make: board('landerHit'),
    },
    // A big kill (a bomber, a monster): Defender's mutant explosion
    // (command $17, CANNON), the classic Williams boom - white noise
    // closing down to a rumble. Its priority is a step above Defender's
    // $D0 so that a small explosion doesn't cut the big one short.
    explodeLarge: {
      level: 1, pos: true, gap: 0.08, max: 3, vary: 0.04,
      priority: 0xD4, protect: held('schitzHit'),
      make: board('schitzHit', { seconds: 1.8, fade: 0.5 }),
    },
    // The player dies: exactly Defender's player death - two crackles of
    // lightning (LITE) 8 frames apart, each cutting the one before, then
    // the explosion (CANNON).
    crash: {
      level: 2, gap: 0.5, max: 1,
      priority: 0xF0, protect: held('playerDeath'),
      make: board('playerDeath', { seconds: 2.6, fade: 0.5 }),
    },
    // A soft touchdown: the first "whoop" of Defender's humanoid set down
    // safely (command $1F, QUASAR): a square wave rising 376 to 1504 Hz.
    land: {
      level: -6, gap: 0.3,
      priority: 0xE0, protect: held('astroLand'),
      make: board('astroLand', { until: ['vari', 1], fade: 0.01 }),
    },
    // Tanks full: the first four passes of Robotron's "family saved"
    // chime (command $0D, ED17), a rising four-note arpeggio.
    refuelFull: {
      level: -7, gap: 0.5,
      priority: 0xE0, protect: held('saveHuman'),
      make: board('saveHuman', { until: ['gwave', 4], fade: 0.02 }),
    },
    // A pickup: Defender's humanoid caught in mid-air (command $08 sent
    // three times, 10 frames apart, SPNRV): three rising "bloip"s. Sound
