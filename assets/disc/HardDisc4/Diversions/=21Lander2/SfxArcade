    waveStart: {
      level: -5, gap: 1,
      priority: 0xF0, protect: held('start1'),
      make: board('start1', { seconds: held('start1') + 0.1, fade: 0.25 }),
    },
    // Wave cleared: Robotron's wave end - the spinner (command $0E, SP1)
