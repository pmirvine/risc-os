  loops: {
    // Engine thrust: a second of white noise plus a 55 Hz rumble wobbling
    // 7 times a second, looped. It plays through a lowpass filter: full
    // thrust opens the filter to a roaring hiss, hovering is a lower,
    // quieter rush.
    thrust: {
      level: -3, loop: 0.1, filter: 'lowpass', q: 1.2, attack: 0.04, release: 0.12,
      make(k) {
        const a = k.buffer(1.1);
        k.noise(a, { gain: 0.8 });
        k.tone(a, { freq: 55, gain: wobble(0.9, 7, 0.2) });
        k.tone(a, { freq: 110, gain: 0.2 });
        return a;
      },
      params: (s) => (s.thrust
        ? { gain: 1, rate: 1, freq: 2200 }
        : { gain: 0.5, rate: 0.85, freq: 800 }),
    },
    // Refuelling on the pad: a soft tremolo tone (220 Hz), rising a
    // semitone for every tenth of the tank filled.
    refuel: {
      level: -10, filter: 'lowpass', q: 0.7, attack: 0.05, release: 0.1,
      make(k) {
        const a = k.buffer(1.0);       // exactly 220 and 8 cycles: loops cleanly
        const trem = wobble(1, 8, 0.35);
        k.tone(a, { freq: 220, gain: trem });
        k.tone(a, { freq: 440, gain: times(trem, 0.25) });
        k.tone(a, { freq: 660, gain: times(trem, 0.1) });
        return a;
      },
      params: (s) => ({ gain: 1, rate: Math.pow(2, s.fuel * 10 / 12), freq: 6000 }),
    },
    // Bombers "whooshing" overhead: noise through a bandpass filter that
    // opens up as a bomber comes close; Sound fades and pans it with the
    // nearest bomber and bends its pitch as it approaches or leaves.
    bomber: {
      level: 1, loop: 0.2, filter: 'bandpass', q: 1.5, attack: 0.1, release: 0.3,
      make(k) {
        const a = k.buffer(2.2);
        k.noise(a, { gain: wobble(0.8, 0.5, 0.3) });
        return a;
      },
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 400 + 1600 * s.near }),
    },
    // Pests "twittering": a sine jumping to a new random pitch every 40 ms,
    // each note a little falling chirp, and the level pulsing 25 times a
    // second (silent at each jump, so there are no clicks).
    pest: {
      level: -9, filter: 'lowpass', q: 0.7, attack: 0.05, release: 0.2,
      make(k) {
        const a = k.buffer(0.96);
        const pitches = [];
        for (let i = 0; i < 24; i++) pitches.push(3250 + 750 * k.random());
        const base = steps(0.04, pitches);
        k.tone(a, {
          freq: (t) => base(t) * (1.15 - 7 * (t % 0.04)),
          gain: (t) => Math.pow(Math.sin(Math.PI * 25 * t), 2),
        });
        return a;
      },
      params: (s) => ({ gain: s.near, rate: s.doppler, freq: 9000 }),
    },
  },
};
