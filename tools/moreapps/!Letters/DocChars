// DocChars - the text of a .doc's pieces (./DocPieces): the
// characters at CPs, decoded from the WordDocument stream ([MS-DOC]
// 2.9.73 FcCompressed). Used by ./DocRead; pure.
//
//   segments(pieces, word, from, to, {codepage?}) -> [{cp, text}]
//       the text of CPs from..to, piece by piece: text at CP cp
//       (where a piece was cut there is a gap). Unpaired
//       surrogates are U+FFFD. Compressed bytes map as [MS-DOC]
//       FcCompressed says (0x82 -> U+201A ... COMPRESSED), the
//       others through wimplib/RtfCodepage (1252: 0x80 the euro)
//   chunks(pieces, word, from, to, opts?)  a generator of the same
//       {cp, text}, at most opts.chunk (CHUNK_UNITS) units each, so
//       a reader can stop part way (./DocRead)
//   textOf(pieces, word, from, to, opts?) -> string  the segments'
//       text joined
//   pieceAt(pieces, cp) -> the index of the piece holding cp, or -1
//   pieceFrom(pieces, cp) -> the index of the piece holding cp, or
//       of the first one after it (pieces.length: none); a binary
//       search, as pieceAt (a CP in a gap costs no scan)
//   COMPRESSED, CHUNK_UNITS
import {decoderFor, known} from 'wimplib/RtfCodepage';

/** [MS-DOC] FcCompressed's table: byte -> UTF-16 unit. */
export const COMPRESSED = Object.freeze(new Map([[0x82, 0x201A],
  [0x83, 0x0192], [0x84, 0x201E], [0x85, 0x2026], [0x86, 0x2020],
  [0x87, 0x2021], [0x88, 0x02C6], [0x89, 0x2030], [0x8A, 0x0160],
  [0x8B, 0x2039], [0x8C, 0x0152], [0x91, 0x2018], [0x92, 0x2019],
  [0x93, 0x201C], [0x94, 0x201D], [0x95, 0x2022], [0x96, 0x2013],
  [0x97, 0x2014], [0x98, 0x02DC], [0x99, 0x2122], [0x9A, 0x0161],
  [0x9B, 0x203A], [0x9C, 0x0153], [0x9F, 0x0178]]));

const TABLES = new Map();

/** The 256 UTF-16 units of compressed text in code page cpg. */
function tableOf(cpg) {
  const key = known(cpg) ? cpg : 1252;
  let t = TABLES.get(key);
  if (t) return t;
  const dec = decoderFor(key);
  t = new Uint16Array(256);
  for (let b = 0; b < 256; b++) {
    t[b] = COMPRESSED.has(b) ? COMPRESSED.get(b)
      : dec(b).charCodeAt(0);
  }
  TABLES.set(key, t);
  return t;
}

/** See the header. */
export function pieceAt(pieces, cp) {
  let lo = 0, hi = pieces.length - 1;
  while (lo <= hi) {
    const mid = (lo + hi) >> 1, p = pieces[mid];
    if (cp < p.cpStart) hi = mid - 1;
    else if (cp >= p.cpEnd) lo = mid + 1;
    else return mid;
  }
  return -1;
}

/** See the header. */
export function pieceFrom(pieces, cp) {
  let lo = 0, hi = pieces.length;
  while (lo < hi) {
    const mid = (lo + hi) >> 1;
    if (pieces[mid].cpEnd <= cp) lo = mid + 1;
    else hi = mid;
  }
  return lo;
}

const CHUNK = 8192;
/** Units decoded at a time by chunks. */
export const CHUNK_UNITS = 65536;

/** The string of the UTF-16 units u (unpaired surrogates fixed). */
function stringOf(u) {
  for (let i = 0; i < u.length; i++) {
    const c = u[i];
    if (c < 0xD800 || c > 0xDFFF) continue;
    if (c <= 0xDBFF && i + 1 < u.length && u[i + 1] >= 0xDC00 &&
      u[i + 1] <= 0xDFFF) {
      i++;
      continue;
    }
    u[i] = 0xFFFD;
  }
  let s = '';
  for (let i = 0; i < u.length; i += CHUNK) {
    s += String.fromCharCode.apply(null, u.subarray(i, i + CHUNK));
  }
  return s;
}

/** The units of piece p from CP a to CP b (inside it). */
function unitsOf(p, word, a, b, opts) {
  const n = b - a, u = new Uint16Array(n);
  if (p.unicode) {
    const at = p.fc + 2 * (a - p.cpStart);
    for (let i = 0; i < n; i++) {
      u[i] = word[at + 2 * i] | (word[at + 2 * i + 1] << 8);
    }
  } else {
    const t = tableOf(opts.codepage || p.cp);
    const at = p.fc + (a - p.cpStart);
    for (let i = 0; i < n; i++) u[i] = t[word[at + i]];
  }
  return u;
}

/** See the header. */
export function* chunks(pieces, word, from, to, opts = {}) {
  const size = opts.chunk || CHUNK_UNITS;
  if (!(to > from)) return;
  let i = pieceFrom(pieces, from);
  for (; i < pieces.length && pieces[i].cpStart < to; i++) {
    const p = pieces[i];
    const b = Math.min(to, p.cpEnd);
    for (let a = Math.max(from, p.cpStart); a < b;) {
      let e = Math.min(b, a + size);
      const u = unitsOf(p, word, a, e, opts);
      // (a surrogate pair is not split between chunks)
      const last = u[u.length - 1];
      if (e < b && last >= 0xD800 && last <= 0xDBFF) {
        e++;
        yield {cp: a, text: stringOf(unitsOf(p, word, a, e, opts))};
      } else {
        yield {cp: a, text: stringOf(u)};
      }
      a = e;
    }
  }
}

/** See the header. */
export function segments(pieces, word, from, to, opts = {}) {
  const out = [];
  for (const c of chunks(pieces, word, from, to, opts)) {
    const last = out[out.length - 1];
    if (last && last.cp + last.text.length === c.cp) {
      last.text += c.text;
    } else {
      out.push(c);
    }
  }
  return out;
}

/** See the header. */
export function textOf(pieces, word, from, to, opts) {
  return segments(pieces, word, from, to, opts).map((s) => s.text)
    .join('');
}
