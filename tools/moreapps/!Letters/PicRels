// PicRels - a picture's bytes through a relationship list, and a
// document seen from a header or footer part (Batch D P0.3, P7.2).
//
//   bytesOf(doc, pic, from = doc.rels) -> Uint8Array | null
//       the bytes of the image part that relationship pic.embed
//       names (the rules of ./PicMedia mediaOf: an internal image
//       relationship, its part in doc.parts), or null. from: a
//       relationship list, its targets resolved against the main
//       part; or a Story (./StoryRead: a header or footer part has
//       its own relationships, their targets relative to ITS part:
//       partDoc). The very bytes object of the document: never
//       mutate it; it is what ./PicCache keys on.
//   partDoc(doc, story) -> doc as seen from story's part: rels the
//       story's own ([] when it has none), meta.mainPart its part
//       name, meta.documentRoot its root (the scope a raw picture
//       of it is read in: ./PicRead docMap); everything else doc's.
//       ./StoryLayout lays a story out on it, so ./PicPaint's
//       mediaOf(L.doc, embed) finds a header's pictures through the
//       header's relationships. Memoised per (doc, story) objects
//       and the doc's values (Ops change a Doc's fields in place:
//       new styles give a new view).
// Pure: no desktop services.
import {mediaOf} from './PicMedia';

const NONE = Object.freeze([]);
const views = new WeakMap();           // story -> {doc, view}

/** See the header. */
export function partDoc(doc, story) {
  const got = views.get(story), vals = Object.values(doc);
  if (got && got.doc === doc && got.vals.length === vals.length &&
    got.vals.every((v, i) => v === vals[i])) return got.view;
  const meta = {...(doc.meta || {}), mainPart: story.part};
  if (story.root) meta.documentRoot = story.root;
  const view = {...doc, rels: Array.isArray(story.rels) ? story.rels
    : NONE, meta};
  views.set(story, {doc, vals, view});
  return view;
}

/** See the header. */
export function bytesOf(doc, pic, from = doc && doc.rels) {
  if (!doc || !pic || typeof pic.embed !== 'string' || !from ||
    typeof from !== 'object') return null;
  let d = doc;
  if (Array.isArray(from)) {
    if (from !== doc.rels) d = {...doc, rels: from};
  } else if (typeof from.part === 'string') d = partDoc(doc, from);
  else return null;
  const m = mediaOf(d, pic.embed);
  return m ? m.bytes : null;
}
