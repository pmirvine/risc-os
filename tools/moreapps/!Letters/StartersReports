// StartersReports - the Reports group of starter templates: every
// placeholder in [square brackets]; British conventions; A4, margins
// 1440 (text width 9026). Built-in styles by name; colours only as
// theme references; no blank paragraphs (spacing does the spacing).
//
//   report()    cover (Title, Subtitle, author and date), then
//     "Contents" (TOC Heading, on a new page) and the editor's own
//     table of contents field: TOC \o "1-3" \h \z \u, the field in
//     a plain paragraph, which Edit > Update all fields (./TocUpdate)
//     rebuilds. The build cannot lay the document out, so the
//     cached result is the one line "Update the field to build the
//     contents (Edit > Update all fields)." Summary starts a new page;
//     Heading 1 sections Summary .. Recommendations, Findings with
//     two Heading 2; Appendix on a new page. Header: the report
//     title, right; footer: Page X of Y (PAGE, NUMPAGES), right;
//     the cover has neither (titlePg, no first-page parts).
//     Plain headings, not numbered.
//   essay()     Title centred; a running header "[Surname] " + PAGE,
//     right; author, course and date lines; four body paragraphs;
//     "References" (Heading 1, centred) and three references with a
//     hanging indent of 720. Double spacing is the Normal style's
//     (line 480 auto, after 0: the starter's stylePPr), so new
//     paragraphs follow it; body paragraphs have a first-line
//     indent of 720 each; the Title and headings keep their own.
//   proposal()  Title, Subtitle (organisation and date), Summary,
//     Background, Objectives (numbered), Approach, Timeline (table:
//     Phase, Activities, Start, End, five rows), Budget (table:
//     Item, Cost (GBP), bold shaded Total row), Risks (bullets),
//     Next steps (a second numbered list, restarting at 1); footer
//     Page X of Y.
import {para, run, field, table, list, header, footer,
  footerPageXofY, starterDoc} from './StarterKit';

const h1 = (t, o = {}) => para(t, {style: 'Heading1', ...o});
const h2 = (t) => para(t, {style: 'Heading2'});
const TOC = 'TOC \\o "1-3" \\h \\z \\u';
const FIELD_TEXT = 'Update the field to build the contents ' +
  '(Edit > Update all fields).';

/** See the header. */
export function report() {
  const section = (t, text, o) => [h1(t, o), para(text)];
  const sub = (t, text) => [h2(t), para(text)];
  return starterDoc({title: 'Report', body: [
    para('[Report title]', {style: 'Title',
      spacing: {before: 2400}}),
    para('[Subtitle or purpose]', {style: 'Subtitle'}),
    para('Prepared by: [Author]', {spacing: {before: 480, after: 60}}),
    para('Date: [5 November 2026]'),
    para('Contents', {style: 'TOCHeading', pageBreakBefore: true}),
    para(field(TOC, FIELD_TEXT)),
    ...section('Summary', '[Summarise the report in a short ' +
      'paragraph: the question, what you found and what you ' +
      'recommend.]', {pageBreakBefore: true}),
    ...section('Introduction', '[Say why the report was written, ' +
      'who it is for and what it covers.]'),
    h1('Findings'),
    ...sub('[First finding]', '[Describe what you found, with the ' +
      'evidence for it.]'),
    ...sub('[Second finding]', '[Describe what you found, with the ' +
      'evidence for it.]'),
    ...section('Conclusions', '[Say what the findings mean, in a ' +
      'few sentences.]'),
    ...section('Recommendations', '[List what should be done, by ' +
      'whom and by when.]'),
    ...section('Appendix', '[Add supporting material: tables, ' +
      'notes or sources.]', {pageBreakBefore: true}),
  ], header: [header('[Report title]', {align: 'right'})],
  footer: [footer(['Page ', field('PAGE', '1'), ' of ',
    field('NUMPAGES', '1')], {align: 'right'})], titlePg: true});
}

/** See the header. */
export function essay() {
  const line = (t) => para(t);
  const text = (t) => para(t, {ind: {firstLine: 720}});
  const ref = (t) => para(t, {ind: {left: 720, hanging: 720}});
  return starterDoc({title: 'Essay', stylePPr: {Normal: {spacing:
    {line: 480, lineRule: 'auto', after: 0}}}, body: [
    para('[Essay title]', {style: 'Title', align: 'center'}),
    line('[Your name]'), line('[Course and tutor]'),
    line('[5 November 2026]'),
    text('[Open with your argument: say what the essay is about, why ' +
      'it matters and the main point you will make. Keep it to a few ' +
      'sentences that lead the reader into the first section. Name ' +
      'the sources or cases you will draw on, and say in what order ' +
      'you will take the points so that the reader can follow the ' +
      'shape of the whole piece from the start. State clearly what ' +
      'you mean by any key term, because the rest of the essay ' +
      'depends on it.]'),
    text('[Make your first point. Give the evidence or an example, ' +
      'quote a source where it helps, and say how it supports your ' +
      'argument. Explain anything the reader might not know, and ' +
      'weigh the evidence fairly, including its limits. End by ' +
      'linking back to the question you were set so that the point ' +
      'is never left standing alone. If the evidence points two ' +
      'ways, say so and explain which way you find more ' +
      'convincing.]'),
    text('[Make your second point in the same way. Compare it with ' +
      'the first, note any view that differs from yours, and show ' +
      'why your reading is the stronger one. Use a short quotation ' +
      'or a figure if it makes the case clearer, and cite it in the ' +
      'form your tutor asks for. Keep each paragraph to one main ' +
      'idea, and begin it with a sentence that tells the reader what ' +
      'that idea is before you develop it.]'),
    text('[Close by drawing the points together. Restate your ' +
      'argument in fresh words and say what follows from it, without ' +
      'adding new evidence. Say what the essay has shown, what it ' +
      'has not tried to show, and where a reader who wanted to go ' +
      'further might look next. Finish on your strongest sentence.]'),
    h1('References', {align: 'center', keepNext: true}),
    ref('[Author, A. (Year) Title of book. Place: Publisher.]'),
    ref('[Author, B. (Year) Title of article. Journal, 1(2), 3-4.]'),
    ref('[Author, C. (Year) Title of page. Available at: address ' +
      '(Accessed: 5 November 2026).]'),
  ], header: [header(['[Surname] ', field('PAGE', '1')],
    {align: 'right'})]});
}

const BOLD = (t, o = {}) => para(run(t, {b: true}),
  {spacing: {after: 0}, ...o});
const TINT = {themeFill: 'accent1', themeFillTint: '33'};
const head = (cols) => cols.map((t) => ({content: [BOLD(t)],
  shade: TINT}));

/** See the header. */
export function proposal() {
  const sec = (t, text) => [h1(t), para(text)];
  const phase = (n) => [`[Phase ${n}]`, '[What happens]', '[Date]',
    '[Date]'];
  const money = (t) => ({content: [para(t, {align: 'right',
    spacing: {after: 0}})]});
  const total = (t, o) => ({content: [BOLD(t, o)], shade: TINT});
  return starterDoc({title: 'Project proposal', body: [
    para('[Project title]', {style: 'Title'}),
    para('[Organisation name] | [5 November 2026]',
      {style: 'Subtitle'}),
    ...sec('Summary', '[Summarise the project, what it will ' +
      'achieve and what you are asking for. Say who will benefit, ' +
      'how long it will take and what it will cost in total.]'),
    ...sec('Background', '[Explain the need or problem, and what ' +
      'has been done about it so far. Give the facts and figures ' +
      'that show why the work is needed now, and say who has ' +
      'asked for it or will gain from it.]'),
    h1('Objectives'),
    ...list(['[First objective, measurable]',
      '[Second objective, measurable]',
      '[Third objective, measurable]'], 'number'),
    ...sec('Approach', '[Describe how the work will be done, by ' +
      'whom and with what. Set out the stages in order, name the ' +
      'people or partners involved and say how you will check ' +
      'that the work is on track and that the results are ' +
      'good enough to use.]'),
    h1('Timeline'),
    table({cols: [1800, 4026, 1600, 1600], borders: 'grid',
      header: true, rows: [head(['Phase', 'Activities', 'Start',
        'End']), phase(1), phase(2), phase(3), phase(4), phase(5)]}),
    h1('Budget'),
    table({cols: [6226, 2800], borders: 'grid', header: true,
      rows: [head(['Item', 'Cost (GBP)']),
        ['[Item]', money('[0.00]')], ['[Item]', money('[0.00]')],
        ['[Item]', money('[0.00]')],
        [total('Total'), total('[0.00]', {align: 'right'})]]}),
    h1('Risks'),
    ...list(['[Risk and how you will reduce it]',
      '[Risk and how you will reduce it]',
      '[Risk and how you will reduce it]'], 'bullet'),
    h1('Next steps'),
    ...list(['[First step, with a date]', '[Second step, with a date]',
      '[Third step, with a date]'], 'number', {restart: 1}),
  ], footer: [footerPageXofY()]});
}
