// StylesBuiltinMore - Word's quick styles and the Word 2013+ look of
// Heading 1-6 and Title, for ./StylesBuiltin. Pure.
//
//   style(id, name, type, o?) -> a built-in style object (the helper
//       ./StylesBuiltin builds all its built-ins with)
//   moreIds  the ids moreStyle knows (below)
//   moreStyle(id) -> a new copy of quick style `id`, or null
//   headingLook(n) (n 1..6) / titleLook() -> Heading n / Title as
//       Word 2013-2022 makes them (./StylesBuiltin builtins)
//   QUICK  the gallery's quick styles in Word's order (by uiPriority:
//       No Spacing; Subtitle; the emphasis, quote and reference
//       styles; Book Title), for ./StylesBuiltin galleryIds
//
// The definitions are Word's for the Office 2013-2022 theme that new
// documents carry (./ThemeDefault; accent1 4472C4, text1 000000),
// taken from Word-made files of that theme in the corpus
// (stylesbuiltin-corpus.test.mjs compares them): theme fonts and
// colours are raw children in `extra` (w:rFonts asciiTheme...,
// w:color themeColor with themeTint / themeShade, the w:val the
// colour Word caches for this theme), as a file holds them, so they
// read back equal. Character styles are based on Default Paragraph
// Font. The linked character halves (Subtitle Char, Quote Char,
// Intense Quote Char, Body Text Char) are custom, as Word marks them,
// with the paragraph half's rPr. Heading 1-6: major font, accent1
// shade BF (Heading 3 and 6: shade 7F), 16 / 13 / 12 pt for 1-3,
// Heading 4 italic, keep with next and lines together, 12 pt before
// Heading 1 and 2 pt before the others, none after. Title: major
// font, 28 pt, character spacing -0.5 pt, kerning from 14 pt,
// single lines, no space after, contextual spacing. Subtitle sits at
// outline level 2 of a list (numPr ilvl 1 without a list: no
// number), as Word's does.
import {W} from './Wml';

/** See the header. */
export const style = (id, name, type, o = {}) => ({
  id, type, name, pPr: {extra: []}, rPr: {extra: []}, extra: [],
  raw: null, ...o,
});

const MAJOR = () => W('rFonts', [['w:asciiTheme', 'majorHAnsi'],
  ['w:eastAsiaTheme', 'majorEastAsia'], ['w:hAnsiTheme', 'majorHAnsi'],
  ['w:cstheme', 'majorBidi']]);
const color = (val, theme, k, v) => W('color', [['w:val', val],
  ['w:themeColor', theme], ...(k ? [['w:' + k, v]] : [])]);
// accent1, its shades BF and 7F; text1 tints BF and A5
const COLORS = {
  A1: ['4472C4', 'accent1'], A1BF: ['2F5496', 'accent1', 'themeShade',
    'BF'], A17F: ['1F3763', 'accent1', 'themeShade', '7F'],
  T1BF: ['404040', 'text1', 'themeTint', 'BF'],
  T1A5: ['5A5A5A', 'text1', 'themeTint', 'A5'],
};
const C = (k) => color(...COLORS[k]);
const on = (n) => W(n);
const sp = (n) => W('spacing', {'w:val': String(n)});
const rp = (o, ...extra) => ({...o, extra});
const pp = (o, ...extra) => ({...o, extra});

/** Heading n (1..6) as Word 2013-2022 makes it. */
export function headingLook(n) {
  const sz = [32, 26, 24][n - 1];
  const r = sz ? {sz, szCs: sz} : {};
  const it = n === 4 ? [on('iCs')] : [];
  if (n === 4) r.i = true;
  return style('Heading' + n, 'heading ' + n, 'paragraph', {
    basedOn: 'Normal', next: 'Normal', uiPriority: 9, qFormat: true,
    ...(n > 1 ? {unhideWhenUsed: true} : {}),
    pPr: pp({keepNext: true, keepLines: true, outlineLvl: n - 1,
      spacing: {before: n === 1 ? 240 : 40, after: 0}}),
    rPr: rp(r, MAJOR(), ...it, C(n === 3 || n === 6 ? 'A17F'
      : 'A1BF')),
  });
}

/** Title as Word 2013-2022 makes it. */
export function titleLook() {
  return style('Title', 'Title', 'paragraph', {
    basedOn: 'Normal', next: 'Normal', uiPriority: 10, qFormat: true,
    pPr: pp({spacing: {after: 0, line: 240, lineRule: 'auto'},
      contextualSpacing: true}),
    rPr: rp({sz: 56, szCs: 56}, MAJOR(), sp(-10),
      W('kern', {'w:val': '28'})),
  });
}

const para = (id, name, o) => style(id, name, 'paragraph', {
  basedOn: 'Normal', next: 'Normal', qFormat: true, ...o});
const char = (id, name, uiPriority, rPr) => style(id, name,
  'character', {basedOn: 'DefaultParagraphFont', uiPriority,
    qFormat: true, rPr});
// the custom character half of `of`, with its rPr
const half = (id, name, of) => style(id, name, 'character', {
  basedOn: 'DefaultParagraphFont', link: of.id,
  uiPriority: of.uiPriority, custom: true,
  rPr: structuredClone(of.rPr)});

const subR = () => rp({sz: 22, szCs: 22},
  W('rFonts', {'w:eastAsiaTheme': 'minorEastAsia'}), C('T1A5'),
  sp(15));
const QUOTE_IND = {left: 864, right: 864};
const border = (side) => W(side, [['w:val', 'single'], ['w:sz', '4'],
  ['w:space', '10'], ['w:color', '4472C4'], ['w:themeColor',
    'accent1']]);

const DEFS = {
  Subtitle: () => para('Subtitle', 'Subtitle', {link: 'SubtitleChar',
    uiPriority: 11, pPr: pp({numPr: {ilvl: 1}}), rPr: subR()}),
  Quote: () => para('Quote', 'Quote', {link: 'QuoteChar',
    uiPriority: 29, pPr: pp({jc: 'center', spacing: {before: 200},
      ind: {...QUOTE_IND}}), rPr: rp({i: true}, on('iCs'),
      C('T1BF'))}),
  IntenseQuote: () => para('IntenseQuote', 'Intense Quote', {
    link: 'IntenseQuoteChar', uiPriority: 30,
    pPr: pp({jc: 'center', spacing: {before: 360, after: 360},
      ind: {...QUOTE_IND}}, W('pBdr', null, border('top'),
      border('bottom'))),
    rPr: rp({i: true}, on('iCs'), C('A1'))}),
  Emphasis: () => char('Emphasis', 'Emphasis', 20,
    rp({i: true}, on('iCs'))),
  Strong: () => char('Strong', 'Strong', 22, rp({b: true}, on('bCs'))),
  SubtleEmphasis: () => char('SubtleEmphasis', 'Subtle Emphasis', 19,
    rp({i: true}, on('iCs'), C('T1BF'))),
  IntenseEmphasis: () => char('IntenseEmphasis', 'Intense Emphasis',
    21, rp({i: true}, on('iCs'), C('A1'))),
  SubtleReference: () => char('SubtleReference', 'Subtle Reference',
    31, rp({}, on('smallCaps'), C('T1A5'))),
  IntenseReference: () => char('IntenseReference',
    'Intense Reference', 32, rp({b: true}, on('bCs'), on('smallCaps'),
      C('A1'), sp(5))),
  BookTitle: () => char('BookTitle', 'Book Title', 33,
    rp({b: true, i: true}, on('bCs'), on('iCs'), sp(5))),
  NoSpacing: () => style('NoSpacing', 'No Spacing', 'paragraph', {
    uiPriority: 1, qFormat: true,
    pPr: pp({spacing: {after: 0, line: 240, lineRule: 'auto'}})}),
  BodyText: () => style('BodyText', 'Body Text', 'paragraph', {
    basedOn: 'Normal', link: 'BodyTextChar', uiPriority: 99,
    unhideWhenUsed: true, pPr: pp({spacing: {after: 120}})}),
};
const HALVES = {
  SubtitleChar: ['Subtitle Char', 'Subtitle'],
  QuoteChar: ['Quote Char', 'Quote'],
  IntenseQuoteChar: ['Intense Quote Char', 'IntenseQuote'],
  BodyTextChar: ['Body Text Char', 'BodyText'],
};
const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);

/** See the header. */
export const moreIds = Object.freeze([...Object.keys(DEFS),
  ...Object.keys(HALVES)]);

/** See the header. */
export const QUICK = Object.freeze(['NoSpacing', 'Subtitle',
  'SubtleEmphasis', 'Emphasis', 'IntenseEmphasis', 'Strong', 'Quote',
  'IntenseQuote', 'SubtleReference', 'IntenseReference',
  'BookTitle']);

/** See the header. */
export function moreStyle(id) {
  if (typeof id !== 'string') return null;
  if (own(DEFS, id)) return DEFS[id]();
  if (!own(HALVES, id)) return null;
  const [name, of] = HALVES[id];
  return half(id, name, DEFS[of]());
}
