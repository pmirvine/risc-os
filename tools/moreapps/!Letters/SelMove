// SelMove - moving the caret or the selection's head by one key's
// command, over a ./DocLayout. Used through ./Selection.
//
//   move(sel, L, cmd, extend, pageH) -> a new selection
//   make(anchor, head, affinity, goalX) -> a frozen selection
//   pageCmd(L, cmd) -> cmd, or pageDown / pageUp for nextPage /
//     prevPage where L.place has no pages (Draft): the one rule,
//     which ./EditKeys asks too
//
// Commands: left right (a grapheme of the paragraph's whole text;
// past an end, to the next item's start or the item before's end),
// up down (a line, keeping goalX, the work-area x the column was
// asked for; past a paragraph's first or last line into the item
// next to it in its column; past the first or last item, to the
// start or end of the document; in tables by the cells' geometry:
// ./SelTable vertical), home end (the line, ./PositionMap; in a
// cell, its line there), wordLeft wordRight (the start of a word,
// WimpLib/Segment; at a paragraph's edge, as left and right),
// paraStart paraEnd (this paragraph's start or end, or the next
// one's when already there), docHome docEnd, pageUp pageDown (pageH
// px up or down at goalX, default 400), nextPage prevPage (Ctrl+Page
// Down / Up: the next / previous page's first line in Print layout,
// ./SelPage toPage, D33; where L.place has no pages they are
// pageDown and pageUp). A kept block is atomic: its
// two positions are off 0 and 1 and left/right step over it; going
// into it by up/down gives the edge nearer goalX. Every item
// boundary is one step, like a paragraph mark: from the end of a
// paragraph, right gives the place before the box after it, then
// after the box, then the start of the paragraph after that. Left
// and right follow ./DocLayout's L.flow, cells too (C3.1, D8): right
// from the end of the paragraph before a table goes straight to its
// first cell's start, from the last cell's end to the paragraph
// after; a table's edge {table, 0 | 1} is a step only where no
// paragraph is beside it in its column (a table first in the
// document or in a cell, last in a cell, next to another table:
// ./SelVert step, reachable); right from {table, 0} goes into its
// first cell, left from {table, 1} into its last.
//
// Only up, down, pageUp and pageDown keep goalX; every other command
// clears it. With extend the anchor stays and the head moves;
// without it the selection collapses to the new place, and left or
// right on a selection collapse to its left or right edge instead of
// moving (up, down and the page keys move from the top or bottom
// edge; the other commands from the head). Spaces hidden after a
// line break are each one step: the caret does not move on the
// screen over them. Unseen inlines (bookmarks, proofing marks,
// field codes: ./Kinds unseenAt) cost no step: left and right go
// over them together with the character next to them (in
// 'a[bookmark]b', right from 0 gives 1, then 3; at a paragraph's
// edge, with its paragraph mark), so every press moves the caret on
// the screen. A field result shown computed (./FieldShow, D18: its
// layout item has `field` {b, e}) is one atomic range: no caret
// inside it; a move that would end inside it (or at its end, going
// forward) goes past it, to after its end fldChar (e + 1), going
// back to before its begin (b; its result's start when the begin is
// in another paragraph): one press steps over it. Unknown commands
// give sel back unchanged.
// Pure: no desktop services.
import * as PM from './PositionMap';
import {make, at, withAff, page, step} from './SelVert';
import {vertical} from './SelTable';
import {toPage} from './SelPage';
import {nextWord, prevWord} from 'wimplib/Segment';
import {itemEnd, nextG, prevG, compare} from './DocPos';
import {unseenAt} from './Kinds';

export {make};

const start = (it) => at(it, 0);
const end = (it) => at(it, itemEnd(it));

/** The next caret place in flow order, or stay at p. */
const forward = (L, it, p) => step(L, it, p.off, 1) || at(it, p.off);

/** The previous one, or stay at p. */
const backward = (L, it, p) => step(L, it, p.off, -1) ||
  at(it, p.off);

/** The start (end: d 1) of the item a step from p goes to, or of
 *  it. */
function para(L, it, p, d) {
  const r = step(L, it, p.off, d);
  const n = r ? L.byId.get(r.pos.id) : it;
  return d > 0 ? end(n) : start(n);
}

/** p.off past the unseen inlines after it (dir 1) or before it. */
function skip(it, off, dir) {
  if (it.kind !== 'p') return off;
  const b = it.block, n = b.text.length;
  if (dir > 0) while (off < n && unseenAt(b, off)) off++;
  else while (off > 0 && unseenAt(b, off - 1)) off--;
  return off;
}

function right(L, it, p) {
  const off = skip(it, p.off, 1);
  if (off < itemEnd(it) && it.kind !== 'tbl') {
    return at(it, it.kind !== 'p' ? 1 : nextG(it.block.text, off));
  }
  return forward(L, it, p);
}

function left(L, it, p) {
  const off = skip(it, p.off, -1);
  if (off > 0 && it.kind !== 'tbl') {
    return at(it, it.kind !== 'p' ? 0 : prevG(it.block.text, off));
  }
  return backward(L, it, p);
}

const CMDS = {
  left, right,
  home: (L, it, p, aff) => (it.kind !== 'p' ? at(it, 0)
    : withAff(it, PM.lineStart(it, p.off, aff))),
  end: (L, it, p, aff) => (it.kind !== 'p' ? at(it, 1)
    : withAff(it, PM.lineEnd(it, p.off, aff))),
  wordRight: (L, it, p) => (it.kind === 'p' && p.off < itemEnd(it)
    ? at(it, nextWord(it.block.text, p.off)) : right(L, it, p)),
  wordLeft: (L, it, p) => (it.kind === 'p' && p.off > 0
    ? at(it, prevWord(it.block.text, p.off)) : left(L, it, p)),
  paraStart: (L, it, p) => (p.off > 0 ? start(it)
    : para(L, it, p, -1)),
  paraEnd: (L, it, p) => (p.off < itemEnd(it) ? end(it)
    : para(L, it, p, 1)),
  docHome: (L) => ({pos: L.docStart(), affinity: 'down'}),
  docEnd: (L) => ({pos: L.docEnd(), affinity: 'down'}),
  up: (L, it, p, aff, gx) => vertical(L, it, p, aff, gx, -1),
  down: (L, it, p, aff, gx) => vertical(L, it, p, aff, gx, 1),
  pageUp: (L, it, p, aff, gx, h) => page(L, p, aff, gx, -1, h),
  pageDown: (L, it, p, aff, gx, h) => page(L, p, aff, gx, 1, h),
  nextPage: (L, it, p, aff) => toPage(L, it, p, aff, 1),
  prevPage: (L, it, p, aff) => toPage(L, it, p, aff, -1),
};
// (where there are no pages: Page Down and Page Up)
const NOPAGES = new Map([['nextPage', 'pageDown'],
  ['prevPage', 'pageUp']]);

/** See the header. */
export const pageCmd = (L, cmd) => (NOPAGES.has(cmd) &&
  !(L && L.place && L.place.pages) ? NOPAGES.get(cmd) : cmd);
const KEEP = new Set(['up', 'down', 'pageUp', 'pageDown']);
const EDGE = new Set(['left', 'right', ...KEEP, 'nextPage',
  'prevPage']);

/** pos moved past the computed field result it is in (from p:
 *  the direction; see the header). */
function pastField(L, pos, p) {
  const it = L.byId.get(pos.id), off = pos.off;
  if (!it || it.kind !== 'p' || !it.lines) return pos;
  const fwd = compare(L, pos, p) > 0;
  for (const ln of it.lines) {
    if (off < ln.from || off > ln.to) continue;
    for (const x of ln.items) {
      if (!x.field || !(fwd ? x.from < off && off <= x.to
        : x.from <= off && off < x.to)) continue;
      const b = x.field.b ?? x.from;
      return {id: pos.id, off: fwd ? x.field.e + 1 : b};
    }
  }
  return pos;
}

/** See the header. */
export function move(sel, L, cmd, extend = false, pageH) {
  cmd = pageCmd(L, cmd);
  const fn = Object.hasOwn(CMDS, cmd) ? CMDS[cmd] : null;
  if (!fn || !sel) return sel;
  const ha = L.locate(sel.head), an = L.locate(sel.anchor);
  if (!ha || !an) return sel;
  const back = compare(L, sel.anchor, sel.head) > 0;
  const same = ha.index === an.index && ha.off === an.off;
  let it = ha.item, off = ha.off, aff = sel.affinity;
  if (!extend && !same && EDGE.has(cmd)) {
    // left/right: to that edge; up/down: from it
    const first = cmd === 'left' || cmd === 'up' ||
      cmd === 'pageUp' || cmd === 'prevPage';
    const edge = first === back ? ha : an;
    if (edge !== ha) aff = 'down';
    if (cmd === 'left' || cmd === 'right') {
      const p = {id: edge.item.id, off: edge.off};
      return make(p, p, aff);
    }
    it = edge.item;
    off = edge.off;
  }
  const p = {id: it.id, off};
  const keep = KEEP.has(cmd);
  const gx = keep ? sel.goalX ?? L.caretRect(p, aff).x : null;
  const r = fn(L, it, p, aff, gx, pageH);
  if (!r || !r.pos) return sel;
  const goal = keep ? gx : null, to = pastField(L, r.pos, p);
  return extend ? make(sel.anchor, to, r.affinity, goal)
    : make(to, to, r.affinity, goal);
}
