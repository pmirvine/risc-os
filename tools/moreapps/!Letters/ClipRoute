// ClipRoute - where a paste goes (EditClip.pasteIn's second half):
// ./ClipPick chooses the route for the payload, then
//
//   routePaste(dw, p, lost) -> true, or undefined (nothing to paste)
//     dw: the document window (./AppWin); p: {text, html, files};
//     lost: whether the browser's paste event held more text than
//     the Wimp passed on (./EditClip)
//   say(message)    the message box every clip message uses
//
// exact and html: the blocks (./ClipPaste pasteBlocks; HTML tables
// read at the text width where the caret is, ./TblInsert widthAt);
// plain: the text (pastePlain); picture: put in as a picture
// (./PicLoad); files: a beep and a message. See ./EditClip for the
// rules. Footnote and endnote marks the paste could not put in
// (./ClipNotes: report.marks): a beep; with a message when the
// document's notes were kept as bytes (MARKS) or no id was left.
// A note pasted from another document that lost a picture or a link
// (report.lost): a beep and LOST, once a paste.
//   MARKS      {unknown, free} those messages
//   LOST       that message
import {wimp, reportError} from 'riscos';
import {store} from './ClipStore';
import {pick} from './ClipPick';
import {parserOf} from './ClipDom';
import {pasteBlocks, pastePlain} from './ClipPaste';
import {dropPending} from './EditFormat';
import {putPicture, MSG} from './PicLoad';
import {widthAt} from './TblInsert';

const parseHtml = parserOf(globalThis.DOMParser);
const FILES = 'Only PNG, JPEG and GIF pictures can be pasted: other ' +
  'files cannot.';
const CUT = 'Only the first 100,000 characters were pasted: the ' +
  'clipboard held more.';
export const say = (m) => reportError(m, {appName: 'Letters'});
export const MARKS = Object.freeze({
  unknown: 'The footnotes or endnotes of this document could not ' +
    'be read: the text was pasted without its note marks.',
  free: 'There is no free note number left: some note marks were ' +
    'not pasted.'});
export const LOST = 'A picture or link in a pasted footnote or ' +
  'endnote was left out (a link keeps its text): a note\'s pictures ' +
  'and links are not carried to another document.';

/** See the header. */
export function routePaste(dw, p, lost) {
  const v = dw.view, st = dw.clip;
  const textTw = v.sel ? widthAt(v.d.doc, v.L, v.sel.head) : undefined;
  const r = pick(p, {store, docKey: dw.docKey, parseHtml, textTw});
  if (!r) {
    const files = !!(p && p.files && p.files.length);
    st.last = files ? 'files' : 'none';
    if (files) {
      st.status = FILES;
      wimp.beep();
      say(FILES);
    }
    return files || undefined;
  }
  st.last = r.route;
  if (!v.sel) {
    wimp.beep();
    return true;
  }
  if (r.route === 'picture') {
    dropPending(v);
    if (r.tooBig) {
      wimp.beep();
      say(MSG.tooBig);
      return true;
    }
    putPicture(dw, () => r.file.arrayBuffer()
      .then((b) => new Uint8Array(b)));
    return true;
  }
  v.ensure();
  dropPending(v);
  const sel = v.sel, d = v.d, report = {};
  const run = (x) => v.typing.command(() => (x.route === 'plain'
    ? pastePlain(d, sel, x.text)
    : pasteBlocks(d, sel, x.blocks, {...x.opts, report})));
  let out = sel;
  try {
    out = run(r);
  } catch (e) {
    // content the model refuses: the text instead; a bug is thrown
    if (!(e instanceof RangeError)) throw e;
    if (r.route !== 'plain' && p.text) {
      st.last = 'plain';
      out = run({route: 'plain', text: p.text});
    } else if (/^(ids|name)$/.test(e.message)) say(MSG.pasteFree);
  }
  if (out === sel) wimp.beep();
  else v.edited(out);
  if (out !== sel && report.marks && st.last !== 'plain') {
    // (marks not pasted: in a note, a header, notes kept as bytes)
    wimp.beep();
    if (MARKS[report.marks]) say(MARKS[report.marks]);
  }
  if (out !== sel && report.lost && st.last !== 'plain') {
    wimp.beep();
    say(LOST);
  }
  // the Wimp cuts a paste's text at MAX_TEXT: say so when it did
  if (st.last === 'plain' && out !== sel && lost) {
    st.status = CUT;
    wimp.beep();
    say(CUT);
  }
  return true;
}
