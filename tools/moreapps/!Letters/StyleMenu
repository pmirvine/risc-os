// StyleMenu - the styles menu of the toolbar's popup and of Format >
// Style (Batch E1).
//
//   styleMenu(view, {more}?) -> a Menu
//   updateItem(view) -> the item Update <style> to match selection
//       (here and in the Format menu: ./FormatMenu)
//
// One item for each style of the gallery (./StyleList gallery: the
// quick styles, paragraph, character and linked, by priority then
// name; hidden ones are not offered), then More styles... when
// more() is given, which opens the Styles window; without it the
// item is shaded. A choice runs view.format('style', id)
// (./FormatSet applyStyle: a paragraph style on the paragraphs, a
// character style on the selected text, a linked one by what is
// selected), so is one undo step. Then Update <style> to match
// selection, as Word's style menu has it: view.format('styleUpdate')
// (./StyleUpdate: the caret paragraph's style takes its direct
// formatting), named with the caret paragraph's style (cut at 40
// characters with '...'); shaded with no selection and when
// ./StyleUpdate updateTarget gives a reason (no paragraph style to
// change, or the caret outside the body's text: a header, a note).
// The style in force is ticked: the character style when the
// selection is wholly in one, else the caret paragraph's
// (view.query() style and charStyle). The menu
// does not preview a style in its own font (the desktop's menus draw
// every item alike); ./StyleList gives the previews for the window.
// view is the window's ./EditView. The style table is only read.
import {Menu} from 'riscos';
import {gallery} from './StyleList';
import {updateTarget} from './StyleUpdate';
import {display} from './StyleName';

/** The id of the style the toolbar shows for query q (or ''). */
export function shownStyle(q) {
  return (q && (q.charStyle || q.style)) || '';
}

const cut = (n) => (n.length > 40 ? n.slice(0, 40) + '...' : n);

/** See the header. */
export function updateItem(v) {
  const t = () => (v.sel ? updateTarget(v.d.doc, v.sel) : {});
  return {text: () => {
    const s = t().style;
    return 'Update ' + (s ? cut(display(s)) : 'style') +
      ' to match selection';
  }, shaded: () => !v.sel || !t().style,
  action: () => v.format('styleUpdate'),
  help: 'Make the paragraph\'s style look like the paragraph: its ' +
    'paragraph formatting and that of its first character.'};
}

/** See the header. */
export function styleMenu(v, {more} = {}) {
  const items = gallery(v.d.doc).map((e) => ({text: e.name,
    ticked: () => !!v.sel && shownStyle(v.query()) === e.id,
    shaded: () => !v.sel,
    action: () => v.format('style', e.id)}));
  if (items.length) items[items.length - 1].dotted = true;
  items.push(updateItem(v));
  items.push({text: 'More styles...', shaded: () => !more,
    action: () => { if (more) more(); },
    help: 'All the document\'s styles, to apply, make, change or ' +
      'remove, in a window.'});
  return new Menu('Style', items);
}
