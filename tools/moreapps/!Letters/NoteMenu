// NoteMenu - the menu items of footnotes and endnotes (Batch E2).
// Desktop-bound (Menu): it imports the desktop in its import line
// only.
//
//   noteItems(dw) -> [item]  for Insert (./InsertMenu), after
//       Bookmark...:
//     Footnote   Ctrl+Alt+F  a footnote at the caret, then the notes
//                            mode in it (./NoteMode insert)
//     Endnote    Ctrl+Alt+D  the same for an endnote
//     Footnote and Endnote...  the box of where notes go and how they
//                            are numbered (./NoteBox); shaded with
//                            no selection and in the header and
//                            footer mode (where nothing in it
//                            works; in the notes mode its Custom
//                            mark and Convert... do)
//     each shaded where it would be refused (./NoteMode refusal: in a
//     header, footer or note, by a table or box, in a field, a kind
//     kept as bytes, no caret)
//   noteMenu(dw) -> a Menu titled Footnote (Endnote), the window
//       menu's item while the window is in the notes mode (./WinMenu,
//       as Header in the header and footer mode):
//     Next note      Alt+Down   the note of the next mark
//     Previous note  Alt+Up     the note of the mark before
//                               (./NoteMode step; each shaded at the
//                               last / first note)
//     Go to mark     Escape     back to the body, the caret after
//                               the note's mark (./NoteMode leave)
import {Menu} from 'riscos';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';
import {insert, step, leave, refusal} from './NoteMode';
import {isNote} from './NoteEdit';
import {stepFrom} from './NotePick';
import {noteBox} from './NoteBox';

/** See the header. */
export function noteItems(dw) {
  const v = dw.view, k = (id) => macLabel(keymap.labelFor(id), v.mac);
  return [
    {text: 'Footnote', key: k('footnote') || undefined,
      shaded: () => refusal(dw, 'footnote') !== null,
      action: () => { insert(dw, 'footnote'); },
      help: 'Put a footnote mark at the caret (after the selected ' +
        'text) and type the note at the foot of the page; Escape ' +
        'goes back to the text.'},
    {text: 'Endnote', key: k('endnote') || undefined,
      shaded: () => refusal(dw, 'endnote') !== null,
      action: () => { insert(dw, 'endnote'); },
      help: 'Put an endnote mark at the caret (after the selected ' +
        'text) and type the note at the end of the document; ' +
        'Escape goes back to the text.'},
    {text: 'Footnote and Endnote...', shaded: () => !v.sel ||
      (!!v.hdr && !isNote(v.hdr)),
      action: () => { noteBox(dw); }, dotted: true,
      help: 'Choose where the notes go and how they are numbered, ' +
        'and put a note in.'},
  ];
}

/** See the header. */
export function noteMenu(dw) {
  const v = dw.view, m = () => (isNote(v.hdr) ? v.hdr : null);
  const k = (id) => macLabel(keymap.labelFor(id), v.mac);
  const none = (d) => !m() || !stepFrom(v.real.doc, m().note, d);
  const word = m() && m().note.kind === 'endnote' ? 'Endnote'
    : 'Footnote';
  return new Menu(word, [
    {text: 'Next note', key: k('nextNote') || undefined,
      shaded: () => none(1), action: () => { step(dw, 1); },
      help: 'Edit the note of the next mark in the text.'},
    {text: 'Previous note', key: k('prevNote') || undefined,
      shaded: () => none(-1), action: () => { step(dw, -1); },
      help: 'Edit the note of the mark before this one.',
      dotted: true},
    {text: 'Go to mark', key: 'Escape', shaded: () => !m(),
      action: () => { leave(dw); },
      help: 'Go back to the text, the caret after this note\'s mark.'},
  ]);
}
