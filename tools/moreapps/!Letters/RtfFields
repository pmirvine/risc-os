// RtfFields - fields, hyperlinks and bookmarks for the RTF reader
// (./RtfRead), as the Model holds them after reading a .docx.
//
//   PART   handlers: {\field \fldlock \flddirty {\*\fldinst code}
//       {\fldrslt result}} and {\*\bkmkstart name} / {\*\bkmkend
//       name}
//
// A field is a complex field: begin, ONE instrText of the code
// (./FieldMake fieldInlines: trimmed, a space each side), separate,
// the result as ordinary text and inlines (it may run over several
// paragraphs: a TOC), end; \fldlock gives the begin w:fldLock,
// \flddirty w:dirty. RTF is untrusted input: only the field names
// in SAFE (PAGE, NUMPAGES, DATE, REF, TOC, SEQ, IF, '='...; none
// that reads files, programs or data sources: no DDE, INCLUDETEXT,
// LINK, DATABASE, MERGEFIELD, MACROBUTTON...) stay fields; any other
// keeps only its result, as text, with a note. The name is the
// leading run of ASCII letters (or '=') after any white space,
// upper-cased; it must be followed by white space or the end ('='
// by anything) and be the name ./FieldParse reads too (not '' or
// 'UNKNOWN'), else the code fails closed: result text and a note.
// A code ./FieldMake codeText refuses (empty, too long, a control
// character) leaves the result as plain text (a note unless empty).
// No result: an empty one. A field named HYPERLINK is a
// w:hyperlink instead (level 'p' raw inline, its runs the result's:
// ./LinkParts runNodes, linkX): "url" an External relationship
// (./LinkParts withTarget: in doc.rels, or in a header's or
// footer's own rels when ctx.relsAt (./RtfSect) is set), \l "name"
// w:anchor, \o "tip" w:tooltip; an address or name ./LinkParts
// refuses leaves the result as text, with a note; a paragraph end
// in the result ends the link and starts another to the same place;
// a link in the result gives only its text.
// A field in a field's code gives its result to the code text.
// Bookmarks are level 'p' raw inlines w:bookmarkStart w:id w:name /
// w:bookmarkEnd w:id, ids 0, 1... in the order the starts come; a
// name is trimmed and must pass ./LinkUrl checkAnchor (the rule a
// link's \l name passes; else skipped, with a note); an empty name,
// a name started twice, or an end with no start is skipped. At most
// MAX_MARKS bookmarks.
// Shared with the writer (./RtfWriteFields), so the two keep one
// rule: SAFE, nameOf(code) (the name, or null), linkTarget(parsed)
// and MAX_CODE.
// Pure: no desktop services.
import {el} from 'wimplib/Xml';
import {codeText, fieldInlines} from './FieldMake';
import {parse} from './FieldParse';
import {target, withTarget, withTip, runNodes, linkX, TIP_MAX}
  from './LinkParts';
import {checkAnchor} from './LinkUrl';
import {docScope} from './WriteBody';
import {Para, fmtOf} from './RtfBody';

export const MAX_CODE = 32 * 1024;
const MAX_MARKS = 100000;

const give = (dest, ctx, x) => {
  if (dest.obj) dest.obj(ctx, x);
};

/** The w:hyperlink target of parsed code p: {url?, anchor?, tip?}
 *  or null (refused). */
export function linkTarget(p) {
  const sw = (s) => {
    const x = p.switches.find((o) => o.sw.toLowerCase() === s);
    return x && typeof x.arg === 'string' ? x.arg : undefined;
  };
  const out = {};
  if (p.args.length) {
    const t = target({address: p.args[0]});
    if (!t || t.error) return null;
    out.url = t.url;
  }
  const a = sw('\\l');
  if (a !== undefined) {
    const t = target({anchor: a});
    if (!t || t.error) return null;
    out.anchor = t.anchor;
  }
  const tip = sw('\\o');
  if (tip !== undefined && tip.length <= TIP_MAX) out.tip = tip;
  return out.url || out.anchor ? out : null;
}

/** The w:hyperlink inline for content c ({text, runs, inlines}). */
function linkInline(ctx, f, c) {
  const doc = ctx.doc, map = docScope(doc).map;
  const holder = ctx.relsAt || doc;
  let attrs = [['w:history', '1']];
  if (f.target.url) {
    const ops = [];
    attrs = withTarget(attrs, {url: f.target.url}, {rels: holder.rels,
      meta: doc.meta}, map, ops);
    holder.rels = ops[0].value;
  }
  if (f.target.anchor) attrs.push(['w:anchor', f.target.anchor]);
  if (f.target.tip) attrs = withTip(attrs, f.target.tip);
  const node = el('w:hyperlink', attrs, ...runNodes(c, null, map));
  return linkX(node, map);
}

/** The field names kept as fields: none reads anything outside
 *  the document. */
export const SAFE = new Set(['PAGE', 'NUMPAGES', 'SECTIONPAGES',
  'SECTION', 'DATE', 'TIME', 'CREATEDATE', 'SAVEDATE', 'PRINTDATE',
  'EDITTIME',
  'AUTHOR', 'TITLE', 'SUBJECT', 'FILENAME', 'NUMWORDS', 'NUMCHARS',
  'REF', 'PAGEREF', 'NOTEREF', 'SEQ', 'TOC', 'TOA', 'TC', 'XE',
  'INDEX', 'STYLEREF', 'HYPERLINK', '=', 'IF', 'COMPARE', 'SYMBOL',
  'QUOTE', 'LISTNUM']);
const WS = ' \t\r\n\f\v';
const isLetter = (c) => (c >= 'A' && c <= 'Z') ||
  (c >= 'a' && c <= 'z');

/** The field's name (see the header), or null: fail closed. */
export function nameOf(raw) {
  let i = 0;
  while (i < raw.length && WS.includes(raw[i])) i++;
  if (raw[i] === '=') return '=';
  let j = i;
  while (j < raw.length && isLetter(raw[j])) j++;
  if (j === i || (j < raw.length && !WS.includes(raw[j]))) return null;
  return raw.slice(i, j).toUpperCase();
}

/** Decide what the field is, once; a complex one starts here. */
function start(ctx, f) {
  if (f.mode) return;
  f.mode = 'text';
  const raw = f.instr || '';
  const code = raw.length <= MAX_CODE ? codeText(raw) : null;
  if (!code) {
    if (raw.trim()) {
      ctx.note('a field whose code cannot be kept: its result is ' +
        'kept as text');
    }
    return;
  }
  const p = parse(raw), name = nameOf(raw);
  if (!name || name !== p.name || !SAFE.has(name)) {
    ctx.note('fields of a kind !Letters does not keep: their ' +
      'results are kept as text');
    return;
  }
  if (name === 'HYPERLINK') {
    f.target = linkTarget(p);
    if (f.target) f.mode = 'link';
    else ctx.note('a link to an address that is not allowed: its ' +
      'text is kept');
    return;
  }
  f.mode = 'complex';
  const ins = fieldInlines(code).inlines;
  const begin = ins[0];
  const attrs = begin.node.attrs.slice();
  if (f.lock) attrs.push(['w:fldLock', '1']);
  if (f.dirty) attrs.push(['w:dirty', '1']);
  give(f.outer, ctx, {...begin, node: {...begin.node, attrs}});
  give(f.outer, ctx, ins[1]);
  give(f.outer, ctx, ins[2]);
  f.end = ins[3];
}

/** {\*\fldinst ...}: the code, nested groups' text too. */
const instr = (f) => () => {
  f.instr = f.instr || '';
  return {text(ctx, s) {
    if (f.instr.length <= MAX_CODE) f.instr += s;
  }};
};

/** {\fldrslt ...} of a complex field or text: to the outer flow. */
function forward(o) {
  return {
    text: (ctx, s) => o.text && o.text(ctx, s),
    obj: (ctx, x) => give(o, ctx, x),
    par: (ctx) => o.par && o.par(ctx),
  };
}

/** {\fldrslt ...} of a link: gathered, given as w:hyperlink. */
function linkResult(f) {
  let piece = new Para();
  const flush = (ctx) => {
    if (piece.len) {
      give(f.outer, ctx, linkInline(ctx, f, piece.content()));
    }
    piece = new Para();
  };
  return {
    text: (ctx, s) => piece.add(s, fmtOf(ctx)),
    // (a link in a link, which Word refuses: its text only)
    obj: (ctx, x) => (x.node && x.node.name === 'w:hyperlink'
      ? x.text && piece.add(x.text, fmtOf(ctx)) : piece.obj(ctx, x)),
    par(ctx) {
      flush(ctx);
      if (f.outer.par) f.outer.par(ctx);
    },
    end: flush,
  };
}

function result(ctx, f) {
  if (f.result) return undefined;
  f.result = true;
  start(ctx, f);
  return f.mode === 'link' ? linkResult(f) : forward(f.outer);
}

function field(ctx) {
  const f = {outer: ctx.dest, instr: null, mode: null};
  const flag = (k) => () => {
    f[k] = true;
  };
  return {text() {},
    words: new Map([['fldlock', flag('lock')],
      ['flddirty', flag('dirty')]]),
    dests: new Map([['fldinst', instr(f)],
      ['fldrslt', (c) => result(c, f)]]),
    end(c) {
      start(c, f);
      if (f.end) give(f.outer, c, f.end);
    }};
}

/** The bookmarks read so far. */
const marks = (ctx) => ctx.bookmarks || (ctx.bookmarks = {next: 0,
  open: new Map(), seen: new Set()});

function bookmark(isStart) {
  return (ctx) => {
    const outer = ctx.dest;
    let name = '';
    return {text(c, s) {
      if (name.length <= 256) name += s;
    },
    end(c) {
      const n = name.trim(), b = marks(c);
      if (!n) return;
      if (checkAnchor(n)) {
        c.note('a bookmark whose name cannot be kept is skipped');
        return;
      }
      if (isStart) {
        if (b.seen.has(n) || b.next >= MAX_MARKS) return;
        const id = String(b.next++);
        b.seen.add(n);
        b.open.set(n, id);
        give(outer, c, {kind: 'raw', level: 'p', text: '',
          node: el('w:bookmarkStart', [['w:id', id], ['w:name', n]])});
      } else if (b.open.has(n)) {
        const id = b.open.get(n);
        b.open.delete(n);
        give(outer, c, {kind: 'raw', level: 'p', text: '',
          node: el('w:bookmarkEnd', [['w:id', id]])});
      }
    }};
  };
}

export const PART = {
  dests: new Map([['field', field], ['bkmkstart', bookmark(true)],
    ['bkmkend', bookmark(false)]]),
};
