// OdtLists - the lists of an OpenDocument text (OpenDocument 1.3
// part 3, 5.3 <text:list>, <text:list-item>, <text:list-header>,
// 14 list styles) for ./OdtRead, through the builder's lists
// (./ImpBuild list, listOverride; the levels: ./OdtLevels).
//
//   PART  {elements: text:list}  (./OdtRead's registry)
//   numFor(ctx, node, def) -> {numId, ilvl} | null  the pPr.numPr
//       of the text:p / text:h node (ctx.styles def its paragraph
//       style): the item of the list it is in, else the list its
//       paragraph style names (style:list-style-name; '' none), else
//       for a text:h the outline numbering (text:outline-style, when
//       it numbers). A text:list-header has none
//   isolate(ctx, fn)  runs fn with no list open (a table cell's
//       content is not in the list the table is in)
//   ctx.lst  {stack, made, ids, outline}: the open lists (frames
//       {numId, ilvl, style, m, header}), the numbering made for each
//       list style, text:list xml:id -> numId
//
// A list style is one list (b.list) the first time it is used; a
// later text:list of that style that does not continue numbering is
// a restart (b.listOverride with every level's start value); text:
// continue-numbering and text:continue-list carry on the last numId
// of the style / of that list; a text:start-value on an item is an
// override from there on. A text:list with no style, or that of the
// list around it, goes on with that list's numId (the levels restart
// by themselves). Depth is the level, at most 9 (the Model's; deeper
// ones are the 9th, a note).
// Pure: no desktop services.
import {levelsOf, numbered} from './OdtLevels';
import {levelOf} from './OdtProps';
import {num} from './OdtUnits';
import {attr} from './OdtXml';

const MAX_IDS = 10000, MAX_LEVEL = 8;
const DEEP = 'lists nested more than 9 deep: the deeper ones are ' +
  'numbered at level 9';
const OUTLINE = '\u0000outline';

const state = (ctx) => ctx.lst || (ctx.lst = {stack: [],
  made: new Map(), ids: new Map(), outline: undefined});

/** The numbering made for list style `name` (made on first use). */
function made(ctx, name, node, missing) {
  const L = state(ctx), key = ctx.where + '\n' + name;
  let m = L.made.get(key);
  if (m) return m;
  if (missing && name) ctx.note('a list style that is not in the ' +
    'file is read as bullets');
  const levels = levelsOf(ctx, node);
  m = {levels, base: ctx.b.list(levels), used: false,
    numbered: numbered(levels)};
  m.cur = m.base;
  L.made.set(key, m);
  return m;
}

const styleMade = (ctx, name) => {
  const node = name === OUTLINE ? ctx.styles.other.outline
    : ctx.styles.other.list(name);
  return made(ctx, name, node, !node && name !== OUTLINE);
};

/** The numId of a list of m that starts (or continues). */
function pick(ctx, m, cont) {
  if (!m.used || cont) {
    m.used = true;
    return m.cur;
  }
  if (m.base === null) return null;
  const starts = {};
  m.levels.forEach((l, k) => { starts[k] = l.start; });
  const id = ctx.b.listOverride(m.base, starts);
  m.cur = id ?? m.cur;
  return m.cur;
}

function list(ctx, node) {
  const L = state(ctx), depth = L.stack.length;
  if (depth >= MAX_LEVEL + 1) ctx.note(DEEP);
  const parent = L.stack[depth - 1];
  const name = attr(node, 'text:style-name');
  const cl = attr(node, 'text:continue-list');
  const cont = attr(node, 'text:continue-numbering') === 'true' ||
    cl !== undefined;
  let numId, m;
  if (parent && (!name || name === parent.style) && !cont) {
    ({numId, m} = parent);
  } else {
    m = styleMade(ctx, name || (parent ? parent.style : '') || '');
    numId = cl !== undefined && L.ids.has(cl) ? L.ids.get(cl)
      : pick(ctx, m, cont);
  }
  const xid = attr(node, 'xml:id');
  if (xid && L.ids.size < MAX_IDS) L.ids.set(xid, numId);
  const f = {numId, m, ilvl: Math.min(depth, MAX_LEVEL),
    style: name || (parent ? parent.style : ''), header: false};
  L.stack.push(f);
  try {
    for (const c of node.children) {
      if (ctx.stop) return;
      if (typeof c !== 'string') item(ctx, f, c);
    }
  } finally {
    L.stack.pop();
  }
}

function item(ctx, f, c) {
  const header = c.name === 'text:list-header';
  if (!header && c.name !== 'text:list-item') return;
  const v = num(attr(c, 'text:start-value'));
  if (!header && f.numId && v !== undefined && v >= 0 && v <= 32767) {
    const id = ctx.b.listOverride(f.numId, {[f.ilvl]: Math.round(v)});
    if (id) {
      f.numId = id;
      f.m.cur = id;
    }
  }
  f.header = header;
  try {
    ctx.walk(c);
  } finally {
    f.header = false;
  }
}

/** Whether text:outline-style numbers the headings. */
function outlined(ctx) {
  const L = state(ctx);
  if (L.outline === undefined) {
    L.outline = !!ctx.styles.other.outline &&
      styleMade(ctx, OUTLINE).numbered;
  }
  return L.outline;
}

/** See the header. */
export function numFor(ctx, node, def) {
  const L = state(ctx), f = L.stack[L.stack.length - 1];
  if (f) return f.header || !f.numId ? null
    : {numId: f.numId, ilvl: f.ilvl};
  const own = def && ctx.styles.line(def).find((d) =>
    d.listStyle !== undefined);
  const heading = node.name === 'text:h';
  const name = own ? own.listStyle : heading && outlined(ctx) ? OUTLINE
    : '';
  if (!name) return null;
  const m = styleMade(ctx, name);
  m.used = true;
  const lvl = heading ? Math.min(levelOf(node), MAX_LEVEL) : 0;
  return m.cur ? {numId: m.cur, ilvl: lvl} : null;
}

/** See the header. */
export function isolate(ctx, fn) {
  const L = state(ctx), saved = L.stack;
  L.stack = [];
  try {
    return fn();
  } finally {
    L.stack = saved;
  }
}

export const PART = {elements: new Map([['text:list', list]])};
