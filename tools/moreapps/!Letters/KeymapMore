// KeymapMore - the rows of menu 'Window' of ./Keymap, which
// builds its ROWS from them (Batch D, P0.2), and of menu 'Outline'.
//
// cut, copy and paste (Ctrl+X, C, V) are labels for the
// Edit menu: ./EditKeys passes those keys on, and the browser makes
// them its own cut, copy and paste (./EditClip). Ctrl+Shift+C, X and V
// have no row. Ctrl+1, 2, 5 (line spacing) and Ctrl+0 (12 pt before)
// are Word's; they arrive with the key name '1'... (Cmd+digit is the
// browser's: ./MacKeys never maps it, so on a Mac too it is Ctrl).
// Ctrl+Shift+L (bullets) is Word's too, on a Mac as well: Cmd-Shift-L
// is Safari's sidebar and is never mapped. Ctrl+Enter is Word's page
// break (./InsertApply), Ctrl on a Mac too (./MacKeys leaves
// Cmd+Enter as Enter); Ctrl+Shift+Enter is Word's split table
// (splitTable, menu 'Table': ./TblCmd, R21) in a table and a column
// break outside one (columnBreak, Insert > Column break, Batch D
// P10.3: no key of its own; ./EditKeys routes the key by the
// caret's place, ./InsertMenu shows it). sectionNext,
// sectionContinuous, sectionEven and sectionOdd (Insert > Section
// break; the last two Batch D P4.4) have no key. nbsp
// (Ctrl+Shift+Space) and nbHyphen (Ctrl+Shift+-, which the browser
// names '_' with Shift, so both are listed) are Word's too, Ctrl on a
// Mac as well; softHyphen (Optional hyphen) has no key.
// The rows of menu 'Window' (WINDOW) act on the document's window,
// not its text (./DocKeys): new (F2, Ctrl+N), close (Ctrl+F2), save
// (Ctrl+S), saveBox (F3), sendToBack (Ctrl+F10), and the Find box's
// (./EditFind): find (Ctrl+F, F4), replace (Ctrl+H), findNext
// (Ctrl+G), findPrev (Ctrl+Shift+G), hyperlink (Ctrl+K: Insert >
// Hyperlink..., the box ./LinkBox; Cmd+K on a Mac), bookmark
// (Ctrl+Shift+F5, Word's: Insert > Bookmark..., ./BookmarkBox; Ctrl
// on a Mac too: ./MacKeys maps no function key). F8 and
// F9 undo and redo, as in Edit. Shift+F3 is caseCycle (Format >
// Change case, ./ChangeCase: Word's key). Shift+F9 is fieldCodes
// (View > Field codes, ./FieldView: Word's key; R2: no RISC OS
// standard key is Shift+F9, F9 stays Redo). F1, F5..F7, F10..F12
// and the other Shift forms (but Ctrl+Shift+F5) have no row (F12 and
// its forms are the desktop's).
// footnote (Ctrl+Alt+F) and endnote (Ctrl+Alt+D) are Word's (Insert
// > Footnote / Endnote: ./NoteMode insert, Batch E2; Ctrl on a Mac
// too, with Option as Alt); comment (Ctrl+Alt+M, Word's key for
// Insert > Comment..., ./CommentBox insertComment, Batch F1; not
// Ctrl+Alt+C, which is AltGr+C on Polish and Czech keyboards);
// nextNote (Alt+Down) and prevNote (Alt+Up) step through the notes
// in the notes mode (./NoteMode step; Word has no key for them;
// outside the mode the key goes on). ./Keymap matches Alt only for
// these rows.
// OUTROWS, menu 'Outline' (Batch D P13.3, D32: ./OutlineCmd):
// outlineUp and outlineDown are Ctrl+Shift+Up and Down, Word's keys,
// only in Outline view (./EditKeys asks before ./Keys, where they
// extend the selection by paragraphs); outlinePromote and
// outlineDemote have no key of their own: in Outline view Shift+Tab
// and Tab at a heading's start run them (./OutlineCmd outlineId).
// Pure: no desktop services.

export const OUTROWS = [
  out('outlinePromote', [], 'Promote'),
  out('outlineDemote', [], 'Demote'),
  out('outlineUp', ['Ctrl+Shift+Up'], 'Move up'),
  out('outlineDown', ['Ctrl+Shift+Down'], 'Move down'),
];

/** A row of the Outline commands. */
function out(id, keys, label) {
  return {id, keys, label, menu: 'Outline'};
}

export const WINROWS = [
  win('new', ['F2', 'Ctrl+N'], 'New'),
  win('close', ['Ctrl+F2'], 'Close'),
  win('save', ['Ctrl+S'], 'Save'),
  win('saveBox', ['F3'], 'Save as'),
  win('find', ['Ctrl+F', 'F4'], 'Find'),
  win('replace', ['Ctrl+H'], 'Replace'),
  win('findNext', ['Ctrl+G'], 'Find next'),
  win('findPrev', ['Ctrl+Shift+G'], 'Find previous'),
  win('sendToBack', ['Ctrl+F10'], 'Send to back'),
  win('hyperlink', ['Ctrl+K'], 'Hyperlink'),
  win('bookmark', ['Ctrl+Shift+F5'], 'Bookmark'),
  win('fieldCodes', ['Shift+F9'], 'Field codes'),
  win('styleList', ['Ctrl+Shift+S'], 'Style list'),
  win('footnote', ['Ctrl+Alt+F'], 'Footnote'),
  win('endnote', ['Ctrl+Alt+D'], 'Endnote'),
  win('comment', ['Ctrl+Alt+M'], 'Comment'),
  win('nextNote', ['Alt+Down'], 'Next note'),
  win('prevNote', ['Alt+Up'], 'Previous note'),
];

/** The ids of the rows of menu 'Window' (the header). */
export const WINDOW = new Set(['new', 'close', 'save', 'saveBox',
  'find', 'replace', 'findNext', 'findPrev', 'sendToBack',
  'hyperlink', 'bookmark', 'fieldCodes', 'styleList', 'footnote',
  'endnote', 'comment', 'nextNote', 'prevNote']);

/** A row of the window's own commands. */
function win(id, keys, label) {
  return {id, keys, label, menu: 'Window'};
}
