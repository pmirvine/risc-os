// DocRects - the rectangles that show a selection in a ./DocLayout.
//
//   selectionRects(L, sel, y0, y1) -> [{x, y, w, h}] in work-area
//   coordinates, for what the screen band y0..y1 shows only: the
//   band (both ends finite) is first made the galley span of what it
//   shows (L.place band: Draft the band itself, Print layout the
//   lines of the pages in it, D33), and the culling below is on the
//   galley (none: nothing lit)
//
// sel is a ./Selection ({anchor, head}); its ends are put in order.
// Text is lit line by line (./PositionMap). A paragraph whose end is
// inside the selection (the selection goes on past it) also gets a
// stub 6 px wide where its last line ends, for its paragraph mark;
// an empty paragraph crossed shows just that (a paragraph ending in a
// page break's rule: the stub inside the text column, at its end).
// A kept block is lit whole when both its edges are in the
// selection. Tables go by the selection's shape (./SelShape,
// memoised per layout; a layout without a typed table is all text):
// 'cells' lights each cell's box on whole pixels (a merged cell
// over every row it spans), a whole table its rows; 'mixed' lights
// the text range as above and each table it takes as one box over
// its taken rows (the table's width), not their text. Only the items
// (and in a long paragraph only the lines, in a table only the
// rows) in the band are looked at, so selecting a whole long
// document costs no more to draw than a short one. The items are
// taken from L.flow (by place, ./DocPos placeOf: cells' items too;
// the band's ends mapped from the root column's items, a table's to
// its end place), each at its column's x and w (./DocItems); an
// item in a cell outside the band is passed. Every box is placed by
// the layout's L.place (./Place, D4): a line's by its rects, a
// table's moved as its place moves it. Pure: no desktop services.
import * as PM from './PositionMap';
import {compare} from './DocPos';
import {shapeOf} from './SelShape';
import {rowAtY, bottomOf} from './TblLayout';
import {at as walkAt} from './Walk';
import {shiftOf} from './Place';

const STUB = 6;
const TEXT = {kind: 'text'};

/** Index of the line of item it that y (work area) falls in. */
function lineAt(it, y) {
  const {lines} = it;
  let lo = 0, hi = lines.length - 1;
  while (lo < hi) {
    const mid = (lo + hi) >> 1;
    if (it.y + lines[mid].y + lines[mid].h > y) hi = mid;
    else lo = mid + 1;
  }
  return lo;
}

/** Line k of paragraph item it lit from x to x + w (x in the line's
 *  coordinates; h the line's height): on screen where L.place puts
 *  the line (its rects). */
function onLine(L, it, k, x, w, h) {
  const b = L.place.rects(it, k, k + 1)[0];
  return {x: x + b.x, y: b.y, w, h};
}

/** The layout item of the table at path tp, or null. */
function tableItem(L, tp) {
  const t = walkAt(L.doc, tp);
  const it = t && L.byId.get(t.id);
  return it && it.kind === 'tbl' ? it : null;
}

/** r moved by d ({dx, dy}: ./Place shiftOf; Draft: r itself). */
const moved = (r, d) => (d.dx || d.dy
  ? {...r, x: r.x + d.dx, y: r.y + d.dy} : r);

/** One box over rows r0..r1 of table item it, in the band. */
function rowsBox(L, it, r0, r1, y0, y1, out) {
  const {rows} = it, n = rows.length;
  const a = Math.max(r0, rowAtY(it, y0));
  const b = Math.min(r1, rowAtY(it, y1));
  if (a > b) return;
  if (L.place.rowParts) {
    // (Print layout: one box per page the rows show on)
    let cur = null;
    for (let r = a; r <= b; r++) {
      for (const p of L.place.rowParts(it, r)) {
        if (cur && cur.page === p.page) cur.h = p.y + p.h - cur.y;
        else {
          cur = {page: p.page, x: it.x + it.left + p.dx, y: p.y,
            w: it.width, h: p.h};
          out.push(cur);
        }
      }
    }
    for (const o of out) delete o.page;
    return;
  }
  const top = a === 0 ? it.y : rows[a].y;
  const end = b === n - 1 ? it.y + it.h : rows[b].y + rows[b].h;
  out.push(moved({x: it.x + it.left, y: top, w: it.width,
    h: end - top}, shiftOf(L.place, it, 0)));
}

/** Row r of table it on screen: [{dx, dy, y, h}] (./Place rowParts
 *  in Print layout: a box on each page; else the row moved by the
 *  table's shift). */
function partsOf(L, it, r) {
  if (L.place.rowParts) return L.place.rowParts(it, r);
  const d = shiftOf(L.place, it, 0), row = it.rows[r];
  return [{dx: d.dx, dy: d.dy, y: row.y + d.dy, h: row.h}];
}

/** The box x0..x1, y0..y1 on whole pixels: neighbouring cells'
 *  boxes meet without a seam or an overlap (./TablePaint's rule). */
function onPixels(x0, y0, x1, y1) {
  const x = Math.round(x0), y = Math.round(y0);
  return {x, y, w: Math.round(x1) - x, h: Math.round(y1) - y};
}

/** A 'cells' shape's boxes in the band (see the header). */
function cellRects(L, sh, y0, y1) {
  const out = [], it = tableItem(L, sh.table);
  if (!it || !it.rows.length) return out;
  if (sh.whole) {
    rowsBox(L, it, 0, it.rows.length - 1, y0, y1, out);
    return out;
  }
  const a = Math.max(sh.r0, rowAtY(it, y0));
  const b = Math.min(sh.r1, rowAtY(it, y1));
  const g = it.key.g;
  for (let r = a; r <= b; r++) {
    for (let c of it.rows[r].cells) {
      if (c.c0 < sh.c0 || c.c1 - 1 > sh.c1) continue;
      if (c.cont) {
        // a merge from above the band: its top cell, once
        const [tr, tk] = g.rows[r].cells[c.k].top;
        if (r !== a || tr >= r) continue;
        c = it.rows[tr].cells[tk];
      }
      for (const d of partsOf(L, it, c.r)) {
        const end = c.rowSpan > 1 ? bottomOf(it, c) + d.dy : d.y + d.h;
        out.push(onPixels(c.x + d.dx, d.y, c.x + c.w + d.dx, end));
      }
    }
  }
  return out;
}

/** See the header. */
export function selectionRects(L, sel, y0, y1) {
  const out = [];
  if (!sel) return out;
  if (Number.isFinite(y0) && Number.isFinite(y1) && L.place.band) {
    const b = L.place.band(y0, y1);
    if (!b) return out;
    ({y0, y1} = b);
  }
  // (no typed table: L.flow is L.items, the shape is text)
  const sh = L.flow === L.items ? TEXT : shapeOf(L.doc, sel, L);
  if (sh.kind === 'cells') return cellRects(L, sh, y0, y1);
  const flip = compare(L, sel.anchor, sel.head) > 0;
  const f = L.locate(flip ? sel.head : sel.anchor);
  const t = L.locate(flip ? sel.anchor : sel.head);
  if (!f || !t || (f.index === t.index && f.off === t.off)) return out;
  let i0 = f.index, i1 = t.index;
  const lit = new Map();
  for (const x of sh.kind === 'mixed' ? sh.tables : []) {
    const it = tableItem(L, x.table);
    if (!it) continue;
    lit.set(it, x);
    i0 = Math.min(i0, it.index);
    i1 = Math.max(i1, it.endIndex);
  }
  if (y0 > -Infinity) i0 = Math.max(i0, L.itemAtY(y0).index);
  if (y1 < Infinity) {
    const e = L.itemAtY(y1);
    i1 = Math.min(i1, e.kind === 'tbl' ? e.endIndex : e.index);
  }
  for (let i = i0; i <= i1; i++) {
    const it = L.flow[i];
    const x = it.kind === 'tbl' && i === it.index && lit.get(it);
    if (x) {
      rowsBox(L, it, x.r0, x.r1, y0, y1, out);
      i = it.endIndex;
      continue;
    }
    if (it.col !== L.root && (it.y > y1 || it.y + it.h < y0)) continue;
    if (it.kind === 'tbl') continue;
    if (it.kind !== 'p') {
      const lit = (i > f.index || f.off === 0) &&
        (i < t.index || t.off === 1);
      if (lit) {
        out.push(L.boxRect(it));
      }
      continue;
    }
    const len = it.block.text.length;
    let a = i === f.index ? f.off : 0;
    let b = i === t.index ? t.off : len;
    const {lines} = it;
    if (lines.length > 1 && it.y < y0) {
      // from one before the first line in view: a wrapper's later
      // piece there is lit only when its offset is in the range
      const s = lines[lineAt(it, y0)].from - 1;
      if (s > a) a = s;
    }
    if (lines.length > 1 && it.y + it.h > y1) {
      const e = lines[lineAt(it, y1)].to;
      if (e < b) b = e;
    }
    if (a < b) {
      for (const r of PM.selectionRects(it, a, b)) {
        out.push(onLine(L, it, r.line, r.x, r.w, r.h));
      }
    }
    if (i < t.index) {
      const c = PM.caretRect(it, len, 'down');
      // after a page break's rule: inside the column
      const x = lines[lines.length - 1].endsWithBreak
        ? Math.min(c.x, it.w - STUB) : c.x;
      out.push(onLine(L, it, c.line, x, STUB, c.h));
    }
  }
  return out;
}
