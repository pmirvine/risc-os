// StyleName - the name of a style as Word shows it. Pure.
//
//   display(style) -> string  style.name, except that Word's own
//       built-in styles, which styles.xml stores in lower case
//       ('heading 1'), are shown as Word shows them ('Heading 1',
//       'TOC 1', 'Footnote Text'); the name falls back to the id.
//       Any other name is shown as stored: a user's style called
//       'heading 1x' or 'my style' is not changed
//   displayName(name) -> string  the same for a bare name
//
// Only the exact stored names (any case) are mapped, from this list
// of the built-ins Word stores in lower case: heading 1-9, toc 1-9,
// index 1-9, footnote text, footnote reference, endnote text,
// endnote reference, header, footer, caption, annotation text,
// annotation reference, balloon text, table of figures, table of
// authorities, toa heading, index heading, page number, line number,
// envelope address, envelope return. Not sure of: 'macro' (Word
// shows 'Macro Text') and 'toc heading' (stored 'TOC Heading'): both
// left as stored. The style's id and stored name are never changed.
const WORD = new Map();
for (const n of [1, 2, 3, 4, 5, 6, 7, 8, 9]) {
  WORD.set('heading ' + n, 'Heading ' + n);
  WORD.set('toc ' + n, 'TOC ' + n);
  WORD.set('index ' + n, 'Index ' + n);
}
for (const n of ['footnote text', 'footnote reference',
  'endnote text', 'endnote reference', 'header', 'footer', 'caption',
  'annotation text', 'annotation reference', 'balloon text',
  'table of figures', 'table of authorities', 'index heading',
  'page number', 'line number', 'envelope address',
  'envelope return']) {
  WORD.set(n, n.replace(/\b[a-z]/g, (c) => c.toUpperCase())
    .replace(/\bOf\b/g, 'of'));
}
WORD.set('toa heading', 'TOA Heading');

// The names (lower case) of Word's built-in styles: the ones above
// and Normal, Title, List Paragraph, Default Paragraph Font, Normal
// Table, Table Grid, TOC Heading, Macro Text. A document in another
// language stores them under other ids, so the name is what says a
// style is built in (isBuiltinName).
const BUILTIN = new Set([...WORD.keys(), 'normal', 'title',
  'list paragraph', 'default paragraph font', 'normal table',
  'table grid', 'toc heading', 'macro text']);

/** True when `name` (any case) is a built-in style's stored name. */
export function isBuiltinName(name) {
  return typeof name === 'string' &&
    BUILTIN.has(name.trim().toLowerCase());
}

/** See the header. */
export function displayName(name) {
  return WORD.get(name) || name;
}

/** See the header. */
export function display(s) {
  const n = s && typeof s.name === 'string' && s.name ? s.name
    : s && s.id;
  return n === undefined || n === null ? '' : displayName(String(n));
}
