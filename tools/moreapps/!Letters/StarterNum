// StarterNum - the numbering part of a starter: one bullet list and
// one numbered list, always numId 1 and 2 (StarterKit list()), made
// with ./NumWrite addList from the gallery entries of ./ListGallery,
// plus `more` numbered lists (numId 3...) of the same definition
// that start again at 1 (addRestart: a startOverride).
//
//   BULLET_ID, NUMBER_ID   the numIds list() writes
//   starterNumbering(more = 0) -> {raw, nums}  the numbering of a Doc
import {addList, addRestart} from './NumWrite';

export const BULLET_ID = 1, NUMBER_ID = 2;

/** See the header (nsids are fixed: the same bytes every time). */
export function starterNumbering(more = 0) {
  let n = 0;
  const rand = () => 0x5A000000 + ++n;
  const a = addList(null, 'disc', {rand});
  const b = addList(a.numbering, '1.', {rand});
  if (a.numId !== BULLET_ID || b.numId !== NUMBER_ID)
    throw new RangeError('starter list ids moved');
  let numbering = b.numbering;
  for (let k = 1; k <= more; k++) {
    const r = addRestart(numbering, NUMBER_ID, 0, 1);
    if (r.numId !== NUMBER_ID + k)
      throw new RangeError('starter list ids moved');
    numbering = r.numbering;
  }
  return numbering;
}
