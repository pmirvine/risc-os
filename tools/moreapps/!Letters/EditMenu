// EditMenu - the Edit submenu of a document's window menu:
//
//   editMenu(view, {count, update, updateAll}?) -> a Menu: Undo,
//                     Redo, Cut, Copy, Paste, Select all, Find...,
//                     Find next, Find previous, Replace..., Next
//                     page, Previous page, Update field, Update all
//                     fields, Word count...
//
// Each shows its key from ./Keymap ('Ctrl+Z'...; 'Cmd+Z' on a Mac,
// view.mac: ./MacKeys macLabel; F8 and F9 undo and redo too, as in
// Edit); Undo and Redo are
// shaded while there is nothing to undo or redo, Cut and Copy while
// nothing is selected (the menu looks each time it opens); Paste is
// never shaded (./EditClip: Cut, Copy, Paste). Find... (Ctrl+F;
// F4 too), Find next (Ctrl+G), Find previous (Ctrl+Shift+G) and
// Replace... (Ctrl+H) open or use the Find box (./EditFind, through
// view.run: ./DocKeys). Next page and Previous page (Word's Go To,
// browse by page; P3 fix wave) do what Ctrl-Page Down and Ctrl-Page
// Up do (./EditKeys pageMove): the first line of the next or
// previous page in Print layout, a window down or up in Draft. They
// are the route when the browser keeps those keys for its own tabs
// (Chrome and Firefox do); never shaded, the key shown as
// Ctrl+PgDn and Ctrl+PgUp. Word count... (no key) runs count() when it
// is given (editMenu(view, {count}): ./CountBox), shaded without a
// selection. Update field and Update all fields (Batch D, D19; no
// key and none shown, R2: F9 stays Redo) run update() and
// updateAll() (./FieldUpdate): the fields at the caret or in the
// selection (in the header and footer mode, its story's), and every
// field of the body (shaded in the mode); shaded without a
// selection or without the function. view is the window's
// ./EditView.
import {Menu} from 'riscos';
import * as S from './Selection';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';
import {copyMenu, cutMenu, pasteMenu} from './EditClip';
import {pageMove} from './EditKeys';

/** See the header. */
export function editMenu(v, {count, update, updateAll} = {}) {
  const k = (id) => macLabel(keymap.labelFor(id), v.mac);
  const none = () => !v.sel || S.collapsed(v.sel);
  return new Menu('Edit', [
    {text: 'Undo', key: k('undo'), shaded: () => !v.d.canUndo,
      action: () => v.undo(),
      help: 'Undo the last change (a word typed is one change). ' +
        'F8 undoes too.'},
    {text: 'Redo', key: k('redo'), shaded: () => !v.d.canRedo,
      action: () => v.redo(),
      help: 'Do again the change that was undone. F9 redoes too.'},
    {text: 'Cut', key: k('cut'), shaded: none,
      action: () => cutMenu(v),
      help: 'Move the selected text to the clipboard.'},
    {text: 'Copy', key: k('copy'), shaded: none,
      action: () => copyMenu(v),
      help: 'Copy the selected text to the clipboard.'},
    {text: 'Paste', key: k('paste'), action: () => { pasteMenu(v); },
      help: 'Put in the text on the clipboard, in place of the ' +
        'selection.'},
    {text: 'Select all', key: k('selectAll'),
      action: () => v.run('selectAll'),
      help: 'Select the whole document.'},
    {text: 'Find...', key: k('find'), action: () => v.run('find'),
      help: 'Find text in the document: the Find box. F4 opens it ' +
        'too.'},
    {text: 'Find next', key: k('findNext'),
      action: () => v.run('findNext'),
      help: 'Find the next place with the text in the Find box.'},
    {text: 'Find previous', key: k('findPrev'),
      action: () => v.run('findPrev'),
      help: 'Find the place before with the text in the Find box.'},
    {text: 'Replace...', key: k('replace'),
      action: () => v.run('replace'),
      help: 'Find text and replace it: the Find box, its caret in ' +
        'Replace.'},
    {text: 'Next page', key: 'Ctrl+PgDn',
      action: () => { pageMove(v, 'nextPage'); },
      help: 'Put the caret on the first line of the next page ' +
        '(in Draft: a window down). CTRL-Page Down does it too, ' +
        'but a browser may keep that key for its own tabs.'},
    {text: 'Previous page', key: 'Ctrl+PgUp',
      action: () => { pageMove(v, 'prevPage'); },
      help: 'Put the caret on the first line of the previous page ' +
        '(in Draft: a window up). CTRL-Page Up does it too, but a ' +
        'browser may keep that key for its own tabs.', dotted: true},
    {text: 'Update field', shaded: () => !v.sel || !update,
      action: () => { if (update) update(); },
      help: 'Put the page number, date, time... of the field at the ' +
        'caret, or of the fields selected, into the document (in a ' +
        'header or footer: all of its fields). A locked field, or ' +
        'one the program cannot work out, is left as it is.'},
    {text: 'Update all fields', dotted: true,
      shaded: () => !v.sel || !updateAll || !!v.hdr,
      action: () => { if (updateAll) updateAll(); },
      help: 'Put the value of every field of the text into the ' +
        'document (not in the header and footer mode).'},
    {text: 'Word count...', shaded: () => !v.sel || !count,
      action: () => { if (count) count(); },
      help: 'The words, characters, paragraphs and lines of the ' +
        'selection, or of the whole document.'},
  ]);
}
