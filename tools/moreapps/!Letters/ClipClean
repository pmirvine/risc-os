// ClipClean - clipboard blocks made fit to go into a document, for
// ./ClipPaste.
//
//   clean(blocks, doc, {sameDoc, styleNames, styles, lists, pics,
//     picScope, inNote, toNote, inComment, cmtMarks}) -> blocks
//   rebuild(c, swap, fmt) -> content  c ({text, runs, inlines})
//     rebuilt run by run: each U+FFFC's inline x stays when swap(x)
//     is null, else becomes the text swap(x) gives; fmt(r) is a
//     run's new {rPr, rStyle?}
//
// blocks: ./ClipSlice's shape (from a copy, or ./ClipRead); the
// result has the same shape (no ids: ./ClipPaste gives fresh ones;
// no extraP: a pasted paragraph gets []), new objects, every
// paragraph checked (RangeError for one that is not valid). Anything
// that is not a block is skipped.
//
// The same document (sameDoc): everything passes as it is: raw
// inlines (links, fields, symbols, pictures), styles, numPr (a list
// goes on), kept blocks (tables); except raw inlines whose XML holds
// an element with an id that must stay unique in the document
// (UNIQUE: bookmarkStart/End, commentRangeStart/End,
// commentReference, ins, del, moveFrom, moveTo, footnoteReference,
// endnoteReference, permStart/End, the moveFrom/moveTo range marks
// and the customXml*Range marks, at any depth): each becomes its
// display text (a w:ins its inserted text, a w:del nothing), or
// nothing. A modelled comment mark (cmtStart, cmtEnd, cmtRef:
// ./ReadPara, Batch F1) is kept, in the same document and across,
// only with opts.cmtMarks (./ClipPaste: ./ClipComments carry then
// gives it a new comment of its own or drops it), else it goes as
// the raw one does (a header's copy, ./StoryCopy); with inNote or
// inComment always. Pictures and
// other drawings are kept: ./ClipPaste then gives every wp:docPr id
// in them afresh (./ClipPics freshDocPrs, plan R14). A kept block
// whose XML holds any id that must stay unique (./ClipIds.hasIds:
// those elements, a wp:docPr, a content control's w:id, a change
// record's w:id) is pasted as text instead (./ClipIds.flatten: a
// paragraph per table row, cells joined by tabs); a kept one loses
// its w14:paraId / w14:textId.
// A footnote or endnote mark (a noteRef inline, Batch E2) is kept,
// in the same document and across: ./ClipPaste then gives it a new
// note of its own or drops it (./ClipNotes carry); a note's own
// mark (self) is kept only in the same document and pasted into a
// note (opts.toNote: ./ClipPaste, d a note's ./StoryFacade): in the
// body or a header Word never writes one. With opts.inNote
// (the blocks of a note the paste carries) the other way round: a
// note's own mark is kept, any other mark goes (no note in a note).
// With opts.inComment (the blocks of a comment the paste carries,
// ./ClipComments) every note and comment mark goes and the
// comment's own mark (a bare w:annotationRef) is kept, across
// documents too.
// A typed table (Batch C) comes whole: ./ClipCleanTbl sameTable
// (its paragraphs as these, its marks with unique ids dropped); a
// floating one never overlaps the tables before it (./TblFloat
// apart: P12b fix I4, the copy is not hidden under its original).
// Elements with such ids in pPr.extra and in a run's rPr.extra
// (w:pPrChange, w:rPrChange: tracked format changes) are dropped.
//
// Another document (or HTML): what refers to the source document's
// parts cannot come, but its pictures:
//   - a picture (./ClipPics picKept: ./PicRead understands it, read
//     in opts.picScope, and its embed is in opts.pics, the source's
//     media) is kept as it is: ./ClipPaste then copies its media
//     and gives it new ids (./ClipPics copyPics)
//   - every other raw inline goes: one with display text (a link,
//     any level 'p' wrapper) becomes that text (./Edit.clean: no
//     control characters, no U+FFFC), a w:t holding a character
//     becomes that character, any other (a field character, a
//     bookmark, a linked or VML picture, a picture whose media did
//     not come...) becomes nothing; a tab inline is a tab character
//     and a br inline a line break, as typed ones are, except a page
//     or column break (./BreakMarks), a w:noBreakHyphen and a
//     w:softHyphen (no attributes, no children), which stay one (a
//     new inline: it refers to no part); the text keeps its
//     run's formatting
//   - pStyle and rStyle are mapped by NAME (styleNames: Map id ->
//     {name, type}, ./ClipSlice) to the target's style of that name
//     and type (case ignored), else dropped (the default style)
//   - rPr and pPr keep their modelled fields and their raw extras
//     cleaned, as Word keeps them (./ClipProps: borders, shading,
//     tab stops... left and right spelled as the target spells
//     them); numPr only for a list of opts.lists (Map numId ->
//     definition: ./ClipNums) with the source's numId, which
//     ./ClipPaste then makes in the target (./NumCopy)
//   - kept blocks (tables, whose XML can point at the source's
//     parts) are skipped; a typed table comes as a table (Batch
//     C6.1): its paragraphs as these, its own parts as
//     ./ClipCleanTbl crossTable cleans them (tblStyle mapped by name
//     as pStyle, type 'table'; kept as the source's id when
//     opts.styles holds the source's table styles: ./ClipPaste then
//     makes them in the target, ./TblStyleCopy).
// Pure: no desktop services.
import {fail, normRuns, checkContent} from './ModelCheck';
import {crossPPr, crossRPr} from './ClipProps';
import {clean as cleanText} from './Edit';
import {hasUnique, hasIds, dropIds, keepIds, flatten} from './ClipIds';
import {isPageBreak} from './BreakMarks';
import {isStrictDoc} from './JcName';
import {picKept} from './ClipPics';
import {sameTable, crossTable} from './ClipCleanTbl';
import {apart} from './TblFloat';
import {docMap} from './PicRead';
import {isCommentMark} from './Kinds';

const OBJ = '\ufffc';
const isObj = (v) => v !== null && typeof v === 'object' &&
  !Array.isArray(v);

/** {text, runs, inlines} of b, checked. */
function contentOf(b) {
  const c = {text: b.text, runs: b.runs, inlines: b.inlines};
  checkContent(c);
  return c;
}

/** A target style id for source style id, or undefined. */
function mapper(doc, names) {
  const index = new Map();
  const map = doc && doc.styles && doc.styles.styles;
  if (map instanceof Map) {
    for (const s of map.values()) {
      if (!s || typeof s.name !== 'string') continue;
      const k = s.type + '|' + s.name.toLowerCase();
      if (!index.has(k)) index.set(k, s.id);
    }
  }
  return (id, type) => {
    if (typeof id !== 'string' || !(names instanceof Map)) return;
    const n = names.get(id);
    if (!n || n.type !== type || typeof n.name !== 'string') return;
    return index.get(type + '|' + n.name.toLowerCase());
  };
}

/** 'w:noBreakHyphen' or 'w:softHyphen' for such a bare inline. */
function hyphen(x) {
  const n = isObj(x) && x.kind === 'raw' && x.level === 'r' && x.node;
  return isObj(n) && (n.name === 'w:noBreakHyphen' ||
    n.name === 'w:softHyphen') && !attrsOf(n) && !kids(n) ? n.name :
    null;
}
const attrsOf = (n) => Array.isArray(n.attrs) && n.attrs.length > 0;
const kids = (n) => Array.isArray(n.children) && n.children.length > 0;

/** The text an inline becomes across documents (null: kept). */
function inlineText(x) {
  if (!isObj(x)) return '';
  if (isPageBreak(x) || hyphen(x)) return null;
  if (x.kind === 'tab') return '\t';
  if (x.kind === 'br') return '\n';
  if (typeof x.text === 'string') return cleanText(x.text);
  const n = x.node;
  if (isObj(n) && /(^|:)t$/.test(String(n.name)) &&
    Array.isArray(n.children) &&
    n.children.every((c) => typeof c === 'string'))
    return cleanText(n.children.join(''));
  return '';
}

/** See the header. */
export function rebuild(c, swap, fmt) {
  let text = '';
  const runs = [], inlines = {};
  for (const r of c.runs) {
    const s = c.text.slice(r.start, r.end);
    let t = '', at = 0;
    for (let j = s.indexOf(OBJ); j >= 0; j = s.indexOf(OBJ, at)) {
      t += s.slice(at, j);
      const x = c.inlines[r.start + j];
      const rep = swap(x);
      if (rep === null) {
        inlines[text.length + t.length] = x;
        t += OBJ;
      } else t += rep;
      at = j + 1;
    }
    t += s.slice(at);
    if (!t) continue;
    runs.push({start: text.length, end: text.length + t.length,
      ...fmt(r)});
    text += t;
  }
  return {text, runs: normRuns(runs), inlines};
}

/** Paragraph block b for another document. */
function cross(b, map, strict, opts, doc) {
  const rprs = new Map();
  const fmt = (r) => {
    let rPr = rprs.get(r.rPr);
    if (!rPr) rprs.set(r.rPr, rPr = crossRPr(r.rPr, strict));
    const rs = map(r.rStyle, 'character');
    return rs === undefined ? {rPr} : {rPr, rStyle: rs};
  };
  const {pics, picScope} = opts;
  const keep = markKept(opts.inNote, false, opts.inComment);
  const cmt = cmtKept(opts);
  const swap = (x) => {
    const m = keep(x);
    if (m !== undefined) return m;
    if (isCommentMark(x)) return cmt ? null : '';
    if (opts.inComment && isAnnot(x)) return null;
    return picKept(x, pics, picScope, doc) ? null : inlineText(x);
  };
  const c = rebuild(contentOf(b), swap, fmt);
  for (const k of Object.keys(c.inlines)) {
    const x = c.inlines[k];
    // a page or column break, a hyphen: a new inline (any other
    // kept as it is)
    if (isPageBreak(x)) {
      c.inlines[k] = {kind: 'br', level: 'r', brType: x.brType};
    } else if (hyphen(x)) {
      c.inlines[k] = {kind: 'raw', level: 'r',
        node: {name: hyphen(x), attrs: [], children: []}};
    }
  }
  const pPr = crossPPr(b.pPr, strict, opts.lists);
  const out = {type: 'p', ...c, pPr};
  const ps = map(b.pStyle, 'paragraph');
  if (ps !== undefined) out.pStyle = ps;
  return out;
}

const isMark = (x) => isObj(x) && x.kind === 'noteRef';

/** What a footnote or endnote mark becomes (see the header): null
 *  kept, '' dropped; undefined for any other inline. self: whether
 *  a note's own mark stays (pasted into a note). */
const markKept = (inNote, self, none) => (x) => {
  if (!isMark(x)) return undefined;
  if (none) return '';
  if (x.self === true) return inNote || self ? null : '';
  return inNote ? '' : null;
};

/** Whether comment marks are kept (see the header). */
const cmtKept = (opts) => opts.cmtMarks === true && !opts.inNote &&
  !opts.inComment;

/** Whether x is a comment's own mark, a bare w:annotationRef. */
const isAnnot = (x) => isObj(x) && x.kind === 'raw' && isObj(x.node) &&
  /(^|:)annotationRef$/.test(String(x.node.name)) && !kids(x.node);

/** Same document: the text an inline becomes, or null (kept). */
const sameSwap = (inNote, toNote, cmt, inCmt) => {
  const keep = markKept(inNote, toNote, inCmt);
  return (x) => {
    const m = keep(x);
    if (m !== undefined) return m;
    if (isCommentMark(x)) return cmt ? null : '';
    return isObj(x) && x.kind === 'raw' && hasUnique(x.node)
      ? (typeof x.text === 'string' ? cleanText(x.text) : '') : null;
  };
};

/** Paragraph block b for its own document, doc. */
function same(b, inNote, toNote, cmt, inCmt) {
  const c = contentOf(b), sw = sameSwap(inNote, toNote, cmt, inCmt);
  if (!isObj(b.pPr) || !Array.isArray(b.pPr.extra)) fail('bad pPr');
  const swap = Object.values(c.inlines).some((x) => sw(x) !== null);
  const fmt = (r) => (r.rStyle === undefined ? {rPr: dropIds(r.rPr)}
    : {rPr: dropIds(r.rPr), rStyle: r.rStyle});
  const body = swap ? rebuild(c, sw, fmt)
    : {text: c.text, runs: normRuns(c.runs.map((r) => ({...r,
      ...fmt(r)}))), inlines: c.inlines};
  const out = {type: 'p', ...body, pPr: dropIds(b.pPr)};
  if (typeof b.pStyle === 'string') out.pStyle = b.pStyle;
  return out;
}

/** See the header. */
export function clean(blocks, doc, opts = {}) {
  const sameDoc = !!opts.sameDoc;
  const inNote = !!opts.inNote, inCmt = !!opts.inComment;
  const cmt = cmtKept(opts);
  const toNote = opts.toNote === true;
  const map = mapper(doc, opts.styleNames);
  const strict = isStrictDoc(doc);
  const crossP = (b) => cross(b, map, strict, opts, doc);
  const style = opts.styles instanceof Map ? (id) => id
    : (id) => map(id, 'table');
  const out = [];
  for (const b of Array.isArray(blocks) ? blocks : []) {
    if (!isObj(b)) continue;
    if (b.type === 'opaque') {
      if (!sameDoc || !isObj(b.node)) continue;
      if (hasIds(b.node)) out.push(...flatten(b.node));
      else out.push({type: 'opaque', node: keepIds(b.node)});
    } else if (b.type === 'tbl') {
      if (sameDoc) {
        const t = sameTable(b, (x) => same(x, inNote, toNote, cmt,
          inCmt));
        out.push({...t, tblPr: apart(t.tblPr, docMap(doc))});
      } else out.push(crossTable(b, crossP, {strict, style}));
    } else if (b.type === 'p') {
      out.push(sameDoc ? same(b, inNote, toNote, cmt, inCmt)
        : crossP(b));
    }
  }
  return out;
}
