// NoteStyle - the styles of footnotes and endnotes (Batch E2): Word's
// Footnote Text, Footnote Reference, Endnote Text and Endnote
// Reference, found or made on first use.
//
//   noteStyle(d, id, name, type) -> id | null  the style of id, or
//       of Word's name `name`, of type ('character' | 'paragraph'),
//       made (Word's built-in) when d has none (below); null for
//       none (./NoteCmd, ./NoteConvert, and ./ClipNotes for a paste
//       from another document)
//   styleIds(doc, kind) -> {text, ref}  the ids a note of kind
//       ('footnote' | 'endnote') is styled with now: each a Set of
//       Word's id (FootnoteText...) and the id of the document's
//       style found by it or by Word's name; nothing is made
// The styles: the document's own of that id, else of Word's name
// (footnote text, footnote reference, endnote text, endnote
// reference: ./DocParts findStyle; none used when the one found is
// of the wrong type), else Word's built-in (./StyleCmd ensureBuiltin,
// Strict-safe in a Strict document) added in the same step; a
// document with no style table gets none.
// Pure: no desktop services.
import {findStyle} from './DocParts';
import {ensureBuiltin} from './StyleCmd';

const isObj = (v) => v !== null && typeof v === 'object';
const CAP = {footnote: 'Footnote', endnote: 'Endnote'};

/** See the header. */
export function noteStyle(d, id, name, type) {
  const st = d.doc.styles;
  if (!isObj(st) || !(st.styles instanceof Map)) return null;
  const own = findStyle(st, id, name);
  if (own) return own.type === type ? own.id : null;
  const strict = isObj(d.doc.meta) && d.doc.meta.conformance ===
    'strict';
  const t = ensureBuiltin(st, id, {strict});
  if (!t) return null;
  d.apply({op: 'setDocPart', key: 'styles', value: t});
  return id;
}

/** The ids of one style (see the header). */
function idsOf(st, id, name) {
  const out = new Set([id]);
  const own = isObj(st) && st.styles instanceof Map
    ? findStyle(st, id, name) : null;
  if (own && typeof own.id === 'string') out.add(own.id);
  return out;
}

/** See the header. */
export function styleIds(doc, kind) {
  const st = doc.styles, cap = CAP[kind];
  return {text: idsOf(st, cap + 'Text', kind + ' text'),
    ref: idsOf(st, cap + 'Reference', kind + ' reference')};
}
