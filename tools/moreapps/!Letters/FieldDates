// FieldDates - date pictures and the document's properties (Batch D,
// D17): the dates and names ./Fields shows.
//
//   formatDate(date, picture) -> string | null   '\@': date (a valid
//     Date, shown in local time, year 0 to 9999) by picture:
//       d dd ddd dddd   day 1, 01, Sun, Sunday (4 or more d: dddd)
//       M MM MMM MMMM   month 1, 01, Oct, October (Month names and
//                       day names in English (UK))
//       yy yyyy         26, 2026 (y or yy: yy; 3 or more: yyyy)
//       H HH h hh       hour 0-23, 00-23, 1-12, 01-12
//       m mm s ss       minutes, seconds (M is the month, m minutes)
//       am/pm AM/PM     'am' or 'pm', 'AM' or 'PM'
//       'text'          literal ('' nothing)
//     Any other character is itself. Null: not a valid date, an
//     unclosed quote, an empty picture, one longer than
//     ./FieldFormat MAX_PICTURE
//   DATE_PICTURE  'dd/MM/yyyy' (Word's for DATE in English (UK),
//                 PG18); TIME_PICTURE 'HH:mm'; STAMP_PICTURE
//                 'dd/MM/yyyy HH:mm' (CREATEDATE, SAVEDATE,
//                 PRINTDATE)
//   w3cdtf(s) -> Date | null   a W3CDTF date as core.xml writes it:
//     YYYY, YYYY-MM, YYYY-MM-DD, or with Thh:mm, :ss and .s and a
//     zone (Z or +hh:mm); white space around is ignored; at most 64
//     characters; anything else (a day past the month's end, hour
//     24) null
//   coreOf(doc) -> the document's core properties, frozen:
//     {creator, title, subject, keywords, lastModifiedBy} strings
//     ('' when missing), {created, modified, lastPrinted} Dates or
//     null. Read-only: the part's bytes in doc.parts (the package
//     relationship of type .../metadata/core-properties, else
//     docProps/core.xml) parsed and never changed. Tolerant: no
//     part, bytes that do not parse, more than CORE_MAX_BYTES or
//     CORE_MAX_ELEMENTS: every value missing. A text is cut to
//     CORE_MAX_TEXT. Memoised per doc.parts
//   CORE_MAX_BYTES 1 MB, CORE_MAX_ELEMENTS 10000, CORE_MAX_TEXT 4096
// Pure: no desktop services; the clock is never read (./Fields gets
// now from its caller).
import {MAX_PICTURE} from './FieldFormat';
import {parsePart} from './PartXml';
import {resolvePart} from './Rels';
import {localName} from './Kinds';
import {isEl} from './Ns';

export const DATE_PICTURE = 'dd/MM/yyyy';
export const TIME_PICTURE = 'HH:mm';
export const STAMP_PICTURE = 'dd/MM/yyyy HH:mm';
export const CORE_MAX_BYTES = 1024 * 1024;
export const CORE_MAX_ELEMENTS = 10000;
export const CORE_MAX_TEXT = 4096;

const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday',
  'Friday', 'Saturday'];
const MONTHS = ['January', 'February', 'March', 'April', 'May',
  'June', 'July', 'August', 'September', 'October', 'November',
  'December'];
const TOKEN = 'dMyHhms';
const z2 = (n) => String(n).padStart(2, '0');

/** Token c repeated k times, of the parts t. */
function token(c, k, t) {
  switch (c) {
  case 'd': return k === 1 ? String(t.d) : k === 2 ? z2(t.d)
    : k === 3 ? DAYS[t.wd].slice(0, 3) : DAYS[t.wd];
  case 'M': return k === 1 ? String(t.M) : k === 2 ? z2(t.M)
    : k === 3 ? MONTHS[t.M - 1].slice(0, 3) : MONTHS[t.M - 1];
  case 'y': return k <= 2 ? z2(t.y % 100)
    : String(t.y).padStart(4, '0');
  case 'H': return k === 1 ? String(t.H) : z2(t.H);
  case 'h': return k === 1 ? String(t.H % 12 || 12)
    : z2(t.H % 12 || 12);
  case 'm': return k === 1 ? String(t.m) : z2(t.m);
  default: return k === 1 ? String(t.s) : z2(t.s);
  }
}

/** See the header. */
export function formatDate(date, picture) {
  if (!(date instanceof Date) || Number.isNaN(date.getTime()) ||
    typeof picture !== 'string' || !picture.length ||
    picture.length > MAX_PICTURE) return null;
  const t = {y: date.getFullYear(), M: date.getMonth() + 1,
    d: date.getDate(), wd: date.getDay(), H: date.getHours(),
    m: date.getMinutes(), s: date.getSeconds()};
  if (t.y < 0 || t.y > 9999) return null;
  let out = '';
  for (let i = 0; i < picture.length;) {
    const c = picture[i];
    if (c === "'") {
      const j = picture.indexOf("'", i + 1);
      if (j < 0) return null;
      out += picture.slice(i + 1, j);
      i = j + 1;
    } else if (picture.startsWith('am/pm', i) ||
      picture.startsWith('AM/PM', i)) {
      const s = t.H < 12 ? 'am' : 'pm';
      out += c === 'a' ? s : s.toUpperCase();
      i += 5;
    } else if (TOKEN.includes(c)) {
      let k = 1;
      while (picture[i + k] === c) k++;
      out += token(c, Math.min(k, 4), t);
      i += k;
    } else {
      out += c;
      i++;
    }
  }
  return out;
}

const W3C = new RegExp('^(\\d{4})(?:-(\\d\\d)(?:-(\\d\\d)(?:T(\\d\\d)' +
  ':(\\d\\d)(?::(\\d\\d)(?:\\.(\\d{1,9}))?)?' +
  '(Z|[+-]\\d\\d:\\d\\d))?)?)?$');

/** See the header. */
export function w3cdtf(s) {
  if (typeof s !== 'string' || s.length > 64) return null;
  const m = W3C.exec(s.trim());
  if (!m) return null;
  const [y, mo = 1, d = 1, h = 0, mi = 0, se = 0] = m.slice(1, 7)
    .map((x) => (x === undefined ? undefined : Number(x)));
  const ms = m[7] ? Math.floor(Number('0.' + m[7]) * 1000) : 0;
  if (mo < 1 || mo > 12 || h > 23 || mi > 59 || se > 59) return null;
  const u = new Date(Date.UTC(2000, 0, 1, h, mi, se, ms));
  u.setUTCFullYear(y, mo - 1, d);        // (years 0-99 too)
  const t = u.getTime();
  if (u.getUTCDate() !== d || u.getUTCMonth() !== mo - 1 || d < 1)
    return null;
  let off = 0;
  if (m[8] && m[8] !== 'Z') {
    const oh = Number(m[8].slice(1, 3)), om = Number(m[8].slice(4));
    if (oh > 14 || om > 59) return null;
    off = (m[8][0] === '-' ? -1 : 1) * (oh * 60 + om) * 60000;
  }
  return new Date(t - off);
}

const STRINGS = ['creator', 'title', 'subject', 'keywords',
  'lastModifiedBy'];
const DATES = ['created', 'modified', 'lastPrinted'];
const EMPTY = Object.freeze({creator: '', title: '', subject: '',
  keywords: '', lastModifiedBy: '', created: null, modified: null,
  lastPrinted: null});
const memo = new WeakMap();

/** The core properties part's name in doc. */
function partOf(doc) {
  const rels = doc.meta && Array.isArray(doc.meta.packageRels)
    ? doc.meta.packageRels : [];
  const rel = rels.find((r) => r && typeof r.type === 'string' &&
    /\/metadata\/core-properties$/i.test(r.type) &&
    typeof r.target === 'string' && r.mode !== 'External');
  return rel ? resolvePart('', rel.target) : 'docProps/core.xml';
}

/** The text directly in element n, cut to CORE_MAX_TEXT. */
function textIn(n) {
  let s = '';
  for (const c of n.children) {
    if (typeof c === 'string') s += c;
    if (s.length > CORE_MAX_TEXT) return s.slice(0, CORE_MAX_TEXT);
  }
  return s;
}

/** The core properties in bytes (see the header). */
function readCore(bytes, name) {
  if (!(bytes instanceof Uint8Array)) return EMPTY;
  let x;
  try {
    x = parsePart(bytes, name, {maxXmlBytes: CORE_MAX_BYTES,
      maxElements: CORE_MAX_ELEMENTS});
  } catch {
    return EMPTY;
  }
  const out = {...EMPTY};
  for (const c of x.root.children) {
    if (!isEl(c)) continue;
    const k = localName(c);
    if (STRINGS.includes(k)) out[k] = textIn(c);
    else if (DATES.includes(k)) out[k] = w3cdtf(textIn(c));
  }
  return Object.freeze(out);
}

/** See the header. */
export function coreOf(doc) {
  if (!doc || !(doc.parts instanceof Map)) return EMPTY;
  let c = memo.get(doc.parts);
  if (!c) {
    const name = partOf(doc);
    c = readCore(doc.parts.get(name), name);
    memo.set(doc.parts, c);
  }
  return c;
}
