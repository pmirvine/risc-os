// OutlineView - a window's Outline collapse set (Batch D P13.2,
// P13.4, D32): split from ./ViewMode (P13 fix prep). The set is the
// window's, kept across views and never written to the file.
//
//   initOutline(dw)       dw.collapsed, Outline's collapse set (an
//                         empty Set: every heading expanded);
//                         view.toggleMarker(id), a double-click on a
//                         marker (./EditMouse): applyFold with
//                         ./OutlineFold toggleId; view.reveal(sel)
//                         (./EditView setSelection, ./FindSel: Find,
//                         Replace, Go to; P13 fix I1): in Outline,
//                         an end of sel in hidden text opens the
//                         headings over it (./OutlineFold revealCmd)
//   outlineOpt(dw)        -> the window's next layout's outline
//                         (./LayoutOpts): dw.collapsed in Outline,
//                         else null (./WinFit)
//   setCollapsed(dw, set) Outline's collapse set replaced (a new Set
//                         of heading ids, never changed after: the
//                         layout keys by it) and, in Outline, laid
//                         out again (dw.fit)
//   applyFold(dw, next)   -> bool   next (a ./OutlineFold Fold; null:
//                         the command found nothing to do: a beep,
//                         view.refused) made the collapse set, and
//                         a selection end in text now hidden moved
//                         to the heading above (keepVisible)
//
// Imports no desktop services.
import {toggleId, keepVisible, revealCmd} from './OutlineFold';

/** See the header. */
export function initOutline(dw) {
  dw.collapsed = new Set();            // (Outline: D32)
  dw.view.toggleMarker = (id) => applyFold(dw,
    toggleId(dw.doc, dw.collapsed, id));   // (./EditMouse)
  dw.view.reveal = (sel) => reveal(dw, sel);
}

/** See the header (view.reveal). */
function reveal(dw, sel) {
  if (dw.viewName !== 'outline' || !sel || !sel.head) return;
  dw.view.ensure();                    // (an edit laid out first)
  const by = dw.L.byId;
  if (by.has(sel.anchor.id) && by.has(sel.head.id)) return;
  const f = revealCmd(dw.doc, dw.collapsed, sel);
  if (f) setCollapsed(dw, f);
}

/** See the header. */
export const outlineOpt = (dw) => (dw.viewName === 'outline'
  ? dw.collapsed : null);

/** See the header. */
export function setCollapsed(dw, set) {
  dw.collapsed = set instanceof Set ? set : new Set();
  if (dw.viewName === 'outline') dw.fit();
}

/** See the header. */
export function applyFold(dw, next) {
  const v = dw.view, sel = v.sel;
  if (!next) {
    v.refused();
    return false;
  }
  setCollapsed(dw, next);
  const to = sel && keepVisible(dw.doc, next, sel);
  if (to && to !== sel) v.setSelection(to);
  return true;
}
