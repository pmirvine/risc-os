// Ops - the operations that change a Doc, each returning its inverse.
//
//   apply(doc, op) -> inverse op
//
// apply(doc, apply(doc, op)) leaves doc deep-equal to how it was
// before op (paragraph ids included). An op that is refused throws
// RangeError and leaves doc unchanged. Positions are paths
// (./Path): [s, i] at top level, [s, i, r, c, j, ...] in a cell of a
// table, with the same meaning inside that cell's blocks (./OpsPath
// locate; mergeBlock joins blocks of one container only, never
// across cells; a cell, and a story, keeps at least one block and
// never ends with a table: ./TblCheck endsCell, refused before any
// change; ./OpsPath locate's tail, which spares a story read from
// the file empty or ending with a table). An op in
// a cell copies the tables on its path first (./OpsPath own): a
// table, row or cell object is never changed. Section ops refuse a
// nested path.
// Every op but a compound, a setDocPart, a setStory, the section
// ops and the notes ops takes `story` (Batch D, D12, R8): a header
// or footer part name of doc.stories, or a note's key {note: {kind,
// id}} (Batch E2), whose blocks the path [0, i, ...] is in (absent
// or null: the body). Its inverse has the same story; doc.stories
// (doc.notes) is replaced by a new Map holding a new Story (Note),
// never changed in place (./OpsPath). The others refuse a story (a
// compound's ops each carry their own; a setStory's `story` is the
// Story it sets).
// Offsets are UTF-16 code units.
//
//   replaceText  {block, at, del, ins, rPr?, rStyle?, inlines?}
//   setProps     {block, pPr?, pStyle?, range?, rPr?, rStyle?}
//   splitBlock   {block, at}         mergeBlock  {block}
//   insertBlock  {at, block}         removeBlock {at}
//   restoreBlock {block, snapshot}   (replace a block)
//   removeBlocks {at, count}         insertBlocks {at, blocks}
//                                    (many blocks: ./OpsBlocks)
//   spliceText   {block, at, del, content: {text, runs, inlines}}
//   compound     {ops: [...]}        (all or nothing)
//   setDocPart   {key, value}        (numbering, rels, styles,
//                                    settings, numberingPart: ./OpsDoc)
//   splitSection {at, props, raw}    mergeSection {at, keep?}
//   setSection   {at, props, raw}    (./OpsSect)
//   setStory     {part, story, at?}  (a whole story added, replaced
//                                    or removed: ./OpsStory; its
//                                    `story` is the Story or null)
//   addNote      {kind, id, note, at?}   removeNote {kind, id}
//   addNotes     {kind, notes, order}    removeNotes {kind, ids}
//   setNote      {kind, id, patch}   setNoteRels {kind, rels}
//   setNoteOpts  {level, kind, value}
//   setNotesPart {kind, value}       (footnotes and endnotes:
//                                    ./OpsNotes)
//
// NEVER CHANGE A MODEL OBJECT IN PLACE. Blocks, runs, rPr, pPr,
// inlines and Xml nodes are shared between the live Doc and the
// inverse ops in undo history (copy-on-write: an op that changes a
// part makes new objects for that part only). apply() copies the op
// it is given, so callers' objects never enter the Doc (except a
// setDocPart's value, a setStory's Story, the Notes, patch values,
// rels, raw and part value of the notes ops, and a restoreBlock's
// TABLE snapshot: immutable by contract, kept by reference so that a
// new table shares its
// unchanged rows with the old one, D4); applyOwn() does not, and is
// only for ops this module made (Document's undo).
//
// Ids: a block put in (and every block inside a table) must have an
// id used nowhere else in doc (./OpsUtil checkIds); a restoreBlock of
// a table with the same id checks the table, and against doc only
// the ids it holds that the old one did not (one scan, none if no
// new id).
import {fail, checkBlock, opStory} from './ModelCheck';
import {checkTail, endsCell} from './TblCheck';
import {clone} from './Model';
import {locate, own, checkIds, inStory} from './OpsUtil';
import {blockIds, ids} from './Walk';
import {replaceText, spliceText, splitBlock, mergeBlock}
  from './OpsText';
import {setProps} from './OpsProps';
import {removeBlocks, insertBlocks} from './OpsBlocks';
import {setDocPart} from './OpsDoc';
import {splitSection, mergeSection, setSection}
  from './OpsSect';
import {setStory} from './OpsStory';
import {addNote, removeNote, setNote, setNoteRels, setNoteOpts,
  setNotesPart, addNotes, removeNotes} from './OpsNotes';
import {bump} from './DocVersion';

/**
 * Check block `b` inside `around` tables; its ids must be free in
 * doc (but for those of `old`, the block it replaces).
 */
function check(doc, b, old, around) {
  checkBlock(b, around);
  checkIds(doc, [b], old ? [old] : []);
  return b;
}

function insertBlock(doc, op) {
  const {i, at, depth, blocks, tail} = locate(doc, op.at, true,
    op.story);
  const b = check(doc, op.block, null, depth);
  if (tail && i === blocks.length) checkTail(b, tail);
  own(doc, at, op.story).splice(i, 0, b);
  return inStory({op: 'removeBlock', at}, op.story);
}

function removeBlock(doc, op) {
  const {i, at, blocks, tail} = locate(doc, op.at, false, op.story);
  if (tail && blocks.length === 1)
    fail(tail + ' needs at least one block');
  if (tail && i === blocks.length - 1) checkTail(blocks[i - 1], tail);
  const [b] = own(doc, at, op.story).splice(i, 1);
  return inStory({op: 'insertBlock', at, block: b}, op.story);
}

/** The ids inside table b that table old does not hold. */
function newIds(b, old) {
  const had = new Set(blockIds([old]));
  return blockIds([b]).filter((id) => !had.has(id));
}

/**
 * A paragraph that keeps the id of the one it replaces cannot make
 * an id used twice: no scan of the document (undoing a setProps of
 * 50,000 paragraphs stays linear). A table that keeps its id: only
 * the ids it holds that the old one did not are looked for.
 */
function restoreBlock(doc, op) {
  const {i, at, blocks, depth, tail} = locate(doc, op.block, false,
    op.story);
  const old = blocks[i];
  const b = op.snapshot;
  if (tail && i === blocks.length - 1 && !endsCell(old))
    checkTail(b, tail);
  const same = b && (b.type === 'p' || b.type === 'tbl') &&
    old.type === b.type && b.id === old.id;
  if (!same) check(doc, b, old, depth);
  else {
    checkBlock(b, depth);
    const fresh = b.type === 'tbl' ? newIds(b, old) : [];
    if (fresh.length) {
      const used = new Set(ids(doc));
      for (const id of fresh) {
        if (used.has(id)) fail('id ' + id + ' is already in use');
      }
    }
  }
  own(doc, at, op.story)[i] = b;
  return inStory({op: 'restoreBlock', block: at, snapshot: old},
    op.story);
}

function compound(doc, op) {
  if (!Array.isArray(op.ops)) fail('compound needs ops');
  const done = [];
  const m = doc.stories, n = doc.notes;
  try {
    for (const o of op.ops) done.push(applyOwn(doc, o));
  } catch (e) {
    for (let k = done.length - 1; k >= 0; k--) applyOwn(doc, done[k]);
    // (undone: the stories and notes as they were, so the very
    // objects again)
    if (doc.stories !== m) doc.stories = m;
    if (doc.notes !== n) doc.notes = n;
    throw e;
  }
  return {op: 'compound', ops: done.reverse()};
}

const KINDS = {replaceText, spliceText, setProps, splitBlock,
  mergeBlock, insertBlock, removeBlock, restoreBlock, compound,
  removeBlocks, insertBlocks, setDocPart, splitSection,
  mergeSection, setSection, setStory, addNote, removeNote, setNote,
  setNoteRels, setNoteOpts, setNotesPart, addNotes, removeNotes};

/** The ops that refuse a story (D12). */
const BODY_ONLY = new Set(['compound', 'setDocPart', 'splitSection',
  'mergeSection', 'setSection', 'addNote', 'removeNote', 'setNote',
  'setNoteRels', 'setNoteOpts', 'setNotesPart', 'addNotes',
  'removeNotes']);

/** The notes ops' fields: [kept by reference (see copy), copied]. */
const BY_REF = {addNote: [['note', 'raw'], ['kind', 'id', 'at']],
  removeNote: [['raw'], ['kind', 'id']],
  addNotes: [['notes', 'order', 'raw'], ['kind']],
  removeNotes: [['raw'], ['kind', 'ids']],
  setNote: [['note'], ['kind', 'id', 'patch']],
  setNoteRels: [['rels'], ['kind']],
  setNotesPart: [['value'], ['kind']]};

/**
 * Apply `op` to `doc` and return the op that undoes it. The op is
 * copied first, so nothing the caller holds becomes part of doc.
 * @param {object} doc a Doc (see Model)
 * @param {object} op
 * @returns {object}
 */
export function apply(doc, op) {
  return applyOwn(doc, copy(op));
}

/**
 * A copy of op for apply(): a setDocPart's value is NOT copied (it
 * is immutable by contract, see ./OpsDoc: a whole numbering or style
 * table copied per apply would cost time and lose the sharing), nor
 * a restoreBlock's table snapshot (D4: the new table shares every
 * unchanged row, cell and paragraph with the old one), nor a
 * setStory's Story (./OpsStory: its bytes and orig must stay the
 * objects read, for ./StoryWrite), nor the Notes, patch values,
 * rels, raw and part value of the notes ops (./OpsNotes: the very
 * objects, so that ./NoteWrite and a layout know them again).
 */
function copy(op) {
  if (op && typeof op.op === 'string' && Object.hasOwn(BY_REF, op.op))
    return copyNoteOp(op);
  if (op && op.op === 'setDocPart')
    return keep(op, {op: 'setDocPart', key: op.key, value: op.value});
  if (op && op.op === 'setStory') {
    const o = {op: 'setStory', part: clone(op.part), story: op.story};
    if (op.at !== undefined) o.at = clone(op.at);
    return o;
  }
  if (op && op.op === 'compound' && Array.isArray(op.ops))
    return keep(op, {op: 'compound', ops: op.ops.map(copy)});
  if (op && op.op === 'restoreBlock' && op.snapshot &&
    op.snapshot.type === 'tbl')
    return keep(op, {op: 'restoreBlock', block: clone(op.block),
      snapshot: op.snapshot});
  return clone(op);
}

/** A notes op copied: its own fields only, the by-reference ones
 *  kept (see copy); a setNote's patch a new object holding the
 *  very values. */
function copyNoteOp(op) {
  const [ref, own] = BY_REF[op.op];
  const o = {op: op.op};
  for (const k of [...ref, ...own, 'story']) {
    if (!Object.hasOwn(op, k)) continue;
    const v = op[k];
    if (ref.includes(k)) o[k] = v;
    else if (k === 'patch' && v !== null && typeof v === 'object' &&
      !Array.isArray(v)) o[k] = {...v};
    else o[k] = clone(v);
  }
  return o;
}

/** o with op's story, when op has one (so that it is checked). */
const keep = (op, o) => (op.story === undefined ? o
  : {...o, story: clone(op.story)});

/**
 * apply() without the copy: `op` and everything in it may become
 * part of doc, so it must be an op nobody will change, such as an
 * inverse returned by apply() or applyOwn(). Every op that did not
 * throw moves doc's ./DocVersion on (memos of the body read it).
 */
export function applyOwn(doc, op) {
  const kind = op && typeof op.op === 'string' &&
    Object.hasOwn(KINDS, op.op) ? KINDS[op.op] : null;
  if (!kind) fail('unknown op ' + (op && op.op));
  if (op.op !== 'setStory' && opStory(op) !== undefined &&
    BODY_ONLY.has(op.op))
    fail(op.op + ' takes no story');
  const inv = kind(doc, op);
  bump(doc);
  return inv;
}
