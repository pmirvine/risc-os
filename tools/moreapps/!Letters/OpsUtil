// OpsUtil - finding blocks for the operations in Ops (./OpsPath,
// re-exported here), the id rule for blocks put in, and cutting and
// joining paragraph content.
//
// Ops never change a model object in place (see Ops): cut and join
// reuse run objects whose offsets do not change, and always reuse
// rPr objects and Inline objects.
import {fail, normRuns, checkPos} from './ModelCheck';
import {blockIds, forEachId} from './Walk';

export {sectionAt, locate, own, paraAt, inStory, tailOf}
  from './OpsPath';

/**
 * Throw unless no 'p' / 'tbl' id inside the blocks `add` (at every
 * depth) is used twice among them, or in doc outside the blocks
 * `old` (the blocks they replace). One scan of doc (./Walk).
 */
export function checkIds(doc, add, old = []) {
  const mine = blockIds(add);
  if (!mine.length) return;
  const want = new Set();
  for (const id of mine) {
    if (want.has(id)) fail('id ' + id + ' is already in use');
    want.add(id);
  }
  const gone = new Set(blockIds(old));
  forEachId(doc, (id) => {
    if (want.has(id) && !gone.has(id))
      fail('id ' + id + ' is already in use');
  });
}

/**
 * The content of p in [a, b), shifted to start at 0:
 * {text, runs, inlines}. a and b must already be checked.
 */
export function cut(p, a, b) {
  const runs = [];
  for (const r of p.runs) {
    const s = Math.max(r.start, a);
    const e = Math.min(r.end, b);
    if (e <= s) continue;
    if (s - a === r.start && e - a === r.end) runs.push(r);
    else runs.push({...r, start: s - a, end: e - a});
  }
  const inlines = {};
  for (const k of Object.keys(p.inlines)) {
    const n = Number(k);
    if (n >= a && n < b) inlines[n - a] = p.inlines[k];
  }
  return {text: p.text.slice(a, b), runs, inlines};
}

/** Join pieces made by cut(): {text, runs (normalised), inlines}. */
export function join(...parts) {
  let text = '';
  const runs = [];
  const inlines = {};
  for (const x of parts) {
    const d = text.length;
    for (const r of x.runs) {
      runs.push(d ? {...r, start: r.start + d, end: r.end + d} : r);
    }
    for (const k of Object.keys(x.inlines)) {
      inlines[Number(k) + d] = x.inlines[k];
    }
    text += x.text;
  }
  return {text, runs: normRuns(runs), inlines};
}

/** Check a {start, end} range of p's text. */
export function checkRange(p, range) {
  if (range === null || typeof range !== 'object') fail('bad range');
  checkPos(p.text, range.start, 'range start');
  checkPos(p.text, range.end, 'range end');
  if (range.end < range.start) fail('range ends before it starts');
}
