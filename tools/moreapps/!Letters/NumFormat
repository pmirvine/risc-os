// NumFormat - Word's number formats for list labels.
//
//   formatNumber(n, numFmt) -> string
//     decimal       1 2 3 ... (negative numbers too)
//     decimalZero   01 02 ... 09 10 11
//     lowerLetter / upperLetter  a..z, then Word repeats the letter:
//                   27 = aa, 28 = bb, 52 = zz, 53 = aaa (at most
//                   LABEL_CAP letters); below 1: decimal
//     lowerRoman / upperRoman    1..3999; anything else: decimal
//     ordinal       1st 2nd 3rd 4th 11th 12th 13th 21st ...
//     bullet, none  '' (no number)
//     anything else (unknown, missing): decimal
//   n must be a safe integer; anything else is taken as 0.
//   fmtOf(numFmt)   the format used: the name when known, else
//                   'decimal'
//   LABEL_CAP       labels are cut to 40 UTF-16 units: capLabel(s)
//                   (never half a surrogate pair)
// No number is ever made larger than it is: 2^31 is '2147483648'.

export const LABEL_CAP = 40;

const KNOWN = new Set(['decimal', 'decimalZero', 'lowerLetter',
  'upperLetter', 'lowerRoman', 'upperRoman', 'ordinal', 'bullet',
  'none']);

/** The format a numFmt value gives: known name, else 'decimal'. */
export function fmtOf(numFmt) {
  return typeof numFmt === 'string' && KNOWN.has(numFmt) ? numFmt
    : 'decimal';
}

/** s cut to LABEL_CAP units, never ending in half a pair. */
export function capLabel(s) {
  if (s.length <= LABEL_CAP) return s;
  const t = s.slice(0, LABEL_CAP);
  const c = t.charCodeAt(LABEL_CAP - 1);
  return c >= 0xD800 && c <= 0xDBFF ? t.slice(0, -1) : t;
}

function letters(n, base) {
  if (n < 1) return String(n);
  const ch = String.fromCharCode(base + (n - 1) % 26);
  const times = Math.floor((n - 1) / 26) + 1;
  return ch.repeat(Math.min(times, LABEL_CAP));
}

const ROMAN = [[1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
  [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'],
  [5, 'V'], [4, 'IV'], [1, 'I']];

function roman(n) {
  if (n < 1 || n > 3999) return String(n);
  let s = '';
  for (const [v, r] of ROMAN) {
    while (n >= v) {
      s += r;
      n -= v;
    }
  }
  return s;
}

function ordinal(n) {
  if (n < 0) return String(n);
  const h = n % 100;
  if (h >= 11 && h <= 13) return n + 'th';
  const t = n % 10;
  return n + (t === 1 ? 'st' : t === 2 ? 'nd' : t === 3 ? 'rd'
    : 'th');
}

/** The text of number n in format numFmt (see above). */
export function formatNumber(n, numFmt) {
  if (!Number.isSafeInteger(n)) n = 0;
  switch (fmtOf(numFmt)) {
  case 'decimalZero':
    return n >= 0 && n < 10 ? '0' + n : String(n);
  case 'lowerLetter': return letters(n, 97);
  case 'upperLetter': return letters(n, 65);
  case 'lowerRoman': return roman(n).toLowerCase();
  case 'upperRoman': return roman(n);
  case 'ordinal': return ordinal(n);
  case 'bullet':
  case 'none':
    return '';
  default: return String(n);
  }
}
