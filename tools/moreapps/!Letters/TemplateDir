// TemplateDir - the user's Templates folder (no desktop services:
// the filing system is passed in, as `vfs` from 'riscos').
//
//   templatesDir() -> 'Choices:LettersTemplates'   the folder. NOT
//                  'Choices:Letters.Templates': Choices:Letters is
//                  the choices FILE (./WordChoices), and a file and a
//                  folder cannot have one name, so that folder could
//                  never be made once any choice was kept
//   ensureDir(vfs) -> {ok: true} | {error: message}   made on first
//                  use (a folder already there is fine); a failure
//                  is returned, never thrown
//   list(vfs) -> [{leaf, path}]   the files of the template type
//                  (./Open TEMPLATE_TYPE) in the folder, sorted by
//                  leaf (case ignored), the first 200; a folder that
//                  is missing or cannot be read: []. The array's
//                  (non-enumerable) `more` is how many were left out
//                  by the cap (0 when none)
import {TEMPLATE_TYPE} from './Open';

const DIR = 'Choices:LettersTemplates';
const MAX = 200;

/** See the header. */
export function templatesDir() { return DIR; }

/** See the header. */
export function ensureDir(vfs) {
  try {
    vfs.mkdir(DIR, {parents: true});
    return {ok: true};
  } catch (e) {
    return {error: e && e.message ? e.message : String(e)};
  }
}

/** See the header. */
export function list(vfs) {
  let items;
  try {
    items = vfs.list(DIR);
  } catch (e) {
    return [];
  }
  if (!Array.isArray(items)) return [];
  const low = (s) => s.toLowerCase();
  const all = items
    .filter((i) => i && i.type !== 'dir' && typeof i.name === 'string'
      && i.filetype === TEMPLATE_TYPE)
    .map((i) => ({leaf: i.name, path: i.path || `${DIR}.${i.name}`}))
    .sort((a, b) => (low(a.leaf) < low(b.leaf) ? -1
      : low(a.leaf) > low(b.leaf) ? 1 : 0));
  const out = all.slice(0, MAX);
  Object.defineProperty(out, 'more',
    {value: all.length - out.length});
  return out;
}
