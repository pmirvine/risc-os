// BorderBox - the Borders and shading dialogue box (Format > Borders
// and shading...), as Word's: Setting (None, Box, All, Custom), the
// sides (Top, Bottom, Left, Right, Between, Inside horizontal, Inside
// vertical: option icons), Style (Single, Double, Dotted, Dashed,
// Thick), Width (1/4 to 3 pt), Colour (WimpLib Ui/ColourPopup:
// Automatic allowed), Fill (None or Colour, with its colour button)
// and Apply to (Paragraph, Text, Cell or Table). Built by WimpLib
// Ui/Dialog; the values and what OK does: ./BorderPatch (Paragraph,
// Text) and ./TblBorderPatch (Cell, Table: Batch C5.2, D31).
//
//   borderBox(dw, {target}?) -> the box's api (WimpLib Ui/Dialog),
//       opened one box per document (key 'borders:<docKey>'), kept
//       in dw.boxes ('borders') so ./CloseDoc deletes it with the
//       document; asked again while it is open, the same box is
//       brought to the front. Nothing when the document has no
//       selection. target: a ./StyleTarget of adapter (the Modify
//       Style box's Borders...): the box works on it instead of
//       dw.view (key 'borders-style:<docKey>', dw.boxes
//       'borders-style'): it shows the style's borders and shading,
//       Apply to is Paragraph only, its OK changes the style box's
//       pending patch, not the document; it opens whatever the
//       selection, and is stale when the style or the styles change
//
// It opens filled from the document's query (./BorderPatch fill): a
// mixed value is empty (an option off, a popup blank) and left as it
// is unless changed. Picking None, Box or All sets the sides;
// clicking a side makes the setting what the sides now are (Custom
// unless they are none, a box or all). Fill Colour shows Word's
// light grey (D9D9D9) until a colour is picked; Fill None shades the
// colour button. Apply to Text shades the borders (text gets shading
// only: rPr w:shd over the selected characters) and shows the text's
// shading; Paragraph the paragraphs'. Cell and Table are offered
// (not shaded) when the selection is in a table (./TblCmd rectOf:
// the caret's cell or the selected cells), and Cell is then what the
// box opens with, as Word's: Cell shows and sets the selected cells'
// sides (Top, Bottom, Left, Right their outer edges, Inside
// horizontal and Inside vertical the lines between them) and their
// shading; Table the table's own borders and shading. Between is
// shaded for them, the inside sides and All for Paragraph and Text.
// Changing Apply to between those kinds fills the box again from
// what it now applies to. OK (or Return): one command, one undo step
// (none when nothing changed): view.format('borders' or 'charShade',
// ...) for Paragraph and Text, ./TblCmdCols bordersCmd for Cell and
// Table (the selection stays).
// Beeps, the box kept and nothing written: a value the box does not
// offer, Style, Width or Colour changed for a mixed selection with
// no side chosen (nothing to draw them on), a paragraph, run, cell
// or table whose own borders or shading are kept raw and would
// change (a themed border: the command refuses it,
// ./BorderExplicit), and a selection or document that changed while
// the box was open (the box is filled again); a line under the
// options says why. Cancel, Escape and the
// close icon change nothing; the caret goes back to the document.
import {wimp} from 'riscos';
import {dialog} from 'wimplib/Ui/Dialog';
import {box} from './Boxes';
import {fill, patch, settingOf, sidesOf, STYLES, WIDTHS, SIDES5}
  from './BorderPatch';
import * as T from './TblBorderPatch';
import {rectOf} from './TblCmd';
import {bordersCmd} from './TblCmdCols';
import {gridOf} from './TblGrid';
import {at as walkAt} from './Walk';

const radio = (group, value, text, label) => ({kind: 'radio',
  name: group + '-' + value, group, value, text, label});
const FILLS = [{id: 'none', text: 'None'},
  {id: 'colour', text: 'Colour'}];
const rows = () => [
  [radio('setting', 'none', 'None', 'Setting'),
    radio('setting', 'box', 'Box'), radio('setting', 'all', 'All'),
    radio('setting', 'custom', 'Custom')],
  SIDES5.map((k, i) => ({kind: 'option', name: k,
    text: k.charAt(0).toUpperCase() + k.slice(1),
    label: i ? undefined : 'Borders'})),
  [{kind: 'option', name: 'insideH', text: 'Inside horizontal'},
    {kind: 'option', name: 'insideV', text: 'Inside vertical'}],
  [{kind: 'popup', name: 'style', label: 'Style', choices: STYLES},
    {kind: 'popup', name: 'width', label: 'Width', choices: WIDTHS}],
  {kind: 'colour', name: 'colour', label: 'Colour', allowAuto: true},
  [{kind: 'popup', name: 'fillkind', label: 'Fill', choices: FILLS},
    {kind: 'colour', name: 'fill', label: 'Fill colour',
      allowAuto: false}],
  [radio('apply', 'para', 'Paragraph', 'Apply to'),
    radio('apply', 'text', 'Text'), radio('apply', 'cell', 'Cell'),
    radio('apply', 'table', 'Table')],
  {kind: 'label', name: 'msg', text: '', w: 560},
];
const MSG = {
  sides: 'Choose the sides first: Style, Width and Colour go on them.',
  raw: 'Lines or shading here are themed in the file: kept as they ' +
    'are.',
  refused: 'These lines cannot be put there (a width or spacing ' +
    'out of range).',
  changed: 'The selection or the document changed: the box shows ' +
    'the new values; look, then click OK.',
  bad: 'Choose one of the values the box offers.',
};

const HELP = 'Borders and shading: lines round the selected ' +
  'paragraphs or table cells, and a colour behind them or behind ' +
  'the text.';
const INSIDE = ['insideH', 'insideV'];
const BORDER = ['setting-none', 'setting-box', 'setting-all',
  'setting-custom', ...SIDES5, ...INSIDE, 'style', 'width', 'colour'];
const VALUES = ['setting', ...SIDES5, ...INSIDE, 'style', 'width',
  'colour', 'fillkind', 'fill', 'apply'];
const isTbl = (a) => a === 'cell' || a === 'table';

const state = new WeakMap();    // api -> {q, tq, apply, at, doc,
                                //   style}
const wired = new WeakSet();

/** Where the document and its selection are (stale check). */
const where = (v) => JSON.stringify([v.sel.anchor, v.sel.head,
  v.d.stateId]);

/** See the header. */
export function borderBox(dw, {target} = {}) {
  const v = target || dw.view;
  if (!v.sel) return null;
  const k = target ? 'borders-style' : 'borders';
  const api = dialog({task: dw.app.task, key: `${k}:${dw.docKey}`,
    title: 'Borders and shading', rows: rows(), help: HELP,
    buttons: ['Cancel', 'OK']});
  box(dw, k, () => api.win);
  if (api.isOpen) return api;
  if (!wired.has(api)) wire(api, v);
  refill(api, v);
  api.open();
  return api;
}

/** The selection's table cells: {shape, table, g, eff} or null. */
function tableQ(v) {
  const x = rectOf(v.d.doc, v.sel);
  if (!x) return null;
  const t = walkAt(v.d.doc, x.at);
  return {shape: x, table: t, g: gridOf(t), eff: T.effOf(v.L, t)};
}

/** The values for apply (see the header). */
const valuesOf = (q, tq, apply) => (isTbl(apply)
  ? T.fill(tq.shape, tq.table, tq.g, apply, tq.eff)
  : {...fill(q, apply), insideH: false, insideV: false});

/** Fill the box from the current query (Apply to kept if it can). */
function refill(api, v) {
  const q = v.query(), tq = tableQ(v), was = api.get('apply');
  const apply = !state.has(api) ? (tq ? 'cell' : 'para')
    : isTbl(was) && !tq ? 'para' : was;
  const vals = valuesOf(q, tq, apply);
  for (const k of VALUES) api.set(k, vals[k]);
  state.set(api, {q, tq, apply, at: where(v), doc: v.d.doc,
    style: v.isStyle === true});
  api.set('msg', '');
  adapt(api);
}

/** Shade what the Apply to does not use, the fill colour for None. */
function adapt(api) {
  const a = api.get('apply'), tbl = isTbl(a), x = state.get(api);
  for (const k of BORDER) api.shade(k, a === 'text');
  for (const k of ['setting-all', ...INSIDE]) api.shade(k, !tbl);
  api.shade('between', a === 'text' || tbl);
  for (const k of ['apply-cell', 'apply-table']) {
    api.shade(k, !(x && x.tq));
  }
  if (x && x.style) api.shade('apply-text', true);
  api.shade('fill', api.get('fillkind') !== 'colour');
}

/** The sides of apply's kind, and its settingOf / sidesOf. */
const kind = (a) => (isTbl(a) ? {sides: T.SIDES6, settingOf:
  T.settingOf, sidesOf: T.sidesOf} : {sides: SIDES5, settingOf,
  sidesOf});

/** The handlers of a new box. */
function wire(api, v) {
  wired.add(api);
  const no = (key) => {
    wimp.beep();
    api.set('msg', MSG[key] || MSG.bad);
    return false;
  };
  api.on('change', ({name, value}) => {
    const x = state.get(api), K = kind(api.get('apply'));
    if (name === 'setting') {
      const s = K.sidesOf(value);
      if (s) for (const k of K.sides) api.set(k, s[k]);
    } else if (SIDES5.includes(name) || INSIDE.includes(name)) {
      const o = {};
      for (const k of K.sides) o[k] = api.get(k);
      api.set('setting', K.settingOf(o));
    } else if (name === 'fill') {
      api.set('fillkind', 'colour');
    } else if (name === 'fillkind' && value === 'colour' &&
      api.get('fill') === undefined) {
      api.set('fill', 'D9D9D9');
    } else if (name === 'apply' && x) {
      const f = valuesOf(x.q, x.tq, value);
      const keys = isTbl(value) || isTbl(x.apply) ? VALUES
        : ['fillkind', 'fill'];
      for (const k of keys) api.set(k, f[k]);
    }
    if (x) x.apply = api.get('apply');
    adapt(api);
  });
  api.on('button', ({name, values}) => {
    if (name !== 'OK') { v.focus(); return undefined; }
    const x = state.get(api);
    if (!v.sel || where(v) !== x.at || v.d.doc !== x.doc) {
      if (v.sel) refill(api, v);
      return no('changed');
    }
    if (isTbl(values.apply)) return tableOK(no, v, values, x.tq);
    const r = patch(values, x.q);
    if (r.bad.length) return no(r.bad.includes('sides') ? 'sides' : '');
    if (r.arg !== undefined && !v.format(r.id, r.arg)) return no('raw');
    v.focus();
    return undefined;
  });
}

/** OK for Cell or Table (see the header). */
function tableOK(no, v, values, tq) {
  const r = tq ? T.patch(values, tq) : {bad: ['apply']};
  let out = null;
  try {
    if (!r.bad && (r.cells || r.tblPr)) {
      out = v.typing.command(() => bordersCmd(v.d, v.sel, r));
      if (!out) r.bad = ['refused'];
    }
  } catch (e) {
    if (!(e instanceof RangeError)) throw e;
    r.bad = ['refused'];
  }
  if (r.bad) {
    return no(['sides', 'raw', 'refused'].find((k) =>
      r.bad.includes(k)));
  }
  if (out) v.edited(out);
  v.focus();
  return undefined;
}
