// StyleDoc - a style-table change applied to a Document, with what
// uses the styles (Batch E1). d is the real ./Document. Each command
// is one typing.command (typing may be null) holding one d.atomic:
// one undo step. Pure: no desktop services.
//
//   usedBy(doc, id) -> {paragraphs, runs}  how many paragraphs have
//       pStyle id and how many runs have rStyle id, in the body,
//       its tables' cells, and every story (headers, footers)
//   usedAll(doc) -> Map<id, number>  paragraphs plus runs using each
//       style id, from ONE walk of the document (for lists)
//   run(d, typing, change) -> result | null  change(doc.styles) is a
//       ./StyleCmd command's result {table, ...} or null (no change:
//       null back, no undo step); else the table is set
//       (setDocPart styles) and the result returned. result.ops, when
//       given: more setDocPart ops run first in the same atomic (the
//       numbering part of a list a style starts: ./StyleTarget)
//   remove(d, typing, id) -> boolean  ./StyleCmd deleteStyle, and
//       every pStyle / rStyle equal to id removed (the default style
//       then applies; one setProps per paragraph, and per run range
//       for rStyle) in every story, in the same atomic. false (no
//       step) when deleteStyle refuses
import {blocks, walkBlocks} from './Walk';
import {deleteStyle} from './StyleCmd';

/** Every paragraph of the document as {p, at, story}: the body's,
 *  then each story's (paths [0, i, ...], op.story the part). */
function* paras(doc) {
  for (const e of blocks(doc)) {
    if (e.b.type === 'p') yield {p: e.b, at: e.at, story: undefined};
  }
  const m = doc.stories instanceof Map ? doc.stories : new Map();
  for (const [part, st] of m) {
    if (!st || !Array.isArray(st.blocks)) continue;
    for (const e of walkBlocks(st.blocks, [0])) {
      if (e.b.type === 'p') yield {p: e.b, at: e.at, story: part};
    }
  }
}

/** Ranges [start, end) of the runs of p with rStyle id (adjacent
 *  ones joined). */
function runRanges(p, id) {
  const out = [];
  for (const r of p.runs || []) {
    if (r.rStyle !== id) continue;
    const last = out[out.length - 1];
    if (last && last.end === r.start) last.end = r.end;
    else out.push({start: r.start, end: r.end});
  }
  return out;
}

/** See the header. */
export function usedBy(doc, id) {
  let paragraphs = 0, runs = 0;
  for (const {p} of paras(doc)) {
    if (p.pStyle === id) paragraphs++;
    for (const r of p.runs || []) if (r.rStyle === id) runs++;
  }
  return {paragraphs, runs};
}

/** See the header. */
export function usedAll(doc) {
  const m = new Map();
  const bump = (id) => {
    if (typeof id === 'string') m.set(id, (m.get(id) || 0) + 1);
  };
  for (const {p} of paras(doc)) {
    bump(p.pStyle);
    for (const r of p.runs || []) bump(r.rStyle);
  }
  return m;
}

/** See the header. */
export function run(d, typing, change) {
  const r = change(d.doc.styles);
  if (!r) return null;
  const go = () => d.atomic(() => {
    for (const op of r.ops || []) d.apply(op);
    d.apply({op: 'setDocPart', key: 'styles', value: r.table});
  });
  if (typing) typing.command(go);
  else go();
  return r;
}

/** See the header. */
export function remove(d, typing, id) {
  const table = deleteStyle(d.doc.styles, id);
  if (!table) return false;
  const todo = [];
  for (const {p, at, story} of paras(d.doc)) {
    const base = story === undefined ? {op: 'setProps', block: at}
      : {op: 'setProps', block: at, story};
    if (p.pStyle === id) todo.push({...base, pStyle: null});
    for (const range of runRanges(p, id))
      todo.push({...base, rStyle: null, range});
  }
  const go = () => d.atomic(() => {
    d.apply({op: 'setDocPart', key: 'styles', value: table});
    for (const op of todo) d.apply(op);
  });
  if (typing) typing.command(go);
  else go();
  return true;
}
