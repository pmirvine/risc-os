// PrintFrags - a page's fragments as Print layout places and paints
// them (./PlacePrint pageFrags, split from it).
//
//   fragsOf(L, pg) -> [{it, l0, l1, dx, dy, head, tail, clip, first,
//       last, col}] page pg's fragments, frame by frame (col: the
//       frame's index, a column's, D23), from the page's own origin
//       (D36: paintPage): dx, dy whole px; head: the fragment holds the
//       item's top (its "page break before" rule goes with it; not
//       the rest of a cut line, block or table row), tail: its end
//       (its section break band goes with it); clip {y0, y1} the
//       frame, for a cut item's part or a table's rows (./PageRows),
//       else null; first / last: the frame's first / last fragment
//       (a border box cut there is closed: ./BorderGroups
//       closedMark, PG38). A table's also has its rows on the page,
//       r0, r1, from?, cuts?, heads? (./PageFrames, ./TblPieces); a
//       floating table placed on the page (P12.6, R5) float: true,
//       dx, dy to its Float's x, y (pg.floats, ./AnchorPlace: its
//       left edge as drawn, it.x + it.left, at x), clip null
//
// Pure: no desktop services.
const NONE = Object.freeze([]);
/** The placed floating table id of page pg (./AnchorPlace). */
const floatOf = (pg, id) => (pg.floats || NONE).find((x) =>
  x.tbl === id) || null;
const ROWS = ['r0', 'r1', 'from', 'cuts', 'heads'];

/** See the header. */
export function fragsOf(L, pg) {
  const out = [];
  (pg.frames || NONE).forEach((fr, col) => {
    const {start, end} = fr, n = fr.frags.length;
    fr.frags.forEach((f, j) => {
      const k = start.k + j;
      let it = L.items[k];
      if (!it || it.id !== f.id) it = L.byId.get(f.id);
      if (!it) return;
      const head = !(j === 0 && (start.line > 0 || start.dy > 0 ||
        !!start.cuts));
      const tail = !(j === n - 1 && end.k === k);
      const cut = (j === 0 && start.dy > 0) || (!tail && end.dy > 0)
        || f.r0 !== undefined;     // (a table's rows: P4.1, P4.2)
      const F = f.float ? floatOf(pg, f.id) : null;
      const o = {it, l0: f.l0, l1: f.l1,
        dx: Math.round(F ? F.x - it.left - it.x : f.x - it.x),
        dy: Math.round((F ? F.y : f.y) - it.y), head,
        tail, clip: cut && !F ? Object.freeze({y0: fr.y,
          y1: fr.y + fr.h}) : null, first: j === 0, last: j === n - 1,
        col};
      if (F) o.float = true;
      if (f.r0 !== undefined) {
        for (const x of ROWS) if (f[x] !== undefined) o[x] = f[x];
      }
      out.push(Object.freeze(o));
    });
  });
  return Object.freeze(out);
}
