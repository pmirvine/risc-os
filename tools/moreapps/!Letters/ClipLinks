// ClipLinks - the URL of a hyperlink, for the HTML other programs get
// from a copy (./ClipHtml's urlOf):
//
//   linkUrl(doc) -> urlOf(inline) -> 'https://...' | null
//
// inline: a raw inline whose node is a w:hyperlink (any prefix) with
// a relationship id (an attribute named <prefix>:id, the prefix not
// w); doc.rels must hold that relationship, of the hyperlink type,
// external (TargetMode External), its target an http, https or
// mailto URL with no spaces or control characters (./ClipHtmlRun
// safeUrl). Anything else (a link to a place in the document, a
// javascript: or file target, no such relationship): null, so the
// link is copied as its text. Nothing is fetched or opened. Pure: no
// desktop services.
import {safeUrl} from './ClipHtmlRun';

const local = (n) => String(n).slice(String(n).indexOf(':') + 1);
const LINK = /\/relationships\/hyperlink$/;

/** The relationship id of hyperlink node n, or null. */
function relId(n) {
  if (!n || local(n.name) !== 'hyperlink' || !Array.isArray(n.attrs))
    return null;
  for (const [k, v] of n.attrs) {
    const s = String(k), i = s.indexOf(':');
    if (i > 0 && s.slice(0, i) !== 'w' && s.slice(i + 1) === 'id')
      return String(v);
  }
  return null;
}

/** See the header. */
export function linkUrl(doc) {
  let map = null;
  const rels = doc && Array.isArray(doc.rels) ? doc.rels : [];
  return (x) => {
    if (!x || x.kind !== 'raw') return null;
    const id = relId(x.node);
    if (id === null) return null;
    if (!map) {
      map = new Map();
      for (const r of rels) if (r && !map.has(r.id)) map.set(r.id, r);
    }
    const r = map.get(id);
    if (!r || r.mode !== 'External' || !LINK.test(String(r.type)))
      return null;
    return safeUrl(r.target);
  };
}
