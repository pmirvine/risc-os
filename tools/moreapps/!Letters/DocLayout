// DocLayout - the whole document laid out as columns of items (the
// root one the width of the text on its page): paragraphs and kept
// blocks stacked, and positions ({id, off}, ./DocPos) <-> places in
// the work area.
//
//   const L = new DocLayout(doc, metrics, prev?, {top, decorators,
//              pics, fields, colW, floats, wrap}?)
//              metrics: WimpLib/TextMetrics; prev: an older layout
//              of doc whose lines may be kept (./DocItems); the
//              options (L.top, L.decorators, L.pics, L.fields,
//              L.colW, L.floats, L.wrap): ./LayoutOpts optsOf.
//              L.anchored: ./DocItems. L.fieldText(p,
//              off) is ./FieldShow fieldText on L (./LineTokens),
//              L.fshown its record
//   L.layout(viewWidth) -> {w, h}: the work area's extent (the
//             widest section's page, or as far as the widest root
//             item or table: L.wide, D18)
//   L.items  [{id, block, kind: 'p'|'box'|'tbl', index, x, w, col,
//             ci, s, y, h, gapAbove, gapBelow, marks, lines?, list?,
//             mark?, label?}] (./DocItems) in document order: the
//             root column's; a 'p' item is also the pl ({para, y, h,
//             lines, metrics}) of ./PositionMap; a 'tbl' item holds
//             its rows and cell columns (./TblItems, ./TblLayout)
//   L.root   the root column {x, w, items, styles} (x: L.left, w:
//             L.textW, items: L.items); L.flow  every caret-holding
//             item in flow order, cells' items too, a table's item at
//             its start and again at its end (index, endIndex: D9,
//             ./DocItems; L.items itself without a table). Items are
//             placed by their x and w.
//   L.labels  Map paraId -> list Label (./ListNumbers), once per
//             layout object; L.byId  Map id -> item, every depth
//   L.cacheFor(styles)      -> the run-format cache (./Fmt) for a
//                              style table: L.cache for doc.styles,
//                              one more Map per derived one (R6)
//   L.stackColumn(col, y0)  -> ./DocStack stackColumn(L, col, y0)
//   L.left, L.textW, L.pageLeft, L.pageW: the column (px); L.top
//   L.pageWide, L.textWide  the widest section's page and first
//             column (px; L.pageW, L.textW at least): the white page
//             (./EditPaint pageRect) and the extent reach them
//   L.geom(s)  -> section s's geometry in px (./SectGeom pxOf of
//             geomOf, settings gutterAtTop: ./SettingsRead;
//             ./LayoutGeom), one object per section object for
//             this layout; null for
//             no section s. A root item is as wide as its section's
//             first column (it.w, it.s: ./DocItems)
//   L.web    Web layout's text width (px: ./WebLayout, D31): every
//             section as one column that wide, no pages; L.stale the
//             paragraphs waiting at the old width (OD8: ./WebLayout
//             carry and stepWeb), L.lazy opts' band of the rest
//   L.outline  Outline view's collapse set (./OutlineLayout, D32), or
//             null: L.ol its rows; root items indented (dx), with a
//             level and marker; children of collapsed headings get
//             no item (L.items, L.flow, L.byId leave them out)
//   L.ns     the scope raw inlines are read in (./PicRead docMap)
//   L.pageH  the page's height (px); L.height  the extent's (layout)
//   L.place  the view's placement (./Place, D4): every screen
//             position below is asked of it; a new layout's is
//             ./PlaceDraft (the identity), a view may set another
//   L.itemAtY(y)            -> the root column's item at y (./DocHit
//                              itemIn: clamped to the ends; a gap
//                              gives the item below it; where items
//                              overlap, the lower one from the top
//                              of its first line)
//   L.locate(pos)           -> {item, index, off} (off clamped; index
//                              the position's place in L.flow,
//                              ./DocPos placeOf), or null for an id
//                              not in the document
//   L.caretRect(pos, aff)   -> {x, y, h} in work-area coordinates
//                              (a table: ./DocHit)
//   L.hitTest(x, y)         -> {pos, affinity} (in a section break
//                              band, ./SectDeco: the end of the
//                              block above it; in the gap of a
//                              bottom border, ./BorderGroups: the
//                              paragraph above, its last line; in a
//                              table: in a cell, ./DocHit)
//   L.selectionRects(sel, y0?, y1?) -> [{x, y, w, h}] (./DocRects)
//   L.paraStart(pos), L.paraEnd(pos), L.docStart(), L.docEnd()
//   L.nextItem(item), L.prevItem(item) -> item or null (in L.flow,
//                              from the item's index)
//   L.boxRect(item)         -> {x, y, w, h} of a kept block's box
//                              (a table's: the table)
//   L.invalidate()          lay all the lines out (and ask the
//                           decorators) again on next layout
//                           (L.dirtyFrom 0: no page kept)
//   L.dirtyFrom, L.cleanFrom  what changed since prev (./DocItems;
//                           ./Pages reuse, D7)
//
// The page geometry (L.geom(0): text width, margin and page size
// from the first section, the page centred, a whole page high at
// least), kept blocks and hits outside the items:
// docs/apps/Letters.md, DocLayout. Pure: no desktop services.
import {buildItems, moveColumn, BOX} from './DocItems';
import {stack, stackColumn, MARGIN, PAGE_TOP} from './DocStack';
import {optsOf} from './LayoutOpts';
import {itemEnd, clampOff, placeOf} from './DocPos';
import {selectionRects} from './DocRects';
import {caretRect, boxRect, hitTest, itemIn} from './DocHit';
import {docMap} from './PicRead';
import {unlay} from './TblLayout';
import {geomOf, pxOf} from './SectGeom';
import {PlaceDraft} from './PlaceDraft';
import {fieldText} from './FieldShow';
import {carry} from './WebLayout';
import {geomInit, geomAt} from './LayoutGeom';

export {BOX, PAGE_TOP};               // (desk above and below a page)
const num = (v, d) => (Number.isFinite(v) ? v : d);

export class DocLayout {
  constructor(doc, metrics, prev, opts = {}) {
    this.doc = doc;
    this.ns = docMap(doc);             // pictures (./PicRead)
    optsOf(this, prev, opts);
    this.fshown = null;                // (./FieldShow)
    this.fieldText = (p, off) => fieldText(this, p, off);
    this.metrics = metrics;
    this.place = PlaceDraft(this);     // (D4: a view may set another)
    this.cache = new Map();            // run formats (./Fmt)
    this.caches = null;                // per derived style table
    this.laid = false; this.width = 0; this.wide = 0;
    this.moved = false;
    this.stale = 0; this.webAt = 0;    // (Web layout: ./WebLayout)
    geomInit(this, prev);              // (gset, geoms: ./LayoutGeom)
    const g = this.geom(0) || pxOf(geomOf(null, this.gset));
    this.pageH = g.size.h;
    this.height = this.minHeight(2 * MARGIN + this.top);
    this.textW = g.textW;
    this.marL = g.mar.left;
    this.pageW = g.size.w;
    this.pageLeft = MARGIN; this.left = MARGIN + this.marL;
    buildItems(this, doc, prev);
    if (this.web) carry(this, prev, this.lazy);
    this.pageWide = this.pageW; this.textWide = this.textW;
    for (let s = 1; s < doc.sections.length; s++) {
      const gs = this.geom(s);         // (a wider later section)
      this.pageWide = Math.max(this.pageWide, gs.size.w);
      this.textWide = Math.max(this.textWide, gs.cols[0].w);
    }
  }

  /** See the header. */
  layout(viewWidth) {
    const vw = Math.max(0, num(+viewWidth, 0));
    this.width = vw;
    this.pageLeft = Math.max(MARGIN, (vw - this.pageW) / 2);
    this.left = this.pageLeft + this.marL;
    if (this.root.x !== this.left || this.moved) {
      moveColumn(this.root, this.left);  // (kept tables: ./TblReuse)
      this.moved = false;
    }
    if (!this.laid) this.stack();
    return this.place.extent();
  }

  /** See the header. */
  geom(s) { return geomAt(this, s); }

  /** Break every paragraph and stack the items (./DocStack). */
  stack() { stack(this); }

  /** See the header. */
  stackColumn(col, y0) { return stackColumn(this, col, y0); }

  /** See the header. */
  cacheFor(styles) {
    if (styles === this.doc.styles) return this.cache;
    if (!this.caches) this.caches = new Map();
    let m = this.caches.get(styles);
    if (!m) this.caches.set(styles, m = new Map());
    return m;
  }

  /** h, or a whole page below top if that is more. */
  minHeight(h) {
    return Math.max(h, this.top + 2 * PAGE_TOP + this.pageH);
  }

  invalidate() {
    // (byId: the items in cells; items: also any id twice; no
    // table: L.items holds them all)
    const lists = this.flow === this.items ? [this.items]
      : [this.items, this.byId.values()];
    for (const list of lists) {
      for (const it of list) {
        it.deco = null;
        if (it.kind === 'p') it.lines = null;
        if (it.kind === 'tbl') unlay(it);
      }
    }
    this.laid = false;
    this.dirtyFrom = 0;                // (pages: none kept)
    this.cleanFrom = Infinity;
  }

  itemAtY(y) { return itemIn(this.items, y); }

  locate(pos) {
    const it = pos && this.byId.get(pos.id);
    if (!it) return null;
    const off = clampOff(it, pos.off);
    return {item: it, index: placeOf(it, off), off};
  }

  // See the header (./DocHit has the code).
  caretRect(pos, aff = 'down') { return caretRect(this, pos, aff); }
  boxRect(it) { return boxRect(this, it); }
  hitTest(x, y) { return hitTest(this, x, y); }

  /** See the header (./DocRects). */
  selectionRects(sel, y0 = -Infinity, y1 = Infinity) {
    return selectionRects(this, sel, y0, y1);
  }

  paraStart(pos) { return {id: pos.id, off: 0}; }
  paraEnd(pos) {
    const it = this.byId.get(pos.id);
    return {id: pos.id, off: it ? itemEnd(it) : 0};
  }

  docStart() {
    return this.flow.length ? {id: this.flow[0].id, off: 0} : null;
  }

  docEnd() {
    const it = this.flow[this.flow.length - 1];
    return it ? {id: it.id, off: itemEnd(it)} : null;
  }

  nextItem(it) { return this.flow[it.index + 1] || null; }
  prevItem(it) { return this.flow[it.index - 1] || null; }
}
