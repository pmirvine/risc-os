// StylesBuiltin - the styles every new document gets.
//
// ensureBuiltins adds only what is missing; styles that exist (for
// instance from a loaded document) are never touched. `raw` is null:
// it holds the original XML node only for styles read from a file.
// builtinStyle(id, {strict}?) -> a new copy of built-in style `id`,
// or null (./ListMake adds List Paragraph to a document that lacks
// it). The table styles Normal Table (id TableNormal) and Table Grid
// (TableGrid, based on it) are Word's own definitions (Batch C4.4,
// D27; ./TblInsert adds them with Insert > Table): the w:tblPr in
// `extra`, the sides start / end for a Strict document (opts.strict),
// never part of ensureBuiltins. Header and Footer (Batch D P7.4,
// D14, PG15) are Word 2016's paragraph styles of those names (name
// 'header' / 'footer', based on Normal, uiPriority 99,
// unhideWhenUsed; tab stops centre 4513 and right 9026 twips, the
// middle and the right edge of A4's text; no space after, single
// lines): ./HdrCmd adds the one a new header or footer needs, never
// ensureBuiltins (Word's own link to a HeaderChar character style is
// not made: nothing here uses it). Heading 7, 8 and 9 (Batch D
// P13.3: Demote in Outline view, ./OutlineCmd, adds the one it needs)
// are made as Heading 4..6 are (11 pt bold, 10 pt before, outline
// levels 6..8), never part of ensureBuiltins: a new document's
// styles part stays as it was.
// Footnote Text / Footnote Reference and the Endnote pair are
// Word's own definitions (the text styles based on Normal, 10 pt,
// single spacing, linked to FootnoteTextChar / EndnoteTextChar;
// the reference styles superscript, semiHidden): latent, added by
// ./StyleCmd ensureBuiltin when the note code first needs one,
// never part of ensureBuiltins or galleryIds.
// The comment styles (Batch F1), latent the same way: CommentText
// ('annotation text', based on Normal, 10 pt, linked to
// CommentTextChar, uiPriority 99, semiHidden, unhideWhenUsed),
// CommentTextChar ('Comment Text Char', custom, 10 pt) and
// CommentReference ('annotation reference', 8 pt, semiHidden,
// unhideWhenUsed): Word's, as in the corpus (python-docx
// comments-rich-para.docx); ./CommentCmd adds them on first use.
// Table of contents styles (Batch E3), latent like the note ones:
// TOC1..TOC9 (name 'toc n', based on Normal, next Normal,
// autoRedefine, uiPriority 39, unhideWhenUsed, 5 pt after
// (spacing after 100), indent 220 twips per level below the
// first: Word 2013's TOC 1 and TOC 2 are in handoff 3-roundtrip-real
// .docx and open-xml-sdk Complex01.docx, TOC 3 (indent 440) in poi
// Bug54771a.docx; the indents of TOC 4..9 (660..1760) carry the
// same step on: to check in real Word), TOCHeading (name 'TOC
// Heading', based on Heading 1, next Normal, uiPriority 39,
// unhideWhenUsed, qFormat, outline level 9: Word 2013's, same
// files; Word also marks it semiHidden until used, left out here as
// the style is only added when used), Hyperlink (colour 0563C1,
// single underline, uiPriority 99: the same as ./DocParts
// hyperlinkStyle's), Caption (name 'caption', based on Normal, next
// Normal, uiPriority 35, unhideWhenUsed, qFormat, bold, 8 pt,
// colour 2E74B5 without the theme tint: Word 2013's, same files) and
// TableofFigures (name 'table of figures', based on Normal, next
// Normal, uiPriority 99, unhideWhenUsed, no space after: Word 2013's
// from memory, not in the corpus: to check in real Word). None is
// part of ensureBuiltins or galleryIds: ./StyleCmd ensureBuiltin
// adds one when a table of contents or a caption first needs it.
// galleryIds() -> the ids of the built-ins Word's gallery offers
// (the qFormat ones above: Normal, Title, List Paragraph, Heading 1
// to 6) for ./StyleList to list when a document lacks them
// (latent styles: ./StyleCmd ensureBuiltin adds one on first use).
import {W} from './Wml';
import {isBuiltinName} from './StyleName';

// Heading sizes are in half-points. List Paragraph has Word's
// contextualSpacing (no space between two list items).
const HEADS = [[1, 32, 240], [2, 26, 200], [3, 24, 200],
  [4, 22, 200], [5, 22, 200], [6, 22, 200]];

const style = (id, name, type, o = {}) => ({
  id, type, name, pPr: {extra: []}, rPr: {extra: []}, extra: [],
  raw: null, ...o,
});

function builtins() {
  const list = [
    style('Normal', 'Normal', 'paragraph', {isDefault: true,
      qFormat: true}),
    style('DefaultParagraphFont', 'Default Paragraph Font',
      'character', {isDefault: true, uiPriority: 1,
        semiHidden: true, unhideWhenUsed: true}),
    style('Title', 'Title', 'paragraph', {
      basedOn: 'Normal', next: 'Normal', uiPriority: 10,
      qFormat: true,
      pPr: {spacing: {after: 300}, extra: []},
      rPr: {sz: 56, szCs: 56, extra: []},
    }),
    style('ListParagraph', 'List Paragraph', 'paragraph', {
      basedOn: 'Normal', uiPriority: 34, qFormat: true,
      pPr: {ind: {left: 720}, contextualSpacing: true, extra: []},
    }),
  ];
  for (const [n, sz, before] of HEADS)
    list.push(heading(n, sz, before));
  return list;
}

/** Built-in style Heading n (n 1..9). */
function heading(n, sz, before) {
  return style('Heading' + n, 'heading ' + n, 'paragraph', {
    basedOn: 'Normal', next: 'Normal', uiPriority: 9, qFormat: true,
    pPr: {keepNext: true, keepLines: true, outlineLvl: n - 1,
      spacing: {before, after: 60}, extra: []},
    rPr: {b: true, sz, szCs: sz, extra: []},
  });
}

/** Add the missing built-in styles to `styles`; returns `styles`. */
export function ensureBuiltins(styles) {
  for (const s of builtins()) {
    if (!styles.styles.has(s.id)) styles.styles.set(s.id, s);
  }
  if (!styles.defaults.paragraph) styles.defaults.paragraph = 'Normal';
  if (!styles.defaults.character)
    styles.defaults.character = 'DefaultParagraphFont';
  return styles;
}

const dxa = (w) => ({'w:w': w, 'w:type': 'dxa'});
const SIDES = ['top', 'left', 'bottom', 'right'];

/** Word's w:tblPr of the table styles (see the header). */
function tblPrOf(id, strict) {
  const side = (n) => (!strict ? n : n === 'left' ? 'start'
    : n === 'right' ? 'end' : n);
  if (id === 'TableNormal') {
    return W('tblPr', null, W('tblInd', dxa(0)), W('tblCellMar', null,
      ...SIDES.map((n) => W(side(n), dxa(n === 'left' || n ===
        'right' ? 108 : 0)))));
  }
  const line = {'w:val': 'single', 'w:sz': 4, 'w:space': 0,
    'w:color': 'auto'};
  return W('tblPr', null, W('tblBorders', null, ...SIDES.concat(
    ['insideH', 'insideV']).map((n) => W(side(n), line))));
}

/** Word's footnote / endnote styles: `what` Text, Reference or
 *  TextChar of the family `fam` ('footnote' or 'endnote'). */
function noteStyle(id, fam, what) {
  const cap = fam[0].toUpperCase() + fam.slice(1);
  const sz = {sz: 20, szCs: 20, extra: []};
  if (what === 'Text') {
    return style(id, fam + ' text', 'paragraph', {basedOn: 'Normal',
      link: cap + 'TextChar', uiPriority: 99, unhideWhenUsed: true,
      pPr: {spacing: {after: 0, line: 240, lineRule: 'auto'},
        extra: []}, rPr: sz});
  }
  if (what === 'TextChar') {
    return style(id, cap + ' Text Char', 'character', {
      basedOn: 'DefaultParagraphFont', link: cap + 'Text',
      uiPriority: 99, custom: true, rPr: sz});
  }
  return style(id, fam + ' reference', 'character', {
    basedOn: 'DefaultParagraphFont', uiPriority: 99,
    semiHidden: true, unhideWhenUsed: true,
    rPr: {vertAlign: 'superscript', extra: []}});
}

/** Word's comment styles (see the header). */
function commentStyle(id) {
  const sz = (n) => ({sz: n, szCs: n, extra: []});
  if (id === 'CommentText') {
    return style(id, 'annotation text', 'paragraph', {
      basedOn: 'Normal', link: 'CommentTextChar', uiPriority: 99,
      semiHidden: true, unhideWhenUsed: true, rPr: sz(20)});
  }
  if (id === 'CommentTextChar') {
    return style(id, 'Comment Text Char', 'character', {
      basedOn: 'DefaultParagraphFont', link: 'CommentText',
      uiPriority: 99, semiHidden: true, custom: true, rPr: sz(20)});
  }
  return style(id, 'annotation reference', 'character', {
    basedOn: 'DefaultParagraphFont', uiPriority: 99,
    semiHidden: true, unhideWhenUsed: true, rPr: sz(16)});
}

/** Word's table of contents style TOC n (n 1..9). */
function tocStyle(n) {
  const pPr = {spacing: {after: 100}, extra: []};
  if (n > 1) pPr.ind = {left: 220 * (n - 1)};
  return style('TOC' + n, 'toc ' + n, 'paragraph', {basedOn: 'Normal',
    next: 'Normal', uiPriority: 39, unhideWhenUsed: true, pPr,
    extra: [W('autoRedefine')]});
}

/** The table of contents, caption and link styles (see above). */
function tocFamily(id) {
  const toc = /^TOC([1-9])$/.exec(id);
  if (toc) return tocStyle(+toc[1]);
  if (id === 'TOCHeading') {
    return style(id, 'TOC Heading', 'paragraph', {basedOn: 'Heading1',
      next: 'Normal', uiPriority: 39, unhideWhenUsed: true,
      qFormat: true, pPr: {outlineLvl: 9, extra: []}});
  }
  if (id === 'Hyperlink') {
    return style(id, 'Hyperlink', 'character', {
      basedOn: 'DefaultParagraphFont', uiPriority: 99,
      unhideWhenUsed: true,
      rPr: {color: '0563C1', u: 'single', extra: []}});
  }
  if (id === 'Caption') {
    return style(id, 'caption', 'paragraph', {basedOn: 'Normal',
      next: 'Normal', uiPriority: 35, unhideWhenUsed: true,
      qFormat: true, rPr: {b: true, color: '2E74B5', sz: 16,
        szCs: 16, extra: [W('bCs')]}});
  }
  if (id === 'TableofFigures') {
    return style(id, 'table of figures', 'paragraph', {
      basedOn: 'Normal', next: 'Normal', uiPriority: 99,
      unhideWhenUsed: true,
      pPr: {spacing: {after: 0}, extra: []}});
  }
  return null;
}

/** See the header. */
export function builtinStyle(id, {strict = false} = {}) {
  const tf = typeof id === 'string' ? tocFamily(id) : null;
  if (tf) return tf;
  if (id === 'TableNormal') {
    return style(id, 'Normal Table', 'table', {isDefault: true,
      uiPriority: 99, semiHidden: true, unhideWhenUsed: true,
      extra: [tblPrOf(id, strict)]});
  }
  if (id === 'TableGrid') {
    return style(id, 'Table Grid', 'table', {basedOn: 'TableNormal',
      uiPriority: 39, pPr: {spacing: {after: 0, line: 240,
        lineRule: 'auto'}, extra: []}, extra: [tblPrOf(id, strict)]});
  }
  if (id === 'Header' || id === 'Footer') {
    return style(id, id.toLowerCase(), 'paragraph', {basedOn: 'Normal',
      uiPriority: 99, unhideWhenUsed: true, pPr: {tabs: [{val: 'center',
        pos: 4513}, {val: 'right', pos: 9026}], spacing: {after: 0,
        line: 240, lineRule: 'auto'}, extra: []}});
  }
  const note = /^(Foot|End)note(Text|Reference|TextChar)$/.exec(id);
  if (note) return noteStyle(id, note[1].toLowerCase() + 'note',
    note[2]);
  if (/^Comment(Text|Reference|TextChar)$/.test(id))
    return commentStyle(id);
  const deep = /^Heading([7-9])$/.exec(id);
  if (deep) return heading(+deep[1], 22, 200);
  return builtins().find((s) => s.id === id) || null;
}

/** True when `id` is the id of one of the built-in styles above. */
export function isBuiltin(id) {
  return typeof id === 'string' && builtinStyle(id) !== null;
}

/** True when `style` (a table entry) is a built-in: its id is one
 *  of the above, or its stored name is a built-in's name (a document
 *  in another language gives Normal the id 'Standard'). */
export function isBuiltinStyle(style) {
  return !!style && (isBuiltin(style.id) || isBuiltinName(style.name));
}

/** Ids of the built-ins a gallery offers (see the header). */
export function galleryIds() {
  return builtins().filter((s) => s.qFormat).map((s) => s.id);
}
