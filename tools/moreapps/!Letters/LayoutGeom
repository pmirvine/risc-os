// LayoutGeom - a layout's section geometry (split from ./DocLayout,
// Batch D final fix A): L.geom(s) and what it is made under.
//
//   geomInit(L, prev?)  L.gset ({gutterAtTop: ./SettingsRead's, map:
//       L.ns, the scope}) and L.geoms (WeakMap section props object
//       -> px: geomOf reads a section's props and the first
//       section's), prev's when prev was made under the same rules
//       (gutterAtTop, scope, the first section's props, Web layout):
//       an edit replaces the props it changes, so a layout made after
//       it measures only those, not every one of 100,000 sections
//       again (final fix A F2-I1)
//   geomAt(L, s) -> px | null  section s's geometry (./SectGeom pxOf
//       of geomOf; Web layout's: ./WebLayout webGeom), null for no
//       section s
//   geomTwAt(L, s) -> twips | null  ./SectGeom geomOf's (./PageGalley
//       geomTw), memoised with L.geoms' rules (L.geomsTw)
//
// Pure: no desktop services.
import {geomOf, pxOf} from './SectGeom';
import {onOffOf} from './SettingsRead';
import {webGeom} from './WebLayout';

/** The memo key of section sec: its props (the section itself when
 *  it has none). */
const keyOf = (sec) => (sec.props && typeof sec.props === 'object'
  ? sec.props : sec);

/** See the header. */
export function geomInit(L, prev) {
  L.gset = {gutterAtTop: onOffOf(L.doc, 'gutterAtTop'), map: L.ns};
  const f = L.doc.sections[0];
  L.geomFirst = f ? keyOf(f) : null;
  const p = prev && prev.geoms instanceof WeakMap && prev.gset
    ? prev : null;
  const same = p && p.gset.gutterAtTop === L.gset.gutterAtTop &&
    p.ns === L.ns && p.web === L.web && p.geomFirst === L.geomFirst;
  L.geoms = same ? p.geoms : new WeakMap();
  L.geomsTw = same && p.geomsTw ? p.geomsTw : new WeakMap();
}

/** See the header. */
export function geomTwAt(L, s) {
  const secs = L.doc.sections, sec = secs[s];
  if (!Number.isInteger(s) || s < 0 || !sec) return null;
  const m = L.geomsTw || (L.geomsTw = new WeakMap());
  let g = m.get(keyOf(sec));
  if (!g) m.set(keyOf(sec), g = geomOf(sec, L.gset, secs[0]));
  return g;
}

/** See the header. */
export function geomAt(L, s) {
  const secs = L.doc.sections, sec = secs[s];
  if (!Number.isInteger(s) || s < 0 || !sec) return null;
  let g = L.geoms.get(keyOf(sec));
  if (!g) {
    g = pxOf(geomOf(sec, L.gset, secs[0]));
    if (L.web) g = webGeom(g, L.web);
    L.geoms.set(keyOf(sec), g);
  }
  return g;
}
