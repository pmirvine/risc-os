// StyleClear - Clear all formatting and Normal (the style completion
// batch). d is the real ./Document, typing its ./Typing (or null);
// each command is one undo step (none when nothing changes) and
// returns {sel, pending}, as ./FormatSet's.
//
//   clearAll(d, typing, sel, pending)  Word's Clear All Formatting:
//       the characters as ./FormatSet clearFormat (Ctrl+Space: the
//       character formatting and the character style; at a caret
//       into pending), and each paragraph the selection formats back
//       to the default paragraph style with no direct paragraph
//       properties, numbering (numPr) too; a raw property of one of
//       those names goes with it (./PropNames), other raw elements
//       stay
//   applyNormal(d, typing, sel, pending)  Ctrl+Shift+N: the default
//       paragraph style on those paragraphs (pStyle removed), their
//       direct formatting kept
// Pure: no desktop services.
import {clearFormat} from './FormatSet';
import {paraCommand, paraStyle} from './FormatPara';
import {PPR_FIELDS} from './PropNames';

const NONE = Object.freeze({pStyle: null, pPr: Object.fromEntries(
  [...PPR_FIELDS.keys()].map((k) => [k, null]))});

/** See the header. */
export function clearAll(d, typing, sel, pending) {
  let out;
  const go = () => d.atomic(() => {
    out = clearFormat(d, null, sel, pending);
    paraCommand(d, null, sel, out.pending, () => NONE);
  });
  if (typing) typing.command(go);
  else go();
  return out;
}

/** See the header. */
export const applyNormal = (d, typing, sel, pending) =>
  paraStyle(d, typing, sel, null, pending);
