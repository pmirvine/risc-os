// EditRange - the ops that delete a range of a document, for the
// editing commands (./Edit, ./EditDel). Each applies ops to a
// Document, which the command has already put in a group, and
// returns where the caret goes ({id, off}).
//
//   deleteRange(d, o)      o from EditPos.orderedPos: delete from
//                          o.from to o.to (not collapsed)
//   mergeAt(d, a, b)       join paragraph b (the block after a in
//                          document order, maybe in the next
//                          section) into paragraph a: see below
//   paraBy(d, loc, off)    a new empty paragraph before (off 0) or
//                          after (off 1) the kept block at loc
//
// Merge rule (Backspace, Delete, and the two ends of a deleted
// range): the first paragraph keeps its id, properties and style,
// and the caret goes to the join; but when the first is empty and
// the second is not, the first is removed and the second keeps its
// own (caret at its start). Word's behaviour, to be checked in real
// Word.
//
// Positions are paths (Batch C): ops go to loc.at. A range with an
// end in a table's cell (EditPos topOnly fails) is ./RangeTbl's
// (C3.4): in one cell as here; over a 'cells' shape the cells
// cleared; a 'mixed' one its paragraphs and covered rows. The rest
// below is the top-level range, unchanged. paraBy and mergeAt work
// in a cell too (siblings only). The ops are ./RangeOps'.
//
// A range across paragraphs and kept blocks: the first paragraph is
// cut at from, the last cut before to, the blocks between removed
// (removeBlocks: one op per section, so O(blocks), not O(n^2)), and
// the two ends merged. A kept block is in the range when the range
// covers it (from at its off 0, or to at its off 1).
//
// A bookmark mark in the range whose partner is outside it is put
// back where the range was (./BookmarkKeep: a pair is never broken).
// Section breaks are never removed by a range (kept so for now: a
// question for real Word, SB4 in docs/apps/Letters.md; only Delete or
// Backspace next to a break removes it, ./SectBreak).
// Two tables (typed or Opaque) the range leaves next to each other
// get an empty paragraph between them, the caret in it (./RangeOps
// apart; D27, C7 fix).
// A section the range leaves with no block gets one
// empty paragraph (fresh id), in the same undo step, so every
// section stays reachable by the caret and the document never has
// no block at all; so does one left ending with a kept block (not
// the last section: the writer would add a paragraph there to carry
// the section break, and the file would read back with one more).
// Pure: no desktop services.
import {atIndex, endOf, posOf, neighbour, topOnly, sibOf}
  from './EditPos';
import {at as walkAt} from './Walk';
import {keptMarks, putMarks} from './BookmarkKeep';
import {cutOut, putPara, mergeAt, removeTop, fillEmpty, apart}
  from './RangeOps';
import {sib} from './Path';
import {deleteIn} from './RangeTbl';

export {mergeAt};

/** See the header. */
export const paraBy = (d, loc, off) => putPara(d, sibOf(loc,
  off ? 1 : 0));

/** See the header. */
export function deleteRange(d, o) {
  if (!topOnly(o)) return deleteIn(d, o);
  const keep = keptMarks(d.doc, o);
  const cut = cutRange(d, o);
  fillEmpty(d, o.f.s, o.t.s);
  const pos = cut || after(d, o);
  putMarks(d, pos, keep);
  return pos;
}

/** Only kept blocks at the ends: the next block left, else the end
 * of the one before (fillEmpty makes sure there is one). */
function after(d, o) {
  const doc = d.doc;
  const lo = o.f.k + (o.from.off === 1 ? 1 : 0);
  const next = atIndex(doc, lo);
  if (next) return posOf(next, 0);
  const prev = atIndex(doc, lo - 1);
  return posOf(prev, endOf(prev.b));
}

/** deleteRange's ops; the caret, or null when no paragraph end. */
function cutRange(d, o) {
  const {from, to, f, t} = o;
  if (f.k === t.k && f.b.type === 'p') {
    cutOut(d, f.at, from.off, to.off);
    return from;
  }
  const A = f.b.type === 'p', B = t.b.type === 'p';
  const lo = f.k + (A || from.off === 1 ? 1 : 0);
  const hi = t.k - (B || to.off === 0 ? 1 : 0);
  if (B) cutOut(d, t.at, 0, to.off);
  if (hi >= lo) {
    removeTop(d, f, t, lo, hi);
    if (!A && !B) apart(d, sib(f.at, lo - f.k));
  }
  if (A) cutOut(d, f.at, from.off, f.b.text.length);
  if (A && B) {                        // (d.doc: a story's is new)
    const a = {...f, b: walkAt(d.doc, f.at)};
    return mergeAt(d, a, neighbour(d.doc, a, 1));
  }
  if (A) return from;
  if (B) return {id: t.b.id, off: 0};
  return null;
}
