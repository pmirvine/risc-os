// AnchorBox - the boxes a float is placed in (./AnchorPlace's,
// split from it, P12.6 prep; pictures and floating tables, R5).
//
//   hBox(c, from, at) -> {x, w} | null   the horizontal box `from`
//       (relativeFrom) on page c ({pg, geo, odd}: AnchorPlace's)
//       for a float whose line is at ({fr, x, cell?})
//   vBox(c, from, at) -> {y, h} | null   the vertical box ({para,
//       line, lineH, cellV?})
//   along(pos, b, k, n, lo, hi) -> where pos ({align?, offset?})
//       puts a side n long in box b (k 'x' or 'y'; lo / hi the
//       align values meaning its start and end; else b[k] + offset
//       EMU / EMU_PX)
//   EMU_PX 9525; fin(v) a finite number
//
// The boxes: ./AnchorPlace's header. Pure: no desktop services.

export const EMU_PX = 9525;
export const fin = (v) => typeof v === 'number' && Number.isFinite(v);
const IN_CELL_H = new Set(['column', 'margin', 'insideMargin',
  'outsideMargin', 'leftMargin', 'rightMargin']);
const IN_CELL_V = new Set(['margin', 'topMargin', 'bottomMargin']);

/** The horizontal box {x, w} of from on page c (see the header). */
export function hBox(c, from, at) {
  const g = c.geo, W = c.pg.w, L = g.mar.left, R = g.mar.right;
  if (at.cell && IN_CELL_H.has(from)) return at.cell;
  const left = {x: 0, w: L}, right = {x: W - R, w: R};
  switch (from) {
    case 'character': return {x: at.x, w: 0};
    case 'column': return {x: at.fr.x, w: at.fr.w};
    case 'margin': return {x: L, w: W - L - R};
    case 'page': return {x: 0, w: W};
    case 'leftMargin': return left;
    case 'rightMargin': return right;
    case 'insideMargin': return c.odd ? left : right;
    case 'outsideMargin': return c.odd ? right : left;
    default: return null;
  }
}

/** The vertical box {y, h} of from on page c. */
export function vBox(c, from, at) {
  const g = c.geo, H = c.pg.h, T = g.mar.top, B = g.mar.bottom;
  if (at.cellV && IN_CELL_V.has(from)) return at.cellV;
  switch (from) {
    case 'paragraph': return {y: at.para, h: 0};
    case 'line': return {y: at.line, h: at.lineH};
    case 'margin': return {y: T, h: H - T - B};
    case 'page': return {y: 0, h: H};
    case 'topMargin': return {y: 0, h: T};
    case 'bottomMargin': return {y: H - B, h: B};
    default: return null;
  }
}

/** Where pos ({from, align?, offset?}) puts a side n long in box
 *  b (at b.x or b.y: k), lo/hi the align values meaning its start
 *  and end. */
export function along(pos, b, k, n, lo, hi) {
  const a = pos.align;
  if (a === lo) return b[k];
  if (a === hi) return b[k] + b[k === 'x' ? 'w' : 'h'] - n;
  if (a === 'center') return b[k] + (b[k === 'x' ? 'w' : 'h'] - n) / 2;
  return b[k] + (fin(pos.offset) ? pos.offset / EMU_PX : 0);
}
