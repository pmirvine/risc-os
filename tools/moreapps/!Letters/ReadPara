// ReadPara - one w:p -> a Para of the Model (or null: keep it raw).
//
// In a w:r: w:t is text; w:tab is '\t'; a plain w:br (no attributes)
// is '\n'; any other w:br is U+FFFC with inline {kind:'br',
// level:'r', brType?, node}; every other element (w:drawing,
// w:fldChar, w:instrText, w:sym, w:footnoteReference...) is U+FFFC
// with {kind:'raw', level:'r', node} and the run's formatting. A
// tab, newline or U+FFFC written inside w:t is kept as a level 'r'
// raw inline holding a w:t with just that character, so text never
// gains a meaning the file did not give it.
//
// In a body paragraph, a table cell or a note (readPara's `notes`
// option, set by ./ReadBody, ./TblRead and ./NoteRead) a
// w:footnoteReference or w:endnoteReference is instead U+FFFC with
// {kind:'noteRef', note:'footnote'|'endnote', id, level:'r', node,
// custom?, customNode?}, and the note's own w:footnoteRef /
// w:endnoteRef one with {note, id: null, self: true}: id the integer
// w:id (a w:id that is not a whole number 0..2147483647 keeps the
// raw inline, as does any mark outside those paragraphs: headers,
// footers, text boxes). A reference with w:customMarkFollows is
// tied to the w:t that follows it in the run (custom: its text,
// customNode: that element, written back as it was); with no such
// plain text after it, it stays a raw inline. node is written back
// unchanged.
//
// With the `comments` option (body paragraphs and their tables at
// every depth: ./ReadBody, ./TblRead; never a header, footer, note,
// text box or content control, whose marks stay raw) a
// w:commentRangeStart or w:commentRangeEnd directly in w:p is U+FFFC
// with {kind: 'cmtStart' | 'cmtEnd', level: 'p', id, node} in a
// plain run (as a raw one), and a w:commentReference in a run
// {kind: 'cmtRef', level: 'r', id, node} with the run's formatting
// (Batch F1): id the integer of its one w:id (./Kinds markId: a
// plain whole number 0..2147483647); any other id, or children,
// keep the raw inline. node is written back unchanged.
//
// Every other child of w:p (w:hyperlink, w:fldSimple, w:ins, w:del,
// w:sdt, w:smartTag, bookmarks, w:proofErr, m:oMath, unknown...) is
// one U+FFFC with {kind:'raw', level:'p', node, text}: text (for
// display only) is the plain text of the w:t elements inside, maybe
// ''. A w:r that cannot be split up safely (unknown attributes, text
// directly in it, a misplaced or repeated w:rPr) is such a level 'p'
// inline too, whole. Run rsid attributes are not kept.
//
// The attributes of w:p (rsids, w14:paraId...) go to extraP as
// [[name, value]] pairs. A w:pPr carrying attributes makes the whole
// paragraph raw (returns null). Comments directly in w:p or w:r are
// dropped; white space between elements is ignored.
import {newPara, OBJ} from './Model';
import {scope, wName, wAttrs, wAttr, isEl, blank, plainText}
  from './Ns';
import {readRPr, readPPr} from './ReadProps';
import {markId} from './Kinds';

const RSIDS = ['rsidR', 'rsidRPr', 'rsidDel'];
const plain = () => ({rPr: {extra: []}});

/** Collects text, runs and inlines for one paragraph. */
class Builder {
  constructor() {
    this.parts = [];
    this.len = 0;
    this.runs = [];
    this.inlines = {};
  }

  text(s, fmt) {
    if (!s) return;
    const run = {start: this.len, end: this.len + s.length,
      rPr: fmt.rPr};
    if (fmt.rStyle !== undefined) run.rStyle = fmt.rStyle;
    this.runs.push(run);
    this.parts.push(s);
    this.len += s.length;
  }

  inline(x, fmt) {
    this.inlines[this.len] = x;
    this.text(OBJ, fmt);
  }

  /** A child of w:p kept whole. */
  pRaw(node, map) {
    const text = typeof node === 'string' ? node
      : plainText(node, map);
    this.inline({kind: 'raw', level: 'p', node, text}, plain());
  }
}

/** True when the run must be kept whole: see the header. */
function awkward(r, m) {
  const a = wAttrs(r, m);
  if (!a) return true;
  for (const k of a.keys()) if (!RSIDS.includes(k)) return true;
  let seen = false;
  for (const c of r.children) {
    if (typeof c === 'string') {
      if (!blank(c)) return true;
    } else if (isEl(c)) {
      if (wName(c, m) === 'rPr') {
        if (seen || c.attrs.length) return true;
      }
      seen = true;
    }
  }
  return false;
}

/** The text of a w:t, or null when it is not plain text. */
function tText(t, m) {
  for (const [n] of t.attrs) if (n !== 'xml:space') return null;
  let s = '';
  for (const c of t.children) {
    if (typeof c !== 'string') return null;
    s += c;
  }
  return s;
}

function readT(t, m, b, fmt) {
  const s = tText(t, m);
  if (s === null) {
    b.inline({kind: 'raw', level: 'r', node: t}, fmt);
    return;
  }
  let from = 0;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    if (c !== 9 && c !== 10 && c !== 0xfffc) continue;
    b.text(s.slice(from, i), fmt);
    b.inline({kind: 'raw', level: 'r', node: {name: t.name,
      attrs: t.attrs.map(([n, v]) => [n, v]), children: [s[i]]}}, fmt);
    from = i + 1;
  }
  b.text(s.slice(from), fmt);
}

const NOTE_MARKS = {footnoteReference: ['footnote', false],
  endnoteReference: ['endnote', false], footnoteRef: ['footnote', true],
  endnoteRef: ['endnote', true]};

/** The custom-mark flag of a reference: true, false, or null (not
 *  understood). */
function customFlag(c, m) {
  const v = wAttr(c, c.attrs.length ? scope(m, c) : m,
    'customMarkFollows');
  if (v === undefined) return false;
  if (['1', 'true', 'on'].includes(v)) return true;
  return ['0', 'false', 'off'].includes(v) ? false : null;
}

/** The noteRef inline for mark `c`, or null to keep it raw. `next`
 *  is the element after it in the run. */
function noteRef(c, l, m, next) {
  const [note, self] = NOTE_MARKS[l];
  const mm = c.attrs.length ? scope(m, c) : m;
  const x = {kind: 'noteRef', note, id: null, level: 'r', node: c};
  if (self) {
    if (c.attrs.length || c.children.length) return null;
    x.self = true;
    return x;
  }
  const id = wAttr(c, mm, 'id');
  if (id === undefined || !/^[0-9]{1,10}$/.test(id) ||
    +id > 2147483647 || c.children.length) return null;
  x.id = +id;
  const flag = customFlag(c, m);
  if (flag === null) return null;
  if (flag) {
    const t = next && isEl(next) && wName(next, m) === 't' &&
      tText(next, m);
    if (!t || /[\t\n\ufffc]/.test(t)) return null;
    x.custom = t;
    x.customNode = next;
  }
  return x;
}

const RANGE = {commentRangeStart: 'cmtStart',
  commentRangeEnd: 'cmtEnd'};

/** The comment mark inline of element c (local name l), or null to
 *  keep it raw (see the header). */
function cmtMark(c, kind, level) {
  if (c.children.length) return null;
  const id = markId(c);
  return id === null ? null : {kind, level, id, node: c};
}

function readRun(r, map, b, notes, comments) {
  const m = r.attrs.length ? scope(map, r) : map;
  if (awkward(r, m)) {
    b.pRaw(r, map);
    return;
  }
  let fmt = plain();
  for (const c of r.children) {
    if (isEl(c) && wName(c, m) === 'rPr') fmt = readRPr(c, m, true);
  }
  const kids = r.children.filter(isEl);
  let skip = null;
  for (let i = 0; i < kids.length; i++) {
    const c = kids[i];
    if (c === skip) continue;
    const l = wName(c, m);
    if (l === 'rPr') continue;
    const ref = notes && NOTE_MARKS[l] ? noteRef(c, l, m, kids[i + 1])
      : null;
    if (ref) {
      if (ref.customNode) skip = ref.customNode;
      b.inline(ref, fmt);
      continue;
    }
    const cm = comments && l === 'commentReference'
      ? cmtMark(c, 'cmtRef', 'r') : null;
    if (cm) {
      b.inline(cm, fmt);
      continue;
    }
    const bare = !c.attrs.length && !c.children.length;
    if (l === 't') readT(c, m, b, fmt);
    else if (l === 'tab' && bare) b.text('\t', fmt);
    else if (l === 'br' && bare) b.text('\n', fmt);
    else if (l === 'br') {
      const x = {kind: 'br', level: 'r', node: c};
      const type = wAttr(c, c.attrs.length ? scope(m, c) : m, 'type');
      if (type !== undefined) x.brType = type;
      b.inline(x, fmt);
    } else b.inline({kind: 'raw', level: 'r', node: c}, fmt);
  }
}

/**
 * Read a w:p (flags.notes: model note marks, flags.comments: comment
 * marks: see the header).
 * Returns {para, sectPr} (sectPr: the w:pPr/w:sectPr
 * node or null), or null when the paragraph must stay raw.
 */
export function readPara(node, map, flags = {}) {
  const m = node.attrs.length ? scope(map, node) : map;
  const b = new Builder();
  let pp = {pPr: {extra: []}};
  let first = true;
  for (const c of node.children) {
    if (typeof c === 'string') {
      if (!blank(c)) b.pRaw(c, m);
      continue;
    }
    if (!isEl(c)) continue;
    const l = wName(c, m);
    if (l === 'pPr' && first) {
      if (c.attrs.length) return null;
      pp = readPPr(c, m, true);
    } else if (l === 'r') {
      readRun(c, m, b, !!flags.notes, !!flags.comments);
    } else {
      const cm = flags.comments && Object.hasOwn(RANGE, l)
        ? cmtMark(c, RANGE[l], 'p') : null;
      if (cm) b.inline(cm, plain());
      else b.pRaw(c, m);
    }
    first = false;
  }
  const opts = {runs: b.runs, inlines: b.inlines, pPr: pp.pPr,
    extraP: node.attrs.map(([n, v]) => [n, v])};
  if (pp.pStyle !== undefined) opts.pStyle = pp.pStyle;
  const para = newPara(b.parts.join(''), opts);
  return {para, sectPr: pp.sectPr || null};
}
