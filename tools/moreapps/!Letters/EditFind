// EditFind - Find and Replace in !Letters: the task's one Find box
// (WimpLib Ui/FindBox) working on the document whose window last
// had the caret (the active one: the box goes with it as you click
// from document to document). The finding is ./Find's.
//
//   attachFind(dw)        (./DocKeys) dw becomes the active document
//                         when its window gains the caret
//   openFind(dw, replace) CTRL-F, F4, Find... (replace: CTRL-H,
//                         Replace...): the box at the front, the
//                         caret in it; a selection of at most 100
//                         characters in one line is put in Find
//   findStep(dw, back)    CTRL-G, CTRL-SHIFT-G: Find next / previous
//                         with what the box holds (no text yet: the
//                         box opens)
//   findHook(app) -> {box, active, open(replace), run(action,
//                         fields)}   for the tests (fields: find,
//                         replace, matchCase, whole put in the box;
//                         find is looked for as given, even when
//                         longer than the field holds) -> message
//
// Find next: from the end of the selection (Find previous: from its
// start), going round from the top (bottom) when it reaches the end
// (start), the message saying so; the match is selected and scrolled
// into view (grey while the box has the caret). Not found: a beep
// and 'Not found'. Replace: when the selection is a match, it is
// replaced (one undo step) and the next found; otherwise it finds
// first. Replace all: every match in the document, one undo step,
// 'N replaced'. Text in a link is found but never replaced (said in
// the message). An empty Find field is refused ('Type the text to
// find.'); only the first 1000 characters are looked for (said).
// Close, Escape and the box's close icon give the caret back to the
// active document. In the box, CTRL-G and CTRL-SHIFT-G (Cmd on a
// Mac) find too. While the box is open it is a pane of the active
// document's view (./FindView): the match is drawn in the usual
// selection colour, its window brought to the front, the box moved
// off it. CTRL-G that goes round (or finds nothing) with the box
// shut opens it, without the caret, to show the message. Replace
// all leaves the caret after the last text it put in.
import {wimp} from 'riscos';
import {findBox} from 'wimplib/Ui/FindBox';
import * as S from './Selection';
import {orderedPos} from './EditPos';
import {prepare, MAX} from './Find';
import {st, step, replaceStep, all} from './FindSel';
import {keymap} from './Keymap';
import {macKey, isMac} from './MacKeys';
import {lend, unlend, show} from './FindView';

const PREFILL = 100;
const alive = (dw) => !!dw && !dw.closed && dw.win.isOpen;

/** See the header. */
export function attachFind(dw) {
  const s = st(dw.app);
  dw.win.on('gaincaret', () => {
    s.active = dw;
    if (s.box && s.box.isOpen) lend(s, dw, s.box);
  });
  dw.win.on('deleted', () => {
    if (s.pane && s.pane.view === dw.view) unlend(s);
    if (s.active === dw) s.active = null;
  });
}

/** The box for app, with its handlers. */
function boxOf(app) {
  const s = st(app);
  return (s.box = findBox(app.task, {
    onAction: (a) => run(app, a),
    onClose: () => {
      unlend(s);
      if (alive(s.active)) s.active.view.focus();
    },
    onKey: (ev) => {
      const dw = st(app).active;
      const mac = dw ? dw.view.mac
        : isMac(globalThis.navigator?.platform);
      const id = keymap.lookup(macKey(ev, mac));
      if (id === 'findNext' || id === 'findPrev') {
        run(app, id === 'findNext' ? 'next' : 'prev');
        return true;
      }
      return id === 'find' || id === 'replace' || undefined;
    },
  }));
}

/** The selection's text if short and on one line, else null. */
function prefill(v) {
  const o = v.sel && !S.collapsed(v.sel) && orderedPos(v.d.doc, v.sel);
  if (!o || o.f.b !== o.t.b || o.to.off - o.from.off > PREFILL)
    return null;
  const t = v.text();
  return t && t.length <= PREFILL && !/[\n\r]/.test(t) ? t : null;
}

/** See the header. */
export function openFind(dw, replace = false) {
  st(dw.app).active = dw;
  const b = boxOf(dw.app);
  b.message = '';
  b.open({text: prefill(dw.view) ?? undefined, replace});
  lend(st(dw.app), dw, b);
  return true;
}

/** See the header. */
export function findStep(dw, back) {
  st(dw.app).active = dw;
  const b = boxOf(dw.app);
  if (!b.find) return openFind(dw);
  run(dw.app, back ? 'prev' : 'next');
  if (!b.isOpen && b.message) {
    // went round, or nothing found: the box shows it, the caret
    // stays in the document
    b.open({focus: false});
    lend(st(dw.app), dw, b);
    show(dw, b);
  }
  return true;
}

/** A button of the box (or Return, or a key); raw: the text to
 *  find instead of the field's (the tests: longer than it holds). */
function run(app, action, raw) {
  const b = boxOf(app), dw = st(app).active;
  if (!alive(dw)) {
    wimp.beep();
    b.message = 'No document to search: click in one first.';
    return;
  }
  const p = prepare(raw ?? b.find);
  if (!p.needle) {
    wimp.beep();
    b.message = 'Type the text to find.';
    return;
  }
  const o = {matchCase: b.matchCase, whole: b.whole};
  let msg;
  if (action === 'prev' || action === 'next')
    msg = step(dw, p.needle, o, action === 'prev');
  else if (action === 'replace')
    msg = replaceStep(dw, p.needle, o, b.replace);
  else if (action === 'all') msg = all(dw, p.needle, o, b.replace);
  else return;
  b.message = (p.cut ? `Only the first ${MAX} characters are ` +
    'looked for. ' : '') + msg;
}

/** See the header. */
export function findHook(app) {
  return {
    get box() { return boxOf(app); },
    get active() { return st(app).active; },
    open: (replace) => {
      const dw = st(app).active;
      return alive(dw) ? openFind(dw, replace) : false;
    },
    run: (action, f = {}) => {
      const b = boxOf(app);
      for (const k of ['find', 'replace', 'matchCase', 'whole'])
        if (f[k] !== undefined) b[k] = f[k];
      run(app, action, f.find);
      return b.message;
    },
  };
}
