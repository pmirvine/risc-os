// StartersLetters2 - more of the Letters group of starter templates
// (see ./StartersLetters): every placeholder in [square brackets];
// British conventions; A4.
//
//   personalLetter()  address top right, date, short paragraphs,
//                     "Best wishes,"
//   coverLetter()     sender, date, employer, "Re:" line, opening,
//                     two paragraphs on experience, closing
//   memo()            Title, borderless To / From / Date / Subject
//                     table with a rule under it, body, action line
//   faxCover()        Title, To ... Subject table, a boxed Message,
//                     a small confidentiality note
import {para, run, table, starterDoc} from './StarterKit';

const TIGHT = {spacing: {after: 0}};
const GAP = {spacing: {after: 240}};
const lines = (list, o = {}) => list.map((t) =>
  para(t, {...TIGHT, ...o}));
const label = (t) => para(run(t, {b: true}), TIGHT);

/** See the header. */
export function personalLetter() {
  return starterDoc({title: 'Personal letter', body: [
    ...lines(['[Your address line 1]', '[Your address line 2]',
      '[Town]', '[Postcode]'], {align: 'right'}),
    para('[5 November 2026]', {align: 'right',
      spacing: {before: 240, after: 480}}),
    para('Dear [Name],', GAP),
    para('[Start with a friendly line: how you are, or thanks for ' +
      'their last letter.]', GAP),
    para('[Say what you wrote to say, in a few short paragraphs.]',
      GAP),
    para('[Finish with your plans, an invitation or a question.]',
      GAP),
    para('Best wishes,', {spacing: {after: 480}, keepNext: true}),
    para('[Your name]'),
  ]});
}

/** See the header. */
export function coverLetter() {
  return starterDoc({title: 'Cover letter', body: [
    ...lines(['[Your name]', '[Address line 1]', '[Town]',
      '[Postcode]', '[Telephone]', '[Email]']),
    para('[5 November 2026]', {spacing: {before: 360, after: 360}}),
    ...lines(['[Hiring manager]', '[Company name]',
      '[Address line 1]', '[Town]', '[Postcode]']),
    para('Dear [Hiring manager],', {spacing: {before: 360,
      after: 240}}),
    para(run('Re: [Job title] (ref [reference])', {b: true}), GAP),
    para('[Say which post you are applying for, where you saw it ' +
      'and why it appeals to you.]', GAP),
    para('[Describe your most relevant experience and one result ' +
      'you achieved.]', GAP),
    para('[Add the skills or training that fit the post, with a ' +
      'short example.]', GAP),
    para('[Say when you are available and thank them for their ' +
      'time.]', GAP),
    para('Yours sincerely,', {spacing: {after: 720}, keepNext: true}),
    para('[Your name]'),
  ]});
}

/** See the header. */
export function memo() {
  const rule = {bottom: {sz: 8, themeColor: 'accent1'}};
  const row = (k, v, last) => {
    const b = last ? {borders: rule} : {};
    return [{content: [para(run(k, {b: true}), {spacing:
      {after: last ? 120 : 60}})], ...b},
    {content: [para(v, {spacing: {after: last ? 120 : 60}})], ...b}];
  };
  return starterDoc({title: 'Memo', body: [
    para('Memo', {style: 'Title'}),
    table({cols: [1500, 7526], rows: [row('To', '[Recipient name]'),
      row('From', '[Your name]'), row('Date', '[5 November 2026]'),
      row('Subject', '[Subject of the memo]', true)]}),
    para('[State the purpose of the memo in one or two sentences.]',
      {spacing: {before: 360, after: 240}}),
    para('[Give the background or details the readers need.]', GAP),
    para('[Say what happens next and who to ask for more ' +
      'information.]', GAP),
    para([run('Action required: ', {b: true}),
      '[what is to be done, by whom and by when]']),
  ]});
}

/** See the header. */
export function faxCover() {
  const rows = [['To', '[Recipient name]'], ['Company', '[Company]'],
    ['Fax number', '[Fax number]'], ['From', '[Your name]'],
    ['Date', '[5 November 2026]'], ['Pages', '[Number of pages]'],
    ['Subject', '[Subject]']].map(([k, v]) => [
    {content: [para(run(k, {b: true}), {spacing: {before: 60,
      after: 60}})]},
    {content: [para(v, {spacing: {before: 60, after: 60}})]}]);
  const edge = {sz: 8, themeColor: 'accent1'};
  return starterDoc({title: 'Fax cover sheet', body: [
    para('Fax', {style: 'Title'}),
    table({cols: [2000, 7026], rows, borders: 'rules'}),
    para(run('Message', {b: true}), {spacing: {before: 360,
      after: 120}, keepNext: true}),
    table({cols: [9026], rows: [{height: 4000, cells: [{borders:
      {top: edge, bottom: edge, left: edge, right: edge},
    content: [para('[Write your message here.]', GAP)]}]}]}),
    para(run('[If you have received this fax in error, please tell ' +
      'the sender by telephone and destroy it. It may contain ' +
      'confidential information.]', {sz: 16, i: true}),
    {spacing: {before: 240}}),
  ]});
}
