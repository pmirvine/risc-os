// LayoutOpts - the options of a ./DocLayout (split from it, Batch D
// P12.3): what a new layout takes from its opts, else from prev.
//
//   optsOf(L, prev, opts) sets on layout L:
//     top         px above everything (the panes), 0..1000: opts',
//                 else prev's, else 0
//     decorators  opts', else prev's, else ./DocStack DECORATORS
//     pics        a ./PicCache view (picView), ./PicPaint's L.pics:
//                 opts', else prev's, else null (pictures: boxes)
//     fields      the context field results are shown computed in
//                 (./FieldShow: {now, page?, pages?, pageOf?}):
//                 opts', else prev's, else null (stored results)
//     colW        the widths of root paragraphs that land in a
//                 column of another width (./ColPass, D23; Print
//                 layout's): prev's when opts' is undefined, none
//                 when null
//     floats      Print layout's (P12.2, D26: an understood floating
//                 picture zero width, ./AnchorPlace places it):
//                 opts', else prev's, else off (Draft; Web layout
//                 and Outline: always off)
//     web         Web layout's text width (px, ./WebLayout: 80..4000;
//                 no floats, one column), else prev's, else none
//     lazy        ./WebLayout bandOf: the items to break at once on a
//                 resize, the rest waiting stale (not kept)
//     outline     Outline view's collapse set (a Set of block ids,
//                 ./OutlineLayout, D32; any other value but null and
//                 undefined: an empty one): opts', else prev's, else
//                 none (null)
//     wrap        the shapes root paragraphs beside floats are broken
//                 with (./WrapPass, P12.3, D27; Print layout's):
//                 prev's when opts' is undefined, none when null;
//                 none when floats is off
//
// Pure: no desktop services.
import {DECORATORS} from './DocStack';

const num = (v, d) => (Number.isFinite(v) ? v : d);
const clamp = (v, a, b) => Math.min(Math.max(v, a), b);
const NO_SET = new Set();              // (never changed)

/** See the header. */
export function optsOf(L, prev, opts) {
  const top = opts.top === undefined && prev ? prev.top : opts.top;
  L.top = clamp(num(top, 0), 0, 1000);
  L.decorators = opts.decorators || (prev && prev.decorators) ||
    DECORATORS;
  L.pics = opts.pics || (prev && prev.pics) || null;
  L.fields = opts.fields || (prev && prev.fields) || null;
  L.colW = opts.colW !== undefined ? opts.colW || null
    : (prev && prev.colW) || null;
  const web = opts.web !== undefined ? opts.web : prev && prev.web;
  L.web = Number.isFinite(web) ? clamp(web, 80, 4000) : null;
  L.lazy = opts.lazy || null;
  const ol = opts.outline !== undefined ? opts.outline
    : prev && prev.outline;
  L.outline = ol instanceof Set ? ol : ol ? NO_SET : null;
  L.floats = !L.web && !L.outline && (opts.floats !== undefined
    ? !!opts.floats : !!(prev && prev.floats));
  L.wrap = !L.floats ? null : opts.wrap !== undefined
    ? opts.wrap || null : (prev && prev.wrap) || null;
}
