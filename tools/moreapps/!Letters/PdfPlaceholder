// PdfPlaceholder - what the PDF export draws for a picture it could
// not make: the grey outlined box the screen draws (PicPaint box),
// without the label.
//
//   placeholderOps(sink, x, y, w, h) -> the content lines (q ... Q)
//
// x, y, w, h are the picture's rectangle in the sink's current user
// space (px, y down); sink supplies rectOps and k.

import {num} from 'wimplib/PdfWrite';
import {parseColour, rgbOf} from 'wimplib/PdfColour';

const GREY = rgbOf(parseColour('#a0a0a0'));

/** See the header: a 1 px outline kept inside the rectangle. */
export function placeholderOps(sink, x, y, w, h) {
  const a = Math.abs(w), b = Math.abs(h);
  const x0 = Math.min(x, x + w) + 0.5, y0 = Math.min(y, y + h) + 0.5;
  return ['q', GREY + ' RG', num(sink.k) + ' w [] 0 d',
    sink.rectOps(x0, y0, Math.max(0, a - 1), Math.max(0, b - 1)),
    'S', 'Q'];
}
