// ToolsMenu - the Tools submenu of a document's window menu (Batch
// F1):
//
//   toolsMenu(dw) -> a Menu
//     Show Comments               the Comments pane shown or hidden
//                                 (./CommentBox toggleComments;
//                                 ticked while it is open)
//     Delete comments in selection  every comment whose whole range
//                                 (a point comment: its reference)
//                                 lies inside the selection, with
//                                 its replies,
//                                 one undo step (./CommentBox
//                                 deleteInSelection). Shaded with a
//                                 caret (no selection), in the
//                                 header and footer mode and the
//                                 notes mode. A comment that only
//                                 partly overlaps the selection or
//                                 touches its edge stays
//                                 (./CommentCmd deleteAllIn)
//     User name and initials...   the box of the name and initials
//                                 new comments are written with
//                                 (./AuthorBox)
// Everything of the window's: dw.view is its ./EditView.
import {Menu} from 'riscos';
import {commentsShown, toggleComments, deleteInSelection}
  from './CommentBox';
import {authorBox} from './AuthorBox';
import * as S from './Selection';

/** See the header. */
export function toolsMenu(dw) {
  const v = dw.view;
  return new Menu('Tools', [
    {text: 'Show Comments', ticked: () => commentsShown(dw),
      action: () => { toggleComments(dw); },
      help: 'Show or hide the Comments pane: the comments of the ' +
        'document, to go to, answer, resolve, edit or delete.'},
    {text: 'Delete comments in selection', dotted: true,
      shaded: () => !!v.hdr || !v.sel || S.collapsed(v.sel),
      action: () => { deleteInSelection(dw); },
      help: 'Delete the comments whose whole range lies in the ' +
        'selection, with their replies (not one that only partly ' +
        'overlaps it or touches its edge). The text stays.'},
    {text: 'User name and initials...',
      action: () => { authorBox(dw); },
      help: 'The name and initials new comments are written with.'},
  ]);
}
