// ToolsMenu - the Tools submenu of a document's window menu (Batch
// F1, F2):
//
//   toolsMenu(dw) -> a Menu
//     Show Comments               the Comments pane shown or hidden
//                                 (./CommentBox toggleComments;
//                                 ticked while it is open)
//     Delete comments in selection  every comment whose whole range
//                                 (a point comment: its reference)
//                                 lies inside the selection, with
//                                 its replies,
//                                 one undo step (./CommentBox
//                                 deleteInSelection). Shaded with a
//                                 caret (no selection), in the
//                                 header and footer mode and the
//                                 notes mode. A comment that only
//                                 partly overlaps the selection or
//                                 touches its edge stays
//                                 (./CommentCmd deleteAllIn)
//     Track Changes  Ctrl+Shift+E  the document's setting switched,
//                                 one undo step (./ChangesBox
//                                 toggleTracking); ticked while it
//                                 is on (./RevTrack on, so after an
//                                 undo too)
//     Show Markup >               All Markup, Final, Original: the
//                                 window's markup view (dw.setMarkup,
//                                 ./RevView), the one shown ticked
//     Show Changes Pane           the Changes pane shown or hidden
//                                 (./ChangesBox; ticked while open)
//     Accept, Reject              the change at the caret, or those
//                                 in the selection (./ChangesBox
//                                 accept, ./RevCmd)
//     Accept All, Reject All      every change that can be; then a
//                                 notice of how many (./ChangesBox
//                                 resolveAll)
//     Previous Change  Alt+Shift+Up, Next Change  Alt+Shift+Down
//                                 the previous / next change in the
//                                 window's view selected
//                                 (./ChangesBox step)
//     Spelling...  F7             the Spelling box (./SpellBox
//                                 spellBox), at the caret
//     Check spelling as you type  the setting (./SpellOpts spellOn),
//                                 ticked while on; every window
//                                 follows (./SpellBind setSpell)
//     User name and initials...   the box of the name and initials
//                                 new comments and changes are
//                                 written with (./AuthorBox)
// The change commands are shaded exactly when they would refuse or
// find nothing to do (./ChangesBox why: every one in the header and
// footer mode and the notes mode, Track Changes too), and their help
// says why. Show Markup and Show Changes Pane always work.
// Everything of the window's: dw.view is its ./EditView.
import {Menu} from 'riscos';
import {commentsShown, toggleComments, deleteInSelection}
  from './CommentBox';
import {changesShown, toggleChanges, trackingOn, toggleTracking, why,
  accept, resolveAll, step} from './ChangesBox';
import {authorBox} from './AuthorBox';
import {spellBox} from './SpellBox';
import {spellOn} from './SpellOpts';
import {setSpell} from './SpellBind';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';
import * as S from './Selection';

const MARKUP = [['all', 'All Markup'], ['final', 'Final'],
  ['original', 'Original']];

/** The Show Markup submenu: the view shown ticked. */
function markupMenu(dw) {
  return new Menu('Show Markup', MARKUP.map(([id, text]) => ({text,
    ticked: () => dw.markup === id,
    action: () => {
      dw.setMarkup(id);
      const w = dw.boxes.get('changes');
      if (w && w.isOpen && w.api) w.api.refresh();
    },
    help: id === 'all' ? 'Show every tracked change: insertions ' +
      'underlined, deletions struck through.' : id === 'final'
      ? 'Show the text as it will be once the changes are accepted.'
      : 'Show the text as it was before the changes.'})));
}

/** A change command's item: shaded with why's reason as its help. */
function cmd(dw, text, w, run, help, extra = {}) {
  return {text, shaded: () => why(dw, w) !== null,
    action: () => { run(); },
    help: () => why(dw, w) || help, ...extra};
}

/** See the header. */
export function toolsMenu(dw) {
  const v = dw.view;
  const k = (id) => macLabel(keymap.labelFor(id), v.mac);
  return new Menu('Tools', [
    {text: 'Show Comments', ticked: () => commentsShown(dw),
      action: () => { toggleComments(dw); },
      help: 'Show or hide the Comments pane: the comments of the ' +
        'document, to go to, answer, resolve, edit or delete.'},
    {text: 'Delete comments in selection', dotted: true,
      shaded: () => !!v.hdr || !v.sel || S.collapsed(v.sel),
      action: () => { deleteInSelection(dw); },
      help: 'Delete the comments whose whole range lies in the ' +
        'selection, with their replies (not one that only partly ' +
        'overlaps it or touches its edge). The text stays.'},
    cmd(dw, 'Track Changes', 'track', () => toggleTracking(dw),
      'Record typing and deleting as tracked changes (a setting ' +
      'saved in the document).', {key: k('trackChanges'),
        ticked: () => trackingOn(dw)}),
    {text: 'Show Markup', submenu: () => markupMenu(dw),
      help: 'All Markup, Final or Original: how tracked changes are ' +
        'shown in this window.'},
    {text: 'Show Changes Pane', dotted: true,
      ticked: () => changesShown(dw),
      action: () => { toggleChanges(dw); },
      help: 'Show or hide the Changes pane: the tracked changes of ' +
        'the document, to go to, accept or reject.'},
    cmd(dw, 'Accept', 'accept', () => accept(dw, true),
      'Accept the change at the caret, or those in the selection.'),
    cmd(dw, 'Reject', 'reject', () => accept(dw, false),
      'Reject the change at the caret, or those in the selection.'),
    cmd(dw, 'Accept All', 'all', () => resolveAll(dw, true),
      'Accept every tracked change of the document.'),
    cmd(dw, 'Reject All', 'all', () => resolveAll(dw, false),
      'Reject every tracked change of the document.'),
    cmd(dw, 'Previous Change', 'prev', () => step(dw, -1),
      'Select the tracked change before the selection.',
      {key: k('prevChange')}),
    cmd(dw, 'Next Change', 'next', () => step(dw, 1),
      'Select the tracked change after the selection.',
      {key: k('nextChange'), dotted: true}),
    {text: 'User name and initials...', dotted: true,
      action: () => { authorBox(dw); },
      help: 'The name and initials new comments and tracked changes ' +
        'are written with.'},
    {text: 'Spelling...', key: k('spell'),
      action: () => { spellBox(dw); },
      help: 'Go through the words the spell check does not know, ' +
        'to change, ignore or add them.'},
    {text: 'Check spelling as you type', ticked: () => spellOn(dw.app),
      action: () => { setSpell(dw.app, !spellOn(dw.app)); },
      help: 'Mark words that are not in the dictionary with a red ' +
        'wavy line as you type (all documents).'},
  ]);
}
