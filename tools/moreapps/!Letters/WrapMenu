// WrapMenu - Format > Wrap text > of a document's window (Batch D
// P12.4, D28): how text goes round the selected picture.
//
//   wrapMenu(v) -> a Menu
//     In line with text   the picture in a line, as a character
//     Square              floating; text beside its box
//     Tight               floating; text close to its outline
//     Top and bottom      floating; no text beside it
//     Behind text         floating, under the text
//     In front of text    floating, over the text
//   The picture's kind is ticked (./WrapCmd kindOf of ./PicFind
//   selectedPic; none for Through or an anchor not understood).
//   Each runs ./WrapCmd wrapCmd as one command (one undo step:
//   v.typing.command); a picture in line made floating is placed
//   where it was: its x in its column and its top in its paragraph
//   (./WrapCmd placeOf, P12a fix M3).
//   Refused (null: an anchor not understood, no picture): a beep
//   (v.refused), nothing changed. v is the window's ./EditView.
import {Menu} from 'riscos';
import {selectedPic} from './PicFind';
import {wrapCmd, kindOf, placeOf} from './WrapCmd';

const ITEMS = [['In line with text', 'inline',
  'The picture sits in its line, like a character.'],
['Square', 'square', 'Text goes round the picture\'s box.'],
['Tight', 'tight', 'Text goes round the picture\'s outline.'],
['Top and bottom', 'topBottom', 'Text stops above the picture and ' +
  'goes on below it.'],
['Behind text', 'behind', 'The picture floats behind the text.'],
['In front of text', 'inFront', 'The picture floats over the ' +
  'text.']];

/** kind for the selected picture: see the header. */
function run(v, kind) {
  if (!v.sel) { v.refused(); return; }
  v.ensure();
  const f = selectedPic(v.L, v.sel);
  const at = f && !f.item.pic.floating ? placeOf(f) : {x: 0, y: 0};
  const out = v.typing.command(() => wrapCmd(v.d, v.sel, kind, at));
  if (out === null) { v.refused(); return; }
  v.edited(out);
}

/** See the header. */
export function wrapMenu(v) {
  const now = () => {
    const f = v.sel && selectedPic(v.L, v.sel);
    return f ? kindOf(f.item.pic) : null;
  };
  return new Menu('Wrap text', ITEMS.map(([text, kind, help]) => ({
    text, ticked: () => now() === kind, help,
    action: () => run(v, kind)})));
}
