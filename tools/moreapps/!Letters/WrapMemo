// WrapMemo - what ./WrapPass remembers of the pages it settles (Batch
// D P12a fix C1): a record for each page start, and whether a page's
// inputs are still the ones its record was made from.
//
//   memoOf(old, ver) -> {known, ver, total}  of wrap old: known
//       (Map page key -> record, ./ColMemo keyOf) kept, shared by the
//       wraps that follow (as ./ColMemo's memos); total the passes
//       made in ./DocVersion ver (0 for a first pass in it)
//   recFor(L, P, pg, memo, view) -> record | null  Page pg's record
//       when its inputs are the ones the record was made from: its
//       start, the offset of its first line when it starts inside a
//       paragraph, its parity, body top, frame height, shift and
//       size, its section's props object, the inputs (./ItemReuse
//       inp: all but the wrap) of every item it has held since the
//       record was made, and of the item after its end each time
//       (the one that did not fit: it decides where the page ends;
//       P12b fix wave), and the view (./WrapWant viewOf: Map id ->
//       key) of its paragraphs now where the record expects one (the
//       view its last pass left: a part changed by another page's
//       pass starts it again); else null
//   newRec(L, P, pg, memo) -> a new record for pg (known pruned as
//       ./ColMemo pruned does), n 0, st 'busy'
//     record {sig, toks, n, st: 'busy' | 'done' | 'fall', expect,
//       end, k, cut, seen, ends, cuts, pinned, kept}: n its passes,
//       expect (Map id -> key), end the page's end when done
//       (endKey; k its root index, cut whether inside an item), seen
//       the page states its passes made (a state seen again: a
//       cycle), ends and cuts its ends and its columns' cut items a
//       pass, pinned and kept its pins made (./WrapPage); and
//       (P12b fix) tys: the tables it may hold (Map id -> {pk, y}),
//       held: those it holds (a Map) or undefined
//   grow(rec, P, pg)   the inputs of the items pg holds now, and of
//       the item after its end, added
//   heldSame(P, pg, rec) -> whether the items record rec of page pg
//       held past pg's last item in its passes (a page's passes may
//       hold more than it ends with) have their inputs still (P12b
//       fix I1: ./WrapPage's settled page, whose own items are the
//       same while its Page object is, is no longer settled when one
//       of them changed)
//   endKey(P, pg) -> where page pg ends, as text
//
// Pages are read by their cursors in the galley of ./Pages P (P.G:
// its items, notes after the text too, ./EndGalley), never in L.
// Pure: no desktop services.
import {keyOf, pruned} from './ColMemo';

let SER = 0;
const SERIAL = new WeakMap();          // object -> number

/** A number for object o (0 for none). */
function ser(o) {
  if (!o || typeof o !== 'object') return 0;
  let n = SERIAL.get(o);
  if (!n) SERIAL.set(o, n = ++SER);
  return n;
}

const inside = (c) => !!(c.line || c.dy || c.cuts);
const lastOf = (pg) => (inside(pg.end) ? pg.end.k : pg.end.k - 1);
/** The input of galley G's item k (./ItemReuse inp; a run of
 *  notes' item: its note item, ./EndnoteLayout), -1 for none. */
const inp = (G, k) => {
  const it = G.items[k];
  return !it ? -1 : it.en ? it.en.src : it.inp;
};

/** See the header. */
export function memoOf(old, ver) {
  const ok = !!old && old.known instanceof Map;
  return {known: ok ? old.known : new Map(), ver,
    total: ok && old.ver === ver ? old.total : 0};
}

/** Page pg's inputs but its items' (see the header). */
function sigOf(L, G, pg) {
  const c = pg.start, it = G.items[c.k];
  const ln = inside(c) && it && it.lines ? it.lines[c.line] : null;
  return [keyOf(G, pg), (c.cuts || []).join(','), ln ? ln.from : -1,
    pg.parity, pg.bodyTop, pg.frameH, pg.vShift, pg.w, pg.h,
    ser(L.sectProps[pg.s])].join('/');
}

/** See the header. */
export function recFor(L, P, pg, memo, view) {
  const G = P.G, rec = memo.known.get(keyOf(G, pg));
  if (!rec || rec.sig !== sigOf(L, G, pg)) return null;
  const k0 = pg.start.k;
  for (let j = 0; j < rec.toks.length; j++) {
    if (inp(G, k0 + j) !== rec.toks[j]) return null;
  }
  for (const [id, k] of view) {
    const e = rec.expect.get(id);
    if (e !== undefined && e !== k) return null;
  }
  return rec;
}

/** See the header. */
export function newRec(L, P, pg, memo) {
  const rec = {sig: sigOf(L, P.G, pg), toks: [], n: 0, st: 'busy',
    expect: new Map(), end: '', k: -1, cut: false, seen: new Set(),
    ends: [], cuts: [], pinned: false, kept: false};
  grow(rec, P, pg);
  pruned(L, P, memo.known).set(keyOf(P.G, pg), rec);
  return rec;
}

/** See the header. */
export function grow(rec, P, pg) {
  const G = P.G, k0 = pg.start.k;
  const end = Math.min(lastOf(pg) + 1, G.items.length - 1);
  for (let k = k0 + rec.toks.length; k <= end; k++) {
    rec.toks.push(inp(G, k));
  }
}

/** See the header. */
export function heldSame(P, pg, rec) {
  const k0 = pg.start.k;
  for (let j = Math.max(0, lastOf(pg) + 1 - k0); j < rec.toks.length;
    j++) {
    if (inp(P.G, k0 + j) !== rec.toks[j]) return false;
  }
  return true;
}

/** See the header. */
export function endKey(P, pg) {
  const c = pg.end, it = P.G.items[c.k];
  return [it ? it.id : '', c.line || 0, c.dy || 0,
    (c.cuts || []).join(',')].join('/');
}
