// OutlineMenu - the Outline submenu of a document's window menu
// (Batch D P13.4, D32; ./WinMenu puts it after View, shaded outside
// Outline view):
//
//   outlineMenu(dw) -> a Menu
//     Expand                  Collapse's opposite: opens the
//                             collapsed heading the caret or
//                             selection is in (after Show level: one
//                             level more); a beep when none is
//     Collapse                hides the text and headings under the
//                             heading the caret is in (body text:
//                             the heading above it); after Show
//                             level one level less
//     Show level >            Level 1..9 (only the headings down to
//                             that level, no body text) and All
//                             (everything: the collapsed headings
//                             stay collapsed); the one shown ticked
//     Show first line only    ticked while on: each paragraph shows
//                             its first line (a caret in the rest is
//                             drawn at the end of the first)
//     Promote, Demote         the paragraphs one outline level up or
//                             down (Shift+Tab, Tab at a heading's
//                             start; a collapsed heading takes the
//                             headings hidden under it)
//     Move up, Move down      the paragraph with what is under it
//                             past the one before or after
//                             (Ctrl+Shift+Up, Down)
// Promote, Demote and the moves are ./OutlineCmd's, through
// view.run (so a Mac, where the system keeps Ctrl+Shift+Up and Down,
// has them here); the rest are ./OutlineFold's, made the window's
// collapse set by ./OutlineView applyFold. The keys are shown from
// ./Keymap, Cmd for Ctrl on a Mac (./MacKeys). The set is the
// window's, never written to the file.
import {Menu} from 'riscos';
import {expandCmd, collapseCmd, showLevel, showFirst}
  from './OutlineFold';
import {applyFold} from './OutlineView';
import {keymap} from './Keymap';
import {macLabel} from './MacKeys';

/** See the header. */
export function outlineMenu(dw) {
  const v = dw.view;
  const k = (id, own) => macLabel(own || keymap.labelFor(id), v.mac);
  const none = () => !v.sel;
  const fold = (cmd) => () => {
    applyFold(dw, cmd(dw.doc, dw.collapsed, v.sel));
  };
  const level = (n) => ({text: n ? 'Level ' + n : 'All',
    ticked: () => (dw.collapsed.cap || 0) === n,
    action: () => {
      applyFold(dw, showLevel(dw.doc, dw.collapsed, n));
    },
    help: n ? 'Show the headings down to level ' + n + ', and no ' +
      'body text.' : 'Show all the text and headings again.'});
  const cmd = (text, id, help, own) => ({text, key: k(id, own),
    shaded: none, action: () => { v.run(id); }, help});
  return new Menu('Outline', [
    {text: 'Expand', shaded: none, action: fold(expandCmd),
      help: 'Show what is under the heading the caret is in (after ' +
        'Show level: one more level).'},
    {text: 'Collapse', shaded: none, action: fold(collapseCmd),
      help: 'Hide what is under the heading the caret is in (after ' +
        'Show level: one level less). Double-click its + or - to ' +
        'do the same.'},
    {text: 'Show level', submenu: () => new Menu('Show level',
      [1, 2, 3, 4, 5, 6, 7, 8, 9, 0].map(level)),
    help: 'Show only the headings down to a level, or all the text.'},
    {text: 'Show first line only', dotted: true,
      ticked: () => !!dw.collapsed.first,
      action: () => {
        applyFold(dw, showFirst(dw.collapsed, !dw.collapsed.first));
      },
      help: 'Show only the first line of each paragraph.'},
    cmd('Promote', 'outlinePromote', 'Move the paragraph one ' +
      'outline level up (Heading 2 becomes Heading 1; body text ' +
      'becomes Heading 1). Shift+Tab at the start of a heading ' +
      'does it too.', 'Shift+Tab'),
    cmd('Demote', 'outlineDemote', 'Move the paragraph one ' +
      'outline level down (Heading 1 becomes Heading 2; Heading 9 ' +
      'becomes body text). Tab at the start of a heading does it ' +
      'too.', 'Tab'),
    cmd('Move up', 'outlineUp', 'Move the paragraph, with the ' +
      'text under it, above the one before it.'),
    cmd('Move down', 'outlineDown', 'Move the paragraph, with the ' +
      'text under it, below the one after it.'),
  ]);
}
