// DocStsh - the style sheet of a .doc as it is in the file
// ([MS-DOC] 2.9.271 STSH: 2.9.273 Stshif (cstd, cbSTDBaseInFile,
// the default fonts), then LPStd records: 2.9.260 STD = StdfBase
// (sti, stk, istdBase, cupx, istdNext), xstzName, the UPXs). Used
// by ./DocStyles; pure.
//
//   readStsh(table, fib, note?) -> {stds, ftc}  stds a Map istd ->
//       {istd, sti, stk (1 paragraph, 2 character, 3 table, 4
//       list), base, next (istds; 0x0FFF none), name (the file's,
//       its aliases after a comma left out), papx, chpx (./DocSprm
//       Prl lists: a paragraph style's both, a character style's
//       chpx, a table style's both after its TAPX, a list style's
//       papx)}; ftc the default fonts {ascii, fe, other} (font
//       indexes). An empty LPStd (cbStd 0) is no style. A record
//       that runs past the style sheet is the last, read as far as
//       it goes; an STD too short for its StdfBase or name is left
//       out, a UPX that runs past its STD ends that STD's UPXs (a
//       note each). At most NONE (4095) STDs are read: an istd is
//       below 0x0FFF ([MS-DOC] 2.9.130 Istd), so no more can be
//       named (a note)
import {slice} from './DocFib';
import {readSprms} from './DocSprm';

export const NONE = 0x0FFF;
const CUT = 'the style sheet is damaged: some styles are not read';
const MAX_NAME = 255;
const MANY = 'the style sheet holds more styles than Word allows: ' +
  'the rest are left out';

/** A Xstz at `at` of d: [name, next offset] or null. */
function xstz(d, at) {
  if (at + 2 > d.length) return null;
  const cch = d[at] | (d[at + 1] << 8);
  const end = at + 2 + 2 * cch;
  if (end > d.length) return null;
  let s = '';
  for (let o = at + 2; o < end && s.length < MAX_NAME; o += 2) {
    s += String.fromCharCode(d[o] | (d[o + 1] << 8));
  }
  return [s, end + 2];
}

/** The UPXs of an STD from `at`: up to n views. */
function upxs(d, at, n, note) {
  const out = [];
  for (let k = 0; k < n; k++) {
    if (at + 2 > d.length) break;
    const cb = d[at] | (d[at + 1] << 8);
    at += 2;
    if (at + cb > d.length) {
      note(CUT);
      break;
    }
    out.push(d.subarray(at, at + cb));
    at += cb + (cb & 1);
  }
  return out;
}

/** One STD, or null. */
function std(d, istd, cbBase, note) {
  if (d.length < 10 || cbBase > d.length) return null;
  const w = (o) => d[o] | (d[o + 1] << 8);
  const stk = w(2) & 15, cupx = w(4) & 15;
  const nm = xstz(d, cbBase);
  if (!nm) return null;
  const u = upxs(d, nm[1], cupx, note);
  const prls = (b, from = 0) => (b ? readSprms(b, from, b.length,
    note) : []);
  const s = {istd, sti: w(0) & 0xFFF, stk, base: w(2) >> 4,
    next: w(4) >> 4, name: nm[0].split(',')[0].trim(), papx: [],
    chpx: []};
  if (stk === 1) {
    s.papx = prls(u[0], 2);
    s.chpx = prls(u[1]);
  } else if (stk === 2) s.chpx = prls(u[0]);
  else if (stk === 3) {
    s.papx = prls(u[1], 2);
    s.chpx = prls(u[2]);
  } else if (stk === 4) s.papx = prls(u[0], 2);
  return s;
}

/** See the header. */
export function readStsh(table, fib, note = () => {}) {
  const t = slice(table, fib, 'Stshf', note);
  const out = {stds: new Map(), ftc: {ascii: 0, fe: 0, other: 0}};
  if (!t || t.length < 4) return out;
  const w = (o) => (o + 2 <= t.length ? t[o] | (t[o + 1] << 8) : 0);
  const cbStshi = w(0);
  const cstd = Math.min(w(2), NONE), cbBase = w(4);
  if (w(2) > NONE) note(MANY);
  if (cbStshi >= 18) {
    out.ftc = {ascii: w(14), fe: w(16), other: w(18)};
  }
  let at = 2 + cbStshi;
  for (let istd = 0; istd < cstd; istd++) {
    if (at + 2 > t.length) {
      note(CUT);
      break;
    }
    const cb = w(at);
    at += 2;
    if (!cb) continue;
    if (at + cb > t.length) note(CUT);
    const s = std(t.subarray(at, Math.min(at + cb, t.length)), istd,
      cbBase, note);
    if (s) out.stds.set(istd, s);
    else note(CUT);
    at += cb;
  }
  return out;
}
