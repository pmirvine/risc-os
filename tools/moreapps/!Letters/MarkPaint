// MarkPaint - draws the marks ./DocPaint puts between and in the
// lines, all grey dotted rules with a small grey italic label in the
// middle (./DocPaint's header says where each one goes).
//
//   paintBand(L, g, it, m, rect)  the section break band m under
//                                 item it (./SectDeco)
//   paintFlow(L, g, it, m, rect)  the "Page break before" rule m in
//                                 the gap above item it (./FlowDeco)
//   paintRule(g, x, left, top, h)  the rule of a page or column
//                                 break's item x on a line at top, h
//                                 high, in a column at left
//                                 (./BreakMarks)
//
// A band or rule goes across its item's column (it.x, it.w:
// ./DocItems).
//
// Draws on the context it is given; imports no desktop services.
import {rulePaint} from './BreakMarks';
import {bandPaint} from './SectDeco';
import {flowPaint} from './FlowDeco';

const RULE = '#909090';
const RULE_FONT = 'italic 11px "Liberation Sans", sans-serif';

/** The section break band m under item it. */
export function paintBand(L, g, it, m, rect) {
  const top = it.y + it.h + m.dy;
  if (top >= rect.y1 || top + m.h <= rect.y0) return;
  if (g.font !== RULE_FONT) g.font = RULE_FONT;
  const lw = g.measureText ? g.measureText(m.label).width : 0;
  const r = bandPaint(m, it.w, lw);
  g.fillStyle = RULE;
  for (const dy of [r.y1, r.y2]) {
    const y = Math.round(top + dy);
    for (const [a, b] of r.dots) {
      for (let d = Math.ceil(it.x + a); d < it.x + b; d += 3) {
        g.fillRect(d, y, 1, 1);
      }
    }
  }
  if (r.label !== null) {
    g.fillText(m.label, it.x + r.label,
      Math.round(top + m.h / 2) + 4);
  }
}

/** The "Page break before" rule m in the gap above item it. */
export function paintFlow(L, g, it, m, rect) {
  const top = it.y + m.dy;
  if (top >= rect.y1 || top + m.h <= rect.y0) return;
  if (g.font !== RULE_FONT) g.font = RULE_FONT;
  const lw = g.measureText ? g.measureText(m.label).width : 0;
  const r = flowPaint(m, it.w, lw);
  g.fillStyle = RULE;
  const y = Math.round(top + r.y);
  for (const [a, b] of r.dots) {
    for (let d = Math.ceil(it.x + a); d < it.x + b; d += 3) {
      g.fillRect(d, y, 1, 1);
    }
  }
  if (r.label !== null) g.fillText(m.label, it.x + r.label, y + 3);
}

/** A break's rule x on a line at top, h high, column at left. */
export function paintRule(g, x, left, top, h) {
  if (g.font !== RULE_FONT) g.font = RULE_FONT;
  const lw = x.label && g.measureText ? g.measureText(x.label).width
    : 0;
  const r = rulePaint(x, lw);
  const y = Math.round(top + h * r.y);
  g.fillStyle = RULE;
  for (const [a, b] of r.dots) {
    for (let d = Math.ceil(left + a); d < left + b; d += 3) {
      g.fillRect(d, y, 1, 1);
    }
  }
  if (r.label !== null) g.fillText(x.label, left + r.label, y + 4);
}
