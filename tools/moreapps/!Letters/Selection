// Selection - the caret and the selection of a document, as a value:
// {anchor, head, affinity, goalX}, frozen; every change makes a new
// one. anchor and head are positions {id, off} (./DocPos); affinity
// is the head's ('up' or 'down' at a soft wrap, ./PositionMap);
// goalX the work-area x that Up and Down keep to (null when unset).
//
//   caret(pos, affinity?)           -> a collapsed selection
//   select(anchor, head, affinity?) -> a selection
//   collapsed(sel)                  -> whether anchor and head meet
//   ordered(sel, L)                 -> {from, to} in document order
//   move(sel, L, cmd, extend, pageH) -> moved by a key (./SelMove)
//   selectWord(L, pos)  the word at pos (not the spaces after it,
//                       when pos is at the end of a word); an inline
//                       (a link...) alone; a kept block whole
//   selectPara(L, pos)  the paragraph at pos (or the kept block)
//   selectAll(L)        the whole document
//   text(sel, L)        the selection as plain text: paragraphs
//                       joined by \n (a table's cells' paragraphs
//                       too, in flow order), a kept block as an
//                       empty line, a tab as \t, a line break as
//                       \n, an inline wrapper (a link...) as its text
//                       and other inline items as nothing
//   clamp(sel, doc, oldL?) the selection made valid for doc: an
//                       offset past its paragraph's end is its end;
//                       a position whose paragraph is gone goes to
//                       the start of the next block still there in
//                       the old layout oldL's flow (else the end of
//                       the one before, else the start of the
//                       document); when that next one is the END of
//                       a table (the table's last paragraphs gone),
//                       the end of the table's last paragraph left
//                       (./TblPos lastPos), never its start edge;
//                       a position in a vMerge continue cell (never
//                       drawn) goes to the start of the merge's
//                       restart cell (./TblPos); blocks at every
//                       depth (./Walk; found by ./EditPos findBlock,
//                       O(top-level blocks); for a position whose
//                       block is gone, a few more lookups, then a
//                       map of every block made once)
//
// oldL is used up (./DocItems: the layout built from it shares its
// kept items): clamp reads only ids from oldL.flow (a table's id is
// there twice: its start and its end place), and the index of the
// item of a GONE block, which no new layout keeps.
//
// L is a ./DocLayout. Pure: no desktop services.
import {wordBounds} from 'wimplib/Segment';
import {blockId, itemEnd, clampOff, compare, isWordText}
  from './DocPos';
import {make, move} from './SelMove';
import {inlineText} from './InlineText';
import {scan} from './Walk';
import {findBlock} from './EditPos';
import {contOf, cellPos, lastPos, shown} from './TblPos';
import {at as walkAt} from './Walk';

export {move};

/** See the header. */
export const caret = (pos, affinity = 'down') =>
  make(pos, pos, affinity);

/** See the header. */
export const select = (anchor, head, affinity = 'down') =>
  make(anchor, head, affinity);

/** See the header. */
export const collapsed = (sel) =>
  sel.anchor.id === sel.head.id && sel.anchor.off === sel.head.off;

/** See the header. */
export function ordered(sel, L) {
  return compare(L, sel.anchor, sel.head) > 0
    ? {from: sel.head, to: sel.anchor}
    : {from: sel.anchor, to: sel.head};
}

/** See the header. */
export function selectWord(L, pos) {
  const loc = L.locate(pos);
  if (!loc) return null;
  const it = loc.item, id = it.id;
  if (it.kind !== 'p') return select({id, off: 0}, {id, off: 1});
  const text = it.block.text;
  if (!text) return caret({id, off: 0});
  let w = wordBounds(text, loc.off);
  if (!isWordText(text.slice(w.from, w.to)) && loc.off > 0) {
    const b = wordBounds(text, loc.off - 1);
    if (isWordText(text.slice(b.from, b.to))) w = b;
  }
  // an inline (a link...) is one thing: not the spaces around it
  const o = loc.off;
  const k = text[o] === '\uFFFC' && o >= w.from && o < w.to ? o
    : text[o - 1] === '\uFFFC' && o - 1 >= w.from ? o - 1 : -1;
  if (k >= 0) return select({id, off: k}, {id, off: k + 1});
  return select({id, off: w.from}, {id, off: w.to});
}

/** See the header. */
export function selectPara(L, pos) {
  const loc = L.locate(pos);
  if (!loc) return null;
  const id = loc.item.id;
  return select({id, off: 0}, L.paraEnd({id}));
}

/** See the header. */
export function selectAll(L) {
  const a = L.docStart();
  return a ? select(a, L.docEnd()) : null;
}

/** The text of [a, b) of a paragraph, inline items as text. */
function paraText(para, a, b) {
  const s = para.text.slice(a, b);
  if (!s.includes('\uFFFC')) return s;
  return s.replace(/\uFFFC/g, (m, i) => {
    return inlineText(para.inlines && para.inlines[a + i]);
  });
}

/** See the header. */
export function text(sel, L) {
  const {from, to} = ordered(sel, L);
  const f = L.locate(from), t = L.locate(to);
  if (!f || !t) return '';
  const out = [];
  for (let i = f.index; i <= t.index; i++) {
    const it = L.flow[i];
    if (it.kind === 'tbl') continue;
    if (it.kind !== 'p') {
      if (i !== f.index || i !== t.index) out.push('');
      continue;
    }
    const a = i === f.index ? f.off : 0;
    const b = i === t.index ? t.off : itemEnd(it);
    out.push(paraText(it.block, a, b));
  }
  return out.join('\n');
}

/** Map id -> block of doc (every depth), and its first block. */
function blocksOf(doc) {
  const map = new Map();
  let first = null;
  scan(doc, (b) => {
    map.set(blockId(b), b);
    if (!first) first = b;
  });
  return {map, first};
}

/** Whether the table id at oldL.flow[i] is its END place: its id
 *  is not met again after i (a table is there twice). */
function endPlace(flow, i) {
  const id = flow[i].id;
  for (let j = i + 1; j < flow.length; j++) {
    if (flow[j].id === id) return false;
  }
  return true;
}

const LOOKS = 8;                       // findBlock calls before a map

/** The block of id in doc, or null: a few by findBlock, then by
 *  doc's map (blocksOf), made once (a deletion of many blocks). */
function blockOf(doc, d, id) {
  if (!d.map && (d.looks = (d.looks || 0) + 1) <= LOOKS) {
    const loc = findBlock(doc, id);
    return loc ? loc.b : null;
  }
  if (!d.map) Object.assign(d, blocksOf(doc));
  return d.map.get(id) || null;
}

/** Where a position whose block is gone goes (see the header). */
function near(doc, oldL, old, d) {
  const flow = oldL.flow;
  for (let i = old.index + 1; i < flow.length; i++) {
    const x = blockOf(doc, d, flow[i].id);
    if (!x) continue;
    if (x.type !== 'tbl' || !endPlace(flow, i)) {
      return {id: flow[i].id, off: 0};
    }
    return lastPos(x) || {id: x.id, off: 1};
  }
  for (let i = old.index - 1; i >= 0; i--) {
    const x = blockOf(doc, d, flow[i].id);
    if (!x) continue;
    if (x.type !== 'tbl') {
      return {id: x.id, off: x.type === 'p' ? x.text.length : 1};
    }
    return endPlace(flow, i) ? {id: x.id, off: 1}
      : lastPos(x) || {id: x.id, off: 0};
  }
  return null;
}

/** One position made valid (see the header). */
function clampPos(pos, doc, d, oldL) {
  const loc = findBlock(doc, pos.id), b = loc && loc.b;
  if (b) {
    const c = loc.at.length > 2 && contOf(doc, loc.at);
    if (c) return cellPos(walkAt(doc, c.tp), c.r, c.k) || pos;
    const it = b.type === 'p' ? {kind: 'p', block: b} : {kind: 'box'};
    return {id: pos.id, off: clampOff(it, pos.off)};
  }
  const old = oldL && oldL.byId.get(pos.id);
  const to = old && near(doc, oldL, old, d);
  if (to) return shown(doc, to);
  if (!d.map) Object.assign(d, blocksOf(doc));
  return d.first ? {id: blockId(d.first), off: 0} : pos;
}

/** See the header. */
export function clamp(sel, doc, oldL) {
  const d = {};
  const a = clampPos(sel.anchor, doc, d, oldL);
  const h = clampPos(sel.head, doc, d, oldL);
  return make(a, h, sel.affinity, null);
}
