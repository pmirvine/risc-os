| !Boot file for !Letters: the Filer runs it when it first shows the
| application (and the desktop does at start-up, for $.MoreApps), so
| its icons and the file types of Word documents and RTF are known.
Set Letters$Dir <Obey$Dir>
IconSprites <Obey$Dir>.!Sprites
Set File$Type_A7E MSWordX
| double-clicking a .docx opens it in !Letters (%% is a %: Obey would
| put its own parameters in place of a plain %*0)
Set Alias$@RunType_A7E Run <Letters$Dir>.!Run %%*0
| and an RTF file (&C32) too
Set File$Type_C32 RTF
Set Alias$@RunType_C32 Run <Letters$Dir>.!Run %%*0
