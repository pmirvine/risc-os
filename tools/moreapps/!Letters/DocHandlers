// DocHandlers - the handler modules of ./DocRead, in order (a later
// one wins), and the registry made of them once.
//
//   PARTS  each module's PART {chars?, fmt?, para?, start?, finish?}
//          (./DocRead's header says what each is)
//   REG    {low[32], high: Map, fmt, para, start: [], finish: []}:
//          the handlers of the characters below 0x20 (low) and
//          above (high), the last fmt and para given, every start
//          and finish hook in the order of PARTS
//
// ./DocRevs comes after ./DocChpx and ./DocPapx: its fmt and para
// wrap theirs (tracked changes). ./DocFields, ./DocNotes,
// ./DocComments and ./DocBkmk read their tables in start hooks,
// after ./DocPapx's (the styles first).
import {PART as TEXT} from './DocText';
import {PART as PAPX} from './DocPapx';
import {PART as CHPX} from './DocChpx';
import {PART as SECT} from './DocSect';
import {PART as PICT} from './DocPict';
import {PART as FIELDS} from './DocFields';
import {PART as NOTES} from './DocNotes';
import {PART as COMMENTS} from './DocComments';
import {PART as BKMK} from './DocBkmk';
import {PART as REVS} from './DocRevs';
import {PART as BODY} from './DocBody';

/** See the header. */
export const PARTS = [TEXT, PAPX, CHPX, SECT, PICT, FIELDS, NOTES,
  COMMENTS, BKMK, REVS, BODY];

function registry() {
  const reg = {low: new Array(32).fill(null), high: new Map(),
    fmt: null, para: null, start: [], finish: []};
  for (const p of PARTS) {
    for (const [k, v] of p.chars || []) {
      if (k < 32) reg.low[k] = v || null;
      else reg.high.set(k, v || null);
    }
    if (p.fmt) reg.fmt = p.fmt;
    if (p.para) reg.para = p.para;
    reg.start.push(...(p.start || []));
    reg.finish.push(...(p.finish || []));
  }
  return reg;
}

/** See the header. */
export const REG = registry();
