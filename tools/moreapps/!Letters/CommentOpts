// CommentOpts - the user name and initials new comments are written
// with (Batch F1): kept in Choices:Letters (./WordChoices) as
// 'userName' and 'userInitials', for every document window of
// Letters at once (Tools > User name and initials..., Task 6, reads
// and writes them here).
//
//   read(app) -> {name, initials}  the choices as kept: each
//       ./CommentCmd cleanName's (the one rule for names: one line,
//       spaces collapsed, trimmed, at most MAX code points); ''
//       when missing or not a string
//   write(app, {name, initials}) -> Promise  both cleaned so and
//       written (./WordChoices setChoice: the other keys kept)
//   KEYS  {name: 'userName', initials: 'userInitials'}
//   MAX   255
// ./CommentCmd addComment returns {needsAuthor: true} when either
// is empty: the window asks for them first.
import {choiceOf, setChoice} from './WordChoices';
import {cleanName, MAX_NAME} from './CommentCmd';

export const KEYS = Object.freeze({name: 'userName',
  initials: 'userInitials'});
export const MAX = MAX_NAME;

/** A value as kept (see the header). */
const tidy = cleanName;

/** See the header. */
export const read = (app) => ({name: tidy(choiceOf(app, KEYS.name)),
  initials: tidy(choiceOf(app, KEYS.initials))});

/** See the header. */
export async function write(app, {name, initials} = {}) {
  await setChoice(app, KEYS.name, tidy(name));
  await setChoice(app, KEYS.initials, tidy(initials));
}
