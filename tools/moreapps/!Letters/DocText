// DocText - the first handler module of ./DocRead (PART {start}):
// what a .doc holds that is not read, said once. The special
// characters are the later modules' (./DocBody: marks, breaks, tabs
// and hyphens; ./DocFields: fields; ./DocNotes, ./DocComments:
// notes and comments; ./DocPict: pictures); any other character
// below 0x20 is left out (./DocRead).
//
//   start: one note for the text boxes (a story not read)

/** The notes for stories not read. */
function stories(ctx) {
  const f = ctx.fib;
  if (f.ccpTxbx || f.ccpHdrTxbx) {
    ctx.note('text boxes are not read');
  }
}

/** See the header. */
export const PART = {start: [stories]};
