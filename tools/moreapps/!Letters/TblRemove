// TblRemove - a typed table removed whole by a table command (Batch
// C final fix wave, from ./TblCmd, which was full): Table > Delete >
// Table, and Delete > Rows or Columns over all of them.
//
//   removeTable(d, at) -> the caret  the table at path `at` removed
//       (one removeBlock, inside the caller's d.atomic), the caret in
//       the block after it (a table: its first paragraph; at the end
//       of a section or cell an empty paragraph is made, the one
//       ./RangeOps fillEmpty would make: a cell always ends with a
//       paragraph). Bookmarks: a mark in the table (at any depth,
//       loose ones between rows and cells too) whose partner is
//       outside it goes to the caret (./BookmarkKeep tableMarks,
//       stillPaired, putMarks: ends first, then starts), as a range
//       delete of the same table does (./RangeTbl); a pair wholly in
//       the table goes with it (final-1 I1)
// Pure: no desktop services.
import {reserveIds, newPara} from './Model';
import {at as walkAt} from './Walk';
import {caret} from './Selection';
import {firstPos} from './TblPos';
import {blockId} from './DocPos';
import {tableMarks, stillPaired, putMarks} from './BookmarkKeep';

const isTbl = (b) => !!b && b.type === 'tbl' && Array.isArray(b.rows);

/** See the header. */
export function removeTable(d, at) {
  const got = tableMarks(walkAt(d.doc, at), []);
  d.apply({op: 'removeBlock', at});
  let b = walkAt(d.doc, at);
  if (!b) {
    reserveIds(d.doc);
    b = newPara('');
    d.apply({op: 'insertBlock', at, block: b});
  }
  const pos = (isTbl(b) && firstPos(b)) || {id: blockId(b), off: 0};
  putMarks(d, pos, stillPaired(d.doc, got));
  return caret(pos);
}
