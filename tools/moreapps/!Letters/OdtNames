// OdtNames - the names of a parsed XML part of an OpenDocument
// package (wimplib/Xml's tree) made fixed, for ./OdtXml: OpenDocument
// 1.3 part 3 names elements and attributes by namespace, whatever
// prefix a file writes.
//
//   named(root, fail) -> the tree's weight (elements + attributes /
//       ./OdtCount ATTR_WEIGHT); the tree changed in place: a name
//       is 'text:p' (the prefix NS gives the namespace), or
//       '{uri}local' for a namespace NS does not know ('{?p}local'
//       for an unbound prefix p); an attribute without a prefix is
//       its local name; xmlns attributes (and a second attribute of
//       one name), comments and processing instructions are left
//       out; an empty array is EMPTY (shared, frozen).
//       fail(code, message) is called (and must throw) with code
//       'namespaces' for more than MAX_NS_ELEMENT declared on one
//       element, or MAX_NS_PART in the part
//   NS  namespace URI -> the prefix this reader uses
//   MAX_NS_ELEMENT 256, MAX_NS_PART 100,000
// Without recursion, the namespaces in scope kept in one Map, each
// name worked out once while they stay the same: linear in the part.
// Pure: no desktop services.
import {ATTR_WEIGHT} from './OdtCount';

/** Most namespaces declared on one element, and in one part. */
export const MAX_NS_ELEMENT = 256, MAX_NS_PART = 100000;

const O = 'urn:oasis:names:tc:opendocument:xmlns:';
/** See the header. */
export const NS = new Map([
  [O + 'office:1.0', 'office'], [O + 'style:1.0', 'style'],
  [O + 'text:1.0', 'text'], [O + 'table:1.0', 'table'],
  [O + 'drawing:1.0', 'draw'], [O + 'xsl-fo-compatible:1.0', 'fo'],
  [O + 'meta:1.0', 'meta'], [O + 'datastyle:1.0', 'number'],
  [O + 'svg-compatible:1.0', 'svg'], [O + 'chart:1.0', 'chart'],
  [O + 'dr3d:1.0', 'dr3d'], [O + 'form:1.0', 'form'],
  [O + 'script:1.0', 'script'], [O + 'config:1.0', 'config'],
  [O + 'presentation:1.0', 'presentation'],
  [O + 'manifest:1.0', 'manifest'],
  ['http://www.w3.org/1999/xlink', 'xlink'],
  ['http://purl.org/dc/elements/1.1/', 'dc'],
  ['http://www.w3.org/1998/Math/MathML', 'math'],
  ['http://www.w3.org/1999/xhtml', 'xhtml'],
  ['urn:org:documentfoundation:names:experimental:office:xmlns:' +
    'loext:1.0', 'loext'],
  ['http://openoffice.org/2009/office', 'officeooo'],
  ['urn:openoffice:names:experimental:ooo-ms-interop:xmlns:field:1.0',
    'field'],
]);

/** node's own xmlns declarations: [[prefix, uri]] ('' the default
 *  namespace), at most MAX_NS_ELEMENT. */
function declsOf(node, fail) {
  let out = null;
  for (const [n, v] of node.attrs) {
    if (n !== 'xmlns' && !n.startsWith('xmlns:')) continue;
    (out || (out = [])).push([n === 'xmlns' ? '' : n.slice(6), v]);
  }
  if (out && out.length > MAX_NS_ELEMENT) {
    fail('namespaces', 'more than ' + MAX_NS_ELEMENT +
      ' namespaces declared on one element');
  }
  return out;
}

/** The uri prefix p is bound to in scope (a Map of prefix -> the
 *  uris declared for it, innermost last), or undefined. */
const uriOf = (scope, p) => {
  const s = scope.get(p);
  return s && s.length ? s[s.length - 1] : undefined;
};

const canon = (u, l) => {
  const p = NS.get(u);
  return p ? p + ':' + l : '{' + u + '}' + l;
};

function nameOf(q, scope, isAttr) {
  const c = q.indexOf(':');
  if (c < 0) {
    const u = isAttr ? undefined : uriOf(scope, '');
    return u ? canon(u, q) : q;
  }
  const p = q.slice(0, c), local = q.slice(c + 1);
  if (p === 'xml') return q;
  const u = uriOf(scope, p);
  return u === undefined ? '{?' + p + '}' + local : canon(u, local);
}

const isDecl = (n) => n === 'xmlns' || n.startsWith('xmlns:');

/** Whether one of the first n pairs of a is named k. */
function had(a, n, k) {
  for (let j = 0; j < n; j++) if (a[j][0] === k) return true;
  return false;
}

/** node's attributes with fixed names (fix), xmlns ones and a
 *  second of one name left out: the pairs changed in place. */
function attrsOf(node, fix) {
  const a = node.attrs;
  let keep = 0, seen = null;
  for (let i = 0; i < a.length; i++) {
    if (isDecl(a[i][0])) continue;
    const k = fix(a[i][0]);
    if (seen ? seen.has(k) : had(a, keep, k)) continue;
    a[i][0] = k;
    a[keep++] = a[i];
    if (seen) seen.add(k);
    else if (keep === 8) seen = new Set(a.slice(0, 8).map((x) => x[0]));
  }
  return !keep ? EMPTY : keep < a.length ? a.slice(0, keep) : a;
}

const EMPTY = Object.freeze([]);

/** Names fixed in scope, each worked out once while scope is as it
 *  is: fix.el(q), fix.attr(q), fix.clear() when it changes. */
function fixer(scope) {
  const els = new Map(), attrs = new Map();
  const get = (m, isAttr) => (q) => {
    let k = m.get(q);
    if (k === undefined) m.set(q, k = nameOf(q, scope, isAttr));
    return k;
  };
  return {el: get(els, false), attr: get(attrs, true),
    clear() {
      els.clear();
      attrs.clear();
    }};
}

/** See the header. Depth first, with one Map of the
 *  namespaces in scope: an element's own declarations are pushed
 *  as it is entered and popped after its content (an {undo} entry
 *  on the stack), so each costs the same whatever is around it.
 *  Empty arrays are EMPTY. Returns the tree's weight (./OdtCount:
 *  elements + attributes / ATTR_WEIGHT). */
export function named(root, fail) {
  const scope = new Map(), stack = [root], fix = fixer(scope);
  let decls = 0, els = 0, attrs = 0;
  while (stack.length) {
    const node = stack.pop();
    if (node.undo) {
      for (const p of node.undo) scope.get(p).pop();
      fix.clear();
      continue;
    }
    els++;
    attrs += node.attrs.length;
    const own = declsOf(node, fail);
    if (own) {
      decls += own.length;
      if (decls > MAX_NS_PART) {
        fail('namespaces', 'more than ' + MAX_NS_PART +
          ' namespace declarations');
      }
      for (const [p, u] of own) {
        const s = scope.get(p);
        if (s) s.push(u);
        else scope.set(p, [u]);
      }
      fix.clear();
      stack.push({undo: own.map((d) => d[0])});
    }
    node.attrs = node.attrs.length ? attrsOf(node, fix.attr) : EMPTY;
    node.name = fix.el(node.name);
    const kids = node.children;
    let drop = false;
    for (const c of kids) {
      if (typeof c === 'string') continue;
      if (c && c.name !== undefined) stack.push(c);
      else drop = true;
    }
    // (comments and processing instructions left out)
    if (drop) {
      node.children = kids.filter((c) => typeof c === 'string' ||
        (c && c.name !== undefined));
    }
    if (!node.children.length) node.children = EMPTY;
  }
  return els + Math.ceil(attrs / ATTR_WEIGHT);
}
