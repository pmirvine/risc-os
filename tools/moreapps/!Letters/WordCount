// WordCount - the numbers of Edit > Word count... (./CountBox).
//
//   count(doc, sel?, L?) -> {words, chars, charsNoSpaces, paras,
//       lines, scope, partial?}
//       of the selection (a range, not a caret: the blocks it
//       covers at every depth, ./SelShape covered: a 'cells'
//       rectangle its cells, a 'mixed' range the rows it touches)
//       or, with none, of the whole document; scope ('selection' |
//       'document'). L (a ./DocLayout) gives lines (null without it)
//   countView(view) -> count of the view's selection and layout
//
// Words are the runs of non-white-space characters: a no-break space
// (U+00A0) and a no-break hyphen join; every other space (the Unicode
// white space, a tab, a line break) ends a word. As Word counts, each
// East Asian character (ideographs, kana, Hangul, Bopomofo) is a
// word of its own and ends the word beside it. Characters count code
// points (an emoji is one), with and without spaces (white space and
// the no-break space), tabs and line breaks included as one each, the
// optional hyphen as none, paragraph marks not. A paragraph is
// counted when it has any character. Lines are the layout's lines of
// the paragraphs (those a selection touches), a typed table's cells'
// too (C3 fix wave). Text counted: the
// paragraphs' text, a typed table's through ./Walk (its cells'
// paragraphs in flow order, nested tables' too: the model, D7), and
// the XML of inline items (a link, an insertion, a field, a content
// control...) and of kept blocks (an Opaque table...; a typed
// table's loose marks, which hold none): w:t, tabs and breaks, never
// a field's codes, deleted or moved-away text, ruby text, formulas,
// drawings or properties; of an mc:AlternateContent only the Choice
// (else the Fallback). The XML walks take at most 1,000,000 nodes in
// all (past that `partial` is true and the rest is left out). A
// table inside a selection counts when it lies inside it. The
// numbers: ./WordTally. Pure: no desktop services; linear.
import {orderedPos} from './EditPos';
import {covered} from './SelShape';
import {collapsed} from './Selection';
import {localName} from './Kinds';
import {hyphenText} from './InlineText';
import {forEachIn, loose} from './Walk';
import {Tally} from './WordTally';

export const NODE_LIMIT = 1e6;

/** The text of [a, e) of paragraph p into t (budget: see walk). */
function para(t, p, a, e, budget) {
  const s = p.text;
  let from = a;
  for (let i = s.indexOf('\uFFFC', a); i >= 0 && i < e;
    i = s.indexOf('\uFFFC', from)) {
    if (i > from) t.text(s.slice(from, i));
    from = i + 1;
    const x = p.inlines[i];
    if (!x) continue;
    if (x.kind === 'tab' || x.kind === 'br') t.gap();
    else if (x.kind === 'raw' && x.level === 'p' && x.node) {
      // (a link, an insertion, a field, a content control...: the
      // same walk as a kept block's)
      xml(t, x.node, budget);
    } else {
      const h = hyphenText(x);
      if (h) t.text(h);
    }
  }
  if (from < e) t.text(s.slice(from, e));
  t.end();
}

const SKIP = new Set(['del', 'moveFrom', 'delText', 'instrText',
  'drawing', 'pict', 'txbxContent', 'object', 'rt', 'oMath',
  'oMathPara']);
// properties (pPr, rPr, tblPr, trPr, tcPr, sdtPr, sectPr and their
// change records) hold no text: a w:tab there is a tab stop
const PROPS = /Pr(Change)?$/;
const END = {};

/** An element of another vocabulary (m:t of a formula...). */
const foreign = (n) => /^(m|a|wp|v|o|w10):/.test(n.name);

/**
 * The text of a kept block's XML into t; budget.left nodes may still
 * be walked (false: it ran out).
 */
function walk(t, top, budget) {
  const stack = [top];
  while (stack.length) {
    const n = stack.pop();
    if (n === END) { t.end(); continue; }
    if (typeof n === 'string') continue;
    if (!n || typeof n !== 'object') continue;
    if (--budget.left < 0) return false;
    const l = localName(n);
    if (SKIP.has(l) || PROPS.test(l) || foreign(n)) continue;
    const kids = Array.isArray(n.children) ? n.children : [];
    if (l === 'AlternateContent') {
      // (Choice and Fallback show the same: the Choice, else the
      // Fallback)
      const pick = kids.find((c) => localName(c) === 'Choice') ||
        kids.find((c) => localName(c) === 'Fallback');
      if (pick) stack.push(pick);
      continue;
    }
    if (l === 't') {
      for (const c of kids) if (typeof c === 'string') t.text(c);
      continue;
    }
    if (l === 'tab' || l === 'br' || l === 'cr') { t.gap(); continue; }
    if (l === 'noBreakHyphen') { t.text('-'); continue; }
    if (l === 'p') stack.push(END);
    for (let k = kids.length - 1; k >= 0; k--) stack.push(kids[k]);
  }
  return true;
}

/** The XML of node into t, unless the budget ran out. */
function xml(t, node, budget) {
  if (!budget.partial && !walk(t, node, budget)) budget.partial = true;
}

/** The whole of block b into t: a typed table by ./Walk (see the
 *  header), a kept block by its XML. */
function block(t, b, budget) {
  if (b.type === 'p') return para(t, b, 0, b.text.length, budget);
  if (b.type === 'opaque') return xml(t, b.node, budget);
  if (b.type !== 'tbl') return;
  forEachIn([b], [], (x) => {
    if (x.type !== 'tbl') block(t, x, budget);
    else for (const m of loose(x)) xml(t, m.node, budget);
  });
}

/** The lines of item it from offset a to e (the whole when all). */
function linesOf(it, a, e) {
  if (!it || !it.lines) return 0;
  if (a <= 0 && e >= it.block.text.length) return it.lines.length;
  let n = 0;
  for (const l of it.lines) if (l.from < e && l.to > a) n++;
  return n;
}

/** See the header. */
export function count(doc, sel, L) {
  const range = sel && !collapsed(sel) && orderedPos(doc, sel);
  const t = new Tally();
  const budget = {left: NODE_LIMIT, partial: false};
  let lines = L ? 0 : null;
  const add = (b, a, e) => {
    if (b.type === 'tbl' && L) {
      // (a typed table's cells' lines, nested tables' too)
      forEachIn([b], [], (x) => {
        if (x.type === 'p') {
          lines += linesOf(L.byId.get(x.id), 0, Infinity);
        }
      });
    }
    if (b.type !== 'p') return block(t, b, budget);
    para(t, b, a, e, budget);
    if (L) lines += linesOf(L.byId.get(b.id), a, e);
  };
  if (range) {
    // the selection's blocks at every depth (./SelShape covered: a
    // 'cells' rectangle its cells, a 'mixed' range the touched rows)
    for (const x of covered(doc, sel)) add(x.b, x.from, x.to);
  } else {
    for (const sec of doc.sections) {
      for (const b of sec.blocks) add(b, 0, b.type === 'p'
        ? b.text.length : 1);
    }
  }
  const out = {words: t.words, chars: t.chars,
    charsNoSpaces: t.noSpaces, paras: t.paras, lines,
    scope: range ? 'selection' : 'document'};
  if (budget.partial) out.partial = true;
  return out;
}

/** See the header. */
export function countView(v) {
  return count(v.d.doc, v.sel, v.L);
}
