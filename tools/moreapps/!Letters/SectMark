// SectMark - what a section break is called and which kind it is,
// for the layout (./DocItems, ./SectDeco) and ./SectBreak:
//
//   markOf(doc, s)   -> {type}: the section-end mark of section s,
//                       or null for the last section (or no such s)
//   sectLabel(type)  -> 'Section break (Next page)'...
//
// w:type says how a section STARTS, so the mark's type is the
// FOLLOWING section's: its type field, else a raw w:type with a
// string w:val it kept, else 'nextPage' (the schema's default).
// Labels: Next page, Continuous, Even page, Odd page, Next column;
// anything else 'Section break' (a Map: names from files are only
// keys). Pure: no desktop services.

const LABELS = new Map([['nextPage', 'Next page'],
  ['continuous', 'Continuous'], ['evenPage', 'Even page'],
  ['oddPage', 'Odd page'], ['nextColumn', 'Next column']]);

/** A raw w:type's string w:val in extra, or undefined. */
function rawType(extra) {
  let type;
  for (const n of Array.isArray(extra) ? extra : []) {
    if (!n || typeof n !== 'object' || n.name !== 'w:type') continue;
    for (const a of Array.isArray(n.attrs) ? n.attrs : []) {
      if (a && a[0] === 'w:val' && typeof a[1] === 'string')
        type = a[1];
    }
  }
  return type;
}

/** See the header. */
export function markOf(doc, s) {
  const secs = (doc && doc.sections) || [];
  if (!(s >= 0 && s < secs.length - 1)) return null;
  const p = (secs[s + 1] && secs[s + 1].props) || {};
  const type = typeof p.type === 'string' ? p.type : rawType(p.extra);
  return {type: type === undefined ? 'nextPage' : type};
}

/** See the header. */
export function sectLabel(type) {
  const k = LABELS.get(type);
  return k ? 'Section break (' + k + ')' : 'Section break';
}
