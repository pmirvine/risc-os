// TocParas - the paragraphs of the body that lie inside a table of
// contents' result, for drawing its entries as Word does (./LineTokens:
// a link to a _Toc bookmark there is drawn plain, whatever the
// paragraph's style).
//
//   tocParas(doc) -> Set of paragraph ids  each paragraph from the
//       one holding a TOC field's separate to the one holding its
//       end (./FieldScan scan, complex fields whose instruction is
//       TOC: a table of figures too; one container: a table in a
//       cell has its cell's paragraphs). Memoised per scan (one per
//       block list), so a layout pass pays once, not per paragraph.
//       Empty for no document
// Pure: no desktop services.
import {scan} from './FieldScan';
import {parse} from './FieldParse';
import {at as blockAt} from './Walk';

const isObj = (v) => v !== null && typeof v === 'object';
const memo = new WeakMap();            // scan result -> Set
const NONE = new Set();

/** Add the ids of field f's result paragraphs to out. */
function addResult(doc, f, out) {
  const a = f.sep.at, z = f.end.at;
  if (!Array.isArray(a) || !Array.isArray(z) || a.length !== z.length)
    return;
  for (let k = 0; k < a.length - 1; k++) if (a[k] !== z[k]) return;
  const base = a.slice(0, -1);
  for (let k = a[a.length - 1]; k <= z[z.length - 1]; k++) {
    const b = blockAt(doc, [...base, k]);
    if (isObj(b) && b.type === 'p') out.add(b.id);
  }
}

/** See the header. */
export function tocParas(doc) {
  if (!isObj(doc) || !Array.isArray(doc.sections)) return NONE;
  const fs = scan(doc);
  let got = memo.get(fs);
  if (got) return got;
  got = new Set();
  for (const f of fs) {
    if (f.simple || !f.sep || !f.end || typeof f.instr !== 'string')
      continue;
    if (parse(f.instr).name === 'TOC') addResult(doc, f, got);
  }
  memo.set(fs, got);
  return got;
}
