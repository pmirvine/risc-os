// BookmarkKeep - a deleted range keeps bookmarks whole: the rule
// ./EditRange deleteRange follows (so Backspace or Delete over a
// selection, typing over it, a cut, a paste over it...).
//
//   keptMarks(doc, o) -> [inline]  o from EditPos.orderedPos: the
//       bookmark marks (w:bookmarkStart / w:bookmarkEnd level-'p'
//       inlines) in the range from o.from to o.to whose partner (a
//       mark of the other kind with the same w:id) is outside it,
//       somewhere in the document (a mark inside a table or a
//       wrapper the range covers is inside it): their ends first,
//       then their starts, in document order. [] when the range
//       holds none (without looking further)
//   putMarks(d, pos, xs)  put them back at pos (a position {id,
//       off}), each a U+FFFC in a plain run (as read); pos at a kept
//       block (a table: a range that ended on tables both sides) puts
//       them at the start of the nearest paragraph after it, else at
//       the end of the nearest one before (every section may hold
//       only tables: then they are not put back, and nothing can
//       find them anyway)
//   putAround(d, first, last, xs)  marks of cells overwritten or
//       cleared (./ClipPasteTbl overwrite, ./RangeTbl): each START
//       put at `first` (the start of the first cell), each END at
//       `last` (the end of the last cell): a start never moves later
//       and an end never earlier, so no pair is reversed (C6 fix B3;
//       one place would put a start after an end in a cell the
//       rectangle does not cover). first comes before last in flow
//       order (the later one is filled first: first's offset stays)
//   marksIn(p, a, z, out) -> out  the bookmark marks of paragraph p
//       in [a, z) pushed as {kind, id, x} (the one reader of a
//       range's marks)
//   tableMarks(t, out) -> out  every bookmark mark of typed table t
//       at every depth (its cells' paragraphs' and its loose ones,
//       nested tables' too: a loose node as a level-'p' raw inline,
//       so it can be put back in a paragraph) pushed as marksIn's:
//       a table a deletion takes whole (C7 fix A2)
//   markOf(node) -> {kind: 'start' | 'end', id} | null  a mark node's
//       (a table's lead or tail holds the nodes themselves)
//   stillPaired(doc, got) -> [inline]  for a deletion in a table
//       (Batch C3.4, ./RangeTbl): got (marksIn's, collected before
//       the deletion) read against doc AFTER it: the marks gone
//       from doc whose partner is still somewhere in it, ends
//       first, then starts (keptMarks' rule, counted after the fact
//       instead of by what the range covers; a mark the deletion
//       moved, as ./TblEdit deleteRows moves a removed row's to the
//       next row, is not put back twice)
//
// So a bookmark that only starts (or ends) in a deleted range moves
// its start (end) to where the range was, as Word does: a pair is
// never broken by a deletion. A bookmark wholly in the range goes
// with it; a mark inside a typed table the range covers counts as in
// the range (its partner outside: it goes to where the range was;
// C7 fix); marks inside a kept item (an Opaque table: at its edge,
// ./BookmarkFind) go with that item; an end with no start anywhere
// (or a start with no end) is not kept. Pure: no desktop services.
import {OBJ} from './Model';
import {localName} from './Kinds';
import {findBlock, neighbour, topOnly} from './EditPos';
import {cmpPath, samePath} from './Path';
import {marks} from './BookmarkFind';
import {forEachIn, loose} from './Walk';

const KIND = {bookmarkStart: 'start', bookmarkEnd: 'end'};

/** The id of a mark node (any prefix), or null. */
function idOf(n) {
  for (const [k, v] of Array.isArray(n.attrs) ? n.attrs : []) {
    if (String(k).split(':').pop() === 'id') return String(v);
  }
  return null;
}

/** The direct marks in the range's top-level paragraphs and in the
 *  typed tables it covers: [{kind, id, x}] (a range with an end in a
 *  cell is ./RangeTbl's: refused). */
function inRange(doc, o) {
  if (!topOnly(o)) throw new RangeError('a range in a table');
  const out = [], {from, to, f, t} = o;
  for (let n = f; n && n.rank <= t.rank; n = neighbour(doc, n, 1)) {
    const b = n.b;
    if (b.type === 'tbl' && Array.isArray(b.rows) &&
      (b !== f.b || from.off === 0) && (b !== t.b || to.off === 1)) {
      tableMarks(b, out);
    }
    if (b.type !== 'p') continue;
    marksIn(b, b === f.b ? from.off : 0, b === t.b ? to.off
      : b.text.length, out);
  }
  return out;
}

/** See the header. */
export function tableMarks(t, out) {
  forEachIn([t], [], (b) => {
    if (b.type === 'p') marksIn(b, 0, b.text.length, out);
    if (b.type !== 'tbl' || !Array.isArray(b.rows)) return;
    for (const {node} of loose(b)) {
      const m = markOf(node);
      if (m) out.push({kind: m.kind, id: m.id, x: {kind: 'raw',
        level: 'p', node, text: ''}});
    }
  });
  return out;
}

/** See the header. */
export function markOf(n) {
  const k = n && typeof n === 'object' ? localName(n) : '';
  return Object.hasOwn(KIND, k) ? {kind: KIND[k], id: idOf(n)} : null;
}

/** See the header. */
export function marksIn(b, a, z, out) {
  for (let k = b.text.indexOf(OBJ, a); k >= 0 && k < z;
    k = b.text.indexOf(OBJ, k + 1)) {
    const x = b.inlines[k];
    const m = x && x.kind === 'raw' && x.level === 'p' &&
      markOf(x.node);
    if (m) out.push({kind: m.kind, id: m.id, x});
  }
  return out;
}

/** The marks of xs ({kind, id}) by `kind id`: Map key -> count. */
function count(xs) {
  const c = new Map();
  for (const m of xs) {
    const k = m.kind + ' ' + m.id;
    c.set(k, (c.get(k) || 0) + 1);
  }
  return c;
}

/** got's marks whose partner is in doc: their ends, then starts. */
const partnered = (got, has) => {
  const keep = (kind, other) => got.filter((m) => m.kind === kind &&
    m.id !== null && has(other, m.id)).map((m) => m.x);
  return [...keep('end', 'start'), ...keep('start', 'end')];
};

/** See the header. */
export function stillPaired(doc, got) {
  if (!got.length) return [];
  const all = count(marks(doc));
  const gone = got.filter((m) => !all.has(m.kind + ' ' + m.id));
  return partnered(gone, (kind, id) => all.has(kind + ' ' + id));
}

/** Block path `at` before (<0), at (0) or after (>0) location b. */
const cmp = (at, b) => cmpPath(at, b.at);

/** Path `at` is inside the table at location b (a cell's block). */
const inside = (at, b) => at.length > b.at.length &&
  samePath(at.slice(0, b.at.length), b.at);

/**
 * Mark m (./BookmarkFind marks) is deleted with the range: in a
 * paragraph within it (inside a wrapper: the wrapper's offset), in a
 * kept block the range covers, or in a typed table the range covers
 * (one at an end: from its start edge, to its end edge).
 */
function covered(m, o) {
  if (inside(m.at, o.f)) return o.from.off === 0;
  if (inside(m.at, o.t)) return o.to.off === 1;
  const a = cmp(m.at, o.f), z = cmp(m.at, o.t);
  if (a < 0 || z > 0) return false;
  if (m.table) {
    return (a > 0 || o.from.off === 0) && (z < 0 || o.to.off === 1);
  }
  return (a > 0 || m.off >= o.from.off) && (z < 0 || m.off < o.to.off);
}

/** See the header. */
export function keptMarks(doc, o) {
  const got = inRange(doc, o).filter((m) => m.id !== null);
  if (!got.length) return [];
  const ms = marks(doc);
  const all = count(ms), here = count(ms.filter((m) => covered(m, o)));
  return partnered(got, (kind, id) => {
    const k = kind + ' ' + id;
    return (all.get(k) || 0) - (here.get(k) || 0) > 0;
  });
}

/** The paragraph nearest kept block loc among its container's
 *  blocks (./EditPos neighbour): {loc, off} or null. */
function nearPara(doc, loc) {
  for (let n = neighbour(doc, loc, 1); n; n = neighbour(doc, n, 1)) {
    if (n.b.type === 'p') return {loc: n, off: 0};
  }
  for (let n = neighbour(doc, loc, -1); n; n = neighbour(doc, n, -1)) {
    if (n.b.type === 'p') return {loc: n, off: n.b.text.length};
  }
  return null;
}

/** See the header. */
export function putMarks(d, pos, xs) {
  if (!xs.length || !pos) return;
  let loc = findBlock(d.doc, pos.id), off = pos.off;
  if (loc && loc.b.type !== 'p') {
    const near = nearPara(d.doc, loc);
    loc = near && near.loc;
    off = near && near.off;
  }
  if (!loc) return;
  const inlines = {};
  xs.forEach((x, k) => { inlines[k] = x; });
  d.apply({op: 'spliceText', block: loc.at, at: off,
    del: 0, content: {text: OBJ.repeat(xs.length), inlines,
      runs: [{start: 0, end: xs.length, rPr: {extra: []}}]}});
}

/** See the header. */
export function putAround(d, first, last, xs) {
  const isEnd = (x) => (markOf(x.node) || {}).kind === 'end';
  putMarks(d, last, xs.filter(isEnd));
  putMarks(d, first, xs.filter((x) => !isEnd(x)));
}
