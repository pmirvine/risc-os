// StartersCareers - the Careers group of starter templates: every
// placeholder in [square brackets]; British "CV"; A4.
//
//   cvSimple()     one column, margins 1440 (text width 9026): the
//     name as Title, a centred contact line, then Profile,
//     Experience, Education, Skills and Interests as Heading 1 with
//     an accent rule under each. A role is a bold line with its dates
//     on a right tab at 9026, the employer in italics, then bullets.
//   cvTwoColumn()  margins 1134 (text width 9638): one borderless
//     table of one row, 2800 + 6838 twips. The left column is shaded
//     with a light tint of accent 1 (a theme tint, no RGB) and holds
//     the name, contact details, Skills and Languages; the right
//     holds Profile, Experience and Education, its dates on a right
//     tab at 6600 (the cell width less both cell margins).
import {para, run, tab, list, table, starterDoc} from './StarterKit';

const RULE = {bottom: {sz: 8, space: 1, themeColor: 'accent1'}};
const TIGHT = {spacing: {after: 0}};
const h1 = (t, o = {}) => para(t, {style: 'Heading1', ...o});

/** A role: bold title, dates on a right tab, employer, bullets. */
function role(at, title, dates, who, points) {
  return [
    para([run(title, {b: true}), tab(), dates], {keepNext: true,
      spacing: {before: 120, after: 0},
      tabs: [{pos: at, val: 'right'}]}),
    para(run(who, {i: true}), {...TIGHT, keepNext: true}),
    ...list(points, 'bullet', {spacing: {after: 0}}),
  ];
}
const points = (n) => [`[Achievement ${n}, with a result]`,
  `[Achievement ${n + 1}, with a result]`];

/** See the header. */
export function cvSimple() {
  const sec = (t) => h1(t, {border: RULE});
  return starterDoc({title: 'CV (simple)', body: [
    para('[Your name]', {style: 'Title'}),
    para('[Address] | [Telephone] | [Email]', {align: 'center',
      spacing: {after: 120}}),
    sec('Profile'),
    para('[Two or three sentences on who you are, what you do best ' +
      'and the post you want.]'),
    sec('Experience'),
    ...role(9026, '[Job title]', '[Month Year] - [Month Year]',
      '[Employer], [Town]', points(1)),
    ...role(9026, '[Job title]', '[Month Year] - [Month Year]',
      '[Employer], [Town]', points(1)),
    sec('Education'),
    ...role(9026, '[Qualification]', '[Year] - [Year]',
      '[School or college], [Town]', ['[Subjects or grades]',
        '[Project, prize or activity]']),
    sec('Skills'),
    para([run('Professional: ', {b: true}), '[skill, skill, skill]'],
      TIGHT),
    para([run('Practical: ', {b: true}), '[skill, skill, skill]']),
    sec('Interests'),
    para('[Two or three interests that say something about you.]'),
  ]});
}

/** See the header. */
export function cvTwoColumn() {
  const side = (t) => para(t, {style: 'Heading2'});
  const left = [
    para('[Your name]', {style: 'Title'}),
    para([run('Contact', {b: true})], {spacing: {after: 60}}),
    para('[Address]', TIGHT), para('[Telephone]', TIGHT),
    para('[Email]', {spacing: {after: 240}}),
    side('Skills'),
    ...list(['[Skill]', '[Skill]', '[Skill]', '[Skill]'], 'bullet',
      {spacing: {after: 0}}),
    side('Languages'),
    para('[Language, level]', TIGHT), para('[Language, level]', TIGHT),
  ];
  const right = [
    h1('Profile', {border: RULE}),
    para('[Two or three sentences on who you are, what you do best ' +
      'and the post you want.]'),
    h1('Experience', {border: RULE}),
    ...role(6600, '[Job title]', '[Year] - [Year]',
      '[Employer], [Town]', points(1)),
    ...role(6600, '[Job title]', '[Year] - [Year]',
      '[Employer], [Town]', points(1)),
    h1('Education', {border: RULE}),
    ...role(6600, '[Qualification]', '[Year] - [Year]',
      '[School or college], [Town]', ['[Subjects or grades]']),
  ];
  const tint = {themeFill: 'accent1', themeFillTint: '33'};
  return starterDoc({title: 'CV (two column)', tailGap: 'tiny',
    pgMar: {'w:top': 1134,
    'w:right': 1134, 'w:bottom': 1134, 'w:left': 1134},
  body: [table({cols: [2800, 6838], rows: [{height: 14000, cells: [
    {content: left, shade: tint}, {content: right}]}]})]});
}
