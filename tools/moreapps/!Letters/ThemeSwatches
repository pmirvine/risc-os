// ThemeSwatches - the theme block of the colour picker: 6 rows x 10
// columns as Word's own (Background 1, Text 1, Background 2, Text 2,
// Accent 1-6). Pure.
//
//   grid(theme) -> rows x cols of {rgb: 'RRGGBB',
//     ref: {themeColor, themeTint?, themeShade?}, name}
//     Row 0 is the base colour; rows 1-5 are Word's lighter/darker
//     steps. A ref never carries both a tint and a shade. rgb is
//     ThemeRead.colorOf(theme, ref).
//
// Word's levels (themeTint / themeShade, hex): lighter 80/60/40% =
// 33/66/99, darker 25/50% = BF/7F, text lighter 50/35/25/15% =
// 7F/A6/BF/D9, background darker 5/15/25/35/50% = F2/D9/BF/A6/7F,
// Background 2 darker 10/25/50/75/90% = E6/BF/7F/3F/1A.
import {colorOf} from './ThemeRead';

export const COLS = 10;
export const ROWS = 6;

const t = (v) => ({themeTint: v});
const s = (v) => ({themeShade: v});
const ACCENT = [[t('33'), 'Lighter 80%'], [t('66'), 'Lighter 60%'],
  [t('99'), 'Lighter 40%'], [s('BF'), 'Darker 25%'],
  [s('7F'), 'Darker 50%']];
const COLUMNS = [
  ['background1', 'White, Background 1',
    [[s('F2'), 'Darker 5%'], [s('D9'), 'Darker 15%'],
      [s('BF'), 'Darker 25%'], [s('A6'), 'Darker 35%'],
      [s('7F'), 'Darker 50%']]],
  ['text1', 'Black, Text 1',
    [[t('7F'), 'Lighter 50%'], [t('A6'), 'Lighter 35%'],
      [t('BF'), 'Lighter 25%'], [t('D9'), 'Lighter 15%'],
      [t('F2'), 'Lighter 5%']]],
  ['background2', 'Background 2',
    [[s('E6'), 'Darker 10%'], [s('BF'), 'Darker 25%'],
      [s('7F'), 'Darker 50%'], [s('3F'), 'Darker 75%'],
      [s('1A'), 'Darker 90%']]],
  ['text2', 'Text 2', ACCENT],
  ...[1, 2, 3, 4, 5, 6].map((n) =>
    ['accent' + n, 'Accent ' + n, ACCENT]),
];

/** See the header. */
export function grid(theme) {
  const rows = [];
  for (let r = 0; r < ROWS; r++) {
    rows.push(COLUMNS.map(([themeColor, base, steps]) => {
      const ref = {themeColor};
      let name = base;
      if (r > 0) {
        Object.assign(ref, steps[r - 1][0]);
        name = base.split(',').slice(-1)[0].trim() + ', ' +
          steps[r - 1][1];
        if (themeColor === 'background1') name = 'White, ' + name;
        if (themeColor === 'text1') name = 'Black, ' + name;
      }
      return {rgb: colorOf(theme, ref), ref, name};
    }));
  }
  return rows;
}
