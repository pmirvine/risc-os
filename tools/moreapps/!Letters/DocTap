// DocTap - the properties of a .doc table row ([MS-DOC] 2.6.4 the
// table sprms, applied to its row mark: TDefTableOperand, TC80,
// TCGRF, TableBordersOperand(80), DefTableShdOperand, Shd(80),
// TableBrc(80)Operand, TableShadeOperand, VertMergeOperand,
// CellRangeVertAlign) for ./DocTable; pure.
//
//   tapOf(prls, note) -> tap  the row's {centers, cells, trPr,
//       tblPr, gap}: centers the rgdxaCenter edges (twips, made
//       non-decreasing and at most +-MAX_POS), cells one per cell
//       definition {horz (0 none, 1 merged into the one before, 2
//       the first of a merged set), vert (0, 1 continue, 3
//       restart), vAlign, flow, bdr {top...} (sides that draw a
//       line), shd (fill)}; trPr {trHeight?, tblHeader?,
//       cantSplit?}; tblPr {jc?, tblBorders?, tblW?, shd?, tblInd?}
//       (the table's, from its first row); key the values of the
//       sprms that make two rows different tables ([MS-DOC] 2.4.3:
//       sprmTIstd, sprmTFBiDi(90), sprmTPc, sprmTDxaAbs, TDyaAbs)
// Applied in order, as Word does: sprmTDefTable (the cells), the
// shading (sprmTDefTableShd / 2nd / 3rd, which include the table
// style's; else their Raw forms; else sprmTDefTableShd80),
// sprmTSetShd, sprmTSetBrc(80), sprmTVertMerge, sprmTVertAlign,
// sprmTTableBorders(80), sprmTDyaRowHeight (> 0 at least, < 0
// exactly), sprmTTableHeader, sprmTFCantSplit (not the 90 form:
// [MS-DOC] says to ignore it; Word sets it on merged rows),
// sprmTJc(90),
// sprmTTableWidth, sprmTWidthIndent (else the first edge plus
// sprmTDxaGapHalf: the indent),
// sprmTSetShdTable. A cell's border from its TC80 is kept only when
// it draws a line (nil and none fall back to the table's);
// sprmTSetBrc's are kept as given. sprmTInsert, sprmTDelete,
// sprmTDxaCol, sprmTMerge and sprmTSplit change cells after the
// fact: not read (a note). Operands too short are left out.
import {OPS, u8, u16, i16} from './DocSprm';
import {brc, brc80, shdFill, shd80Fill, clamp} from './DocValues';

export const MAX_POS = 31680 * 2, MAX_DEFS = 255;
const EDITS = 'table cells inserted, deleted or merged after the ' +
  'row was made are not read';
const SIDES4 = ['top', 'left', 'bottom', 'right'];
const SIDES6 = [...SIDES4, 'insideH', 'insideV'];
const FLOW = [undefined, 'tbRl', undefined, 'btLr', 'lrTbV', 'tbRlV'];
const VA = ['top', 'center', 'bottom'];
const JC = ['left', 'center', 'right'];
const FTS = [undefined, 'auto', 'pct', 'dxa'];
const SHD_AT = new Map([[OPS.TDefTableShd, 0], [OPS.TDefTableShd2nd,
  22], [OPS.TDefTableShd3rd, 44]]);
const RAW_AT = new Map([[OPS.TDefTableShdRaw, 0],
  [OPS.TDefTableShdRaw2nd, 22], [OPS.TDefTableShdRaw3rd, 44]]);
const KEY_OPS = new Set([OPS.TIstd, OPS.TFBiDi, OPS.TFBiDi90,
  OPS.TPc, OPS.TDxaAbs, OPS.TDyaAbs]);
const EDIT_OPS = new Set([OPS.TInsert, OPS.TDelete, OPS.TDxaCol,
  OPS.TMerge, OPS.TSplit]);

const lineOf = (b) => (b && b.side.val !== 'none' ? b.side
  : undefined);

/** A cell definition from TC80 bytes at `at` (none: defaults). */
function cellOf(v, at) {
  const c = {horz: 0, vert: 0, vAlign: undefined, flow: undefined,
    bdr: {}, shd: undefined};
  if (!v || at + 2 > v.length) return c;
  const g = u16(v, at);
  const h = g & 3;
  c.horz = h === 1 ? 1 : h ? 2 : 0;
  c.flow = FLOW[(g >> 2) & 7];
  c.vert = (g >> 5) & 3;
  c.vAlign = VA[(g >> 7) & 3];
  if (at + 20 <= v.length) {
    SIDES4.forEach((s, k) => {
      const side = lineOf(brc80(v, at + 4 + 4 * k));
      if (side) c.bdr[s] = side;
    });
  }
  return c;
}

/** sprmTDefTable: the edges and the cell definitions. */
function defTable(t, v) {
  const n = Math.min(u8(v, 0), MAX_DEFS);
  const centers = [];
  let last = -MAX_POS;
  for (let i = 0; i <= n && 1 + 2 * i + 2 <= v.length; i++) {
    last = Math.max(last, clamp(i16(v, 1 + 2 * i), -MAX_POS, MAX_POS));
    centers.push(last);
  }
  t.centers = centers;
  const tc = 1 + 2 * (n + 1);
  t.cells = [];
  for (let i = 0; i < n; i++) t.cells.push(cellOf(v, tc + 20 * i));
}

/** Cells itcFirst..itcLim of the 2-byte ItcFirstLim at v[at]. */
function range(t, v, at, fn) {
  const lim = Math.min(u8(v, at + 1), t.cells.length);
  for (let i = u8(v, at); i < lim; i++) fn(t.cells[i]);
}

function shading(t, v, from, raw) {
  const fills = [];
  if (raw === 80) {
    for (let i = 0; 2 * i + 2 <= v.length; i++) {
      fills.push(shd80Fill(u16(v, 2 * i)));
    }
  } else {
    for (let i = 0; 10 * i + 10 <= v.length; i++) {
      fills.push(shdFill(v, 10 * i));
    }
  }
  fills.forEach((f, i) => {
    const c = t.cells[from + i];
    if (c) c.shd = f;
  });
}

function borders(t, v, wide) {
  const o = {};
  SIDES6.forEach((s, k) => {
    const b = wide ? brc(v, 8 * k) : brc80(v, 4 * k);
    if (b) o[s] = b.side;
  });
  if (Object.keys(o).length) t.tblPr.tblBorders = o;
}

function setBrc(t, v, wide) {
  const b = wide ? brc(v, 3) : brc80(v, 3);
  if (!b) return;
  const bits = u8(v, 2);
  range(t, v, 0, (c) => SIDES4.forEach((s, k) => {
    if (bits & (1 << k)) c.bdr[s] = b.side;
  }));
}

function width(v, at) {
  const type = FTS[u8(v, at)], w = i16(v, at + 1);
  if (!type || (type !== 'auto' && w < 0)) return undefined;
  return {w: type === 'auto' ? 0 : Math.min(w, type === 'pct' ? 5000
    : 31680), type};
}

function one(t, s, note, shd) {
  const v = s.operand, op = s.op;
  if (KEY_OPS.has(op)) t.key += op + ':' + [...v].join(',') + ';';
  switch (op) {
  case OPS.TDefTable: return defTable(t, v);
  case OPS.TDefTableShd80: return shd.push([v, 0, 80, 3]);
  case OPS.TSetShd:
    if (v.length >= 12) {
      range(t, v, 0, (c) => { c.shd = shdFill(v, 2); });
    }
    return;
  case OPS.TSetBrc80: return setBrc(t, v, false);
  case OPS.TSetBrc: return setBrc(t, v, true);
  case OPS.TVertMerge: {
    const c = t.cells[u8(v, 0)];
    if (c && v.length >= 2) c.vert = u8(v, 1) & 3;
    return;
  }
  case OPS.TVertAlign:
    if (v.length >= 3) {
      range(t, v, 0, (c) => { c.vAlign = VA[u8(v, 2)]; });
    }
    return;
  case OPS.TTableBorders80: return borders(t, v, false);
  case OPS.TTableBorders: return borders(t, v, true);
  case OPS.TDyaRowHeight: {
    const h = i16(v);
    if (h) {
      t.trPr.trHeight = {val: Math.min(Math.abs(h), 31680),
        hRule: h < 0 ? 'exact' : 'atLeast'};
    } else delete t.trPr.trHeight;
    return;
  }
  case OPS.TTableHeader: t.trPr.tblHeader = u8(v) !== 0; return;
  case OPS.TFCantSplit:
    t.trPr.cantSplit = u8(v) !== 0;
    return;
  case OPS.TJc: case OPS.TJc90: t.jc = JC[u16(v)]; return;
  case OPS.TTableWidth: t.tblW = width(v, 0); return;
  case OPS.TWidthIndent: t.ind = width(v, 0); return;
  case OPS.TDxaGapHalf: t.gap = Math.max(0, i16(v)); return;
  case OPS.TSetShdTable:
    if (v.length >= 10) t.tableShd = shdFill(v, 0);
    return;
  default:
    if (SHD_AT.has(op)) shd.push([v, SHD_AT.get(op), 0, 1]);
    else if (RAW_AT.has(op)) shd.push([v, RAW_AT.get(op), 0, 2]);
    else if (EDIT_OPS.has(op) && note) note(EDITS);
  }
}

/** See the header. */
export function tapOf(prls, note) {
  const t = {centers: [], cells: [], trPr: {}, tblPr: {}, gap: 0,
    key: ''};
  const shd = [];
  for (const s of prls || []) one(t, s, note, shd);
  // the shading: the best kind given (with the table style's, then
  // raw, then 80), each in its place; sprmTSetShd's after
  const kind = Math.min(4, ...shd.map((x) => x[3]));
  const set = t.cells.map((c) => c.shd);
  for (const c of t.cells) c.shd = undefined;
  for (const [v, from, raw, k] of shd) {
    if (k === kind) shading(t, v, from, raw);
  }
  t.cells.forEach((c, i) => {
    if (set[i] !== undefined) c.shd = set[i];
  });
  if (t.trPr.tblHeader === false) delete t.trPr.tblHeader;
  if (t.trPr.cantSplit === false) delete t.trPr.cantSplit;
  if (t.jc === 'center' || t.jc === 'right') t.tblPr.jc = t.jc;
  if (t.tblW && t.tblW.type !== 'auto') t.tblPr.tblW = t.tblW;
  const left = t.ind && t.ind.type === 'dxa' ? t.ind.w
    : (t.centers[0] || 0) + t.gap;
  if (left && !t.tblPr.jc) {
    t.tblPr.tblInd = {w: clamp(left, -31680, 31680), type: 'dxa'};
  }
  if (t.tableShd && t.tableShd !== 'none') {
    t.tblPr.shd = {val: 'clear', color: 'auto', fill: t.tableShd};
  }
  return t;
}
