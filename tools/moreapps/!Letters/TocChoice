// TocChoice - the Update Table of Contents choice's start (./TocBox
// tocUpdateBox) and why page numbers only cannot run.
//
//   modeFor(doc, f, paged) -> 'pages' | 'entire'  the update chosen
//       first for table f of doc: Update entire table when the
//       table has no entries (none of ./TocUpdate entriesOf's has a
//       TOC level, a page number or a link: the "No table of
//       contents entries found." form, where page numbers only has
//       nothing to do) or when the view gives no pages (paged
//       false: Outline, Web layout; ./FieldUpdate paged); else
//       Update page numbers only, Word's first choice (f not a
//       table: the same)
//   pagesWhy(paged) -> string | null  NO_PAGES when page numbers
//       only cannot run because the view gives no pages, else null
//   NO_PAGES  'Page numbers need Print layout: choose Update entire
//       table.'
//
// Pure: no desktop services.
import {entriesOf} from './TocUpdate';

export const NO_PAGES = 'Page numbers need Print layout: choose ' +
  'Update entire table.';

/** See the header. */
export function modeFor(doc, f, paged) {
  if (!f || typeof f !== 'object') return 'pages';
  if (!paged) return 'entire';
  const real = (e) => e.level > 0 || e.page !== null || !!e.anchor;
  return entriesOf(doc, f).some(real) ? 'pages' : 'entire';
}

/** See the header. */
export const pagesWhy = (paged) => (paged ? null : NO_PAGES);
