// OdtUnits - OpenDocument values (OpenDocument 1.3 part 3, 18.3:
// length, percent, color) read the way ./OdtProps needs them.
//
//   points(s) -> points | undefined   a length: a decimal number
//       (a minus sign allowed, no exponent) and a unit cm mm in
//       inch pt pc px ('2.5cm', '-0.25in'); anything else, or more
//       than MAX_PT points either way: undefined (never NaN)
//   twips(s), halfPts(s) -> whole twips / half-points | undefined
//   pct(s) -> number | undefined      '120%' -> 120
//   hex(s) -> 'RRGGBB' | undefined     '#rrggbb' (six hex digits)
//   num(s) -> number | undefined      a plain decimal number
//   whole(s) -> integer >= 0 | undefined  a count: decimal digits only
//       (no sign, point or exponent); more than 15 digits: Infinity
// Values longer than MAX_LEN characters are none. No regular
// expressions: each is one pass over a short string.
// Pure: no desktop services.

export const MAX_PT = 100000;
const MAX_LEN = 40;
const PER = new Map([['cm', 72 / 2.54], ['mm', 72 / 25.4],
  ['in', 72], ['inch', 72], ['pt', 1], ['pc', 12], ['px', 0.75]]);

const isDigit = (c) => c >= 48 && c <= 57;

/** The length of the decimal number at the start of s (0: none). */
function numLen(s) {
  let i = s.charCodeAt(0) === 45 ? 1 : 0, digits = 0, dot = false;
  for (; i < s.length; i++) {
    const c = s.charCodeAt(i);
    if (isDigit(c)) digits++;
    else if (c === 46 && !dot) dot = true;
    else break;
  }
  return digits ? i : 0;
}

/** See the header. */
export function num(s) {
  if (typeof s !== 'string' || !s || s.length > MAX_LEN) {
    return undefined;
  }
  const t = s.trim();
  const n = numLen(t);
  if (!n || n !== t.length) return undefined;
  const v = Number(t);
  return Number.isFinite(v) ? v : undefined;
}

/** See the header. */
export function points(s) {
  if (typeof s !== 'string' || !s || s.length > MAX_LEN) {
    return undefined;
  }
  const t = s.trim();
  const n = numLen(t);
  const per = n ? PER.get(t.slice(n).toLowerCase()) : undefined;
  if (per === undefined) return undefined;
  const v = Number(t.slice(0, n)) * per;
  return Number.isFinite(v) && Math.abs(v) <= MAX_PT ? v : undefined;
}

/** See the header. */
export function twips(s) {
  const p = points(s);
  return p === undefined ? undefined : Math.round(p * 20);
}

/** See the header. */
export function halfPts(s) {
  const p = points(s);
  return p === undefined ? undefined : Math.round(p * 2);
}

/** See the header. */
export function pct(s) {
  if (typeof s !== 'string' || !s.endsWith('%')) return undefined;
  return num(s.slice(0, -1));
}

/** See the header. */
export function hex(s) {
  if (typeof s !== 'string' || s.length !== 7 || s[0] !== '#') {
    return undefined;
  }
  for (let i = 1; i < 7; i++) {
    const c = s.charCodeAt(i), l = c | 0x20;
    if (!isDigit(c) && !(c >= 65 && l >= 97 && l <= 102)) {
      return undefined;
    }
  }
  return s.slice(1).toUpperCase();
}

/** See the header. */
export function whole(s) {
  if (typeof s !== 'string') return undefined;
  const t = s.trim();
  if (!t) return undefined;
  for (let i = 0; i < t.length; i++) {
    if (!isDigit(t.charCodeAt(i))) return undefined;
  }
  return t.length > 15 ? Infinity : Number(t);
}
