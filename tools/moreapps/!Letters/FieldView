// FieldView - the View menu's field items for a document's window
// (Batch D, D18): Field codes (per window, not kept) and Field
// shading (the app's choice, kept in Choices:Letters as
// 'fieldShading', ./WordChoices: every window follows it at once).
//
//   shadeFor(dw) -> {mode, sel}  getters ./FieldShade reads when a
//       window paints: the app's choice (./FieldShade modeOf) and
//       dw.view.sel (the header's in the header and footer mode)
//   shadingOf(app) -> a mode of ./FieldShade MODES
//   setShading(app, mode)  the choice set and written; every window
//       of the app drawn again. Not a mode: nothing
//   codesOn(dw) -> bool  View > Field codes is on in dw
//   setCodes(dw, on) -> bool  shows the codes (./FieldCodes) or the
//       results: dw.fields.codes, then the document laid out again
//       (dw.relayout: every line, headers and footers too), the
//       caret's line kept where it was in the window (false: as it
//       was already). Display only: the document is not changed and
//       no undo step is made; Shift+F9 (./KeymapMore 'fieldCodes',
//       ./DocKeys)
// Imports no desktop services.
import {modeOf} from './FieldShade';
import {choiceOf, setChoice} from './WordChoices';

const KEY = 'fieldShading';

/** See the header. */
export const shadingOf = (app) => modeOf(choiceOf(app, KEY));

/** See the header. */
export function shadeFor(dw) {
  return {
    get mode() { return shadingOf(dw.app); },
    get sel() { return dw.view ? dw.view.sel : null; },
  };
}

/** See the header. */
export function setShading(app, mode) {
  if (modeOf(mode) !== mode) return;
  setChoice(app, KEY, mode);
  for (const d of app.docs.values()) {
    if (d.win && d.win.isOpen) d.win.invalidate();
  }
}

/** See the header. */
export const codesOn = (dw) => !!(dw.fields && dw.fields.codes);

/** See the header. */
export function setCodes(dw, on) {
  if (!!on === codesOn(dw)) return false;
  const v = dw.view, w = dw.win;
  const c0 = v.caretRect(), y0 = c0 ? c0.y - w.scrollY : null;
  dw.fields = {...dw.fields, codes: !!on};
  dw.relayout();
  const c1 = v.caretRect();
  if (c1 && y0 !== null) {
    w.scrollTo(w.scrollX, Math.max(0, Math.round(c1.y - y0)));
  }
  w.invalidate();
  return true;
}
