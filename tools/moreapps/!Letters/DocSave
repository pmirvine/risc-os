// DocSave - saving the document of a window (./AppWin): Save, Save
// as, the Save boxes of its menu (./WinMenu), and what a save
// changes in the window.
//
//   save(dw) -> Promise<boolean>   Save: a titled document is written
//                  to its file; an untitled one opens the Save as box
//                  (centred), true only once it has been saved from
//                  there (false when the box is closed and stays
//                  closed: not when the menu is opened again over it).
//                  One such promise per window: Save again while it
//                  waits gives the same one, and leaves the name typed
//                  in an open box as it is
//   saveAsTo(dw, path) -> Promise<boolean>   write it as path and
//                  take that name; an error is reported, false
//   writeTo(dw, path) -> Promise<path>       the same, but throws
//                  (the Save box reports what it throws); null when
//                  nothing was written (Discard, below). The saves
//                  of a window run one after another, in the order
//                  asked: a slow one never overwrites a later one
//   writeTo(dw, path, format)  the same in format ('docx' | 'rtf';
//                  default the window's, dw.format, when it runs):
//                  written, the window's format is format from then
//                  on (later Saves follow it), and its Save boxes'
//                  file type with it
//   bytesOf(dw, format = dw.format) -> Promise<Uint8Array>   the
//                  bytes (dw.saveBytes(format)) in that format: 'rtf'
//                  by ./RtfWrite (./LostBox rtfOf: kept while the
//                  document is unchanged; a new copy of it each
//                  time), else a .docx by ./DocxWrite
//   idle(dw) -> Promise    settles when the window's saves (those
//                  asked so far) have ended; saving(dw): any running
//   canWrite(dw, path, asTemplate) -> null, or why not: path is the
//                  file of another open document (saving over it is
//                  refused), or the file an imported document was
//                  opened from (dw.importedFrom: ./Open IMPORTERS);
//                  asTemplate: a template's own document may be
//                  saved as a template over its source
//   saveBox(dw)  the Save box of Save as (made once, kept in
//                  dw.boxes: ./Boxes); OK onto another file that is
//                  there asks Replace / Cancel (./Replace). It saves
//                  in the format it was last opened for (boxFormat),
//                  looked up when it saves. Save a copy is ./CopySave
//   openSaveBox(dw, format, at)  the Save box for format (./SaveAsBox
//                  Continue): its name (SaveState suggestName with
//                  format; a name typed in the box open is kept, its
//                  extension switched if the format changes) and file
//                  type; an untitled document's
//                  opens centred, as Save opens it (a save() waiting
//                  on it then settles from it), any other's as a menu
//                  at at ({x, y}: where the Save as box was), else
//                  centred
//   saveTemplate(dw, path) -> Promise<path>   a COPY of the document
//                  as a Word template (.dotx, file type &A83) at path;
//                  the window (name, path, format, '*', importedFrom)
//                  and the Doc are untouched, a failed write too:
//                  canWrite refuses, notSaved tells. ./TemplateSave
//                  is its Save box (./SaveAsBox's third choice)
//   boxFormat(dw) -> the format the Save box saves in now
//   commitComposition(view)  the composing text typed in
//   notSaved(name, e) -> Error  "'name' could not be saved: why"
// A file saved goes to app.noteRecent (./RecentFiles); app.recent
// gives the Save box's directory for an untitled document
// (SaveState.defaultDir), with a name no file there has.
//
// A save first puts an input method's composing text into the
// document (the method's late commit of it is not typed again:
// ./EditInput), ends the undo step being typed and takes the state's id
// (Document.stateId); writeDocx makes the parts before its first
// await, so the bytes are that state. Only when vfs.writeFile has
// succeeded is that state marked saved (Document.markSavedAt):
// typing during the write keeps the '*', undo back to it is clean.
// The file type is the format's (./Open fileTypeOf: &A7E for a
// .docx, &C32 for RTF); a leaf with no '/docx' or '/rtf' is kept as
// typed. A window opened from RTF saves as RTF, any other as a
// .docx, until a Save as in the other format is written. Save of an
// RTF window that would lose something (./LostBox toTell) asks
// first, once per window (./LostBox askLost: Cancel saves nothing,
// false); Save as says it in ./SaveAsBox. The window is told once
// an RTF file is written (./LostBox saved), not at Continue. OK in
// the Save box saving RTF that would lose more than the window was
// told of or answered (./LostBox unasked: put in with the box open)
// asks again first (guardLost; a drag to a directory: in its save).
// A window imported from another kind of file (dw.imported 'odt' |
// 'doc', dw.importedFrom that file, dw.path null, dw.format 'docx')
// is saved as untitled ones are: Save opens the Save box, offering a
// .docx beside the original (SaveState importName); nothing writes
// to the file it came from (canWrite). Once written it is a .docx
// window like any other: dw.imported and dw.importedFrom null.
// A save that renames the window changes its title, dw.path,
// dw.leaf, its app.docs key (app.rekey), the Save as box's name and
// the Save a copy box's and the Info box. Save a copy changes
// nothing in the window.
//
// Save on a titled document takes dw.path when its turn comes (after
// a Save as still writing: the new name). A window closed while its
// save was writing is left alone: the file is written (true), the
// path goes to Recent, but the closed window is not renamed, marked
// or put back in app.docs. A save still waiting its turn when the
// window is closed with changes made after it was asked for (Discard)
// writes nothing (false): the changes thrown away are not saved.
import {wimp, vfs, saveAs, reportError} from 'riscos';
import {suggestName, defaultDir, leafOf} from './SaveState';
import {box} from './Boxes';
import {writeDocx} from './DocxWrite';
import {asTemplate, isMacro} from './Template';
import {ensureDir, templatesDir} from './TemplateDir';
import {fileTypeOf, TEMPLATE_TYPE} from './Open';
import {guardOK, samePath} from './Replace';
import {askLost, toTell, rtfOf, lostOf, saved, unasked}
  from './LostBox';

const waiting = new WeakMap();         // dw -> {p, res, off} (save())
const queue = new WeakMap();           // dw -> the last save's end
const gone = new WeakSet();            // Save boxes deleted
const chosen = new WeakMap();          // dw -> its Save box's format
const there = (p) => vfs.exists(p);

/** See the header. */
export function canWrite(dw, path, asTemplate) {
  const from = dw.importedFrom;
  // (Save as template over the template the document was made from
  // is allowed: the guide's way of changing a template; Replace is
  // asked first, ./TemplateSave)
  if (asTemplate && dw.imported === 'template') {
    // (the source is not a window's file: only other windows count)
  } else if (from && dw.app.keyOf(path) === dw.app.keyOf(from)) {
    return `'${leafOf(from)}' is the file this document was ` +
      'opened from: save it under another name' +
      (asTemplate ? '.' : ', as a .docx.');
  }
  const other = dw.app.docs.get(dw.app.keyOf(path));
  if (!other || other === dw) return null;
  return `'${other.leaf}' is open in another window: close ` +
    'it first, or save this document under another name.';
}

/** See the header. */
export function notSaved(name, e) {
  return new Error(`'${name}' could not be saved: ` +
    (e && e.message ? e.message : String(e)));
}

/** See the header (the input method stopped). */
export function commitComposition(v) {
  const t = v.comp;
  if (!t) return;
  const ti = wimp.textInput, had = v.hasFocus;
  if (ti && ti.composing) ti.blur();
  v.compose(null);
  v.input(t, {composed: true});    // (never AutoFormat: ./EditInput)
  v.lateCommit = {text: t, at: performance.now()};  // ./EditInput
  v.flush();
  if (had) v.focus();
}

/** See the header. */
export async function bytesOf(dw, format = dw.format) {
  try {
    // (a copy: what is saved or given away never shares the array
    // kept for the next save)
    if (format === 'rtf') return rtfOf(dw).bytes.slice();
    return await writeDocx(dw.doc);
  } catch (e) {
    throw notSaved(dw.leaf, e);
  }
}

/** See the header. */
export function idle(dw) { return queue.get(dw) || Promise.resolve(); }

/** See the header. */
export function saving(dw) { return queue.has(dw); }

/** See the header: after the window's saves before it (path null:
 *  dw.path, when it runs). */
export function writeTo(dw, path, format) {
  const asked = dw.d.stateId;
  const prev = queue.get(dw);
  const run = () => write1(dw, path, asked, format);
  const p = prev ? prev.then(run) : run();
  const end = p.then(() => {}, () => {});
  queue.set(dw, end);
  end.then(() => { if (queue.get(dw) === end) queue.delete(dw); });
  return p;
}

/** One save (writeTo); null: not written (the header). */
async function write1(dw, to, asked, format) {
  if (dw.closed && dw.d.stateId !== asked) return null;
  const path = to == null ? dw.path : to;
  const fmt = format || dw.format || 'docx';
  if (path == null) {                  // (an import: never its file)
    throw notSaved(dw.leaf, new Error('it has no file yet: use Save ' +
      'as'));
  }
  let why = canWrite(dw, path);
  if (why) throw new Error(why);
  const d = dw.d;
  if (!dw.closed) {
    commitComposition(dw.view);
    d.breakCoalesce();
  }
  const id = d.stateId;
  const bytes = await dw.saveBytes(fmt);  // (its error names it)
  const lost = fmt === 'rtf' ? lostOf(dw) : null;  // (those bytes')
  why = canWrite(dw, path);            // (opened meanwhile)
  if (why) throw new Error(why);
  let full;
  try {
    full = vfs.writeFile(path, bytes, {filetype: fileTypeOf(fmt)});
  } catch (e) {
    throw notSaved(leafOf(path), e);
  }
  if (dw.app.noteRecent) dw.app.noteRecent(full);
  if (dw.closed) return full;          // (closed while it was written)
  d.markSavedAt(id);
  if (lost) saved(dw, lost);
  if ((dw.format || 'docx') !== fmt) retype(dw, fmt);
  dw.imported = null;                  // (now a file of its own)
  dw.importedFrom = null;
  rename(dw, full);
  dw.retitle();
  return full;
}

/** The bytes of dw's document as a .dotx (a copy: the Doc is not
 *  changed). A macro-enabled package is never written as one. */
export async function templateBytes(dw) {
  try {
    const m = dw.doc.meta;
    if (m && isMacro(m.contentTypes, m.mainPart)) {
      throw new Error('a macro-enabled document is not saved as a ' +
        'template');
    }
    return await writeDocx(asTemplate(dw.doc));
  } catch (e) {
    throw notSaved(dw.leaf, e);
  }
}

/** See the header: a copy as a template; the window is unchanged. */
export async function saveTemplate(dw, path) {
  const why = canWrite(dw, path, true);
  if (why) throw new Error(why);
  if (!dw.closed) commitComposition(dw.view);
  const bytes = await templateBytes(dw);
  const again = canWrite(dw, path, true);
  if (again) throw new Error(again);
  try {
    if (path.toLowerCase().startsWith(templatesDir().toLowerCase() +
      '.')) ensureDir(vfs);        // (the folder, if it is gone)
    return vfs.writeFile(path, bytes, {filetype: TEMPLATE_TYPE});
  } catch (e) {
    throw notSaved(leafOf(path), e);
  }
}

/** dw now saves as format: its Save boxes' file type with it. */
function retype(dw, format) {
  dw.format = format;
  chosen.delete(dw);
  for (const k of ['saveas', 'copy']) {
    const b = dw.boxes.get(k);
    if (b) b.setFiletype(fileTypeOf(format));
  }
}

/** dw is now the document at path (canonical). */
function rename(dw, path) {
  if (dw.path === path) return;
  dw.path = path;
  dw.leaf = vfs.leaf(path);
  dw.app.rekey(dw);
  const b = dw.boxes.get('saveas');
  if (b) b.setFilename(path);
  const c = dw.boxes.get('copy');
  if (c) c.setFilename(path);
  const info = dw.boxes.get('info');
  const f = info && info.iconByName && info.iconByName('file');
  if (f) f.setText(dw.leaf);
}

/** See the header. */
export async function saveAsTo(dw, path) {
  try {
    return (await writeTo(dw, path)) != null;
  } catch (e) {
    reportError(e && e.message ? e.message : String(e),
      {appName: 'Letters'});
    return false;
  }
}

/** The save() waiting for the Save box (if any) gets ok. */
function settle(dw, ok) {
  const w = waiting.get(dw);
  if (!w) return;
  waiting.delete(dw);
  if (w.off) w.off();
  w.res(ok);
}

/**
 * The Save box closed: false for the save() waiting, unless it opens
 * again at once (the menu opened again over it): then when it, or
 * the menu tree it may come back in, closes again.
 */
function closed(dw, b) {
  queueMicrotask(() => {
    const w = waiting.get(dw);
    if (!w || b.isOpen) return;
    const M = wimp.menus, task = dw.app.task;
    if (!gone.has(b) && M.isOpen && M.owner === task) {
      if (!w.off) {
        w.off = task.onMessage('MenusDeleted', () => {
          w.off();
          w.off = null;
          closed(dw, b);
        });
      }
      return;
    }
    settle(dw, false);
  });
}

/** See the header. */
export function save(dw) {
  if (dw.path) {
    const lost = toTell(dw);
    if (!lost) return saveAsTo(dw, null);
    return askLost(dw, lost).then((ok) => (ok && !dw.closed
      ? saveAsTo(dw, null) : false));
  }
  const b = saveBox(dw);
  const w = pending(dw);
  if (!b.isOpen) {
    setFormat(dw, b, dw.format);
    b.openCentred();
  }
  return w.p;
}

/** The save() waiting for the Save box (made now if none). */
function pending(dw) {
  let w = waiting.get(dw);
  if (!w) {
    w = {off: null};
    w.p = new Promise((res) => { w.res = res; });
    waiting.set(dw, w);
  }
  return w;
}

/** The Save box b of dw saves as format, with its name (one typed
 *  in it while open kept: its extension switched to format's). */
function setFormat(dw, b, format) {
  const f = format === 'rtf' ? 'rtf' : 'docx', was = boxFormat(dw);
  chosen.set(dw, f);
  if (b.filetype !== fileTypeOf(f)) b.setFiletype(fileTypeOf(f));
  const dir = defaultDir(dw.app.recent);
  if (!b.isOpen) b.setFilename(suggestName(dw, dir, there, f));
  else if (was !== f) {
    b.setFilename(suggestName({path: b.filename()}, dir, there, f));
  }
}

/** See the header. */
export function boxFormat(dw) {
  return chosen.get(dw) || dw.format || 'docx';
}

/** See the header. */
export function openSaveBox(dw, format, at) {
  if (dw.closed) return;
  const b = saveBox(dw);
  if (dw.isUntitled) {
    const w = pending(dw);
    setFormat(dw, b, format);
    if (!b.isOpen) b.openCentred();
    return w.p;
  }
  setFormat(dw, b, format);
  if (b.isOpen) {
    if (b.bringToFront) b.bringToFront();
    return undefined;
  }
  if (!at) {
    b.openCentred();
    return undefined;
  }
  wimp.menus.open(b, Math.round(at.x), Math.round(at.y),
    {task: dw.app.task});
  const n = b.icons[1];
  if (n) wimp.setCaret(b, n, n.text.length);
  return undefined;
}

/** See the header. */
export function saveBox(dw) {
  return box(dw, 'saveas', () => {
    const b = saveAs({task: dw.app.task, title: 'Save as',
      filename: suggestName(dw, defaultDir(dw.app.recent), there,
        dw.format),
      filetype: fileTypeOf(dw.format),
      getData: () => dw.saveBytes(boxFormat(dw)),
      save: async (path) => {
        // (null: nothing written, Discard: no save to settle)
        const f = boxFormat(dw);
        // (OK asked already, guardLost; a drag to a directory: here)
        if (f === 'rtf' && !(await answer(dw))) return;
        if (await writeTo(dw, path, f) != null) settle(dw, true);
      },
      // (the box shows the path as typed: the canonical one again)
      onSaved: () => { if (dw.path) b.setFilename(dw.path); }});
    guardOK(b, dw.app.task, (p) => (!!dw.path && samePath(p, dw.path))
      || !!canWrite(dw, p));
    guardLost(dw, b);
    b.on('closed', () => closed(dw, b));
    b.on('deleted', () => { gone.add(b); settle(dw, false); });
    return b;
  });
}

/** Saving dw as RTF now: true, or after askLost when it would lose
 *  more than the window was told of (./LostBox unasked). */
async function answer(dw) {
  const lost = unasked(dw);
  return !lost || ((await askLost(dw, lost)) && !dw.closed);
}

/**
 * OK (or Return) in dw's Save box b saving RTF that would lose more
 * than the window was told of (an edit since Continue, the box
 * open): ./LostBox askLost first. Continue: OK again (then the
 * Replace question, ./Replace, if the file is there); Cancel:
 * nothing written, the box open, the caret back in its name. Only
 * when the name is a full path (OK saves nothing otherwise).
 */
function guardLost(dw, b) {
  const check = () => {
    const to = String(b.filename());
    if (dw.closed || boxFormat(dw) !== 'rtf' ||
      !(to.includes('.') || to.includes(':'))) return undefined;
    const lost = unasked(dw);
    if (!lost) return undefined;
    askLost(dw, lost).then((yes) => {
      if (!b.isOpen || dw.closed) return;
      const name = b.icons[1];
      if (yes) b.emit('click', {icon: b.icons[0], button: 'select'});
      else if (name) wimp.setCaret(b, name, name.text.length);
    });
    return true;
  };
  b.on('click', (ev) => (ev.icon === b.icons[0] &&
    ev.button !== 'menu' ? check() : undefined), {first: true});
  b.on('key', (ev) => (ev.code === 13 ? check() : undefined),
    {first: true});
}
