// EditView - the caret, the selection and the editing in a document's
// window: it draws it (./EditPaint), shows the caret and keeps it in
// view. Keys: ./EditKeys; typed text and input methods: ./EditInput;
// the mouse: ./EditMouse; commands: ./EditApply.
//
//   const v = new EditView(win, L, d, typing, rebuild)
//     win: the Window; L: a ./DocLayout of d.doc; d: its ./Document;
//     typing: its ./Typing; rebuild(): makes a new layout after an
//     edit and calls v.setLayout (./AppWin)
//   v.L, v.sel             the layout (made again first if the
//                          document has changed); the selection
//                          (./Selection), at first a caret at the start
//   v.paint(g, rect)       the window's canvas redraw: L drawn at
//                          v.zoom (./Zoom: a factor, 1 = 100%; the
//                          part below L.top scaled)
//   v.setSelection(sel, {scroll = true})  show sel, its head scrolled
//                          into view (24 px inside); not an edit, so
//                          the next typing is a new undo step
//   v.setLayout(L, oldL)   a new layout: the selection is made valid
//                          for it (Selection.clamp); then v.placed()
//   v.placed(), v.focus()  show the caret (focus: take the focus;
//                          placed() never takes the browser focus)
//   v.key(ev)              -> true if used, undefined if not
//   v.input(text, {composed}?)  type text (./EditInput: AutoFormat
//                          lists after a space, when v.autoList()
//                          says so: ./DocKeys);  v.compose(text|null):
//                          show what an input method composes
//   v.run(id)              a ./Keymap command -> true, or undefined
//                          (./EditRun)
//   v.format(id, arg)      a formatting command (./FormatApply ids)
//                          -> true if applied (./EditFormat)
//   v.query()              the selection's formatting, cached
//   v.pending, v.selRev, v.formatListeners   ./EditFormat
//   v.caretRect()          the head's caret in the work area (zoomed)
//   v.hitAt(x, y)          L.hitTest of a work-area point (zoomed)
//   v.undo(), v.redo(), v.overwrite (Insert's mode), v.text(),
//   v.destroy(), v.hook() (for tests: ./EditHook)
//   v.inset   px hidden by the toolbar and ruler (./EditScroll)
//   v.addPane(pane) -> remove()  the caret in this pane keeps v.lit
//
// The caret is the Wimp's text-input caret ({text: true}), hidden
// while something is selected, as in Word. After an edit the
// selection is the command's; after an undo or a redo,
// EditApply.stepEnd's. The layout is made again at most once a frame
// (a burst of typing is laid out once), then the caret is scrolled
// into view. A refused edit (no paragraph to type in) beeps.
// The pending format (Ctrl-B at a caret...) is typed with the next
// text and then used up; a selection set (mouse, keys), undo, redo
// or any other command drops it. A format chosen from a menu keeps
// the caret, and gives the focus back to the Wimp's text field.
import {wimp} from 'riscos';
import * as S from './Selection';
import {keyFor} from './EditKeys';
import {stepEnd} from './EditApply';
import {runView, stepView} from './EditRun';
import {paintView} from './EditPaint';
import {EMPTY} from './Pending';
import {hook} from './EditHook';
import {showCaret, inputView, composeView} from './EditInput';
import {caretOf, toLayout, layoutRect} from './Zoom';
import {scrollToCaret} from './EditScroll';
import {initFormat, touch, formatQuery, formatRun, stopFormat}
  from './EditFormat';

export class EditView {
  constructor(win, L, d, typing, rebuild) {
    this.win = win;
    this._L = L;
    this.d = d;
    this.typing = typing;
    this._rebuild = rebuild;
    this._stale = false;
    this._raf = 0;
    this.comp = null;
    this.overwrite = false;
    this.inset = 0;
    this.zoom = 1;
    this._panes = [];
    initFormat(this);
    const a = L.docStart();
    this.sel = a ? S.caret(a) : null;
    win.pointer = 'ptr_write';
    const lit = () => win.invalidate();
    win.on('gaincaret', lit);
    win.on('losecaret', lit);
    this._off = d.on('change', (ev) => this._changed(ev));
  }

  get L() { this.ensure(); return this._L; }

  get hasFocus() { return wimp.caret?.window === this.win; }

  /** The focus here, or in a pane of this window (its size field). */
  get lit() {
    return this.hasFocus || this._panes.includes(wimp.caret?.window);
  }

  /** See the header. */
  addPane(pane) {
    this._panes.push(pane);
    return () => {
      this._panes = this._panes.filter((p) => p !== pane);
    };
  }

  /** The document changed: see the header. */
  _changed(ev) {
    if (ev.kind !== 'apply') {
      const p = stepEnd(this.d.doc, ev.ops, this._L);
      if (p) this.sel = S.caret(p);
    }
    this._stale = true;
    touch(this);
    if (!this._raf) {
      this._raf = requestAnimationFrame(() => this.flush());
    }
  }

  /** A new layout now if the document has changed. */
  ensure() {
    if (!this._stale) return;
    this._stale = false;
    this._rebuild();
  }

  /** After edits: lay out, scroll to the caret, show it. */
  flush() {
    if (this._raf) cancelAnimationFrame(this._raf);
    this._raf = 0;
    if (!this.win.isOpen) return;
    this.ensure();
    this.scrollToCaret();
    this.showCaret();
    this.win.invalidate();
  }

  destroy() {
    if (this._raf) cancelAnimationFrame(this._raf);
    this._raf = 0;
    this.comp = null;
    stopFormat(this);
    this._off();
  }

  paint(g, rect) {
    const L = this.L, z = this.zoom, t = L.top;
    g.save();
    g.translate(0, t);
    g.scale(z, z);
    g.translate(0, -t);
    paintView(L, g, layoutRect(rect, z, t), this.sel, this.lit,
      {comp: this.comp, overwrite: this.overwrite});
    g.restore();
  }

  caretRect() {
    if (!this.sel) return null;
    const L = this.L;
    return caretOf(L.caretRect(this.sel.head, this.sel.affinity),
      this.zoom, L.top);
  }

  hitAt(x, y) {
    const L = this.L, p = toLayout(x, y, this.zoom, L.top);
    return L.hitTest(p.x, p.y);
  }

  text() { return this.sel ? S.text(this.sel, this.L) : ''; }

  /** See the header. */
  setSelection(sel, {scroll = true} = {}) {
    if (!sel) return;
    this.typing.reset();
    this.sel = sel;
    this.pending = EMPTY;
    touch(this);
    this.win.invalidate();
    if (scroll) this.scrollToCaret();
    this.showCaret();
  }

  /** The selection after an edit: shown when laid out (flush). */
  edited(sel) {
    this.sel = sel;
    touch(this);
    if (!this._raf) {
      this._raf = requestAnimationFrame(() => this.flush());
    }
  }

  /** See the header. */
  setLayout(L, oldL) {
    this._L = L;
    if (this.sel) this.sel = S.clamp(this.sel, L.doc, oldL);
    else {
      const a = L.docStart();
      this.sel = a ? S.caret(a) : null;
    }
    touch(this);
    this.win.invalidate();
  }

  placed() { this.showCaret(); }

  focus() { this.showCaret(true); }

  /** The Wimp's caret at the head (./EditInput). */
  showCaret(take = false) { showCaret(this, take); }

  /** The head 24 px inside what can be seen (./EditScroll). */
  scrollToCaret() { scrollToCaret(this); }

  /** See the header (./EditInput). */
  input(text, opts) { inputView(this, text, opts); }
  compose(text) { composeView(this, text); }

  undo() { stepView(this, 'undo'); }
  redo() { stepView(this, 'redo'); }
  /** See the header (./EditRun, ./EditKeys). */
  run(id) { return runView(this, id); }
  key(ev) { return keyFor(this, ev); }

  /** See the header (./EditFormat). */
  format(id, arg) {
    const done = formatRun(this, id, arg);
    const ti = wimp.textInput;
    // a menu or toolbar click took the browser's focus from the
    // Wimp's text field: give it back (the caret stays where it is)
    if (done && this.hasFocus && ti && !ti.focused) this.focus();
    return done;
  }

  query() { return formatQuery(this); }
  hook() { return hook(this); }
}
