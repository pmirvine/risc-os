// BulletGlyph - bullet characters as visible Unicode glyphs.
//
// Word writes most bullets in a symbol font: the character is a
// private-use code U+F0xx (or the plain code 0x00..0xFF) whose
// picture is the glyph at that code in Symbol or Wingdings. Our
// fonts have no such pictures, so they are mapped to ordinary
// Unicode shapes:
//   glyphFor(ch, font) -> string   one character (code point)
//   bulletText(lvlText, font)      every character mapped, capped
//                                  (NumFormat.LABEL_CAP)
// font is the level's run font name (rFonts ascii or hAnsi), may be
// undefined. Rules: a symbol-font code (U+F000..U+F0FF, or a code
// below 0x100 in a font named Symbol* / Wingdings*) goes through
// the font's table, unknown codes become a bullet (U+2022); any
// other private-use character is a bullet; a middle dot is a
// bullet; 'o' (Word's Courier New circle) is a white circle in any
// font (a letter o as a bullet is rare); U+F0B7 / 0xB7 is a bullet
// whatever the font (Word often names none, or Wingdings); the rest
// is shown as it is.
import {capLabel} from './NumFormat';

const BULLET = '\u2022';

const WINGDINGS = new Map([
  [0xB7, BULLET],     // F0B7: Symbol's bullet, often with no font
  [0xA7, '\u25AA'],   // small black square
  [0xA8, '\u25FB'],   // white medium square
  [0xD8, '\u27A2'],   // arrowhead
  [0xE8, '\u2794'],   // heavy arrow
  [0xFC, '\u2713'],   // check mark
  [0xFB, '\u2717'],   // ballot x
  [0x76, '\u25C6'],   // diamond (Word: four diamonds)
  [0x6E, '\u25A0'],   // black square
  [0x6C, '\u25CF'],   // black circle
  [0x71, '\u25A1'],   // white square (Word: shadowed)
  [0x9F, BULLET],     // small bullet
  [0xA1, '\u25CB'],   // white circle
]);
const SYMBOL = new Map([
  [0xB7, BULLET],
  [0xA8, '\u2666'],   // diamond suit
  [0x2D, '\u2212'],   // minus
  [0x2A, '\u2217'],   // asterisk
]);

const fontKind = (font) => {
  const f = typeof font === 'string' ? font.toLowerCase() : '';
  if (f.startsWith('symbol')) return SYMBOL;
  if (f.startsWith('wingdings')) return WINGDINGS;
  return null;
};

/** The visible glyph for bullet character `ch` in `font`. */
export function glyphFor(ch, font) {
  const code = ch.codePointAt(0);
  const table = fontKind(font);
  let sym = -1;
  if (code >= 0xF000 && code <= 0xF0FF) sym = code - 0xF000;
  else if (table && code < 0x100) sym = code;
  if (sym >= 0) return (table || WINGDINGS).get(sym) || BULLET;
  if (code >= 0xE000 && code <= 0xF8FF) return BULLET;
  if (code === 0xB7) return BULLET;
  if (ch === 'o') return '\u25CB';
  return ch;
}

/** The label of a bullet level: lvlText mapped, capped. */
export function bulletText(lvlText, font) {
  if (typeof lvlText !== 'string') return '';
  let s = '';
  for (const ch of lvlText) {
    s += glyphFor(ch, font);
    if (s.length > 64) break;
  }
  return capLabel(s);
}
