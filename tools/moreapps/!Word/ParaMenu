// ParaMenu - the paragraph spacing menu: Format > Line spacing >
// (./FormatMenu) and the toolbar's line spacing button's popup
// (./ToolbarBind).
//
//   spacingMenu(view, {options}?) -> a Menu
//
//   1.0 1.15 1.5 2.0 2.5 3.0   the line spacing in lines
//                  (./FormatApply lineSpacing with a LINE_FACTORS
//                  factor); the selection's ticked when all of it
//                  has that one (rule auto); keys Ctrl+1, Ctrl+5,
//                  Ctrl+2 (./Keymap)
//   Add space before        12 pt above the paragraph (shaded when
//                           every paragraph has some already)
//   Remove space before     none above (shaded when none has any)
//   Add space after, Remove space after   the same below
//   Line spacing options... options() when given (the Paragraph
//                           dialogue box: ./ParaBox), else shaded
//
// Each runs view.format(id, arg) (./EditView): one undo step. Ticks
// and shading come from view.query() (cached per change of the
// selection). Everything is shaded when there is no selection.
import {Menu} from 'riscos';
import {keymap} from './Keymap';
import {LINE_FACTORS} from './FormatApply';

const KEYS = new Map([[1, 'lineSingle'], [1.5, 'line15'],
  [2, 'lineDouble']]);
const TWELVE = 240;

/** '1.0', '1.15', '2.0'... */
const label = (f) => (Number.isInteger(f) ? f.toFixed(1) : String(f));

/** See the header. */
export function spacingMenu(v, {options} = {}) {
  const off = () => !v.sel;
  const q = () => v.query();
  const lines = LINE_FACTORS.map((f, i) => ({
    text: label(f),
    key: KEYS.has(f) ? keymap.labelFor(KEYS.get(f)) : undefined,
    ticked: () => {
      if (off()) return false;
      const ls = q().lineSpacing;
      return !!ls && ls.rule === 'auto' &&
        ls.line === Math.round(f * 240);
    },
    shaded: off, dotted: i === LINE_FACTORS.length - 1,
    action: () => v.format('lineSpacing', f),
    help: `${label(f)} lines from one baseline to the next.`,
  }));
  const space = (text, id, to, has, more = {}) => ({text,
    shaded: () => {
      if (off()) return true;
      const n = q()[id];
      return n !== null && has(n);
    },
    action: () => v.format(id, to), ...more});
  return new Menu('Line spacing', [
    ...lines,
    space('Add space before', 'spaceBefore', TWELVE, (n) => n > 0,
      {key: keymap.labelFor('spaceBefore12') || undefined,
        help: '12 points of space above the paragraph.'}),
    space('Remove space before', 'spaceBefore', 0, (n) => n === 0,
      {help: 'No space above the paragraph.'}),
    space('Add space after', 'spaceAfter', TWELVE, (n) => n > 0,
      {help: '12 points of space below the paragraph.'}),
    space('Remove space after', 'spaceAfter', 0, (n) => n === 0,
      {dotted: true, help: 'No space below the paragraph.'}),
    {text: 'Line spacing options...',
      shaded: () => off() || typeof options !== 'function',
      action: () => { if (typeof options === 'function') options(); },
      help: 'Line spacing and the space before and after, ' +
        'exactly.'},
  ]);
}
