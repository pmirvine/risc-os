// BorderCommand - the borders and shading commands (./FormatApply
// ids 'borders', 'paraShade' and 'charShade'; the Borders and
// shading box's OK: ./BorderBox).
//
//   borders(d, typing, sel, arg, pending) -> {sel, pending}
//       arg {pBdr?, shd?} (./FormatCheck paraPatch's): on each
//       paragraph the selection formats, each side given and the
//       shading made explicit as ./BorderExplicit boxExplicit says
//       (whole sides, whole shading; a side or shading the styles
//       give already is not written)
//   paraShade(d, typing, sel, shd, pending)  borders with {shd}
//   charShade(d, typing, sel, shd, pending)  the shading of the
//       selected text (rPr.shd of the runs in it; at a caret the
//       pending format for the text typed next): shd {val, color?,
//       fill?} or null (none: ./BorderExplicit runShade)
//
// One undo step each (./FormatPara paraCommand, ./FormatSet
// charCommand), none when nothing changes. Refused (RangeError,
// nothing changed): a bad arg (a name outside Word's schema:
// ./BorderNames), a paragraph whose own w:pBdr (w:shd) is kept raw
// when the borders (shading) are to change, a run whose own w:shd
// is kept raw. Pure: no desktop services.
import {setPara, charCommand} from './FormatSet';
import {charPatch} from './FormatCheck';
import {runShade} from './BorderExplicit';
import {fail} from './ModelCheck';

const KEYS = ['pBdr', 'shd'];

/** See the header. */
export function borders(d, typing, sel, arg, pending) {
  if (!arg || typeof arg !== 'object' || Array.isArray(arg) ||
    !Object.keys(arg).every((k) => KEYS.includes(k)))
    fail('bad borders change');
  return setPara(d, typing, sel, arg, pending);
}

/** See the header. */
export const paraShade = (d, typing, sel, shd, pending) =>
  borders(d, typing, sel, {shd}, pending);

/** See the header. */
export function charShade(d, typing, sel, shd, pending) {
  if (shd === undefined) fail('bad shading');
  const v = charPatch({shd}).shd;
  return charCommand(d, typing, sel, pending,
    (p, r, res) => ({rPr: {shd: runShade(v, res, p, r)}}));
}
