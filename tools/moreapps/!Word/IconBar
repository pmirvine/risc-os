// IconBar - Word's icon on the icon bar and its menu.
//
//   addIcon(app)   the icon: a Select click makes a new, empty
//                  document (app.newDoc: 'Untitled', with the caret);
//                  Adjust does nothing; a .docx dropped on it opens.
//                  Its menu: New (the same), Recent > (./RecentFiles),
//                  Info >, Quit (./Quit: asks first if documents have
//                  unsaved changes).
//
// A double-click on the icon is two Select clicks to Word (the icon
// bar's icons report every press as a click, never a double-click),
// so a click within AGAIN ms of the one that made a document is the
// same gesture and makes none: one double-click, one document.
import {Menu, infoBox} from 'riscos';
import {recentItem} from './RecentFiles';
import {quit} from './Quit';

const AGAIN = 500;                     // ms (the Wimp's 400, and some)

/** See the header. */
export function addIcon(app) {
  const task = app.task;
  const info = infoBox(task, {name: 'Word',
    purpose: 'Word documents (.docx)', author: 'MoreApps',
    version: '0.11 (07-Oct-26)'});
  const make = () => { app.newDoc(); };
  const menu = () => new Menu('Word', [
    {text: 'New', action: make,
      help: 'Make a new, empty document (A4).'},
    recentItem(app),
    {text: 'Info', submenu: info},
    {text: 'Quit', action: () => { quit(app); },
      help: 'Stop Word (if documents have unsaved changes, it asks ' +
        'first).'},
  ]);
  let last = -Infinity;
  return task.addIconbarIcon({
    sprite: '!word', menu,
    help: 'This is Word.|MClick SELECT to make a new document. Drop ' +
      'a Word .docx file on this icon to open it, or double-click ' +
      'one in a directory display.',
    onClick: (ev) => {
      if (!ev || ev.button !== 'select') return;
      const now = performance.now();
      if (ev.kind === 'double' || now - last < AGAIN) return;
      last = now;
      make();
    },
    onDataLoad: (ev) => {
      for (const f of ev.files) if (f.type !== 'dir') app.open(f.path);
    },
  });
}
