// ClipDom - ./ClipRead's parseHtml from the browser's DOMParser:
//
//   parserOf(DOMParser) -> parseHtml(html) -> a Document | null
//
// The caller passes the DOMParser class (./EditClip: the page's), so
// this stays pure. parseHtml parses the pasted HTML as text/html
// into a document of its own: such a document is inert (no script
// runs, nothing is loaded, no event fires), it is never put into
// the page, and ./ClipRead only reads nodeType, nodeName,
// childNodes, data and getAttribute of its nodes, which a DOM node
// has as they are. No DOMParser: null (the caller pastes the plain
// text). A parse that throws throws (ClipRead.readHtml catches it).
// Pure: no desktop services.

/** See the header. */
export function parserOf(DP) {
  if (typeof DP !== 'function') return null;
  return (html) => new DP().parseFromString(String(html), 'text/html');
}
