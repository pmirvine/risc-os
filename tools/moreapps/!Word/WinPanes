// WinPanes - the panes across the top of a document's window
// (./AppWin): ROWS toolbar rows (./ToolbarBind, BAR_H high each: row
// 1 the character formatting, BUTTONS; row 2 under it, BUTTONS2) and
// the ruler under them (./RulerBind, RULER_H high, may be hidden).
// The page starts below them and the caret is kept out from under
// them: inset(dw) px, given to both the layout (DocLayout top) and
// the view (EditView inset). Each pane is as wide as the window (its
// buttons cut off at the right edge), a Menu click on it opens the
// window's menu, and the wheel over it scrolls the document.
//
//   makePanes(dw)      dw.bars (a row per ROW_BUTTONS list, BAR_H
//                      apart; dw.bar, dw.bar2 the first two), dw.rb
//                      (the ruler) made; dw.view.inset set
//   inset(dw)          ROWS * BAR_H, + RULER_H while dw.rulerOn
//   setRuler(dw, on)   show or hide the ruler: the page moves up or
//                      down (a new layout), the caret kept in view
//   destroyPanes(dw)   the rows and the ruler deleted (./CloseDoc)
import {bindToolbar} from './ToolbarBind';
import {BAR_H, ROWS, ROW_BUTTONS} from './ToolbarButtons';
import {bindRuler} from './RulerBind';
import {paraBox} from './ParaBox';
import {RULER_H} from './RulerInd';

/** See the header. */
export function makePanes(dw) {
  const task = dw.app.task, parent = dw.win, v = dw.view;
  const menu = () => dw.menu();
  const rows = ROW_BUTTONS.map((buttons, i) => bindToolbar(v,
    {task, parent, height: BAR_H, menu, buttons, dy: i * BAR_H,
      paragraph: () => paraBox(dw)}));
  dw.bars = rows;
  [dw.bar, dw.bar2] = rows;
  dw.rb = bindRuler(v, {task, parent, dy: ROWS * BAR_H, menu});
  v.inset = inset(dw);
}

/** See the header. */
export function inset(dw) {
  return ROWS * BAR_H + (dw.rulerOn ? RULER_H : 0);
}

/** See the header. */
export function setRuler(dw, on) {
  if (!!on === dw.rulerOn) return;
  dw.rulerOn = !!on;
  dw.rb.show(dw.rulerOn);
  dw.view.inset = inset(dw);
  dw.rebuild();
  dw.view.scrollToCaret();
  if (dw.view.hasFocus) dw.view.focus();   // (after a menu)
}

/** See the header. */
export function destroyPanes(dw) {
  for (const p of [...(dw.bars || []), dw.rb]) if (p) p.destroy();
}
