// AppWin - the window of one open document: its text in a scrolling
// window, as a column the width of the text on its page
// (./DocLayout), on a white page on a grey desk; a caret and a
// selection made with the mouse and the keys, typing, deleting and
// undo (./EditView, ./EditMouse, ./EditInput), copy, cut and paste
// (./EditClip: dw.docKey, dw.clip), F2, F3, Ctrl-F2... (./DocKeys).
// Its menu saves, undoes, formats or closes it (./WinMenu). A
// toolbar across its top (./ToolbarBind, BAR_H high) shows and
// changes the formatting, a ruler under it (./RulerBind, RULER_H)
// the indents; the page starts below them and the caret is kept out
// from under them: dw.inset() px, given to both the layout (DocLayout
// top) and the view (EditView inset). The page is shown at
// dw.zoom percent (./ZoomBind: the window's menu, Ctrl+wheel): the
// layout stays at 100%, laid out for the window's width / zoom, the
// extent and everything under the bars scaled (./Zoom).
//
//   const dw = new DocWindow(app, path, doc)   path null: untitled
//   dw.show()          open it (or to the front), with the focus
//   dw.path, dw.leaf   its file (null if untitled) and name: the
//                      file's leaf, or 'Untitled', 'Untitled 2'...
//                      (SaveState.untitledName); dw.isUntitled
//   dw.save(), dw.saveAs(path) -> Promise<boolean>  (./DocSave)
//   dw.relayout()      lay it out again (fonts came), same selection
//   dw.d, dw.typing    its ./Document (dw.doc = dw.d.doc), ./Typing
//   dw.view            its ./EditView;  dw.bar  its ./ToolbarBind
//   dw.rb, dw.rulerOn  its ./RulerBind; whether the ruler is shown
//   dw.setRuler(on)    show or hide it (Format > Ruler): the page
//                      moves up or down, the caret kept in view
//   dw.zoom, dw.setZoom(pct)  the zoom (percent, per window)
//   dw.text            the paragraphs' texts, as they are now
//   dw.summary         the Info line, as the document was opened
//   dw.saveBytes()     -> Promise<Uint8Array>, the bytes to save
//   dw.requestClose(), dw.revert()  ask first (./CloseDoc)
//   dw.close()         close it without asking; dw.closed
// app (!RunImage): {task, docs (Map key -> DocWindow), keyOf(path),
// rekey(dw), recent, noteRecent(path), closed(dw), open, newDoc}.
//
// A new window is as wide as the page and its grey edges (at most
// the screen's width less 40 px); it scrolls across when narrower.
// It is as tall as a whole page under the bars where the screen has
// room above the icon bar, and never less than 560 px.
// The work area is the page's height, and at least the screen's
// width, so the window can be made as wide (the page centred).
// The title is dw.leaf, with ' *' while the document has changes
// that are not saved (Document.dirty; a save calls retitle). Saving
// a copy does not count (the star stays).
import {wimp, vfs} from 'riscos';
import {TextMetrics} from 'wimplib/TextMetrics';
import {DocLayout, PAGE_TOP} from './DocLayout';
import {EditView} from './EditView';
import {attachMouse} from './EditMouse';
import {attachInput} from './EditInput';
import {attachClip} from './EditClip';
import {attachKeys} from './DocKeys';
import {windowMenu} from './WinMenu';
import {bindToolbar} from './ToolbarBind';
import {BAR_H} from './ToolbarButtons';
import {bindRuler} from './RulerBind';
import {RULER_H} from './RulerInd';
import {bindZoom} from './ZoomBind';
import {extentOf} from './Zoom';
import {Document} from './Document';
import {Typing} from './Typing';
import {summary} from './Info';
import {untitledName} from './SaveState';
import {save, saveAsTo, bytesOf} from './DocSave';
import {requestClose, revert, destroy} from './CloseDoc';

const H0 = 560, EDGE = 48, BELOW = 92;  // (icon bar, scroll bar)
let count = 0;                         // (to place windows in turn)

export class DocWindow {
  constructor(app, path, doc) {
    this.app = app;
    this.path = path || null;
    this.doc = doc;
    this.d = new Document(doc);
    this.typing = new Typing(this.d);
    this.leaf = path ? vfs.leaf(path) : untitledName(
      [...app.docs.values()].filter((x) => !x.path).map((x) => x.leaf));
    this.boxes = new Map();            // ./WinMenu's boxes
    this.summary = summary(doc);       // (as opened)
    this.ctx = null;                   // the canvas's, to measure with
    this.rulerOn = true;
    this.L = new DocLayout(doc, this.metrics(), null,
      {top: this.inset()});
    const L = this.L;
    const W = Math.max(240, Math.min(wimp.width - 40,
      Math.ceil(Math.max(L.pageW, L.marL + L.textW) + EDGE)));
    const n = count++ % 8, y = 70 + n * 28;
    const H = Math.max(H0, Math.min((wimp.height || 0) - y - BELOW,
      Math.ceil(L.top + L.pageH + 2 * PAGE_TOP)));
    const w = this.win = app.task.createWindow({
      title: this.leaf, w: W, h: H, y,
      x: Math.max(8, Math.min(160 + n * 28, wimp.width - W - 40)),
      extent: {w: Math.max(W, wimp.width), h: H},
      flags: {back: true, close: true, title: true, toggle: true,
        vscroll: true, hscroll: true, size: true, moveable: true},
      colours: {workBg: 0}, minW: 240, minH: 120,
      workButton: 'clickdragdouble',
      help: 'This is a Word document: click to put the caret in ' +
        'it and type. Drag to select text, double-click for a ' +
        'word; Ctrl-Z undoes, Ctrl-Y redoes, Ctrl-B, Ctrl-I and ' +
        'Ctrl-U make it bold, italic or underlined.|MClick MENU ' +
        'to save it, to undo, or to format the text.',
      menu: () => this.menu(),
    });
    const canvas = w.useCanvas((g, rect) => this.paint(g, rect),
      {hiDPI: true});
    this.ctx = canvas.getContext('2d');
    this.view = new EditView(w, L, this.d, this.typing,
      () => this.rebuild());
    this.view.inset = this.inset();
    attachMouse(this.view);
    attachInput(this.view);
    attachClip(this);
    attachKeys(this);
    this.bar = bindToolbar(this.view, {task: app.task, parent: w,
      height: BAR_H, menu: () => this.menu()});
    this.rb = bindRuler(this.view, {task: app.task, parent: w,
      dy: BAR_H, menu: () => this.menu()});
    this.zb = bindZoom(this);
    this.d.on('change', () => this.retitle());
    this.fit();
    w.on('moved', () => {
      if (this.viewW() !== this.L.width) this.fit();
    });
    w.on('close', (ev) => {
      ev.preventDefault();
      this.requestClose();
    });
    w.on('key', (ev) => this.view.key(ev));
    w.on('dataload', (ev) => {
      for (const f of ev.files) if (f.type !== 'dir') app.open(f.path);
      return true;
    });
  }

  /** The paragraphs' texts now (kept blocks left out). */
  get text() {
    const out = [];
    for (const s of this.doc.sections) {
      for (const b of s.blocks) if (b.type === 'p') out.push(b.text);
    }
    return out;
  }

  /** Text widths, measured on the window's canvas. */
  metrics() {
    return new TextMetrics((text, css) => {
      const g = this.ctx;
      g.font = css;
      return g.measureText(text).width;
    });
  }

  /** Place the column for the window's width; the extent (header). */
  fit() {
    // (after an edit: the new layout first; it fits itself). fit
    // may run inside a redraw (EditView.paint -> L -> rebuild):
    // setExtent there only asks for another redraw, which then
    // draws the new extent and scroll offsets
    if (this.view) this.view.ensure();
    const w = this.win, L = this.L;
    const r = extentOf(L.layout(this.viewW()), this.view.zoom, L.top);
    w.setExtent({w: Math.max(r.w, wimp.width),
      h: Math.max(r.h, 64)});
    this.view.placed();
    this.rb.refresh();
    w.invalidate();
  }

  /** The width to lay out for: the window's, at 100%. */
  viewW() { return Math.round(this.win.w) / this.view.zoom; }

  get zoom() { return this.zb.pct; }

  /** See the header (./ZoomBind). */
  setZoom(pct) { this.zb.set(pct); }

  /** px at the window's top hidden by the toolbar and the ruler. */
  inset() { return BAR_H + (this.rulerOn ? RULER_H : 0); }

  /** See the header. */
  setRuler(on) {
    if (!!on === this.rulerOn) return;
    this.rulerOn = !!on;
    this.rb.show(this.rulerOn);
    this.view.inset = this.inset();
    this.rebuild();
    this.view.scrollToCaret();
    if (this.view.hasFocus) this.view.focus();   // (after a menu)
  }

  /** The title: the leaf name, ' *' when changed (the header). */
  retitle() {
    const t = this.leaf + (this.d.dirty ? ' *' : '');
    if (this.win.title !== t) this.win.setTitle(t);
  }

  /** After an edit: a new layout keeping the unchanged lines. */
  rebuild() { this.newLayout(this.L.metrics, this.L); }

  /** See the header: new widths, so a new layout. */
  relayout() { this.newLayout(this.metrics(), null); }

  /** A new layout, inset() px down; prev: one to keep lines of. */
  newLayout(metrics, prev) {
    const old = this.L;
    this.L = new DocLayout(this.doc, metrics, prev,
      {top: this.inset()});
    this.view.setLayout(this.L, old);
    this.fit();                        // (lays it out)
  }

  paint(g, rect) {
    // the width changed without a 'moved' (toggle size, say)
    if (this.viewW() !== this.L.width) {
      Promise.resolve().then(() => this.fit());
    }
    this.view.paint(g, rect);
  }

  show() {
    const w = this.win;
    if (w.isOpen) w.bringToFront();
    else w.open({behind: 'top'});
    this.view.focus();
  }

  get isUntitled() { return !this.path; }

  save() { return save(this); }

  saveAs(path) { return saveAsTo(this, path); }

  /** The bytes to save; an error names the file. */
  saveBytes() { return bytesOf(this); }

  menu() { return windowMenu(this); }

  requestClose() { return requestClose(this); }

  revert() { return revert(this); }

  close() { destroy(this); }
}
