// DocKeys - the keys that act on a document's window (./AppWin)
// rather than on its text: ./Keymap's rows of menu 'Window'.
//
//   attachKeys(dw)       view.docCommand = (id) => docCommand(dw, id);
//                        view.autoList = () => whether AutoFormat
//                        lists is on (./AutoFormatOpt, for the app)
//   docCommand(dw, id) -> true if used, undefined if not (the key
//                         then goes on)
//
//   new         F2, Ctrl+N: a new, empty document (app.newDoc, as
//               the icon bar's click: 'Untitled', with the caret)
//   close       Ctrl+F2: close it, asking first if it has changes
//               (./CloseDoc requestClose, as its close icon)
//   save        Ctrl+S: ./DocSave save (written to its file; an
//               untitled document opens the Save as box)
//   saveBox     F3: the Save as box near the caret, as a menu
//               (Escape or a click elsewhere closes it), as Edit
//               does; already open: left as it is (one box:
//               ./Boxes). For an untitled document F3 is Save
//               (the box centred, a new name)
//   sendToBack  Ctrl+F10: the window to the back of the stack
//   find        Ctrl+F, F4: the Find box (./EditFind openFind)
//   replace     Ctrl+H: the Find box, the caret in Replace
//   findNext    Ctrl+G, findPrev Ctrl+Shift+G: find again with the
//               box's text (./EditFind findStep)
//   hyperlink   Ctrl+K (Cmd+K on a Mac): the Hyperlink box
//               (./LinkBox: insert, edit or remove a link)
//   bookmark    Ctrl+Shift+F5: the Bookmark box (./BookmarkBox:
//               add, delete or go to a bookmark)
// attachKeys also makes the window one the Find box can work on
// (./EditFind attachFind), the symbol grid (./SymbolBind
// attachSymbols) and the format painter (./PaintBind attachPainter).
//
// ./EditKeys runs each once per press: a key held down (the
// browser's auto-repeat) does New, Close, Save and Save as once.
import {wimp} from 'riscos';
import {save, saveBox} from './DocSave';
import {requestClose} from './CloseDoc';
import {attachFind, openFind, findStep} from './EditFind';
import {autoListOn} from './AutoFormatOpt';
import {attachSymbols} from './SymbolBind';
import {linkBox} from './LinkBox';
import {bookmarkBox} from './BookmarkBox';
import {attachPainter} from './PaintBind';

/** See the header. */
export function attachKeys(dw) {
  dw.view.docCommand = (id) => docCommand(dw, id);
  dw.view.autoList = () => autoListOn(dw.app);
  attachFind(dw);
  attachSymbols(dw);
  attachPainter(dw.view);
}

/** See the header. */
export function docCommand(dw, id) {
  switch (id) {
    case 'new': dw.app.newDoc(); return true;
    case 'close': requestClose(dw); return true;
    case 'save': save(dw); return true;
    case 'saveBox':
      if (dw.isUntitled) save(dw);
      else nearCaret(dw);
      return true;
    case 'sendToBack': dw.win.sendToBack(); return true;
    case 'find': return openFind(dw, false);
    case 'replace': return openFind(dw, true);
    case 'findNext': return findStep(dw, false);
    case 'findPrev': return findStep(dw, true);
    case 'hyperlink': return linkBox(dw) ? true : undefined;
    case 'bookmark': return bookmarkBox(dw) ? true : undefined;
    default: return undefined;
  }
}

/** The Save as box as a menu, by the caret (else the window's
 *  top left corner). */
function nearCaret(dw) {
  const b = saveBox(dw);
  if (b.isOpen) return;
  const v = dw.view, w = dw.win;
  const c = v.hasFocus ? v.caretRect() : null;
  const s = c ? w.workToScreen(c.x, c.y) : {x: w.x + 14, y: w.y};
  const x = s.x + 50, y = s.y + 60;
  wimp.menus.open(b, Math.round(x), Math.round(y),
    {task: dw.app.task});
  const n = b.icons[1];
  if (n) wimp.setCaret(b, n, n.text.length);
}
