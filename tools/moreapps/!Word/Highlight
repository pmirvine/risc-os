// Highlight - Word's highlight colours (w:highlight) as CSS colours.
//
//   HIGHLIGHT              name -> '#rrggbb', Word's 16 names
//   highlightCss(name)     -> '#rrggbb', or null for 'none' and
//                             anything that is not one of the names
//
// The names are those of ./FormatCheck's HIGHLIGHTS; the colours are
// the ones Word draws. Pure: no desktop services.

/** See the header. */
export const HIGHLIGHT = Object.freeze({
  yellow: '#ffff00', green: '#00ff00', cyan: '#00ffff',
  magenta: '#ff00ff', blue: '#0000ff', red: '#ff0000',
  darkBlue: '#000080', darkCyan: '#008080', darkGreen: '#008000',
  darkMagenta: '#800080', darkRed: '#800000', darkYellow: '#808000',
  darkGray: '#808080', lightGray: '#c0c0c0', black: '#000000',
  white: '#ffffff',
});

/** See the header. */
export function highlightCss(name) {
  return typeof name === 'string' &&
    Object.prototype.hasOwnProperty.call(HIGHLIGHT, name)
    ? HIGHLIGHT[name] : null;
}
