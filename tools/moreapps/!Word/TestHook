// TestHook - task.word, what the tests see of a running Word (set by
// !RunImage):
//
//   docs        the open documents, each: path, leaf, untitled,
//               stateId, save(), saveAs(p), requestClose(), revert()
//               (./DocSave, ./CloseDoc), closed, saving, dw (the
//               DocWindow), doc, text, summary, win, d, saveBytes(),
//               view (./EditView hook: type, press, compose, dirty..),
//               painter (the format painter: null, or {picked,
//               sticky}: ./PaintBind), count() (./WordCount of the
//               selection or the document: ./CountBox shows it),
//               toolbar, toolbar2 (the rows), inset (px: dw.inset),
//               ruler, rulerOn, setRuler, zoom, setZoom,
//               relayout(), docKey, clipboard ({last, status}),
//               copy(), cut(), paste(payload) (./EditClip clipHook)
//   open(path), new({paper}) / newUntitled(paper)   -> the DocWindow
//   keys        the app.docs keys
//   ask(opts)   WimpLib Ui/SaveQuery for the task
//   prompt      the Save / Discard / Cancel prompt open: {leaf,
//               buttons, win} (the quit prompt: leaf null)
//   recent, recentReady   the Recent list (a copy) and its read
//   mayQuit(), quit()     ./Quit: may it quit? the menu's Quit
//   find        ./EditFind findHook: {box (WimpLib Ui/FindBox),
//               active (the DocWindow it works on), open(replace),
//               run(action, fields) -> the message}
//   symbols     ./SymbolBind symbolsHook: {grid (WimpLib Ui/
//               CharGrid), active (the DocWindow it works on),
//               open(), withSets(sets)}
//   dialog(spec) WimpLib Ui/Dialog for the task (spec without task)
//   pics        the program's picture cache now (./PicCache stats:
//               {count, bytes, pending, decodes})
import {saveQuery} from 'wimplib/Ui/SaveQuery';
import {dialog} from 'wimplib/Ui/Dialog';
import {saving} from './DocSave';
import {mayQuit, quit} from './Quit';
import {clipHook} from './EditClip';
import {findHook} from './EditFind';
import {symbolsHook} from './SymbolBind';
import {countView} from './WordCount';
import {CACHE} from './PicCache';

/** See the header. */
export function testHook(app) {
  const {task, docs} = app;
  return {
    get docs() {
      return [...docs.values()].map((d) => ({
        get path() { return d.path; }, get leaf() { return d.leaf; },
        get untitled() { return d.isUntitled; },
        get stateId() { return d.d.stateId; },
        save: () => d.save(), saveAs: (p) => d.saveAs(p),
        requestClose: () => d.requestClose(), revert: () => d.revert(),
        get closed() { return !!d.closed; }, dw: d,
        get saving() { return saving(d); },
        doc: d.doc, text: d.text,
        summary: d.summary,             // (as opened)
        win: d.win, saveBytes: () => d.saveBytes(), d: d.d,
        view: d.view.hook(),
        get painter() { return d.view.painter; },  // (./PaintBind)
        count: () => countView(d.view),   // (./WordCount)
        toolbar: d.bar.tb,              // (WimpLib Ui/Toolbar)
        toolbar2: d.bar2.tb,            // (row 2)
        get inset() { return d.inset(); },
        ruler: d.rb.ruler,              // (WimpLib Ui/Ruler)
        get rulerOn() { return d.rulerOn; },
        setRuler: (on) => d.setRuler(on),
        get zoom() { return d.zoom; },  // (percent)
        setZoom: (z) => d.setZoom(z),
        relayout: () => d.relayout(),
        get docKey() { return d.docKey; },
        get clipboard() { return {...d.clip}; },
        ...clipHook(d),
      }));
    },
    open: (path) => app.open(path),
    new: (o) => app.newDoc(o),
    newUntitled: (paper) => app.newDoc({paper}),
    get keys() { return [...docs.keys()]; },
    ask: (o) => saveQuery({...o, task}),
    get prompt() {
      const p = app.prompt;
      return p && {leaf: p.dw ? p.dw.leaf : null, buttons: p.buttons,
        win: p.win};
    },
    get recent() { return [...app.recent]; },
    get recentReady() { return app.recentReady; },
    mayQuit: () => mayQuit(app),
    quit: () => quit(app),
    find: findHook(app),
    symbols: symbolsHook(app),
    dialog: (o) => dialog({...o, task}),
    get pics() { return CACHE.stats(); },
  };
}
