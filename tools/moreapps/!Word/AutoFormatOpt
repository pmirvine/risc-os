// AutoFormatOpt - the AutoFormat lists choice: whether a marker
// typed at a paragraph's start, then a space or Tab, makes a list
// item (./AutoList). On unless turned off with Format > AutoFormat
// lists; kept in Choices:Word as 'autoList' (./WordChoices), for
// every document window of Word at once.
//
//   autoListOn(app) -> boolean  false only when the choice read or
//                       set is false (missing, corrupt or any other
//                       value: on)
//   setAutoList(app, on) -> Promise  the choice set and written
//                       (./WordChoices setChoice: Recent kept)
//   autoListItem(app)   the Format menu's item 'AutoFormat lists',
//                       ticked while on; choosing it turns it over
// The windows ask autoListOn when a space or Tab is typed
// (./DocKeys sets view.autoList), so a change works at once.
import {choiceOf, setChoice} from './WordChoices';

const KEY = 'autoList';

/** See the header. */
export const autoListOn = (app) => choiceOf(app, KEY) !== false;

/** See the header. */
export const setAutoList = (app, on) => setChoice(app, KEY, !!on);

/** See the header. */
export function autoListItem(app) {
  return {text: 'AutoFormat lists', ticked: () => autoListOn(app),
    action: () => { setAutoList(app, !autoListOn(app)); },
    help: 'When ticked, typing * or 1. (and the like) and a space ' +
      'at the start of a paragraph makes it a list item.'};
}
