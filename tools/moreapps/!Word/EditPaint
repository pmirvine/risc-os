// EditPaint - draws a document's window: the grey desk, the page (a
// white column with a thin border and a shadow), the text
// (./DocPaint) and the selection.
//
//   paintView(L, g, rect, sel, active)
//     L     a ./DocLayout, laid out
//     g     a canvas 2D context in work-area coordinates
//     rect  {x0, y0, x1, y1}, the part to draw (work area)
//     sel   a ./Selection, or null
//     active  whether the window has the input focus
//   pageRect(L) -> {x, y, w, h}, the white page (work area)
//
// The selection is lit after the text, multiplied into what is
// there, so the text stays black on it and a kept block's grey box
// is tinted too: light blue (SEL) in the window with the input
// focus, light grey (SEL_OFF) in another. Only the band in rect is
// looked at (./DocRects), so a selection of a whole long document
// costs no more to draw than a short one.
// Draws on the context it is given; imports no desktop services.
import {paint} from './DocPaint';

export const DESK = '#888888', SEL = '#b3d4fc', SEL_OFF = '#d4d4d4';
const TOP = 8, SHADOW = 3;

/** See the header. */
export function pageRect(L) {
  const w = Math.max(L.pageW, L.marL + L.textW);
  return {x: Math.round(L.pageLeft), y: TOP, w: Math.round(w),
    h: Math.max(0, Math.round(L.height - 2 * TOP))};
}

/** See the header. */
export function paintView(L, g, rect, sel, active) {
  g.fillStyle = DESK;
  g.fillRect(rect.x0, rect.y0, rect.x1 - rect.x0, rect.y1 - rect.y0);
  const p = pageRect(L);
  g.fillStyle = '#555555';
  g.fillRect(p.x + SHADOW, p.y + SHADOW, p.w, p.h);
  g.fillStyle = '#ffffff';
  g.fillRect(p.x, p.y, p.w, p.h);
  g.strokeStyle = '#444444';
  g.lineWidth = 1;
  g.strokeRect(p.x - 0.5, p.y - 0.5, p.w + 1, p.h + 1);
  paint(L, g, rect);
  if (!sel) return;
  const rects = L.selectionRects(sel, rect.y0, rect.y1);
  if (!rects.length) return;
  g.save();
  g.globalCompositeOperation = 'multiply';
  g.fillStyle = active ? SEL : SEL_OFF;
  for (const r of rects) g.fillRect(r.x, r.y, r.w, r.h);
  g.restore();
}
