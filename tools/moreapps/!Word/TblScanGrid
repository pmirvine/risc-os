// TblScanGrid - the grid and span checks of ./TblScan (split from it
// in the C3 fix wave): a table's w:tblGrid read, and a row checked
// against MAX_COLS. Each adds its Opaque reason (R3) to the Set sc.
//
//   readGrid(node, map, sc) -> [twips]  the w:gridCol widths ('grid'
//     for a w:gridCol that is not just w:w = 0..MAX_TW, anything else
//     in the grid, not 1..MAX_COLS columns; 'tracked' for a
//     w:tblGridChange)
//   wide(row, sc)   'span' when the row is wider than MAX_COLS grid
//     columns: gridBefore + its cells' gridSpan + gridAfter
//   inRange(v, lo)  v absent, or an integer lo..MAX_COLS
//
// SECURITY: names from the file are only compared. Pure.
import {scope, wName, wAttrs, isEl, blank} from './Ns';
import {intOf} from './ReadPropsMore';
import {MAX_COLS, MAX_TW} from './TblCheck';

const inside = (node, map) => node.attrs.length ? scope(map, node)
  : map;

/** See the header. */
export const inRange = (v, lo) => v === undefined ||
  (Number.isInteger(v) && v >= lo && v <= MAX_COLS);

/** See the header. */
export function readGrid(node, map, sc) {
  const m = inside(node, map);
  const grid = [];
  for (const c of node.children) {
    if (!isEl(c)) {
      if (typeof c !== 'string' || !blank(c)) sc.add('grid');
      continue;
    }
    const l = wName(c, m);
    if (l === 'tblGridChange') {
      sc.add('tracked');
      continue;
    }
    const a = l === 'gridCol' ? wAttrs(c, m) : null;
    const w = a && a.size === 1 && c.children.every((x) =>
      typeof x === 'string' && blank(x)) ? intOf(a.get('w'))
      : undefined;
    // the writer writes String(w): "-0" would come back "0"
    if (w === undefined || w < 0 || w > MAX_TW ||
      String(w) !== a.get('w')) sc.add('grid');
    else grid.push(w);
  }
  if (grid.length < 1 || grid.length > MAX_COLS) sc.add('grid');
  return grid;
}

/** See the header. */
export function wide(row, sc) {
  const pr = row.trPr || {};
  let n = (pr.gridBefore || 0) + (pr.gridAfter || 0);
  for (const c of row.cells) {
    n += c.tcPr && c.tcPr.gridSpan !== undefined ? c.tcPr.gridSpan : 1;
  }
  if (!(n <= MAX_COLS)) sc.add('span');
}
