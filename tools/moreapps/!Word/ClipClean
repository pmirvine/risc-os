// ClipClean - clipboard blocks made fit to go into a document, for
// ./ClipPaste.
//
//   clean(blocks, doc, {sameDoc, styleNames}) -> blocks
//
// blocks: ./ClipSlice's shape (from a copy, or ./ClipRead); the
// result has the same shape (no ids: ./ClipPaste gives fresh ones;
// no extraP: a pasted paragraph gets []), new objects, every
// paragraph checked (RangeError for one that is not valid). Anything
// that is not a block is skipped.
//
// The same document (sameDoc): everything passes as it is: raw
// inlines (links, fields, symbols, pictures), styles, numPr (a list
// goes on), kept blocks (tables); except raw inlines whose XML holds
// an element with an id that must stay unique in the document
// (UNIQUE: bookmarkStart/End, commentRangeStart/End,
// commentReference, ins, del, moveFrom, moveTo, footnoteReference,
// endnoteReference, permStart/End, the moveFrom/moveTo range marks
// and the customXml*Range marks, at any depth): each becomes its
// display text (a w:ins its inserted text, a w:del nothing), or
// nothing. Pictures are kept although their wp:docPr id is then
// used twice (Word is believed to accept that: to be checked in
// real Word). A kept block whose XML holds any id that must stay
// unique (./ClipIds.hasIds: those elements, a wp:docPr, a content
// control's w:id, a change record's w:id) is pasted as text
// instead (./ClipIds.flatten: a paragraph per table row, cells
// joined by tabs); a kept one loses its w14:paraId / w14:textId.
// Elements with such ids in pPr.extra and in a run's rPr.extra
// (w:pPrChange, w:rPrChange: tracked format changes) are dropped.
//
// Another document (or HTML): what refers to the source document's
// parts cannot come, as the target has no op to add them:
//   - every raw inline goes: one with display text (a link, any
//     level 'p' wrapper) becomes that text (./Edit.clean: no control
//     characters, no U+FFFC), a w:t holding a character becomes that
//     character, any other (a picture with its r:embed, a field
//     character, a bookmark...) becomes nothing; a tab inline is a
//     tab character and a br inline (a page break too) a line break,
//     as typed ones are; the text keeps its run's formatting
//   - pStyle and rStyle are mapped by NAME (styleNames: Map id ->
//     {name, type}, ./ClipSlice) to the target's style of that name
//     and type (case ignored), else dropped (the default style)
//   - rPr keeps its modelled fields (rFonts b i u strike color sz
//     szCs highlight vertAlign: ./PropNames), its raw extra goes;
//     pPr keeps jc ind spacing keepNext keepLines pageBreakBefore
//     outlineLvl, numPr and the raw extra go (no list is made)
//   - kept blocks (tables, whose XML can point at the source's
//     parts) are skipped.
// Pure: no desktop services.
import {fail, normRuns, checkContent} from './ModelCheck';
import {RPR_FIELDS} from './PropNames';
import {clean as cleanText} from './Edit';
import {hasUnique, hasIds, dropIds, keepIds, flatten} from './ClipIds';

const PPR_KEEP = ['jc', 'ind', 'spacing', 'keepNext', 'keepLines',
  'pageBreakBefore', 'outlineLvl'];
const OBJ = '\ufffc';
const isObj = (v) => v !== null && typeof v === 'object' &&
  !Array.isArray(v);

/** {text, runs, inlines} of b, checked. */
function contentOf(b) {
  const c = {text: b.text, runs: b.runs, inlines: b.inlines};
  checkContent(c);
  return c;
}

/** A target style id for source style id, or undefined. */
function mapper(doc, names) {
  const index = new Map();
  const map = doc && doc.styles && doc.styles.styles;
  if (map instanceof Map) {
    for (const s of map.values()) {
      if (!s || typeof s.name !== 'string') continue;
      const k = s.type + '|' + s.name.toLowerCase();
      if (!index.has(k)) index.set(k, s.id);
    }
  }
  return (id, type) => {
    if (typeof id !== 'string' || !(names instanceof Map)) return;
    const n = names.get(id);
    if (!n || n.type !== type || typeof n.name !== 'string') return;
    return index.get(type + '|' + n.name.toLowerCase());
  };
}

/** Copy of o with only `keys` (and extra: []). */
function keep(o, keys) {
  const out = {};
  if (isObj(o)) {
    for (const k of keys) if (o[k] !== undefined) out[k] = o[k];
  }
  out.extra = [];
  return out;
}

const RKEEP = [...RPR_FIELDS.keys()];

/** The text an inline becomes across documents. */
function inlineText(x) {
  if (!isObj(x)) return '';
  if (x.kind === 'tab') return '\t';
  if (x.kind === 'br') return '\n';
  if (typeof x.text === 'string') return cleanText(x.text);
  const n = x.node;
  if (isObj(n) && /(^|:)t$/.test(String(n.name)) &&
    Array.isArray(n.children) &&
    n.children.every((c) => typeof c === 'string'))
    return cleanText(n.children.join(''));
  return '';
}

/**
 * The content c rebuilt run by run: each U+FFFC's inline x stays when
 * swap(x) is null, else becomes the text swap(x) gives; fmt(r) is a
 * run's new {rPr, rStyle?}.
 */
function rebuild(c, swap, fmt) {
  let text = '';
  const runs = [], inlines = {};
  for (const r of c.runs) {
    const s = c.text.slice(r.start, r.end);
    let t = '', at = 0;
    for (let j = s.indexOf(OBJ); j >= 0; j = s.indexOf(OBJ, at)) {
      t += s.slice(at, j);
      const x = c.inlines[r.start + j];
      const rep = swap(x);
      if (rep === null) {
        inlines[text.length + t.length] = x;
        t += OBJ;
      } else t += rep;
      at = j + 1;
    }
    t += s.slice(at);
    if (!t) continue;
    runs.push({start: text.length, end: text.length + t.length,
      ...fmt(r)});
    text += t;
  }
  return {text, runs: normRuns(runs), inlines};
}

/** Paragraph block b for another document. */
function cross(b, map) {
  const rprs = new Map();
  const fmt = (r) => {
    let rPr = rprs.get(r.rPr);
    if (!rPr) rprs.set(r.rPr, rPr = keep(r.rPr, RKEEP));
    const rs = map(r.rStyle, 'character');
    return rs === undefined ? {rPr} : {rPr, rStyle: rs};
  };
  const out = {type: 'p', ...rebuild(contentOf(b), inlineText, fmt),
    inlines: {}, pPr: keep(b.pPr, PPR_KEEP)};
  const ps = map(b.pStyle, 'paragraph');
  if (ps !== undefined) out.pStyle = ps;
  return out;
}

const local = (n) => String(n).split(':').pop();

/** Same document: the text an inline becomes, or null (kept). */
const sameSwap = (x) => (isObj(x) && x.kind === 'raw' &&
  hasUnique(x.node) ? (typeof x.text === 'string'
    ? cleanText(x.text) : '') : null);

/** Paragraph block b for its own document. */
function same(b) {
  const c = contentOf(b);
  if (!isObj(b.pPr) || !Array.isArray(b.pPr.extra)) fail('bad pPr');
  const swap = Object.values(c.inlines).some((x) => sameSwap(x) !==
    null);
  const fmt = (r) => (r.rStyle === undefined ? {rPr: dropIds(r.rPr)}
    : {rPr: dropIds(r.rPr), rStyle: r.rStyle});
  const body = swap ? rebuild(c, sameSwap, fmt)
    : {text: c.text, runs: normRuns(c.runs.map((r) => ({...r,
      ...fmt(r)}))), inlines: c.inlines};
  const out = {type: 'p', ...body, pPr: dropIds(b.pPr)};
  if (typeof b.pStyle === 'string') out.pStyle = b.pStyle;
  return out;
}

/** See the header. */
export function clean(blocks, doc, opts = {}) {
  const sameDoc = !!opts.sameDoc;
  const map = mapper(doc, opts.styleNames);
  const out = [];
  for (const b of Array.isArray(blocks) ? blocks : []) {
    if (!isObj(b)) continue;
    if (b.type === 'opaque') {
      if (!sameDoc || !isObj(b.node)) continue;
      if (hasIds(b.node)) out.push(...flatten(b.node));
      else out.push({type: 'opaque', node: keepIds(b.node)});
    } else if (b.type === 'p') {
      out.push(sameDoc ? same(b) : cross(b, map));
    }
  }
  return out;
}
