// FlowDeco - "page break before" on the screen: a ./DocStack
// decorator that puts a 12 px gap above a paragraph whose
// pageBreakBefore is on (its own, or its style's, or the document
// defaults': the last layer that says), and the dotted rule drawn
// there. There are no pages yet (Batch D): the rule only shows that
// the flag is set. Keep with next, keep lines together and widow
// control have no mark at all until pages arrive.
//
//   flowDeco(item, L, acc) -> {gapAbove: GAP, marks: [mark]} for
//                      a paragraph with the flag, else null
//   GAP                12 px: the gap above, the mark's height
//   breaksBefore(styles, para) -> whether the flag is in force
//   flowMark(item)     -> the mark of an item, or null
//   flowPaint(mark, w, labelW) -> {y, dots: [[a, b]...], label: x |
//                      null}: a single dotted rule across the text
//                      column (w px) at y px from the mark's top,
//                      its label (labelW px wide) in the middle
//                      with a gap round it (null: too narrow)
//
// The mark: {kind: 'flow', label: 'Page break before', dy: -GAP, h:
// GAP}: the gap is dy (-12) from the item's top (item.y), so the
// rule is above the paragraph and its space before (and above the
// gap the decorators before it gave, acc.gapAbove when positive: a
// top border's, ./BorderGroups; dy is then -GAP less it). It belongs
// to no item (a click in it is the paragraph below's), is never text
// and never selected. Contextual spacing cuts nothing across it
// (./ParaSpace: the paragraphs would be on different pages), nor
// does a border box (./BorderGroups). The mark depends on the
// paragraph and the styles only, both in the reuse key (./DocStack),
// and on the gaps of the decorators before it, worked out with it:
// no keyOf. Pure: no desktop services.
import {paraLayers} from './Styles';
import {bandPaint} from './SectDeco';

export const GAP = 12;
const LABEL = 'Page break before';

/** See the header. */
export function breaksBefore(styles, para) {
  let v = false;
  for (const l of paraLayers(styles, para)) {
    if (l && typeof l.pageBreakBefore === 'boolean')
      v = l.pageBreakBefore;
  }
  return v;
}

/** See the header. */
export function flowDeco(it, L, acc) {
  if (!it || it.kind !== 'p' || !it.block ||
    !breaksBefore(L.doc.styles, it.block)) return null;
  const up = acc && acc.gapAbove > 0 ? acc.gapAbove : 0;
  return {gapAbove: GAP, marks: [Object.freeze({kind: 'flow',
    label: LABEL, dy: -GAP - up, h: GAP})]};
}

/** See the header. */
export function flowMark(it) {
  for (const m of (it && it.marks) || []) {
    if (m && m.kind === 'flow') return m;
  }
  return null;
}

/** See the header. */
export function flowPaint(m, w, labelW) {
  const b = bandPaint(m, w, labelW);
  return {y: Math.round(m.h / 2) + 1, dots: b.dots, label: b.label};
}
