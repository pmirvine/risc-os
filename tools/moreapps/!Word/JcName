// JcName: the w:jc name a document spells an alignment with.
//
//   jcName(jc, strict)  the name for a left or right alignment
//     (jc 'left', 'start', 'right' or 'end'): Strict documents say
//     start / end, Transitional ones left / right; center, both and
//     anything else come back as given. Pure.
//   isStrictDoc(doc)    doc.meta.conformance is 'strict'
//
// Only values a command or a paste MAKES go through here; a w:jc
// read from a file is never renamed (it writes back as it was).
const NAMES = {
  left: ['left', 'start'], start: ['left', 'start'],
  right: ['right', 'end'], end: ['right', 'end']};

export const jcName = (jc, strict) => Object.hasOwn(NAMES, jc)
  ? NAMES[jc][strict ? 1 : 0] : jc;

export const isStrictDoc = (doc) =>
  !!(doc && doc.meta && doc.meta.conformance === 'strict');
