// Justify - spreads a laid-out line (./LineLayout) to the right edge
// of the text, for paragraphs with w:jc 'both'.
//
//   justify(line, maxX)   moves and widens line.items in place
//
// The free width (maxX less the right edge of the line's last item
// with visible text) is shared out equally over every space between
// its first and its last visible item: each space item (text of
// U+0020 only; ./LineLayout makes one per space in model text) grows
// by its share times its length and records the growth in js (px),
// and every item after it moves right. Spaces before the first word
// and those hanging after the last are not widened (the hanging ones
// move with the line's end). A line with a tab or a [...] box, with
// no space between words, or with no free width is left alone.
// Only x and w change, never offsets: ./PosLine scales a hit in a
// widened space by js. Linear in the items. Pure.

const isGap = (it) => it.text !== '' && /^ +$/.test(it.text);

/** See the header. */
export function justify(line, maxX) {
  const its = line.items;
  let a = -1, b = -1;
  for (let i = 0; i < its.length; i++) {
    const it = its[i];
    if (it.kind === 'tab' || it.kind === 'box') return;
    if (/\S/.test(it.text)) {
      if (a < 0) a = i;
      b = i;
    }
  }
  if (b < 0) return;
  const room = maxX - (its[b].x + its[b].w);
  let n = 0;
  for (let i = a + 1; i < b; i++) {
    if (isGap(its[i])) n += its[i].text.length;
  }
  if (!(room > 0) || !n) return;
  const per = room / n;
  let dx = 0;
  for (let i = a + 1; i < its.length; i++) {
    const it = its[i];
    it.x += dx;
    if (i < b && isGap(it)) {
      const e = per * it.text.length;
      it.w += e;
      it.js = e;
      dx += e;
    }
  }
}
