// TabAlign - the text after a right, centre or decimal tab, lined
// up with its stop (./TabStops), for ./LineLayout.
//
//   p = {it, idx, x, pos, val, dot}: a pending tab: its item it (at
//       line.items[idx], placed with no width at x), its stop pos
//       and val (center | right | decimal), dot the x of the first
//       '.' in the segment so far as placed (or null)
//   startOf(p, end, dot?) -> where the segment (placed from p.x up
//       to end) starts when lined up, or null when it does not fit
//       between p.x and the stop: right -> it ends at pos; center ->
//       centred on pos; decimal -> its first '.' at pos (dot, else
//       p.dot), none -> as right
//   alignedEnd(p, end, dot?) -> where the segment ends lined up, or
//       null (does not fit)
//   close(line, p, end) -> dx: the tab item widened by dx (to the
//       stop's alignment; 0 when the segment does not fit) and every
//       item after it, and line.ink when it is in the segment, moved
//       right by dx; end: where the segment's last non-space ends
//       (spaces after it are not lined up)
//   dotIn(group, x, metrics) -> the x of the first '.' in group
//       ([[token, w]] placed from x), or null; a [...] box has none
//
// The segment is what follows the tab on its line up to the next
// tab or the line's end. The tab item only ever grows from 0 (it is
// never narrower than nothing); a segment wider than the room
// before its stop (or than the margin, for ./LineLayout) leaves the
// tab with no width: the text goes on right after what came before
// it and wraps as usual (Word; T1). Only x and w change, never
// offsets.
// Pure: no desktop services.

const EPS = 0.01;

/** See the header. */
export function startOf(p, end, dot) {
  const w = end - p.x;
  const d = dot ?? p.dot;
  let s;
  if (p.val === 'center') s = p.pos - w / 2;
  else if (p.val === 'decimal' && d !== null && d !== undefined) {
    s = p.pos - (d - p.x);
  } else s = p.pos - w;
  return s < p.x - EPS ? null : Math.max(s, p.x);
}

/** See the header. */
export function alignedEnd(p, end, dot) {
  const s = startOf(p, end, dot);
  return s === null ? null : s + (end - p.x);
}

/** See the header. */
export function close(line, p, end) {
  const s = startOf(p, end);
  const dx = s === null ? 0 : Math.max(0, s - p.x);
  if (!dx) return 0;
  const its = line.items;
  p.it.w += dx;
  for (let i = p.idx + 1; i < its.length; i++) its[i].x += dx;
  if (line.ink > p.x + EPS) line.ink += dx;
  return dx;
}

/** See the header. */
export function dotIn(group, x, metrics) {
  for (const [tk, w] of group) {
    const i = tk.kind === 'box' ? -1 : tk.text.indexOf('.');
    if (i >= 0) {
      return x + (i ? metrics.width(tk.text.slice(0, i), tk.f.css) : 0);
    }
    x += w;
  }
  return null;
}
