// MacKeys - Cmd (the Meta key) as Ctrl for !Word's editing and
// format keys on a Mac, as Mac programs have them:
//
//   isMac(platform) -> boolean   platform: navigator.platform (the
//                                caller's: ./EditClip sets view.mac)
//   macKey(ev, mac) -> ev, or a copy given as Ctrl + the letter
//   CMD                          the letters Cmd works for
//   macLabel(label, mac) -> a menu's key label: 'Ctrl+Z' is 'Cmd+Z'
//                                on a Mac for a CMD letter and for
//                                C, X, V; other labels as they are
//
// On a Mac, a 'key' event whose browser event has Cmd (metaKey),
// with neither Ctrl nor Alt, for a letter in CMD (Cmd-Z undo, Cmd-Y
// and Cmd-Shift-Z redo, Cmd-A select all, Cmd-B, Cmd-I, Cmd-U bold,
// italic, underline, Cmd-E centre, Cmd-J justify, Cmd-S save,
// Cmd-N new (the browser may keep Cmd-N), Cmd-F find, Cmd-G and
// Cmd-Shift-G find next and previous) comes back as a
// copy with ctrl true and the Ctrl-letter code (1..26), so ./Keymap
// and ./Keys see Ctrl-Z. Never
// Cmd-R or Cmd-L (the browser's reload and location bar: the Wimp
// cancels them for a text caret, and they do nothing here), never
// Cmd-C, Cmd-X, Cmd-V (the browser's own copy, cut and paste: see
// ./EditClip), never Cmd-M (macOS minimises the window: the page
// never gets it; indent with Ctrl-M), never Cmd-H (macOS hides the
// program: Replace is Ctrl-H), and no other key: ev itself.
// Pure: no desktop services.

export const CMD = new Set(['a', 'b', 'e', 'f', 'g', 'i', 'j', 'n',
  's', 'u', 'y', 'z']);
const CLIP = new Set(['c', 'x', 'v']);

/** See the header. */
export const isMac = (platform) => typeof platform === 'string' &&
  /^(Mac|iPhone|iPad|iPod)/.test(platform);

/** See the header. */
export function macKey(ev, mac) {
  if (!mac || !ev || typeof ev !== 'object' || ev.ctrl || ev.alt)
    return ev;
  const e = ev.domEvent;
  if (!e || !e.metaKey || e.ctrlKey || e.altKey) return ev;
  const k = typeof ev.key === 'string' ? ev.key.toLowerCase() : '';
  if (!CMD.has(k)) return ev;
  return {...ev, ctrl: true, code: k.charCodeAt(0) - 96};
}

/** See the header. */
export function macLabel(label, mac) {
  const m = /^Ctrl\+((?:Shift\+)?)([A-Z])$/.exec(String(label));
  if (!mac || !m) return label;
  const k = m[2].toLowerCase();
  return CMD.has(k) || CLIP.has(k) ? 'Cmd+' + m[1] + m[2] : label;
}
