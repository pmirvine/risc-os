// EditRun - the commands of a document's window (./EditView), by
// ./Keymap id:
//
//   runView(v, id) -> true if used, undefined if not (the key then
//                     goes on)
//   stepView(v, 'undo' | 'redo')
//
// A formatting id (./FormatApply) is v.format(id) (used whenever
// there is a selection, even if it changes nothing); any other
// command first drops the pending format (./EditFormat). undo and
// redo end the typing's undo step; selectAll selects everything
// without scrolling; insert switches overwrite on or off; the rest
// are editing commands (./EditApply.run): the selection after one
// is shown when laid out (v.edited). Uses only the view: no desktop
// services.
import * as S from './Selection';
import {run} from './EditApply';
import {isFormat} from './FormatApply';
import {dropPending} from './EditFormat';

/** See the header. */
export function stepView(v, kind) {
  v.ensure();
  dropPending(v);
  if (!(kind === 'undo' ? v.d.canUndo : v.d.canRedo)) return;
  v.typing.command(() => v.d[kind]());
  v.edited(v.sel);
}

/** See the header. */
export function runView(v, id) {
  if (isFormat(id)) {
    if (!v.sel) return undefined;
    v.format(id);
    return true;
  }
  dropPending(v);
  if (id === 'undo' || id === 'redo') {
    stepView(v, id);
    return true;
  }
  if (id === 'selectAll') {
    if (v.sel) v.setSelection(S.selectAll(v.L), {scroll: false});
    return true;
  }
  if (id === 'insert') {
    v.overwrite = !v.overwrite;
    v.typing.reset();
    v.win.invalidate();
    return true;
  }
  if (!v.sel) return undefined;
  const out = run(id, v.d, v.typing, v.sel);
  if (out === undefined) return undefined;
  if (out !== v.sel) v.edited(out);
  return true;
}
