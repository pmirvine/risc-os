// DocxError - what readDocx throws for a file it cannot read, and
// writeDocx for a Doc it cannot write.
//
//   err.code   one of:
//     'not-docx'     not a zip, or a zip that is not a Word package
//     'no-document'  a package without a main document part
//     'bad-xml'      a part it needs is not well-formed XML
//     'unsupported'  too big, or zip64 or encrypted (writing: a
//                    root that binds w to another namespace)
//     'bad-model'    (writeDocx) a Doc that is not valid: nothing
//                    is written (see ./DocxWrite)
//   err.part   the part name involved, if any
//   err.cause  the ZipError or XmlError underneath, if any
//   err.kind   'ole2' for an older Word (.doc) or password-protected
//              file (an OLE2 container, not a zip), else undefined

export class DocxError extends Error {
  /**
   * @param {string} code see above
   * @param {string} [message] defaults to the code
   * @param {{part?: string, cause?: *, kind?: string}} [opts]
   */
  constructor(code, message, opts = {}) {
    super(message || code,
      opts.cause === undefined ? undefined : {cause: opts.cause});
    this.name = 'DocxError';
    this.code = code;
    this.part = opts.part;
    this.kind = opts.kind;
  }
}
