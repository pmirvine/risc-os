// EditInput - typed text and input methods in a document's window
// (./EditView), from the Wimp's text-input caret (src/core
// textinput):
//
//   attachInput(view)
//
//   textinput       the text is typed (view.input): one event, one
//                   edit, however long (at most 100,000 characters,
//                   the Wimp's limit)
//   composition     an input method is composing: its text is shown
//                   at the caret (view.compose), not yet in the
//                   document
//   compositionend  the composing text goes; what is committed comes
//                   next as a textinput (nothing when cancelled)
//   losecaret       the input focus went elsewhere: any composing
//                   text goes too
// Events for a window that is no longer open are ignored.
// It also gives the view fromProxy(ev): whether a 'key' event came
// from the Wimp's hidden text field while it had the focus (a
// printable key from there is never text: ./EditKeys).
import {wimp} from 'riscos';

/** See the header. */
export function attachInput(v) {
  const w = v.win;
  v.fromProxy = (ev) => {
    const t = wimp.textInput, e = ev && ev.domEvent;
    return !!(e && t && t.el && t.focused && e.target === t.el);
  };
  w.on('textinput', (ev) => {
    if (w.isOpen) v.input(ev.text);
    return true;
  });
  w.on('composition', (ev) => {
    if (w.isOpen && wimp.caret?.window === w) v.compose(ev.text);
    return true;
  });
  w.on('compositionend', () => {
    v.compose(null);
    return true;
  });
  w.on('losecaret', () => v.compose(null));
}
