// BookmarkFind - the bookmarks of a document, found: the one lookup
// for the Bookmark box (./Bookmarks, ./BookmarkBox), the Hyperlink
// box's popup (./LinkBox) and a Ctrl-click on a link (./EditMouse).
//
//   marks(doc) -> [{kind 'start' | 'end', name (start: its w:name,
//       else null), id (w:id as written, or null), at, off, table,
//       direct}] every w:bookmarkStart and w:bookmarkEnd in document
//       order (./Walk: the model; XML only inside an Opaque block or
//       an inline; a typed table's loose marks between its rows and
//       cells in their places): at the block's path; off the offset
//       of its U+FFFC in the paragraph (a mark inside a kept wrapper,
//       a link or an insertion, has the wrapper's); in a typed
//       table's cell the same, at the cell paragraph's path (C3.5); a
//       loose mark of a typed table at a paragraph's edge: a row's or
//       a cell's lead at the start of that row's (cell's) first
//       paragraph, a row's tail at the end of its last cell's last
//       paragraph, the table's tail at the end of its last cell's;
//       table: in a kept block (an Opaque table...): at its path, off
//       0; direct: the mark is a level-'p' inline itself (so it can
//       be moved or deleted: never a loose or kept one).
//       marks.complete is false when the walk stopped at its
//       1,000,000-node limit
//   pairs(doc) -> [{name, id, start, end}] one per start with a name
//       (start and end marks; end null when there is none): each end
//       goes with the earliest start before it with its id that has
//       none yet. pairs.marks is marks(doc)
//   findPair(ps, name) -> the pair named name exactly, else the first
//       one with case ignored (Word's names are unique so), or null
//   list(doc, {hidden, sort}) -> [{name, id, at: {at, off} | null
//       (in a kept block)}] one per name (case ignored: the first),
//       hidden ones (a name starting '_', such as _Toc...) only with
//       hidden;
//       sort 'location' (document order, the default) or 'name'
//       (case ignored, by UTF-16 code units: the same on every
//       machine)
//   bookmarkNames(doc, {hidden?, max = 500}) -> list's names
//   linkNames(doc) -> the names a link may go to (./LinkBox's
//       popup): bookmarkNames without the ones ./LinkUrl checkAnchor
//       refuses (U+FFFC, spaces, controls...)
//   findBookmark(doc, name) -> {id, off} | null  where it starts: the
//       offset of its U+FFFC (a wrapper's when inside one), in a
//       typed table's cell too; in a kept block its start {id, off:
//       0}. id is the ./DocPos blockId
//
// Names from files are only compared, never used as object keys (a
// bookmark may be called __proto__); ids are Map keys. Pure: no
// desktop services.
import {OBJ} from './Model';
import {blockId} from './DocPos';
import {at as walkAt, forEachBlock, forEachIn, loose} from './Walk';
import {samePath} from './Path';
import {localName} from './Kinds';
import {checkAnchor} from './LinkUrl';

const LIMIT = 1e6;
const KIND = {bookmarkStart: 'start', bookmarkEnd: 'end'};

/** The value of the attribute with local name `local`, or null. */
function attr(n, local) {
  if (!Array.isArray(n.attrs)) return null;
  for (const [k, v] of n.attrs) {
    if (String(k).split(':').pop() === local) return String(v);
  }
  return null;
}

/** Whether loose mark m (./Walk loose) comes before cell (r, c). */
const before = (m, r, c) => m.r < r || (m.r === r &&
  (m.where === 'rowLead' || (m.where === 'lead' && m.c <= c)));

/** See the header. */
export function marks(doc) {
  const out = [];
  let seen = 0;
  out.complete = true;
  const inNode = (top, at) => {
    const stack = [top];
    while (stack.length) {
      const n = stack.pop();
      if (++seen > LIMIT) return false;
      if (!n || typeof n !== 'object') continue;
      const kind = KIND[localName(n)];
      if (kind) {
        out.push({kind, name: kind === 'start' ? attr(n, 'name') : null,
          id: attr(n, 'id'), at: at.at, off: at.off, table: at.table,
          direct: n === top && !!at.own});
      }
      const kids = Array.isArray(n.children) ? n.children : [];
      for (let k = kids.length - 1; k >= 0; k--) {
        if (kids[k] && typeof kids[k] === 'object') stack.push(kids[k]);
      }
    }
    return true;
  };
  // the typed tables around the walk, outermost first: {at, t, ls
  // (their loose marks), k (the next one to report)}
  const open = [];
  const flush = (o, r, c) => {
    for (; o.k < o.ls.length; o.k++) {
      const m = o.ls[o.k];
      if (r !== undefined && !before(m, r, c)) break;
      if (!inNode(m.node, placeOf(o, m))) return false;
    }
    return true;
  };
  const visit = (b, at, depth, cell) => {
    while (open.length && !(cell &&
      samePath(open[open.length - 1].at, cell.table))) {
      if (!flush(open.pop())) return false;
    }
    if (cell && !flush(open[open.length - 1], cell.r, cell.c))
      return false;
    if (b.type === 'tbl') {
      open.push({at, t: b, ls: loose(b), k: 0});
      return true;
    }
    if (b.type !== 'p')
      return inNode(b.node, {at, off: 0, table: true});
    if (b.text.indexOf(OBJ) < 0) return true;
    const offs = Object.keys(b.inlines).map(Number)
      .sort((x, y) => x - y);
    for (const off of offs) {
      const x = b.inlines[off];
      if (x.kind !== 'raw' || x.level !== 'p' || !x.node) continue;
      if (!inNode(x.node, {at, off, table: false, own: true}))
        return false;
    }
    return true;
  };
  // (the tables still open end with the document: innermost first)
  out.complete = forEachBlock(doc, visit) &&
    open.reverse().every((o) => flush(o));
  return out;
}

/** Where loose mark m (./Walk loose) of open table o is put: a row's
 *  or a cell's lead at the start of the row's (cell's) first
 *  paragraph, a row's tail at the end of its last cell's last one,
 *  the table's tail at the end of the last cell's last one (nested
 *  tables entered; a cell with no paragraph: its first block, kept). */
function placeOf(o, m) {
  const {t, at} = o;
  const last = m.where === 'tail' || m.where === 'rowTail';
  const r = m.where === 'tail' ? t.rows.length - 1 : m.r;
  const row = t.rows[r];
  const c = last ? row.cells.length - 1 : m.where === 'lead' ? m.c : 0;
  const base = [...at, r, c];
  let got = null;
  forEachIn(row.cells[c].blocks, base, (b, p) => {
    if (b.type !== 'p') return true;
    got = {at: p, off: last ? b.text.length : 0, table: false};
    return last;
  });
  return got || {at: [...base, 0], off: 0, table: true};
}

/** See the header. */
export function pairs(doc) {
  const ms = marks(doc), out = [], open = new Map();
  for (const m of ms) {
    if (m.kind === 'start') {
      if (m.name === null) continue;
      const p = {name: m.name, id: m.id, start: m, end: null};
      out.push(p);
      if (m.id === null) continue;
      if (!open.has(m.id)) open.set(m.id, []);
      open.get(m.id).push(p);
    } else {
      const q = m.id === null ? null : open.get(m.id);
      if (q && q.length) q.shift().end = m;
    }
  }
  out.marks = ms;
  return out;
}

/** See the header. */
export function findPair(ps, name) {
  if (typeof name !== 'string' || !name) return null;
  const want = name.toLowerCase();
  return ps.find((p) => p.name === name) ||
    ps.find((p) => p.name.toLowerCase() === want) || null;
}

const byName = (a, b) => {
  const x = a.name.toLowerCase(), y = b.name.toLowerCase();
  if (x !== y) return x < y ? -1 : 1;
  return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
};

/** See the header. */
export function list(doc, {hidden = false, sort = 'location'} = {}) {
  const out = [], low = new Set();
  for (const p of pairs(doc)) {
    const k = p.name.toLowerCase();
    if (!p.name || low.has(k)) continue;
    low.add(k);
    if (!hidden && p.name.startsWith('_')) continue;
    const m = p.start;
    out.push({name: p.name, id: p.id, at: m.table ? null
      : {at: m.at, off: m.off}});
  }
  return sort === 'name' ? out.sort(byName) : out;
}

/** See the header. */
export const bookmarkNames = (doc, {hidden = false, max = 500} = {}) =>
  list(doc, {hidden}).slice(0, max).map((b) => b.name);

/** See the header. */
export const linkNames = (doc) =>
  bookmarkNames(doc).filter((n) => checkAnchor(n) === null);

/** See the header. */
export function findBookmark(doc, name) {
  const p = findPair(pairs(doc), name);
  if (!p) return null;
  const m = p.start;
  return {id: blockId(walkAt(doc, m.at)), off: m.off};
}
