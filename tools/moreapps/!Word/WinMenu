// WinMenu - the menu of a document's window (./AppWin):
//
//   windowMenu(dw) -> a Menu
//     Save copy as .docx >   a Save box (the copy: dw.saveBytes)
//     Info >                 what the document holds (./Info)
//     Edit >                 undo, redo, select all (./EditMenu)
//     Format >               ./FormatMenu, with Ruler (dw.setRuler)
//     Zoom >                 50%..200%, Zoom in, Zoom out (./ZoomBind)
//     Close
//
// The Save and Info boxes are made once (a menu asks for a submenu
// each time the pointer goes over its arrow), made again only if
// deleted, and kept in dw.boxes ('save', 'info' -> Window), which
// ./AppWin deletes with the document.
import {Menu, saveAs} from 'riscos';
import {editMenu} from './EditMenu';
import {formatMenu} from './FormatMenu';
import {infoWindow} from './Info';
import {zoomMenu} from './ZoomBind';

/** dw's box name, made by make() if there is none. */
function box(dw, name, make) {
  let b = dw.boxes.get(name);
  if (!b) {
    b = make();
    dw.boxes.set(name, b);
    b.on('deleted', () => {
      if (dw.boxes.get(name) === b) dw.boxes.delete(name);
    });
  }
  return b;
}

/** See the header. */
export function windowMenu(dw) {
  const task = dw.app.task;
  return new Menu('Word', [
    {text: 'Save copy as .docx', submenu: () => box(dw, 'save',
      () => saveAs({task, title: 'Save as', filename: dw.leaf,
        filetype: 0xA7E, getData: () => dw.saveBytes()})),
    help: 'Save a copy of this document, as it is now, as a ' +
      'Word .docx file: the parts it does not show are saved ' +
      'as they were.'},
    {text: 'Info', submenu: () => box(dw, 'info',
      () => infoWindow(task, dw.leaf, dw.doc)),
    help: 'What the document holds.'},
    {text: 'Edit', submenu: () => editMenu(dw.view),
      help: 'Undo, redo, select all.'},
    {text: 'Format', submenu: () => formatMenu(dw.view, {
      ruler: () => dw.rulerOn,
      toggleRuler: () => dw.setRuler(!dw.rulerOn)}),
    help: 'Bold, italic, font, size, colour, alignment, ' +
      'paragraph styles; the ruler.'},
    {text: 'Zoom', submenu: () => zoomMenu(dw),
      help: 'Show the page larger or smaller (CTRL with the wheel ' +
        'does it too).'},
    {text: 'Close', action: () => dw.close(),
      help: 'Close this document.'},
  ]);
}
