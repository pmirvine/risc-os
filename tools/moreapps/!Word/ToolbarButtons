// ToolbarButtons - the buttons of a document's toolbar
// (./ToolbarBind), left to right, as WimpLib Ui/Toolbar takes them:
//
//   BUTTONS   [{name, kind, sprite?, w?, gap?, validation?, help...}]
//   ACTIONS   the names that are ./FormatApply ids run as they are
//             (view.format(name))
//   TOGGLES   [[name, query key, value]]: pressed in when the
//             selection's ./Format.query has that value
//   ALIGNS    [[name, align]]: the alignment radio buttons
//   BAR_H     the toolbar's height (px)
// Sprites wb_* are !Word's own (tools/moreapps/icon.mjs); up, down and
// gright are the Wimp's. Pure: no desktop services.

export const BAR_H = 34;

const S = '|MClick SELECT to ';
const tog = (name, sprite, what, gap = 0) => ({name, kind: 'toggle',
  sprite, gap, help: `${what}.${S}set it or clear it.`});
const act = (name, sprite, help, gap = 0) => ({name, kind: 'action',
  sprite, gap, help});
const align = (name, sprite, how, gap = 0) => ({name, kind: 'radio',
  group: 'align', sprite, gap,
  help: `Lines ${how}.${S}line the paragraph up like this.`});

export const BUTTONS = Object.freeze([
  {name: 'style', kind: 'field', w: 96, help: 'The paragraph\'s ' +
    'style.' + S + 'choose another.'},
  {name: 'styleMenu', kind: 'popup', help: 'The document\'s ' +
    'paragraph styles.' + S + 'choose one.'},
  {name: 'font', kind: 'field', w: 108, gap: 6, validation: 'R7',
    maxLen: 31, help: 'The font of the selection (empty when it ' +
      'has several).|MType a font name and press Return.'},
  {name: 'fontMenu', kind: 'popup', help: 'The fonts.' + S +
    'choose one.'},
  {name: 'size', kind: 'field', w: 36, gap: 6, validation: 'R7;A0-9.',
    maxLen: 5, help: 'The size of the text in points (empty when ' +
      'it has several).|MType a size and press Return.'},
  {name: 'sizeMenu', kind: 'popup', help: 'Word\'s sizes.' + S +
    'choose one.'},
  act('fontBigger', 'up', 'Bigger.' + S + 'make the text a size ' +
    'bigger (Ctrl-Shift->).'),
  act('fontSmaller', 'down', 'Smaller.' + S + 'make the text a ' +
    'size smaller (Ctrl-Shift-<).'),
  tog('bold', 'wb_bold', 'Bold (Ctrl-B)', 6),
  tog('italic', 'wb_italic', 'Italic (Ctrl-I)'),
  tog('underline', 'wb_underline', 'Underline (Ctrl-U)'),
  tog('strike', 'wb_strike', 'Strikethrough'),
  tog('superscript', 'wb_super', 'Superscript: smaller, above'),
  tog('subscript', 'wb_sub', 'Subscript: smaller, below'),
  {...act('color', 'wb_colour', 'The colour of the text, shown ' +
    'under the A.' + S + 'choose another.', 6), swatch: true},
  act('highlight', 'wb_highlight', 'A colour behind the text.' + S +
    'choose one.'),
  align('alignLeft', 'wb_left', 'start at the left (Ctrl-L)', 6),
  align('alignCenter', 'wb_centre', 'centred (Ctrl-E)'),
  align('alignRight', 'wb_right', 'end at the right (Ctrl-R)'),
  align('alignJustify', 'wb_justify', 'fill the width (Ctrl-J)'),
  act('indentLess', 'wb_indless', 'Indent less.' + S + 'move the ' +
    'paragraph\'s left edge half an inch out.', 6),
  act('indentMore', 'wb_indmore', 'Indent more.' + S + 'move the ' +
    'paragraph\'s left edge half an inch in.'),
  act('clearFormat', 'wb_clear', 'Clear formatting.' + S +
    'remove the character formatting (Ctrl-Space).', 6),
].map((b) => Object.freeze(b)));

export const TOGGLES = Object.freeze([['bold', 'bold', true],
  ['italic', 'italic', true], ['underline', 'underline', true],
  ['strike', 'strike', true], ['superscript', 'vert', 'superscript'],
  ['subscript', 'vert', 'subscript']]);

export const ALIGNS = Object.freeze([['alignLeft', 'left'],
  ['alignCenter', 'center'], ['alignRight', 'right'],
  ['alignJustify', 'both']]);

export const ACTIONS = Object.freeze(['fontBigger', 'fontSmaller',
  ...TOGGLES.map((t) => t[0]), ...ALIGNS.map((a) => a[0]),
  'indentLess', 'indentMore', 'clearFormat']);
