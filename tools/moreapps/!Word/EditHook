// EditHook - what the tests see of a document's ./EditView
// (task.word.docs[i].view, !RunImage):
//
//   hook(view) -> {selection, layout, dirty, undoDepth, overwrite,
//     composing, pending, selRev, lit, zoom (getters); text(),
//     caretRect() (zoomed, in the work area),
//     setSelection(a, b = a, affinity), type(text), press(id),
//     compose(text), flush(), lines(), format(id, arg), query()}
//
// press runs a ./Keymap command (view.run), format a formatting
// command (view.format: true if applied), query the formatting of
// the selection (./Format.query, cached per selRev). Uses only the
// view: no desktop services.
import * as S from './Selection';

/** See the header. */
export function hook(v) {
  return {
    get selection() { return v.sel; },
    get layout() { return v.L; },
    get dirty() { return v.d.dirty; },
    get undoDepth() { return v.d.undoDepth; },
    get overwrite() { return v.overwrite; },
    get composing() { return v.comp; },
    get pending() { return v.pending; },
    get selRev() { return v.selRev; },
    get lit() { return v.lit; },
    get zoom() { return v.zoom; },
    text: () => v.text(),
    caretRect: () => v.caretRect(),
    setSelection: (a, b = a, aff) =>
      v.setSelection(S.select(a, b, aff)),
    type: (t) => v.input(t),
    press: (id) => v.run(id),
    compose: (t) => v.compose(t),
    flush: () => v.flush(),
    format: (id, arg) => v.format(id, arg),
    query: () => v.query(),
    lines: () => v.d.doc.sections.flatMap((s) =>
      s.blocks.map((b) => (b.type === 'p' ? b.text : null))),
  };
}
