// Boxes - the dialogue boxes of a document's window (its Save and
// Info boxes, ./WinMenu, ./DocSave), made once: a menu asks for a
// submenu each time the pointer goes over its arrow.
//
//   box(dw, name, make) -> dw.boxes.get(name), made by make() if
//                          there is none (or it was deleted)
//
// dw.boxes is a Map name -> Window; ./AppWin deletes them with the
// document. Uses no desktop services itself.

/** See the header. */
export function box(dw, name, make) {
  let b = dw.boxes.get(name);
  if (!b) {
    b = make();
    dw.boxes.set(name, b);
    b.on('deleted', () => {
      if (dw.boxes.get(name) === b) dw.boxes.delete(name);
    });
  }
  return b;
}
