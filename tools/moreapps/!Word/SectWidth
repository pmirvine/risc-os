// SectWidth - the width of a section's text column in twips: the one
// rule Insert > Picture and Insert > Table size by (Batch C4 fix
// wave; it was written in both).
//
//   columnTw(props) -> the section's page width (w:pgSz w, A4's 11906
//       when not given) less its left and right margins (1440 each
//       when not given), less the spaces between its w:cols num
//       columns (720 each when not given; num below 2: one column),
//       divided by num: a number, fractional or <= 0 as it comes (the
//       caller decides what that means). props: a section's props
//       (null or {} for the defaults).
// Pure: no desktop services.

const num = (v, d) => (Number.isFinite(v) ? v : d);

/** See the header. */
export function columnTw(props) {
  const pr = props || {};
  const sz = pr.pgSz || {}, mar = pr.pgMar || {}, cols = pr.cols || {};
  const tw = num(sz.w, 11906) - num(mar.left, 1440) -
    num(mar.right, 1440);
  const k = cols.num > 1 ? Math.floor(cols.num) : 1;
  return (tw - (k - 1) * num(cols.space, 720)) / k;
}
