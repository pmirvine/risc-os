// RulerInd - what a document's ruler (./RulerBind) shows, worked out
// from the document and its layout:
//
//   RULER_H              the ruler's height (px)
//   firstIndents(doc, sel) -> {left, first, right} | null  the
//       indents drawn (twips: ./ParaInd.effective, a list level's
//       too; first < 0 for a hanging indent: a list label's place)
//       of the first paragraph the selection touches, at any depth
//       (./SelShape paraRanges: a kept block at its start, the next
//       paragraph; a table, its first cell's); null when there is
//       none (no selection, a caret on a table)
//   firstPara(doc, sel) -> the first 'p' block the selection
//       touches (as above), or null
//   textTwips(L, pos?)   the text's width (twips) of a ./DocLayout
//   scaleOf(L, scrollX, zoom = 1, pos?) -> the WimpLib Ui/Ruler
//       scale: origin (the text's left edge), page and text [x0, x1]
//       (px in the window's work area: L's px times the zoom, a
//       factor: ./Zoom), zoom, scrollX
// The text is the column of pos's item (the caret: its x and w,
// ./DocItems); the page's (L.left, L.textW) without pos or when pos
// is not in L.
// Pure: no desktop services.
import {orderedPos} from './EditPos';
import {paraRanges} from './SelShape';
import {at as walkAt} from './Walk';
import {effective} from './ParaInd';

export const RULER_H = 24;

/** See the header. */
export function firstPara(doc, sel) {
  const ok = sel && sel.anchor && sel.head && orderedPos(doc, sel);
  const en = ok ? paraRanges(doc, sel)[0] : null;
  return en ? walkAt(doc, en.at) : null;
}

/** See the header. */
export function firstIndents(doc, sel) {
  const p = firstPara(doc, sel);
  if (!p) return null;
  return effective(doc, p);
}

/** The column {x, w} of pos's item, else the page's text. */
function colOf(L, pos) {
  const loc = pos && L.locate ? L.locate(pos) : null;
  return loc ? loc.item : {x: L.left, w: L.textW};
}

/** See the header. */
export const textTwips = (L, pos) => Math.round(colOf(L, pos).w * 15);

/** See the header. */
export function scaleOf(L, scrollX, zoom = 1, pos) {
  const z = zoom, c = colOf(L, pos);
  return {origin: c.x * z,
    page: [L.pageLeft * z, (L.pageLeft + L.pageW) * z],
    text: [c.x * z, (c.x + c.w) * z], zoom: z, scrollX};
}
