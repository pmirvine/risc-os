// Units - lengths and point sizes as a dialog field shows them, and
// what a field holds read back. Everything is in twips: 1440 to the
// inch, 20 to the point (as Word stores indents and spacing).
//
//   parseLength(text, {min, max}) -> twips, or null
//       inches: a plain decimal number, alone or followed by " or
//       in ('0.5', '0.5"', '1 in'); or points followed by pt
//       ('36 pt'); a minus sign allowed; spaces around the parts;
//       any case. No centimetres, exponents or other characters
//       (null). Rounded to whole twips, then clamped to min..max
//       (default -LIMIT..LIMIT: Word's 22 inches)
//   formatLength(twips) -> inches with at most 2 decimals and no
//       trailing zeros, then " ('0.5"', '1"'); '' for no length (a
//       mixed selection: the field is left empty)
//   parsePoints(text, {min, max}) -> twips, or null
//       points: a plain decimal number, alone or followed by pt
//       ('12', '6.5 pt'); clamped to min..max (default 0..LIMIT,
//       1584 points)
//   formatPoints(twips) -> '12 pt' (at most 2 decimals); '' for none
//   LIMIT   31680 twips (22 inches, 1584 points)
// Text longer than 32 characters is refused. Pure JavaScript.
import {formatNumber} from './NumberField';

export const LIMIT = 31680;
const IN = 1440, PT = 20, MAXLEN = 32;
const NUM = /^ *(-?) *(\d+(?:\.\d*)?|\.\d+) *(in|"|pt)? *$/i;

/** The limit given if it is a number, else d. */
const lim = (v, d) => (typeof v === 'number' && !Number.isNaN(v) ?
  v : d);

/** Whole twips from n units of size, clamped; null for no number. */
function twips(n, size, min, max) {
  if (!Number.isFinite(n)) n = n > 0 ? Infinity : -Infinity;
  const t = Math.min(Math.max(Math.round(n * size), min), max);
  return t === 0 ? 0 : t;
}

/** [sign, digits, unit] of text, or null. */
function split(text) {
  if (typeof text !== 'string' || text.length > MAXLEN) return null;
  const m = NUM.exec(text);
  return m ? [m[1] ? -1 : 1, m[2], (m[3] || '').toLowerCase()] : null;
}

/** See the header. */
export function parseLength(text, opts = {}) {
  const p = split(text);
  if (!p) return null;
  const [sign, digits, unit] = p;
  return twips(sign * Number(digits), unit === 'pt' ? PT : IN,
    lim(opts.min, -LIMIT), lim(opts.max, LIMIT));
}

/** See the header. */
export function parsePoints(text, opts = {}) {
  const p = split(text);
  if (!p || (p[2] && p[2] !== 'pt')) return null;
  return twips(p[0] * Number(p[1]), PT, lim(opts.min, 0),
    lim(opts.max, LIMIT));
}

/** n with at most 2 decimals; never '-0'. */
function dec(n) {
  const s = formatNumber(n, 2);
  return s === '-0' ? '0' : s;
}

/** See the header. */
export function formatLength(t) {
  if (typeof t !== 'number' || !Number.isFinite(t)) return '';
  return `${dec(t / IN)}"`;
}

/** See the header. */
export function formatPoints(t) {
  if (typeof t !== 'number' || !Number.isFinite(t)) return '';
  return `${dec(t / PT)} pt`;
}
