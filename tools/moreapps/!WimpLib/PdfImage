// PdfImage - pictures as PDF image XObjects (./PdfWrite PdfWriter).
//
//   imageObjects(writer, {width, height, rgba?, jpeg?, components?})
//       -> {id}      the XObject's object id
//       rgba: Uint8Array of 4*width*height (straight, not
//             premultiplied): a Flate 8-bit /DeviceRGB image with an
//             /SMask holding the alpha plane, left out when every
//             alpha is 255
//       jpeg: the file's bytes, embedded unchanged as /DCTDecode
//             (baseline, extended or progressive Huffman, 8 bit):
//             1, 3 or 4 components as /DeviceGray, /DeviceRGB or
//             /DeviceCMYK; width and height come from the file's own
//             start-of-frame marker (a given width or height that
//             disagrees, or a components that does, is an Error);
//             Adobe CMYK (APP14) is stored inverted so gets /Decode
//             [1 0 1 0 1 0 1 0], and an Adobe transform byte that
//             differs from the default is passed as /ColorTransform
//   jpegInfo(bytes) -> {width, height, components, adobe}|null
//       adobe: the APP14 transform byte, or -1 without the marker;
//       null for what is not a JPEG PDF can show (no SOI, no start
//       of frame before the scan, truncated, arithmetic, lossless,
//       12 bit, 0 size, other component counts)
//
// Width and height must be integers 1..16384 and an rgba array
// exactly 4*width*height long, else an Error is thrown. Pure.
import {num} from './PdfWrite';

export const MAX_SIDE = 16384;

const SPACE = {1: '/DeviceGray', 3: '/DeviceRGB', 4: '/DeviceCMYK'};

/** The marker segments of a JPEG up to its scan, or null. */
export function jpegInfo(b) {
  if (!(b instanceof Uint8Array) || b.length < 4 || b[0] !== 0xff ||
    b[1] !== 0xd8) return null;
  let i = 2, sof = null, adobe = -1;
  while (i + 1 < b.length) {
    if (b[i] !== 0xff) return null;
    while (i + 1 < b.length && b[i + 1] === 0xff) i++;  // fill bytes
    const m = b[i + 1];
    i += 2;
    if (m === 0x00 || m === 0xd9) return null;
    if (m === 0x01 || (m >= 0xd0 && m <= 0xd8)) continue;
    if (i + 2 > b.length) return null;
    const len = b[i] << 8 | b[i + 1];
    if (len < 2 || i + len > b.length) return null;     // truncated
    if (m === 0xda) break;                // the scan: no more markers
    const unsupported = m >= 0xc3 && m <= 0xcf && m !== 0xc4 &&
      m !== 0xc8 && m !== 0xcc;
    if (unsupported) return null;
    if (m >= 0xc0 && m <= 0xc2 && !sof) {
      if (len < 8 || b[i + 2] !== 8) return null;
      const height = b[i + 3] << 8 | b[i + 4];
      const width = b[i + 5] << 8 | b[i + 6];
      const components = b[i + 7];
      if (!(components in SPACE) || len < 8 + 3 * components ||
        !width || !height) return null;
      sof = {width, height, components};
    } else if (m === 0xee && len >= 14 && b[i + 2] === 0x41 &&
      b[i + 3] === 0x64 && b[i + 4] === 0x6f && b[i + 5] === 0x62 &&
      b[i + 6] === 0x65) {
      adobe = b[i + 13];
    }
    i += len;
  }
  return sof ? {...sof, adobe} : null;
}

/** True for an integer 1..MAX_SIDE. */
const sideOk = (n) => Number.isInteger(n) && n >= 1 && n <= MAX_SIDE;

/** See the header. */
export function imageObjects(writer, spec) {
  const {width, height, rgba, jpeg, components} = spec || {};
  if (jpeg) return jpegObject(writer, jpeg, width, height, components);
  if (!sideOk(width) || !sideOk(height)) {
    throw new Error('PdfImage: bad size ' + width + ' x ' + height);
  }
  if (!(rgba instanceof Uint8Array) ||
    rgba.length !== 4 * width * height) {
    throw new Error('PdfImage: rgba must be 4 * width * height bytes');
  }
  const n = width * height;
  const rgb = new Uint8Array(3 * n), alpha = new Uint8Array(n);
  let opaque = true;
  for (let i = 0, j = 0, k = 0; i < n; i++, k += 4) {
    rgb[j++] = rgba[k]; rgb[j++] = rgba[k + 1]; rgb[j++] = rgba[k + 2];
    const a = rgba[k + 3];
    alpha[i] = a;
    if (a !== 255) opaque = false;
  }
  const dict = {Type: '/XObject', Subtype: '/Image',
    Width: String(width), Height: String(height),
    ColorSpace: '/DeviceRGB', BitsPerComponent: '8'};
  if (!opaque) {
    dict.SMask = writer.stream({Type: '/XObject', Subtype: '/Image',
      Width: String(width), Height: String(height),
      ColorSpace: '/DeviceGray', BitsPerComponent: '8'}, alpha) +
      ' 0 R';
  }
  return {id: writer.stream(dict, rgb)};
}

/** The DCTDecode object for a JPEG's bytes. */
function jpegObject(writer, bytes, width, height, components) {
  const info = jpegInfo(bytes);
  if (!info) throw new Error('PdfImage: not a JPEG PDF can embed');
  if (width !== undefined && width !== info.width ||
    height !== undefined && height !== info.height) {
    throw new Error('PdfImage: size differs from the JPEG\'s');
  }
  if (components !== undefined && components !== info.components) {
    throw new Error('PdfImage: components differ from the JPEG\'s');
  }
  if (!sideOk(info.width) || !sideOk(info.height)) {
    throw new Error('PdfImage: JPEG size out of range');
  }
  const n = info.components;
  const dict = {Type: '/XObject', Subtype: '/Image',
    Width: String(info.width), Height: String(info.height),
    ColorSpace: SPACE[n], BitsPerComponent: '8',
    Filter: '/DCTDecode'};
  if (n === 4 && info.adobe >= 0) {
    dict.Decode = '[' + [1, 0, 1, 0, 1, 0, 1, 0].map(num).join(' ') +
      ']';
  }
  if (n === 4 && info.adobe === 2) {
    dict.DecodeParms = '<< /ColorTransform 1 >>';
  } else if (n === 3 && info.adobe === 0) {
    dict.DecodeParms = '<< /ColorTransform 0 >>';
  }
  return {id: writer.stream(dict, bytes, {flate: false})};
}
