// FontList - the font names a font menu or a font field offers.
//
//   WORD_FONTS          Word's common fonts: Calibri, Cambria, Arial,
//                       Times New Roman, Courier New
//   cleanFont(name)  -> the name trimmed, its spaces collapsed, with
//                       no control characters, at most 31 characters
//                       (Word's limit); null for no name
//   fontList(docFonts, desktop) -> {doc, word, desktop}: the
//                       document's fonts (in the order given), then
//                       Word's not among them, then the desktop's not
//                       among either; each name once, compared
//                       ignoring case; names that are not strings, or
//                       empty, are left out
//   allFonts(list)   -> the three lists of a fontList as one
//   findFont(list, name) -> the name in list (a fontList or an
//                       array) that is name ignoring case and spaces,
//                       or null
// Pure JavaScript.

export const WORD_FONTS = Object.freeze(['Calibri', 'Cambria', 'Arial',
  'Times New Roman', 'Courier New']);

const MAX = 31;

/** See the header. */
export function cleanFont(name) {
  if (typeof name !== 'string') return null;
  const s = name.replace(/[\u0000-\u0008\u000e-\u001f\u007f]/g, '')
    .replace(/\s+/g, ' ').trim().slice(0, MAX).trim();
  return s || null;
}

const key = (n) => n.toLowerCase();

/** names not already in seen, cleaned, added to it. */
function fresh(names, seen) {
  const out = [];
  for (const n of Array.isArray(names) ? names : []) {
    const c = cleanFont(n);
    if (!c || seen.has(key(c))) continue;
    seen.add(key(c));
    out.push(c);
  }
  return out;
}

/** See the header. */
export function fontList(docFonts, desktop) {
  const seen = new Set();
  const doc = fresh(docFonts, seen);
  const word = fresh(WORD_FONTS, seen);
  return {doc, word, desktop: fresh(desktop, seen)};
}

/** See the header. */
export function allFonts(list) {
  if (Array.isArray(list)) return list.slice();
  return [...list.doc, ...list.word, ...list.desktop];
}

/** See the header. */
export function findFont(list, name) {
  const c = cleanFont(name);
  if (!c || !list) return null;
  const k = key(c);
  for (const n of allFonts(list)) {
    if (typeof n === 'string' && key(n) === k) return n;
  }
  return null;
}
