// PaneWheel - a pane's mouse wheel goes to its parent window.
//
//   forwardWheel(pane, parent)
//     The core scrolls any window under the pointer, so a wheel
//     turned over a toolbar or ruler pane (which is wider than its
//     window) would slide the pane's own contents sideways. This
//     claims the wheel on the pane instead: the parent's 'wheel'
//     listeners are given it first (a Ctrl+wheel that zooms, say);
//     if none takes it, the parent scrolls by the same amounts the
//     core would use (Shift turns a vertical wheel sideways). The
//     pane's own scroll is kept at 0, also if it ever moves.
// Pure: no desktop services (pane and parent are core windows).

/** See the header. */
export function forwardWheel(pane, parent) {
  pane.on('wheel', (ev) => {
    const w = {dx: ev.dx, dy: ev.dy, shift: !!ev.shift};
    const r = parent.emit('wheel', w);
    if (r.handled || r.defaultPrevented) return true;
    let {dx, dy} = w;
    if (w.shift && !dx) { dx = dy; dy = 0; }
    parent.requestOpen({scrollX: parent.scrollX + dx,
      scrollY: parent.scrollY + dy, behind: 'keep'});
    return true;
  });
  pane.on('moved', () => {
    if (pane.scrollX !== 0 || pane.scrollY !== 0) pane.scrollTo(0, 0);
  });
}
