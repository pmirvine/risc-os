// CfbError - what the compound file reader (./Cfb) throws for a file
// or a stream it cannot use.
//
//   err.code   one of:
//     'not-cfb'     not an OLE compound file (no D0 CF 11 E0 A1 B1
//                   1A E1 signature)
//     'bad-header'  the header is not one this reader knows, or the
//                   directory has no root entry
//     'bad-chain'   a sector chain loops, ends before its size, or
//                   leads nowhere; the directory's links loop
//     'too-big'     the file, a stream or all the streams read
//                   together pass the limits
//     'truncated'   the file ends before a sector it needs

export class CfbError extends Error {
  /**
   * @param {string} code see above
   * @param {string} [message] defaults to the code
   */
  constructor(code, message) {
    super(message || code);
    this.name = 'CfbError';
    this.code = code;
  }
}
