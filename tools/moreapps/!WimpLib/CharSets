// CharSets - named sets of characters for a symbol picker (./Ui/
// CharGrid), as plain data: no desktop services.
//
//   SETS             the sets, in the order a popup lists them:
//                    {id, name, chars}  chars a string, one UTF-16
//                    unit per character (all are in the BMP)
//   setById(id)      a set or null (never a prototype's property)
//   setOf(ch, id?)   the set (first in SETS; id: that one first)
//                    that holds the character ch, or null
//   codeLabel(ch)    'U+00E9' (at least four hex digits, capitals)
//   statusText(ch, id?)  'U+00E9  Latin-1': the line under a grid
//
// A set holds only characters that Carlito, Liberation Sans and
// Liberation Serif have, in all four styles of each (!Word draws
// Calibri with Carlito, Arial with Liberation Sans and Times New Roman
// with Liberation Serif), proved by tests/moreapps/charsets.test.mjs
// against the fonts' cmap tables. Caladea (Cambria) and Liberation
// Mono (Courier New) are not asked: Caladea has no Greek, Cyrillic or
// geometric shapes, so a character missing there is drawn from another
// font by the browser, as Word falls back too. A character may be in
// two sets (the cent sign is in Latin-1 and Currency); none twice in
// one. The sets are written as ranges of code points [first, last]
// (both included), so the file stays plain ASCII.

const RANGES = [
  ['latin1', 'Latin-1', [[0xA1, 0xAC], [0xAE, 0xFF]]],
  ['latinA', 'Latin Extended-A', [[0x100, 0x17F]]],
  ['greek', 'Greek', [[0x386, 0x38A], [0x38C, 0x38C], [0x38E, 0x3A1],
    [0x3A3, 0x3CE]]],
  ['cyrillic', 'Cyrillic', [[0x400, 0x45F]]],
  ['punct', 'Punctuation', [[0x2012, 0x2022], [0x2026, 0x2026],
    [0x2030, 0x2030], [0x2033, 0x2034], [0x2039, 0x203A],
    [0x203C, 0x203C], [0x203E, 0x203E], [0x2044, 0x2044]]],
  ['currency', 'Currency', [[0xA2, 0xA5], [0x20A0, 0x20B5]]],
  ['letterlike', 'Letterlike and fractions', [[0xBC, 0xBE],
    [0x2105, 0x2105], [0x2113, 0x2113], [0x2116, 0x2117],
    [0x2122, 0x2122], [0x2126, 0x2126], [0x212E, 0x212E],
    [0x2153, 0x2154], [0x215B, 0x215E]]],
  ['arrows', 'Arrows', [[0x2190, 0x2195], [0x21A8, 0x21A8]]],
  ['maths', 'Maths', [[0xB1, 0xB1], [0xD7, 0xD7], [0xF7, 0xF7],
    [0x2202, 0x2202], [0x2206, 0x2206], [0x220F, 0x220F],
    [0x2211, 0x2212], [0x2215, 0x2215], [0x221A, 0x221A],
    [0x221E, 0x221F], [0x2229, 0x2229], [0x222B, 0x222B],
    [0x2248, 0x2248], [0x2260, 0x2261], [0x2264, 0x2265]]],
  ['shapes', 'Geometric shapes', [[0x25A1, 0x25A1], [0x25AA, 0x25AB],
    [0x25CA, 0x25CC], [0x25CF, 0x25CF], [0x25E6, 0x25E6]]],
];

const expand = (rs) => rs.map(([a, b]) => {
  let s = '';
  for (let c = a; c <= b; c++) s += String.fromCharCode(c);
  return s;
}).join('');

export const SETS = Object.freeze(RANGES.map(([id, name, rs]) =>
  Object.freeze({id, name, chars: expand(rs)})));

const BY_ID = new Map(SETS.map((s) => [s.id, s]));

/** See the header. */
export const setById = (id) => BY_ID.get(id) || null;

/** See the header. */
export function setOf(ch, id) {
  if (typeof ch !== 'string' || ch.length !== 1) return null;
  const first = id === undefined ? null : BY_ID.get(id);
  if (first && first.chars.includes(ch)) return first;
  return SETS.find((s) => s.chars.includes(ch)) || null;
}

/** See the header. */
export function codeLabel(ch) {
  const c = String(ch).codePointAt(0);
  return 'U+' + c.toString(16).toUpperCase().padStart(4, '0');
}

/** See the header. */
export function statusText(ch, id) {
  const s = setOf(ch, id);
  return codeLabel(ch) + (s ? '  ' + s.name : '');
}
