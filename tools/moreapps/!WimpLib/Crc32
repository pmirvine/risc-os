// Crc32 - the CRC-32 checksum used by zip files (and PNG, gzip).
//
//   crc32(bytes)          -> number, unsigned 32 bits
//   crc32(more, crc32(a)) -> the checksum of a followed by more
//
// Pure JavaScript: no browser or RISC OS APIs are used.

/** The 256-entry lookup table, built once. */
const TABLE = new Uint32Array(256);
for (let n = 0; n < 256; n++) {
  let c = n;
  for (let k = 0; k < 8; k++)
    c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1;
  TABLE[n] = c >>> 0;
}

/**
 * Checksum of a byte array.
 * @param {Uint8Array} bytes
 * @param {number} [seed=0] the checksum of the bytes before these
 * @returns {number}
 */
export function crc32(bytes, seed = 0) {
  let c = ~seed;
  for (let i = 0; i < bytes.length; i++)
    c = TABLE[(c ^ bytes[i]) & 0xFF] ^ (c >>> 8);
  return ~c >>> 0;
}
