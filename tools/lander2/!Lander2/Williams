/**
 * Every named sound: { rom, steps, pri, protect } (pri and protect only
 * for the games' own tables). Also: the tunes (phantom, toccata, fifth,
 * ninth), siren (Robotron's SIREN) and every command by name (e.g.
 * CANNON; Robotron-only ones such as ZIREN play on Robotron's board).
 */
export const SOUNDS = {};
for (const [name, [rom, pri, entries]] of Object.entries(TABLES)) {
  const { steps, protect } = fromTable(entries);
  SOUNDS[name] = { rom, steps, pri, protect };
}
for (const [i, tune] of [[1, 'phantom'], [2, 'toccata']]) {
  SOUNDS[tune] = { rom: 'defender', steps: [[0, 0x1B], [0.001, i]] };
}
for (const [i, tune] of [[1, 'fifth'], [2, 'ninth']]) {
  SOUNDS[tune] = { rom: 'robotron', steps: [[0, 0x1B], [0.001, i]] };
}
COMMANDS.robotron.forEach((name, n) => {
  if (!name || SOUNDS[name] || MISSING.has(name)) return;
  SOUNDS[name] = { rom: n <= 31 ? 'defender' : 'robotron', steps: [[0, n]] };
});
SOUNDS.siren = SOUNDS.SIREN;

// ================================================================ render

/**
 * Turn the DAC's writes into samples at `rate`: each sample is the
 * average DAC level over its time (the board's output is a staircase),
 * centred so that 128 is silence, -1..1.
 */
export function toSamples(log, rate, endCycle, start = 0x80) {
  const cps = CLOCK / rate;
  const n = Math.max(1, Math.ceil(endCycle / cps));
  const out = new Float32Array(n);
  let level = start, li = 0, t = 0;
  for (let i = 0; i < n; i++) {
    const tEnd = (i + 1) * cps;
    let acc = 0;
    while (li < log.length && log[li] < tEnd) {
      acc += (log[li] - t) * level;
      t = log[li]; level = log[li + 1]; li += 2;
    }
    acc += (tEnd - t) * level;
    t = tEnd;
    out[i] = (acc / cps - 128) / 128;
  }
  return out;
}

// The cabinet's amplifier and speaker, roughly: a high-pass at 25 Hz to
// take away the DC (the DAC's level sits around 128, not 0) and a gentle
// one-pole low-pass at 6 kHz. (render() does this unless filter: false.)
export function cabinet(a, rate) {
  const r = Math.exp(-2 * Math.PI * 25 / rate);
  const k = 1 - Math.exp(-2 * Math.PI * 6000 / rate);
  let px = a[0], hp = 0, lp = 0;
  for (let i = 0; i < a.length; i++) {
    const x = a[i];
    hp = x - px + r * hp;
    px = x;
    lp += k * (hp - lp);
    a[i] = lp;
  }
  return a;
}

function fade(a, rate, seconds) {
  const n = Math.min(a.length, Math.round(seconds * rate));
  for (let i = 0; i < n; i++) a[a.length - 1 - i] *= i / n;
  return a;
}

// Work out what to play: a name, a command number, steps or an object.
function resolve(sound, o) {
  if (typeof sound === 'string') {
    const s = SOUNDS[sound];
    if (!s) throw new Error('Williams: no sound ' + sound);
    return { ...s, rom: o.rom ?? s.rom };
  }
  if (typeof sound === 'number') return { rom: o.rom ?? 'defender', steps: [[0, sound]] };
  if (Array.isArray(sound)) return { rom: o.rom ?? 'defender', steps: sound };
  return { rom: o.rom ?? sound.rom ?? 'defender', steps: sound.steps };
}

/**
 * Play a sound on a fresh board and return it as samples (Float32Array,
 * -1..1). o: { rom, seconds, until, fade, rate, seed, filter, board } - see the
 * top of this file. board: a Board to play on (its noise and counters
 * carry on from what it played before).
 */
export function render(sound, o = {}) {
  const s = resolve(sound, o);
  const rate = o.rate ?? 48000;
  const b = o.board ?? new Board({ rom: s.rom, seed: o.seed });
  const t0 = b.t;
  const start = b.v;
  const limit = o.seconds ?? 30;
  const steps = s.steps.map(([t, ...rest]) => [t + t0 / CLOCK, ...rest]);
  let done = b.play(steps, t0 / CLOCK + limit) - t0;
  let cut = done >= Math.round(limit * CLOCK) - 1;
  if (o.until) {                        // cut where a pass, sweep or note starts
    const [what, index] = o.until;
    const at = b.marks.filter(([m, t]) => m === what && t >= t0);
    if (at[index]) { done = at[index][1] - t0; cut = true; }
  }
  // a little silence after a sound that ended by itself, so the filter
  // can settle
  const end = cut ? done : done + Math.round(0.03 * CLOCK);
  const log = b.log.map((v, i) => (i & 1 ? v : v - t0));
  const a = toSamples(log, rate, end, start);
  if (o.filter !== false) cabinet(a, rate);
  return fade(a, rate, cut ? (o.fade ?? 0.02) : 0.01);
}

/**
 * A buffer that loops without a click. With { mark: 'vari', from, to }
 * (or 'gwave') it is cut exactly from the start of one pass or sweep to
 * the start of another, for sounds that repeat themselves; otherwise it
 * is `seconds` long (after skipping `skip` seconds), its end faded into
 * its start over `crossfade` seconds (for noise).
 */
export function renderLoop(sound, o = {}) {
  const rate = o.rate ?? 48000;
  const s = resolve(sound, o);
  const b = new Board({ rom: s.rom, seed: o.seed });
  if (o.mark) {
    const need = o.to ?? 2;
    const secs = o.seconds ?? 8;
    b.play(s.steps, secs);
    const at = b.marks.filter(([m]) => m === o.mark).map(([, t]) => t);
    if (at.length <= need) throw new Error('Williams: loop marks not found');
    const a = toSamples(b.log, rate, at[need] + 1, 0x80);
    const from = Math.round(at[o.from ?? 0] / CLOCK * rate);
    const one = a.slice(from, Math.round(at[need] / CLOCK * rate));
    if (o.filter === false) return one;
    // filter two copies end to end and keep the second, so the filter
    // is already where it will be when the loop comes round
    const two = new Float32Array(one.length * 2);
    two.set(one); two.set(one, one.length);
    return cabinet(two, rate).slice(one.length);
  }
  const skip = o.skip ?? 0.1, secs = o.seconds ?? 1.5, xf = o.crossfade ?? 0.1;
  b.play(s.steps, skip + secs + xf);
  const all = toSamples(b.log, rate, Math.round((skip + secs + xf) * CLOCK), 0x80);
  if (o.filter !== false) cabinet(all, rate);
  const a = all.slice(Math.round(skip * rate));
  const f = Math.round(xf * rate), n = a.length - f;
  const out = a.slice(0, n);
  for (let i = 0; i < f; i++) {
    const x = i / f;
    out[i] = a[n + i] * Math.cos(x * Math.PI / 2) + a[i] * Math.sin(x * Math.PI / 2);
  }
  return out;
}
