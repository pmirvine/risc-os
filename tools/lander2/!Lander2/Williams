// Robotron's second table (JMPTB1: commands 44-62).
const JMPTBL = ['SP1', 'BG1', 'BG2INC', 'LITE', 'BON2', 'BGEND', 'TURBO',
  'APPEAR', 'THRUST', 'CANNON', 'RADIO', 'HYPER', 'SCREAM', 'ORGANT', 'ORGANN'];
const JMPTB1 = ['SND2', 'SND5', 'THNDR', 'HSTD', 'ATARI', 'SIREN', 'ORRRR',
  'PERKQQ', 'SQRT', 'START', 'PLANE', 'SND16', 'SND17', 'LAUNCH', 'CDR',
  'KNOCK', 'ZIREN', 'WHIST', 'HBOMB'];

/**
 * The command names of each board, by number: COMMANDS.defender[0x17] is
 * 'CANNON'. Robotron's commands 1-31 are Defender's.
 */
export const COMMANDS = { defender: [null], robotron: [null] };
{
  const base = [...SV_NAMES.slice(0, 13), ...JMPTBL, 'SAW', 'FOSHIT', 'QUASAR'];
  COMMANDS.defender.push(...base);
  COMMANDS.robotron.push(...base, ...SV_NAMES.slice(15), ...JMPTB1, 'MOSQTO');
}
// Routines on the Robotron board this file does not recreate: these
// commands are silent here.
const MISSING = new Set(['SND2', 'SND5', 'THNDR', 'SQRT', 'START', 'SND16',
  'SND17', 'CDR', 'KNOCK', 'ORGANN']);

// ================================================================ the board

/**
 * One sound board: its CPU's time (in cycles), the DAC, the random
 * number generator and the little bits of memory that carry from one
 * command to the next. Most users want render(); Board is for playing
 * with commands directly:
 *   const b = new Board({ rom: 'defender' });
 *   b.play([[0, 0x11], [0.133, 0x11], [0.267, 0x17]], 3);
 *   b.log   the writes: [cycle, value, cycle, value, ...]
 */
export class Board {
  constructor({ rom = 'defender', seed, dac = 0x80 } = {}) {
    this.rom = ROMS[rom] ? rom : 'defender';
    this.R = ROMS[this.rom];
    this.t = 0;            // CPU cycles since the start
    this.v = dac & 0xff;   // the DAC's level
    this.log = [];         // writes: cycle, value, cycle, value ...
    this.marks = [];       // [what, cycle]: where passes and sweeps start
    this.limit = Infinity; // the cycle at which the next command arrives
    // the random number generator's two bytes (after reset: $3C, 0)
    this.hi = 0x3C; this.lo = 0;
    if (seed !== undefined) {
      const s = Math.floor(Math.abs(+seed || 0) * 65521) >>> 0;
      this.hi = (s >> 8) & 0xff; this.lo = s & 0xff;
      if (!this.hi && !this.lo) this.hi = 0x3C;
    }
    // the flags and counters that live between commands
    this.sp1flg = 0; this.b2flg = 0; this.bg1flg = 0; this.bg2flg = 0;
    this.orgflg = 0; this.tempa = 0; this.tempb = 0; this.amp0 = 0xAF;
    this.gw = null;        // GWAVE's state (BON2 carries on from it)
    this.ram = { top1: 0, time: 0 };
  }

  // ---- time and the DAC
  // Spend n cycles. When the next command is due, the routine stops
  // there and then (the board resets its stack and moves on).
  c(n) { if ((this.t += n) > this.limit) { this.t = this.limit; throw STOP; } }
  // Write v to the DAC with an instruction n cycles long (STAA 5, COM
  // or CLR 6); the write lands as the instruction ends. An instruction
  // that has started is finished before the next command is taken.
  w(n, v) {
    if (this.t >= this.limit) { this.t = this.limit; throw STOP; }
    this.t += n;
    this.v = v & 0xff;
    this.log.push(this.t, this.v);
    if (this.t > this.limit) throw STOP;
  }
  out(v) { this.w(0, v); }
  mark(what) { this.marks.push([what, this.t]); }

  // ---- the random number generator: a 16-bit shift register. step()
  // is the usual "LDAA LO; LSRA x3; EORA LO; LSRA; ROR HI; ROR LO": it
  // returns the bit that falls out of LO (the carry).
  shift(bit) {
    const out = this.lo & 1;
    this.lo = ((this.hi & 1) << 7) | (this.lo >> 1);
    this.hi = (bit << 7) | (this.hi >> 1);
    return out;
  }
  step() { return this.shift(((this.lo >> 3) ^ this.lo) & 1); }

  // ADDX: add A to the index register (the cost of a table look-up)
  addx(x, a) { this.c(25 + ((x & 0xff) + a > 0xff ? 6 : 0)); return (x + a) & 0xffff; }

  /**
   * Play a sequence: steps [[seconds, command, params?], ...] in time
   * order, each cutting off the one before, until `seconds` (or until the
   * last one finishes, if sooner; at most 30 s). Returns the end cycle.
   */
  play(steps, seconds = 30) {
    const end = Math.round(seconds * CLOCK);
    let done = 0;
    for (let i = 0; i < steps.length; i++) {
      const [at, cmd, params] = steps[i];
      const next = i + 1 < steps.length ? Math.round(steps[i + 1][0] * CLOCK) : end;
      this.t = Math.max(this.t, Math.round(at * CLOCK));
      if (this.t >= end) break;
      this.limit = Math.min(next, end);
      try {
        this.send(cmd, params);
      } catch (e) {                         // cut off by the next command
        if (e !== STOP) throw e;
      }
      done = this.t;
    }
    this.limit = Infinity;
    return Math.min(done, end);
  }

  /** Send one command (a number or a name), or run one routine. */
  send(cmd, params) {
    if (typeof cmd === 'number') return this.command(cmd);
    if (typeof cmd === 'function') return cmd(this);
    const own = CUSTOM[cmd];
    if (own) { this.c(12 + 40); own(this, params ?? {}); return this.irq3(); }
    const n = COMMANDS[this.rom].indexOf(cmd);
    if (n > 0) return this.command(n);
    throw new Error('Williams: no command ' + cmd);
  }

  // ---- IRQ: a command arrives. The stack is reset, so whatever was
  // playing is simply abandoned; then the command number picks a routine.
  command(n) {
    const rb = this.rom === 'robotron';
    this.c(12 + (rb ? 38 : 16));             // interrupt, then IRQ's set-up
    if (rb) this.amp0 = 0xAF;
    let a = (n & 0xff) & this.R.mask;
    if (this.orgflg) {                        // the tune number, after ORGANT
      this.c(4);
      if (!rb && !(this.orgflg & 0x80)) { this.orgflg = 0; return this.irq3(); }
      this.c(rb ? 9 + 8 : 4 + 9);
      this.organTune(a);
      this.c(rb ? 5 + 3 : 3);
      return this.irq3();
    }
    this.c(4 + 8);                            // BEQ IRQ00; CLRB; CMPA; BEQ
    if (a !== 0x0E) { this.c(4); this.sp1flg = 0; }
    this.c(6);
    if (a !== 0x12) { this.c(4); this.b2flg = 0; }
    if (!rb) this.c(10);                      // no speech ROM fitted
    this.c(6);                                // TSTA; BEQ
    if (!a) return this.irq3();
    a--;
    this.c(2);
    // which routine: a GWAVE vector, a special routine or a VARI vector
    // (the compares and subtracts cost `pre` cycles)
    let gw = -1, jump = -1, vari = -1, pre = 0;
    if (!rb || a < 0x1F) {
      pre = rb ? 12 : 6;                      // (CMPA #$1F; BLT) CMPA #$C; BHI
      if (a <= 0x0C) gw = a;
      else {
        pre += 8;                             // CMPA #$1B; BHI; SUBA
        if (a <= 0x1B) jump = a - 0x0D; else vari = a - 0x1C;
      }
    } else {
      pre = 12;                               // CMPA #$1F; BLT; CMPA #$3D; BGT
      if (a > 0x3D) { vari = a - 0x39; pre += 6; } else {
        pre += 12;                            // CMPA #$2A; BHI; SUBA; BRA
        if (a > 0x2A) jump = a - 0x1C; else gw = a - 0x10;
      }
    }
    this.c(pre);
    if (gw >= 0) {
      this.c(9); this.gwld(gw); this.c(9); this.gwave(); this.c(4);
    } else if (jump >= 0) {
      this.c(2 + 3 + 8);                      // ASLA; LDX #JMPTBL; BSR ADDX
      this.addx(this.R.jmptbl, 2 * jump);
      this.c(6 + 8);                          // LDX 0,X; JSR 0,X
      const name = jump < 15 ? JMPTBL[jump] : JMPTB1[jump - 15];
      this.special(name);
      this.c(4);                              // BRA IRQ3
    } else {
      this.c(9); this.varild(vari); this.c(9); this.vari();
    }
    return this.irq3();
  }

  // IRQ3: the sound has finished. If a background sound is on (BG1, the
  // rumble, or BG2, the turbine) it starts again; otherwise the board
  // waits, the DAC holding its last level.
  irq3() {
    this.c(10);
    if (!this.bg1flg && !this.bg2flg) return;
    this.c(13 + 3); this.b2flg = 0;
    if (this.bg1flg) this.BG1(); else this.bg2();
  }

  special(name) {
    if (MISSING.has(name)) { this.c(5); return; }
    this[name]();
  }

  // ============================================================ GWAVE

  // GWLD: load sound vector i (a number, or a vector of 7 bytes): copy
  // its wave to RAM, pre-decay it and find its stretch of GFRTAB.
  gwld(i) {
    const R = this.R;
    const v = typeof i === 'number' ? SVTAB[SV_NAMES[i]] : i;
    const k = typeof i === 'number' ? i : 0;
    this.c(10 + 3 + 9); let x = this.addx(R.svtab, 7 * k);
    this.c(25 + 33);
    const w = v[1] & 15;
    let wx = R.gwvtab;
    for (let j = 0; j < w; j++) {            // GWLD2: step through the waves
      this.c(10 + 5 + 2 + 9); wx = this.addx(wx, WAVES[j].length + 1); this.c(4);
    }
    this.c(10);
    const wave = WAVES[w];
    const g = this.gw = {
      echo: v[0] >> 4, ccnt: v[0] & 15, ecdec: v[1] >> 4, wave,
      ram: wave.slice(), predec: v[2], dfinc: v[3], dcnt: v[4],
      start: v[6], end: v[6] + v[5], fofs: 0,
    };
    this.c(5 + 9); this.wvtran();
    this.c(4 + 5 + 4 + 9); this.wvdeca(g.predec);
    this.c(4 + 5 + 4 + 5 + 4 + 5 + 2 + 5 + 3 + 9);
    x = this.addx(R.gfrtab, v[6]);
    this.c(2 + 5 + 6 + 9); this.addx(x, v[5]);
    this.c(5 + 5);
  }

  // WVTRAN: copy the wave from ROM to RAM (43 cycles a byte)
  wvtran() {
    const g = this.gw;
    g.ram = g.wave.slice();
    this.c(57 + 43 * g.ram.length);
  }

  // WVDECA: take k/16 of the ROM wave off every byte in RAM, wrapping
  // round at 0 (no clamping: that is where the grit comes from)
  wvdeca(k) {
    const g = this.gw;
    if (!k) { this.c(11); return; }
    for (let i = 0; i < g.ram.length; i++) {
      g.ram[i] = (g.ram[i] - k * (g.wave[i] >> 4)) & 0xff;
    }
    this.tempb = k;
    this.c(27 + g.ram.length * (65 + 12 * k));
  }

  // GWAVE: play every pitch of the stretch, `ccnt` cycles of the wave at
  // each; decay the wave after each pass; repeat for each echo; then step
  // the pitch offset (GEND50) and go round again while it still fits.
  gwave() {
    const g = this.gw;
    for (;;) {
      this.mark('gwave');
      this.c(7);                                 // LDAA GECHO; STAA GECNT
      for (let e = 0; e < n256(g.echo); e++) {
        this.c(9);                               // GWT4
        for (let p = g.start; p < g.end; p++) {
          const per = n256(GFRTAB[p] + g.fofs);
          this.c(36);                            // GPLAY: the next period
          const cc = n256(g.ccnt), L = g.ram.length;
          for (let cyc = 0; cyc < cc; cyc++) {
            this.c(3);                           // GOUT: LDX #GWTAB
            for (let i = 0; i < L; i++) {
              this.c(3 + 6 * per + 5);           // wait for the period
              this.w(5, g.ram[i]);
              this.c(12);
            }
            this.c(6);                           // DECB; BEQ GPLAY
            if (cyc < cc - 1) this.c(40);        // (padding to 36 + 4)
          }
        }
        this.c(24 + 3 + 8);                      // GPLAY at the end; GEND
        this.wvdeca(g.ecdec);
        this.c(10);                              // GEND40: DEC GECNT; BNE
      }
      this.c(7);                                 // LDAA B2FLG; BNE GEND1
      if (this.b2flg) { this.c(5); return; }     // BON2 plays one pass
      if (!this.gend50()) return;
    }
  }

  // GEND50: step the pitch offset; false when the sound is over
  gend50() {
    const g = this.gw;
    this.c(7);                                   // LDAA GDFINC; BEQ
    if (!g.dfinc) { this.c(5); return false; }
    this.c(10);                                  // DEC GDCNT; BEQ
    g.dcnt = (g.dcnt - 1) & 0xff;
    if (!g.dcnt) { this.c(5); return false; }
    this.c(3);                                   // ADDA FOFSET
    return this.gend60((g.fofs + g.dfinc) & 0xff);
  }

  // GEND60 / GEND61: keep the first unbroken run of pattern entries whose
  // period + offset doesn't overflow; if there are none, the sound ends.
  gend60(fofs) {
    this.gw.fofs = fofs;
    this.c(4);
    return this.gend61();
  }

  gend61() {
    const g = this.gw, dec = !!(g.dfinc & 0x80);
    let found = false;
    this.c(6);                                   // LDX GWFRQ; CLRB
    for (let p = g.start; p < g.end; p++) {
      const sum = GFRTAB[p] + g.fofs;
      let ok;
      if (!dec) { ok = sum <= 0xff; this.c(ok ? 26 : 22); } else if (!(sum & 0xff)) {
        ok = false; this.c(22);
      } else { ok = sum > 0xff; this.c(26); }
      if (ok) {
        this.c(6);
        if (!found) { this.c(7); found = true; g.start = p; }
      } else {
        this.c(6);
        if (found) { this.c(4); g.end = p; return this.gw3(); }
      }
      this.c(12);                                // INX; CPX FRQEND; BNE GW0
    }
    this.c(6);                                   // TSTB; BNE GW3
    if (!found) { this.c(5); return false; }
    return this.gw3();
  }

  // GW3: the new stretch is set; reload the wave if echoes decayed it
  gw3() {
    const g = this.gw;
    this.c(5 + 3 + 4);
    if (g.ecdec) {
      this.c(8); this.wvtran();
      this.c(3 + 8); this.wvdeca(g.predec);
    }
    this.c(3);                                   // JMP GWAVE
    return true;
  }

  // ============================================================ VARI

  // VARILD: copy vector i (a number, or 9 bytes) into VARI's parameters
  varild(i) {
    const v = typeof i === 'number' ? VVECT[VV_NAMES[i]] : i;
    const k = typeof i === 'number' ? i : 0;
    this.c(2 + 6 + 2 + 3 + 5 + 3 + 9);
    this.addx(this.R.vvect, 9 * k);
    this.c(2 + 3 + 4 + 43 * 9 + 4 + 5);        // LDAB #9; JMP TRANS
    this.vv = v.slice();
  }

  // VARI: a square wave. Each half is timed by its own count (14 cycles a
  // step); every SWPDT steps the counts change by LODT and HIDT (the
  // sweep), until the high count reaches HIEN. Then, if LOMOD isn't 0,
  // the low count moves on by LOMOD and it all starts again.
  vari() {
    const v = this.vv;
    const hiper = v[1], lodt = v[2], hidt = v[3], hien = v[4];
    const swpdt = (v[5] << 8) | v[6], lomod = v[7];
    let s = v[8];
    this.c(3); this.w(5, s);                   // LDAA VAMP; STAA SOUND
    for (;;) {                                 // VAR0
      this.mark('vari');
      let lo = v[0], hi = hiper;
      this.c(14);
      for (;;) {                               // V0: one sweep step
        let x = swpdt || 65536;
        // one half of the square: count n down, 14 cycles a count, while
        // the sweep's own count X runs down too; true if X ran out first
        const half = (n) => {
          for (let a = n256(n); ;) {
            this.c(8);                         // DEX; BEQ VSWEEP
            if (--x === 0) return true;
            this.c(6);                         // DECA; BNE
            if (--a === 0) return false;
          }
        };
        this.c(4);
        for (;;) {                             // V0LP
          this.c(3); s ^= 0xff; this.w(6, s);
          if (half(lo)) break;
          s ^= 0xff; this.w(6, s); this.c(3);
          if (half(hi)) break;
          this.c(4);
        }
        // VSWEEP: leave the output at its high level, step the counts
        this.c(8); if (!(s & 0x80)) { s ^= 0xff; this.c(2); }
        this.c(2); this.w(5, s);
        lo = (lo + lodt) & 0xff; hi = (hi + hidt) & 0xff;
        this.c(27);
        if (hi === hien) break;
      }
      this.c(7);
      if (!lomod) { this.c(5); return; }
      v[0] = (v[0] + lomod) & 0xff;
      this.c(11);
      if (!v[0]) { this.c(5); return; }
    }
  }

  // SP1, the spinner: every time it is sent again (with nothing else in
  // between) its count goes up, the low half gets shorter and the whirr
  // higher. It spins until the next command.
  SP1() {
    this.c(2 + 9); this.varild(3);
    this.c(3 + 2 + 4);
    let b = this.sp1flg;
    if (b === 31) { b = 0; this.c(2); }
    this.sp1flg = ++b;
    this.c(2 + 4 + 2 + 2 + 2);
    let a = 32 - b, lo = 0;
    for (;;) { this.c(6); if (a <= 20) break; lo += 14; a--; this.c(8); }
    do { lo += 5; a--; this.c(8); } while (a);
    this.vv[0] = lo & 0xff;
    this.c(4);
    for (;;) { this.c(9); this.vari(); this.vv[0] = lo & 0xff; this.c(4); }
  }

  // ============================================================ LITEN

  // LITEN: flip the DAC between two levels whenever the random generator
  // throws out a 1, waiting a delay between tries; after every `cycnt`
  // tries the delay changes by `dfreq`, until it wraps round to 0.
  liten(lfreq, dfreq, cycnt) {
    let s = 0xff;
    this.c(4 + 2); this.w(5, s);             // STAA LFREQ; LDAA #$FF; STAA
    this.c(4);
    do {
      this.c(3);                              // LITE0: LDAB CYCNT
      for (let b = 0; b < n256(cycnt); b++) {
        this.c(30);
        if (this.step()) { s ^= 0xff; this.w(6, s); }
        this.c(3 + 6 * n256(lfreq) + 6);
      }
      lfreq = (lfreq + dfreq) & 0xff;
      this.c(14);
    } while (lfreq);
    this.c(5);
  }

  LITE() { this.c(12); this.liten(1, 1, 3); }           // lightning
  APPEAR() { this.c(14); this.liten(0xC0, 0xFE, 16); }  // appear
  LAUNCH() { this.c(14); this.liten(0x60, 0xFF, 0xFF); } // Robotron

  // ============================================================ NOISE

  // NOISE: random bits at level `amp`, `cycnt` bits at a time; after
  // each batch the level falls by `decay` and (if nfflg) the time per bit
  // grows by 8 cycles. TURBO is Defender's laser.
  noise(decay, period, amp, cycnt, nfflg) {
    this.c(4 + 5 + 4 + 3);
    for (;;) {
      for (let b = 0; b < n256(cycnt); b++) {
        this.c(32);
        const v = this.step() ? amp : 0;
        if (v) this.c(3);
        this.w(5, v);
        this.c(4 + 8 * (period || 65536) + 6);
      }
      amp = (amp - decay) & 0xff;
      this.c(10);
      if (!amp) { this.c(5); return; }
      this.c(15);
      if (nfflg) { period = (period + 1) & 0xffff; this.c(16); } else this.c(7);
    }
  }

  TURBO() { this.c(21); this.noise(1, 1, 0xff, 0x20, 0x20); }

  // ============================================================ FNOISE

  // FNOISE: the level slews towards a random target, `fmax` (plus
  // flo/256) per 30-cycle step, and a new target is picked when it gets
  // there. With dsflg the slope is also randomised (fmax AND a random
  // byte, plus lofrq). With fdflg the slope shrinks by 1/8 every `sampc`
  // steps, and the sound ends when it has all but gone.
  fnoise({ fmax, sampc, fdflg = 0, dsflg = 0, lofrq = 0 }) {
    const rb = this.rom === 'robotron';
    let flo = 0;
    this.c(19);
    let x = sampc & 0xffff, a = this.v;      // FNOIS0: LDX SAMPC; LDAA SOUND
    this.c(8);
    for (;;) {
      // FNOIS1: the next random target
      this.shift(((a >> 3) ^ this.lo) & 1);
      let fhi = fmax;
      this.c(38);
      if (dsflg) {                            // ANDB HI (Robotron: ADDB LOFRQ)
        fhi = ((fhi & this.hi) + (rb ? lofrq : 0)) & 0xff;
        this.c(rb ? 6 : 3);
      }
      let b = flo;
      const target = this.lo;
      this.c(14);
      let ended = false;
      if (a > target) {
        for (;;) {                            // FNOIS4: slope down
          x = (x - 1) & 0xffff; this.c(8); if (!x) { ended = true; break; }
          this.w(5, a);
          const nb = b - flo, borrow = nb < 0 ? 1 : 0; b = nb & 0xff;
          const na = a - fhi - borrow; a = na & 0xff;
          this.c(10);
          if (na < 0) break;
          this.c(7); if (!(a > target)) break;
        }
      } else {
        for (;;) {                            // FNOIS3: slope up
          x = (x - 1) & 0xffff; this.c(8); if (!x) { ended = true; break; }
          this.w(5, a);
          const nb = b + flo, carry = nb > 0xff ? 1 : 0; b = nb & 0xff;
          const na = a + fhi + carry; a = na & 0xff;
          this.c(10);
          if (na > 0xff) break;
          this.c(7); if (a > target) { this.c(4); break; }
        }
      }
      if (!ended) {                           // FNOIS5: land on the target
        a = target; this.c(3); this.w(5, a); this.c(4);
        continue;
      }
      this.c(7);                              // FNOIS6
      if (!fdflg) continue;
      let v = (fmax << 8) | flo;
      v = (v - (v >> 3)) & 0xffff;
      fmax = v >> 8; flo = v & 0xff;
      this.c(42);
      if (!fmax) { this.c(6); if (flo === 7) { this.c(5); return; } }
      x = sampc & 0xffff; a = this.v;
      this.c(8);
    }
  }

  // Defender's: BG1 (the background rumble, which sets the flag that
  // brings it back after every sound), THRUST and CANNON (the explosion).
  // On Defender the sample count of the first two is whatever the index
  // register held (the routine's own address): it only matters for when
  // the slope would decay, which it doesn't.
  BG1() {
    this.bg1flg = 1;
    if (this.rom === 'robotron') this.c(13 + 34); else this.c(16);
    return this.fnoise({ fmax: 1, sampc: this.rom === 'robotron' ? 0 : 0xF913 });
  }
  THRUST() {
    if (this.rom === 'robotron') this.c(7 + 34); else this.c(12);
    return this.fnoise({ fmax: 3, sampc: this.rom === 'robotron' ? 0 : 0xF91C });
  }
  CANNON() {
    const rb = this.rom === 'robotron';
    this.c(rb ? 7 + 34 : 17);
    this.fnoise({ fmax: 0xff, sampc: 1000, fdflg: 1, dsflg: 1 });
  }
  HBOMB() {                                   // Robotron: the aftershock
    this.c(3 + 34);
    this.fnoise({ fmax: 0x40, sampc: 0x1000, fdflg: 1, dsflg: 1, lofrq: 1 });
  }

  // ============================================================ background

  BGEND() { this.c(2 + 4 + 4 + 5); this.bg1flg = 0; this.bg2flg = 0; }
  BG2INC() {
    this.bg1flg = 0;
    this.c(6 + 3 + 2 + 2 + 4);
    let a = this.bg2flg & 0x7f;
    if (a === 29) { a = 0; this.c(2); }
    this.bg2flg = a + 1;
    this.c(2 + 4 + 5);
  }
  // BG2, the turbine: TRBV with its pitch offset set from the BG2INC
  // count, played over and over.
  bg2() {
    this.c(2 + 9); this.gwld(14);
    this.c(3 + 2 + 2 + 2 + 9);
    if (this.gend60((~(this.bg2flg * 4)) & 0xff)) this.gwave();
    this.bg2loop();
  }
  bg2loop() {
    for (;;) {
      this.gw.dcnt = (this.gw.dcnt + 1) & 0xff;
      this.c(6 + 9);
      if (this.gend61()) this.gwave();
      this.c(4);
    }
  }

  // BON2: the first time, play BONV once; each time it is sent again,
  // step its pitch up one and play it once more (a rising warble).
  BON2() {
    this.c(7);
    if (!this.b2flg) {
      this.b2flg = 1;
      this.c(6 + 2 + 8); this.gwld(13);
      this.c(4); this.gwave();
      return;
    }
    this.c(3);
    if (this.gw && this.gend50()) this.gwave();
  }

  // ============================================================ others

  // RADIO: a 16-step wave through a phase accumulator whose step grows
  // by one every time the accumulator wraps: a sweep that rises faster
  // and faster (about an octave every 3 seconds at first).
  RADIO() {
    let freq = 100, acc = (this.tempa << 8) | 0;
    this.c(14);
    for (;;) {
      const s = acc + freq;
      acc = s & 0xffff;
      this.c(51);
      if (s > 0xffff) { freq = (freq + 1) & 0xffff; if (!freq) { this.c(5); return; } }
      this.tempa = acc >> 8;
      this.w(5, RADSND[(acc >> 8) & 15]);
      this.c(4);
    }
  }

  // HYPER: a 57 Hz pulse whose width sweeps from nothing to all.
  HYPER() {
    let s = 0;
    this.c(2); this.w(5, s); this.c(4 + 2);
    for (let phase = 0; phase < 128; phase++) {
      for (let a = 0; a < 128; a++) {
        this.c(7);
        if (a === phase) { s ^= 0xff; this.w(6, s); }
        this.c(2 + 6 * 18 + 6);
      }
      s ^= 0xff; this.w(6, s);
      this.c(10);
      if (phase < 127) this.c(2);
    }
    this.c(5);
  }

  // SCREAM: four square-wave voices at levels 128, 64, 32 and 16, added
  // together; every 256 samples each voice's pitch falls a step, and each
  // starts when the one before has fallen to $37: a falling whistle with
  // echoes.
  SCREAM() {
    const f = [0x40, 0, 0, 0], tm = [0, 0, 0, 0];
    this.c(3 + 8 * 18 + 6);
    for (;;) {
      do {
        this.c(11);
        let amp = 0x80, b = 0;
        for (let v = 0; v < 4; v++) {
          tm[v] = (tm[v] + f[v]) & 0xff;
          this.c(20);
          if (tm[v] & 0x80) { b = (b + amp) & 0xff; this.c(3); }
          amp >>= 1;
          this.c(21);
        }
        this.w(5, b);
        this.tempb = (this.tempb + 1) & 0xff;
        this.c(10);
      } while (this.tempb);
      let any = false;
      this.c(5);
      for (let v = 0; v < 4; v++) {
        this.c(9);
        if (f[v]) {
          this.c(6);
          if (f[v] === 0x37 && v < 3) { f[v + 1] = 0x41; this.c(8); }
          f[v]--; any = true;
          this.c(9);
        }
        this.c(15);
      }
      this.c(6);
      if (!any) { this.c(5); return; }
    }
  }

  // ORGANT: the next command is a tune number
  ORGANT() { this.c(6 + 5); this.orgflg = 0xff; }
  ORGANN() { this.c(5); }

  // A tune: each note is a loop that counts up a byte and writes how many
  // of its bits (picked by the note's mask) are set, times 16 (32 on
  // Robotron): square waves an octave apart, added up like organ stops.
  // A few NOPs copied into RAM stretch the loop, which sets the pitch.
  organTune(n) {
    const R = this.R, rb = this.rom === 'robotron';
    this.orgflg = 0;
    this.c(6 + 4 + 3);
    const names = R.tunes;
    let x = R.orgtab;
    for (let i = 1; i < n; i++) {             // ORGNT2: skip earlier tunes
      if (i > names.length) { this.c(9); return; }
      this.c(5 + 4 + 6 + 4 + 2 + 9);
      x = this.addx(x, TUNES[names[i - 1]].length * 4 + 1);
      this.c(4);
    }
    if (!n || n > names.length) { this.c(9); return; }
    this.c(19 + 4 + 5 + 9);
    this.addx(x + 1, TUNES[names[n - 1]].length * 4);
    this.c(5 + 4);
    for (const [mask, delay, dur] of TUNES[names[n - 1]]) {
      this.c(33);                             // ORGNT4 .. BSR ORGANL
      this.mark('note');
      // ORGANL: build the delay (NOPs, maybe a 3-cycle CMPA) in RAM
      let nops = 0, cmpa = false, a = delay;
      if (!rb) {
        this.c(3);
        for (;;) {
          if (a === 0) { this.c(6); break; }
          if (a === 3) { this.c(12 + 23); cmpa = true; break; }
          nops++; a = (a - 2) & 0xff; this.c(30);
        }
      } else {
        this.c(3 + 2);
        let borrow = a < 2;
        a = (a - 2) & 0xff;
        for (;;) {
          if (borrow || a === 0) { this.c(4); break; }
          if (a === 3) { this.c(10 + 23); cmpa = true; break; }
          nops++; borrow = a < 2; a = (a - 2) & 0xff; this.c(28);
        }
      }
      this.c(24 + 4);                          // LD1: JMP ORGAN1; LDX DUR
      const wait = 2 * nops + (cmpa ? 3 : 0);
      const body = rb ? 60 : 58, sh = R.shift;
      let loops = dur || 65536;
      for (;;) {                               // ORGAN1
        this.tempb = (this.tempb + 1) & 0xff;
        let bits = this.tempb & mask, sum = 0;
        while (bits) { sum += bits & 1; bits >>= 1; }
        this.c(body - 5); this.w(5, sum << sh);
        this.c(8);                             // DEX; BEQ ORGAN2
        if (--loops === 0) { this.c(5); break; }
        this.c(3 + wait + 3);                  // JMP RDELAY ... JMP ORGAN1
      }
      this.c(33);                              // next note
    }
  }

  // ============================================================ Robotron

  // SING: a square wave whose half-period (6 cycles a count) steps by
  // DQFRQ every CQFRQ cycles until it reaches EQFRQ; its level can step
  // too (every CQAMP cycles, by DQAMP) until it goes negative.
  sing(vec) {
    let [freqq, cqfrq, dqfrq, eqfrq, cqamp, dqamp] = vec;
    this.c(9 + 54 + 5 + 9);                    // JSR MOVE ... JSR SING
    let a = this.amp0, cqampq = cqamp, cqfrqq = cqfrq;
    this.c(21);
    a ^= 0xff; this.c(5); this.w(5, a);         // SING1
    let b = freqq;
    for (;;) {
      this.c(6 * n256(b));                     // SING2
      a ^= 0xff; b = freqq; this.c(25); this.w(5, a);
      this.c(6 * n256(b));                     // SING3
      cqfrqq = (cqfrqq - 1) & 0xff; this.c(10);
      if (!cqfrqq) {                           // SING4: next period
        a ^= 0xff; this.c(15); this.w(5, a);
        cqfrqq = cqfrq; b = (freqq - dqfrq) & 0xff;
        this.c(20);
        if (b === eqfrq) { this.c(9); return; }
        freqq = b; b = (b - 5) & 0xff; this.c(10);
        continue;
      }
      cqampq = (cqampq - 1) & 0xff; this.c(10);
      if (cqampq) { a ^= 0xff; b = freqq; this.c(5); this.w(5, a); continue; }
      a ^= 0xff; this.c(5); this.w(5, a);       // next level
      cqampq = cqamp; b = freqq; a = (a + dqamp) & 0xff;
      this.c(14);
      if (a & 0x80) { this.c(9); return; }
      this.c(6);
      freqq = b; b = (b - 5) & 0xff; this.c(10);
    }
  }
  perk1(name) { this.sing(SINGV[name]); this.c(5); }
  // the "echo" callers: play it again 8 levels quieter until the level
  // byte turns positive
  perkq(name) {
    for (;;) {
      this.c(8); this.perk1(name);
      this.c(8 + 3 + 2 + 4);
      const a = (this.amp0 - 8) & 0xff;
      if (!(a & 0x80)) { this.c(4 + 4 + 5); return; }
      this.amp0 = a; this.c(4 + 5 + 4);
    }
  }
  ATARI() { this.c(3 + 4); this.perk1('VEC02X'); }
  ORRRR() { this.c(3 + 4); this.perk1('VEC05X'); }
  HSTD() { this.amp0 = 0xff; this.c(2 + 4 + 3 + 4); this.perkq('VEC08X'); }
  PERKQQ() { this.amp0 = 0xff; this.c(2 + 4 + 3 + 4); this.perkq('VEC06X'); }
  // SIREN: SING falling then rising, 255 times over ("wee-woo")
  SIREN() {
    this.amp0 = 0xff; this.c(2 + 4);
    for (let b = 255; b > 0; b--) {
      this.mark('siren');
      this.c(3 + 8); this.perk1('VEC03X');
      this.c(3 + 8); this.perk1('VEC04X');
      this.c(2 + 4);
    }
    this.c(5);
  }

  // ZIREN, the air-raid siren: a flat-topped triangle (8 steps up, a
  // wait, 8 steps down, a wait) whose wait shrinks, then slowly grows.
  ZIREN() {
    let top = 0xff00 | this.ram.top1, sweep = 0xFEC0;
    this.c(2 + 4 + 3 + 5 + 2 + 3 + 8);
    const zirt = () => {
      const b = n256(top >> 8);
      this.c(3 + b * 20 + 5);
    };
    const part = (slope, end2) => {
      this.c(4 + 5);
      do {
        this.c(3);
        for (let x = 16; x > 0; x--) {
          this.c(8 + 2);                      // BSR ZIRLOP; CLRA
          for (let a = 0; a < 0x100; a += 0x20) { this.w(5, a); this.c(6); }
          this.c(8); zirt();
          this.c(2);
          for (let a = 0xE0; a >= 0; a -= 0x20) { this.w(5, a); this.c(6); }
          zirt();
          top = (top + sweep) & 0xffff;
          this.ram.top1 = top & 0xff;
          this.c(28);
        }
        const lo = (sweep & 0xff) + slope;
        this.c(14);
        if (lo > 0xff) { sweep = (sweep + 0x100) & 0xffff; this.c(6); }
        sweep = (sweep & 0xff00) | (lo & 0xff);
        this.c(12);
      } while (sweep !== end2);
      this.c(5);
    };
    part(0x20, 0xFFE0);
    this.c(2 + 3);
    part(0x01, 0x0044);
  }

  // WHIST, the falling bomb: steps through the top half of a sine table
  // at a rate that falls every 128 samples.
  WHIST() {
    let freqz = 0x80;
    this.c(2 + 4 + 2 + 4);
    do {
      this.c(2 + 4);
      for (let n = 0; n < 128; n++) {
        this.c(2 + 18 * 6);
        this.ram.time = (this.ram.time + freqz) & 0xff;
        this.c(31); this.w(5, SINTBL[this.ram.time >> 3]);
        this.c(10);
      }
      freqz = (freqz - 1) & 0xff;
      this.c(15);
    } while (freqz !== 0x20);
    this.c(5);
  }

  // PLANE, the diving plane: a pulse whose low half grows for ever.
  PLANE() {
    let x1 = 1;
    this.c(3 + 5 + 3 + 5);
    for (;;) {
      this.w(6, 0);
      x1 = (x1 + 1) & 0xffff;
      this.c(4 + 4 + 5 + 8 * (x1 || 65536));
      this.w(6, 0xff);
      this.c(4 + 8 * 0x380 + 4);
    }
  }
}

// Routines with parameters of our own (for sounds the arcade didn't
// have): [seconds, name, params] in a sequence.
const CUSTOM = {
  fnoise: (b, p) => b.fnoise(p),
  liten: (b, p) => b.liten(p.lfreq, p.dfreq, p.cycnt),
  noise: (b, p) => b.noise(p.decay ?? 1, p.period ?? 1, p.amp ?? 0xff,
    p.cycnt ?? 0x20, p.nfflg ?? 1),
  gwave: (b, p) => {
    b.gwld(SVTAB[p.vector] ?? p.vector);
    if (p.fofs) b.gw.fofs = p.fofs & 0xff;
    b.gwave();
  },
  vari: (b, p) => {
    b.varild(VVECT[p.vector] ?? p.vector);
    if (p.loper) b.vv[0] = p.loper;
    b.vari();
  },
  sing: (b, p) => { b.amp0 = p.amp ?? 0xAF; b.sing(SINGV[p.vector] ?? p.vector); },
};

// ================================================================ sequences

/**
 * A main-CPU sound table, as Defender and Robotron list them: entries
 * [repeats, ticks, command] - send the command `repeats` times, `ticks`
 * frames (60ths of a second) apart. Returns { steps, protect }: the
 * steps for render() and how long the table lasts (the time for which
 * the game let nothing of lower priority cut in).
 */
export function fromTable(entries) {
  const steps = [];
  let t = 0;
  for (const [rep, ticks, cmd] of entries) {
    for (let r = 0; r < rep; r++) { steps.push([t, cmd]); t += ticks * TICK; }
  }
  return { steps, protect: t };
}

// The named sounds: the games' own sound tables (priority, entries) and
// a few single commands. pri is the priority byte the main CPU gave it.
const TABLES = {
  // Defender (defa7.src)
  coin: ['defender', 0xFF, [[1, 0x18, 0x19]]],
  freeShip: ['defender', 0xFF, [[1, 0x20, 0x1E]]],
  playerDeath: ['defender', 0xF0, [[2, 8, 0x11], [1, 0x20, 0x17]]],
  start1: ['defender', 0xF0, [[1, 0x40, 0x0A]]],
  start2: ['defender', 0xF0, [[1, 0x10, 0x0B]]],
  terrainBlow: ['defender', 0xE8, [[1, 4, 0x14], [2, 6, 0x11], [2, 0x0A, 0x17]]],
  smartBomb: ['defender', 0xE8, [[6, 4, 0x11], [1, 0x10, 0x17]]],
  astroCatch: ['defender', 0xE0, [[3, 0x0A, 0x08]]],
  astroLand: ['defender', 0xE0, [[1, 0x18, 0x1F]]],
  astroHit: ['defender', 0xE0, [[1, 0x18, 0x11]]],
  astroScream: ['defender', 0xD8, [[1, 0x10, 0x1A]]],
  appear: ['defender', 0xD0, [[1, 0x30, 0x15]]],
  probeHit: ['defender', 0xD0, [[1, 0x10, 0x05]]],
  schitzHit: ['defender', 0xD0, [[1, 8, 0x17]]],
  ufoHit: ['defender', 0xD0, [[1, 8, 0x07]]],
  tieHit: ['defender', 0xD0, [[1, 0x0A, 0x01]]],
