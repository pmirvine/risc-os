// Lander II - Maths: small helpers shared by every other module.
//
// Units used throughout the game: one TILE is 1.0, so a position like
// (4.5, 3.3, 4.5) is four and a half tiles east, 3.3 tiles down and four
// and a half tiles north. As in the original Lander, y points DOWN: a
// bigger y is lower, and the sea is at y = 5.3125.
//
// The world is a torus: x and z wrap round every terrain.period tiles.
// Positions are kept in [0, period); use wrapDelta() for differences.

export const TAU = Math.PI * 2;

/** v wrapped into [0, p). */
export function wrap(v, p) {
  v %= p;
  return v < 0 ? v + p : v;
}

/** The shortest signed difference d wrapped into [-p/2, p/2). */
export function wrapDelta(d, p) {
  d = wrap(d + p / 2, p);
  return d - p / 2;
}

export const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);
export const lerp = (a, b, t) => a + (b - a) * t;

/**
 * A small, fast, seedable random number generator (xorshift32), so a
 * landscape or a demo game can be played again exactly.
 */
export class Rng {
  constructor(seed = 0x4F9C3490) { this.s = (seed | 0) || 1; }
  /** A random unsigned 32-bit integer. */
  next() {
    let s = this.s;
    s ^= s << 13; s ^= s >>> 17; s ^= s << 5;
    this.s = s | 0;
    return s >>> 0;
  }
  /** A random number in [0, 1). */
  float() { return this.next() / 4294967296; }
  /** A random number in [a, b). */
  range(a, b) { return a + (b - a) * this.float(); }
  /** A random integer in [0, n). */
  int(n) { return Math.floor(this.float() * n); }
  /** A random number in [-1, 1). */
  signed() { return this.float() * 2 - 1; }
  /** true with probability p. */
  chance(p) { return this.float() < p; }
}

/**
 * The ship's orientation from its pitch a and direction b (radians), as
 * in the original's CalculateRotationMatrix: three unit vectors,
 *   nose - where the nose points (bullets go this way)
 *   roof - out of the floor, i.e. DOWN when level (y is down), so the
 *          engines push along -roof
 *   side - out of the right-hand side
 */
export function orientation(a, b) {
  const ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b);
  return {
    nose: [ca * cb, sa, -ca * sb],
    roof: [-sa * cb, ca, sa * sb],
    side: [sb, 0, cb],
  };
}

export const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
export const len3 = (x, y, z) => Math.sqrt(x * x + y * y + z * z);
