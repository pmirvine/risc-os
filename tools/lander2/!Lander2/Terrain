// Lander II - Terrain: the height of the land.
//
// altitude(x, z) gives the height of the ground (y, down is positive) at
// any point, in tiles. Two kinds of landscape:
//
//  'lander'   - exactly the original's: six sine waves added together,
//               repeating every 256 tiles (see lander.bbcelite.com,
//               "Generating the landscape"):
//                 y = 5 - [sin(x-2z) + sin(4x+3z) + sin(3z-5x)
//                          + sin(7x+5z) + (sin(5x+11z) + sin(10x+7z))/2]
//               where sin(t) means sin(2 pi t / 256).
//  'invasion' - the same idea with waves that repeat every 64 tiles, so
//               the whole world fits on the scanner. There are several
//               landscapes (number 0, 1, 2 ...); later ones are hillier
//               with more sea.
//
// Anything below the sea is flattened to sea level, and the 8 x 8 tiles
// from (0, 0) to (8, 8) are the flat launch pad.
//
// raw(x, z) gives the same height as a 32-bit integer (1 tile = 2^24),
// like the original's; the renderer uses two of its low bits to speckle
// the land with green and brown, as Lander does.

import { TAU, wrap, wrapDelta } from './Maths';

export const TILE = 16777216;              // 2^24: one tile in raw units
export const SEA_LEVEL = 5.3125;           // 0x05500000
export const PAD_ALTITUDE = 3.3125;        // 0x03500000
export const PAD_SIZE = 8;                 // tiles
export const UNDERCARRIAGE = 0.390625;     // 0x00640000: ship centre to feet

// Invasion landscapes: [kx, kz, amplitude, phase] waves, a sea level
// and a name. The sums of amplitudes are about the original's 5 tiles.
const LANDSCAPES = [
  { name: 'Green Hills', sea: 5.3125, waves: [
    [1, 1, 1, 0.3], [1, -1, 1, 1.9], [2, 1, 1, 4.1], [-1, 2, 1, 2.6],
    [3, 1, 0.5, 0.7], [1, 3, 0.5, 5.2]] },
  { name: 'Archipelago', sea: 5.0, waves: [
    [1, 2, 1.1, 1.1], [2, -1, 1.1, 3.3], [3, 2, 1, 0.2], [-2, 3, 1, 4.4],
    [4, 1, 0.6, 2.2], [1, 5, 0.6, 5.9]] },
  { name: 'Highlands', sea: 5.6, waves: [
    [1, 0, 1.3, 2.0], [0, 1, 1.3, 0.6], [2, 2, 1.2, 3.7], [-2, 3, 1.1, 1.4],
    [5, 1, 0.6, 4.8], [1, -4, 0.6, 0.1]] },
];

export class Terrain {
  /**
   * kind: 'lander' or 'invasion'; landscape: which invasion landscape
   * (it wraps round the list).
   */
  constructor(kind = 'lander', landscape = 0) {
    this.kind = kind;
    if (kind === 'lander') {
      this.period = 256;
      this.seaLevel = SEA_LEVEL;
      this.name = 'Lander';
    } else {
      const l = LANDSCAPES[landscape % LANDSCAPES.length];
      this.period = 64;
      this.seaLevel = l.sea;
      this.name = l.name;
      // later passes round the list are hillier still
      const k = 1 + 0.15 * Math.floor(landscape / LANDSCAPES.length);
      this.waves = l.waves.map(([kx, kz, a, ph]) =>
        [kx * TAU / 64, kz * TAU / 64, a * k, ph]);
    }
  }

  static get landscapeCount() { return LANDSCAPES.length; }

  /** Height of the ground at (x, z) in tiles (y is down). */
  altitude(x, z) {
    return this.raw(x, z) / TILE;
  }

  /** Height of the ground as a 32-bit integer (1 tile = 2^24). */
  raw(x, z) {
    x = wrap(x, this.period);
    z = wrap(z, this.period);
    if (x < PAD_SIZE && z < PAD_SIZE) return PAD_ALTITUDE * TILE;
    let y;
    if (this.kind === 'lander') {
      const s = (t) => Math.sin(t * TAU / 256);
      y = 5 - (s(x - 2 * z) + s(4 * x + 3 * z) + s(3 * z - 5 * x)
        + s(7 * x + 5 * z) + (s(5 * x + 11 * z) + s(10 * x + 7 * z)) / 2);
    } else {
      let sum = 0;
      for (const [kx, kz, a, ph] of this.waves) sum += a * Math.sin(kx * x + kz * z + ph);
      y = 5 - sum;
    }
    if (y > this.seaLevel) y = this.seaLevel;
    return Math.round(y * TILE) | 0;
  }

  /** Is (x, z) on the launch pad? */
  isPad(x, z) {
    return wrap(x, this.period) < PAD_SIZE && wrap(z, this.period) < PAD_SIZE;
  }

  /** Is the ground at (x, z) sea? */
  isSea(x, z) {
    return this.altitude(x, z) >= this.seaLevel;
  }

  /** Is the whole tile whose front-left corner is (tx, tz) sea? */
  tileIsSea(tx, tz) {
    return this.isSea(tx, tz) && this.isSea(tx + 1, tz) &&
      this.isSea(tx, tz + 1) && this.isSea(tx + 1, tz + 1);
  }

  /** v wrapped into the world. */
  wrap(v) { return wrap(v, this.period); }

  /** The shortest difference b - a across the wrapping world. */
  delta(a, b) { return wrapDelta(b - a, this.period); }

  /** Index into per-tile maps (period x period) of the tile at (x, z). */
  index(x, z) {
    const p = this.period;
    return Math.floor(wrap(z, p)) * p + Math.floor(wrap(x, p));
  }
}
