// Undo - remembers what has been done so it can be undone and
// redone. Each change is a command object:
//
//   undo.do({ name: 'Delete', do() { ... }, undo() { ... } })
//   undo.undo(); undo.redo();
//   undo.canUndo, undo.canRedo, undo.undoName   ('Delete' ...)
//   undo.clear();  undo.on('change', ...)       (for shading menus)
import { Emitter } from './Emitter';

export class Undo extends Emitter {
  constructor(limit = 50) {
    super();
    this.limit = limit;              // how many changes to remember
    this.done = [];                  // changes that can be undone
    this.undone = [];                // changes that can be redone
  }

  /** Make a change (cmd.do()) and remember it. */
  do(cmd) {
    cmd.do();
    this.done.push(cmd);
    if (this.done.length > this.limit) this.done.shift();
    this.undone = [];                // a new change: no redoing
    this.emit('change');
  }

  undo() {
    const cmd = this.done.pop();
    if (!cmd) return false;
    cmd.undo();
    this.undone.push(cmd);
    this.emit('change');
    return true;
  }

  redo() {
    const cmd = this.undone.pop();
    if (!cmd) return false;
    cmd.do();
    this.done.push(cmd);
    this.emit('change');
    return true;
  }

  clear() {
    this.done = [];
    this.undone = [];
    this.emit('change');
  }

  get canUndo() { return this.done.length > 0; }
  get canRedo() { return this.undone.length > 0; }
  get undoName() { return this.done.at(-1)?.name ?? ''; }
  get redoName() { return this.undone.at(-1)?.name ?? ''; }
}
