// MainWindow - the window showing an address book: its toolbar, the
// list of contacts, its menu, and what keys and drags do.
import { wimp, Menu, saveAs, dragSave, query } from 'riscos';
import { ListView } from './Toolkit/ListView';
import { Toolbar } from './Toolkit/Toolbar';
import { vcardWrite, csvWrite, encode } from './Toolkit/Formats';
import { nameOf, phoneOf, SORTS } from './Model';
import { editCard } from './Card';
import { importFiles, importData } from './Import';

export class MainWindow {
  constructor(doc) {
    this.doc = doc;
    this.app = doc.app;
    this.search = '';
    const n = this.app.docs.size % 6;
    const w = this.win = this.app.task.createWindow({
      title: doc.title, x: 120 + 24 * n, y: 70 + 24 * n,
      w: 600, h: 380, extent: { w: 600, h: 380 },
      colours: { workBg: 0 }, workButton: 'clickdragdouble',
      flags: { back: true, close: true, title: true, toggle: true,
        vscroll: true, size: true, moveable: true },
    });
    this.bar = new Toolbar(w, {
      area: this.app.area,
      buttons: [
        { name: 'new', sprite: 'tb_new', action: () => this.add() },
        { name: 'edit', sprite: 'tb_edit',
          action: () => this.edit() },
        { name: 'delete', sprite: 'tb_delete',
          action: () => this.remove() },
        { gap: true },
        { name: 'save', sprite: 'tb_save',
          action: () => this.doc.quickSave() },
      ],
      search: {
        change: (text) => { this.search = text; this.refresh(); },
      },
      menu: (ev) => this.openMenu(ev),
    });
    this.list = new ListView(w, {
      top: this.bar.height, key: (c) => c.id,
      columns: [
        { title: 'Name', width: 190, text: nameOf },
        { title: 'Phone', width: 130, text: phoneOf },
        { title: 'Email', width: 190, text: (c) => c.email },
        { title: 'Category', width: 90, text: (c) => c.category },
      ],
    });
    this.list.on('open', (c) => this.edit(c));
    this.list.on('menu', ({ ev }) => this.openMenu(ev));
    this.list.on('drag', (ev) => this.dragOut(ev));
    this.list.on('select', () => this.shade());
    this.off = doc.book.on('change', () => this.refresh());
    w.on('key', (ev) => this.key(ev));
    w.on('close', (ev) => { ev.preventDefault(); this.doc.close(); });
    w.on('dataload', (ev) => {        // files dropped on the window
      importFiles(doc, ev.files);
      return true;
    });
    w.on('datasave', async (ev) => {       // another program's data
      importData(doc, await ev.receive());
      return true;
    });
    w.open({ behind: 'top' });
    this.refresh();
  }

  // ------------------------------------------------ showing the book
  refresh() {
    const sort = this.app.prefs.sort;
    const search = this.search;
    this.list.setItems(this.doc.book.list({ search, sort }));
    this.shade();
  }
  updateTitle() { this.win.setTitle(this.doc.title); }
  /** Grey out the tools that can't be used just now. */
  shade() {
    const n = this.list.selected().length;
    this.bar.shade('edit', n !== 1);
    this.bar.shade('delete', n === 0);
  }
  dispose() {
    this.off();
    this.win.delete();
  }

  // ------------------------------------------------ changes
  /** Give the window the keyboard again (after a dialogue box). */
  focus() { if (this.win.isOpen) wimp.setCaret(this.win); }

  async add() {
    const v = await editCard(this.app.task, {}, 'New contact');
    this.focus();
    if (!v) return;
    const c = this.doc.book.add(v);
    this.list.select(c);
    this.list.ensureVisible(c);
  }
  async edit(c = this.list.selected()[0]) {
    if (!c) return;
    const v = await editCard(this.app.task, c, nameOf(c));
    this.focus();
    if (!v) return;
    this.doc.book.update(c.id, v);
  }
  async remove() {
    const gone = this.list.selected();
    if (!gone.length) return;
    const what = gone.length === 1 ? nameOf(gone[0])
      : `these ${gone.length} contacts`;
    const r = await query({ task: this.app.task, title: 'Contacts',
      message: `Delete ${what}?`, buttons: ['Delete', 'Cancel'] });
    this.focus();
    if (r !== 'Delete') return;
    for (const c of gone) this.doc.book.remove(c.id);
  }

  // ------------------------------------------------ other programs
  /** The contacts to export: the chosen ones, or all of them. */
  chosen() {
    const sel = this.list.selected();
    return sel.length ? sel : this.list.items;
  }
  exportBox(kind) {
    const vcard = kind === 'vcard';
    return saveAs({
      task: this.app.task, filetype: vcard ? 0xFFF : 0xDFE,
      filename: vcard ? 'Cards/vcf' : 'Contacts/csv',
      getData: async () => encode(vcard ? vcardWrite(this.chosen())
        : csvWrite(this.chosen())),
    });
  }
  dragOut(ev) {
    const sel = this.list.selected();
    const leaf = sel.length === 1
      ? nameOf(sel[0]).replace(/[^A-Za-z0-9]+/g, '_') : 'Cards';
    dragSave(ev, { task: this.app.task, leafname: leaf + '/vcf',
      filetype: 0xFFF,
      getData: async () => encode(vcardWrite(sel)) });
  }

  // ------------------------------------------------ keys and menus
  key(ev) {
    switch (ev.code) {
      case 0x183: this.doc.quickSave(); return true;          // F3
      case 0x184:                                             // F4
        wimp.setCaret(this.bar.pane, this.bar.search);
        return true;
      case 0x186: this.nextSort(); return true;               // F6
      case 1: this.list.selectAll(); return true;         // Ctrl-A
      case 26: this.list.clear(); return true;            // Ctrl-Z
      case 127: case 8: this.remove(); return true;       // Delete
      case 0x1CD: this.add(); return true;                // Insert
      default: return undefined;
    }
  }
  setSort(s) { this.app.prefs.sort = s; this.app.refreshAll(); }
  nextSort() {
    const keys = Object.keys(SORTS);
    const i = keys.indexOf(this.app.prefs.sort);
    this.setSort(keys[(i + 1) % keys.length]);
  }
  openMenu(ev) {
    wimp.menus.openAt(this.menu(), ev, { task: this.app.task,
      onClose: () => this.list.endTemporary() });
  }
  menu() {
    const doc = this.doc, none = () => !this.list.selected().length;
    return new Menu('Contacts', [
      { text: 'File', submenu: new Menu('File', [
        { text: 'Save', key: 'F3', submenu: () => doc.saveBox(),
          action: () => doc.quickSave() },
        { text: 'Export', submenu: new Menu('Export', [
          { text: 'vCard', submenu: () => this.exportBox('vcard') },
          { text: 'CSV', submenu: () => this.exportBox('csv') },
        ]) },
      ]) },
      { text: 'Edit', submenu: new Menu('Edit', [
        { text: 'New contact', key: 'Insert',
          action: () => this.add() },
        { text: 'Change', shaded: () => this.list.selected()
          .length !== 1, action: () => this.edit() },
        { text: 'Delete', key: 'Delete', shaded: none,
          action: () => this.remove(), dotted: true },
        { text: 'Select all', key: '^A',
          action: () => this.list.selectAll() },
        { text: 'Clear selection', key: '^Z', shaded: none,
          action: () => this.list.clear() },
      ]) },
      { text: 'Sort', submenu: new Menu('Sort', Object.entries(SORTS)
        .map(([k, name]) => ({ text: name,
          ticked: () => this.app.prefs.sort === k,
          action: () => this.setSort(k) }))) },
      { text: 'Find', key: 'F4',
        action: () => this.key({ code: 0x184 }) },
    ]);
  }
}
