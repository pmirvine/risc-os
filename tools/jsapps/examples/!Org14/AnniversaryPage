// AnniversaryPage - birthdays and other anniversaries, a box for each
// month: January to June on the left page, July to December on the
// right, with how many years it will be (58th) this year. They also
// show in the diary on their days. Click an anniversary's day to see
// it in the diary; double-click one to change it.
import { Section, heading, text, inside, INK, FAINT, RULE }
  from './Paper';
import { nth } from './Store';
import { editAnniversary, showDay } from './Entries';
import * as D from './Toolkit/Dates';

const LINE = 16;

export class AnniversaryPage extends Section {
  constructor(org) {
    super(org, { id: 'anniversary', name: 'Anniversary',
      colour: '#e377c2', newHelp: 'add a birthday or anniversary' });
    this.year = +D.today().slice(0, 4);
    this.dayLinks = [];               // the day numbers: to the diary
  }
  state() { return { year: this.year }; }

  draw(g, L, R) {
    heading(g, L, 'Anniversary', this.colour, String(this.year));
    heading(g, R, 'Anniversary', this.colour, String(this.year));
    this.dayLinks = [];
    [[L, 1], [R, 7]].forEach(([p, m0]) => {
      const bw = (p.w - 30) / 2, bh = (p.h - 56) / 3;
      for (let i = 0; i < 6; i++) {
        const x = p.x + 10 + (i % 2) * (bw + 10);
        const y = p.y + 46 + Math.floor(i / 2) * bh;
        this.month(g, m0 + i, x, y, bw, bh - 8);
      }
    });
  }
  month(g, m, x, y, w, h) {
    g.strokeStyle = RULE;
    g.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
    g.fillStyle = this.colour;
    g.fillRect(x, y, w, 18);
    const first = `${this.year}-${String(m).padStart(2, '0')}-01`;
    text(g, D.format(first, '%MO'), x + 6, y + 9, w - 12,
      'bold 12px Homerton', '#ffffff');
    let ly = y + 22;
    for (const a of this.doc.anniversaries.inMonth(m)) {
      if (ly + LINE > y + h) {                   // no more room
        text(g, '...', x + w - 18, ly, 14);
        break;
      }
      const day = +a.date.slice(8), n = nth(a, this.year);
      text(g, String(day), x + 6, ly + LINE / 2, 20,
        'bold 12px Homerton', '#1c4f8a');
      this.dayLinks.push({ x: x + 4, y: ly, w: 20, h: LINE,
        date: `${this.year}-${a.date.slice(5)}` });
      text(g, a.text + (n ? ` (${n})` : ''), x + 28, ly + LINE / 2,
        w - 34, '12px Homerton', INK);
      this.box(x + 26, ly, w - 30, LINE, { id: a.id });
      ly += LINE;
    }
    if (ly === y + 22) {
      text(g, '-', x + 8, ly + LINE / 2, 20, '12px Homerton', FAINT);
    }
  }

  click(ev) {
    const d = this.dayLinks.find((b) => inside(b, ev.x, ev.y));
    if (d) { this.org.go({ section: 'diary', date: d.date }); }
    return true;
  }
  async double(ev) {
    const box = this.at(ev.x, ev.y);
    if (!box) return;
    const a = this.doc.anniversaries.get(box.ref.id);
    const v = await editAnniversary(this.org.app.task, a);
    this.org.focus();
    if (v) this.doc.anniversaries.update(a.id, v);
  }
  async newEntry() {
    const v = await editAnniversary(this.org.app.task, {});
    this.org.focus();
    if (v) this.doc.anniversaries.add(v);
  }
  turn(dir) { this.year += dir; }
  today() { this.year = +D.today().slice(0, 4); }
  describe(ref) {
    const a = this.doc.anniversaries.get(ref.id);
    return a ? `${showDay(a.date)} ${a.text}` : 'Anniversary';
  }
  remove(ref) { this.doc.anniversaries.remove(ref.id); }
  go() { this.year = +D.today().slice(0, 4); }
}
