// Contacts - an address book for RISC OS.
// !RunImage is where it starts: it makes an address book (the Book
// in ./Model), fills it with the contacts in ./Sample, and opens a
// window showing them (./MainWindow).
import { Book } from './Model';
import { CONTACTS } from './Sample';
import { MainWindow } from './MainWindow';

export default function start(task) {
  const book = new Book();
  for (const c of CONTACTS) book.add(c);
  new MainWindow(task, book);
}
