// Contacts - an address book for RISC OS.
// !RunImage is where it starts: it makes an address book (the Book
// in ./Model), fills it with the contacts in ./Sample, and opens a
// window showing them (./MainWindow). The toolbar's pictures come
// from the program's own sprite file, Sprites.
import { vfs, sprites } from 'riscos';
import { Book } from './Model';
import { CONTACTS } from './Sample';
import { MainWindow } from './MainWindow';

export default async function start(task, ctx) {
  const app = {
    task,
    prefs: { sort: 'last' },         // the order of the list
    area: sprites.spritesFromFile(await vfs.readFile(ctx.dir +
      '.Sprites')),                  // the toolbar's pictures
  };
  const book = new Book();
  for (const c of CONTACTS) book.add(c);
  new MainWindow(app, book);
}
