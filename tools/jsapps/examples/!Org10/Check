// Check - tests the parts of the Organiser that don't need windows:
// a Collection, which keeps every section's entries. Double-click it:
// it prints ok or FAIL for each test, and 'all ok' if they all pass.
import { print } from 'riscos';
import { Collection } from './Store';

let failed = 0;
function check(what, got, want) {
  const ok = JSON.stringify(got) === JSON.stringify(want);
  if (!ok) failed++;
  print(`${ok ? 'ok  ' : 'FAIL'} ${what}`);
  if (!ok) print(`     got ${JSON.stringify(got)}`);
}

export default function start() {
  const c = new Collection([{ id: 4, text: 'kept' }]);
  let told = 0;
  c.on('change', () => told++);
  const x = c.add({ text: 'new' });
  check('a new entry gets the next id', x.id, 5);
  c.update(4, { done: true });
  check('update keeps the other fields', c.get(4),
    { id: 4, text: 'kept', done: true });
  c.remove(5);
  check('removed', [c.size, c.get(5)], [1, undefined]);
  check('listeners told of each change', told, 3);
  check('saved as a list', JSON.stringify(c), '[{"id":4,' +
    '"text":"kept","done":true}]');
  print(failed ? `${failed} FAILED` : 'all ok');
}
