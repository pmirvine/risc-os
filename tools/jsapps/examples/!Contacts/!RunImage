// Contacts - an address book for RISC OS.
// !RunImage is where it starts: the icon on the icon bar and its
// menu, opening address book files, and quitting. Each open book is a
// Document (./Document) with a window (./MainWindow).
import { wimp, vfs, sprites, Menu, infoBox, discardChanges,
  reportError } from 'riscos';
import { Document } from './Document';
import { loadChoices, openChoices } from './Choices';
import { importFiles } from './Import';

const TYPE = 0x1C4;          // Contacts files (!Boot names the type)

export default async function start(task, ctx) {
  const file = ctx.argv[0];
  // only one Contacts at a time: pass the file to the one running
  const other = wimp.tasks.find((t) => t !== task && t.alive &&
    t.name === task.name);
  if (other) {
    if (file) {
      wimp.sendMessage('DataOpen', { path: file, filetype: TYPE },
        { to: other });
    }
    task.quit();
    return;
  }

  const app = {
    task, TYPE,
    docs: new Set(),                 // the open address books
    prefs: await loadChoices(),
    area: sprites.spritesFromFile(await vfs.readFile(ctx.dir +
      '.Sprites')),                  // the toolbar's pictures
    /** Open a file (or bring its window to the front). */
    async open(path) {
      const name = vfs.canonical(path);
      const open = [...app.docs].find((d) => d.filename === name);
      if (open) {
        open.view.win.open({ behind: 'top' });
        return open;
      }
      try {
        return await Document.load(app, name);
      } catch (e) {
        reportError(`Can't load ${vfs.leaf(name)}: ${e.message}`);
        return null;
      }
    },
    refreshAll() { for (const d of app.docs) d.view.refresh(); },
    get modified() { return [...app.docs].some((d) => d.modified); },
  };

  // ------------------------------------------------ the icon bar
  const info = infoBox(task, { name: 'Contacts',
    purpose: 'Address book', author: 'You',
    version: '1.00 (25-Sep-26)' });
  const quit = async () => {
    if (app.modified && !(await discardChanges(task,
      'Some address books have changes. Quit anyway?'))) return;
    task.quit();
  };
  const menu = () => new Menu('Contacts', [
    { text: 'Info', submenu: info },
    { text: 'Choices...', help: 'Change how Contacts behaves.',
      action: () => openChoices(task, app.prefs,
        () => app.refreshAll()) },
    { text: 'Quit', action: quit, help: 'Stop Contacts.' },
  ]);
  task.addIconbarIcon({
    sprite: '!contacts', menu,
    help: 'This is Contacts, an address book.|MClick SELECT for a ' +
      'new address book. Drag vCard or CSV files here to add them.',
    onClick: () => new Document(app),
    onDataLoad: async (ev) => {
      for (const f of ev.files) {
        if (f.filetype === TYPE) await app.open(f.path);
        else await importFiles(new Document(app), [f]);
      }
    },
  });

  // ------------------------------------------------ messages
  // a Contacts file double-clicked while we're running
  task.onMessage('DataOpen', (msg) => {
    if (msg.filetype !== TYPE) return false;
    app.open(msg.path);
    return true;
  });
  // the desktop is shutting down: ask about unsaved changes
  task.onMessage('PreQuit', async (msg) => {
    if (!app.modified) return;
    msg.object?.();                  // "wait": stop the shutdown
    if (await discardChanges(task,
      'Some address books have changes. Discard them?')) {
      task.quit();
      if (!msg.single) wimp.emit('hotkey:CtrlShiftF12', {});
    }
  });
  task.onMessage('Quit', () => task.quit());

  if (file) await app.open(file);
}
