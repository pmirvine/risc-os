// Card - the dialogue box for one contact's details.
//
//   const values = await editCard(task, contact, 'New contact');
//   (null if Cancel was chosen)
import { Form } from './Toolkit/Form';
import { CATEGORIES } from './Model';

let form = null;                       // made the first time

function makeForm(task) {
  return new Form(task, {
    title: 'Contact',
    help: 'Type the contact\'s details and click Save.',
    fields: [
      { name: 'title', label: 'Title', width: 80 },
      { name: 'first', label: 'First name' },
      { name: 'last', label: 'Surname' },
      { name: 'company', label: 'Company' },
      { name: 'job', label: 'Job title' },
      { name: 'address', label: 'Address', lines: 4 },
      { name: 'postcode', label: 'Postcode', width: 110 },
      { column: 2 },
      { name: 'work', label: 'Work phone', allowed: '0-9 +()-' },
      { name: 'home', label: 'Home phone', allowed: '0-9 +()-' },
      { name: 'mobile', label: 'Mobile', allowed: '0-9 +()-' },
      { name: 'email', label: 'Email' },
      { name: 'web', label: 'Web' },
      { name: 'birthday', label: 'Birthday', width: 120,
        help: 'The birthday as 25/12/1990 (or 1990-12-25).' },
      { name: 'category', label: 'Category', width: 140,
        choices: CATEGORIES },
      { name: 'notes', label: 'Notes', lines: 3 },
    ],
    buttons: ['Cancel', 'Save'],
    check,
  });
}

/** Is everything filled in properly? null, or what's wrong. */
function check(v) {
  if (!v.first && !v.last && !v.company) {
    return { field: 'first', message: 'Please give a name' };
  }
  if (v.email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.email)) {
    return { field: 'email', message: 'That email address is wrong' };
  }
  if (v.birthday && !dateKey(v.birthday)) {
    return { field: 'birthday',
      message: 'Give the birthday as 25/12/1990' };
  }
  return null;
}

/** '25/12/1990' or '1990-12-25' as '1990-12-25' (or null). */
export function dateKey(s) {
  let m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
  const [y, mo, d] = m ? [m[3], m[2], m[1]]
    : (m = /^(\d{4})-(\d\d)-(\d\d)$/.exec(s)) ? [m[1], m[2], m[3]]
    : [];
  if (!y) return null;
  const date = new Date(+y, mo - 1, +d);
  if (date.getMonth() !== mo - 1) return null;       // 31/02 ...
  return `${y}-${String(mo).padStart(2, '0')}-${String(d)
    .padStart(2, '0')}`;
}

export async function editCard(task, contact = {}, title) {
  form ??= makeForm(task);
  form.win.setTitle(title ?? 'Contact');
  const v = await form.ask(contact);
  if (v?.birthday) v.birthday = dateKey(v.birthday);
  return v;
}
