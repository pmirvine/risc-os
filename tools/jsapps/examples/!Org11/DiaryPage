// DiaryPage - the diary: appointments, shown a week across the two
// pages (or a day, a month or the year: the view buttons).
import { Section } from './Paper';
import * as V from './DiaryViews';
import * as D from './Toolkit/Dates';

export class DiaryPage extends Section {
  constructor(org) {
    super(org, { id: 'diary', name: 'Diary', colour: '#6fa8dc',
      views: ['Week', 'Day', 'Month', 'Year'],
      newHelp: 'add an appointment' });
    this.day = D.today();                  // the day we're looking at
    this.days = [];                        // where each day is drawn
  }

  draw(g, L, R) {
    this.days = [];
    V[this.view.toLowerCase()](this, g, L, R);
  }
  /** Remember where a day is drawn (for clicks and drops). */
  dayBox(key, x, y, w, h) { this.days.push({ key, x, y, w, h }); }
  dayAt(x, y) {
    return this.days.find((d) => x >= d.x && x < d.x + d.w &&
      y >= d.y && y < d.y + d.h)?.key ?? null;
  }

  /** Everything to show on a day: its appointments, as
   * { kind, text, ref, time }. */
  itemsOn(key) {
    const doc = this.doc;
    return [
      ...doc.diary.occurrences(key, key).map(({ appt }) => ({
        kind: 'appt', time: appt.time, text: appt.text,
        ref: { id: appt.id, date: key } })),
    ];
  }

  // ------------------------------------------------ the mouse
  click(ev) {
    const day = this.dayAt(ev.x, ev.y);
    if (!day) return false;
    if (this.view === 'Month' || this.view === 'Year') {
      this.day = day;                        // a date: see its week
      this.setView('Week');
      this.org.refresh();
    } else this.day = day;
    return true;
  }
  go(ref) {
    const a = this.doc.diary.get(ref.id);
    this.day = ref.date ?? a?.date ?? this.day;
    if (this.view !== 'Day') this.view = 'Week';
  }

  // ------------------------------------------------ turning pages
  turn(dir) {
    const d = this.day;
    this.day = this.view === 'Week' ? D.addDays(d, 7 * dir)
      : this.view === 'Day' ? D.addDays(d, 2 * dir)
      : this.view === 'Month' ? D.addMonths(d, 2 * dir)
      : D.addYears(d, dir);
  }
  today() { this.day = D.today(); }
  key(ev) {                         // the arrow keys move a day/week
    const step = { 0x18C: -1, 0x18D: 1,             // left, right
      0x18F: -7, 0x18E: 7 }[ev.code];               // up, down
    if (!step || this.view !== 'Week') return false;
    this.day = D.addDays(this.day, step);
    this.org.refresh();
    return true;
  }
}
