// !Pacman - Player: Pac-Man's movement, one pixel at a time.
//
// (px, py) is his centre pixel in the maze; (tx, ty) the tile holding
// it. He keeps going in dir until a wall stops him at a tile centre,
// turns to the wanted direction at a tile centre when it is open, and
// may reverse at any moment. A dot is eaten on entering its tile;
// eating makes him pause (1 frame for a dot, 3 for an energizer).
// anim counts pixels moved, for the mouth. Row 14 wraps at px 224.

import { DX, DY } from './Dirs';
import { steps } from './Mover';

export class Player {
  constructor(start) {
    this.start = start;
    this.reset();
  }

  /** Back to the starting place, facing the starting way. */
  reset() {
    const s = this.start;
    this.px = s.px;
    this.py = s.py;
    this.dir = s.dir;
    this.acc = 0;
    this.tx = s.px >> 3;
    this.ty = s.py >> 3;
    this.pause = 0;
    this.anim = 0;
    this.stopped = false;
  }

  /** One frame at pct percent speed, wanting direction want (-1: no
   *  change). Returns {moved, ate}: pixels moved, points eaten. */
  tick(maze, want, pct) {
    if (this.pause > 0) { this.pause--; return { moved: 0, ate: 0 }; }
    let moved = 0, ate = 0;
    const n = steps(this, pct);
    for (let i = 0; i < n; i++) {
      if (want >= 0 && want === (this.dir ^ 2)) this.dir = want;
      if ((this.px & 7) === 4 && (this.py & 7) === 4) {
        const open = (d) => maze.walkable(
          this.tx + DX[d], this.ty + DY[d], 'pac');
        if (want >= 0 && want !== this.dir && open(want)) {
          this.dir = want;
        }
        if (!open(this.dir)) { this.stopped = true; break; }
      }
      this.stopped = false;
      this.px = (this.px + DX[this.dir] + 224) % 224;
      this.py += DY[this.dir];
      this.anim++;
      moved++;
      const tx = this.px >> 3, ty = this.py >> 3;
      if (tx !== this.tx || ty !== this.ty) {
        this.tx = tx;
        this.ty = ty;
        const v = maze.eat(tx, ty);
        if (v) { ate += v; this.pause = v === 50 ? 3 : 1; }
      }
    }
    return { moved, ate };
  }
}
