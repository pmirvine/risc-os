// !Pacman - Targets: where a ghost goes at a junction.
//
// A ghost never turns back on itself. At a tile it takes, of the
// exits left, the one whose next tile is nearest (straight line,
// squared) to its target tile; ties go to up, then left, down, right.
// Tiles are [x, y] pairs. Pinky and Inky, aiming ahead of a Pac-Man
// who faces up, also aim left by the same amount (the 1980 bug).

import { DX, DY, UP, LEFT, DOWN, RIGHT } from './Dirs';
import { BLINKY, PINKY, INKY } from './Dirs';

/** The direction to take at tile (arrived at going dir) towards
 *  target. redZones true forbids turning up in the maze's red zones
 *  (chasing and scattering ghosts only). */
export function chooseExit(maze, tile, dir, target, redZones) {
  const [x, y] = tile;
  const noUp = redZones && maze.isRedZone(x, y);
  let best = dir ^ 2, bestD = Infinity;
  for (let d = 0; d < 4; d++) {
    if (d === (dir ^ 2) || (d === UP && noUp)) continue;
    const nx = x + DX[d], ny = y + DY[d];
    if (!maze.walkable(nx, ny, 'ghost')) continue;
    const dist = (nx - target[0]) ** 2 + (ny - target[1]) ** 2;
    if (dist < bestD) { bestD = dist; best = d; }
  }
  return best;
}

// Tiles ahead of Pac-Man: the bug adds the same again to the left.
function ahead(pac, n) {
  const x = pac.tx + DX[pac.dir] * n, y = pac.ty + DY[pac.dir] * n;
  return [pac.dir === UP ? x - n : x, y];
}

/** The tile ghost id steers for when chasing. pac {tx, ty, dir},
 *  blinky and self {tx, ty}, scatter this ghost's corner. */
export function chaseTarget(id, pac, blinky, scatter, self) {
  if (id === BLINKY) return [pac.tx, pac.ty];
  if (id === PINKY) return ahead(pac, 4);
  if (id === INKY) {
    const [ax, ay] = ahead(pac, 2);
    return [2 * ax - blinky.tx, 2 * ay - blinky.ty];
  }
  const dx = self.tx - pac.tx, dy = self.ty - pac.ty;
  return dx * dx + dy * dy < 64 ? scatter : [pac.tx, pac.ty];
}

/** A frightened ghost's turn: a random direction, or if that is a
 *  wall or the way back, the first open one in up, left, down, right.
 *  Always draws one number from rng. */
export function frightExit(maze, tile, dir, rng) {
  const open = (d) => d !== (dir ^ 2) &&
    maze.walkable(tile[0] + DX[d], tile[1] + DY[d], 'ghost');
  const d = rng.int(4);
  if (open(d)) return d;
  for (const e of [UP, LEFT, DOWN, RIGHT]) if (open(e)) return e;
  return dir ^ 2;
}
