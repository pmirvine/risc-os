// !Pacman - Fruit: the bonus fruit that appears twice a level.
//
// onDots(eaten) is called with the number of dots (and energizers)
// Pac-Man has eaten so far this level. At 70 and again at 170 the
// fruit of the level appears (kind, points) and stays for
// 540 + rng.int(60) frames: tick() counts them down once a play
// frame. eat() takes it, answering its points (0 if it is not
// there); clear() removes it, as when Pac-Man is caught. It never
// appears a third time.

import { levelSpec } from './Levels';

const AT = [70, 170];

export class Fruit {
  constructor(level, rng) {
    const s = levelSpec(level);
    this.rng = rng;
    this.kind = s.fruit;
    this.points = s.fruitPoints;
    this.shown = false;
    this.timer = 0;
    this.seen = 0;                 // how many of AT have come up
  }

  /** The dots eaten so far: show the fruit at 70 and at 170. */
  onDots(eaten) {
    if (this.seen < AT.length && eaten === AT[this.seen]) {
      this.seen++;
      this.shown = true;
      this.timer = 540 + this.rng.int(60);
    }
  }

  /** One play frame. */
  tick() {
    if (this.shown && --this.timer <= 0) this.shown = false;
  }

  /** Pac-Man takes it: its points, and it goes. */
  eat() {
    if (!this.shown) return 0;
    this.shown = false;
    return this.points;
  }

  clear() { this.shown = false; }
}
