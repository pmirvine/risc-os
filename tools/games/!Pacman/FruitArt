// !Pacman - FruitArt: the eight bonus fruit, drawn from Shapes.
//
// Each fits a 12 x 12 box centred on (x, y). kind is an index into
// Theme.FRUIT or one of its names. The "rocket" is our own: a little
// spaceship, not the arcade's. Re-exported by Sprites.

import { rgb } from 'gamelib/Surface';
import { disc, pie, arc, line, polygon } from 'gamelib/Shapes';
import { FRUIT } from './Theme';

const RED = rgb(255, 0, 0), GREEN = rgb(0, 200, 0);
const WHITE = rgb(255, 255, 255), YELLOW = rgb(255, 255, 0);
const BROWN = rgb(200, 120, 40), CYAN = rgb(0, 255, 255);

const ART = {
  cherries(s, x, y) {
    line(s, x - 3, y, x + 1, y - 5, GREEN);
    line(s, x + 3, y, x + 1, y - 5, GREEN);
    disc(s, x - 3, y + 3, 3, RED);
    disc(s, x + 3, y + 3, 3, RED);
    s.pixel(x - 4, y + 2, WHITE);
  },
  strawberry(s, x, y) {
    disc(s, x, y - 1, 5, RED);
    polygon(s, [[x - 5, y - 1], [x + 5, y - 1], [x, y + 6]], RED);
    s.fillRect(x - 3, y - 6, 6, 2, GREEN);
    for (const [dx, dy] of [[-2, -1], [2, -1], [0, 1], [0, 3]]) {
      s.pixel(x + dx, y + dy, YELLOW);
    }
  },
  peach(s, x, y) {
    disc(s, x, y + 1, 5, rgb(255, 184, 81));
    polygon(s, [[x, y - 4], [x + 3, y - 6], [x + 4, y - 3]], GREEN);
  },
  apple(s, x, y) {
    disc(s, x, y + 1, 5, RED);
    line(s, x, y - 4, x + 1, y - 6, BROWN);
    s.fillRect(x + 1, y - 5, 3, 1, GREEN);
  },
  grapes(s, x, y) {
    line(s, x, y - 6, x, y - 3, GREEN);
    for (const [dx, dy] of [[-3, -2], [0, -2], [3, -2], [-1.5, 1],
      [1.5, 1], [0, 4]]) disc(s, x + dx, y + dy, 2, rgb(200, 0, 220));
  },
  rocket(s, x, y) {
    polygon(s, [[x - 2, y + 4], [x - 2, y - 2], [x, y - 6],
      [x + 2, y - 2], [x + 2, y + 4]], rgb(222, 222, 255));
    polygon(s, [[x - 2, y + 1], [x - 5, y + 5], [x - 2, y + 4]], RED);
    polygon(s, [[x + 2, y + 1], [x + 5, y + 5], [x + 2, y + 4]], RED);
    s.fillRect(x - 1, y - 2, 2, 2, rgb(33, 33, 255));
    s.fillRect(x - 1, y + 4, 2, 2, YELLOW);
  },
  bell(s, x, y) {
    pie(s, x, y, 5, Math.PI, Math.PI * 2, YELLOW);
    s.fillRect(x - 5, y, 10, 3, YELLOW);
    s.fillRect(x - 6, y + 3, 12, 1, YELLOW);
    disc(s, x, y + 5, 1.5, WHITE);
  },
  key(s, x, y) {
    arc(s, x, y - 3, 3.5, 0, Math.PI * 2, CYAN, 2);
    s.fillRect(x - 1, y, 2, 6, WHITE);
    s.fillRect(x + 1, y + 3, 2, 1, WHITE);
    s.fillRect(x + 1, y + 5, 2, 1, WHITE);
  },
};

/** Draw a fruit (index or name) centred on (x, y). */
export function drawFruit(s, x, y, kind) {
  const name = typeof kind === 'number' ? FRUIT[kind] : kind;
  (ART[name] ?? ART.cherries)(s, x, y);
}
