// !Pacman - Theme: names and colours, kept apart from the rules so the
// look of the game can change without touching the engine.
//
// Colours are [r, g, b] with each part 0-255.

export const TITLE = 'Pacman';

export const COLOURS = {
  wall: [33, 33, 255], door: [255, 184, 255], dot: [255, 184, 151],
  pac: [255, 255, 0],
  ghosts: [[255, 0, 0], [255, 184, 255], [0, 255, 255], [255, 184, 81]],
  blue: [33, 33, 222], flash: [222, 222, 255],
  face: [255, 184, 151], faceFlash: [255, 0, 0],
  text: [255, 255, 255], ready: [255, 255, 0], over: [255, 0, 0],
};

const NAMES = [['Blinky', 'Shadow'], ['Pinky', 'Speedy'],
  ['Inky', 'Bashful'], ['Clyde', 'Pokey']];

export const GHOSTS = NAMES.map(([name, nickname], id) => ({
  id, name, nickname, colour: COLOURS.ghosts[id],
}));

export const FRUIT = ['cherries', 'strawberry', 'peach', 'apple',
  'grapes', 'rocket', 'bell', 'key'];
