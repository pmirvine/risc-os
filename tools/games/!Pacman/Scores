// !Pacman - Scores: the high score table and where it is kept.
//
// The table holds ten entries {name, score, level, date}, best
// first. It is saved as the file Scores in the game's Choices
// directory ({table, lastName}, lastName being the name typed last
// time). A missing or damaged file, or one with nothing usable in
// it, gives SEED, ten entries of our own to beat. The scores are
// cleaned with GameLib's cleanTable, so nothing odd gets on screen.

import { cleanTable, insertScore } from 'gamelib/ScoreTable';

export const SIZE = 10;

const NAMES = ['ARM', 'BBC', 'VDU', 'RAM', 'ROM', 'CPU', 'BIT', 'KEY',
  'DOT', 'POW'];

export const SEED = NAMES.map((name, i) => ({ name, score: 10000
  - i * 1000, level: 1, date: '1987-06-01' }));

const OPTS = { size: SIZE, nameLength: 3, extra: ['level'] };

/** The saved table and last name from a Choices store. */
export async function loadScores(store) {
  const o = await store.read('Scores', { table: SEED, lastName: '' });
  const last = typeof o.lastName === 'string' ? o.lastName : '';
  return {
    table: cleanTable(o.table, OPTS) ?? SEED.map((e) => ({ ...e })),
    lastName: last.replace(/[^\x20-\x7e]/g, '').toUpperCase()
      .slice(0, 3),
  };
}

export function saveScores(store, data) {
  return store.write('Scores', data);
}

/** Put a finished game in the table; the place (0 = top) or -1. */
export function record(data, name, score, level, date) {
  data.lastName = name;
  return insertScore(data.table, { name, score, level, date }, SIZE);
}
