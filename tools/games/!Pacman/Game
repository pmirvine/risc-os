// !Pacman - Game: the state of a game and its clock.
//
// Composes the maze, Pac-Man and the ghosts, and runs the states:
// 'start' (the opening jingle, 252 frames) then 'play' (Play.playFrame
// does a frame), with 'eaten' (a 60 frame freeze) after a ghost is
// eaten. Pac-Man caught starts 'dying' (210 frames: freeze, ghosts
// vanish, the collapse, a pause); then 'ready' (120 frames, a life
// from the reserve) or, with none left, 'gameOver' (180 frames) and
// at last 'over', where nothing happens. When the last dot goes,
// 'levelDone' (240 frames: the ghosts vanish after 60, then the maze
// flashes) leads to 'ready' on the next level, with every dot back
// and the table row for the new level. lives counts the spare
// lives; one is taken as the actors appear. A demo game (demo: true,
// played by Autopilot) has a single life, no extra life, actors from
// frame 0, and 'start' and 'ready' of 60 frames, with no jingle.
// tick(input) runs one 60 Hz frame and returns the events of that
// frame ({type: 'dot'} and so on); snapshot() gives the whole state
// as plain data. debug has helpers for tests.

import { Rng } from 'gamelib/Maths';
import * as MazeData from './MazeData';
import * as Theme from './Theme';
import { Maze } from './Maze';
import { Player } from './Player';
import { Ghost } from './Ghost';
import { Modes } from './Modes';
import { Fright } from './Fright';
import { House } from './House';
import { Fruit } from './Fruit';
import { levelSpec } from './Levels';
import { playFrame, eatenFrame, kill, dyingFrame } from './Play';

export const START_FRAMES = 252;
export const READY_FRAMES = 120;
export const DONE_FRAMES = 240;
export const OVER_FRAMES = 180;
export const DEMO_FRAMES = 60;   // 'start' and 'ready' of a demo

export class Game {
  constructor({ seed = 1, level = 1, lives = 3, bonus = 10000,
    demo = false, data } = {}) {
    this.data = data || { maze: MazeData, theme: Theme };
    const { ROWS, SPECIAL } = this.data.maze;
    this.rng = new Rng(seed);
    this.level = level;
    this.lives = demo ? 1 : lives;
    this.bonus = demo ? 0 : bonus;
    this.demo = demo;
    this.score = 0;
    this.frame = 0;
    this.state = 'start';
    this.stateTimer = 0;
    this.events = [];
    this.popups = [];
    this.eatenId = -1;         // the ghost just eaten (the freeze)
    this.extraDone = false;    // the extra life has been given
    this.actorsShown = false;  // not during the first 120 frames
    this.ghostsShown = true;   // false for most of a death
    this.deathFrame = -1;      // -1, or Pac-Man's collapse 0 to 10
    this.maze = new Maze(ROWS, SPECIAL);
    this.player = new Player(SPECIAL.starts.pac);
    this.ghosts = SPECIAL.starts.ghosts.map((s, i) => new Ghost(i, s));
    this.modes = new Modes(level);
    this.startLevel(level);
    if (demo) this.showActors();
    const g = this;
    this.debug = {
      skipIntro() { g.showActors(); g.setState('play'); },
      place(id, px, py, dir) { g.ghosts[id].place(px, py, dir); },
      kill() { kill(g); },
      clearLevel() {
        for (let y = 0; y < g.maze.h; y++) {
          for (let x = 0; x < g.maze.w; x++) g.maze.eat(x, y);
        }
      },
    };
  }

  setState(state) {
    this.state = state;
    this.stateTimer = 0;
  }

  /** Everyone back to the start, as after a death. */
  resetActors() {
    this.player.reset();
    for (const g of this.ghosts) g.reset();
    this.modes.reset(this.level);
    this.fright.reset();
  }

  /** Level n from scratch: every dot back, everyone at the start,
   *  no sweeps, popups, fruit or fright, Elroy allowed. */
  startLevel(n) {
    this.level = n;
    this.maze.reset();
    this.sweeps = 0;
    this.eatenId = -1;
    this.popups = [];
    this.elroyOff = false;
    this.fright = new Fright(levelSpec(n));
    this.house = new House(n);
    this.fruit = new Fruit(n, this.rng);
    this.resetActors();
  }

  /** The next level, after 'levelDone'. */
  nextLevel() {
    this.startLevel(this.level + 1);
    this.ready();
  }

  /** 'ready' for 120 frames. */
  ready() {
    this.events.push({ type: 'ready' });
    this.setState('ready');
  }

  /** The actors appear and a life leaves the reserve (once). */
  showActors() {
    if (this.actorsShown) return;
    this.actorsShown = true;
    this.lives--;
  }

  /** Cruise Elroy stage of Blinky: 0, 1 or 2. */
  get elroy() {
    if (this.elroyOff) return 0;
    const s = levelSpec(this.level), left = this.maze.dotsLeft;
    return left <= s.elroy2Dots ? 2 : left <= s.elroy1Dots ? 1 : 0;
  }

  /** The death show is over: back to the start, or game over. */
  afterDeath() {
    this.resetActors();
    this.house.restart();
    this.house.onDeath();
    this.deathFrame = -1;
    this.ghostsShown = true;
    if (this.lives > 0) {
      this.lives--;
      this.ready();
    } else {
      this.events.push({ type: 'gameOver' });
      this.setState('gameOver');
    }
  }

  /** One frame; returns this frame's events. */
  tick(input) {
    this.events = [];
    if (this.state === 'over') return this.events;
    this.frame++;
    if (this.state === 'start') {
      if (this.stateTimer === 0 && !this.demo) {
        this.events.push({ type: 'start' });
      }
      if (++this.stateTimer === 120) this.showActors();
      if (this.stateTimer >= (this.demo ? DEMO_FRAMES : START_FRAMES)) {
        this.setState('play');
      }
    } else if (this.state === 'play') {
      this.stateTimer++;
      playFrame(this, input);
    } else if (this.state === 'ready') {
      const n = this.demo ? DEMO_FRAMES : READY_FRAMES;
      if (++this.stateTimer >= n) this.setState('play');
    } else if (this.state === 'eaten') {
      eatenFrame(this);
    } else if (this.state === 'dying') {
      if (dyingFrame(this)) this.afterDeath();
    } else if (this.state === 'gameOver') {
      if (++this.stateTimer >= OVER_FRAMES) this.setState('over');
    } else if (this.state === 'levelDone') {
      if (++this.stateTimer >= DONE_FRAMES) this.nextLevel();
    }
    return this.events;
  }

  /** The state as plain JSON, for golden tests. */
  snapshot() {
    const actor = (a) => ({ px: a.px, py: a.py, dir: a.dir, acc: a.acc,
      tx: a.tx, ty: a.ty });
    return JSON.parse(JSON.stringify({
      state: this.state, stateTimer: this.stateTimer,
      frame: this.frame, level: this.level, score: this.score,
      lives: this.lives, rng: this.rng.s,
      dotsLeft: this.maze.dotsLeft, dotsEaten: this.maze.dotsEaten,
      player: { ...actor(this.player), pause: this.player.pause,
        anim: this.player.anim, stopped: this.player.stopped },
      ghosts: this.ghosts.map((g) => ({ id: g.id, ...actor(g),
        state: g.state, turn: g.turn, ahead: g.ahead,
        reverse: g.reverse, blue: g.blue, flash: !!g.flash })),
      fright: { on: this.fright.on, elapsed: this.fright.elapsed },
      modes: { mode: this.modes.mode, phase: this.modes.phase,
        timer: this.modes.timer },
      popups: this.popups,
      fruit: { shown: this.fruit.shown, timer: this.fruit.timer,
        seen: this.fruit.seen },
    }));
  }
}
