// !Pacman - Pages: the plain screens - heading, text, and a footer.
//
// How to play and High scores are pages of text (28 letters wide at
// most); Settings is a Menu under a heading. drawPage puts the
// heading and the lines on the game surface; Screens decides which
// page is showing and any key or click on a text page goes back.

import { rgb } from 'gamelib/Surface';
import { drawText } from 'gamelib/Font';
import { COLOURS } from './Theme';

export const HELP = [
  'Eat every dot to clear the',
  'maze. Ghosts chase you; a',
  'touch costs a life.',
  '',
  'Steer: arrows, W A S D,',
  "Z X ' / or a gamepad.",
  'Pac-Man turns at the next',
  'place the way is open.',
  '',
  'Big dots turn the ghosts',
  'blue: eat them for 200,',
  '400, 800, 1600. Fruit',
  'appears twice a level.',
  '',
  'P pause   Esc menu',
  'F browser full screen',
];

export const NO_SCORES = ['No scores yet.', '',
  'Play a game and the best', 'ones are kept here.'];

/** A heading, lines of text and a footer line on the surface. */
export function drawPage(s, heading, lines, footer = '') {
  s.clear(rgb(0, 0, 0));
  drawText(s, heading, 112, 24, { scale: 2, align: 'centre',
    colour: rgb(...COLOURS.pac), shadow: rgb(...COLOURS.wall) });
  lines.forEach((line, i) => drawText(s, line, 16, 60 + i * 12,
    { colour: rgb(...COLOURS.text) }));
  drawText(s, footer, 112, 268, { align: 'centre',
    colour: rgb(...COLOURS.ready) });
}
