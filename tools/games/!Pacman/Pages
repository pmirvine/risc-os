// !Pacman - Pages: the plain screens - heading, text, and a footer.
//
// How to play is a page of text (28 letters wide at most); High
// scores is the table (drawScores), and name entry shows the name
// being typed (drawEntry); Settings is a Menu under a heading.
// drawPage puts the heading and the lines on the game surface;
// Screens decides which page is showing and any key or click on a
// text page goes back.

import { rgb } from 'gamelib/Surface';
import { drawText } from 'gamelib/Font';
import { COLOURS } from './Theme';

export const HELP = [
  'Eat every dot to clear the',
  'maze. Ghosts chase you; a',
  'touch costs a life.',
  '',
  'Steer: arrows, W A S D,',
  "Z X ' / or a gamepad.",
  'Pac-Man turns at the next',
  'place the way is open.',
  '',
  'Big dots turn the ghosts',
  'blue: eat them for 200,',
  '400, 800, 1600. Fruit',
  'appears twice a level.',
  '',
  'P pause   Esc menu',
  'F browser full screen',
];

/** A heading, lines of text and a footer line on the surface. */
export function drawPage(s, heading, lines, footer = '') {
  s.clear(rgb(0, 0, 0));
  drawText(s, heading, 112, 24, { scale: 2, align: 'centre',
    colour: rgb(...COLOURS.pac), shadow: rgb(...COLOURS.wall) });
  lines.forEach((line, i) => drawText(s, line, 16, 60 + i * 12,
    { colour: rgb(...COLOURS.text) }));
  drawText(s, footer, 112, 268, { align: 'centre',
    colour: rgb(...COLOURS.ready) });
}

/** The table: rank, name, score, level and date for each entry. */
export function drawScores(s, table) {
  drawPage(s, 'HIGH SCORES', [], 'Return: back');
  const head = rgb(...COLOURS.ready), text = rgb(...COLOURS.text);
  const row = (y, c, rank, name, score, level, date) => {
    drawText(s, rank, 24, y, { colour: c, align: 'right' });
    drawText(s, name, 32, y, { colour: c });
    drawText(s, score, 112, y, { colour: c, align: 'right' });
    drawText(s, level, 136, y, { colour: c, align: 'right' });
    drawText(s, date, 144, y, { colour: c });
  };
  row(52, head, 'NO', 'NAME', 'SCORE', 'LV', 'DATE');
  table.forEach((e, i) => row(70 + i * 16, text, String(i + 1), e.name,
    String(e.score), String(e.level), e.date));
}

/** Name entry: the score, and the letters so far with a cursor. */
export function drawEntry(s, score, text, frame) {
  drawPage(s, 'NEW HIGH SCORE', [], 'Return: done');
  drawText(s, 'Your score ' + score, 112, 100, { align: 'centre',
    colour: rgb(...COLOURS.text) });
  drawText(s, 'Type your name:', 112, 128, { align: 'centre',
    colour: rgb(...COLOURS.text) });
  const shown = (text + ((frame >> 4) % 2 ? '_' : ' ')).padEnd(3, '.');
  drawText(s, shown, 112, 152, { scale: 3, align: 'centre',
    colour: rgb(...COLOURS.pac) });
}
