// !Pacman - Maze: the walls, the dots and who may stand where.
//
// Built from the rows in MazeData. walkable(tx, ty, who) says whether
// a tile is open to 'pac', to a 'ghost' (not the house or its door) or
// to a 'house' ghost (which also uses 'H' and the door '-'). Row 14
// wraps from one side to the other, so columns -1 and 28 exist there.

import { DX, DY } from './Dirs';

export class Maze {
  constructor(rows, special) {
    this.rows = rows;
    this.special = special;
    this.w = rows[0].length;
    this.h = rows.length;
    this.dots = new Uint8Array(this.w * this.h);
    this.reset();
  }

  /** Put every dot and energizer back. */
  reset() {
    this.dotsLeft = 0;
    this.dotsEaten = 0;
    for (let y = 0; y < this.h; y++) {
      for (let x = 0; x < this.w; x++) {
        const c = this.rows[y][x];
        const v = c === '.' ? 10 : c === 'o' ? 50 : 0;
        this.dots[y * this.w + x] = v;
        if (v) this.dotsLeft++;
      }
    }
  }

  /** The character at a tile ('#' outside), wrapping in the tunnel. */
  at(tx, ty) {
    if (ty < 0 || ty >= this.h) return '#';
    if (ty === this.special.tunnelRow) tx = (tx + this.w) % this.w;
    return tx < 0 || tx >= this.w ? '#' : this.rows[ty][tx];
  }

  walkable(tx, ty, who) {
    const c = this.at(tx, ty);
    if (c === '#') return false;
    if (c === '-' || c === 'H') return who === 'house';
    return true;
  }

  isTunnel(tx, ty) { return this.at(tx, ty) === 'T'; }

  isRedZone(tx, ty) {
    return this.special.redZones.some(([x, y]) => x === tx && y === ty);
  }

  /** The directions open to Pac-Man from a tile. */
  exits(tx, ty) {
    const out = [];
    for (let d = 0; d < 4; d++) {
      if (this.walkable(tx + DX[d], ty + DY[d], 'pac')) out.push(d);
    }
    return out;
  }

  /** 0, 10 (dot) or 50 (energizer) at a tile. */
  dotAt(tx, ty) {
    if (tx < 0 || tx >= this.w || ty < 0 || ty >= this.h) return 0;
    return this.dots[ty * this.w + tx];
  }

  /** Eat what is at a tile: the points it was worth, or 0. */
  eat(tx, ty) {
    const v = this.dotAt(tx, ty);
    if (v) {
      this.dots[ty * this.w + tx] = 0;
      this.dotsLeft--;
      this.dotsEaten++;
    }
    return v;
  }

  /** 1 for each wall tile ('#'), row by row, for drawing the walls. */
  wallMask() {
    const m = new Uint8Array(this.w * this.h);
    for (let y = 0; y < this.h; y++) {
      for (let x = 0; x < this.w; x++) {
        if (this.rows[y][x] === '#') m[y * this.w + x] = 1;
      }
    }
    return m;
  }
}
