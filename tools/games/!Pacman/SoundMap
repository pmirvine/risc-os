// !Pacman - SoundMap: which sounds the game's events call for.
//
// A personal, non-commercial tribute to Namco's 1980 arcade game.
// Pac-Man is a trademark of Bandai Namco; this program is not
// connected with them.
//
// Pure functions, no desktop in them: the shell gives each frame's
// events to soundsFor() and plays the names it returns, and asks
// loopFor() each frame which looping sound should be running.

// Events that play a sound of the same name.
const SAME = {
  ghostEaten: 'ghostEaten', fruitEaten: 'fruitEaten',
  extraLife: 'extraLife', death: 'death', start: 'startJingle',
};

/**
 * The sounds (names) to play for a frame's events. mem = { waka } keeps
 * which waka comes next (0 or 1); eating a dot or an energizer plays
 * it and flips it. Events with no sound (the engine has several, and
 * may add more) are ignored.
 */
export function soundsFor(events, mem) {
  const out = [];
  if (!Array.isArray(events)) return out;
  for (const e of events) {
    const type = e?.type;
    if (type === 'dot' || type === 'energizer') {
      const w = mem?.waka === 1 ? 1 : 0;
      out.push('waka' + w);
      if (mem) mem.waka = 1 - w;
    } else if (Object.hasOwn(SAME, type)) out.push(SAME[type]);
  }
  return out;
}

// Dots left over which each siren step holds (appendix section 12):
// more than 180 -> siren0, 129-180 -> 1, 65-128 -> 2, 33-64 -> 3,
// 32 or fewer -> 4.
const STEPS = [180, 128, 64, 32];

/**
 * The looping sound that should be running: null unless a game (not
 * the demo) is in play; the eyes if any ghost is going home; else the
 * fright sound if a fright is on; else the siren for the dots left.
 */
export function loopFor(game) {
  if (!game || game.demo || game.state !== 'play') return null;
  if (game.ghosts?.some((g) => g.state === 'eyes')) return 'eyes';
  if (game.fright?.on) return 'fright';
  const left = game.maze?.dotsLeft ?? 0;
  const k = STEPS.findIndex((n) => left > n);
  return 'siren' + (k < 0 ? STEPS.length : k);
}
