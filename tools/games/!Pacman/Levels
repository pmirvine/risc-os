// !Pacman - Levels: what changes from one level to the next.
//
// The scatter/chase schedule: how many 60 Hz frames each phase
// lasts. The phases alternate, scatter first. After the last chase
// (Infinity) the ghosts chase for ever. The 1-frame scatter on
// level 2 and later is real: it reverses the ghosts once more.
//
// Also the ghost house's dot limits and idle time (see House).

/** The phase lengths, in frames, for level n. */
export function schedule(n) {
  if (n === 1) return [420, 1200, 420, 1200, 300, 1200, 300, Infinity];
  if (n <= 4) return [420, 1200, 420, 1200, 300, 61980, 1, Infinity];
  return [300, 1200, 300, 1200, 300, 62220, 1, Infinity];
}

/** Dots Pinky's, Inky's and Clyde's counters need, by ghost id. */
export function houseLimits(n) {
  if (n === 1) return [0, 0, 30, 60];
  if (n === 2) return [0, 0, 0, 50];
  return [0, 0, 0, 0];
}

/** Frames without a dot before the house lets a ghost out. */
export function idleLimit(n) {
  return n <= 4 ? 240 : 180;
}
