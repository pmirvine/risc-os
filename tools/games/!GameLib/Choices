// GameLib - Choices: where a game keeps its saved files.
//
// Files go in <Choices$Write>.<App> (normally $.!Boot.Choices.<App>
// on the hard disc), as JSON text anyone can read in !Edit. The
// services (the desktop's choices, vfs and system variables) are
// passed in, so GameLib itself never needs the desktop. A missing or
// damaged file just gives the defaults.

const FALLBACK = 'ADFS::HardDisc4.$.!Boot.Choices';

export function choicesStore({choices, vfs, sysvars}, app) {
  const path = () =>
    (sysvars?.get?.('Choices$Write') || FALLBACK) + '.' + app;
  const dir = () => {
    const d = path();
    try { vfs.mkdir(d, {parents: true}); } catch { /* read-only */ }
    return d;
  };
  return {
    dir,
    /** The saved object in leaf, or a copy of the defaults. */
    async read(leaf, defaults) {
      try {
        const o = await choices.read(`${app}.${leaf}`, defaults);
        if (o && typeof o === 'object' && !Array.isArray(o)) return o;
      } catch { /* fall through */ }
      return {...defaults};
    },
    /** Save obj in leaf; false (quietly) if that cannot be done. */
    async write(leaf, obj) {
      try {
        vfs.mkdir(path(), {parents: true});
        await choices.write(`${app}.${leaf}`, obj);
        return true;
      } catch {
        return false;
      }
    },
  };
}
