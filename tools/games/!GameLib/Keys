// GameLib - Keys: the keyboard, as named actions.
//
// A game gives Keys its actions as {name: [DOM key codes]}, for example
// {left: ['ArrowLeft', 'KeyA']}. The shell passes on the browser's key
// events; the game asks which actions are held, which were pressed
// since the edges were last cleared, and which of several actions
// (the four directions, say) was pressed most recently and is still
// held. Menus take every press, mapped or not, from takePresses().

export class Keys {
  constructor(actions) {
    this.actions = actions;
    this.codes = new Set();     // DOM codes of the keys held down
    this.order = [];            // held action names, oldest first
    this.edges = new Set();     // actions pressed since clearEdges
    this.presses = [];          // every key press, for the menus
  }

  // The names of the actions a key code belongs to.
  namesFor(code) {
    return Object.keys(this.actions)
      .filter((n) => this.actions[n].includes(code));
  }

  /** A key went down. True if some action uses the key. */
  keyDown(e) {
    const names = this.namesFor(e.code);
    this.codes.add(e.code);
    for (const n of names) {
      if (!e.repeat) this.edges.add(n);
      if (!this.order.includes(n)) this.order.push(n);
    }
    this.presses.push({ code: e.code, key: e.key, repeat: !!e.repeat,
      shift: !!e.shiftKey, ctrl: !!e.ctrlKey });
    return names.length > 0;
  }

  /** A key came up. */
  keyUp(e) {
    this.codes.delete(e.code);
    this.order = this.order.filter((n) => this.held(n));
  }

  /** Is any key of the action down? */
  held(action) {
    return (this.actions[action] ?? []).some((c) => this.codes.has(c));
  }

  /** Was the action pressed (not repeated) since clearEdges? */
  pressed(action) { return this.edges.has(action); }

  /** The most recently pressed of these actions still held, or null. */
  latest(actions) {
    for (let i = this.order.length - 1; i >= 0; i--) {
      const n = this.order[i];
      if (actions.includes(n) && this.held(n)) return n;
    }
    return null;
  }

  /** Every key press since last time, for the menus. */
  takePresses() {
    const p = this.presses;
    this.presses = [];
    return p;
  }

  /** Forget held keys (the focus went elsewhere). */
  release() {
    this.codes.clear();
    this.order = [];
  }

  /** Forget the presses of the last tick. */
  clearEdges() {
    this.edges.clear();
    this.presses = [];
  }
}
