// GameLib - ScoreTable: a high score table, kept sorted.
//
// An entry is {name, score, date} (plus any extra number fields a
// game names, such as level). cleanTable() makes a table read from a
// file safe; qualifies() and insertScore() keep the best `size`.

/** A table from a file made safe, or null if none is usable. */
export function cleanTable(t, {size = 10, nameLength = 3,
  extra = []} = {}) {
  if (!Array.isArray(t)) return null;
  const out = [];
  for (const e of t) {
    if (!e || typeof e !== 'object' || !Number.isFinite(e.score)) continue;
    const entry = {
      name: String(e.name ?? '').replace(/[^\x20-\x7e]/g, '')
        .slice(0, nameLength) || '???',
      score: Math.round(e.score),
      date: typeof e.date === 'string' ? e.date.slice(0, 10) : '',
    };
    for (const k of extra) entry[k] = Number.isFinite(e[k]) ? e[k] : 0;
    out.push(entry);
  }
  out.sort((a, b) => b.score - a.score);
  return out.length ? out.slice(0, size) : null;
}

/** Would this score get into the table? */
export function qualifies(table, score, size) {
  if (score <= 0) return false;
  return table.length < size || score > table[table.length - 1].score;
}

/** Put an entry in its place; returns its position (0 = top) or -1. */
export function insertScore(table, entry, size) {
  let i = table.findIndex((e) => entry.score > e.score);
  if (i < 0) i = table.length;
  table.splice(i, 0, entry);
  table.length = Math.min(table.length, size);
  return i < size ? i : -1;
}

/** Today's date as YYYY-MM-DD. */
export function today(date = new Date()) {
  const two = (n) => String(n).padStart(2, '0');
  return `${date.getFullYear()}-${two(date.getMonth() + 1)}-`
    + two(date.getDate());
}
