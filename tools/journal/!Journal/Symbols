// Symbols - the moods and the weather a day can have, and the little
// pictures of them that the calendar draws. A day's file keeps the
// words ("Mood: Happy"), so any word typed in !Edit works too: one
// the Journal doesn't know is shown as a small grey face or cloud.
//
//   MOODS, WEATHER                 [{ name, colour, ... }]
//   drawMood(g, name, x, y, r)     a face of radius r centred at x, y
//   drawWeather(g, name, x, y, r)
//
// And the prompts offered by Insert > Prompt, for days when it's
// hard to know what to write.

export const MOODS = [
  { name: 'Happy', colour: '#f2c230', smile: 1 },
  { name: 'Excited', colour: '#f28c28', smile: 1, open: true },
  { name: 'Content', colour: '#8cc152', smile: 0.5 },
  { name: 'Calm', colour: '#5dade2', smile: 0.3 },
  { name: 'Tired', colour: '#a5a5c8', smile: 0, sleepy: true },
  { name: 'Anxious', colour: '#c39bd3', smile: -0.4 },
  { name: 'Sad', colour: '#5d6d9e', smile: -1 },
  { name: 'Angry', colour: '#e74c3c', smile: -1, frown: true },
];
export const WEATHER = [
  { name: 'Sunny' }, { name: 'Cloudy' }, { name: 'Rain' },
  { name: 'Snow' }, { name: 'Windy' }, { name: 'Fog' },
  { name: 'Storm' },
];
const find = (list, name) => list.find((x) =>
  x.name.toLowerCase() === String(name).trim().toLowerCase());
export const moodOf = (name) => find(MOODS, name);
export const weatherOf = (name) => find(WEATHER, name);

export const PROMPTS = [
  'Three good things about today:',
  'Something I learnt today:',
  'Someone I was glad to see:',
  'What made me laugh:',
  'What I would do differently:',
  'Something I am looking forward to:',
  'What is on my mind:',
  'A small thing I noticed:',
  'Something I am grateful for:',
  'Tomorrow I will:',
];

// ------------------------------------------------ drawing
export function drawMood(g, name, x, y, r) {
  const m = moodOf(name) ?? { colour: '#bbbbbb', smile: 0 };
  g.save();
  g.fillStyle = m.colour; g.strokeStyle = '#000000'; g.lineWidth = 1;
  g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.fill(); g.stroke();
  g.fillStyle = '#000000';
  const ey = y - r * 0.25, ex = r * 0.38;
  if (m.sleepy) {
    g.beginPath();
    g.moveTo(x - ex - r * 0.15, ey); g.lineTo(x - ex + r * 0.15, ey);
    g.moveTo(x + ex - r * 0.15, ey); g.lineTo(x + ex + r * 0.15, ey);
    g.stroke();
  } else {
    for (const dx of [-ex, ex]) {
      g.beginPath(); g.arc(x + dx, ey, Math.max(1, r * 0.12), 0,
        Math.PI * 2); g.fill();
    }
  }
  if (m.frown) {                       // eyebrows, for Angry
    g.beginPath();
    g.moveTo(x - ex - r * 0.2, ey - r * 0.3);
    g.lineTo(x - ex + r * 0.15, ey - r * 0.12);
    g.moveTo(x + ex + r * 0.2, ey - r * 0.3);
    g.lineTo(x + ex - r * 0.15, ey - r * 0.12);
    g.stroke();
  }
  const my = y + r * 0.35, mw = r * 0.5, bend = m.smile * r * 0.3;
  g.beginPath();
  if (m.open) {
    g.moveTo(x - mw, my - r * 0.05);
    g.quadraticCurveTo(x, my + r * 0.55, x + mw, my - r * 0.05);
    g.closePath(); g.fill();
  } else {
    g.moveTo(x - mw, my - bend / 2);
    g.quadraticCurveTo(x, my + bend, x + mw, my - bend / 2);
    g.stroke();
  }
  g.restore();
}

function cloud(g, x, y, r, fill) {
  g.fillStyle = fill; g.strokeStyle = '#555555'; g.lineWidth = 1;
  g.beginPath();
  g.arc(x - r * 0.45, y + r * 0.1, r * 0.45, Math.PI * 0.5,
    Math.PI * 1.5);
  g.arc(x, y - r * 0.2, r * 0.55, Math.PI * 1.1, Math.PI * 1.95);
  g.arc(x + r * 0.5, y + r * 0.1, r * 0.45, Math.PI * 1.5,
    Math.PI * 0.5);
  g.closePath(); g.fill(); g.stroke();
}
export function drawWeather(g, name, x, y, r) {
  const w = weatherOf(name)?.name ?? '';
  g.save();
  g.lineCap = 'round';
  if (w === 'Sunny') {
    g.strokeStyle = '#e0a000'; g.lineWidth = 1.5;
    for (let i = 0; i < 8; i++) {
      const a = i * Math.PI / 4;
      g.beginPath();
      g.moveTo(x + Math.cos(a) * r * 0.65, y + Math.sin(a) * r * 0.65);
      g.lineTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
      g.stroke();
    }
    g.fillStyle = '#ffd21f'; g.strokeStyle = '#c08000';
    g.beginPath(); g.arc(x, y, r * 0.48, 0, Math.PI * 2);
    g.fill(); g.stroke();
  } else if (w === 'Windy') {
    g.strokeStyle = '#557799'; g.lineWidth = 1.5;
    for (const [dy, len] of [[-0.45, 1], [0, 0.8], [0.45, 0.6]]) {
      g.beginPath();
      g.moveTo(x - r, y + dy * r);
      g.quadraticCurveTo(x + r * (len - 0.4), y + dy * r - r * 0.2,
        x + r * len, y + dy * r);
      g.stroke();
    }
  } else if (w === 'Fog') {
    g.strokeStyle = '#999999'; g.lineWidth = 2;
    for (const dy of [-0.5, 0, 0.5]) {
      g.beginPath(); g.moveTo(x - r, y + dy * r);
      g.lineTo(x + r, y + dy * r); g.stroke();
    }
  } else {
    const dark = w === 'Storm' || w === 'Rain';
    cloud(g, x, y - r * 0.15, r, dark ? '#9aa4b0' : '#e6e6e6');
    if (w === 'Rain') {
      g.strokeStyle = '#2060d0'; g.lineWidth = 1.5;
      for (const dx of [-0.45, 0, 0.45]) {
        g.beginPath(); g.moveTo(x + dx * r, y + r * 0.45);
        g.lineTo(x + dx * r - r * 0.15, y + r * 0.9); g.stroke();
      }
    } else if (w === 'Snow') {
      g.fillStyle = '#6fa8dc';
      for (const dx of [-0.45, 0, 0.45]) {
        g.beginPath(); g.arc(x + dx * r, y + r * 0.7, r * 0.12, 0,
          Math.PI * 2); g.fill();
      }
    } else if (w === 'Storm') {
      g.fillStyle = '#ffcc00'; g.strokeStyle = '#806000';
      g.beginPath();
      const bolt = [[0.1, 0.2], [-0.25, 0.65], [0, 0.65], [-0.15, 1],
        [0.3, 0.5], [0.05, 0.5]];
      bolt.forEach(([dx, dy], i) => (i ? g.lineTo : g.moveTo)
        .call(g, x + dx * r, y + dy * r));
      g.closePath(); g.fill(); g.stroke();
    }
  }
  g.restore();
}
