// Settings - the Journal's choices, kept in Choices:Journal (the
// RISC OS Style Guide's way), and the boxes that ask for a password.
//
//   const prefs = await loadChoices()
//     { folder, autosave, onThisDay, font, size }
//   openChoices(app)                  the Choices... box
//   await askPassword(task, { title, message, twice })
//     -> the password typed, or null (Cancel)
import { wimp, choices, reportError } from 'riscos';
import { Form } from './Toolkit/Form';

/** A "Message from Journal" box; category 'info' for news. */
export const say = (message, category = 'error') =>
  reportError(message, { appName: 'Journal', category });

export const FONTS = { Homerton: 'Homerton', Trinity: 'Trinity',
  Corpus: 'Corpus', System: 'RISCOS System' };
export const SIZES = ['12', '14', '16', '18', '20'];
export const DEFAULTS = {
  folder: 'ADFS::HardDisc4.$.Journal',
  autosave: true, onThisDay: true, font: 'Homerton', size: 14,
};

export const loadChoices = () => choices.read('Journal', DEFAULTS);
export const fontCss = (p) =>
  `${p.size}px "${FONTS[p.font] ?? 'Homerton'}"`;

let form = null;
export async function openChoices(app) {
  form ??= new Form(app.task, {
    title: 'Journal choices',
    help: 'Choose where the journal is kept and how it behaves.',
    fields: [
      { name: 'folder', label: 'Journal', width: 300, maxLen: 200,
        help: 'The folder your journal is kept in. Drag a folder ' +
          'onto the Journal\'s icon to use it instead.' },
      { name: 'autosave', label: 'Save pages as I type',
        option: true, help: 'Save each page a moment after you ' +
          'stop typing, and when it is closed.' },
      { name: 'onThisDay', label: 'Show On this day at start',
        option: true, help: 'When the Journal starts, show what ' +
          'you wrote on this date in other years.' },
      { name: 'font', label: 'Text font', width: 140,
        choices: Object.keys(FONTS),
        help: 'The font pages are written in.' },
      { name: 'size', label: 'Text size', width: 80, choices: SIZES,
        help: 'The size of the text, in pixels.' },
    ],
    buttons: ['Default', 'Cancel', 'Set', 'Save'],
    stay: ['Default'],
    check: (v) => (/^[^\s]+$/.test(v.folder) ? null : { field: 'folder',
      message: 'Please give the full name of a folder, such as ' +
        'ADFS::HardDisc4.$.Journal' }),
  });
  form.off?.();
  form.off = form.on('button', () => form.set(shown(DEFAULTS)));
  const r = await form.run(shown(app.prefs));
  if (!r) return;
  const v = r.values;
  const prefs = { folder: v.folder, autosave: v.autosave,
    onThisDay: v.onThisDay, font: v.font, size: +v.size };
  if (r.button === 'Save') choices.write('Journal', prefs);
  await app.setChoices(prefs);
}
const shown = (p) => ({ ...p, size: String(p.size) });

// ------------------------------------------------ passwords
/** A box asking for a password (shown as *s); twice: type it again. */
export function askPassword(task, { title = 'Journal', message,
  twice = false }) {
  const rows = twice ? 2 : 1;
  const W = 420, H = 56 + rows * 36 + 52;
  const icons = [
    { x: 12, y: 12, w: W - 24, h: 32, text: message },
  ];
  for (let i = 0; i < rows; i++) {
    icons.push({ x: 12, y: 52 + i * 36, w: 130, h: 28,
      text: i ? 'Again' : 'Password', rjustify: true },
    { x: 150, y: 52 + i * 36, w: 250, h: 28, text: '',
      button: 'writable', border: true, filled: true, maxLen: 60,
      validation: 'D*', name: `pw${i}`,
      help: i ? 'Type the password again, to be sure of it.'
        : 'Type the password. It shows as stars.' });
  }
  icons.push(
    { x: W - 232, y: H - 46, w: 100, h: 36, text: 'Cancel',
      border: true, filled: true, hcentre: true, button: 'click',
      validation: 'R5,3', name: 'cancel' },
    { x: W - 120, y: H - 48, w: 108, h: 40, text: 'OK', border: true,
      filled: true, hcentre: true, button: 'click',
      validation: 'R6,3', name: 'ok' });
  const w = task.createWindow({ title, w: W, h: H,
    extent: { w: W, h: H }, flags: { title: true, moveable: true },
    returnNext: true, icons });
  return new Promise((resolve) => {
    const done = (v) => { w.delete(); resolve(v); };
    const ok = () => {
      const a = w.iconByName('pw0').text;
      if (!a) { say('Please type a password'); return; }
      if (twice && a !== w.iconByName('pw1').text) {
        say('The two passwords are not the same');
        w.iconByName('pw1').setText('');
        wimp.setCaret(w, w.iconByName('pw1'));
        return;
      }
      done(a);
    };
    w.on('click', (ev) => {
      if (ev.icon?.name === 'ok') ok();
      else if (ev.icon?.name === 'cancel') done(null);
      return undefined;
    });
    w.on('key', (ev) => {
      if (ev.code === 27) { done(null); return true; }
      if (ev.code === 13) { ok(); return true; }
      return undefined;
    });
    w.open({ x: Math.round((wimp.width - W) / 2),
      y: Math.round((wimp.height - H) / 3), behind: 'top' });
    wimp.setCaret(w, w.iconByName('pw0'));
  });
}
