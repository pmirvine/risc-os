// WordCount - drop a text file on the window to count its words
const w = task.createWindow({
  title: 'WordCount',
  x: 300, y: 200, w: 320, h: 172,
  extent: { w: 320, h: 172 },
  flags: { title: true, close: true, back: true, moveable: true },
  icons: [
    { x: 16, y: 12, w: 288, h: 32, text: 'Drop a text file here',
      hcentre: true },
    { x: 16, y: 56, w: 140, h: 28, text: 'Lines' },
    { x: 16, y: 92, w: 140, h: 28, text: 'Words' },
    { x: 16, y: 128, w: 140, h: 28, text: 'Characters' },
    { x: 170, y: 56, w: 134, h: 28, text: '-', rjustify: true },
    { x: 170, y: 92, w: 134, h: 28, text: '-', rjustify: true },
    { x: 170, y: 128, w: 134, h: 28, text: '-', rjustify: true },
  ],
});

const title = w.icons[0];
const lines = w.icons[4];
const words = w.icons[5];
const chars = w.icons[6];

async function count(file) {
  if (file.filetype !== 0xfff) {
    task.reportError(`'${file.name}' is not a text file`);
    return;
  }
  const text = await vfs.readText(file.path);
  // split at line ends, and at any run of spaces or line ends
  let lineCount = text.split('\n').length;
  if (text.endsWith('\n')) {
    lineCount = lineCount - 1;   // nothing after the last line end
  }
  const wordList = text.split(/\s+/).filter((s) => s !== '');
  title.setText(file.name);
  lines.setText(String(lineCount));
  words.setText(String(wordList.length));
  chars.setText(String(text.length));
}

w.on('dataload', (ev) => {
  count(ev.files[0]);
  return true;
});
w.on('close', () => task.quit());
w.open();
