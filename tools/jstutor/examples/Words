// Words - facts about the words in a sentence
const sentence = await input('Type a sentence: ');

const words = [];
for (const word of sentence.split(' ')) {
  if (word !== '') {
    words.push(word);
  }
}

let longest = '';
for (const word of words) {
  if (word.length > longest.length) {
    longest = word;
  }
}

print(`It has ${words.length} words.`);
print(`The first is "${words[0]}".`);
print(`The last is "${words[words.length - 1]}".`);
print(`The longest is "${longest}".`);
print(`Does it contain "the"? ${words.includes('the')}`);
print(`"the" is word number ${words.indexOf('the') + 1}.`);
print(`Sorted: ${words.sort().join(' ')}`);
