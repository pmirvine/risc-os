// Scores - a table of top scores
const scores = [
  { name: 'Ann', score: 120 },
  { name: 'Bob', score: 85 },
  { name: 'Cat', score: 210 },
];

print('Add some scores. Press Return on its own to finish.');
while (true) {
  const name = await input('Name: ');
  if (name === '') {
    break;
  }
  const score = Number(await input('Score: '));
  scores.push({ name: name, score: score });
}

scores.sort((a, b) => b.score - a.score);

print('');
print('Top scores');
for (let i = 0; i < scores.length; i++) {
  const entry = scores[i];
  const place = String(i + 1).padStart(2);
  const points = String(entry.score).padStart(5);
  print(`${place}. ${entry.name.padEnd(12)}${points}`);
}
print(`Best: ${scores[0].name}, out of ${scores.length} players.`);
