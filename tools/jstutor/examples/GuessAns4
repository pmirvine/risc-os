// GuessAns4 - guess the number, in seven guesses or fewer
const secret = Math.floor(Math.random() * 100) + 1;
let guess = 0;

print("I'm thinking of a number from 1 to 100.");
for (let guesses = 1; guesses <= 7; guesses++) {
  guess = Number(await input(`Guess ${guesses} of 7: `));
  if (guess === secret) {
    print(`Right! You took ${guesses} guesses.`);
    break;
  } else if (guess < secret) {
    print('Too low.');
  } else {
    print('Too high.');
  }
}

if (guess !== secret) {
  print(`Out of guesses! It was ${secret}.`);
}
