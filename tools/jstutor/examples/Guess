// Guess - guess the number I'm thinking of
const secret = Math.floor(Math.random() * 100) + 1;
let guesses = 0;

print("I'm thinking of a number from 1 to 100.");
while (true) {
  const guess = Number(await input('Your guess: '));
  guesses = guesses + 1;
  if (guess === secret) {
    print(`Right! You took ${guesses} guesses.`);
    break;
  } else if (guess < secret) {
    print('Too low.');
  } else {
    print('Too high.');
  }
}
