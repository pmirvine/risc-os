// Pattern - a spirograph pattern that fits the window
const w = task.createWindow({
  title: 'Pattern',
  x: 200, y: 80, w: 460, h: 460,
  extent: { w: 1200, h: 1200 },
  colours: { workBg: 0 },
});

// The point on the curve at angle t (a "hypotrochoid")
function curve(t) {
  const big = 10;
  const small = 7;
  const pen = 6;
  return {
    x: (big - small) * Math.cos(t)
      + pen * Math.cos((big - small) / small * t),
    y: (big - small) * Math.sin(t)
      - pen * Math.sin((big - small) / small * t),
  };
}

w.useCanvas((g, r) => {
  // the middle of the visible part of the window
  const cx = (r.x0 + r.x1) / 2;
  const cy = (r.y0 + r.y1) / 2;
  const size = Math.min(r.x1 - r.x0, r.y1 - r.y0) / 20;
  const steps = 1400;
  g.lineWidth = 2;
  for (let i = 0; i < steps; i++) {
    const a = curve(i / steps * Math.PI * 14);
    const b = curve((i + 1) / steps * Math.PI * 14);
    g.strokeStyle = `hsl(${i * 360 / steps}, 80%, 45%)`;
    g.beginPath();
    g.moveTo(cx + a.x * size, cy + a.y * size);
    g.lineTo(cx + b.x * size, cy + b.y * size);
    g.stroke();
  }
});

w.on('close', () => task.quit());
w.open();
