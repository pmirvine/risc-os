// Picture - the drawing: its lines, how to draw them, and how to
// turn them into text and back (to save and load them)
const lines = [];     // everything drawn so far
let drawing = null;   // the line being drawn, while Select is held

// start a new line at x, y
export function startLine(colour, x, y) {
  drawing = { colour, points: [{ x, y }] };
  lines.push(drawing);
}

// add a point to the line being drawn (false if there isn't one)
export function addPoint(x, y) {
  if (!drawing) return false;
  drawing.points.push({ x, y });
  return true;
}

export function endLine() {
  drawing = null;
}

export function clear() {
  lines.length = 0;
  drawing = null;
}

export function isEmpty() {
  return lines.length === 0;
}

// draw the whole picture with the graphics context g
export function drawPicture(g) {
  g.lineWidth = 4;
  g.lineCap = 'round';
  g.lineJoin = 'round';
  for (const line of lines) {
    g.strokeStyle = line.colour;
    g.beginPath();
    g.moveTo(line.points[0].x, line.points[0].y);
    for (const p of line.points) {
      g.lineTo(p.x, p.y);
    }
    g.stroke();
  }
}

// the picture as text, for saving in a file
export function pictureToText() {
  return JSON.stringify(lines);
}

// replace the picture with one saved by pictureToText
export function pictureFromText(text) {
  const saved = JSON.parse(text);
  if (!Array.isArray(saved)) {
    throw new Error('This is not a drawing');
  }
  lines.length = 0;
  for (const line of saved) {
    lines.push(line);
  }
  drawing = null;
}
