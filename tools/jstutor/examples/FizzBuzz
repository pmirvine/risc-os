// FizzBuzz - the counting game, from 1 to 30
let line = '';
for (let i = 1; i <= 30; i++) {
  let word;
  if (i % 3 === 0 && i % 5 === 0) {
    word = 'FizzBuzz';
  } else if (i % 3 === 0) {
    word = 'Fizz';
  } else if (i % 5 === 0) {
    word = 'Buzz';
  } else {
    word = String(i);
  }
  line = line + word + ' ';
  if (i % 10 === 0) {
    print(line);
    line = '';
  }
}
