// Shapes - drawing in a window
const w = task.createWindow({
  title: 'Shapes',
  x: 150, y: 100, w: 440, h: 300,
  extent: { w: 440, h: 300 },
  flags: { title: true, close: true, back: true, moveable: true },
  colours: { workBg: 0 },
});

w.useCanvas((g) => {
  // a filled rectangle
  g.fillStyle = 'red';
  g.fillRect(20, 20, 120, 80);

  // the outline of a rectangle
  g.strokeStyle = 'blue';
  g.lineWidth = 4;
  g.strokeRect(170, 20, 120, 80);

  // a line
  g.strokeStyle = 'black';
  g.lineWidth = 2;
  g.beginPath();
  g.moveTo(320, 20);
  g.lineTo(420, 100);
  g.stroke();

  // a circle, in Wimp colour 10 (light green)
  g.fillStyle = wimpColour(10);
  g.beginPath();
  g.arc(80, 200, 50, 0, Math.PI * 2);
  g.fill();

  // a triangle
  g.fillStyle = '#ffcc00';
  g.beginPath();
  g.moveTo(230, 150);
  g.lineTo(290, 250);
  g.lineTo(170, 250);
  g.closePath();
  g.fill();

  // some text
  g.fillStyle = 'black';
  g.font = '20px sans-serif';
  g.fillText('Hello, shapes!', 300, 210);
});

w.on('close', () => task.quit());
w.open();
