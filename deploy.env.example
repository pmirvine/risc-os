# Copy to .deploy.env (git-ignored) and fill in. Read by deploy.sh.

# ssh target that can run docker and write both directories (key login; the script never asks for a password)
DEPLOY_SSH=root@your-server

# The full deployment (login + !Browse's engine + the Server drive): where deploy/README.md put the source
DEPLOY_RO_DIR=/srv/riscos/src
# Address people use, for the check at the end (expects 401: the login asking)
DEPLOY_RO_URL=https://your-server/ro/

# The plain static copy: the directory Apache serves it from
DEPLOY_ROWEB_DIR=/srv/www/vhosts/your-site/roweb
# Owner of those files (user:group of the web server); leave empty to leave ownership alone
DEPLOY_WEB_OWNER=wwwrun:www
# Address for the check at the end (expects 200)
DEPLOY_ROWEB_URL=https://your-server/roweb/
